# pan.cyr -- constant-power (sin/cos) stereo panner.
# Ports rust-old/src/dsp/pan.rs. L1: deps error + buffer + abaco::constant_power_pan.
# pan in [-1,+1]; abaco's constant_power_pan(pan, out_l, out_r) writes gains via
# out-pointers. serde/Default dropped.

#derive(accessors)
struct DhStereoPanner { pan; gain_l; gain_r; }

# new(pan) -- panner at the given position (-1 left .. +1 right).
#must_use
fn dhvani_pan_new(pan) {
    var self = alloc(sizeof(DhStereoPanner));
    DhStereoPanner_set_pan(self, 0);
    DhStereoPanner_set_gain_l(self, 0);
    DhStereoPanner_set_gain_r(self, 0);
    dhvani_pan_set_pan(self, pan);
    return self;
}

# set_pan(pan) -- clamp to [-1,1] and recompute L/R gains.
fn dhvani_pan_set_pan(self, pan) {
    var clamped = f64_clamp(pan, f64_neg(1.0), 1.0);
    DhStereoPanner_set_pan(self, clamped);
    var lp = alloc(8);
    var rp = alloc(8);
    constant_power_pan(clamped, lp, rp);
    DhStereoPanner_set_gain_l(self, load64(lp));
    DhStereoPanner_set_gain_r(self, load64(rp));
    return 0;
}

#inline
#must_use
fn dhvani_pan_pan(self) { return DhStereoPanner_pan(self); }
#inline
#must_use
fn dhvani_pan_gain_l(self) { return DhStereoPanner_gain_l(self); }
#inline
#must_use
fn dhvani_pan_gain_r(self) { return DhStereoPanner_gain_r(self); }

# process(buf) -- apply pan gains to L/R in place. No-op for < 2 channels.
fn dhvani_pan_process(self, buf) {
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 2) { return 0; }
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var gl = DhStereoPanner_gain_l(self);
    var gr = DhStereoPanner_gain_r(self);
    var frame = 0;
    while (frame < frames) {
        var l_idx = frame * ch;
        var r_idx = frame * ch + 1;
        vec_set(samples, l_idx, f64_mul(vec_get(samples, l_idx), gl));
        vec_set(samples, r_idx, f64_mul(vec_get(samples, r_idx), gr));
        frame = frame + 1;
    }
    return 0;
}
