# mechanical.cyr -- ghurni mechanical-sound engines bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/mechanical/mod.rs. The Rust module is `pub use ghurni::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call ghurni's bare
# symbols -- ghurni_engine_new / ghurni_motor_new / ... -- directly) plus three
# render bridges. Only the bridges carry over.
#
# Requires the ghurni bundle (+ its deps sakshi -> hisab -> goonj -> naad) to be
# included before this unit, in dependency order (see port-audit.md Wave F note).
#
# The Rust `render_mechanical<S: Synthesizer>` is generic over the Synthesizer
# trait (process_block + set_rpm). In Cyrius that generic dispatch becomes a
# fn-ptr pair: `process_fp(state, out)` fills a pre-sized vec, `setrpm_fp(state,
# rpm)` retargets the RPM. Each ghurni type's `*_process_block` / `*_set_rpm` fn
# is a valid callback as-is (pass `&ghurni_motor_process_block` + the state ptr).
#
# ERRORS: every bridge returns an AudioBuffer handle or 0. ghurni's constructors
# return NEGATIVE GH_ERR_* codes and its synthesize / process_block / set_rpm fns
# read the handle's fields without a check, so a handle <= 0 is refused (0) before
# ghurni is called. Through 2.3.1 render_engine returned DHVANI_ERR_DSP (-5).

# render_mechanical: fill a `frames`-length mono buffer via process_fp(state,out),
# then assemble a 1-channel interleaved AudioBuffer (silence fallback on failure,
# matching the Rust unwrap_or_else). One exact allocation for the samples; 0 for a
# null fn-ptr, a state handle <= 0, or a refused allocation.
#must_use
fn dhvani_mech_render(process_fp, state, frames, sample_rate) {
    if (process_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var samples = dh_vec_zeros(nf);
    if (vec_len(samples) != nf) { return 0; }
    fncall2(process_fp, state, samples);
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, nf, sr);
    }
    return buf;
}

# render_mechanical_at_rpm: set RPM via setrpm_fp(state,rpm), then render. 0 (and
# setrpm_fp not called) for a null fn-ptr or a state handle <= 0.
#must_use
fn dhvani_mech_render_at_rpm(process_fp, setrpm_fp, state, rpm, frames, sample_rate) {
    if (setrpm_fp == 0) { return 0; }
    if (process_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    fncall2(setrpm_fp, state, rpm);
    return dhvani_mech_render(process_fp, state, frames, sample_rate);
}

# render_into: alloc-free per-block form. process_fp(state, samples) fills the
# caller-owned MONO buffer's sample vec in place. DHVANI_ERR_NONE, or
# DHVANI_ERR_INVALID_PARAMETER for a null fn-ptr / buffer, a state handle <= 0, or a
# buffer that is not 1-channel.
fn dhvani_mech_render_into(process_fp, state, buf) {
    if (process_fp == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (state <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dhvani_buffer_channels(buf) != 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    fncall2(process_fp, state, dhvani_buffer_samples(buf));
    return DHVANI_ERR_NONE;
}

# render_engine(engine, rpm, load, sample_rate, duration) -> AudioBuffer, or 0.
# Calls ghurni_engine_synthesize (returns vec<f64> or GH_ERR_*); a synthesis error,
# a buffer-construction failure (rust-old's map_err -> Err) or an engine handle
# <= 0 answers 0.
#must_use
fn dhvani_mech_render_engine(engine, rpm, load, sample_rate, duration) {
    if (engine <= 0) { return 0; }
    var samples = ghurni_engine_synthesize(engine, rpm, load, duration);
    if (samples <= 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}
