# midi_v2.cyr -- MIDI 2.0 / UMP types: 16-bit velocity, 32-bit CC, per-note
# expression. Ports rust-old/src/midi/v2.rs. L0: dep error only (all integer
# logic -- MIDI note/velocity/channel/CC are ints; no floats here).
#
# The data structs (NoteOnV2, NoteOffV2, ControlChangeV2, PerNotePitchBend,
# PerNoteController, ChannelPressureV2, PolyPressureV2, PitchBendV2) -> Dh<Name>
# structs with untyped i64 slots (FramePos u64, u8/u16/u32 fields all fit).
# The UmpMessageType enum (#[non_exhaustive], 6 variants) -> DH_UMP_* int codes.
# serde dropped (Cyrius has no derive-serde).

# ---- UmpMessageType (enum -> int codes, in Rust variant order) ----
var DH_UMP_UTILITY            = 0;   # Utility (JR Timestamp, JR Clock)
var DH_UMP_SYSTEM_COMMON      = 1;   # System Real-Time / System Common (MIDI 1.0)
var DH_UMP_MIDI1_CHANNEL_VOICE = 2;  # MIDI 1.0 Channel Voice (7-bit)
var DH_UMP_DATA64             = 3;   # Data messages (SysEx 7-bit)
var DH_UMP_MIDI2_CHANNEL_VOICE = 4;  # MIDI 2.0 Channel Voice (32-bit)
var DH_UMP_DATA128            = 5;   # Data messages (SysEx 8-bit)

# ---- NoteOnV2 (16-bit velocity, per-note attributes) ----
#derive(accessors)
struct DhNoteOnV2 { position; note; velocity; channel; attribute_type; attribute_data; }
#must_use
fn dhvani_midi2_note_on_new(position, note, velocity, channel, attribute_type, attribute_data) {
    var e = alloc(sizeof(DhNoteOnV2));
    DhNoteOnV2_set_position(e, position);
    DhNoteOnV2_set_note(e, note);
    DhNoteOnV2_set_velocity(e, velocity);
    DhNoteOnV2_set_channel(e, channel);
    DhNoteOnV2_set_attribute_type(e, attribute_type);
    DhNoteOnV2_set_attribute_data(e, attribute_data);
    return e;
}
#inline
#must_use
fn dhvani_midi2_note_on_position(e) { return DhNoteOnV2_position(e); }
#inline
#must_use
fn dhvani_midi2_note_on_note(e) { return DhNoteOnV2_note(e); }
#inline
#must_use
fn dhvani_midi2_note_on_velocity(e) { return DhNoteOnV2_velocity(e); }
#inline
#must_use
fn dhvani_midi2_note_on_channel(e) { return DhNoteOnV2_channel(e); }
#inline
#must_use
fn dhvani_midi2_note_on_attribute_type(e) { return DhNoteOnV2_attribute_type(e); }
#inline
#must_use
fn dhvani_midi2_note_on_attribute_data(e) { return DhNoteOnV2_attribute_data(e); }

