    var e = alloc(sizeof(DhControlChangeV2));
    DhControlChangeV2_set_position(e, position);
    DhControlChangeV2_set_controller(e, controller);
    DhControlChangeV2_set_value(e, value);
    DhControlChangeV2_set_channel(e, channel);
    return e;
}
#inline
#must_use
