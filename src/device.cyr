# device.cyr -- audio device enumeration + default-device open (2.1.2).
#
# Wraps yukti's PCM discovery (yukti_audio_devices) so a consumer can list
# endpoints and open the default playback/capture device without hardcoding
# card/device numbers. yukti finds endpoints by listing /dev/snd and reading
# /proc/asound + sysfs for names and stable ids; its module still links the wider
# yukti stack, so its deps come first in the include chain:
#   freelist -> process -> fs -> patra -> yukti -> sakshi -> vani
# then dhvani error -> simd -> buffer -> playback -> device.
#
# NOT in dist/dhvani.cyr: it references yukti direction CONSTS (which don't
# DCE-prune) + pulls the heavier yukti/patra/fs stack, and the core bundle stays
# device-agnostic. A consumer wanting enumeration links this stack explicitly.

# List audio endpoints: a vec of yukti device descriptors, in /dev/snd READDIR order
# (not sorted; an EMPTY vec when there are none, not 0).
#must_use
fn dhvani_devices_list() { return yukti_audio_devices(); }

# ── Descriptor accessors (dhvani-facing names over yukti's) ─────────────────
fn dhvani_device_card(d) { return yukti_audio_card(d); }
fn dhvani_device_index(d) { return yukti_audio_device(d); }
fn dhvani_device_direction(d) { return yukti_audio_direction(d); }
fn dhvani_device_name(d) { return yukti_audio_name(d); }
fn dhvani_device_is_playback(d) {
    if (yukti_audio_direction(d) == YUKTI_AUDIO_PLAYBACK) { return 1; }
    return 0;
}
fn dhvani_device_is_capture(d) {
    if (yukti_audio_direction(d) == YUKTI_AUDIO_CAPTURE) { return 1; }
    return 0;
}

# ── Default-device candidates ───────────────────────────────────────────────

# Sort key: card first, then device. ALSA caps both well below 4096 (32 cards,
# devices 0..99 in yukti's parser).
fn dh_device_key(d) {
    return yukti_audio_card(d) * 4096 + yukti_audio_device(d);
}

# The endpoints of `devs` going in `direction` (YUKTI_AUDIO_PLAYBACK / _CAPTURE),
# ordered by (card, device), ties kept in enumeration order. A NEW vec; `devs` is not
# touched. An empty vec for devs == 0. /dev/snd readdir order is no order at all
# (devtmpfs lists newest first: pcmC0D9p before pcmC0D3p), so "the first match" used
# to be whichever node the kernel created last.
#must_use
fn dhvani_device_candidates(devs, direction) {
    var out = vec_new();
    if (devs == 0) { return out; }
    var n = vec_len(devs);
    var i = 0;
    while (i < n) {
        var d = vec_get(devs, i);
        if (yukti_audio_direction(d) == direction) {
            vec_push(out, d);
            # insertion step: walk the new element back past every larger key
            var j = vec_len(out) - 1;
            while (j > 0) {
                var prev = vec_get(out, j - 1);
                if (dh_device_key(prev) <= dh_device_key(d)) { break; }
                vec_set(out, j, prev);
                vec_set(out, j - 1, d);
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return out;
}

# ── Default-device open (enumerate → try each candidate in order) ───────────

# Open the first playback endpoint, in (card, device) order, that opens and accepts
# the format. 0 if none does (or for a depth dhvani cannot carry). A busy or
# format-refusing endpoint no longer ends the search.
fn dhvani_playback_open_default_fmt(sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var c = dhvani_device_candidates(yukti_audio_devices(), YUKTI_AUDIO_PLAYBACK);
    var n = vec_len(c);
    var i = 0;
    while (i < n) {
        var d = vec_get(c, i);
        var h = dhvani_playback_open_fmt(yukti_audio_card(d), yukti_audio_device(d),
          sample_rate, channels, bit_depth);
        if (h != 0) { return h; }
        i = i + 1;
    }
    return 0;
}
fn dhvani_playback_open_default(sample_rate, channels) {
    return dhvani_playback_open_default_fmt(sample_rate, channels, 16);
}

# Open the first capture endpoint, in (card, device) order, that opens and accepts
# the format. 0 if none does.
fn dhvani_capture_open_default_fmt(sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var c = dhvani_device_candidates(yukti_audio_devices(), YUKTI_AUDIO_CAPTURE);
    var n = vec_len(c);
    var i = 0;
    while (i < n) {
        var d = vec_get(c, i);
        var h = dhvani_capture_open_fmt(yukti_audio_card(d), yukti_audio_device(d),
          sample_rate, channels, bit_depth);
        if (h != 0) { return h; }
        i = i + 1;
    }
    return 0;
}
fn dhvani_capture_open_default(sample_rate, channels) {
    return dhvani_capture_open_default_fmt(sample_rate, channels, 16);
}
