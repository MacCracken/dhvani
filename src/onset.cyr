# onset.cyr -- Onset detection via spectral flux.
# Ports rust-old/src/analysis/onset.rs. L1: deps error + simd + buffer +
# abaco + analysis + fft + stft (dh_stft_frame). Frames the signal, computes the
# per-frame spectral difference (sum of positive bin-to-bin increases), normalizes
# the flux by its peak, and peak-picks local maxima above a threshold. The flux is
# computed one frame at a time (dhvani_spectral_flux_from_buffer), never holding the
# whole spectrogram.
#
# OnsetResult.positions was Vec<usize> (sample positions), strengths Vec<f32>.
# Here each is a `vec`: positions holds integer sample offsets, strengths holds
# f64 flux values. detect_onsets is fallible in Rust (STFT can fail) -> returns a
# valid result handle, or 0 (null) on STFT error. On < 2 frames it returns an
# empty (but non-null) result, matching the Rust Ok(empty).

#derive(accessors)
struct DhOnsetResult { positions; strengths; }

# frame positions (in samples) of detected onsets.
#inline
#must_use
fn dhvani_onset_positions(self) { return DhOnsetResult_positions(self); }

# spectral flux values at each onset.
#inline
#must_use
fn dhvani_onset_strengths(self) { return DhOnsetResult_strengths(self); }

# number of detected onsets.
#inline
#must_use
fn dhvani_onset_count(self) { return vec_len(DhOnsetResult_positions(self)); }

# position (sample offset) of onset index i.
#inline
#must_use
fn dhvani_onset_position(self, i) { return vec_get(DhOnsetResult_positions(self), i); }

# strength (flux) of onset index i.
#inline
#must_use
fn dhvani_onset_strength(self, i) { return vec_get(DhOnsetResult_strengths(self), i); }

# spectral_flux(sg) -- the onset strength envelope shared by detect_onsets and
# beat's onset_strength_envelope (identical in rust-old: onset.rs's flux before
# peak-picking == beat.rs's envelope). flux[0] = 0 (no predecessor), flux[i] =
# sum over bins of the positive increases frame[i] - frame[i-1], then normalized
# by its peak (folded from 0.0, NaN-ignoring like the oracle's f32::max).
# Returns a `vec` of num_frames f64 values, or an empty vec when < 2 frames.
#must_use
fn dhvani_spectral_flux(sg) {
    var flux = vec_new();
    var num_frames = dhvani_spectrogram_num_frames(sg);
    if (num_frames < 2) { return flux; }
    var num_bins = dhvani_spectrogram_num_bins(sg);

    vec_push(flux, 0); # First frame has no predecessor.
    var prevv = dhvani_spectrogram_frame(sg, 0);
    var i = 1;
    while (i < num_frames) {
        var diff_sum = 0;
        var curv = dhvani_spectrogram_frame(sg, i);
        # raw reads: never past either frame (stft frames are num_bins long)
        var nb = dh_imin(num_bins, dh_imin(vec_len(curv), vec_len(prevv)));
        var cur = dh_vec_data(curv);
        var prev = dh_vec_data(prevv);
        var bin = 0;
        while (bin < nb) {
            var diff = f64_sub(load64(cur + bin * 8), load64(prev + bin * 8));
            if (f64_gt(diff, 0) == 1) { diff_sum = f64_add(diff_sum, diff); }
            bin = bin + 1;
        }
        vec_push(flux, diff_sum);
        prevv = curv;
        i = i + 1;
    }

    # Storage taken after the last push (a push may move it).
    dh_flux_normalize(dh_vec_data(flux), vec_len(flux));
    return flux;
}

# Normalize n flux values at fd by their peak, in place. The peak is folded from 0.0,
# NaN-ignoring like the oracle's f32::max, so it is >= 0; a peak of 0 leaves them as is.
fn dh_flux_normalize(fd, n) {
    var max_flux = 0;
    var m = 0;
    while (m < n) { max_flux = dh_max_ignore_nan(max_flux, load64(fd + m * 8)); m = m + 1; }
    if (f64_gt(max_flux, 0) == 1) {
        var k = 0;
        while (k < n) { store64(fd + k * 8, f64_div(load64(fd + k * 8), max_flux)); k = k + 1; }
    }
    return 0;
}

# spectral_flux_from_buffer(buf, window_size, hop_size) -- the flux of
# dhvani_spectral_flux(dhvani_stft(buf, window_size, hop_size)), bit for bit, computed
# one STFT frame at a time. It keeps two magnitude frames, not the spectrogram, so its
# memory is O(window_size + frames) rather than O(window_size * frames). (A 3-minute
# track at 2048/512 held about 127 MB of spectrogram, which the bump allocator never
# gives back.) Returns 0 on the STFT's errors, and an empty vec when < 2 frames.
#must_use
fn dhvani_spectral_flux_from_buffer(buf, window_size, hop_size) {
    if (dh_stft_args_ok(buf, window_size, hop_size) == 0) { return 0; }
    var count = dh_stft_frame_count(buf, window_size, hop_size);
    if (count < 2) { return vec_new(); }
    var num_bins = window_size / 2;
    var window = dhvani_stft_hann_window(window_size);
    var real = dh_vec_zeros(window_size);
    var imag = dh_vec_zeros(window_size);
    var prevv = dh_vec_zeros(num_bins);
    var curv = dh_vec_zeros(num_bins);
    var flux = dh_vec_zeros(count); # flux[0] = 0: the first frame has no predecessor
    if (vec_len(imag) != window_size) { return 0; }
    if (vec_len(curv) != num_bins) { return 0; }
    if (vec_len(flux) != count) { return 0; }
    var sd = dh_vec_data(DhAudioBuffer_samples(buf));
    var wd = dh_vec_data(window);
    var stride = DhAudioBuffer_channels(buf) * 8;
    var prev = dh_vec_data(prevv);
    var cur = dh_vec_data(curv);
    var fd = dh_vec_data(flux);

    dh_stft_frame(sd, stride, wd, real, imag, window_size, prev);
    var i = 1;
    while (i < count) {
        dh_stft_frame(sd + i * hop_size * stride, stride, wd, real, imag, window_size, cur);
        var diff_sum = 0;
        var bin = 0;
        while (bin < num_bins) {
            var diff = f64_sub(load64(cur + bin * 8), load64(prev + bin * 8));
            if (f64_gt(diff, 0) == 1) { diff_sum = f64_add(diff_sum, diff); }
            bin = bin + 1;
        }
        store64(fd + i * 8, diff_sum);
        var t = prev;
        prev = cur;
        cur = t;
        i = i + 1;
    }
    dh_flux_normalize(fd, count);
    return flux;
}

# build an OnsetResult from positions + strengths vecs.
#must_use
fn dhvani_onset_make_result(positions, strengths) {
    var self = alloc(sizeof(DhOnsetResult));
    DhOnsetResult_set_positions(self, positions);
    DhOnsetResult_set_strengths(self, strengths);
    return self;
}

# detect_onsets(buf, window_size, hop_size, threshold) -- spectral-flux onsets.
# Returns a result handle, or 0 on STFT error (incl. hop_size <= 0). With < 2
# STFT frames returns an empty result. threshold is an f64 sensitivity (lower =
# more sensitive).
#must_use
fn dhvani_detect_onsets(buf, window_size, hop_size, threshold) {
    # Spectral flux: sum of positive differences between consecutive frames,
    # normalized by its peak (shared with beat), streamed frame by frame.
    var flux = dhvani_spectral_flux_from_buffer(buf, window_size, hop_size);
    if (flux == 0) { return 0; }
    var flux_len = vec_len(flux);
    if (flux_len < 2) {
        return dhvani_onset_make_result(vec_new(), vec_new());
    }

    # Peak-pick: flux values above threshold that are local maxima.
    var positions = vec_new();
    var strengths = vec_new();

    # flux.len().saturating_sub(1); num_frames >= 2 so flux_len >= 2.
    var upper = flux_len - 1;
    var p = 1;
    while (p < upper) {
        var fp = vec_get(flux, p);
        if (f64_gt(fp, threshold) == 1) {
            if (f64_gt(fp, vec_get(flux, p - 1)) == 1) {
                if (f64_ge(fp, vec_get(flux, p + 1)) == 1) {
                    vec_push(positions, p * hop_size);
                    vec_push(strengths, fp);
                }
            }
        }
        p = p + 1;
    }

    return dhvani_onset_make_result(positions, strengths);
}
