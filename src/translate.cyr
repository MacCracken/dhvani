# translate.cyr -- MIDI 1.0 <-> 2.0 translation: velocity/CC/pitch-bend scaling
# + NoteEvent/ControlChange <-> V2 struct conversion.
# Ports rust-old/src/midi/translate.rs. L1: deps error + midi (DhNoteEvent /
# DhControlChange consumed) + midi_v2 (DhNoteOnV2 / DhControlChangeV2 target
# types + dhvani_midi2_* constructors/accessors -- reused, not redefined here).
# Pure INTEGER bit logic -- no floats. Rust gets its widths from the types; the
# Cyrius port uses i64 slots, so every scaler masks its INPUT to the Rust type
# width (u8 & 0xFF, u16 & 0xFFFF, u32 & 0xFFFFFFFF -- what the Rust argument
# type would have held) and its OUTPUT to the result width (u16/u32 for the
# up-scalers, the 7/14-bit domain for the down-scalers). Out-of-type input (a
# negative or sign-extended word, >32-bit garbage) can never leak past the
# 7/14-bit range.
#
# UP-SCALING IS THE MIDI 2.0 MIN-CENTER-MAX RULE (a divergence from rust-old,
# ADR 005). rust-old used plain bit replication (`v << 9 | v << 2 | v >> 5`), which
# its doc mislabels "MIDI 2.0 spec scaling" and which moves every centre value:
# pitch bend 8192 went to 0x80020008, not DH_MIDITX_PITCH_BEND_CENTER, so an
# up-scaled MIDI 1.0 bend at rest read as a slight detune. The MIDI 2.0 UMP
# specification (M2-104-UM) defines min-center-max scaling instead (dh_miditx_scale_up):
#   - a value at or below the centre is a plain shift, so 0 -> 0 and the centre
#     (64, or 8192) lands exactly on the 2.0 centre (0x8000, 0x80000000);
#   - above the centre, the low source bits are repeated into the new low bits,
#     so the maximum (127, 16383) lands exactly on the 2.0 maximum.
# A 7-bit up-scaler input of 128..255 (in the u8 type, outside MIDI 1.0) saturates
# to 127, and a 14-bit input above 16383 to 16383: past full scale is full scale.
# Down-scaling is the spec's plain shift, unchanged from rust-old, and every
# up-then-down round trip is exact.
#
# The struct conversions allocate (free-less bump allocator); each has a
# zero-alloc `*_into(..., out)` twin that writes a caller-owned handle.
# serde + Display tests dropped (none in this oracle).

# Pitch bend center value in MIDI 2.0 (32-bit).
var DH_MIDITX_PITCH_BEND_CENTER = 0x80000000;

# ---- scalar scaling (pure integer bit logic) ----

# MIDI 2.0 min-center-max up-scaling of src (0 .. 2^src_bits - 1) from src_bits to
# dst_bits (dst_bits > src_bits): the spec's reference algorithm. At or below the
# centre 2^(src_bits-1) it is a plain shift. Above it, the low src_bits-1 bits are
# aligned under the shifted value and repeated downward until they run out, so the
# source maximum maps to the destination maximum. Allocation-free.
#must_use
fn dh_miditx_scale_up(src, src_bits, dst_bits) {
    var scale = dst_bits - src_bits;
    var shifted = src << scale;
    if (src <= (1 << (src_bits - 1))) { return shifted; }
    var rep_bits = src_bits - 1;
    var rep = src & ((1 << rep_bits) - 1);
    if (scale > rep_bits) { rep = rep << (scale - rep_bits); } else { rep = rep >> (rep_bits - scale); }
    while (rep != 0) {
        shifted = shifted | rep;
        rep = rep >> rep_bits;
    }
    return shifted;
}

# A 7-bit up-scaler input: masked to u8 (the Rust argument type), then saturated to
# the MIDI 1.0 range 0..127.
#inline
#must_use
fn dh_miditx_in7(v) {
    var x = v & 0xFF;
    if (x > 127) { return 127; }
    return x;
}

# Scale 7-bit MIDI 1.0 velocity (u8) to 16-bit MIDI 2.0, min-center-max:
# 0 -> 0, 64 -> 0x8000, 127 -> 0xFFFF (see header).
#must_use
fn dhvani_miditx_velocity_7_to_16(v) {
    return dh_miditx_scale_up(dh_miditx_in7(v), 7, 16);
}

# Scale 16-bit MIDI 2.0 velocity (u16) to 7-bit MIDI 1.0 (lossy). Pure scaler:
# 1..511 -> 0. Note-on conversion applies the 0 -> 1 rule on top (below).
#inline
#must_use
fn dhvani_miditx_velocity_16_to_7(v) {
    return ((v & 0xFFFF) >> 9) & 0x7F;
}

# Scale 7-bit CC value (u8) to 32-bit MIDI 2.0, min-center-max:
# 0 -> 0, 64 -> 0x80000000, 127 -> 0xFFFFFFFF.
#must_use
fn dhvani_miditx_cc_7_to_32(v) {
    return dh_miditx_scale_up(dh_miditx_in7(v), 7, 32);
}

# Scale 32-bit CC value (u32) to 7-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_cc_32_to_7(v) {
    return ((v & 0xFFFFFFFF) >> 25) & 0x7F;
}

# Convert 14-bit MIDI 1.0 pitch bend (u16) to 32-bit MIDI 2.0, min-center-max:
# 0 -> 0, 8192 -> DH_MIDITX_PITCH_BEND_CENTER, 16383 -> 0xFFFFFFFF. An input
# above 16383 (in the u16 type, outside MIDI 1.0) saturates to 16383.
#must_use
fn dhvani_miditx_pitch_bend_14_to_32(v) {
    var x = v & 0xFFFF;
    if (x > 16383) { x = 16383; }
    return dh_miditx_scale_up(x, 14, 32);
}

# Convert 32-bit MIDI 2.0 pitch bend (u32) to 14-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_pitch_bend_32_to_14(v) {
    return ((v & 0xFFFFFFFF) >> 18) & 0x3FFF;
}

# ---- struct conversions (V2 types from midi_v2.cyr) ----

# MIDI 1.0 NoteEvent -> caller-owned NoteOnV2 `out` (zero-alloc). Returns out.
fn dhvani_miditx_note_event_to_v2_into(event, out) {
    return dhvani_midi2_note_on_init(
      out,
      dhvani_note_event_position(event),
      dhvani_note_event_note(event),
      dhvani_miditx_velocity_7_to_16(dhvani_note_event_velocity(event)),
      dhvani_note_event_channel(event),
      0,
      0);
}

# Convert a MIDI 1.0 NoteEvent to a MIDI 2.0 NoteOnV2 (allocates 48 B).
#must_use
fn dhvani_miditx_note_event_to_v2(event) {
    return dhvani_miditx_note_event_to_v2_into(event, alloc(sizeof(DhNoteOnV2)));
}

# MIDI 2.0 NoteOnV2 -> caller-owned NoteEvent `out` (lossy, zero-alloc).
# Requires a duration since NoteOnV2 doesn't carry duration. Returns out.
# DIVERGES from rust-old (translate.rs:83 uses velocity_16_to_7 as-is): a 16-bit
# velocity that down-scales to 0 (0..511) becomes 1, per the MIDI 2.0 -> 1.0
# translation rule -- a note-on must not turn into a MIDI 1.0 velocity-0 note-off.
fn dhvani_miditx_note_on_v2_to_event_into(event, duration, out) {
    var vel = dhvani_miditx_velocity_16_to_7(dhvani_midi2_note_on_velocity(event));
    if (vel == 0) { vel = 1; }
    return dhvani_note_event_init(
      out,
      dhvani_midi2_note_on_position(event),
      duration,
      dhvani_midi2_note_on_note(event),
      vel,
      dhvani_midi2_note_on_channel(event));
}

# Convert a MIDI 2.0 NoteOnV2 back to a MIDI 1.0 NoteEvent (lossy, allocates).
#must_use
fn dhvani_miditx_note_on_v2_to_event(event, duration) {
    return dhvani_miditx_note_on_v2_to_event_into(event, duration, alloc(sizeof(DhNoteEvent)));
}

# MIDI 1.0 ControlChange -> caller-owned ControlChangeV2 `out`. Returns out.
fn dhvani_miditx_cc_to_v2_into(cc, out) {
    return dhvani_midi2_cc_init(
      out,
      dhvani_cc_position(cc),
      dhvani_cc_controller(cc),
      dhvani_miditx_cc_7_to_32(dhvani_cc_value(cc)),
      dhvani_cc_channel(cc));
}

# Convert a MIDI 1.0 ControlChange to MIDI 2.0 ControlChangeV2 (allocates).
#must_use
fn dhvani_miditx_cc_to_v2(cc) {
    return dhvani_miditx_cc_to_v2_into(cc, alloc(sizeof(DhControlChangeV2)));
}

# MIDI 2.0 ControlChangeV2 -> caller-owned ControlChange `out` (lossy). Returns out.
fn dhvani_miditx_cc_v2_to_cc_into(cc, out) {
    return dhvani_cc_init(
      out,
      dhvani_midi2_cc_position(cc),
      dhvani_midi2_cc_controller(cc),
      dhvani_miditx_cc_32_to_7(dhvani_midi2_cc_value(cc)),
      dhvani_midi2_cc_channel(cc));
}

# Convert a MIDI 2.0 ControlChangeV2 to MIDI 1.0 ControlChange (lossy, allocates).
#must_use
fn dhvani_miditx_cc_v2_to_cc(cc) {
    return dhvani_miditx_cc_v2_to_cc_into(cc, alloc(sizeof(DhControlChange)));
}
