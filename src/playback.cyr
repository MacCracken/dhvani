# playback.cyr -- dhvani AudioBuffer <-> vani ALSA device I/O (2.1.x feature).
#
# vani (dh(vani)'s sibling) owns raw /dev/snd PCM playback/capture via ioctls
# (no libasound, no FFI) — the real-hardware sink/source the Rust dhvani only had
# via the platform-blocked PipeWire backend. This module bridges dhvani's f64
# AudioBuffer to vani's interleaved little-endian signed PCM (S16 / S24 / S32).
#
# Requires (in dependency order before this unit): yukti -> sakshi -> vani, then
# dhvani error -> simd -> buffer. Externalizes vani exactly like the Wave F
# wrappers externalize the synthesis siblings — a consumer that wants device I/O
# links vani alongside dhvani. It references vani through FUNCTIONS ONLY (never a
# vani const/var) so the whole module DCE-prunes for vani-free consumers of the
# dist bundle. The PURE format bridges need no hardware and are unit-tested; the
# device glue needs /dev/snd. S16 helpers stay as thin wrappers (2.1.0 API).
#
# Supported depths are signed little-endian 16 / 24 / 32 (dh_pcm_depth_ok). Every
# public entry point refuses anything else -- returning 0 (handle / buffer / PCM
# pointer) or -1 (counts) -- rather than packing it as some other width: vani will
# happily configure S8, and an 8-bit device fed 4-byte words plays noise.

# ── PCM format params ───────────────────────────────

# 1 iff dhvani carries this bit depth (signed little-endian 16 / 24 / 32).
#must_use
fn dh_pcm_depth_ok(bit_depth) {
    if (bit_depth == 16) { return 1; }
    if (bit_depth == 24) { return 1; }
    if (bit_depth == 32) { return 1; }
    return 0;
}

# PACKED bytes per sample (the rust-old `f32_to_i24_packed` layout: 24-bit is 3
# bytes). 0 for an unsupported depth, so a size computed from it fails closed.
fn dh_pcm_bytes(bit_depth) {
    if (bit_depth == 16) { return 2; }
    if (bit_depth == 24) { return 3; }
    if (bit_depth == 32) { return 4; }
    return 0;
}

# ENCODE full scale, 2^(bits-1) - 1: rust-old's `clamp(-1,1) * 32767 / 8388607 /
# 2147483647` then truncate. 32-bit is f64_from(): 2147483647 > 2^24, where a
# decimal literal would misparse.
fn dh_pcm_scale(bit_depth) {
    if (bit_depth == 16) { return 32767.0; }
    if (bit_depth == 24) { return 8388607.0; }
    if (bit_depth == 32) { return f64_from(2147483647); }
    return 0;
}

# DECODE full scale, 2^(bits-1): rust-old's i16_to_f32 / i24_packed_to_f32 /
# i32_to_f32 divide by 32768 / 8388608 / 2147483648 (and so do dhvani's own
# dhvani_simd_i16_to_f32 / dhvani_convert_i32_to_f32), so the most negative code
# decodes to exactly -1.0. Through 2.3.1 this divided by the ENCODE scale, which put
# -32768 at -1.0000305 (outside [-1, 1]) and 16384 at 0.500015.
fn dh_pcm_dscale(bit_depth) {
    if (bit_depth == 16) { return 32768.0; }
    if (bit_depth == 24) { return 8388608.0; }
    if (bit_depth == 32) { return f64_from(2147483648); }
    return 0;
}

# ALSA *storage* width, which is NOT dh_pcm_bytes for 24-bit. `SND_PCM_FORMAT_S24_LE`
# carries 24 significant bits inside a 32-bit word (vani_bytes_per_sample returns 4
# for it, lib/vani.cyr), whereas dh_pcm_bytes(24) == 3 — the *packed* layout the
# pure bridge uses to match rust-old's `f32_to_i24_packed`. Sizing a device buffer
# with the packed width makes the kernel read/write 33% past the allocation, so
# every vani-facing path MUST use this one instead. 0 for an unsupported depth.
fn dh_pcm_store_bytes(bit_depth) {
    if (bit_depth == 16) { return 2; }
    if (bit_depth == 24) { return 4; }   # S24_LE: 24 bits inside a 32-bit word
    if (bit_depth == 32) { return 4; }
    return 0;
}

# ── Pure format bridge (no vani, no hardware) ───────────────────────

# pack `n` f64 samples from raw storage `src` -> `dst` as little-endian signed PCM at
# `bit_depth`, `bytes` of storage per sample (2, 3 or 4): clamp[-1,1], then
# trunc(* encode full-scale). One store16/store32 per sample (store16 + store8 for a
# 3-byte slot); the high byte of a 4-byte S24 slot carries the sign, as before. NaN
# packs to 0 (f64_to of NaN), +/-inf to +/-full-scale. 0, or -1 for an unsupported
# depth or width.
fn dh_pack_ptr(src, n, dst, bit_depth, bytes) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    if (bytes < 2) { return 0 - 1; }
    if (bytes > 4) { return 0 - 1; }
    var scale = dh_pcm_scale(bit_depth);
    var s = src;
    var end = src + n * 8;
    var d = dst;
    while (s < end) {
        var c = f64_clamp(load64(s), DH_NEG_ONE, 1.0);
        var v = f64_to(f64_trunc(f64_mul(c, scale)));
        if (bytes == 4) {
            store32(d, v);
        } elif (bytes == 2) {
            store16(d, v);
        } else {
            store16(d, v);
            store8(d + 2, v >> 16);
        }
        s = s + 8;
        d = d + bytes;
    }
    return 0;
}

# vec form: packs the first `n` samples of `samples` (clamped to its length).
# Alloc-free (caller-owned dst) -> the RT path uses this straight into a scratch.
fn dh_pack_le_w(samples, n, dst, bit_depth, bytes) {
    return dh_pack_ptr(dh_vec_data(samples), dh_imin(n, vec_len(samples)), dst, bit_depth, bytes);
}
# packed-width pack (logical layout — the rust-old-parity bridge).
fn dh_pack_le(samples, n, dst, bit_depth) {
    return dh_pack_le_w(samples, n, dst, bit_depth, dh_pcm_bytes(bit_depth));
}

# unpack `n` little-endian signed PCM samples at `bit_depth` from `src` into raw f64
# storage `dst` (sign-extend from bit_depth bits, / decode full-scale), reading
# `bytes` (2, 3 or 4) of storage per sample. `bytes` may exceed bit_depth/8 (S24_LE
# in a 32-bit word), so the raw word is masked to bit_depth bits BEFORE the sign
# fold — otherwise a negative sample's 0xFF sign padding would read as a huge
# positive value. 0, or -1 for an unsupported depth or width.
fn dh_unpack_ptr(src, n, dst, bit_depth, bytes) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    if (bytes < 2) { return 0 - 1; }
    if (bytes > 4) { return 0 - 1; }
    # x * 2^-k == x / 2^k exactly (power-of-two scaling), so the multiply is the
    # oracle's divide, bit for bit.
    var inv = f64_div(1.0, dh_pcm_dscale(bit_depth));
    var mask = (1 << bit_depth) - 1;
    var half = 1 << (bit_depth - 1);
    var full = 1 << bit_depth;
    var s = src;
    var d = dst;
    var end = dst + n * 8;
    while (d < end) {
        var v = 0;
        if (bytes == 4) {
            v = load32(s);
        } elif (bytes == 2) {
            v = load16(s);
        } else {
            v = load16(s) | (load8(s + 2) << 16);
        }
        v = v & mask;
        if (v >= half) { v = v - full; }
        store64(d, f64_mul(f64_from(v), inv));
        s = s + bytes;
        d = d + 8;
    }
    return 0;
}

# vec form: decodes into the first `n` slots of `dst` (clamped to its length).
fn dh_unpack_le_w(src, n, dst, bit_depth, bytes) {
    return dh_unpack_ptr(src, dh_imin(n, vec_len(dst)), dh_vec_data(dst), bit_depth, bytes);
}
# packed-width unpack (logical layout — the rust-old-parity bridge).
fn dh_unpack_le(src, n, dst, bit_depth) {
    return dh_unpack_le_w(src, n, dst, bit_depth, dh_pcm_bytes(bit_depth));
}

# AudioBuffer f64 -> freshly-allocated little-endian PCM at `bit_depth`
# (channels*frames*bytes). Caller owns it. 0 for a null buffer, an unsupported
# depth or an empty buffer. Per-block use: dhvani_playback_to_pcm_into, or the
# ring player (dhvani_player_push).
#must_use
fn dhvani_playback_to_pcm(buf, bit_depth) {
    if (buf == 0) { return 0; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var pcm = alloc(n * dh_pcm_bytes(bit_depth));
    if (pcm == 0) { return 0; }
    dh_pack_le(samples, n, pcm, bit_depth);
    return pcm;
}
#must_use
fn dhvani_playback_to_s16le(buf) { return dhvani_playback_to_pcm(buf, 16); }

# Alloc-free form: pack the whole buffer (packed layout) into caller-owned `dst` of
# `dst_bytes`. Bytes written, or -1 for a null buffer/dst, an unsupported depth or a
# dst too small for the whole buffer (nothing is written then).
#must_use
fn dhvani_playback_to_pcm_into(buf, bit_depth, dst, dst_bytes) {
    if (buf == 0) { return 0 - 1; }
    if (dst == 0) { return 0 - 1; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var need = n * dh_pcm_bytes(bit_depth);
    if (need > dst_bytes) { return 0 - 1; }
    dh_pack_le(samples, n, dst, bit_depth);
    return need;
}

# little-endian PCM bytes at `bit_depth` (packed layout) -> AudioBuffer. 0 for a null
# pcm pointer, channels < 1, an unsupported depth, or a bad sample rate.
#must_use
fn dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, bit_depth) {
    if (pcm == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var n = nf * channels;
    var f = dh_vec_zeros(n);
    if (vec_len(f) != n) { return 0; }
    dh_unpack_le(pcm, n, f, bit_depth);
    return dhvani_buffer_from_interleaved(f, channels, sample_rate);
}
#must_use
fn dhvani_capture_from_s16le(pcm, frames, channels, sample_rate) {
    return dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, 16);
}

# Alloc-free form: decode up to `frames` frames of packed PCM into the caller-owned
# AudioBuffer `buf` (its channel count; at most its frame count). Frames decoded, or
# -1 for a null pcm/buffer or an unsupported depth. buf's frame count is unchanged.
#must_use
fn dhvani_capture_from_pcm_into(pcm, frames, bit_depth, buf) {
    if (pcm == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (ch < 1) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var nf = dh_imin(frames, dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch));
    if (nf <= 0) { return 0; }
    dh_unpack_le(pcm, nf * ch, samples, bit_depth);
    return nf;
}

# ── Device glue (over vani; needs /dev/snd) ───────────────────────

# Transfer scratch for the blocking device paths, owned here and GROW-ONLY: one per
# direction, reused by every dhvani_playback_write / dhvani_capture_read* call and
# grown only when a call needs more than the high-water mark. Through 2.3.1 each
# call allocated its PCM buffer, which the free-less bump allocator never reclaims
# (4 KiB per 1024-frame S16 stereo block, unbounded over a stream). NOT REENTRANT:
# drive each direction from one thread at a time. The ring player/recorder below own
# their scratch per handle and carry no such restriction.
var _dh_pb_scratch = 0;
var _dh_pb_scratch_cap = 0;
var _dh_cap_scratch = 0;
var _dh_cap_scratch_cap = 0;

# playback scratch of at least `need` bytes, or 0 (need <= 0 / allocation refused).
fn dh_pb_scratch(need) {
    if (need <= 0) { return 0; }
    if (_dh_pb_scratch_cap >= need) { return _dh_pb_scratch; }
    var p = alloc(need);
    if (p == 0) { return 0; }
    _dh_pb_scratch = p;
    _dh_pb_scratch_cap = need;
    return p;
}

# capture scratch of at least `need` bytes, or 0.
fn dh_cap_scratch(need) {
    if (need <= 0) { return 0; }
    if (_dh_cap_scratch_cap >= need) { return _dh_cap_scratch; }
    var p = alloc(need);
    if (p == 0) { return 0; }
    _dh_cap_scratch = p;
    _dh_cap_scratch_cap = need;
    return p;
}

# The device's NEGOTIATED bit depth when dhvani can carry its wire format (signed LE
# 16/24/32, as dhvani_*_open_fmt configures it), else 0 -- also for a null handle or a
# device that was never configured. A FLOAT_LE / U8 / BE device answers 0: its bytes
# are not the integer layout the packers write.
fn dh_dev_depth(dev) {
    if (dev == 0) { return 0; }
    var fmt = vani_format_get(dev);
    if (fmt == 0) { return 0; }
    var depth = vani_format_bit_depth(fmt);
    if (dh_pcm_depth_ok(depth) == 0) { return 0; }
    if (vani_format_alsa(fmt) != vani_alsa_for(depth, 1)) { return 0; }
    return depth;
}

# The device's negotiated channel count, or 0 (null / unconfigured handle).
fn dh_dev_channels(dev) {
    if (dev == 0) { return 0; }
    var fmt = vani_format_get(dev);
    if (fmt == 0) { return 0; }
    return vani_format_channels(fmt);
}

# Open + configure + prepare a playback device at `bit_depth`. vani handle, or 0.
# HW_PARAMS leaves the stream in SETUP, and only PREPARE makes it accept frames
# (vani's programs/play_tone.cyr runs open -> configure -> prepare -> play). There
# is deliberately NO START: the kernel starts a playback stream itself once
# start_threshold frames are queued (1 by default after HW_PARAMS), while an explicit
# START on an empty playback buffer fails. Through 2.3.1 this skipped PREPARE and
# called START unchecked, so the stream never left SETUP.
fn dhvani_playback_open_fmt(card, device, sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var ores_tag, d = vani_open_playback(card, device);
    if (is_ok(ores_tag) == 0) { return 0; }
    var cres_tag, cres = vani_configure(d,
      vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres_tag) == 0) { vani_close(d); return 0; }
    var pres_tag, pres = vani_prepare(d);
    if (is_ok(pres_tag) == 0) { vani_close(d); return 0; }
    return d;
}
fn dhvani_playback_open(card, device, sample_rate, channels) {
    return dhvani_playback_open_fmt(card, device, sample_rate, channels, 16);
}

# Convert an AudioBuffer to the DEVICE's negotiated PCM format and play it.
# Frames written, or -1. The depth AND channel count are read back off the handle
# rather than assumed: `frames` goes straight to the kernel, which reads
# frames * <device channels> * <negotiated width> bytes, so a buffer that disagrees
# with either would have the kernel read past the PCM. -1 for a null device or
# buffer, an unconfigured / unsupported device, or a channel-count mismatch; 0 for an
# empty buffer. Alloc-free in steady state (module-owned grow-only scratch: one
# thread at a time per direction).
fn dhvani_playback_write(dev, buf) {
    if (buf == 0) { return 0 - 1; }
    var depth = dh_dev_depth(dev);
    if (depth == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (dh_dev_channels(dev) != ch) { return 0 - 1; }
    var frames = dhvani_buffer_frames(buf);
    if (frames <= 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    var n = frames * ch;
    if (n > vec_len(samples)) { return 0 - 1; }
    var bpp = dh_pcm_store_bytes(depth);
    var pcm = dh_pb_scratch(n * bpp);
    if (pcm == 0) { return 0 - 1; }
    dh_pack_ptr(dh_vec_data(samples), n, pcm, depth, bpp);
    var pres_tag, pres = vani_play(dev, pcm, frames);
    if (is_ok(pres_tag) == 0) { return 0 - 1; }
    return pres;
}

fn dhvani_playback_close(dev) { return vani_close(dev); }

# Open + configure + prepare + start a capture device at `bit_depth`. Handle, or 0.
# A capture stream does need START (it has nothing queued to start on), and a failed
# START now closes the device and answers 0 instead of handing back a dead stream.
fn dhvani_capture_open_fmt(card, device, sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var ores_tag, d = vani_open_capture(card, device);
    if (is_ok(ores_tag) == 0) { return 0; }
    var cres_tag, cres = vani_configure(d,
      vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres_tag) == 0) { vani_close(d); return 0; }
    var pres_tag, pres = vani_prepare(d);
    if (is_ok(pres_tag) == 0) { vani_close(d); return 0; }
    var sres_tag, sres = vani_start(d);
    if (is_ok(sres_tag) == 0) { vani_close(d); return 0; }
    return d;
}
fn dhvani_capture_open(card, device, sample_rate, channels) {
    return dhvani_capture_open_fmt(card, device, sample_rate, channels, 16);
}

# Read up to `frames` frames of `ch` channels at `depth` into the capture scratch.
# Frames ACTUALLY read (the kernel's count, clamped to [0, frames]), or -1. The
# scratch is sized from the format the caller already checked against the device.
fn dh_capture_raw(dev, frames, ch, depth) {
    var pcm = dh_cap_scratch(frames * ch * dh_pcm_store_bytes(depth));
    if (pcm == 0) { return 0 - 1; }
    var rres_tag, rres = vani_record(dev, pcm, frames);
    if (is_ok(rres_tag) == 0) { return 0 - 1; }
    var got = rres;
    if (got < 0) { got = 0; }
    if (got > frames) { got = frames; }
    return got;
}

# Record `frames` at `bit_depth` into a new AudioBuffer, or 0 on failure. The PCM
# transfer is sized from the DEVICE's negotiated format, and the call refuses (0,
# before any kernel I/O) when `channels` / `bit_depth` disagree with it: the kernel
# writes frames * <device channels> * <device width> bytes, so trusting the arguments
# let a 16-bit read of a 24/32-bit device write past the buffer. The result holds
# the frames ACTUALLY read (a short read is a shorter buffer, not zero padding).
# Allocates only the returned buffer; per-block use: dhvani_capture_read_into.
#must_use
fn dhvani_capture_read_fmt(dev, frames, channels, sample_rate, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (frames <= 0) { return 0; }
    if (dh_dev_depth(dev) != bit_depth) { return 0; }
    if (dh_dev_channels(dev) != channels) { return 0; }
    var got = dh_capture_raw(dev, frames, channels, bit_depth);
    if (got < 0) { return 0; }
    var n = got * channels;
    var f = dh_vec_zeros(n);
    if (vec_len(f) != n) { return 0; }
    dh_unpack_ptr(_dh_cap_scratch, n, dh_vec_data(f), bit_depth, dh_pcm_store_bytes(bit_depth));
    return dhvani_buffer_from_interleaved(f, channels, sample_rate);
}
#must_use
fn dhvani_capture_read(dev, frames, channels, sample_rate) {
    return dhvani_capture_read_fmt(dev, frames, channels, sample_rate, 16);
}

# Alloc-free capture into a caller-owned AudioBuffer: up to dhvani_buffer_frames(buf)
# frames at the device's negotiated format, decoded into buf's samples. Frames
# actually read (samples past them keep their old values; buf's frame count is not
# changed), or -1 for a null device/buffer, an unconfigured or unsupported device, a
# channel-count mismatch, or a vani error. Module scratch: one thread at a time.
#must_use
fn dhvani_capture_read_into(dev, buf) {
    if (buf == 0) { return 0 - 1; }
    var depth = dh_dev_depth(dev);
    if (depth == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (dh_dev_channels(dev) != ch) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var frames = dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch);
    if (frames <= 0) { return 0; }
    var got = dh_capture_raw(dev, frames, ch, depth);
    if (got < 0) { return 0 - 1; }
    dh_unpack_ptr(_dh_cap_scratch, got * ch, dh_vec_data(samples), depth, dh_pcm_store_bytes(depth));
    return got;
}

# ── Ring-buffer RT playback (lock-free, alloc-free producer) ────────────────
# A player owns a vani ring + a reusable scratch PCM buffer, so pushing a block
# converts into scratch and copies into the ring with ZERO per-block allocation
# (the free-less bump allocator demands it). The RT loop: push producer blocks,
# then drain to the device via vani_play_from_ring. The player's depth and channel
# count are fixed at construction and must match the device it drains to.

#derive(accessors)
struct DhPlayer { ring; scratch; scratch_bytes; bit_depth; channels; }

# ring_bytes = ring capacity (rounded up to pow2 by vani); scratch is sized for
# the largest block (max_frames * channels samples at `bit_depth`). 0 when vani
# refuses the ring (ring_bytes <= 0 or > 1 GiB), for channels < 1, max_frames < 1,
# an unsupported depth, or a refused allocation.
#must_use
fn dhvani_player_new_fmt(ring_bytes, max_frames, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (max_frames < 1) { return 0; }
    var ring = vani_ring_new(ring_bytes);
    if (ring == 0) { return 0; }
    # STORAGE width: this scratch is copied into the ring, which vani drains
    # straight to the device, so it must carry the device's wire layout.
    var bytes = max_frames * channels * dh_pcm_store_bytes(bit_depth);
    var scratch = alloc(bytes);
    if (scratch == 0) { return 0; }
    var self = alloc(sizeof(DhPlayer));
    if (self == 0) { return 0; }
    DhPlayer_set_ring(self, ring);
    DhPlayer_set_scratch(self, scratch);
    DhPlayer_set_scratch_bytes(self, bytes);
    DhPlayer_set_bit_depth(self, bit_depth);
    DhPlayer_set_channels(self, channels);
    return self;
}
#must_use
fn dhvani_player_new(ring_bytes, max_frames, channels) {
    return dhvani_player_new_fmt(ring_bytes, max_frames, channels, 16);
}

# the underlying vani ring (pass to vani_play_from_ring / the drain helper); 0 for a
# null player.
fn dhvani_player_ring(self) {
    if (self == 0) { return 0; }
    return DhPlayer_ring(self);
}

# Enqueue frames [start_frame, ...) of `buf`: as many WHOLE frames as fit the block,
# the scratch (max_frames) and the ring's free space, packed into the reusable
# scratch. No allocation. Returns FRAMES enqueued (0 when not one whole frame fits),
# or -1 for a null player/buffer, a buffer whose channel count is not the player's,
# or start_frame outside [0, frames]. A ring never receives part of a frame: with a
# non-power-of-two frame (5.1 S16 = 12 bytes) the free space is often not a frame
# multiple, and a fragment there misaligned every later sample.
fn dhvani_player_push_from(self, buf, start_frame) {
    if (self == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    var ch = DhPlayer_channels(self);
    if (dhvani_buffer_channels(buf) != ch) { return 0 - 1; }
    var frames = dhvani_buffer_frames(buf);
    if (start_frame < 0) { return 0 - 1; }
    if (start_frame > frames) { return 0 - 1; }
    var depth = DhPlayer_bit_depth(self);
    var bpp = dh_pcm_store_bytes(depth);
    var frame_bytes = ch * bpp;
    var ring = DhPlayer_ring(self);
    var nf = frames - start_frame;
    nf = dh_imin(nf, DhPlayer_scratch_bytes(self) / frame_bytes);
    nf = dh_imin(nf, vani_ring_free(ring) / frame_bytes);
    if (nf <= 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    if ((start_frame + nf) * ch > vec_len(samples)) { return 0 - 1; }
    var scratch = DhPlayer_scratch(self);
    dh_pack_ptr(dh_vec_data(samples) + start_frame * ch * 8, nf * ch, scratch, depth, bpp);
    var wrote = vani_ring_write(ring, scratch, nf * frame_bytes);
    return wrote / frame_bytes;
}

# Convert an AudioBuffer into the reusable scratch and enqueue it in the ring.
# No allocation. Returns BYTES enqueued, always a whole number of frames
# (frames = bytes / (channels * storage width)); 0 when not one frame fits, for a
# null handle, or for a buffer whose channel count is not the player's. Frames past
# that count were NOT enqueued: resume them next cycle with
# dhvani_player_push_from(self, buf, bytes / (channels * storage width)).
fn dhvani_player_push(self, buf) {
    var nf = dhvani_player_push_from(self, buf, 0);
    if (nf <= 0) { return 0; }
    return nf * DhPlayer_channels(self) * dh_pcm_store_bytes(DhPlayer_bit_depth(self));
}

# Drain queued audio to the device (call from the RT loop after pushing). A null
# player is reported as vani's own Err for a null ring.
fn dhvani_player_drain(self, dev) {
    if (self == 0) { return vani_play_from_ring(dev, 0); }
    return vani_play_from_ring(dev, DhPlayer_ring(self));
}

# ── Ring-buffer RT capture (mirror of the player) ─────────────────────
# A recorder owns a vani ring, a reusable PCM scratch and a reusable output
# AudioBuffer. The RT loop: fill the ring from the device (vani_record_to_ring),
# then read decoded blocks back. Neither side allocates per block.

#derive(accessors)
struct DhRecorder { ring; scratch; scratch_bytes; bit_depth; channels; sample_rate; out; }

# 0 when vani refuses the ring, for channels < 1, max_frames < 1, an unsupported
# depth, a sample rate dhvani_buffer_from_interleaved rejects, or a refused
# allocation.
#must_use
fn dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (max_frames < 1) { return 0; }
    var ring = vani_ring_new(ring_bytes);
    if (ring == 0) { return 0; }
    # STORAGE width — the ring is filled by vani straight from the device.
    var bytes = max_frames * channels * dh_pcm_store_bytes(bit_depth);
    var scratch = alloc(bytes);
    if (scratch == 0) { return 0; }
    var n = max_frames * channels;
    var outv = dh_vec_zeros(n);
    if (vec_len(outv) != n) { return 0; }
    var out = dhvani_buffer_from_interleaved(outv, channels, sample_rate);
    if (out == 0) { return 0; }
    var self = alloc(sizeof(DhRecorder));
    if (self == 0) { return 0; }
    DhRecorder_set_ring(self, ring);
    DhRecorder_set_scratch(self, scratch);
    DhRecorder_set_scratch_bytes(self, bytes);
    DhRecorder_set_bit_depth(self, bit_depth);
    DhRecorder_set_channels(self, channels);
    DhRecorder_set_sample_rate(self, sample_rate);
    DhRecorder_set_out(self, out);
    return self;
}
#must_use
fn dhvani_recorder_new(ring_bytes, max_frames, channels, sample_rate) {
    return dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, 16);
}

fn dhvani_recorder_ring(self) {
    if (self == 0) { return 0; }
    return DhRecorder_ring(self);
}

# Fill the ring from the device (call from the RT loop). Returns the vani result; a
# null recorder is reported as vani's own Err for a null ring.
fn dhvani_recorder_fill(self, dev, frames) {
    if (self == 0) { return vani_record_to_ring(dev, 0, frames); }
    return vani_record_to_ring(dev, DhRecorder_ring(self), frames);
}

# Move up to `frames` WHOLE frames (also capped by the scratch) from the ring into
# the scratch; frames moved. Computed from what the ring holds BEFORE reading, so a
# trailing partial frame stays in the ring for the next call (through 2.3.1 it was
# consumed and then dropped, misaligning everything after it).
fn dh_recorder_take(self, frames) {
    var frame_bytes = DhRecorder_channels(self) * dh_pcm_store_bytes(DhRecorder_bit_depth(self));
    var ring = DhRecorder_ring(self);
    var nf = frames;
    nf = dh_imin(nf, DhRecorder_scratch_bytes(self) / frame_bytes);
    nf = dh_imin(nf, vani_ring_used(ring) / frame_bytes);
    if (nf <= 0) { return 0; }
    var got = vani_ring_read(ring, DhRecorder_scratch(self), nf * frame_bytes);
    return got / frame_bytes;
}

# Drain up to `frames` whole frames from the ring, decoded per the recorder's bit
# depth, into the recorder-OWNED AudioBuffer, which is returned: zero allocation per
# call. The buffer is REUSED — its samples and frame count are valid until the next
# read on this recorder (copy them out to keep them, or decode into storage you own
# with dhvani_recorder_read_into). Its frame count is the whole frames read: 0 when
# the ring held less than one frame. 0 for a null recorder.
#must_use
fn dhvani_recorder_read(self, frames) {
    if (self == 0) { return 0; }
    var ch = DhRecorder_channels(self);
    var out = DhRecorder_out(self);
    var samples = dhvani_buffer_samples(out);
    var nf = dh_recorder_take(self, frames);
    var n = nf * ch;
    # vec layout { data, len, cap } (lib/vec.cyr, as dh_vec_data relies on): n never
    # exceeds the capacity reserved at construction (max_frames * channels).
    store64(samples + 8, dh_imin(n, vec_cap(samples)));
    DhAudioBuffer_set_frames(out, nf);
    dh_unpack_ptr(DhRecorder_scratch(self), n, dh_vec_data(samples), DhRecorder_bit_depth(self),
      dh_pcm_store_bytes(DhRecorder_bit_depth(self)));
    return out;
}

# Alloc-free drain into a caller-owned AudioBuffer of the recorder's channel count:
# up to dhvani_buffer_frames(buf) whole frames, decoded into buf's samples. Frames
# read (samples past them keep their old values; buf's frame count is not changed),
# or -1 for a null recorder/buffer or a channel-count mismatch.
#must_use
fn dhvani_recorder_read_into(self, buf) {
    if (self == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    var ch = DhRecorder_channels(self);
    if (dhvani_buffer_channels(buf) != ch) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var nf = dh_recorder_take(self, dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch));
    dh_unpack_ptr(DhRecorder_scratch(self), nf * ch, dh_vec_data(samples), DhRecorder_bit_depth(self),
      dh_pcm_store_bytes(DhRecorder_bit_depth(self)));
    return nf;
}
