# midi.cyr -- MIDI 1.0 core types: NoteEvent, ControlChange, MidiEvent, MidiClip.
# Ports rust-old/src/midi/mod.rs. L0: dep error only (stdlib vec).
# The data-carrying MidiEvent enum -> a `kind` code + a fat struct holding every
# variant's fields (only position/channel are read across variants). FramePos
# (u64) and the u8 fields -> i64 slots. serde dropped. Names are string handles.
#
# Allocation (free-less bump allocator): every constructor and every allocating
# clip query (notes_at, note_ons_at, note_offs_at, events_in_range) returns a
# FRESH handle/vec that is never reclaimed. Real-time callers use the zero-alloc
# forms instead: `*_init(e, ...)` reinitialises a caller-owned event handle, and
# the clip queries' `*_into(..., out)` forms truncate + refill a caller-owned vec
# (0 bytes per call once `out` has grown to the result size).

# ---- NoteEvent ----
#derive(accessors)
struct DhNoteEvent { position; duration; note; velocity; channel; }
# init -- (re)initialise a caller-owned DhNoteEvent handle in place; returns e.
# The zero-alloc twin of _new for event reuse in a render loop.
fn dhvani_note_event_init(e, position, duration, note, velocity, channel) {
    DhNoteEvent_set_position(e, position);
    DhNoteEvent_set_duration(e, duration);
    DhNoteEvent_set_note(e, note);
    DhNoteEvent_set_velocity(e, velocity);
    DhNoteEvent_set_channel(e, channel);
    return e;
}
#must_use
fn dhvani_note_event_new(position, duration, note, velocity, channel) {
    return dhvani_note_event_init(alloc(sizeof(DhNoteEvent)), position, duration, note, velocity, channel);
}
#inline
#must_use
fn dhvani_note_event_position(e) { return DhNoteEvent_position(e); }
#inline
#must_use
fn dhvani_note_event_duration(e) { return DhNoteEvent_duration(e); }
#inline
#must_use
fn dhvani_note_event_note(e) { return DhNoteEvent_note(e); }
#inline
#must_use
fn dhvani_note_event_velocity(e) { return DhNoteEvent_velocity(e); }
#inline
#must_use
fn dhvani_note_event_channel(e) { return DhNoteEvent_channel(e); }

# ---- ControlChange ----
#derive(accessors)
struct DhControlChange { position; controller; value; channel; }
# init -- (re)initialise a caller-owned DhControlChange handle; returns e.
fn dhvani_cc_init(e, position, controller, value, channel) {
    DhControlChange_set_position(e, position);
    DhControlChange_set_controller(e, controller);
    DhControlChange_set_value(e, value);
    DhControlChange_set_channel(e, channel);
    return e;
}
#must_use
fn dhvani_cc_new(position, controller, value, channel) {
    return dhvani_cc_init(alloc(sizeof(DhControlChange)), position, controller, value, channel);
}
#inline
#must_use
fn dhvani_cc_position(e) { return DhControlChange_position(e); }
#inline
#must_use
fn dhvani_cc_controller(e) { return DhControlChange_controller(e); }
#inline
#must_use
fn dhvani_cc_value(e) { return DhControlChange_value(e); }
#inline
#must_use
fn dhvani_cc_channel(e) { return DhControlChange_channel(e); }

# ---- MidiEvent (data-carrying enum -> kind code + fat struct) ----
var DH_MIDI_NOTE_ON         = 0;
var DH_MIDI_NOTE_OFF        = 1;
var DH_MIDI_CONTROL_CHANGE  = 2;
var DH_MIDI_PITCH_BEND      = 3;
var DH_MIDI_AFTERTOUCH      = 4;
var DH_MIDI_POLY_AFTERTOUCH = 5;
var DH_MIDI_PROGRAM_CHANGE  = 6;

#derive(accessors)
struct DhMidiEvent { kind; position; note; velocity; controller; value; pressure; program; channel; }

# reset a caller-owned event: kind/position/channel set, every payload slot 0.
fn dh_midi_event_reset(e, kind, position, channel) {
    DhMidiEvent_set_kind(e, kind);
    DhMidiEvent_set_position(e, position);
    DhMidiEvent_set_note(e, 0);
    DhMidiEvent_set_velocity(e, 0);
    DhMidiEvent_set_controller(e, 0);
    DhMidiEvent_set_value(e, 0);
    DhMidiEvent_set_pressure(e, 0);
    DhMidiEvent_set_program(e, 0);
    DhMidiEvent_set_channel(e, channel);
    return e;
}

# *_init(e, ...) -- re-tag a caller-owned DhMidiEvent as that variant (all other
# payload slots zeroed); returns e. The constructors below are alloc + _init.
fn dhvani_midi_note_on_init(e, position, note, velocity, channel) {
    dh_midi_event_reset(e, DH_MIDI_NOTE_ON, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_velocity(e, velocity);
    return e;
}
fn dhvani_midi_note_off_init(e, position, note, velocity, channel) {
    dh_midi_event_reset(e, DH_MIDI_NOTE_OFF, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_velocity(e, velocity);
    return e;
}
fn dhvani_midi_control_change_init(e, position, controller, value, channel) {
    dh_midi_event_reset(e, DH_MIDI_CONTROL_CHANGE, position, channel);
    DhMidiEvent_set_controller(e, controller);
    DhMidiEvent_set_value(e, value);
    return e;
}
fn dhvani_midi_pitch_bend_init(e, position, value, channel) {
    dh_midi_event_reset(e, DH_MIDI_PITCH_BEND, position, channel);
    DhMidiEvent_set_value(e, value);
    return e;
}
fn dhvani_midi_aftertouch_init(e, position, pressure, channel) {
    dh_midi_event_reset(e, DH_MIDI_AFTERTOUCH, position, channel);
    DhMidiEvent_set_pressure(e, pressure);
    return e;
}
fn dhvani_midi_poly_aftertouch_init(e, position, note, pressure, channel) {
    dh_midi_event_reset(e, DH_MIDI_POLY_AFTERTOUCH, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_pressure(e, pressure);
    return e;
}
fn dhvani_midi_program_change_init(e, position, program, channel) {
    dh_midi_event_reset(e, DH_MIDI_PROGRAM_CHANGE, position, channel);
    DhMidiEvent_set_program(e, program);
    return e;
}

#must_use
fn dhvani_midi_note_on(position, note, velocity, channel) {
    return dhvani_midi_note_on_init(alloc(sizeof(DhMidiEvent)), position, note, velocity, channel);
}
#must_use
fn dhvani_midi_note_off(position, note, velocity, channel) {
    return dhvani_midi_note_off_init(alloc(sizeof(DhMidiEvent)), position, note, velocity, channel);
}
#must_use
fn dhvani_midi_control_change(position, controller, value, channel) {
    return dhvani_midi_control_change_init(alloc(sizeof(DhMidiEvent)), position, controller, value, channel);
}
#must_use
fn dhvani_midi_pitch_bend(position, value, channel) {
    return dhvani_midi_pitch_bend_init(alloc(sizeof(DhMidiEvent)), position, value, channel);
}
#must_use
fn dhvani_midi_aftertouch(position, pressure, channel) {
    return dhvani_midi_aftertouch_init(alloc(sizeof(DhMidiEvent)), position, pressure, channel);
}
#must_use
fn dhvani_midi_poly_aftertouch(position, note, pressure, channel) {
    return dhvani_midi_poly_aftertouch_init(alloc(sizeof(DhMidiEvent)), position, note, pressure, channel);
}
#must_use
fn dhvani_midi_program_change(position, program, channel) {
    return dhvani_midi_program_change_init(alloc(sizeof(DhMidiEvent)), position, program, channel);
}
#inline
#must_use
fn dhvani_midi_event_kind(e) { return DhMidiEvent_kind(e); }
#inline
#must_use
fn dhvani_midi_event_position(e) { return DhMidiEvent_position(e); }
#inline
#must_use
fn dhvani_midi_event_channel(e) { return DhMidiEvent_channel(e); }

# ---- MidiClip ----
# Invariants the queries rely on (kept by every dhvani_midi_clip_* mutator; the
# notes()/control_changes() vecs are READ-ONLY views -- Rust hands out &[T]):
#   * notes are sorted by position (non-decreasing). add_note/merge insert in
#     order; quantize maps positions through a monotone function; transpose
#     leaves positions alone.
#   * max_note_duration >= every note's duration (starts 0, only ever raised;
#     no mutator shortens a duration). It bounds how far before a window a note
#     can start and still reach into it, which makes the lower-bound binary
#     search in the queries sound for any mix of durations.
#derive(accessors)
struct DhMidiClip { name; notes; control_changes; timeline_pos; duration; max_note_duration; }
#must_use
fn dhvani_midi_clip_new(name, timeline_pos, duration) {
    var c = alloc(sizeof(DhMidiClip));
    DhMidiClip_set_name(c, name);
    DhMidiClip_set_notes(c, vec_new());
    DhMidiClip_set_control_changes(c, vec_new());
    DhMidiClip_set_timeline_pos(c, timeline_pos);
    DhMidiClip_set_duration(c, duration);
    DhMidiClip_set_max_note_duration(c, 0);
    return c;
}
#inline
#must_use
fn dhvani_midi_clip_name(c) { return DhMidiClip_name(c); }
#inline
#must_use
fn dhvani_midi_clip_notes(c) { return DhMidiClip_notes(c); }
#inline
#must_use
fn dhvani_midi_clip_control_changes(c) { return DhMidiClip_control_changes(c); }
#inline
#must_use
fn dhvani_midi_clip_timeline_pos(c) { return DhMidiClip_timeline_pos(c); }
#inline
#must_use
fn dhvani_midi_clip_duration(c) { return DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_end_pos(c) { return DhMidiClip_timeline_pos(c) + DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_event_count(c) { return vec_len(DhMidiClip_notes(c)) + vec_len(DhMidiClip_control_changes(c)); }

# insert a note handle keeping notes sorted by position (partition_point <=:
# new note goes AFTER equal-position notes).
fn dh_midi_insert_note(notes, e) {
    var pos = DhNoteEvent_position(e);
    vec_push(notes, e);
    var i = vec_len(notes) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(notes, i - 1);
            if (DhNoteEvent_position(left) > pos) {
                vec_set(notes, i, left); vec_set(notes, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}
# insert a note handle into the clip (sorted) and raise max_note_duration.
fn dh_midi_clip_insert_note(self, e) {
    dh_midi_insert_note(DhMidiClip_notes(self), e);
    if (DhNoteEvent_duration(e) > DhMidiClip_max_note_duration(self)) {
        DhMidiClip_set_max_note_duration(self, DhNoteEvent_duration(e));
    }
    return 0;
}
fn dhvani_midi_clip_add_note(self, position, duration, note, velocity, channel) {
    dh_midi_clip_insert_note(self, dhvani_note_event_new(position, duration, note, velocity, channel));
    return 0;
}
fn dhvani_midi_clip_add_cc(self, position, controller, value, channel) {
    var ccs = DhMidiClip_control_changes(self);
    var e = dhvani_cc_new(position, controller, value, channel);
    vec_push(ccs, e);
    var i = vec_len(ccs) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(ccs, i - 1);
            if (DhControlChange_position(left) > position) {
                vec_set(ccs, i, left); vec_set(ccs, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}

# first index whose note position is >= x (binary search; sound because the
# notes are sorted by position). Returns vec_len when every note is before x.
fn dh_midi_lower_bound(notes, x) {
    var lo = 0;
    var hi = vec_len(notes);
    while (lo < hi) {
        var mid = lo + (hi - lo) / 2;
        if (DhNoteEvent_position(vec_get(notes, mid)) < x) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

# Query pruning (all four queries return exactly what a full linear filter over
# the notes would, in note order): a note with duration d <= max_note_duration
# that ends after `t` (position + d > t) must START after t - max_note_duration,
# so the scan begins at lower_bound(t - max_note_duration + 1); and because the
# notes are sorted it stops at the first note starting past the window.

# notes active at `frame` (position <= frame < position+duration) -> `out`
# (truncated first). Returns the match count. Zero-alloc once `out` has room.
fn dhvani_midi_clip_notes_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame - DhMidiClip_max_note_duration(self) + 1);
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p > frame) { break; }
        if (frame < p + DhNoteEvent_duration(e)) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_notes_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_notes_at_into(self, frame, out);
    return out;
}

# note-ons starting exactly at `frame` -> `out`. Returns the match count.
fn dhvani_midi_clip_note_ons_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame);
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) != frame) { break; }
        vec_push(out, e);
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_note_ons_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_note_ons_at_into(self, frame, out);
    return out;
}

# note-offs ending exactly at `frame` (position+duration == frame) -> `out`.
# Returns the match count. Only the lower bound is pruned: position = frame -
# duration >= frame - max_note_duration. There is no upper stop -- with an i64
# (possibly negative) duration a matching note may start after `frame`.
fn dhvani_midi_clip_note_offs_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame - DhMidiClip_max_note_duration(self));
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) + DhNoteEvent_duration(e) == frame) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_note_offs_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_note_offs_at_into(self, frame, out);
    return out;
}

# note events overlapping [start, end) -- position < end AND position+duration >
# start -- -> `out`. Returns the match count.
# PARITY NOTE: rust-old/src/midi/mod.rs:351 binary-searches
# `partition_point(|n| n.position + n.duration <= start)` over notes sorted by
# POSITION; end times are not monotone in that order, so the search can land
# past a long note that still overlaps (notes (0,1000),(100,10),(200,10) and
# [500,600): Rust returns [], the note at 0 is active). This port returns the
# correct overlap set; its binary search is on position, bounded by the tracked
# max_note_duration (see "Query pruning" above).
fn dhvani_midi_clip_events_in_range_into(self, start, end, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, start - DhMidiClip_max_note_duration(self) + 1);
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p >= end) { break; }
        if (p + DhNoteEvent_duration(e) > start) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_events_in_range(self, start, end) {
    var out = vec_new();
    dhvani_midi_clip_events_in_range_into(self, start, end, out);
    return out;
}

# merge another clip's notes+CCs (kept sorted); extend duration if needed.
# merge(c, c) is legal here (Rust's borrow checker forbids it): when `other` IS
# `self`, iterate a snapshot of the handles so the inserts don't shift the
# source under the loop.
# DIVERGES from rust-old (mod.rs:374), which extends to `other.notes.last()`'s
# end -- the note that STARTS last, not the one that ENDS last. This extends to
# the max position+duration over other's notes.
fn dhvani_midi_clip_merge(self, other) {
    var onotes = DhMidiClip_notes(other);
    var occs = DhMidiClip_control_changes(other);
    if (other == self) {
        var snap_n = vec_new();
        var si = 0;
        while (si < vec_len(onotes)) { vec_push(snap_n, vec_get(onotes, si)); si = si + 1; }
        var snap_c = vec_new();
        var sj = 0;
        while (sj < vec_len(occs)) { vec_push(snap_c, vec_get(occs, sj)); sj = sj + 1; }
        onotes = snap_n;
        occs = snap_c;
    }
    var nn = vec_len(onotes);
    var other_end = 0;
    var have_end = 0;
    var i = 0;
    while (i < nn) {
        var e = vec_get(onotes, i);
        var end_i = DhNoteEvent_position(e) + DhNoteEvent_duration(e);
        if (have_end == 0) { other_end = end_i; have_end = 1; }
        if (end_i > other_end) { other_end = end_i; }
        dh_midi_clip_insert_note(self,
          dhvani_note_event_new(
            DhNoteEvent_position(e),
            DhNoteEvent_duration(e),
            DhNoteEvent_note(e),
            DhNoteEvent_velocity(e),
            DhNoteEvent_channel(e)));
        i = i + 1;
    }
    var nc = vec_len(occs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(occs, j);
        dhvani_midi_clip_add_cc(
          self,
          DhControlChange_position(c),
          DhControlChange_controller(c),
          DhControlChange_value(c),
          DhControlChange_channel(c));
        j = j + 1;
    }
    if (have_end == 1) {
        if (other_end > DhMidiClip_duration(self)) { DhMidiClip_set_duration(self, other_end); }
    }
    return 0;
}

# transpose all notes by `semitones` (clamped to 0..127).
fn dhvani_midi_clip_transpose(self, semitones) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        var nn = DhNoteEvent_note(e) + semitones;
        if (nn < 0) { nn = 0; }
        if (nn > 127) { nn = 127; }
        DhNoteEvent_set_note(e, nn);
        i = i + 1;
    }
    return 0;
}

# quantize note+CC positions to the nearest grid boundary. No-op for grid 0.
fn dhvani_midi_clip_quantize(self, grid_frames) {
    if (grid_frames == 0) { return 0; }
    var half = grid_frames / 2;
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        DhNoteEvent_set_position(e, ((DhNoteEvent_position(e) + half) / grid_frames) * grid_frames);
        i = i + 1;
    }
    var ccs = DhMidiClip_control_changes(self);
    var nc = vec_len(ccs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(ccs, j);
        DhControlChange_set_position(c, ((DhControlChange_position(c) + half) / grid_frames) * grid_frames);
        j = j + 1;
    }
    return 0;
}
