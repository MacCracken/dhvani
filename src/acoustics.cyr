# acoustics.cyr -- goonj room-simulation / FDN / ambisonics bridged into
# dhvani's AudioBuffer + ConvolutionReverb. Ported from
# rust-old/src/acoustics/mod.rs. The Rust module is mostly `pub use goonj::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call goonj's bare
# symbols -- acoustic_room_shoebox / fdn_new / new_bformat_ir / write_wav_mono /
# generate_dhvani_ir / ... -- directly). Only the module's own bridge fns +
# room presets carry over.
#
# Requires (in dependency order before this unit): sakshi -> hisab -> goonj,
# then dhvani's error -> simd -> buffer -> fft -> analysis -> convolution.
# goonj IR structs (ImpulseResponse / MultibandIr / DhvaniIr / BFormatIr / Fdn /
# WavBytes) are goonj symbols; dhvani's ConvolutionReverb lives in convolution.cyr.

# ERRORS: the handle-returning bridges answer 0 on failure, the null-handle sentinel
# the other Wave F bridges use (export_ir_wav used to forward goonj's negative
# ERR_COMPUTATION). Every bridge refuses a goonj / dhvani handle <= 0 before
# reading it: goonj's accessors are raw field loads.

# ── Bridge: generate a DhvaniIr from (x,y,z) source/listener positions ──
# Rust `generate_ir((sx,sy,sz),(lx,ly,lz), room, config)` builds Vec3s and
# defers to goonj's generate_dhvani_ir. Here we take scalar coords, build
# hisab hvec3s, and call generate_dhvani_ir. 0 for a room / config handle <= 0.
#must_use
fn dhvani_acoustics_generate_ir(sx, sy, sz, lx, ly, lz, room, config) {
    if (room <= 0) { return 0; }
    if (config <= 0) { return 0; }
    var src = hvec3_new(sx, sy, sz);
    var lis = hvec3_new(lx, ly, lz);
    return generate_dhvani_ir(src, lis, room, config);
}

# ── Bridge: goonj ImpulseResponse -> dhvani ConvolutionReverb ──
# ConvolutionReverb::new(&ir.samples, mix, ir.sample_rate). 0 for an ir <= 0.
#must_use
fn dhvani_acoustics_convolution_from_ir(ir, mix) {
    if (ir <= 0) { return 0; }
    return dhvani_conv_new(ImpulseResponse_samples(ir), mix,
      ImpulseResponse_sample_rate(ir));
}

# ── Bridge: DhvaniIr (broadband) -> ConvolutionReverb ──
#must_use
fn dhvani_acoustics_convolution_from_dhvani_ir(ir, mix) {
    if (ir <= 0) { return 0; }
    return dhvani_acoustics_convolution_from_ir(dhvani_ir_ir(ir), mix);
}

# ── Bridge: MultibandIr (collapsed to broadband) -> ConvolutionReverb ──
# The reusable form of convolve_multiband: build once, then dhvani_conv_process
# per block -- the reverb carries its tail across blocks, allocates nothing in
# steady state, and delays its output by dhvani_conv_latency_frames (one block).
# 0 for a multiband <= 0.
#must_use
fn dhvani_acoustics_convolution_from_multiband(multiband, mix) {
    if (multiband <= 0) { return 0; }
    var broadband = multiband_ir_to_broadband(multiband);
    return dhvani_conv_new(ImpulseResponse_samples(broadband), mix,
      ImpulseResponse_sample_rate(broadband));
}

# ── Multiband convolution (OFFLINE) ──
# Collapse the MultibandIr to a broadband IR, build a ConvolutionReverb, and
# convolve the buffer in place, aligned with its input. OFFLINE / one-shot: it builds
# a reverb (IR partitions + per-channel delay line, megabytes for a long IR) on EVERY
# call, which the bump allocator never reclaims, and each call starts with an empty
# tail. For per-block use build one with dhvani_acoustics_convolution_from_multiband
# and stream it with dhvani_conv_process (one block of latency).
#
# It runs dhvani_conv_render: every frame is convolved, the last partial block
# included, with no added latency. rust-old returned the last frames % 512 frames raw
# (2.3.2 padded to whole blocks to fix that; 2.3.3's render does it for any length).
# Returns DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for a null buffer, a
# multiband <= 0, or a buffer whose samples do not cover frames * channels.
fn dhvani_acoustics_convolve_multiband(buf, multiband, mix) {
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (multiband <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var reverb = dhvani_acoustics_convolution_from_multiband(multiband, mix);
    return dhvani_conv_render(reverb, buf);
}

# ── FDN reverb over an AudioBuffer ──
# Sum channels to mono per frame, run through the FDN, mix wet back into all
# channels. mix is clamped to [0,1]. Walks the sample storage (no per-sample vec
# call), in the same order and with the same arithmetic as before -- bit-identical.
# Alloc-free. 0, or DHVANI_ERR_INVALID_PARAMETER for an fdn <= 0, a null buffer, or
# a buffer whose samples do not cover frames * channels.
fn dhvani_acoustics_process_fdn(fdn, buf, mix) {
    if (fdn <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var m = f64_clamp(mix, 0, 1.0);
    var dry = f64_sub(1.0, m);
    var ch = DhAudioBuffer_channels(buf);
    var chmax = ch;
    if (chmax < 1) { chmax = 1; }
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (ch > 0) {
        if (frames * ch > vec_len(samples)) { return DHVANI_ERR_INVALID_PARAMETER; }
    }
    var div = f64_from(chmax);
    var p = dh_vec_data(samples);

    var frame = 0;
    while (frame < frames) {
        var mono_in = 0;
        var q = p;
        var qend = p + ch * 8;
        while (q < qend) {
            mono_in = f64_add(mono_in, load64(q));
            q = q + 8;
        }
        mono_in = f64_div(mono_in, div);

        var wet = fdn_process_sample(fdn, mono_in);
        var wm = f64_mul(wet, m);

        q = p;
        while (q < qend) {
            store64(q, f64_add(f64_mul(load64(q), dry), wm));
            q = q + 8;
        }
        p = qend;
        frame = frame + 1;
    }
    return 0;
}

# ── Ambisonics: decode a B-Format IR to a stereo AudioBuffer ──
# Cardioid decode: L = W + Y, R = W - Y. Returns 0 on length mismatch, buffer
# construction failure, or a bformat <= 0. One exact allocation for the samples.
#must_use
fn dhvani_acoustics_decode_bformat_stereo(bformat) {
    if (bformat <= 0) { return 0; }
    var w = BFormatIr_w(bformat);
    var y = BFormatIr_y(bformat);
    var len = vec_len(w);
    if (vec_len(y) != len) { return 0; }

    var samples = dh_vec_zeros(len * 2);
    if (vec_len(samples) != len * 2) { return 0; }
    var wp = dh_vec_data(w);
    var yp = dh_vec_data(y);
    var d = dh_vec_data(samples);
    var wend = wp + len * 8;
    while (wp < wend) {
        var wv = load64(wp);
        var yv = load64(yp);
        store64(d, f64_add(wv, yv));
        store64(d + 8, f64_sub(wv, yv));
        wp = wp + 8;
        yp = yp + 8;
        d = d + 16;
    }
    return dhvani_buffer_from_interleaved(samples, 2, BFormatIr_sample_rate(bformat));
}

# ── WAV export ──
# Write the IR as a 16-bit PCM mono WAV; returns a goonj WavBytes handle
# (data pointer + byte length), or 0 when goonj refuses (bad sample rate, data
# over 4 GiB, a refused allocation) or for an ir <= 0. The Rust version writes
# into a std::io::Write; in Cyrius write_wav_mono materializes the bytes.
#must_use
fn dhvani_acoustics_export_ir_wav(ir) {
    if (ir <= 0) { return 0; }
    var w = write_wav_mono(ImpulseResponse_samples(ir),
      ImpulseResponse_sample_rate(ir));
    if (w <= 0) { return 0; }
    return w;
}

# ── Room presets (goonj AcousticRoom + AcousticMaterial) ──
#must_use
fn dhvani_acoustics_preset_studio() {
    return acoustic_room_shoebox(4.5, 3.5, 2.8, acoustic_material_carpet());
}
#must_use
fn dhvani_acoustics_preset_rehearsal_room() {
    return acoustic_room_shoebox(8.0, 5.0, 3.0, acoustic_material_wood());
}
#must_use
fn dhvani_acoustics_preset_concert_hall() {
    return acoustic_room_shoebox(f64_from(40), f64_from(25), f64_from(15),
      acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_bathroom() {
    return acoustic_room_shoebox(2.5, f64_from(2), 2.4, acoustic_material_glass());
}
#must_use
fn dhvani_acoustics_preset_cathedral() {
    return acoustic_room_shoebox(f64_from(60), f64_from(30), f64_from(28),
      acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_outdoor() {
    return acoustic_room_shoebox(f64_from(100), f64_from(100), f64_from(50),
      acoustic_material_carpet());
}
