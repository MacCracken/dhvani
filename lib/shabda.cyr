    _shabda_en_r(t, "", "o", "", "AA1");
    # p
    _shabda_en_r(t, "p", "p", "", "");
    _shabda_en_r(t, "", "ph", "", "F");
    _shabda_en_r(t, "", "peop", "", "P IY1 P");
