# ================================================================
# Spanish G2P rules — ports spanish_rules(). Accented codepoints (2-byte UTF-8):
#   á=0xE1 é=0xE9 í=0xED ó=0xF3 ú=0xFA ü=0xFC ñ=0xF1. ASCII-lower leaves them
#   as-is (already lowercase in inputs), matching Rust's word.to_lowercase().
#
# Phonemic, standard Castilian: distinción (c before e/i and z are /θ/, s is /s/), the jota
# /x/, and yeísmo (ll and consonantal y are one phoneme, /ʝ/). Five vowels /a e i o u/ are
# svara's VOWEL_A/E/I/O/U; an unaccented i or u next to another vowel is the glide /j/ or /w/
# (quién, fuego, aire, auto; in iu/ui the second vowel is the nucleus: ciudad, cuidado). The
# allophones [β ð ɣ] and nasal place assimilation are not written: /b d ɡ/ and /n/ are.
# Accuracy over the Rust (ADR-0002): the Rust spelled a e i u with English vowels (ɑ ɛ ɪ ʌ),
# ñ /ŋ/, ll and y /j/, the jota /h/, and the glides as full vowels.
# svara has no velar /x/: the jota is FRIC_UVULAR_CH (χ), the realization north and central
# Spain give it, and a dorsal fricative where FRIC_H is a glottal one.
# ================================================================

# 1 if `cp` is a Spanish vowel letter, accented or not (ü included).
#must_use
fn _shabda_es_is_vowel(cp): i64 {
    if (_shabda_is_vowel_char(cp) == 1) { return 1; }
    if (cp == 0xE1 || cp == 0xE9 || cp == 0xED || cp == 0xF3 || cp == 0xFA || cp == 0xFC) { return 1; }
    return 0;
}

# 1 if `cp` is e, i, é or í: the letters that make c /θ/, g /x/ and the u of gu / qu silent.
#must_use
fn _shabda_es_is_front(cp): i64 {
    if (cp == 0x65 || cp == 0x69 || cp == 0xE9 || cp == 0xED) { return 1; }
    return 0;
}

# 1 if `cp` is a, e or o, accented or not: a vowel an unaccented i or u next to it glides into.
#must_use
fn _shabda_es_is_strong(cp): i64 {
    if (cp == 0x61 || cp == 0x65 || cp == 0x6F || cp == 0xE1 || cp == 0xE9 || cp == 0xF3) { return 1; }
    return 0;
}

# 1 if the unaccented i or u at chars[pos] is a glide: a vowel follows it (quién, fuego, cuidar,
# ciudad), or a, e or o comes before it (aire, reina, auto, deuda). Written stress (día, país,
# baúl) marks a full vowel, which is why only the unaccented letters reach here.
#must_use
fn _shabda_es_is_glide(chars, pos): i64 {
    if (_shabda_es_is_vowel(_shabda_cp_at(chars, pos + 1)) == 1) { return 1; }
    if (_shabda_es_is_strong(_shabda_cp_at(chars, pos - 1)) == 1) { return 1; }
    return 0;
}

# 1 if the single r at chars[pos] is the Spanish trill: at the start of the word, or after n, l
# or s. Through 3.1.1, as in the Rust, every single r was the tap and rr was svara's English
# approximant /ɹ/; svara has the trill now (SVARA_PH_TRILL_ALVEOLAR).
fn _shabda_spanish_r_is_trill(chars, pos): i64 {
    if (pos == 0) { return 1; }
    var prev = vec_get(chars, pos - 1);
    if (prev == 0x6E || prev == 0x6C || prev == 0x73) { return 1; }
    return 0;
}

# Spanish pattern match at `pos`. Pushes phonemes onto `out`, returns consumed.
fn _shabda_spanish_match_a(a, chars, pos, out): i64 {
    var n = vec_len(chars);
    var rem = n - pos;
    if (rem <= 0) { return 1; }

    var c0 = vec_get(chars, pos);
    var next = _shabda_cp_at(chars, pos + 1);

    # 2-letter digraphs first.
    if (rem >= 2) {
        if (c0 == 0x63) { if (next == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_AFFR_CH); return 2; } }   # ch
        # ll: /ʝ/, one phoneme with consonantal y (yeísmo)
        if (c0 == 0x6C) { if (next == 0x6C) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_PALATAL_J); return 2; } }
        # rr: the alveolar trill /r/
        if (c0 == 0x72) { if (next == 0x72) { _shabda_vec_push_a(a, out, SVARA_PH_TRILL_ALVEOLAR); return 2; } }
        if (c0 == 0x71) { if (next == 0x75) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 2; } } # qu
        # gu before e/i/é/í: u silent, g -> /g/ (guerra, guía); gü keeps the u as /w/
        if (c0 == 0x67) {
            if (next == 0x75) {
                if (_shabda_es_is_front(_shabda_cp_at(chars, pos + 2)) == 1) {
                    _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_G); return 2;
                }
            }
        }
    }

    # Vowels and glides.
    if (c0 == 0x61) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_A); return 1; }        # a
    if (c0 == 0xE1) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_A); return 1; }        # á
    if (c0 == 0x65) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_E); return 1; }        # e
    if (c0 == 0xE9) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_E); return 1; }        # é
    if (c0 == 0x6F) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_O); return 1; }        # o
    if (c0 == 0xF3) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_O); return 1; }        # ó
    if (c0 == 0xED) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_I); return 1; }        # í
    if (c0 == 0xFA) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U); return 1; }        # ú
    if (c0 == 0x69) {                                                     # i: /i/ or the glide /j/
        if (_shabda_es_is_glide(chars, pos) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_J); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_I); return 1;
    }
    if (c0 == 0x75) {                                                     # u: /u/ or the glide /w/
        if (_shabda_es_is_glide(chars, pos) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_W); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U); return 1;
    }
    if (c0 == 0xFC) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_W); return 1; }       # ü: gü /ɡw/

    # Consonants.
    if (c0 == 0x62) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_B); return 1; }      # b
    if (c0 == 0x76) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_B); return 1; }      # v
    if (c0 == 0x63) {                                                     # c: /θ/ before e/i
        if (_shabda_es_is_front(next) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_TH); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1;
    }
    if (c0 == 0x64) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_D); return 1; }      # d
    if (c0 == 0x66) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_F); return 1; }         # f
    if (c0 == 0x67) {                                                     # g: the jota before e/i
        if (_shabda_es_is_front(next) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_UVULAR_CH); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_G); return 1;
    }
    if (c0 == 0x68) { return 1; }                                        # h — silent
    if (c0 == 0x6A) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_UVULAR_CH); return 1; } # j: the jota /x/
    if (c0 == 0x6B) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1; }      # k
    if (c0 == 0x6C) { _shabda_vec_push_a(a, out, SVARA_PH_LATERAL_L); return 1; }      # l
    if (c0 == 0x6D) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_M); return 1; }        # m
    if (c0 == 0x6E) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N); return 1; }        # n
    if (c0 == 0xF1) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_PALATAL); return 1; }  # ñ /ɲ/
    if (c0 == 0x70) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_P); return 1; }      # p
    # r: the trill /r/ at the start of a word and after n, l or s (rojo, honra, alrededor,
    # Israel), the tap /ɾ/ everywhere else (pero, caro). rr is the trill above.
    if (c0 == 0x72) {
        if (_shabda_spanish_r_is_trill(chars, pos) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_TRILL_ALVEOLAR);
        } else {
            _shabda_vec_push_a(a, out, SVARA_PH_TAP_FLAP);
        }
        return 1;
    }
    if (c0 == 0x73) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1; }         # s
    if (c0 == 0x74) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 1; }      # t
    if (c0 == 0x77) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_W); return 1; }       # w
    if (c0 == 0x78) {                                                     # x: /s/ word-initially, else /ks/
        if (pos == 0) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
    }
    if (c0 == 0x79) {                                                     # y
        # /ʝ/ before a vowel (yo, mayo, cónyuge); the glide /j/ after one (hoy, muy, rey);
        # the vowel /i/ alone (the word y) or before a consonant.
        if (_shabda_es_is_vowel(next) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_PALATAL_J); return 1; }
        if (_shabda_es_is_vowel(_shabda_cp_at(chars, pos - 1)) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_APPROX_J); return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_I); return 1;
    }
    if (c0 == 0x7A) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_TH); return 1; }        # z Castilian /θ/
    if (c0 == 0x27) { return 1; }                                        # '
    if (c0 == 0x2D) { return 1; }                                        # -
    return 1;
}

# Public Spanish engine. Ports spanish_rules().
#must_use
fn shabda_spanish_rules(word): i64 {
    return _shabda_spanish_rules_a(default_alloc(), word);
}

# shabda_spanish_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_spanish_rules_a(a, word): i64 {
    var chars = _shabda_word_chars_a(a, word);
    if (vec_len(chars) == 0) {
        return vec_new_a(a);
    }
    var phonemes = vec_new_a(a);
    var i = 0;
    var n = vec_len(chars);
    while (i < n) {
        var consumed = _shabda_spanish_match_a(a, chars, i, phonemes);
        i = i + consumed;
    }
    return phonemes;
}

# ================================================================
# German G2P rules — ports german_rules(). Accented codepoints (2-byte UTF-8):
#   ä=0xE4 ö=0xF6 ü=0xFC ß=0xDF á=0xE1.
#
# Phonemic Standard German. Two passes: the word's vowel nuclei are found first (digraphs ie
# ei ey ai ay au eu äu aa ee oo are one nucleus), and an unstressed prefix (be- ge- ver- zer-
# er- ent-) before a stem with a full vowel; then each letter is spelled with that context:
#   - a stressed vowel is long (tense) before h, ß, a vowel, the end of the word, one consonant
#     and a vowel, or b / d / g and a consonant (lebt, gibt, möglich); short (lax) before a
#     double consonant, a cluster, ch / sch / x, and one final consonant in a short function
#     word (in, mit, das). Long / short: iː ɪ, eː ɛ, oː ɔ, uː ʊ, øː œ; a is /a/ either way, ä
#     is /ɛ/, ü and y are /y/ (svara has no ʏ).
#   - e is /ə/ in the prefixes be- ge-, in a final -e -en -el -er -em -es -et -est -ern -eln
#     -ens -ert -elt -end, and unstressed before r l n s (anderen, Lehrerin, Gelegenheit).
#   - r is /ʁ/, ch is the ich-Laut /ç/ after front vowels, consonants and in -ig, the ach-Laut
#     /x/ after a o u au; z / tz are /t͡s/, pf /p͡f/, tsch /t͡ʃ/, ng /ŋ/, n before k /ŋ/, chs /ks/,
#     sp / st /ʃp ʃt/ at the start of the word or stem; b d g devoice before an obstruent, at
#     the end and before -lich -ling -los -nis; s before a vowel is /z/ unless an obstruent
#     precedes it; h after a vowel is silent.
# svara has no velar /x/: the ach-Laut is FRIC_UVULAR_CH (χ), its own realization after a, and
# a dorsal fricative where FRIC_H is a glottal one. The vocalized r [ɐ] (Wasser, wir) is not
# written: svara has no ɐ, and /əʁ/, /ʁ/ are the phonemes. Accuracy over the Rust (ADR-0002):
# the Rust spelled a /ɑ/, every e /ɛ/, o and u long, ö /ɛ/, r English /ɹ/, ch /ʃ/, z /t s/,
# pf /p f/, ng /n ɡ/, x /k/, had no au, and devoiced only the last phoneme.
# ================================================================

# German vowel letter? (y included; a consonantal y is the caller's to rule out.)
#must_use
fn _shabda_de_is_vowel(cp): i64 {
    if (_shabda_is_vowel_char(cp) == 1) { return 1; }
    if (cp == 0xE4 || cp == 0xF6 || cp == 0xFC || cp == 0x79 || cp == 0xE1) { return 1; }
    return 0;
}

# Length in letters of the vowel nucleus at chars[pos]: 2 for ie ei ey ai ay au eu äu aa ee oo.
#must_use
fn _shabda_de_nucleus_len(chars, pos): i64 {
    var c0 = _shabda_cp_at(chars, pos);
    var c1 = _shabda_cp_at(chars, pos + 1);
    if (c0 == 0x69 && c1 == 0x65) { return 2; }                                    # ie
    if (c0 == 0x65) { if (c1 == 0x69 || c1 == 0x79 || c1 == 0x75 || c1 == 0x65) { return 2; } }   # ei ey eu ee
    if (c0 == 0x61) { if (c1 == 0x69 || c1 == 0x79 || c1 == 0x75 || c1 == 0x61) { return 2; } }   # ai ay au aa
    if (c0 == 0xE4 && c1 == 0x75) { return 2; }                                    # äu
    if (c0 == 0x6F && c1 == 0x6F) { return 2; }                                    # oo
    return 1;
}

# 1 if the y at chars[pos] is the consonant /j/: word-initial before a vowel (Yacht).
#must_use
fn _shabda_de_y_consonant(chars, pos): i64 {
    if (pos != 0) { return 0; }
    if (_shabda_cp_at(chars, 0) != 0x79) { return 0; }
    return _shabda_de_is_vowel(_shabda_cp_at(chars, 1));
}

# Push the start position and letter length of every vowel nucleus onto `nuc` / `nl`.
# The u of qu is a consonant (/kv/), so it is skipped.
fn _shabda_de_scan_a(a, chars, nuc, nl): i64 {
    var n = vec_len(chars);
    var i = 0;
    while (i < n) {
        var c = vec_get(chars, i);
        if (c == 0x71 && _shabda_cp_at(chars, i + 1) == 0x75) {
            i = i + 2;
        } elif (_shabda_de_is_vowel(c) == 1 && _shabda_de_y_consonant(chars, i) == 0) {
            var len = _shabda_de_nucleus_len(chars, i);
            _shabda_vec_push_a(a, nuc, i);
            _shabda_vec_push_a(a, nl, len);
            i = i + len;
        } else {
            i = i + 1;
        }
    }
    return 0;
}

# 1 if chars[from..] is a coda the unstressed final syllable -e… takes: nothing, n l r m s t,
# st nd ns rn rs ls ln rt lt, nds rst (Sonne, leben, Vogel, Wasser, alles, Eltern, abends).
#must_use
fn _shabda_de_schwa_coda(chars, from): i64 {
    var m = vec_len(chars) - from;
    var r0 = _shabda_cp_at(chars, from);
    var r1 = _shabda_cp_at(chars, from + 1);
    var r2 = _shabda_cp_at(chars, from + 2);
    if (m == 0) { return 1; }
    if (m == 1) {
        if (r0 == 0x6E || r0 == 0x6C || r0 == 0x72 || r0 == 0x6D || r0 == 0x73 || r0 == 0x74) { return 1; }
        return 0;
    }
    if (m == 2) {
        if (r1 == 0x74) { if (r0 == 0x73 || r0 == 0x72 || r0 == 0x6C) { return 1; } }      # st rt lt
        if (r1 == 0x73) { if (r0 == 0x6E || r0 == 0x72 || r0 == 0x6C) { return 1; } }      # ns rs ls
        if (r0 == 0x6E && r1 == 0x64) { return 1; }                                        # nd
        if (r0 == 0x72 && r1 == 0x6E) { return 1; }                                        # rn
        if (r0 == 0x6C && r1 == 0x6E) { return 1; }                                        # ln
        return 0;
    }
    if (m == 3) {
        if (r0 == 0x6E && r1 == 0x64 && r2 == 0x73) { return 1; }                          # nds
        if (r0 == 0x72 && r1 == 0x73 && r2 == 0x74) { return 1; }                          # rst
    }
    return 0;
}

# 1 if the last nucleus is a single e with a schwa coda, in a word of 2+ nuclei.
#must_use
fn _shabda_de_last_is_schwa(chars, nuc, nl): i64 {
    var k = vec_len(nuc);
    if (k < 2) { return 0; }
    var p = vec_get(nuc, k - 1);
    if (vec_get(nl, k - 1) != 1) { return 0; }
    if (vec_get(chars, p) != 0x65) { return 0; }
    return _shabda_de_schwa_coda(chars, p + 1);
}

# Nuclei from index `from` on that carry a full vowel: all of them but a final schwa.
#must_use
fn _shabda_de_full_after(chars, nuc, nl, from): i64 {
    var full = vec_len(nuc) - from;
    if (full <= 0) { return 0; }
    if (_shabda_de_last_is_schwa(chars, nuc, nl) == 1) { full = full - 1; }
    return full;
}

# 1 if chars[from..to) is a German syllable onset (the consonants a prefix can stand before).
#must_use
fn _shabda_de_onset_ok(chars, from, to): i64 {
    var m = to - from;
    var o0 = _shabda_cp_at(chars, from);
    var o1 = _shabda_cp_at(chars, from + 1);
    var o2 = _shabda_cp_at(chars, from + 2);
    var o3 = _shabda_cp_at(chars, from + 3);
    if (m == 1) {
        if (o0 == 0x78 || o0 == 0xDF) { return 0; }                                        # x ß
        return 1;
    }
    var sch = 0;
    if (o0 == 0x73 && o1 == 0x63 && o2 == 0x68) { sch = 1; }
    if (m == 2) {
        if (o0 == 0x73) { if (o1 == 0x74 || o1 == 0x70) { return 1; } }                    # st sp
        if (o1 == 0x72) {                                                                   # br dr fr gr kr pr tr
            if (o0 == 0x62 || o0 == 0x64 || o0 == 0x66 || o0 == 0x67 || o0 == 0x6B || o0 == 0x70 || o0 == 0x74) {
                return 1;
            }
        }
        if (o1 == 0x6C) {                                                                   # bl fl gl kl pl
            if (o0 == 0x62 || o0 == 0x66 || o0 == 0x67 || o0 == 0x6B || o0 == 0x70) { return 1; }
        }
        if (o0 == 0x6B && o1 == 0x6E) { return 1; }                                        # kn
        if (o0 == 0x7A && o1 == 0x77) { return 1; }                                        # zw
        if (o0 == 0x70 && o1 == 0x66) { return 1; }                                        # pf
        if (o0 == 0x71 && o1 == 0x75) { return 1; }                                        # qu
        return 0;
    }
    if (m == 3) {
        if (sch == 1) { return 1; }                                                         # sch
        if (o0 == 0x73 && o2 == 0x72) { if (o1 == 0x74 || o1 == 0x70) { return 1; } }      # str spr
        if (o0 == 0x70 && o1 == 0x66) { if (o2 == 0x6C || o2 == 0x72) { return 1; } }      # pfl pfr
        return 0;
    }
    if (m == 4) {
        if (sch == 1) {                                                                     # schw schl schr schm schn
            if (o3 == 0x77 || o3 == 0x6C || o3 == 0x72 || o3 == 0x6D || o3 == 0x6E) { return 1; }
        }
    }
    return 0;
}

# The unstressed prefix the word starts with, packed as length | (kind << 8): kind 1 is be- /
# ge- (its e is /ə/), kind 2 is ver- zer- er- ent- (its e is /ɛ/); 0 if none. A prefix needs a
# stem with a full vowel after it, so geben, gegen, beste, gestern, Ente, erste have none, and
# be- / ge- need an onset after them (bestimmt, Geschichte; not Berlin, gern).
#must_use
fn _shabda_de_prefix(chars, nuc, nl): i64 {
    if (vec_len(nuc) < 2) { return 0; }
    if (vec_get(nl, 0) != 1) { return 0; }
    var n0 = vec_get(nuc, 0);
    var c0 = _shabda_cp_at(chars, 0);
    var c1 = _shabda_cp_at(chars, 1);
    var c2 = _shabda_cp_at(chars, 2);
    var c3 = _shabda_cp_at(chars, 3);
    var full = _shabda_de_full_after(chars, nuc, nl, 1);
    if (full < 1) { return 0; }
    if ((c0 == 0x62 || c0 == 0x67) && c1 == 0x65 && n0 == 1) {                             # be- ge-
        var s1 = vec_get(nuc, 1);
        if (s1 == 2) {
            # hiatus: beachten, beobachten, geöffnet
            if (c2 == 0x61 || c2 == 0x6F || c2 == 0xE4 || c2 == 0xF6 || c2 == 0xFC) { return 2 | (1 << 8); }
            return 0;
        }
        if (_shabda_de_onset_ok(chars, 2, s1) == 1) { return 2 | (1 << 8); }
        return 0;
    }
    if ((c0 == 0x76 || c0 == 0x7A) && c1 == 0x65 && c2 == 0x72 && n0 == 1) {              # ver- zer-
        if (c0 == 0x7A && _shabda_de_is_vowel(c3) == 1) { return 0; }
        return 3 | (2 << 8);
    }
    if (c0 == 0x65 && c1 == 0x6E && c2 == 0x74 && n0 == 0) { return 3 | (2 << 8); }      # ent-
    if (c0 == 0x65 && c1 == 0x72 && n0 == 0) { return 2 | (2 << 8); }                     # er-
    return 0;
}

# Index of the nucleus that starts at `pos`, or -1.
#must_use
fn _shabda_de_nucleus_index(nuc, pos): i64 {
    var k = 0;
    while (k < vec_len(nuc)) {
        if (vec_get(nuc, k) == pos) { return k; }
        k = k + 1;
    }
    return (0 - 1);
}

# 1 if the single-letter e nucleus at `pos` is /ə/: a final -e -en -el -er … syllable, or an
# unstressed e before one r l n s (anderen, Lehrerin, Gelegenheit, Bundestag). The stressed
# nucleus is the first, or the first after a prefix.
#must_use
fn _shabda_de_is_schwa(ctx, pos): i64 {
    var chars = load64(ctx);
    var nuc = load64(ctx + 8);
    var nl = load64(ctx + 16);
    var stressed = 0;
    if (load64(ctx + 24) > 0) { stressed = 1; }
    var k = _shabda_de_nucleus_index(nuc, pos);
    var last = vec_len(nuc) - 1;
    if (k <= stressed) { return 0; }
    if (k == last) { return _shabda_de_schwa_coda(chars, pos + 1); }
    var nx = _shabda_cp_at(chars, pos + 1);
    if (nx == 0x72 || nx == 0x6C || nx == 0x6E || nx == 0x73) {
        if (_shabda_cp_at(chars, pos + 2) != nx) { return 1; }
    }
    return 0;
}

# 1 if the word is a short-vowel function word ending in one consonant (an am ab es im in ob
# um, bin bis das des hat hin man mit von vom was zum): elsewhere that vowel is long.
#must_use
fn _shabda_de_short_word(chars): i64 {
    var n = vec_len(chars);
    var c0 = _shabda_cp_at(chars, 0);
    var c1 = _shabda_cp_at(chars, 1);
    var c2 = _shabda_cp_at(chars, 2);
    if (n == 2) {
        if (c0 == 0x61) { if (c1 == 0x6E || c1 == 0x6D || c1 == 0x62) { return 1; } }      # an am ab
        if (c0 == 0x69) { if (c1 == 0x6E || c1 == 0x6D) { return 1; } }                   # in im
        if (c0 == 0x65 && c1 == 0x73) { return 1; }                                        # es
        if (c0 == 0x6F && c1 == 0x62) { return 1; }                                        # ob
        if (c0 == 0x75 && c1 == 0x6D) { return 1; }                                        # um
        return 0;
    }
    if (n != 3) { return 0; }
    if (c1 == 0x61) {                                                                       # das hat man was
        if (c0 == 0x64 && c2 == 0x73) { return 1; }
        if (c0 == 0x68 && c2 == 0x74) { return 1; }
        if (c0 == 0x6D && c2 == 0x6E) { return 1; }
        if (c0 == 0x77 && c2 == 0x73) { return 1; }
    }
    if (c1 == 0x69) {                                                                       # bin bis hin mit
        if (c0 == 0x62) { if (c2 == 0x6E || c2 == 0x73) { return 1; } }
        if (c0 == 0x68 && c2 == 0x6E) { return 1; }
        if (c0 == 0x6D && c2 == 0x74) { return 1; }
    }
    if (c0 == 0x64 && c1 == 0x65 && c2 == 0x73) { return 1; }                              # des
    if (c0 == 0x76 && c1 == 0x6F) { if (c2 == 0x6E || c2 == 0x6D) { return 1; } }         # von vom
    if (c0 == 0x7A && c1 == 0x75 && c2 == 0x6D) { return 1; }                              # zum
    return 0;
}

# 1 if the g at chars[gpos] ends the suffix -ig, which is /ɪç/: at the end, or before t s st
# keit (König, zwanzig, fertigt, Ewigkeit). Not in ei / ie (Teig, Sieg), not in a monosyllable.
#must_use
fn _shabda_de_ig_final(chars, nuc, gpos): i64 {
    if (_shabda_cp_at(chars, gpos) != 0x67) { return 0; }
    if (_shabda_cp_at(chars, gpos - 1) != 0x69) { return 0; }
    var pre = _shabda_cp_at(chars, gpos - 2);
    if (pre == 0x65 || pre == 0x61) { return 0; }
    if (vec_len(nuc) < 2) { return 0; }
    var m = vec_len(chars) - gpos - 1;
    var r0 = _shabda_cp_at(chars, gpos + 1);
    var r1 = _shabda_cp_at(chars, gpos + 2);
    if (m == 0) { return 1; }
    if (m == 1) { if (r0 == 0x74 || r0 == 0x73) { return 1; } }
    if (m == 2) { if (r0 == 0x73 && r1 == 0x74) { return 1; } }
    if (m == 4) {
        if (r0 == 0x6B && r1 == 0x65 && _shabda_cp_at(chars, gpos + 3) == 0x69) {
            if (_shabda_cp_at(chars, gpos + 4) == 0x74) { return 1; }
        }
    }
    return 0;
}

# 1 if chars[pos..] starts with the 3- or 4-letter ASCII string packed in `lit` (low byte
# first) of length `len`.
#must_use
fn _shabda_de_starts(chars, pos, lit, len): i64 {
    var i = 0;
    while (i < len) {
        if (_shabda_cp_at(chars, pos + i) != ((lit >> (i * 8)) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if a b / d / g before chars[q] is devoiced (Auslautverhärtung): at the end of the word,
# before an obstruent letter, or before the suffixes -lich -ling -los -nis.
#must_use
fn _shabda_de_devoice(chars, q): i64 {
    var c = _shabda_cp_at(chars, q);
    if (c == (0 - 1)) { return 1; }
    if (c == 0x62 || c == 0x63 || c == 0x64 || c == 0x66 || c == 0x67 || c == 0x68 || c == 0x6B) { return 1; }
    if (c == 0x70 || c == 0x71 || c == 0x73 || c == 0x74 || c == 0x76 || c == 0x77 || c == 0x78) { return 1; }
    if (c == 0x7A || c == 0xDF) { return 1; }
    if (_shabda_de_starts(chars, q, 0x6863696C, 4) == 1) { return 1; }                       # lich
    if (_shabda_de_starts(chars, q, 0x676E696C, 4) == 1) { return 1; }                       # ling
    if (_shabda_de_starts(chars, q, 0x736F6C, 3) == 1) { return 1; }                         # los
    if (_shabda_de_starts(chars, q, 0x73696E, 3) == 1) { return 1; }                         # nis
    return 0;
}

# 1 if the vowel at `pos` is short in an unstressed suffix whose consonant would make it long:
# i before g (Königin, wenige), -erin (Lehrerin), -nis (Ergebnis); and final -um (warum,
# Datum), except the suffix -tum after a consonant (Reichtum, Irrtum).
#must_use
fn _shabda_de_short_suffix(ctx, pos): i64 {
    var chars = load64(ctx);
    var n = vec_len(chars);
    var v = vec_get(chars, pos);
    var nx = _shabda_cp_at(chars, pos + 1);
    if (v == 0x75 && nx == 0x6D && pos + 2 == n) {                                          # -um
        if (_shabda_cp_at(chars, pos - 1) == 0x74 && pos >= 2) {
            if (_shabda_de_is_vowel(_shabda_cp_at(chars, pos - 2)) == 0) { return 0; }    # -tum
        }
        return 1;
    }
    if (v != 0x69) { return 0; }
    var stressed = 0;
    if (load64(ctx + 24) > 0) { stressed = 1; }
    if (_shabda_de_nucleus_index(load64(ctx + 8), pos) <= stressed) { return 0; }
    if (nx == 0x67) { return 1; }                                                           # i before g
    if (pos + 2 != n) { return 0; }
    var p1 = _shabda_cp_at(chars, pos - 1);
    if (nx == 0x6E && p1 == 0x72 && _shabda_cp_at(chars, pos - 2) == 0x65) { return 1; }  # -erin
    if (nx == 0x73 && p1 == 0x6E) { return 1; }                                            # -nis
    return 0;
}

# 1 if the single-letter vowel nucleus at `pos` (stressed or full, not /ə/) is long.
#must_use
fn _shabda_de_is_long(ctx, pos): i64 {
    var chars = load64(ctx);
    var nuc = load64(ctx + 8);
    var pfx = load64(ctx + 24) & 0xFF;
    var n = vec_len(chars);
    var q = pos + 1;
    if (q >= n) { return 1; }
    var c = vec_get(chars, q);
    if (_shabda_de_is_vowel(c) == 1) { return 1; }                                         # hiatus
    if (c == 0x68 && q != pfx) { return 1; }                                               # lengthening h
    if (c == 0xDF) { return 1; }                                                            # ß
    if (_shabda_de_short_suffix(ctx, pos) == 1) { return 0; }
    if (_shabda_de_ig_final(chars, nuc, q) == 1) { return 0; }                             # -ig
    var c1 = _shabda_cp_at(chars, q + 1);
    if (c == 0x63 && c1 == 0x68) {                                                          # ch: short, but u + ch
        if (vec_get(chars, pos) == 0x75) {
            if (q + 2 >= n || _shabda_de_is_vowel(_shabda_cp_at(chars, q + 2)) == 1) { return 1; }
        }
        return 0;
    }
    if (c == 0x78) { return 0; }                                                            # x /ks/
    if (c == 0x71) { return 0; }                                                            # qu /kv/
    if (c == 0x73 && c1 == 0x63) { return 0; }                                              # sch
    var ulen = 1;
    if (c1 == 0x68) { if (c == 0x70 || c == 0x74) { ulen = 2; } }                          # ph th: one consonant
    var after = _shabda_cp_at(chars, q + ulen);
    if (after == (0 - 1)) {                                                                 # one final consonant
        if (_shabda_de_short_word(chars) == 1) { return 0; }
        return 1;
    }
    if (_shabda_de_is_vowel(after) == 1) { return 1; }                                     # open syllable
    if (after == c) { return 0; }                                                           # double consonant
    if (c == 0x62 || c == 0x67) { return 1; }                                               # lebt, gibt, möglich
    if (c == 0x64 && after != 0x74) { return 1; }                                           # Adler (not dt)
    return 0;
}

# Push the vowel nucleus at `pos`; returns its letter length.
fn _shabda_de_vowel_a(a, ctx, pos, out): i64 {
    var chars = load64(ctx);
    var plen = load64(ctx + 24) & 0xFF;
    var kind = load64(ctx + 24) >> 8;
    var c0 = vec_get(chars, pos);
    var c1 = _shabda_cp_at(chars, pos + 1);
    if (_shabda_de_nucleus_len(chars, pos) == 2) {
        var ph = SVARA_PH_DIPH_AI;                                                          # ei ey ai ay
        if (c0 == 0x69) { ph = SVARA_PH_VOWEL_LONG_I; }                                    # ie
        if (c1 == 0x75) {
            ph = SVARA_PH_DIPH_OI;                                                          # eu äu
            if (c0 == 0x61) { ph = SVARA_PH_DIPH_AU; }                                     # au
        }
        if (c0 == c1) {                                                                     # aa ee oo
            ph = SVARA_PH_VOWEL_A;
            if (c0 == 0x65) { ph = SVARA_PH_VOWEL_E; }
            if (c0 == 0x6F) { ph = SVARA_PH_VOWEL_O; }
        }
        _shabda_vec_push_a(a, out, ph);
        return 2;
    }
    if (c0 == 0x65) {
        if (pos < plen) {                                                                   # the prefix's e
            if (kind == 1) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_SCHWA); return 1; }
            _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_E); return 1;
        }
        if (_shabda_de_is_schwa(ctx, pos) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_SCHWA); return 1; }
    }
    if (c0 == 0x61 || c0 == 0xE1) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_A); return 1; }   # a á
    if (c0 == 0xE4) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_E); return 1; }      # ä /ɛ ɛː/
    if (c0 == 0xFC || c0 == 0x79) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_Y); return 1; }   # ü y /y/
    var long = _shabda_de_is_long(ctx, pos);
    var short = SVARA_PH_VOWEL_OPEN_E;                                                      # e: eː ɛ
    var tense = SVARA_PH_VOWEL_E;
    if (c0 == 0x69) { short = SVARA_PH_VOWEL_NEAR_I; tense = SVARA_PH_VOWEL_LONG_I; }      # i: iː ɪ
    if (c0 == 0x6F) { short = SVARA_PH_VOWEL_OPEN_O; tense = SVARA_PH_VOWEL_O; }           # o: oː ɔ
    if (c0 == 0x75) { short = SVARA_PH_VOWEL_NEAR_U; tense = SVARA_PH_VOWEL_U; }           # u: uː ʊ
    if (c0 == 0xF6) {                                                                       # ö: øː œ
        short = SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O;
        tense = SVARA_PH_VOWEL_FRONT_ROUND_O;
    }
    if (long == 1) { _shabda_vec_push_a(a, out, tense); return 1; }
    _shabda_vec_push_a(a, out, short);
    return 1;
}

# The phoneme ch at chars[pos] spells: /k/ word-initially before a o u l r (Chor, Christ), the
# ach-Laut after a o u au (Bach, Buch, Bauch), else the ich-Laut /ç/ (ich, euch, Milch, China).
#must_use
fn _shabda_de_ch(chars, pos): i64 {
    if (pos == 0) {
        var nx = _shabda_cp_at(chars, 2);
        if (nx == 0x61 || nx == 0x6F || nx == 0x75 || nx == 0x6C || nx == 0x72) { return SVARA_PH_PLOSIVE_K; }
        return SVARA_PH_FRIC_PALATAL_C;
    }
    var prev = _shabda_cp_at(chars, pos - 1);
    if (prev == 0x61 || prev == 0x6F || prev == 0x75) {
        var pp = _shabda_cp_at(chars, pos - 2);
        if (prev == 0x75 && (pp == 0x65 || pp == 0xE4)) { return SVARA_PH_FRIC_PALATAL_C; }   # eu äu
        return SVARA_PH_FRIC_UVULAR_CH;
    }
    return SVARA_PH_FRIC_PALATAL_C;
}

# German double-consonant helper: for a doubled non-vowel `ch`, push its single
# phoneme (Rust's inner match). Pushes onto out, returns 1 if handled else 0.
fn _shabda_german_double_a(a, out, ch): i64 {
    if (ch == 0x62) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_B); return 1; }   # b
    if (ch == 0x63) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1; }   # c
    if (ch == 0x64) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_D); return 1; }   # d
    if (ch == 0x66) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_F); return 1; }      # f
    if (ch == 0x67) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_G); return 1; }   # g
    if (ch == 0x6B) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1; }   # k
    if (ch == 0x6C) { _shabda_vec_push_a(a, out, SVARA_PH_LATERAL_L); return 1; }   # l
    if (ch == 0x6D) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_M); return 1; }     # m
    if (ch == 0x6E) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N); return 1; }     # n
    if (ch == 0x70) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_P); return 1; }   # p
    if (ch == 0x72) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_UVULAR_R); return 1; }   # r /ʁ/
    if (ch == 0x73) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1; }      # s
    if (ch == 0x74) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 1; }   # t
    # _ arm: empty phoneme sequence, but still consumes 2.
    return 1;
}

# German pattern match at `pos`. `ctx` holds chars (+0), the nuclei (+8, +16) and the prefix
# (+24, length | kind << 8). Pushes phonemes onto `out`, returns consumed.
fn _shabda_german_match_a(a, ctx, pos, out): i64 {
    var chars = load64(ctx);
    var nuc = load64(ctx + 8);
    var pfx = load64(ctx + 24) & 0xFF;
    var n = vec_len(chars);
    if (pos >= n) { return 1; }

    var c0 = vec_get(chars, pos);
    var c1 = _shabda_cp_at(chars, pos + 1);
    var c2 = _shabda_cp_at(chars, pos + 2);
    var prev = _shabda_cp_at(chars, pos - 1);

    if (_shabda_de_is_vowel(c0) == 1 && _shabda_de_y_consonant(chars, pos) == 0) {
        return _shabda_de_vowel_a(a, ctx, pos, out);
    }

    # 4- and 3-letter patterns: tsch /t͡ʃ/, sch /ʃ/.
    if (c0 == 0x74 && c1 == 0x73 && c2 == 0x63 && _shabda_cp_at(chars, pos + 3) == 0x68) {
        _shabda_vec_push_a(a, out, SVARA_PH_AFFR_CH); return 4;
    }
    if (c0 == 0x73 && c1 == 0x63 && c2 == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_SH); return 3; }
    # chs /ks/ (sechs, wachsen, Fuchs), but chst is ch + st (machst, nächste)
    if (c0 == 0x63 && c1 == 0x68 && c2 == 0x73 && _shabda_cp_at(chars, pos + 3) != 0x74) {
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 3;
    }

    # 2-letter patterns.
    if (c0 == 0x63) {
        if (c1 == 0x68) { _shabda_vec_push_a(a, out, _shabda_de_ch(chars, pos)); return 2; }   # ch
        if (c1 == 0x6B) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 2; }          # ck
    }
    if (c0 == 0x64 && c1 == 0x74) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 2; }   # dt
    if (c0 == 0x6E && c1 == 0x67) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_NG); return 2; }    # ng /ŋ/
    if (c0 == 0x70) {
        if (c1 == 0x66) { _shabda_vec_push_a(a, out, SVARA_PH_AFFR_PF); return 2; }            # pf /p͡f/
        if (c1 == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_F); return 2; }             # ph
    }
    if (c0 == 0x74) {
        if (c1 == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 2; }          # th
        if (c1 == 0x7A) { _shabda_vec_push_a(a, out, SVARA_PH_AFFR_TS); return 2; }            # tz /t͡s/
    }
    if (c0 == 0x72 && c1 == 0x68 && pos == 0) {                                             # rh (Rhein)
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_UVULAR_R); return 2;
    }
    if (c0 == 0x71 && c1 == 0x75) {                                                         # qu /kv/
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); _shabda_vec_push_a(a, out, SVARA_PH_FRIC_V); return 2;
    }
    if (c0 == 0x7A && c1 == 0x7A) { _shabda_vec_push_a(a, out, SVARA_PH_AFFR_TS); return 2; }    # zz
    # sp / st at the start of the word or of the stem after a prefix -> /ʃp/, /ʃt/ (Stadt,
    # verstehen); elsewhere /sp/ /st/ (Fenster, ist). Consumes the s only.
    if (c0 == 0x73 && (c1 == 0x70 || c1 == 0x74) && (pos == 0 || pos == pfx)) {
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_SH); return 1;
    }
    # Double consonants -> single phoneme.
    if (c0 == c1 && _shabda_de_is_vowel(c0) == 0) {
        _shabda_german_double_a(a, out, c0);
        return 2;
    }

    # Single consonants.
    if (c0 == 0x62) {                                                                       # b
        if (_shabda_de_devoice(chars, pos + 1) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_P); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_B); return 1;
    }
    if (c0 == 0x63) {                                                                       # c: /t͡s/ before e i ä y
        if (c1 == 0x65 || c1 == 0x69 || c1 == 0xE4 || c1 == 0x79) {
            _shabda_vec_push_a(a, out, SVARA_PH_AFFR_TS); return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1;
    }
    if (c0 == 0x64) {                                                                       # d
        if (_shabda_de_devoice(chars, pos + 1) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_D); return 1;
    }
    if (c0 == 0x66) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_F); return 1; }             # f
    if (c0 == 0x67) {                                                                       # g
        if (_shabda_de_ig_final(chars, nuc, pos) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_FRIC_PALATAL_C); return 1;
        }
        if (_shabda_de_devoice(chars, pos + 1) == 1) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_G); return 1;
    }
    if (c0 == 0x68) {                                                                       # h: silent after a vowel
        if (pos == 0 || pos == pfx || _shabda_de_is_vowel(prev) == 0) {
            _shabda_vec_push_a(a, out, SVARA_PH_FRIC_H);
        }
        return 1;
    }
    if (c0 == 0x6A) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_J); return 1; }           # j
    if (c0 == 0x6B) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); return 1; }          # k
    if (c0 == 0x6C) { _shabda_vec_push_a(a, out, SVARA_PH_LATERAL_L); return 1; }          # l
    if (c0 == 0x6D) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_M); return 1; }            # m
    if (c0 == 0x6E) {                                                                       # n: /ŋ/ before k
        if (c1 == 0x6B) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_NG); return 1; }
        _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N); return 1;
    }
    if (c0 == 0x70) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_P); return 1; }          # p
    if (c0 == 0x72) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_UVULAR_R); return 1; }      # r /ʁ/
    if (c0 == 0x73) {                                                                       # s
        if (_shabda_de_is_vowel(c1) == 1) {
            # /z/ before a vowel, /s/ after an obstruent (Erbse, Rätsel)
            if (prev == 0x70 || prev == 0x74 || prev == 0x6B || prev == 0x66 || prev == 0x63 || prev == 0x78) {
                _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
            }
            if (prev == 0x62 || prev == 0x64 || prev == 0x7A || prev == 0xDF) {
                _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
            }
            if (prev == 0x67 && _shabda_cp_at(chars, pos - 2) != 0x6E) {                    # g, not ng (langsam)
                _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
            }
            _shabda_vec_push_a(a, out, SVARA_PH_FRIC_Z); return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
    }
    if (c0 == 0xDF) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1; }            # ß
    if (c0 == 0x74) { _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_T); return 1; }          # t
    if (c0 == 0x76) {                                                                       # v: /f/, /v/ between vowels
        if (_shabda_de_is_vowel(prev) == 1 && _shabda_de_is_vowel(c1) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_FRIC_V); return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_F); return 1;
    }
    if (c0 == 0x77) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_V); return 1; }             # w = /v/
    if (c0 == 0x78) {                                                                       # x /ks/
        _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_K); _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S); return 1;
    }
    if (c0 == 0x79) { _shabda_vec_push_a(a, out, SVARA_PH_APPROX_J); return 1; }           # consonantal y
    if (c0 == 0x7A) { _shabda_vec_push_a(a, out, SVARA_PH_AFFR_TS); return 1; }            # z /t͡s/
    if (c0 == 0x27) { return 1; }                                                           # '
    if (c0 == 0x2D) { return 1; }                                                           # -
    return 1;
}

# Public German engine. Ports german_rules().
#must_use
fn shabda_german_rules(word): i64 {
    return _shabda_german_rules_a(default_alloc(), word);
}

# shabda_german_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_german_rules_a(a, word): i64 {
    var chars = _shabda_word_chars_a(a, word);
    if (vec_len(chars) == 0) {
        return vec_new_a(a);
    }
    var nuc = vec_new_a(a);
    var nl = vec_new_a(a);
    _shabda_de_scan_a(a, chars, nuc, nl);
    var ctx = alloc_via(a, 32);
    store64(ctx, chars);
    store64(ctx + 8, nuc);
    store64(ctx + 16, nl);
    store64(ctx + 24, _shabda_de_prefix(chars, nuc, nl));
    var phonemes = vec_new_a(a);
    var i = 0;
    var n = vec_len(chars);
    while (i < n) {
        var consumed = _shabda_german_match_a(a, ctx, i, phonemes);
        i = i + consumed;
    }

    # Final devoicing: voiced -> voiceless at word end (mutate last element).
    var pn = vec_len(phonemes);
    if (pn > 0) {
        var last = vec_get(phonemes, pn - 1);
        var newl = last;
        if (last == SVARA_PH_PLOSIVE_B) { newl = SVARA_PH_PLOSIVE_P; }
        if (last == SVARA_PH_PLOSIVE_D) { newl = SVARA_PH_PLOSIVE_T; }
        if (last == SVARA_PH_PLOSIVE_G) { newl = SVARA_PH_PLOSIVE_K; }
        if (last == SVARA_PH_FRIC_V)    { newl = SVARA_PH_FRIC_F; }
        if (last == SVARA_PH_FRIC_Z)    { newl = SVARA_PH_FRIC_S; }
        vec_set(phonemes, pn - 1, newl);
    }

    return phonemes;
}

# ================================================================
# Hindi G2P rules (Devanagari) — ports hindi_rules(). Devanagari codepoints are
# load-bearing: independent vowels, matras (combining vowel signs), virama,
# nukta, anusvara/visarga/chandrabindu. Each consonant carries an inherent schwa
# unless a matra or virama follows it. Hindi then deletes schwa, word-finally and
# in VC_CV (Ohala 1983), which Sanskrit does not.
# The word is decoded WITHOUT ASCII-lowering (Rust uses word.chars() here); the
# Latin fallback lowercases per-codepoint.
#
# Accuracy over the Rust (ADR-0002). The Rust collapsed the retroflex series onto
# the dental one, gave ह /h/ and उ /ʌ/, and spelled ए /ɛ/ and ऐ /ɑ/. svara has
# each sound now: ʈ ɖ ɳ ʂ ɽ ɲ ɦ ʊ e ɛ. svara has no aspirated or breathy stop, so
# an aspirate is its plain stop (one phoneme, as the syllabifier and the stress
# rules need), and no nasal vowel, so a nasal vowel is the vowel + a nasal
# consonant: svara nasalizes a vowel only before a nasal consonant.
# ================================================================

# Placeholder for an inherent schwa until Hindi schwa deletion has run. Never
# leaves _shabda_hindi_rules_a: the last pass writes SVARA_PH_VOWEL_SCHWA.
var _SHABDA_HINDI_INHERENT = 1001;

# Does the codepoint `next` after a consonant take the place of its inherent
# schwa? The matras and the virama do. Anusvara and chandrabindu do NOT: कं is
# /kən/ (they nasalize the inherent vowel), so they are not in the set (the Rust
# had them, and dropped the vowel of every syllable written with one). next == -1
# means end-of-word.
#must_use
fn _shabda_hindi_suppress(next): i64 {
    if (next >= 0x093E && next <= 0x0944) { return 1; }   # ा ि ी ु ू ृ ॄ
    if (next >= 0x0947 && next <= 0x0949) { return 1; }   # े ै ॉ
    if (next == 0x094B || next == 0x094C) { return 1; }   # ो ौ
    if (next == 0x094D) { return 1; }                     # ् virama
    if (next == 0x0962 || next == 0x0963) { return 1; }   # ॢ ॣ vocalic l, ll
    return 0;
}

# The svara phoneme of a Devanagari consonant letter, or SHABDA_PH_NONE. Hindi
# and Sanskrit share it. Aspirates are their plain stop (svara has no aspirated
# or breathy stop); व is svara's /v/ for /ʋ/; श is /ʃ/ (Sanskrit /ɕ/, which svara
# lacks: /ʃ/ is the nearest). The precomposed nukta letters are here too.
#must_use
fn _shabda_hindi_consonant_ph(cp): i64 {
    # Velar
    if (cp == 0x0915 || cp == 0x0916) { return SVARA_PH_PLOSIVE_K; }       # क ख
    if (cp == 0x0917 || cp == 0x0918) { return SVARA_PH_PLOSIVE_G; }       # ग घ
    if (cp == 0x0919) { return SVARA_PH_NASAL_NG; }                        # ङ
    # Palatal
    if (cp == 0x091A || cp == 0x091B) { return SVARA_PH_AFFR_CH; }         # च छ
    if (cp == 0x091C || cp == 0x091D) { return SVARA_PH_AFFR_J; }          # ज झ
    if (cp == 0x091E) { return SVARA_PH_NASAL_PALATAL; }                   # ञ /ɲ/
    # Retroflex
    if (cp == 0x091F || cp == 0x0920) { return SVARA_PH_PLOSIVE_RETRO_T; } # ट ठ /ʈ/
    if (cp == 0x0921 || cp == 0x0922) { return SVARA_PH_PLOSIVE_RETRO_D; } # ड ढ /ɖ/
    if (cp == 0x0923) { return SVARA_PH_NASAL_RETRO; }                     # ण /ɳ/
    # Dental
    if (cp == 0x0924 || cp == 0x0925) { return SVARA_PH_PLOSIVE_T; }       # त थ
    if (cp == 0x0926 || cp == 0x0927) { return SVARA_PH_PLOSIVE_D; }       # द ध
    if (cp == 0x0928) { return SVARA_PH_NASAL_N; }                         # न
    # Labial
    if (cp == 0x092A || cp == 0x092B) { return SVARA_PH_PLOSIVE_P; }       # प फ
    if (cp == 0x092C || cp == 0x092D) { return SVARA_PH_PLOSIVE_B; }       # ब भ
    if (cp == 0x092E) { return SVARA_PH_NASAL_M; }                         # म
    # Semivowels / liquids
    if (cp == 0x092F) { return SVARA_PH_APPROX_J; }                        # य
    if (cp == 0x0930) { return SVARA_PH_TAP_FLAP; }                        # र
    if (cp == 0x0932 || cp == 0x0933) { return SVARA_PH_LATERAL_L; }       # ल ळ (svara has no /ɭ/)
    if (cp == 0x0935) { return SVARA_PH_FRIC_V; }                          # व
    # Sibilants, ह
    if (cp == 0x0936) { return SVARA_PH_FRIC_SH; }                         # श
    if (cp == 0x0937) { return SVARA_PH_FRIC_RETRO_S; }                    # ष /ʂ/
    if (cp == 0x0938) { return SVARA_PH_FRIC_S; }                          # स
    if (cp == 0x0939) { return SVARA_PH_FRIC_GLOTTAL_H; }                  # ह /ɦ/
    # Precomposed nukta letters (U+0958..U+095F)
    if (cp >= 0x0958 && cp <= 0x095F) { return _shabda_hindi_nukta_ph(cp - 0x0958 + 0x1000); }
    return SHABDA_PH_NONE;
}

# The phoneme of a consonant written with nukta, or SHABDA_PH_NONE. `base` is the
# base letter (क + ़), or 0x1000 + the offset of a precomposed letter from U+0958
# (क़ ख़ ग़ ज़ ड़ ढ़ फ़ य़, in that order).
#must_use
fn _shabda_hindi_nukta_ph(base): i64 {
    if (base == 0x0915 || base == 0x1000) { return SVARA_PH_PLOSIVE_UVULAR_Q; } # क़ /q/
    if (base == 0x0916 || base == 0x1001) { return SVARA_PH_FRIC_UVULAR_CH; }   # ख़ /x/ (svara: χ)
    if (base == 0x0917 || base == 0x1002) { return SVARA_PH_FRIC_UVULAR_R; }    # ग़ /ɣ/ (svara: ʁ)
    if (base == 0x091C || base == 0x1003) { return SVARA_PH_FRIC_Z; }           # ज़ /z/
    if (base == 0x0921 || base == 0x1004) { return SVARA_PH_FLAP_RETRO; }       # ड़ /ɽ/
    if (base == 0x0922 || base == 0x1005) { return SVARA_PH_FLAP_RETRO; }       # ढ़ /ɽʱ/
    if (base == 0x092B || base == 0x1006) { return SVARA_PH_FRIC_F; }           # फ़ /f/
    if (base == 0x092F || base == 0x1007) { return SVARA_PH_APPROX_J; }         # य़
    return SHABDA_PH_NONE;
}

# The nasal an anusvara or chandrabindu is before the letter at chars[j]: the
# stop's own place (ŋ velar, ɲ palatal, ɳ retroflex, n dental, m labial), else
# `other`. Before a stop the anusvara is that nasal: लंबा /ləmbaː/, गंगा /ɡəŋɡaː/,
# ठंडा /ʈʰəɳɖaː/. Elsewhere it nasalizes the vowel, which svara can only do before
# a nasal consonant, so `other` stands in (Hindi n, Sanskrit m).
#must_use
fn _shabda_hindi_nasal_before(chars, j, other): i64 {
    var cp = _shabda_cp_at(chars, j);
    if (_shabda_cp_at(chars, j + 1) == 0x093C) {
        if (cp == 0x091C || cp == 0x092B) { return other; }   # ज़ फ़ are fricatives
    }
    if (cp >= 0x0915 && cp <= 0x0919) { return SVARA_PH_NASAL_NG; }
    if (cp >= 0x0958 && cp <= 0x095A) { return SVARA_PH_NASAL_NG; }
    if (cp >= 0x091A && cp <= 0x091E) { return SVARA_PH_NASAL_PALATAL; }
    if (cp >= 0x091F && cp <= 0x0923) { return SVARA_PH_NASAL_RETRO; }
    if (cp == 0x095C || cp == 0x095D) { return SVARA_PH_NASAL_RETRO; }
    if (cp >= 0x0924 && cp <= 0x0928) { return SVARA_PH_NASAL_N; }
    if (cp >= 0x092A && cp <= 0x092E) { return SVARA_PH_NASAL_M; }
    return other;
}

# Push the consonant at chars[i] (with a following nukta, and Hindi's ज्ञ /ɡj/)
# and, unless a matra or virama follows, its inherent vowel `inherent`. Returns
# the index of the next codepoint to read.
fn _shabda_hindi_push_consonant_a(a, out, chars, i, c, inherent, hindi): i64 {
    var ch = vec_get(chars, i);
    var j = i + 1;
    if (_shabda_cp_at(chars, j) == 0x093C) {                 # ़ nukta
        var nk = _shabda_hindi_nukta_ph(ch);
        if (nk != SHABDA_PH_NONE) { c = nk; }
        j = j + 1;
    }
    # Hindi ज्ञ is /ɡj/ (ज्ञान /ɡjaːn/); Sanskrit keeps /d͡ʑɲ/.
    if (hindi == 1 && ch == 0x091C && _shabda_cp_at(chars, j) == 0x094D) {
        if (_shabda_cp_at(chars, j + 1) == 0x091E) {
            _shabda_vec_push_a(a, out, SVARA_PH_PLOSIVE_G);
            c = SVARA_PH_APPROX_J;
            j = j + 2;
        }
    }
    _shabda_vec_push_a(a, out, c);
    if (_shabda_hindi_suppress(_shabda_cp_at(chars, j)) == 0) {
        _shabda_vec_push_a(a, out, inherent);
    }
    return j;
}

# Latin fallback for romanized Hindi. Pushes the phoneme(s) for the letter at
# chars[i] and returns how many codepoints it read. Hindi romanization writes
# aa ii/ee uu/oo for the long vowels, ai au for ɛː ɔː, and an h after a stop for
# its aspiration (kh gh ch jh th dh ph bh), which is the plain stop (see the
# section head); sh is /ʃ/.
fn _shabda_hindi_latin_a(a, out, chars, i): i64 {
    var lower = _shabda_ascii_lower(vec_get(chars, i));
    var next = _shabda_ascii_lower(_shabda_cp_at(chars, i + 1));
    if (lower == 0x61) {                                                            # a
        if (next == 0x61) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_A); return 2; }  # aa
        if (next == 0x69) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_E); return 2; }  # ai
        if (next == 0x75) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_O); return 2; }  # au
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_SCHWA);
        return 1;
    }
    if (lower == 0x65) {                                                            # e
        if (next == 0x65) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_LONG_I); return 2; }  # ee
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_E);
        return 1;
    }
    if (lower == 0x69) {                                                            # i
        if (next == 0x69) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_LONG_I); return 2; }  # ii
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_I);
        return 1;
    }
    if (lower == 0x6F) {                                                            # o
        if (next == 0x6F) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U); return 2; }       # oo
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_O);
        return 1;
    }
    if (lower == 0x75) {                                                            # u
        if (next == 0x75) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U); return 2; }       # uu
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_U);
        return 1;
    }
    var c = SHABDA_PH_NONE;
    if (lower == 0x6B) { c = SVARA_PH_PLOSIVE_K; }       # k
    if (lower == 0x67) { c = SVARA_PH_PLOSIVE_G; }       # g
    if (lower == 0x63) { c = SVARA_PH_AFFR_CH; }         # c (ch, chh)
    if (lower == 0x6A) { c = SVARA_PH_AFFR_J; }          # j
    if (lower == 0x74) { c = SVARA_PH_PLOSIVE_T; }       # t
    if (lower == 0x64) { c = SVARA_PH_PLOSIVE_D; }       # d
    if (lower == 0x70) { c = SVARA_PH_PLOSIVE_P; }       # p
    if (lower == 0x62) { c = SVARA_PH_PLOSIVE_B; }       # b
    if (c != SHABDA_PH_NONE) {
        _shabda_vec_push_a(a, out, c);
        if (next != 0x68) { return 1; }
        if (lower == 0x63 && _shabda_ascii_lower(_shabda_cp_at(chars, i + 2)) == 0x68) { return 3; }   # chh
        return 2;                                        # the h of an aspirate
    }
    if (lower == 0x73) {                                 # s, sh
        if (next == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_SH); return 2; }
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S);
        return 1;
    }
    if (lower == 0x6E) { c = SVARA_PH_NASAL_N; }         # n
    if (lower == 0x6D) { c = SVARA_PH_NASAL_M; }         # m
    if (lower == 0x79) { c = SVARA_PH_APPROX_J; }        # y
    if (lower == 0x72) { c = SVARA_PH_TAP_FLAP; }        # r
    if (lower == 0x6C) { c = SVARA_PH_LATERAL_L; }       # l
    if (lower == 0x76 || lower == 0x77) { c = SVARA_PH_FRIC_V; }   # v w
    if (lower == 0x68) { c = SVARA_PH_FRIC_GLOTTAL_H; }  # h /ɦ/
    if (lower == 0x66) { c = SVARA_PH_FRIC_F; }          # f
    if (lower == 0x7A) { c = SVARA_PH_FRIC_Z; }          # z
    if (lower == 0x71) { c = SVARA_PH_PLOSIVE_UVULAR_Q; }   # q
    if (c != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, c); }
    return 1;
}

# The single vowel phoneme of a Hindi independent vowel or matra, else
# SHABDA_PH_NONE. Hindi short vowels are lax: इ /ɪ/, उ /ʊ/; ए is /eː/, ऐ /ɛː/,
# ओ /oː/, औ and the loanword ऑ /ɔː/; आ is /aː/, svara's VOWEL_OPEN_A [ɑ].
#must_use
fn _shabda_hindi_vowel_ph(cp): i64 {
    if (cp == 0x0905) { return SVARA_PH_VOWEL_SCHWA; }                    # अ
    if (cp == 0x0906 || cp == 0x093E) { return SVARA_PH_VOWEL_OPEN_A; }   # आ ा
    if (cp == 0x0907 || cp == 0x093F) { return SVARA_PH_VOWEL_NEAR_I; }   # इ ि
    if (cp == 0x0908 || cp == 0x0940) { return SVARA_PH_VOWEL_LONG_I; }   # ई ी
    if (cp == 0x0909 || cp == 0x0941) { return SVARA_PH_VOWEL_NEAR_U; }   # उ ु
    if (cp == 0x090A || cp == 0x0942) { return SVARA_PH_VOWEL_U; }        # ऊ ू
    if (cp == 0x090F || cp == 0x0947) { return SVARA_PH_VOWEL_E; }        # ए े
    if (cp == 0x0910 || cp == 0x0948) { return SVARA_PH_VOWEL_OPEN_E; }   # ऐ ै
    if (cp == 0x0913 || cp == 0x094B) { return SVARA_PH_VOWEL_O; }        # ओ ो
    if (cp == 0x0914 || cp == 0x094C) { return SVARA_PH_VOWEL_OPEN_O; }   # औ ौ
    if (cp == 0x0911 || cp == 0x0949) { return SVARA_PH_VOWEL_OPEN_O; }   # ऑ ॉ
    return SHABDA_PH_NONE;
}

# Is `p` a vowel (the inherent-schwa placeholder included)?
#must_use
fn _shabda_hindi_is_vowel(p): i64 {
    if (p == _SHABDA_HINDI_INHERENT) { return 1; }
    var c = svara_phoneme_class(p);
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

#must_use
fn _shabda_hindi_is_schwa(p): i64 {
    if (p == _SHABDA_HINDI_INHERENT || p == SVARA_PH_VOWEL_SCHWA) { return 1; }
    return 0;
}

# The first index after `k` whose keep flag is set, or -1.
#must_use
fn _shabda_hindi_next_kept(keep, n, k): i64 {
    var j = k + 1;
    while (j < n) {
        if (load64(keep + j * 8) == 1) { return j; }
        j = j + 1;
    }
    return 0 - 1;
}

#must_use
fn _shabda_hindi_vowel_at(ph, j): i64 {
    if (j < 0) { return 0; }
    return _shabda_hindi_is_vowel(vec_get(ph, j));
}

# Is there a consonant at index j (j == -1 is no phoneme at all)?
#must_use
fn _shabda_hindi_consonant_at(ph, j): i64 {
    if (j < 0) { return 0; }
    return 1 - _shabda_hindi_is_vowel(vec_get(ph, j));
}

# Hindi schwa deletion and the schwa's [ɛ] beside ɦ, over the rules' phonemes
# (inherent schwas still the placeholder). Returns the final vec.
#   1. A word-final schwa is deleted when an earlier vowel exists (कर /kər/, but
#      न /nə/).
#   2. Then, right to left, an inherent schwa is deleted in VC_CV (Ohala 1983):
#      आदमी /aːdmiː/, मछली /mət͡ʃʰliː/, अपना /əpnaː/. समझना keeps its second
#      schwa, /səməd͡ʒnaː/: the deletion to its right leaves CC after it.
#   3. A schwa before ɦ is [ɛ] when ɦ closes its syllable (कहना /kɛɦnaː/, यह /jɛɦ/),
#      and both schwas of əɦə are (शहर /ʃɛɦɛr/).
fn _shabda_hindi_schwa_a(a, ph): i64 {
    var n = vec_len(ph);
    var keep = alloc_via(a, n * 8 + 8);
    var k = 0;
    while (k < n) { store64(keep + k * 8, 1); k = k + 1; }

    if (n > 1 && _shabda_hindi_is_schwa(vec_get(ph, n - 1)) == 1) {
        k = 0;
        while (k < n - 1) {
            if (_shabda_hindi_is_vowel(vec_get(ph, k)) == 1) { store64(keep + (n - 1) * 8, 0); k = n; }
            k = k + 1;
        }
    }

    k = n - 2;
    while (k >= 2) {
        if (vec_get(ph, k) == _SHABDA_HINDI_INHERENT && load64(keep + k * 8) == 1) {
            var n1 = _shabda_hindi_next_kept(keep, n, k);
            var n2 = 0 - 1;
            if (n1 >= 0) { n2 = _shabda_hindi_next_kept(keep, n, n1); }
            if (_shabda_hindi_consonant_at(ph, k - 1) == 1 && _shabda_hindi_vowel_at(ph, k - 2) == 1) {
                if (_shabda_hindi_consonant_at(ph, n1) == 1 && _shabda_hindi_vowel_at(ph, n2) == 1) {
                    store64(keep + k * 8, 0);
                }
            }
        }
        k = k - 1;
    }

    var out = vec_new_a(a);
    k = 0;
    while (k < n) {
        if (load64(keep + k * 8) == 1) {
            var p = vec_get(ph, k);
            if (_shabda_hindi_is_schwa(p) == 1) {
                p = SVARA_PH_VOWEL_SCHWA;
                var h = _shabda_hindi_next_kept(keep, n, k);
                if (h >= 0 && vec_get(ph, h) == SVARA_PH_FRIC_GLOTTAL_H) {
                    var after = _shabda_hindi_next_kept(keep, n, h);
                    if (_shabda_hindi_vowel_at(ph, after) == 0) { p = SVARA_PH_VOWEL_OPEN_E; }
                    elif (_shabda_hindi_is_schwa(vec_get(ph, after)) == 1) {
                        p = SVARA_PH_VOWEL_OPEN_E;
                        vec_set(ph, after, SVARA_PH_VOWEL_OPEN_E);
                    }
                }
            }
            _shabda_vec_push_a(a, out, p);
        }
        k = k + 1;
    }
    return out;
}

# Public Hindi engine. Ports hindi_rules().
#must_use
fn shabda_hindi_rules(word): i64 {
    return _shabda_hindi_rules_a(default_alloc(), word);
}

# shabda_hindi_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_hindi_rules_a(a, word): i64 {
    var chars = _shabda_decode_chars_a(a, word, 0);
    if (vec_len(chars) == 0) {
        return vec_new_a(a);
    }
    var phonemes = vec_new_a(a);
    var i = 0;
    var n = vec_len(chars);
    while (i < n) {
        var ch = vec_get(chars, i);
        var adv = 1;
        var v = _shabda_hindi_vowel_ph(ch);
        var c = _shabda_hindi_consonant_ph(ch);
        if (v != SHABDA_PH_NONE) { _shabda_vec_push_a(a, phonemes, v); }
        elif (c != SHABDA_PH_NONE) {
            adv = _shabda_hindi_push_consonant_a(a, phonemes, chars, i, c, _SHABDA_HINDI_INHERENT, 1) - i;
        }
        elif (ch == 0x090B || ch == 0x0943) {                # ऋ ृ /rɪ/ in Hindi
            _shabda_vec_push_a(a, phonemes, SVARA_PH_TAP_FLAP);
            _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_NEAR_I);
        }
        elif (ch == 0x0902 || ch == 0x0901) {                # ं ँ
            _shabda_vec_push_a(a, phonemes, _shabda_hindi_nasal_before(chars, i + 1, SVARA_PH_NASAL_N));
        }
        elif (ch == 0x0903) { _shabda_vec_push_a(a, phonemes, SVARA_PH_FRIC_GLOTTAL_H); }   # ः Hindi /ɦ/
        elif (ch == 0x0950) {                                # ॐ /oːm/
            _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_O);
            _shabda_vec_push_a(a, phonemes, SVARA_PH_NASAL_M);
        }
        elif (_shabda_rules_is_ascii_alpha(ch) == 1) {
            adv = _shabda_hindi_latin_a(a, phonemes, chars, i);
        }
        # Else (virama, a stray nukta, danda, digits, ...): nothing.
        i = i + adv;
    }

    return _shabda_hindi_schwa_a(a, phonemes);
}

# ================================================================
# Sanskrit G2P rules (Devanagari) — ports sanskrit_rules(). Same Devanagari
# consonants as Hindi, but: NO schwa deletion (schwa PRESERVATION), short i u
# and e o as Sanskrit has them, ai/au the diphthongs /ɐi ɐu/, vocalic r̥ r̥̄ l̥ l̥̄
# (recited ri rī li lī), ज्ञ /d͡ʑɲ/, visarga /h/ (ह is /ɦ/), and an anusvara that is
# m except before a stop, where it is the stop's nasal.
# ================================================================

# Push the phoneme(s) of a Sanskrit independent vowel, matra or vocalic liquid.
# Returns 1 if `cp` was one, else 0.
fn _shabda_sanskrit_vowel_a(a, out, cp): i64 {
    var v = SHABDA_PH_NONE;
    if (cp == 0x0905) { v = SVARA_PH_VOWEL_SCHWA; }                       # अ /ɐ/
    if (cp == 0x0906 || cp == 0x093E) { v = SVARA_PH_VOWEL_OPEN_A; }      # आ ा
    if (cp == 0x0907 || cp == 0x093F) { v = SVARA_PH_VOWEL_NEAR_I; }      # इ ि
    if (cp == 0x0908 || cp == 0x0940) { v = SVARA_PH_VOWEL_LONG_I; }      # ई ी
    if (cp == 0x0909 || cp == 0x0941) { v = SVARA_PH_VOWEL_NEAR_U; }      # उ ु
    if (cp == 0x090A || cp == 0x0942) { v = SVARA_PH_VOWEL_U; }           # ऊ ू
    if (cp == 0x090F || cp == 0x0947) { v = SVARA_PH_VOWEL_E; }           # ए े /eː/
    if (cp == 0x0910 || cp == 0x0948) { v = SVARA_PH_DIPH_AI; }           # ऐ ै /ɐi/
    if (cp == 0x0913 || cp == 0x094B) { v = SVARA_PH_VOWEL_O; }           # ओ ो /oː/
    if (cp == 0x0914 || cp == 0x094C) { v = SVARA_PH_DIPH_AU; }           # औ ौ /ɐu/
    if (v != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, v); return 1; }
    var liquid = SHABDA_PH_NONE;
    var vowel = SVARA_PH_VOWEL_NEAR_I;
    if (cp == 0x090B || cp == 0x0943) { liquid = SVARA_PH_TAP_FLAP; }      # ऋ ृ
    if (cp == 0x0960 || cp == 0x0944) {                                    # ॠ ॄ
        liquid = SVARA_PH_TAP_FLAP;
        vowel = SVARA_PH_VOWEL_LONG_I;
    }
    if (cp == 0x090C || cp == 0x0962) { liquid = SVARA_PH_LATERAL_L; }     # ऌ ॢ
    if (cp == 0x0961 || cp == 0x0963) {                                    # ॡ ॣ
        liquid = SVARA_PH_LATERAL_L;
        vowel = SVARA_PH_VOWEL_LONG_I;
    }
    if (liquid == SHABDA_PH_NONE) { return 0; }
    _shabda_vec_push_a(a, out, liquid);
    _shabda_vec_push_a(a, out, vowel);
    return 1;
}

# IAST letter (precomposed) -> phoneme, for the romanized fallback, or
# SHABDA_PH_NONE. The vocalic liquids are two phonemes and are handled by the
# caller.
#must_use
fn _shabda_sanskrit_iast_ph(cp): i64 {
    if (cp == 0x0101) { return SVARA_PH_VOWEL_OPEN_A; }        # ā
    if (cp == 0x012B) { return SVARA_PH_VOWEL_LONG_I; }        # ī
    if (cp == 0x016B) { return SVARA_PH_VOWEL_U; }             # ū
    if (cp == 0x1E45) { return SVARA_PH_NASAL_NG; }            # ṅ
    if (cp == 0x00F1) { return SVARA_PH_NASAL_PALATAL; }       # ñ
    if (cp == 0x1E6D) { return SVARA_PH_PLOSIVE_RETRO_T; }     # ṭ
    if (cp == 0x1E0D) { return SVARA_PH_PLOSIVE_RETRO_D; }     # ḍ
    if (cp == 0x1E47) { return SVARA_PH_NASAL_RETRO; }         # ṇ
    if (cp == 0x015B) { return SVARA_PH_FRIC_SH; }             # ś
    if (cp == 0x1E63) { return SVARA_PH_FRIC_RETRO_S; }        # ṣ
    if (cp == 0x1E43 || cp == 0x1E41) { return SVARA_PH_NASAL_M; }   # ṃ ṁ
    if (cp == 0x1E25) { return SVARA_PH_FRIC_H; }              # ḥ
    return SHABDA_PH_NONE;
}

# The nasal IAST ṃ is before the letter `next` (lowercased): the stop's own, as
# for the Devanagari anusvara, else m.
#must_use
fn _shabda_sanskrit_iast_nasal(next): i64 {
    if (next == 0x6B || next == 0x67 || next == 0x1E45) { return SVARA_PH_NASAL_NG; }         # k g ṅ
    if (next == 0x63 || next == 0x6A || next == 0x00F1) { return SVARA_PH_NASAL_PALATAL; }    # c j ñ
    if (next == 0x1E6D || next == 0x1E0D || next == 0x1E47) { return SVARA_PH_NASAL_RETRO; }  # ṭ ḍ ṇ
    if (next == 0x74 || next == 0x64 || next == 0x6E) { return SVARA_PH_NASAL_N; }            # t d n
    return SVARA_PH_NASAL_M;
}

# Latin fallback for romanized Sanskrit, ASCII or IAST. Pushes the phoneme(s) for
# the letter at chars[i] and returns how many codepoints it read. ai au are the
# diphthongs, an h after a stop is its aspiration (the plain stop, as for
# Devanagari), c is /t͡ɕ/, h /ɦ/, ṛ ṝ ḷ the vocalic liquids.
fn _shabda_sanskrit_latin_a(a, out, chars, i): i64 {
    var cp = vec_get(chars, i);
    var lower = _shabda_ascii_lower(cp);
    var next = _shabda_ascii_lower(_shabda_cp_at(chars, i + 1));
    var iast = _shabda_sanskrit_iast_ph(cp);
    if (iast == SVARA_PH_NASAL_M) { iast = _shabda_sanskrit_iast_nasal(next); }   # ṃ, as ं
    if (iast != SHABDA_PH_NONE) {
        _shabda_vec_push_a(a, out, iast);
        if (iast == SVARA_PH_PLOSIVE_RETRO_T || iast == SVARA_PH_PLOSIVE_RETRO_D) {
            if (next == 0x68) { return 2; }                  # ṭh ḍh
        }
        return 1;
    }
    if (cp == 0x1E5B || cp == 0x1E5D || cp == 0x1E37 || cp == 0x1E39) {   # ṛ ṝ ḷ ḹ
        if (cp == 0x1E5B || cp == 0x1E5D) { _shabda_vec_push_a(a, out, SVARA_PH_TAP_FLAP); }
        else { _shabda_vec_push_a(a, out, SVARA_PH_LATERAL_L); }
        if (cp == 0x1E5B || cp == 0x1E37) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_I); }
        else { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_LONG_I); }
        return 1;
    }
    if (_shabda_rules_is_ascii_alpha(cp) == 0) { return 1; }
    if (lower == 0x61) {                                                            # a
        if (next == 0x69) { _shabda_vec_push_a(a, out, SVARA_PH_DIPH_AI); return 2; }      # ai
        if (next == 0x75) { _shabda_vec_push_a(a, out, SVARA_PH_DIPH_AU); return 2; }      # au
        if (next == 0x61) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_OPEN_A); return 2; } # aa
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_SCHWA);
        return 1;
    }
    var v = SHABDA_PH_NONE;
    if (lower == 0x65) { v = SVARA_PH_VOWEL_E; }         # e
    if (lower == 0x69) { v = SVARA_PH_VOWEL_NEAR_I; }    # i
    if (lower == 0x6F) { v = SVARA_PH_VOWEL_O; }         # o
    if (lower == 0x75) { v = SVARA_PH_VOWEL_NEAR_U; }    # u
    if (v != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, v); return 1; }
    var c = SHABDA_PH_NONE;
    if (lower == 0x6B) { c = SVARA_PH_PLOSIVE_K; }       # k
    if (lower == 0x67) { c = SVARA_PH_PLOSIVE_G; }       # g
    if (lower == 0x63) { c = SVARA_PH_AFFR_CH; }         # c
    if (lower == 0x6A) { c = SVARA_PH_AFFR_J; }          # j
    if (lower == 0x74) { c = SVARA_PH_PLOSIVE_T; }       # t
    if (lower == 0x64) { c = SVARA_PH_PLOSIVE_D; }       # d
    if (lower == 0x70) { c = SVARA_PH_PLOSIVE_P; }       # p
    if (lower == 0x62) { c = SVARA_PH_PLOSIVE_B; }       # b
    if (c != SHABDA_PH_NONE) {
        _shabda_vec_push_a(a, out, c);
        if (next == 0x68) { return 2; }                  # the h of an aspirate
        return 1;
    }
    if (lower == 0x73) {                                 # s, sh
        if (next == 0x68) { _shabda_vec_push_a(a, out, SVARA_PH_FRIC_SH); return 2; }
        _shabda_vec_push_a(a, out, SVARA_PH_FRIC_S);
        return 1;
    }
    if (lower == 0x6E) { c = SVARA_PH_NASAL_N; }         # n
    if (lower == 0x6D) { c = SVARA_PH_NASAL_M; }         # m
    if (lower == 0x79) { c = SVARA_PH_APPROX_J; }        # y
    if (lower == 0x72) { c = SVARA_PH_TAP_FLAP; }        # r
    if (lower == 0x6C) { c = SVARA_PH_LATERAL_L; }       # l
    if (lower == 0x76 || lower == 0x77) { c = SVARA_PH_FRIC_V; }   # v w
    if (lower == 0x68) { c = SVARA_PH_FRIC_GLOTTAL_H; }  # h /ɦ/
    if (c != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, c); }
    return 1;
}

# Public Sanskrit engine. Ports sanskrit_rules().
#must_use
fn shabda_sanskrit_rules(word): i64 {
    return _shabda_sanskrit_rules_a(default_alloc(), word);
}

# shabda_sanskrit_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_sanskrit_rules_a(a, word): i64 {
    var chars = _shabda_decode_chars_a(a, word, 0);
    if (vec_len(chars) == 0) {
        return vec_new_a(a);
    }
    var phonemes = vec_new_a(a);
    var i = 0;
    var n = vec_len(chars);
    while (i < n) {
        var ch = vec_get(chars, i);
        var adv = 1;
        var c = _shabda_hindi_consonant_ph(ch);
        if (_shabda_sanskrit_vowel_a(a, phonemes, ch) == 1) { adv = 1; }
        elif (c != SHABDA_PH_NONE) {
            adv = _shabda_hindi_push_consonant_a(a, phonemes, chars, i, c, SVARA_PH_VOWEL_SCHWA, 0) - i;
        }
        elif (ch == 0x0902 || ch == 0x0901) {                # ं ँ
            _shabda_vec_push_a(a, phonemes, _shabda_hindi_nasal_before(chars, i + 1, SVARA_PH_NASAL_M));
        }
        elif (ch == 0x0903) { _shabda_vec_push_a(a, phonemes, SVARA_PH_FRIC_H); }   # ः visarga /h/
        elif (ch == 0x0950) {                                # ॐ /oːm/
            _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_O);
            _shabda_vec_push_a(a, phonemes, SVARA_PH_NASAL_M);
        }
        elif (ch >= 0x80 || _shabda_rules_is_ascii_alpha(ch) == 1) {
            if (ch < 0x0900 || ch > 0x097F) { adv = _shabda_sanskrit_latin_a(a, phonemes, chars, i); }
        }
        # Else (virama, avagraha, danda, accents, digits, ...): nothing.
        i = i + adv;
    }

    # Sanskrit: NO schwa deletion (preservation).
    return phonemes;
}

# ================================================================
# Arabic G2P rules — ports arabic_rules(). Modern Standard / Classical Arabic from
# the abjad: 28 letters, the hamza seats, harakat (fatha/kasra/damma), tanwin,
# shadda, sukun, the dagger alif, taa marbuta, alef maqsura, the definite article,
# + an ASCII romanized fallback. Word decoded WITHOUT ASCII-lowering.
#
# The word is read as clusters, a letter with the marks written on it, so that a
# shadda doubles the consonant whichever order it and the vowel are stored in, and
# a vowel sees the letter after it: fatha + ا, kasra + ي, damma + و are one long
# vowel. Unvocalized text has no short vowels, and the rules cannot supply them;
# a ي or و between consonants is then read as the long vowel (كبير /kabiːr/).
#
# Accuracy over the Rust (ADR-0002): /a/ is svara's VOWEL_A, not the back [ɑ],
# which is its allophone beside the emphatics and the uvulars only (see
# _shabda_arabic_backs); ح ع are the pharyngeals ħ ʕ, not h and ʔ; ق is /q/, خ غ
# the uvular fricatives (MSA /x ɣ/; svara has no velar fricative), not h and a
# stop; ر is the trill. svara has no pharyngealized consonant: an emphatic is its
# plain consonant, and the /a/ beside it is backed.
# ================================================================

# A cluster packs a letter (or 0 for marks with no letter) and the marks on it:
# base in bits 0..23, vowel in 24..26 (_SHABDA_AR_* below), shadda bit 28,
# sukun bit 29, dagger alif bit 30.
var _SHABDA_AR_A = 1;    # fatha
var _SHABDA_AR_I = 2;    # kasra
var _SHABDA_AR_U = 3;    # damma
var _SHABDA_AR_AN = 4;   # fathatan
var _SHABDA_AR_IN = 5;   # kasratan
var _SHABDA_AR_UN = 6;   # dammatan

#must_use
fn _shabda_arabic_base(cl): i64 { return cl & 0xFFFFFF; }
#must_use
fn _shabda_arabic_vowel(cl): i64 { return (cl >> 24) & 7; }
#must_use
fn _shabda_arabic_shadda(cl): i64 { return (cl >> 28) & 1; }
#must_use
fn _shabda_arabic_sukun(cl): i64 { return (cl >> 29) & 1; }
#must_use
fn _shabda_arabic_dagger(cl): i64 { return (cl >> 30) & 1; }
#must_use
fn _shabda_arabic_set_vowel(cl, v): i64 { return cl - (_shabda_arabic_vowel(cl) << 24) + (v << 24); }

# The cluster at k, or 0 past either end.
#must_use
fn _shabda_arabic_at(cls, k): i64 {
    if (k < 0 || k >= vec_len(cls)) { return 0; }
    return vec_get(cls, k);
}

# Read the codepoints into clusters. A hamza or madda written as a mark on its
# seat (the decomposed forms) gives the precomposed letter; tatweel and the
# Quranic annotation marks are dropped.
#must_use
fn _shabda_arabic_clusters_a(a, chars): i64 {
    var cls = vec_new_a(a);
    var n = vec_len(chars);
    var i = 0;
    while (i < n) {
        var cp = vec_get(chars, i);
        var m = vec_len(cls);
        var cur = 0;
        if (m > 0) { cur = vec_get(cls, m - 1); }
        var mark = 0;
        if (cp >= 0x064B && cp <= 0x0650) { mark = 1; }
        if (cp >= 0x0651 && cp <= 0x0655) { mark = 1; }
        if (cp == 0x0670) { mark = 1; }
        if (mark == 1 && m == 0) {
            _shabda_vec_push_a(a, cls, 0);   # marks before any letter
            m = 1;
        }
        if (cp == 0x0640 || (cp >= 0x06D6 && cp <= 0x06ED) || (cp >= 0x0656 && cp <= 0x065F)) {
            i = i;                                                   # tatweel, annotations
        } elif (mark == 1) {
            var b = _shabda_arabic_base(cur);
            if (cp == 0x064E) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_A); }
            if (cp == 0x0650) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_I); }
            if (cp == 0x064F) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_U); }
            if (cp == 0x064B) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_AN); }
            if (cp == 0x064D) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_IN); }
            if (cp == 0x064C) { cur = _shabda_arabic_set_vowel(cur, _SHABDA_AR_UN); }
            if (cp == 0x0651) { cur = cur | (1 << 28); }
            if (cp == 0x0652) { cur = cur | (1 << 29); }
            if (cp == 0x0670) { cur = cur | (1 << 30); }
            var nb = b;
            if (cp == 0x0653 && b == 0x0627) { nb = 0x0622; }                  # ا + ٓ  -> آ
            if (cp == 0x0654 && b == 0x0627) { nb = 0x0623; }                  # ا + ٔ  -> أ
            if (cp == 0x0655 && b == 0x0627) { nb = 0x0625; }                  # ا + ٕ  -> إ
            if (cp == 0x0654 && b == 0x0648) { nb = 0x0624; }                  # و + ٔ  -> ؤ
            if (cp == 0x0654 && (b == 0x064A || b == 0x0649)) { nb = 0x0626; } # ي + ٔ  -> ئ
            cur = cur - _shabda_arabic_base(cur) + nb;
            vec_set(cls, m - 1, cur);
        } else {
            _shabda_vec_push_a(a, cls, cp);
        }
        i = i + 1;
    }
    return cls;
}

# The svara phoneme of an Arabic consonant letter (the hamza seats included), or
# SHABDA_PH_NONE for the vowel letters ا و ي ى ة آ and anything else.
#must_use
fn _shabda_arabic_consonant_ph(b): i64 {
    if (b == 0x0628) { return SVARA_PH_PLOSIVE_B; }          # ب
    if (b == 0x062A) { return SVARA_PH_PLOSIVE_T; }          # ت
    if (b == 0x062B) { return SVARA_PH_FRIC_TH; }            # ث
    if (b == 0x062C) { return SVARA_PH_AFFR_J; }             # ج
    if (b == 0x062D) { return SVARA_PH_FRIC_PHARYNGEAL_H; }  # ح /ħ/
    if (b == 0x062E) { return SVARA_PH_FRIC_UVULAR_CH; }     # خ /x/ (svara: χ)
    if (b == 0x062F) { return SVARA_PH_PLOSIVE_D; }          # د
    if (b == 0x0630) { return SVARA_PH_FRIC_DH; }            # ذ
    if (b == 0x0631) { return SVARA_PH_TRILL_ALVEOLAR; }     # ر /r/
    if (b == 0x0632) { return SVARA_PH_FRIC_Z; }             # ز
    if (b == 0x0633) { return SVARA_PH_FRIC_S; }             # س
    if (b == 0x0634) { return SVARA_PH_FRIC_SH; }            # ش
    if (b == 0x0635) { return SVARA_PH_FRIC_S; }             # ص /sˤ/
    if (b == 0x0636) { return SVARA_PH_PLOSIVE_D; }          # ض /dˤ/
    if (b == 0x0637) { return SVARA_PH_PLOSIVE_T; }          # ط /tˤ/
    if (b == 0x0638) { return SVARA_PH_FRIC_DH; }            # ظ /ðˤ/
    if (b == 0x0639) { return SVARA_PH_FRIC_PHARYNGEAL_A; }  # ع /ʕ/
    if (b == 0x063A) { return SVARA_PH_FRIC_UVULAR_R; }      # غ /ɣ/ (svara: ʁ)
    if (b == 0x0641) { return SVARA_PH_FRIC_F; }             # ف
    if (b == 0x0642) { return SVARA_PH_PLOSIVE_UVULAR_Q; }   # ق /q/
    if (b == 0x0643) { return SVARA_PH_PLOSIVE_K; }          # ك
    if (b == 0x0644) { return SVARA_PH_LATERAL_L; }          # ل
    if (b == 0x0645) { return SVARA_PH_NASAL_M; }            # م
    if (b == 0x0646) { return SVARA_PH_NASAL_N; }            # ن
    if (b == 0x0647) { return SVARA_PH_FRIC_H; }             # ه
    if (b == 0x0621 || b == 0x0623 || b == 0x0625) { return SVARA_PH_GLOTTAL_STOP; }   # ء أ إ
    if (b == 0x0624 || b == 0x0626) { return SVARA_PH_GLOTTAL_STOP; }                  # ؤ ئ
    return SHABDA_PH_NONE;
}

# Does the letter back an /a/ beside it to [ɑ]? The emphatics ص ض ط ظ and the
# uvulars ق خ غ do (tafkhim: the seven musta'liya letters).
#must_use
fn _shabda_arabic_backs(b): i64 {
    if (b >= 0x0635 && b <= 0x0638) { return 1; }            # ص ض ط ظ
    if (b == 0x0642 || b == 0x062E || b == 0x063A) { return 1; }   # ق خ غ
    return 0;
}

# A sun letter, which the article's ل assimilates to (الشمس /aʃʃams/).
#must_use
fn _shabda_arabic_sun(b): i64 {
    if (b == 0x062A || b == 0x062B || b == 0x062F || b == 0x0630) { return 1; }   # ت ث د ذ
    if (b >= 0x0631 && b <= 0x0638) { return 1; }                                # ر ز س ش ص ض ط ظ
    if (b == 0x0644 || b == 0x0646) { return 1; }                                # ل ن
    return 0;
}

# A bare alif or alef maqsura (no mark on it), which a fatha or fathatan before it
# lengthens or supports: one vowel, /aː/ or /an/.
#must_use
fn _shabda_arabic_bare_alif(cl): i64 {
    var b = _shabda_arabic_base(cl);
    if (b != 0x0627 && b != 0x0649) { return 0; }
    if (_shabda_arabic_vowel(cl) != 0 || _shabda_arabic_shadda(cl) == 1) { return 0; }
    return 1;
}

# A bare و or ي, which a damma or kasra before it makes /uː/ or /iː/.
#must_use
fn _shabda_arabic_bare_weak(cl, b): i64 {
    if (_shabda_arabic_base(cl) != b) { return 0; }
    if (_shabda_arabic_vowel(cl) != 0 || _shabda_arabic_shadda(cl) == 1) { return 0; }
    return 1;
}

# Is cluster k the definite article's ل: ال at the word start, or after a
# proclitic و ف ب ك, with no vowel on the ل and a noun of two letters or more
# after it? (So unvocalized بال /baːl/ and والد /waːlid/ are not al-.)
#must_use
fn _shabda_arabic_article_lam(cls, k): i64 {
    var cl = _shabda_arabic_at(cls, k);
    if (_shabda_arabic_base(cl) != 0x0644 || _shabda_arabic_vowel(cl) != 0) { return 0; }
    if (_shabda_arabic_shadda(cl) == 1 || k + 2 >= vec_len(cls)) { return 0; }
    var alif = _shabda_arabic_base(_shabda_arabic_at(cls, k - 1));
    if (alif != 0x0627 && alif != 0x0671) { return 0; }
    if (k == 1) { return 1; }
    if (k == 2) {
        var p = _shabda_arabic_base(_shabda_arabic_at(cls, 0));
        if (p == 0x0648 || p == 0x0641 || p == 0x0628 || p == 0x0643) { return 1; }
    }
    return 0;
}

# /a/, backed to [ɑ] (VOWEL_OPEN_A) when the letter it is written on or the next
# letter backs it.
#must_use
fn _shabda_arabic_a(b, next_b): i64 {
    if (_shabda_arabic_backs(b) == 1 || _shabda_arabic_backs(next_b) == 1) { return SVARA_PH_VOWEL_OPEN_A; }
    return SVARA_PH_VOWEL_A;
}

# Push the vowel written on cluster k (base b), lengthened by a mater after it.
# Returns how many clusters after k it read (0 or 1).
fn _shabda_arabic_vowel_a(a, out, cls, k, b): i64 {
    var cl = vec_get(cls, k);
    var v = _shabda_arabic_vowel(cl);
    var nx = _shabda_arabic_at(cls, k + 1);
    var used = 0;
    if (v == _SHABDA_AR_A || v == _SHABDA_AR_AN) {
        if (_shabda_arabic_bare_alif(nx) == 1) {
            used = 1;
            nx = _shabda_arabic_at(cls, k + 2);
        }
        _shabda_vec_push_a(a, out, _shabda_arabic_a(b, _shabda_arabic_base(nx)));
        if (v == _SHABDA_AR_AN) { _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N); }
        return used;
    }
    if (v == _SHABDA_AR_I) {
        if (_shabda_arabic_bare_weak(nx, 0x064A) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_LONG_I);
            return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_I);
        return 0;
    }
    if (v == _SHABDA_AR_U) {
        if (_shabda_arabic_bare_weak(nx, 0x0648) == 1) {
            _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U);
            return 1;
        }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_U);
        return 0;
    }
    if (v == _SHABDA_AR_IN) {
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_I);
        _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N);
        return 0;
    }
    if (v == _SHABDA_AR_UN) {
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_U);
        _shabda_vec_push_a(a, out, SVARA_PH_NASAL_N);
        return 0;
    }
    if (_shabda_arabic_dagger(cl) == 1) {                    # dagger alif alone: /aː/
        _shabda_vec_push_a(a, out, _shabda_arabic_a(b, _shabda_arabic_base(nx)));
    }
    return 0;
}

# Latin fallback for romanized Arabic, over the clusters' letters. Pushes the
# phoneme(s) for the letter at cluster k and returns how many clusters it read:
# the digraphs sh kh gh th dh are ʃ x ɣ θ ð, and aa ii/ee uu/oo the long vowels.
fn _shabda_arabic_latin_a(a, out, cls, k): i64 {
    var lower = _shabda_ascii_lower(_shabda_arabic_base(vec_get(cls, k)));
    var next = _shabda_ascii_lower(_shabda_arabic_base(_shabda_arabic_at(cls, k + 1)));
    if (next == 0x68) {
        var dg = SHABDA_PH_NONE;
        if (lower == 0x73) { dg = SVARA_PH_FRIC_SH; }        # sh
        if (lower == 0x6B) { dg = SVARA_PH_FRIC_UVULAR_CH; } # kh
        if (lower == 0x67) { dg = SVARA_PH_FRIC_UVULAR_R; }  # gh
        if (lower == 0x74) { dg = SVARA_PH_FRIC_TH; }        # th
        if (lower == 0x64) { dg = SVARA_PH_FRIC_DH; }        # dh
        if (dg != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, dg); return 2; }
    }
    if (lower == 0x61) {                                     # a, aa
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_A);
        if (next == 0x61) { return 2; }
        return 1;
    }
    if (lower == 0x69 || (lower == 0x65 && next == 0x65)) {  # i, ii, ee
        if (next == lower) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_LONG_I); return 2; }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_I);
        return 1;
    }
    if (lower == 0x75 || (lower == 0x6F && next == 0x6F)) {  # u, uu, oo
        if (next == lower) { _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_U); return 2; }
        _shabda_vec_push_a(a, out, SVARA_PH_VOWEL_NEAR_U);
        return 1;
    }
    var c = SHABDA_PH_NONE;
    if (lower == 0x62) { c = SVARA_PH_PLOSIVE_B; }           # b
    if (lower == 0x74) { c = SVARA_PH_PLOSIVE_T; }           # t
    if (lower == 0x64) { c = SVARA_PH_PLOSIVE_D; }           # d
    if (lower == 0x6B) { c = SVARA_PH_PLOSIVE_K; }           # k
    if (lower == 0x66) { c = SVARA_PH_FRIC_F; }              # f
    if (lower == 0x73) { c = SVARA_PH_FRIC_S; }              # s
    if (lower == 0x7A) { c = SVARA_PH_FRIC_Z; }              # z
    if (lower == 0x68) { c = SVARA_PH_FRIC_H; }              # h
    if (lower == 0x6C) { c = SVARA_PH_LATERAL_L; }           # l
    if (lower == 0x6D) { c = SVARA_PH_NASAL_M; }             # m
    if (lower == 0x6E) { c = SVARA_PH_NASAL_N; }             # n
    if (lower == 0x72) { c = SVARA_PH_TRILL_ALVEOLAR; }      # r
    if (lower == 0x77) { c = SVARA_PH_APPROX_W; }            # w
    if (lower == 0x79) { c = SVARA_PH_APPROX_J; }            # y
    if (lower == 0x6A) { c = SVARA_PH_AFFR_J; }              # j
    if (lower == 0x71) { c = SVARA_PH_PLOSIVE_UVULAR_Q; }    # q
    if (c != SHABDA_PH_NONE) { _shabda_vec_push_a(a, out, c); }
    return 1;
}

# Is the last phoneme pushed a consonant (and is there one)?
#must_use
fn _shabda_arabic_after_consonant(out): i64 {
    var n = vec_len(out);
    if (n == 0) { return 0; }
    var c = svara_phoneme_class(vec_get(out, n - 1));
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) { return 0; }
    return 1;
}

# Is the letter a consonant for the unvocalized ي / و rule (not a vowel letter)?
#must_use
fn _shabda_arabic_is_consonant_letter(b): i64 {
    if (_shabda_arabic_consonant_ph(b) != SHABDA_PH_NONE) { return 1; }
    if (b == 0x0629) { return 1; }                           # ة ends a syllable as /a/ or /at/
    return 0;
}

# Public Arabic engine. Ports arabic_rules().
#must_use
fn shabda_arabic_rules(word): i64 {
    return _shabda_arabic_rules_a(default_alloc(), word);
}

# shabda_arabic_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_arabic_rules_a(a, word): i64 {
    var chars = _shabda_decode_chars_a(a, word, 0);
    if (vec_len(chars) == 0) {
        return vec_new_a(a);
    }
    var cls = _shabda_arabic_clusters_a(a, chars);
    var phonemes = vec_new_a(a);
    var m = vec_len(cls);
    var gem = 0;            # the article's ل assimilated: double the next consonant
    var k = 0;
    while (k < m) {
        var cl = vec_get(cls, k);
        var b = _shabda_arabic_base(cl);
        var v = _shabda_arabic_vowel(cl);
        var nb = _shabda_arabic_base(_shabda_arabic_at(cls, k + 1));
        var adv = 1;
        var c = _shabda_arabic_consonant_ph(b);
        if (b == 0) {
            adv = adv + _shabda_arabic_vowel_a(a, phonemes, cls, k, 0);   # marks with no letter
        } elif (b < 0x80) {
            if (_shabda_rules_is_ascii_alpha(b) == 1) { adv = _shabda_arabic_latin_a(a, phonemes, cls, k); }
        } elif (b == 0x0644 && _shabda_arabic_article_lam(cls, k) == 1) {
            if (_shabda_arabic_sun(nb) == 1) {
                if (_shabda_arabic_shadda(_shabda_arabic_at(cls, k + 1)) == 0) { gem = 1; }
            } else {
                _shabda_vec_push_a(a, phonemes, SVARA_PH_LATERAL_L);
            }
        } elif (c != SHABDA_PH_NONE) {
            _shabda_vec_push_a(a, phonemes, c);
            if (_shabda_arabic_shadda(cl) == 1 || gem == 1) { _shabda_vec_push_a(a, phonemes, c); }
            gem = 0;
            if (v == 0 && _shabda_arabic_sukun(cl) == 0 && _shabda_arabic_dagger(cl) == 0) {
                # An unvocalized hamza seat implies its vowel: إ /ʔi/, a word-initial أ /ʔa/.
                if (b == 0x0625) { _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_NEAR_I); }
                if (b == 0x0623 && k == 0) { _shabda_vec_push_a(a, phonemes, _shabda_arabic_a(b, nb)); }
            }
            adv = adv + _shabda_arabic_vowel_a(a, phonemes, cls, k, b);
        } elif (b == 0x0648 || b == 0x064A) {                # و ي
            var semi = SVARA_PH_APPROX_J;
            var longv = SVARA_PH_VOWEL_LONG_I;
            if (b == 0x0648) {
                semi = SVARA_PH_APPROX_W;
                longv = SVARA_PH_VOWEL_U;
            }
            var consonant = 1;
            if (v == 0 && _shabda_arabic_shadda(cl) == 0 && _shabda_arabic_sukun(cl) == 0 && k > 0) {
                # Unvocalized: between a consonant and a consonant (or the word end) it is
                # the long vowel. A vocalized mater was read with the vowel before it.
                var prev = _shabda_arabic_at(cls, k - 1);
                if (_shabda_arabic_vowel(prev) == 0 && _shabda_arabic_sukun(prev) == 0) {
                    if (_shabda_arabic_after_consonant(phonemes) == 1) {
                        if (k + 1 >= m || _shabda_arabic_is_consonant_letter(nb) == 1) { consonant = 0; }
                    }
                }
            }
            if (consonant == 0) {
                _shabda_vec_push_a(a, phonemes, longv);
            } else {
                _shabda_vec_push_a(a, phonemes, semi);
                if (_shabda_arabic_shadda(cl) == 1 || gem == 1) { _shabda_vec_push_a(a, phonemes, semi); }
                gem = 0;
                adv = adv + _shabda_arabic_vowel_a(a, phonemes, cls, k, b);
            }
        } elif (b == 0x0627 || b == 0x0671) {                # ا ٱ
            if (v != 0) {
                adv = adv + _shabda_arabic_vowel_a(a, phonemes, cls, k, b);   # a vowelled or tanwin alif
            } elif (k == 0) {
                # Hamzat al-wasl: /a/ in the article, else /i/ (ابن /ibn/, اثنان /iθnaːn/).
                if (nb == 0x0644) { _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_A); }
                else { _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_NEAR_I); }
            } elif (_shabda_arabic_article_lam(cls, k + 1) == 1 && k == 1) {
                # و ف ب ك + ال: the alif is elided, and the proclitic's own vowel is
                # unwritten when it is not marked.
                if (_shabda_arabic_vowel(vec_get(cls, 0)) == 0) {
                    if (_shabda_arabic_base(vec_get(cls, 0)) == 0x0628) {
                        _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_NEAR_I);
                    } else {
                        _shabda_vec_push_a(a, phonemes, SVARA_PH_VOWEL_A);
                    }
                }
            } elif (_shabda_arabic_vowel(_shabda_arabic_at(cls, k - 1)) == _SHABDA_AR_AN) {
                adv = 1;                                    # the alif after tanwin al-fath
            } elif (k == m - 1 && _shabda_arabic_base(_shabda_arabic_at(cls, k - 1)) == 0x0648) {
                adv = 1;                                    # the silent alif of -ūā (قالوا)
            } else {
                var pb = _shabda_arabic_base(_shabda_arabic_at(cls, k - 1));
                _shabda_vec_push_a(a, phonemes, _shabda_arabic_a(pb, nb));
            }
        } elif (b == 0x0622) {                               # آ /ʔaː/
            _shabda_vec_push_a(a, phonemes, SVARA_PH_GLOTTAL_STOP);
            _shabda_vec_push_a(a, phonemes, _shabda_arabic_a(b, nb));
        } elif (b == 0x0649) {                               # ى /aː/
            var pb2 = _shabda_arabic_base(_shabda_arabic_at(cls, k - 1));
            _shabda_vec_push_a(a, phonemes, _shabda_arabic_a(pb2, 0));
        } elif (b == 0x0629) {                               # ة
            if (v != 0) {
                _shabda_vec_push_a(a, phonemes, SVARA_PH_PLOSIVE_T);
                adv = adv + _shabda_arabic_vowel_a(a, phonemes, cls, k, b);
            } else {
                # Pausal /a/, which the fatha or alif before it may already have given.
                var pn = vec_len(phonemes);
                var last = SHABDA_PH_NONE;
                if (pn > 0) { last = vec_get(phonemes, pn - 1); }
                if (last != SVARA_PH_VOWEL_A && last != SVARA_PH_VOWEL_OPEN_A) {
                    var pb3 = _shabda_arabic_base(_shabda_arabic_at(cls, k - 1));
                    _shabda_vec_push_a(a, phonemes, _shabda_arabic_a(pb3, 0));
                }
            }
        }
        # Else (an unknown letter): nothing.
        k = k + adv;
    }

    return phonemes;
}

# --- prosody.cyr ---

# prosody.cyr — prosody assignment: stress patterns, emphasis, rate, timing,
# and sentence intonation.
#
# Ports rust-old/src/prosody.rs. Maps sentence structure and word class to
# stress and intonation, producing svara-compatible PhonemeEvents.
#
# DEP POSITION: svara (PhonemeEvent ctor + accessors, phoneme class/duration,
# Stress/Intonation consts, SVARA_PH_SILENCE) + src/error.cyr (SentenceType tags,
# SHABDA_NO_STRESS_IDX, SHABDA_TIMING_* layout offsets) + src/syllable.cyr
# (Syllable accessors + shabda_syllable_is_heavy). The entry file includes all of
# those ABOVE this module. Modules never include each other.
#
# PhonemeEvent is immutable-by-handle in Cyrius: the Rust `event.stress = ...` /
# `event.duration *= ...` in-place mutations are re-expressed by rebuilding the
# event via svara_phoneme_event_new(phoneme, dur, stress) and vec_set-ing it back.
#
# Float parity: every Rust f32 constant is promoted to f64 (svara durations are
# f64 bits). The f64 arithmetic/comparison intrinsics (f64_mul/f64_gt/f64_lt/
# f64_from) are compiler builtins; clamp/max are inlined here (math.cyr is not in
# the include set).
#
# NAMING: public surface is `shabda_`-prefixed; private helpers are
# `_shabda_prosody_*` to keep the flat link namespace collision-free.

# ---- Promoted f64 constants (were Rust f32) ----------------------------------
# DEFAULT_WPM = 150.0
var SHABDA_PROSODY_DEFAULT_WPM = 0x4062_C000_0000_0000;
# MIN_WPM = 50.0
var SHABDA_PROSODY_MIN_WPM = 0x4049_0000_0000_0000;
# MAX_WPM = 300.0
var SHABDA_PROSODY_MAX_WPM = 0x4072_C000_0000_0000;
# MIN_CONSONANT_DURATION = 0.03
var SHABDA_PROSODY_MIN_CONSONANT_DURATION = 0x3F9E_B851_EB85_1EB8;
# MIN_VOWEL_DURATION = 0.05
var SHABDA_PROSODY_MIN_VOWEL_DURATION = 0x3FA9_9999_9999_999A;
# EMPHASIS_DURATION_SCALE = 1.3
var SHABDA_PROSODY_EMPHASIS_DURATION_SCALE = 0x3FF4_CCCC_CCCC_CCCD;

# ---- Private helpers ---------------------------------------------------------
# True if the phoneme is a vowel or diphthong (stress-bearing).
fn _shabda_prosody_is_vowel_like(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL) { return 1; }
    if (c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

# f64 max(a, b) — larger of two IEEE-754 f64 bit patterns.
fn _shabda_prosody_f64_max(a, b): i64 {
    if (f64_gt(a, b) == 1) { return a; }
    return b;
}

# f64 clamp(x, lo, hi).
fn _shabda_prosody_f64_clamp(x, lo, hi): i64 {
    if (f64_lt(x, lo) == 1) { return lo; }
    if (f64_gt(x, hi) == 1) { return hi; }
    return x;
}

# svara_phoneme_event_new(phoneme, duration, stress) with the event drawn from
# Allocator `a`. svara's constructor takes no allocator, so this builds the same
# record through svara's public struct: sizeof(SvPhonemeEvent) bytes, each field
# set with svara's own setter, the tone to SVARA_TONE_NONE as svara sets it.
# tests/prosody.tcyr compares the two byte for byte, so a field svara adds later
# fails a test instead of reading as zero.
#must_use
fn _shabda_event_new_a(a, phoneme, duration, stress): i64 {
    var e = alloc_via(a, sizeof(SvPhonemeEvent));
    SvPhonemeEvent_set_phoneme(e, phoneme);
    SvPhonemeEvent_set_duration(e, duration);
    SvPhonemeEvent_set_stress(e, stress);
    SvPhonemeEvent_set_tone(e, SVARA_TONE_NONE);
    return e;
}

# ---- assign_stress -----------------------------------------------------------
# Convert a word's phoneme sequence (vec of ordinals) into PhonemeEvents with
# stress. First vowel-like ph in a content word -> Primary, later vowel-like ->
# Secondary, else Unstressed; function words -> all Unstressed.
#must_use
fn shabda_assign_stress(phonemes, is_content_word): i64 {
    return _shabda_assign_stress_a(default_alloc(), phonemes, is_content_word);
}

# shabda_assign_stress, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_assign_stress_a(a, phonemes, is_content_word): i64 {
    var events = vec_new_a(a);
    var found_primary = 0;
    var n = vec_len(phonemes);
    var i = 0;
    while (i < n) {
        var ph = vec_get(phonemes, i);
        var dur = svara_phoneme_duration(ph);
        var stress = SVARA_STRESS_UNSTRESSED;
        if (is_content_word == 0) {
            stress = SVARA_STRESS_UNSTRESSED;
        } elif ((_shabda_prosody_is_vowel_like(ph) == 1) & (found_primary == 0)) {
            found_primary = 1;
            stress = SVARA_STRESS_PRIMARY;
        } elif (_shabda_prosody_is_vowel_like(ph) == 1) {
            stress = SVARA_STRESS_SECONDARY;
        } else {
            stress = SVARA_STRESS_UNSTRESSED;
        }
        _shabda_vec_push_a(a, events, _shabda_event_new_a(a, ph, dur, stress));
        i = i + 1;
    }
    return events;
}

# ---- assign_stress_syllabic --------------------------------------------------
# Assign stress using syllable-weight analysis over a vec of Syllable*.
# Monosyllable/2-syllable -> stress first; heavy penult -> penult; else
# antepenult; function words -> none.
#must_use
fn shabda_assign_stress_syllabic(syllables, is_content_word): i64 {
    return _shabda_assign_stress_syllabic_a(default_alloc(), syllables, is_content_word);
}

# shabda_assign_stress_syllabic, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_assign_stress_syllabic_a(a, syllables, is_content_word): i64 {
    var events = vec_new_a(a);
    var len = vec_len(syllables);
    if (len == 0) { return events; }

    # Determine which syllable index gets primary stress.
    var primary_idx = SHABDA_NO_STRESS_IDX;
    if (is_content_word == 0) {
        primary_idx = SHABDA_NO_STRESS_IDX;
    } elif (len <= 2) {
        primary_idx = 0;
    } else {
        var penult = len - 2;
        if (shabda_syllable_is_heavy(vec_get(syllables, penult)) == 1) {
            primary_idx = penult;
        } else {
            # Stress antepenult (third from end); Rust saturating_sub(3).
            if (len >= 3) {
                primary_idx = len - 3;
            } else {
                primary_idx = 0;
            }
        }
    }

    var syl_idx = 0;
    while (syl_idx < len) {
        var syllable = vec_get(syllables, syl_idx);
        var syl_stress = SVARA_STRESS_UNSTRESSED;
        if (syl_idx == primary_idx) {
            syl_stress = SVARA_STRESS_PRIMARY;
        } else {
            syl_stress = SVARA_STRESS_UNSTRESSED;
        }

        # Onset: unstressed.
        var onset = shabda_syllable_onset(syllable);
        var on = vec_len(onset);
        var oi = 0;
        while (oi < on) {
            var oph = vec_get(onset, oi);
            var odur = svara_phoneme_duration(oph);
            _shabda_vec_push_a(a, events, _shabda_event_new_a(a, oph, odur, SVARA_STRESS_UNSTRESSED));
            oi = oi + 1;
        }
        # Nucleus: carries the syllable's stress.
        var nuc = shabda_syllable_nucleus(syllable);
        var ndur = svara_phoneme_duration(nuc);
        _shabda_vec_push_a(a, events, _shabda_event_new_a(a, nuc, ndur, syl_stress));
        # Coda: unstressed.
        var coda = shabda_syllable_coda(syllable);
        var cn = vec_len(coda);
        var ci = 0;
        while (ci < cn) {
            var cph = vec_get(coda, ci);
            var cdur = svara_phoneme_duration(cph);
            _shabda_vec_push_a(a, events, _shabda_event_new_a(a, cph, cdur, SVARA_STRESS_UNSTRESSED));
            ci = ci + 1;
        }

        syl_idx = syl_idx + 1;
    }

    return events;
}

# ---- assign_stress_english ---------------------------------------------------
# Since 3.2.0 a dictionary word takes the dictionary's stress (assign_stress_dictionary
# below), so these rules serve the words the letter-to-sound rules convert, and
# dictionary entries without stress.
#
# English lexical stress from the word's spelling and its syllables. The syllabic
# rule above is Latin's (heavy penult, else antepenult); English differs in four
# ways that the phonology literature states and the dictionary shows:
#
#  1. A reduced vowel is never stressed: /ə/ is English's unstressed vowel (CMUdict
#     writes it AH0 and nothing else). The pick moves to the nearest full vowel,
#     rightward first ("about" ə.ˈbaʊt).
#  2. Stress-neutral suffixes leave the base's stress where it was (Chomsky & Halle
#     1968, Sound Pattern of English; Kiparsky 1982's level 2): -ly -ness -less -ful
#     -ing(s) -er(s) and a syllabic -ted / -ded. Each is stripped, when the spelling
#     AND the phonemes show it, and stress is assigned to what remains
#     ("ab.so.ˈlute.ly", "ˈcom.fort.ing").
#  3. Pre-stressing suffixes stress the syllable before them: -ic(s), -ical, -ity,
#     -ify, and -ion / -ian / -ial / -ious / -ient / -eous / -uous, whether the i is a
#     palatal (nation, musician) or its own syllable (union, various) (ibid.; Fudge
#     1984, English Word-Stress). Suffixes from French take the stress themselves:
#     -ee -eer -ese -ette -esque -ique -oon -aire (employee, career, cassette).
#  4. A disyllable whose first syllable is the prefix be- de- re- pre- dis- ex- en-
#     em- in- im- mis- e- with the reduced /ɪ/ stresses its root (begin, decide,
#     reflect); with a full vowel the prefix keeps it (ˈrecord the noun, ˈdecade).
#
# Measured on shabdakosh's 10,617 CMUdict words against CMUdict's own stress digits
# (function words left out), primary stress lands on the right syllable for 87.9% of
# the 8,701 polysyllables; the syllabic rule alone gets 70.8%.

var SHABDA_EN_REDUCED_I = (0 - 1);   # tail pattern slot: /ə/ or /ɪ/
var SHABDA_EN_REDUCED_U = (0 - 2);   # tail pattern slot: /ə/ or /ʊ/
var SHABDA_EN_ANY       = (0 - 3);   # tail pattern slot: unused

# 1 if word[0..wend) ends with cstr `suf`.
fn _shabda_prosody_en_ends(word, wend, suf): i64 {
    var n = strlen(suf);
    if (n > wend) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(word + wend - n + i) != load8(suf + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if word starts with cstr `pre`.
fn _shabda_prosody_en_starts(word, pre): i64 {
    var i = 0;
    while (load8(pre + i) != 0) {
        if (load8(word + i) != load8(pre + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if phoneme `p` matches tail pattern slot `want` (an ordinal or SHABDA_EN_*).
fn _shabda_prosody_en_slot(p, want): i64 {
    if (want == SHABDA_EN_ANY) { return 1; }
    if (want == SHABDA_EN_REDUCED_I) { return (p == SVARA_PH_VOWEL_SCHWA) | (p == SVARA_PH_VOWEL_NEAR_I); }
    if (want == SHABDA_EN_REDUCED_U) { return (p == SVARA_PH_VOWEL_SCHWA) | (p == SVARA_PH_VOWEL_NEAR_U); }
    return p == want;
}

# 1 if ph[0..pend) ends with the n-phoneme pattern p0 p1 p2 (first n of them).
fn _shabda_prosody_en_tail(ph, pend, n, p0, p1, p2): i64 {
    if (pend < n) { return 0; }
    if (_shabda_prosody_en_slot(vec_get(ph, pend - n), p0) == 0) { return 0; }
    if (n >= 2 && _shabda_prosody_en_slot(vec_get(ph, pend - n + 1), p1) == 0) { return 0; }
    if (n >= 3 && _shabda_prosody_en_slot(vec_get(ph, pend - n + 2), p2) == 0) { return 0; }
    return 1;
}

# One stress-neutral suffix at the end of word[0..wend) / ph[0..pend), or 0. A match
# packs (letters) | (phonemes << 8) | (syllables << 16). The stem must keep two
# letters.
fn _shabda_prosody_en_neutral(word, wend, ph, pend): i64 {
    var L = SVARA_PH_LATERAL_L;
    var RI = SHABDA_EN_REDUCED_I;
    var X = SHABDA_EN_ANY;
    var IH = SVARA_PH_VOWEL_NEAR_I;
    var ER = SVARA_PH_VOWEL_BIRD;
    var S = SVARA_PH_FRIC_S;
    var T = SVARA_PH_PLOSIVE_T;
    var D = SVARA_PH_PLOSIVE_D;
    var one = 1 << 16;
    if (wend > 3 && _shabda_prosody_en_ends(word, wend, "ly") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 2, L, SVARA_PH_VOWEL_LONG_I, X) == 1) { return 2 | (2 << 8) | one; }
    }
    if (wend > 5 && _shabda_prosody_en_ends(word, wend, "ness") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, SVARA_PH_NASAL_N, RI, S) == 1) { return 4 | (3 << 8) | one; }
    }
    if (wend > 5 && _shabda_prosody_en_ends(word, wend, "less") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, L, RI, S) == 1) { return 4 | (3 << 8) | one; }
    }
    if (wend > 4 && _shabda_prosody_en_ends(word, wend, "ful") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, SVARA_PH_FRIC_F, SHABDA_EN_REDUCED_U, L) == 1) {
            return 3 | (3 << 8) | one;
        }
    }
    if (wend > 4 && _shabda_prosody_en_ends(word, wend, "ing") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 2, IH, SVARA_PH_NASAL_NG, X) == 1) { return 3 | (2 << 8) | one; }
    }
    if (wend > 5 && _shabda_prosody_en_ends(word, wend, "ings") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, IH, SVARA_PH_NASAL_NG, SVARA_PH_FRIC_Z) == 1) {
            return 4 | (3 << 8) | one;
        }
    }
    if (wend > 3 && _shabda_prosody_en_ends(word, wend, "er") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 1, ER, X, X) == 1) { return 2 | (1 << 8) | one; }
    }
    if (wend > 4 && _shabda_prosody_en_ends(word, wend, "ers") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 2, ER, SVARA_PH_FRIC_Z, X) == 1) { return 3 | (2 << 8) | one; }
    }
    if (wend > 4 && _shabda_prosody_en_ends(word, wend, "ted") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, T, RI, D) == 1) { return 3 | (3 << 8) | one; }
    }
    if (wend > 4 && _shabda_prosody_en_ends(word, wend, "ded") == 1) {
        if (_shabda_prosody_en_tail(ph, pend, 3, D, RI, D) == 1) { return 3 | (3 << 8) | one; }
    }
    return 0;
}

# Rule 1: index `i`, or the nearest syllable in [0, hi) whose nucleus is not /ə/,
# looking right first.
fn _shabda_prosody_en_unreduced(syllables, i, hi): i64 {
    if (shabda_syllable_nucleus(vec_get(syllables, i)) != SVARA_PH_VOWEL_SCHWA) { return i; }
    var j = i + 1;
    while (j < hi) {
        if (shabda_syllable_nucleus(vec_get(syllables, j)) != SVARA_PH_VOWEL_SCHWA) { return j; }
        j = j + 1;
    }
    j = i - 1;
    while (j >= 0) {
        if (shabda_syllable_nucleus(vec_get(syllables, j)) != SVARA_PH_VOWEL_SCHWA) { return j; }
        j = j - 1;
    }
    return i;
}

# 1 if word[0..wend) ends with any suffix of a -ion-type family. `family` 0: the forms
# after a palatal (nation, musician, social, delicious, patient, ocean, gorgeous); 1:
# the forms with i / e its own syllable (union, Indian, burial, various, mania,
# premium, familiar, senior, convenient, spontaneous, continuous, valiant).
fn _shabda_prosody_en_ion(word, wend, family): i64 {
    if (_shabda_prosody_en_ends(word, wend, "ion") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ian") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ial") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ious") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ient") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ience") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "eous") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "uous") == 1) { return 1; }
    if (family == 0) {
        if (_shabda_prosody_en_ends(word, wend, "ions") == 1) { return 1; }
        if (_shabda_prosody_en_ends(word, wend, "ians") == 1) { return 1; }
        if (_shabda_prosody_en_ends(word, wend, "cean") == 1) { return 1; }
        return 0;
    }
    if (_shabda_prosody_en_ends(word, wend, "ia") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ium") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "iar") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ior") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "iant") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "iance") == 1) { return 1; }
    return 0;
}

# 1 if the (lowercase) word ends with a French suffix that takes the stress.
fn _shabda_prosody_en_final_suffix(word, wend): i64 {
    if (_shabda_prosody_en_ends(word, wend, "ee") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "eer") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ese") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ette") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "esque") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "ique") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "oon") == 1) { return 1; }
    if (_shabda_prosody_en_ends(word, wend, "aire") == 1) { return 1; }
    return 0;
}

# 1 if word[0..wend) begins with a prefix of rule 4 and keeps two letters after it.
fn _shabda_prosody_en_weak_prefix(word, wend): i64 {
    var n = 0;
    if (n == 0 && _shabda_prosody_en_starts(word, "be") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "de") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "re") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "pre") == 1) { n = 3; }
    if (n == 0 && _shabda_prosody_en_starts(word, "dis") == 1) { n = 3; }
    if (n == 0 && _shabda_prosody_en_starts(word, "ex") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "en") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "em") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "in") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "im") == 1) { n = 2; }
    if (n == 0 && _shabda_prosody_en_starts(word, "mis") == 1) { n = 3; }
    if (n == 0 && _shabda_prosody_en_starts(word, "e") == 1) { n = 1; }
    if (n == 0) { return 0; }
    return wend > n + 1;
}

# Index of the syllable that takes primary stress in an English content word: the
# four rules above, then the syllabic rule on what remains. `word` is the lowercase
# spelling, `phonemes` the syllables' phonemes in order (syllabify partitions them),
# `syllables` a non-empty vec of Syllable*.
#must_use
fn _shabda_prosody_en_primary_idx(word, phonemes, syllables): i64 {
    var n = vec_len(syllables);
    if (n <= 1) { return 0; }
    var NI = SVARA_PH_VOWEL_NEAR_I;
    var SCHWA = SVARA_PH_VOWEL_SCHWA;

    # Rule 2: strip stress-neutral suffixes, keeping at least one syllable.
    var wend = strlen(word);
    var pend = vec_len(phonemes);
    var k = 0;
    var hit = _shabda_prosody_en_neutral(word, wend, phonemes, pend);
    while (hit != 0 && n - k - (hit >> 16) >= 1) {
        wend = wend - (hit & 255);
        pend = pend - ((hit >> 8) & 255);
        k = k + (hit >> 16);
        hit = _shabda_prosody_en_neutral(word, wend, phonemes, pend);
    }
    var m = n - k;

    # Rule 3: pre-stressing suffixes on the stem.
    if (m >= 2) {
        var lastn = shabda_syllable_nucleus(vec_get(syllables, m - 1));
        var ic = _shabda_prosody_en_ends(word, wend, "ic") | _shabda_prosody_en_ends(word, wend, "ics");
        if (ic == 1 && lastn == NI) {
            return _shabda_prosody_en_unreduced(syllables, m - 2, m);
        }
        if (m >= 3) {
            var pen = shabda_syllable_nucleus(vec_get(syllables, m - 2));
            if (_shabda_prosody_en_ends(word, wend, "ical") == 1 && pen == NI) {
                return _shabda_prosody_en_unreduced(syllables, m - 3, m);
            }
            if (_shabda_prosody_en_ends(word, wend, "ity") == 1 && lastn == SVARA_PH_VOWEL_LONG_I) {
                return _shabda_prosody_en_unreduced(syllables, m - 3, m);
            }
            if (_shabda_prosody_en_ends(word, wend, "ify") == 1 && lastn == SVARA_PH_DIPH_AI) {
                return _shabda_prosody_en_unreduced(syllables, m - 3, m);
            }
        }
        var lonset = shabda_syllable_onset(vec_get(syllables, m - 1));
        var lon = vec_len(lonset);
        if (lastn == SCHWA && lon >= 1 && _shabda_prosody_en_ion(word, wend, 0) == 1) {
            var oc = vec_get(lonset, lon - 1);
            if (oc == SVARA_PH_FRIC_SH || oc == SVARA_PH_FRIC_ZH || oc == SVARA_PH_AFFR_CH || oc == SVARA_PH_AFFR_J) {
                return _shabda_prosody_en_unreduced(syllables, m - 2, m);
            }
        }
        if (m >= 3 && lastn == SCHWA && lon == 0 && _shabda_prosody_en_ion(word, wend, 1) == 1) {
            var hn = shabda_syllable_nucleus(vec_get(syllables, m - 2));
            if (hn == SVARA_PH_VOWEL_LONG_I || hn == NI) {
                return _shabda_prosody_en_unreduced(syllables, m - 3, m);
            }
        }
    }
    # Rule 3, French suffixes.
    if (k == 0 && _shabda_prosody_en_final_suffix(word, wend) == 1) {
        if (shabda_syllable_nucleus(vec_get(syllables, n - 1)) != SCHWA) { return n - 1; }
    }
    if (m == 1) { return 0; }
    # Rule 4: a weak prefix in a disyllabic stem.
    if (m == 2) {
        var first = 0;
        if (_shabda_prosody_en_weak_prefix(word, wend) == 1) {
            if (shabda_syllable_nucleus(vec_get(syllables, 0)) == NI) { first = 1; }
        }
        return _shabda_prosody_en_unreduced(syllables, first, m);
    }
    # The syllabic rule on the stem, then rule 1.
    var pick = m - 3;
    if (shabda_syllable_is_heavy(vec_get(syllables, m - 2)) == 1) { pick = m - 2; }
    return _shabda_prosody_en_unreduced(syllables, pick, m);
}

# PhonemeEvents for `syllables` with primary stress on syllable `primary_idx`
# (SHABDA_NO_STRESS_IDX: none): the nucleus carries the syllable's stress, onset and
# coda are unstressed.
#must_use
fn _shabda_stress_events_a(a, syllables, primary_idx): i64 {
    var events = vec_new_a(a);
    var len = vec_len(syllables);
    var syl_idx = 0;
    while (syl_idx < len) {
        var syllable = vec_get(syllables, syl_idx);
        var syl_stress = SVARA_STRESS_UNSTRESSED;
        if (syl_idx == primary_idx) { syl_stress = SVARA_STRESS_PRIMARY; }
        var onset = shabda_syllable_onset(syllable);
        var oi = 0;
        while (oi < vec_len(onset)) {
            var oph = vec_get(onset, oi);
            var oev = _shabda_event_new_a(a, oph, svara_phoneme_duration(oph), SVARA_STRESS_UNSTRESSED);
            _shabda_vec_push_a(a, events, oev);
            oi = oi + 1;
        }
        var nuc = shabda_syllable_nucleus(syllable);
        _shabda_vec_push_a(a, events, _shabda_event_new_a(a, nuc, svara_phoneme_duration(nuc), syl_stress));
        var coda = shabda_syllable_coda(syllable);
        var ci = 0;
        while (ci < vec_len(coda)) {
            var cph = vec_get(coda, ci);
            var cev = _shabda_event_new_a(a, cph, svara_phoneme_duration(cph), SVARA_STRESS_UNSTRESSED);
            _shabda_vec_push_a(a, events, cev);
            ci = ci + 1;
        }
        syl_idx = syl_idx + 1;
    }
    return events;
}

# English stress: PhonemeEvents for `syllables` (a vec of Syllable*, from
# shabda_syllabify) of the lowercase word `word`, with primary stress where English
# puts it (see the notes above) on a content word, and none on a function word.
#must_use
fn shabda_assign_stress_english(word, syllables, is_content_word): i64 {
    return _shabda_assign_stress_english_a(default_alloc(), word, syllables, is_content_word);
}

# shabda_assign_stress_english, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_assign_stress_english_a(a, word, syllables, is_content_word): i64 {
    if (vec_len(syllables) == 0) { return vec_new_a(a); }
    if (is_content_word == 0) { return _shabda_stress_events_a(a, syllables, SHABDA_NO_STRESS_IDX); }
    # The syllables' phonemes in order, for the suffix tests.
    var ph = vec_new_a(a);
    var i = 0;
    while (i < vec_len(syllables)) {
        var syl = vec_get(syllables, i);
        var on = shabda_syllable_onset(syl);
        var j = 0;
        while (j < vec_len(on)) { _shabda_vec_push_a(a, ph, vec_get(on, j)); j = j + 1; }
        _shabda_vec_push_a(a, ph, shabda_syllable_nucleus(syl));
        var co = shabda_syllable_coda(syl);
        j = 0;
        while (j < vec_len(co)) { _shabda_vec_push_a(a, ph, vec_get(co, j)); j = j + 1; }
        i = i + 1;
    }
    return _shabda_stress_events_a(a, syllables, _shabda_prosody_en_primary_idx(word, ph, syllables));
}

# ---- assign_stress_dictionary ------------------------------------------------
# CMUdict's primary and secondary stress digits, the values shabdakosh stores as
# SHBDK_STRESS_PRIMARY / SHBDK_STRESS_SECONDARY (tests/prosody.tcyr checks that they
# agree). shabda names them itself because `cyrius distlib` compile-checks the bundle
# without shabdakosh, which the consumer supplies, and that check passes an undefined
# function but refuses an undefined variable.
var SHABDA_DICT_STRESS_PRIMARY = 1;
var SHABDA_DICT_STRESS_SECONDARY = 2;

# PhonemeEvents for a dictionary word's `phonemes` with the dictionary's stress:
# `stress` holds one value per phoneme, CMUdict's digit as shabdakosh keeps it
# (shbdk_pronunciation_stress, 3.2.0). SHBDK_STRESS_PRIMARY (1) is Primary,
# SHBDK_STRESS_SECONDARY (2) Secondary, and an unstressed vowel (0) or a consonant
# (SHBDK_STRESS_NONE) Unstressed. A function word gets no stress, as on the
# heuristic paths: CMUdict gives a word's citation form ("of" AH1 V, "to" T UW1),
# and English function words are weak in running speech. A missing `stress` (0),
# or a phoneme past its end, is Unstressed.
#must_use
fn shabda_assign_stress_dictionary(phonemes, stress, is_content_word): i64 {
    return _shabda_assign_stress_dictionary_a(default_alloc(), phonemes, stress, is_content_word);
}

# shabda_assign_stress_dictionary, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_assign_stress_dictionary_a(a, phonemes, stress, is_content_word): i64 {
    var events = vec_new_a(a);
    var n = vec_len(phonemes);
    var sn = 0;
    if (stress != 0 && is_content_word != 0) { sn = vec_len(stress); }
    var i = 0;
    while (i < n) {
        var ph = vec_get(phonemes, i);
        var st = SVARA_STRESS_UNSTRESSED;
        if (i < sn) {
            var d = vec_get(stress, i);
            if (d == SHABDA_DICT_STRESS_PRIMARY) { st = SVARA_STRESS_PRIMARY; }
            if (d == SHABDA_DICT_STRESS_SECONDARY) { st = SVARA_STRESS_SECONDARY; }
        }
        _shabda_vec_push_a(a, events, _shabda_event_new_a(a, ph, svara_phoneme_duration(ph), st));
        i = i + 1;
    }
    return events;
}

# ---- is_content_word ---------------------------------------------------------
# 1 if `word` (cstr) is a content word, 0 if it is one of the ~40 English
# function words. Compares the ASCII-lowercased word against the function set.
#must_use
fn shabda_is_content_word(word): i64 {
    return _shabda_is_content_word_a(default_alloc(), word);
}

# shabda_is_content_word, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_is_content_word_a(a, word): i64 {
    var w = _shabda_ascii_lower_a(a, word);
    if (streq(w, "a") == 1) { return 0; }
    if (streq(w, "an") == 1) { return 0; }
    if (streq(w, "the") == 1) { return 0; }
    if (streq(w, "is") == 1) { return 0; }
    if (streq(w, "am") == 1) { return 0; }
    if (streq(w, "are") == 1) { return 0; }
    if (streq(w, "was") == 1) { return 0; }
    if (streq(w, "were") == 1) { return 0; }
    if (streq(w, "be") == 1) { return 0; }
    if (streq(w, "been") == 1) { return 0; }
    if (streq(w, "to") == 1) { return 0; }
    if (streq(w, "of") == 1) { return 0; }
    if (streq(w, "in") == 1) { return 0; }
    if (streq(w, "on") == 1) { return 0; }
    if (streq(w, "at") == 1) { return 0; }
    if (streq(w, "by") == 1) { return 0; }
    if (streq(w, "for") == 1) { return 0; }
    if (streq(w, "and") == 1) { return 0; }
    if (streq(w, "or") == 1) { return 0; }
    if (streq(w, "but") == 1) { return 0; }
    if (streq(w, "if") == 1) { return 0; }
    if (streq(w, "it") == 1) { return 0; }
    if (streq(w, "he") == 1) { return 0; }
    if (streq(w, "she") == 1) { return 0; }
    if (streq(w, "we") == 1) { return 0; }
    if (streq(w, "they") == 1) { return 0; }
    if (streq(w, "that") == 1) { return 0; }
    if (streq(w, "this") == 1) { return 0; }
    if (streq(w, "with") == 1) { return 0; }
    if (streq(w, "not") == 1) { return 0; }
    if (streq(w, "do") == 1) { return 0; }
    if (streq(w, "did") == 1) { return 0; }
    if (streq(w, "has") == 1) { return 0; }
    if (streq(w, "had") == 1) { return 0; }
    if (streq(w, "have") == 1) { return 0; }
    return 1;
}

# ---- apply_emphasis ----------------------------------------------------------
# Boost every vowel-like event to Primary stress and scale its duration by 1.3x.
# Mutates each event IN PLACE, as Rust does over its `&mut [PhonemeEvent]`. These
# three fns used to mint a replacement SvPhonemeEvent per mutated element — an
# allocation per event per call, out of a bump allocator that never frees, where the
# oracle allocates nothing.
fn shabda_apply_emphasis(events): i64 {
    var n = vec_len(events);
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        var ph = SvPhonemeEvent_phoneme(e);
        if (_shabda_prosody_is_vowel_like(ph) == 1) {
            SvPhonemeEvent_set_duration(e, f64_mul(SvPhonemeEvent_duration(e), SHABDA_PROSODY_EMPHASIS_DURATION_SCALE));
            SvPhonemeEvent_set_stress(e, SVARA_STRESS_PRIMARY);
        }
        i = i + 1;
    }
    return 0;
}

# ---- apply_rate --------------------------------------------------------------
# Scale event durations to a target speaking rate (WPM clamped to 50..300).
# scale = 150/clamped; enforce per-class minimum durations.
fn shabda_apply_rate(events, target_wpm): i64 {
    var clamped_wpm = _shabda_prosody_f64_clamp(target_wpm, SHABDA_PROSODY_MIN_WPM, SHABDA_PROSODY_MAX_WPM);
    var scale = f64_div(SHABDA_PROSODY_DEFAULT_WPM, clamped_wpm);

    var n = vec_len(events);
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        var ph = SvPhonemeEvent_phoneme(e);
        var scaled = f64_mul(SvPhonemeEvent_duration(e), scale);
        var min = SHABDA_PROSODY_MIN_CONSONANT_DURATION;
        if (_shabda_prosody_is_vowel_like(ph) == 1) {
            min = SHABDA_PROSODY_MIN_VOWEL_DURATION;
        }
        SvPhonemeEvent_set_duration(e, _shabda_prosody_f64_max(scaled, min));
        i = i + 1;
    }
    return 0;
}

# ---- apply_timing ------------------------------------------------------------
# Scale each event's duration by a per-category factor from a TimingProfile:
# silence -> pause_scale, vowel-like -> vowel_scale, else consonant_scale. The
# profile stores three f64-bit scales at the SHABDA_TIMING_* offsets.
fn shabda_apply_timing(events, profile): i64 {
    var vowel_scale = load64(profile + SHABDA_TIMING_VOWEL);
    var consonant_scale = load64(profile + SHABDA_TIMING_CONSONANT);
    var pause_scale = load64(profile + SHABDA_TIMING_PAUSE);

    var n = vec_len(events);
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        var ph = SvPhonemeEvent_phoneme(e);
        var scale = consonant_scale;
        if (ph == SVARA_PH_SILENCE) {
            scale = pause_scale;
        } elif (_shabda_prosody_is_vowel_like(ph) == 1) {
            scale = vowel_scale;
        } else {
            scale = consonant_scale;
        }
        SvPhonemeEvent_set_duration(e, f64_mul(SvPhonemeEvent_duration(e), scale));
        i = i + 1;
    }
    return 0;
}

# ---- sentence_intonation -----------------------------------------------------
# Map a SentenceType tag to a svara IntonationPattern.
#must_use
fn shabda_sentence_intonation(sentence_type): i64 {
    if (sentence_type == SHABDA_STYPE_STATEMENT) { return SVARA_INTONATION_DECLARATIVE; }
    if (sentence_type == SHABDA_STYPE_QUESTION) { return SVARA_INTONATION_INTERROGATIVE; }
    if (sentence_type == SHABDA_STYPE_EXCLAMATION) { return SVARA_INTONATION_EXCLAMATORY; }
    return SVARA_INTONATION_DECLARATIVE;
}

# --- validate.cyr ---

# validate.cyr — phoneme inventory + phonotactic validation via varna.
#
# Ports rust-old/src/validate.rs. In Rust the whole module is
# #[cfg(feature = "varna")]; here it is compiled UNCONDITIONALLY (varna is a
# hard dep of the Cyrius port, mirroring shabdakosh's always-on inventory).
#
# Verifies that phoneme output from the G2P rules is valid for a target
# language's phoneme inventory as defined by varna. Each IPA string below is the
# symbol varna's inventory uses for the sound the rules mean by that phoneme, so an
# accurate phoneme validates and an inaccurate one is reported. Accuracy decides,
# not the Rust (ADR-0002): 3.1.2 retired the Rust's VOWEL_E stand-in for /iː/ (now
# VOWEL_LONG_I) and /yː/ (now VOWEL_Y), so VOWEL_E is /e/ in every table, and spells
# the Spanish tap ɾ and trill r, as IPA and varna 2.6.0 do (it was r / rr).
#
# DEP POSITION: svara + varna. The entry file (tests/validate.tcyr / main.cyr)
# includes lib/svara.cyr (SVARA_PH_* ordinals + SVARA_CLASS_* + phoneme class
# query), lib/varna.cyr (phoneme_english/… inventories, phoneme_has,
# phonotactics_english + max_onset/max_coda) and src/error.cyr (SHABDA_LANG_*,
# SHABDA_PH_NONE) ABOVE this module. Modules never include each other.
#
# A svara Phoneme is an i64 ordinal (0..SVARA_PH_SILENCE). Rust's Option::None
# on an IPA lookup becomes the sentinel 0 (a null cstr pointer) — a phoneme with
# no IPA in the given inventory returns 0. Report Strings become cstr vecs.
#
# NAMING: public surface is `shabda_`-prefixed; private helpers are
# `_shabda_validate_<name>` (flat link namespace, avoids duplicate-fn clashes).

# ================================================================
# Phoneme -> &'static str IPA tables. Six of them, one per language. Each is an
# if-chain over the svara phoneme ordinal returning a cstring; a phoneme with no
# single-IPA equivalent (Silence, inventory gaps) returns 0 (== Rust None).
# ================================================================

# English (was `phoneme_to_ipa`). Returns 0 for Silence and for the four
# phonemes valid in English but absent from varna 1.0's inventory (DiphthongAI,
# DiphthongAU, DiphthongOI, VowelBird) — see VARNA_INVENTORY_GAPS below.
#must_use
fn shabda_phoneme_to_ipa(phoneme): cstring {
    # Vowels
    if (phoneme == SVARA_PH_VOWEL_A)       { return "ɑː"; }
    if (phoneme == SVARA_PH_VOWEL_E)       { return "e"; }    # not an English phoneme
    if (phoneme == SVARA_PH_VOWEL_I)       { return "ɪ"; }
    if (phoneme == SVARA_PH_VOWEL_O)       { return "oʊ"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "uː"; }
    if (phoneme == SVARA_PH_VOWEL_SCHWA)   { return "ə"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_O)  { return "ɔː"; }
    if (phoneme == SVARA_PH_VOWEL_ASH)     { return "æ"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "ɪ"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_U)  { return "ʊ"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "ɑː"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_E)  { return "ɛ"; }
    if (phoneme == SVARA_PH_VOWEL_CUP_V)   { return "ʌ"; }
    if (phoneme == SVARA_PH_VOWEL_LONG_I)  { return "iː"; }
    # NURSE vowel (ɜː) — valid English, not yet in varna 1.0 inventory  #skip-lint
    if (phoneme == SVARA_PH_VOWEL_BIRD)    { return 0; }
    # Diphthongs present in varna's English inventory
    if (phoneme == SVARA_PH_DIPH_EI)       { return "eɪ"; }
    if (phoneme == SVARA_PH_DIPH_OU)       { return "oʊ"; }
    # Diphthongs valid in English but not yet in varna 1.0 inventory  #skip-lint
    if (phoneme == SVARA_PH_DIPH_AI)       { return 0; }
    if (phoneme == SVARA_PH_DIPH_AU)       { return 0; }
    if (phoneme == SVARA_PH_DIPH_OI)       { return 0; }
    # Plosives
    if (phoneme == SVARA_PH_PLOSIVE_P)     { return "p"; }
    if (phoneme == SVARA_PH_PLOSIVE_B)     { return "b"; }
    if (phoneme == SVARA_PH_PLOSIVE_T)     { return "t"; }
    if (phoneme == SVARA_PH_PLOSIVE_D)     { return "d"; }
    if (phoneme == SVARA_PH_PLOSIVE_K)     { return "k"; }
    if (phoneme == SVARA_PH_PLOSIVE_G)     { return "ɡ"; }
    # Fricatives
    if (phoneme == SVARA_PH_FRIC_F)        { return "f"; }
    if (phoneme == SVARA_PH_FRIC_V)        { return "v"; }
    if (phoneme == SVARA_PH_FRIC_S)        { return "s"; }
    if (phoneme == SVARA_PH_FRIC_Z)        { return "z"; }
    if (phoneme == SVARA_PH_FRIC_SH)       { return "ʃ"; }
    if (phoneme == SVARA_PH_FRIC_ZH)       { return "ʒ"; }
    if (phoneme == SVARA_PH_FRIC_TH)       { return "θ"; }
    if (phoneme == SVARA_PH_FRIC_DH)       { return "ð"; }
    if (phoneme == SVARA_PH_FRIC_H)        { return "h"; }
    # Nasals
    if (phoneme == SVARA_PH_NASAL_M)       { return "m"; }
    if (phoneme == SVARA_PH_NASAL_N)       { return "n"; }
    if (phoneme == SVARA_PH_NASAL_NG)      { return "ŋ"; }
    # Affricates
    if (phoneme == SVARA_PH_AFFR_CH)       { return "t͡ʃ"; }
    if (phoneme == SVARA_PH_AFFR_J)        { return "d͡ʒ"; }
    # Approximants & lateral
    if (phoneme == SVARA_PH_APPROX_R)      { return "ɹ"; }
    if (phoneme == SVARA_PH_APPROX_W)      { return "w"; }
    if (phoneme == SVARA_PH_APPROX_J)      { return "j"; }
    if (phoneme == SVARA_PH_LATERAL_L)     { return "l"; }
    # Not in English inventory (but do have an IPA in the mapping)
    if (phoneme == SVARA_PH_GLOTTAL_STOP)  { return "ʔ"; }
    if (phoneme == SVARA_PH_TAP_FLAP)      { return "ɾ"; }
    if (phoneme == SVARA_PH_SILENCE)       { return 0; }
    # #[non_exhaustive] fallback (Rust `_ => None`).
    return 0;
}

# Spanish (was `spanish_phoneme_to_ipa`). The symbols of varna's Castilian inventory
# (Martínez-Celdrán et al. 2003). The Rust's English stand-ins for the vowels, ñ and the
# jota are retired (ADR-0002); each now maps to its own IPA, which Spanish lacks, so a
# stand-in that reaches validation is reported.
#must_use
fn shabda_spanish_phoneme_to_ipa(phoneme): cstring {
    # Spanish vowels (5 pure vowels)
    if (phoneme == SVARA_PH_VOWEL_A)       { return "a"; }
    if (phoneme == SVARA_PH_VOWEL_E)       { return "e"; }
    if (phoneme == SVARA_PH_VOWEL_I)       { return "i"; }
    if (phoneme == SVARA_PH_VOWEL_O)       { return "o"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "u"; }
    # Not Spanish vowels (the Rust's stand-ins for a e i u)
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "ɑ"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_E)  { return "ɛ"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "ɪ"; }
    if (phoneme == SVARA_PH_VOWEL_CUP_V)   { return "ʌ"; }
    # Plosives
    if (phoneme == SVARA_PH_PLOSIVE_P)     { return "p"; }
    if (phoneme == SVARA_PH_PLOSIVE_B)     { return "b"; }
    if (phoneme == SVARA_PH_PLOSIVE_T)     { return "t"; }
    if (phoneme == SVARA_PH_PLOSIVE_D)     { return "d"; }
    if (phoneme == SVARA_PH_PLOSIVE_K)     { return "k"; }
    if (phoneme == SVARA_PH_PLOSIVE_G)     { return "ɡ"; }
    # Fricatives
    if (phoneme == SVARA_PH_FRIC_F)        { return "f"; }
    if (phoneme == SVARA_PH_FRIC_TH)       { return "θ"; }
    if (phoneme == SVARA_PH_FRIC_S)        { return "s"; }
    # The jota /x/: svara has no velar fricative, the rules use its uvular χ
    if (phoneme == SVARA_PH_FRIC_UVULAR_CH) { return "x"; }
    if (phoneme == SVARA_PH_FRIC_H)        { return "h"; }   # not a Castilian phoneme
    # Nasals
    if (phoneme == SVARA_PH_NASAL_M)       { return "m"; }
    if (phoneme == SVARA_PH_NASAL_N)       { return "n"; }
    if (phoneme == SVARA_PH_NASAL_PALATAL) { return "ɲ"; }   # ñ
    if (phoneme == SVARA_PH_NASAL_NG)      { return "ŋ"; }   # an allophone of /n/, not a phoneme
    # Liquids & approximants
    if (phoneme == SVARA_PH_LATERAL_L)     { return "l"; }
    if (phoneme == SVARA_PH_LATERAL_PALATAL) { return "ʎ"; }
    if (phoneme == SVARA_PH_TAP_FLAP)      { return "ɾ"; }   # Spanish tap (pero)
    if (phoneme == SVARA_PH_TRILL_ALVEOLAR) { return "r"; }  # Spanish trill (perro, rojo)
    if (phoneme == SVARA_PH_APPROX_R)      { return "ɹ"; }   # not a Spanish phoneme
    if (phoneme == SVARA_PH_APPROX_J)      { return "j"; }
    if (phoneme == SVARA_PH_APPROX_W)      { return "w"; }
    # Affricates: /ʝ/ (ll, consonantal y) is the phoneme varna writes ɟ͡ʝ
    if (phoneme == SVARA_PH_AFFR_CH)       { return "t͡ʃ"; }
    if (phoneme == SVARA_PH_FRIC_PALATAL_J) { return "ɟ͡ʝ"; }
    # No IPA in Spanish
    if (phoneme == SVARA_PH_SILENCE)       { return 0; }
    return 0;
}

# German (was `german_phoneme_to_ipa`). The symbols of varna's German inventory. A tense
# vowel is the long phoneme (eː oː uː øː iː yː), its lax partner the short one (ɛ ɔ ʊ œ ɪ).
# The Rust's stand-ins are retired (ADR-0002): ɹ for /ʁ/, ɑ for /a/, æ for /aː/. Each now maps
# to its own IPA, which German lacks, so a stand-in that reaches validation is reported.
#must_use
fn shabda_german_phoneme_to_ipa(phoneme): cstring {
    # Vowels (short)
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "ɪ"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_E)  { return "ɛ"; }
    if (phoneme == SVARA_PH_VOWEL_A)       { return "a"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_O)  { return "ɔ"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_U)  { return "ʊ"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O) { return "œ"; }
    if (phoneme == SVARA_PH_VOWEL_SCHWA)   { return "ə"; }
    # Vowels (long)
    if (phoneme == SVARA_PH_VOWEL_LONG_I)  { return "iː"; }
    if (phoneme == SVARA_PH_VOWEL_Y)       { return "yː"; }
    if (phoneme == SVARA_PH_VOWEL_E)       { return "eː"; }
    if (phoneme == SVARA_PH_VOWEL_O)       { return "oː"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "uː"; }
    if (phoneme == SVARA_PH_VOWEL_FRONT_ROUND_O) { return "øː"; }
    # Not German vowels (the Rust's stand-ins for /a/ and /aː/)
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "ɑ"; }
    if (phoneme == SVARA_PH_VOWEL_ASH)     { return "æ"; }
    # German diphthongs, which varna's German inventory does not list yet  #skip-lint
    if (phoneme == SVARA_PH_DIPH_AI)       { return 0; }
    if (phoneme == SVARA_PH_DIPH_AU)       { return 0; }
    if (phoneme == SVARA_PH_DIPH_OI)       { return 0; }
    # Plosives
    if (phoneme == SVARA_PH_PLOSIVE_P)     { return "p"; }
    if (phoneme == SVARA_PH_PLOSIVE_B)     { return "b"; }
    if (phoneme == SVARA_PH_PLOSIVE_T)     { return "t"; }
    if (phoneme == SVARA_PH_PLOSIVE_D)     { return "d"; }
    if (phoneme == SVARA_PH_PLOSIVE_K)     { return "k"; }
    if (phoneme == SVARA_PH_PLOSIVE_G)     { return "ɡ"; }
    # Fricatives
    if (phoneme == SVARA_PH_FRIC_F)        { return "f"; }
    if (phoneme == SVARA_PH_FRIC_V)        { return "v"; }
    if (phoneme == SVARA_PH_FRIC_S)        { return "s"; }
    if (phoneme == SVARA_PH_FRIC_Z)        { return "z"; }
    if (phoneme == SVARA_PH_FRIC_SH)       { return "ʃ"; }
    if (phoneme == SVARA_PH_FRIC_PALATAL_C) { return "ç"; }   # ich-Laut
    # The ach-Laut /x/: svara has no velar fricative, the rules use its uvular χ
    if (phoneme == SVARA_PH_FRIC_UVULAR_CH) { return "x"; }
    if (phoneme == SVARA_PH_FRIC_H)        { return "h"; }
    if (phoneme == SVARA_PH_FRIC_UVULAR_R) { return "ʁ"; }
    # Nasals
    if (phoneme == SVARA_PH_NASAL_M)       { return "m"; }
    if (phoneme == SVARA_PH_NASAL_N)       { return "n"; }
    if (phoneme == SVARA_PH_NASAL_NG)      { return "ŋ"; }
    # Affricates
    if (phoneme == SVARA_PH_AFFR_TS)       { return "t͡s"; }
    if (phoneme == SVARA_PH_AFFR_PF)       { return "p͡f"; }
    if (phoneme == SVARA_PH_AFFR_CH)       { return "t͡ʃ"; }
    # Approximants & lateral
    if (phoneme == SVARA_PH_APPROX_J)      { return "j"; }
    if (phoneme == SVARA_PH_LATERAL_L)     { return "l"; }
    if (phoneme == SVARA_PH_APPROX_R)      { return "ɹ"; }   # not a German phoneme (was ʁ)
    # Not mapped
    if (phoneme == SVARA_PH_SILENCE)       { return 0; }
    return 0;
}

# Hindi (was `hindi_phoneme_to_ipa`). Each phoneme's sound in varna's spelling:
# the short i u (svara's lax ɪ ʊ, which is how Hindi says them) are varna's i u;
# श is varna's ɕ (svara's /ʃ/ is the sound); the tap is varna's r. A phoneme the
# rules give that varna's Hindi lacks is still spelled as it sounds, so validation
# reports varna's gap rather than hiding it: आ ɑː, ड़ ɽ, ज़ z, क़ q, ख़ x, ग़ ɣ.
#must_use
fn shabda_hindi_phoneme_to_ipa(phoneme): cstring {
    # Vowels
    if (phoneme == SVARA_PH_VOWEL_SCHWA)   { return "ə"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "i"; }
    if (phoneme == SVARA_PH_VOWEL_LONG_I)  { return "iː"; }
    if (phoneme == SVARA_PH_VOWEL_E)       { return "e"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_U)  { return "u"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "uː"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_E)  { return "ɛː"; }
    if (phoneme == SVARA_PH_VOWEL_O)       { return "o"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "ɑː"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_O)  { return "ɔː"; }
    if (phoneme == SVARA_PH_VOWEL_CUP_V)   { return "ʌ"; }
    # Plosives (unaspirated only)
    if (phoneme == SVARA_PH_PLOSIVE_P)     { return "p"; }
    if (phoneme == SVARA_PH_PLOSIVE_B)     { return "b"; }
    if (phoneme == SVARA_PH_PLOSIVE_T)     { return "t̪"; }
    if (phoneme == SVARA_PH_PLOSIVE_D)     { return "d̪"; }
    if (phoneme == SVARA_PH_PLOSIVE_RETRO_T) { return "ʈ"; }
    if (phoneme == SVARA_PH_PLOSIVE_RETRO_D) { return "ɖ"; }
    if (phoneme == SVARA_PH_PLOSIVE_K)     { return "k"; }
    if (phoneme == SVARA_PH_PLOSIVE_G)     { return "ɡ"; }
    if (phoneme == SVARA_PH_PLOSIVE_UVULAR_Q) { return "q"; }
    # Fricatives
    if (phoneme == SVARA_PH_FRIC_S)        { return "s"; }
    if (phoneme == SVARA_PH_FRIC_Z)        { return "z"; }
    if (phoneme == SVARA_PH_FRIC_GLOTTAL_H) { return "ɦ"; }
    if (phoneme == SVARA_PH_FRIC_H)        { return "h"; }
    if (phoneme == SVARA_PH_FRIC_F)        { return "f"; }
    if (phoneme == SVARA_PH_FRIC_SH)       { return "ɕ"; }
    if (phoneme == SVARA_PH_FRIC_RETRO_S)  { return "ʂ"; }
    if (phoneme == SVARA_PH_FRIC_UVULAR_CH) { return "x"; }
    if (phoneme == SVARA_PH_FRIC_UVULAR_R) { return "ɣ"; }
    # Nasals
    if (phoneme == SVARA_PH_NASAL_M)       { return "m"; }
    if (phoneme == SVARA_PH_NASAL_N)       { return "n"; }
    if (phoneme == SVARA_PH_NASAL_NG)      { return "ŋ"; }
    if (phoneme == SVARA_PH_NASAL_PALATAL) { return "ɲ"; }
    if (phoneme == SVARA_PH_NASAL_RETRO)   { return "ɳ"; }
    # Approximants & lateral
    if (phoneme == SVARA_PH_APPROX_J)      { return "j"; }
    if (phoneme == SVARA_PH_LATERAL_L)     { return "l"; }
    if (phoneme == SVARA_PH_TAP_FLAP)      { return "r"; }
    if (phoneme == SVARA_PH_FLAP_RETRO)    { return "ɽ"; }
    if (phoneme == SVARA_PH_FRIC_V)        { return "ʋ"; }
    # Affricates
    if (phoneme == SVARA_PH_AFFR_CH)       { return "t͡ɕ"; }
    if (phoneme == SVARA_PH_AFFR_J)        { return "d͡ʑ"; }
    # Not mapped
    if (phoneme == SVARA_PH_SILENCE)       { return 0; }
    return 0;
}

# Arabic (was `arabic_phoneme_to_ipa`). /a/ is VOWEL_A, and VOWEL_OPEN_A its backed
# allophone beside an emphatic or uvular, both varna's a; the short i u (svara's
# lax ɪ ʊ) are varna's i u, the long ones iː uː. The trill is r, and the tap, an
# allophone of /r/, is r too. svara's uvular fricatives are varna's x ɣ (MSA
# /x ɣ/). PLOSIVE_G is /ɡ/, which MSA lacks (it was ɣ, for غ, which the rules
# gave as a stop).
#must_use
fn shabda_arabic_phoneme_to_ipa(phoneme): cstring {
    if (phoneme == SVARA_PH_VOWEL_A)       { return "a"; }
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "a"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "i"; }
    if (phoneme == SVARA_PH_VOWEL_LONG_I)  { return "iː"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_U)  { return "u"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "uː"; }
    if (phoneme == SVARA_PH_VOWEL_CUP_V)   { return "ʌ"; }
    if (phoneme == SVARA_PH_PLOSIVE_B)     { return "b"; }
    if (phoneme == SVARA_PH_PLOSIVE_T)     { return "t"; }
    if (phoneme == SVARA_PH_PLOSIVE_D)     { return "d"; }
    if (phoneme == SVARA_PH_PLOSIVE_K)     { return "k"; }
    if (phoneme == SVARA_PH_PLOSIVE_G)     { return "ɡ"; }
    if (phoneme == SVARA_PH_PLOSIVE_UVULAR_Q) { return "q"; }
    if (phoneme == SVARA_PH_FRIC_F)        { return "f"; }
    if (phoneme == SVARA_PH_FRIC_TH)       { return "θ"; }
    if (phoneme == SVARA_PH_FRIC_DH)       { return "ð"; }
    if (phoneme == SVARA_PH_FRIC_S)        { return "s"; }
    if (phoneme == SVARA_PH_FRIC_Z)        { return "z"; }
    if (phoneme == SVARA_PH_FRIC_SH)       { return "ʃ"; }
    if (phoneme == SVARA_PH_FRIC_H)        { return "h"; }
    if (phoneme == SVARA_PH_FRIC_PHARYNGEAL_H) { return "ħ"; }
    if (phoneme == SVARA_PH_FRIC_PHARYNGEAL_A) { return "ʕ"; }
    if (phoneme == SVARA_PH_FRIC_UVULAR_CH) { return "x"; }
    if (phoneme == SVARA_PH_FRIC_UVULAR_R) { return "ɣ"; }
    if (phoneme == SVARA_PH_NASAL_M)       { return "m"; }
    if (phoneme == SVARA_PH_NASAL_N)       { return "n"; }
    if (phoneme == SVARA_PH_LATERAL_L)     { return "l"; }
    if (phoneme == SVARA_PH_TRILL_ALVEOLAR) { return "r"; }
    if (phoneme == SVARA_PH_TAP_FLAP)      { return "r"; }
    if (phoneme == SVARA_PH_APPROX_W)      { return "w"; }
    if (phoneme == SVARA_PH_APPROX_J)      { return "j"; }
    if (phoneme == SVARA_PH_AFFR_J)        { return "d͡ʒ"; }
    if (phoneme == SVARA_PH_GLOTTAL_STOP)  { return "ʔ"; }
    if (phoneme == SVARA_PH_SILENCE)       { return 0; }
    return 0;
}

# Sanskrit (was `sanskrit_phoneme_to_ipa`). Overrides the vowels and the dental
# nasal, then DELEGATES every other phoneme to the Hindi table (Rust
# `other => hindi(...)`). e o are long in Sanskrit (eː oː), ai au the diphthongs
# ɐi ɐu, and न dental n̪, all as varna spells them. The visarga is h, which varna's
# Sanskrit lacks.
#must_use
fn shabda_sanskrit_phoneme_to_ipa(phoneme): cstring {
    # Sanskrit schwa is /ɐ/ not /ə/
    if (phoneme == SVARA_PH_VOWEL_SCHWA)   { return "ɐ"; }
    # Long vowels
    if (phoneme == SVARA_PH_VOWEL_OPEN_A)  { return "ɐː"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_I)  { return "i"; }
    if (phoneme == SVARA_PH_VOWEL_LONG_I)  { return "iː"; }
    if (phoneme == SVARA_PH_VOWEL_NEAR_U)  { return "u"; }
    if (phoneme == SVARA_PH_VOWEL_U)       { return "uː"; }
    if (phoneme == SVARA_PH_VOWEL_E)       { return "eː"; }
    if (phoneme == SVARA_PH_VOWEL_O)       { return "oː"; }
    if (phoneme == SVARA_PH_DIPH_AI)       { return "ɐi"; }
    if (phoneme == SVARA_PH_DIPH_AU)       { return "ɐu"; }
    # The dental nasal
    if (phoneme == SVARA_PH_NASAL_N)       { return "n̪"; }
    # Consonants — same as Hindi
    return shabda_hindi_phoneme_to_ipa(phoneme);
}

# Dispatch a phoneme to the language's IPA table (was `phoneme_to_ipa_for`).
# #[non_exhaustive] Language -> if-chain + mandatory fallback (Rust exhaustive
# match; fall back to English).
#must_use
fn shabda_phoneme_to_ipa_for(phoneme, language): cstring {
    if (language == SHABDA_LANG_ENGLISH)  { return shabda_phoneme_to_ipa(phoneme); }
    if (language == SHABDA_LANG_SPANISH)  { return shabda_spanish_phoneme_to_ipa(phoneme); }
    if (language == SHABDA_LANG_GERMAN)   { return shabda_german_phoneme_to_ipa(phoneme); }
    if (language == SHABDA_LANG_HINDI)    { return shabda_hindi_phoneme_to_ipa(phoneme); }
    if (language == SHABDA_LANG_ARABIC)   { return shabda_arabic_phoneme_to_ipa(phoneme); }
    if (language == SHABDA_LANG_SANSKRIT) { return shabda_sanskrit_phoneme_to_ipa(phoneme); }
    return shabda_phoneme_to_ipa(phoneme);
}

# ================================================================
# VARNA_INVENTORY_GAPS — phonemes that are valid English sounds but not yet in  #skip-lint
# varna 1.0's inventory; skipped during validation to avoid false positives.
# Built as a fresh vec of ordinals (order matches the Rust const array).
# ================================================================
#must_use
fn shabda_varna_inventory_gaps(): i64 {
    var v = vec_new();
    vec_push(v, SVARA_PH_DIPH_AI);    # PRICE: aɪ
    vec_push(v, SVARA_PH_DIPH_AU);    # MOUTH: aʊ
    vec_push(v, SVARA_PH_DIPH_OI);    # CHOICE: ɔɪ
    vec_push(v, SVARA_PH_VOWEL_BIRD); # NURSE: ɜː
    return v;
}

# ================================================================
# Inventory + phonotactics dispatch (varna handles).
# ================================================================

# varna PhonemeInventory for a language (was `inventory_for`). #[non_exhaustive]
# Language -> if-chain + fallback to English.
#must_use
fn shabda_inventory_for(language): i64 {
    if (language == SHABDA_LANG_ENGLISH)  { return phoneme_english(); }
    if (language == SHABDA_LANG_SPANISH)  { return phoneme_spanish(); }
    if (language == SHABDA_LANG_GERMAN)   { return phoneme_german(); }
    if (language == SHABDA_LANG_HINDI)    { return phoneme_hindi(); }
    if (language == SHABDA_LANG_ARABIC)   { return phoneme_classical_arabic(); }
    if (language == SHABDA_LANG_SANSKRIT) { return phoneme_sanskrit(); }
    return phoneme_english();
}

# varna Phonotactics for a language (was `phonotactics_for`). Rust returns
# Option: Some(english_phonotactics()) for English, None for every other
# language. Sentinel: English -> handle, else 0 (== None).
#must_use
fn shabda_phonotactics_for(language): i64 {
    if (language == SHABDA_LANG_ENGLISH) { return phonotactics_english(); }
    return 0;
}

# ================================================================
# Validation.
# ================================================================

# True (1) if a phoneme counts as a "vowel" for the phonotactics consonant-run
# reset: Vowel or Diphthong class, OR the Silence phoneme (Rust
# `matches!(ph.class(), Vowel | Diphthong) || ph == Silence`).
fn _shabda_validate_is_vowel(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL) { return 1; }
    if (c == SVARA_CLASS_DIPHTHONG) { return 1; }
    if (ph == SVARA_PH_SILENCE) { return 1; }
    return 0;
}

# Validate a phoneme sequence (vec of ordinals) against phonotactic constraints
# (was `validate_phonotactics`). Returns a vec of report Strings (cstr). Empty
# vec means no violations. No constraints for the language -> empty vec.
#
# The consonant run is a vec of IPA cstrs; on a vowel boundary a run longer than
# max_onset is a violation; a trailing run longer than max_coda is a violation.
# Report text mirrors Rust's alloc::format! output exactly (join is empty-sep
# concat of the collected IPA cstrs).
#must_use
fn shabda_validate_phonotactics(phonemes, language): i64 {
    return _shabda_validate_phonotactics_a(default_alloc(), phonemes, language);
}

# shabda_validate_phonotactics, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_validate_phonotactics_a(a, phonemes, language): i64 {
    var violations = vec_new_a(a);
    var constraints = shabda_phonotactics_for(language);
    if (constraints == 0) { return violations; }   # no constraints available

    var max_onset = phonotactics_max_onset(constraints);
    var max_coda = phonotactics_max_coda(constraints);

    # Walk phonemes, tracking a run of consonant IPA cstrs.
    var consonant_run = vec_new_a(a);
    var n = vec_len(phonemes);
    var i = 0;
    while (i < n) {
        var ph = vec_get(phonemes, i);
        # Rust: `if let Some(ipa) = phoneme_to_ipa(ph)` — English table, always.
        var ipa = shabda_phoneme_to_ipa(ph);
        if (ipa != 0) {
            if (_shabda_validate_is_vowel(ph) == 1) {
                if (vec_len(consonant_run) > max_onset) {
                    var joined = _shabda_validate_join_a(a, consonant_run);
                    _shabda_vec_push_a(a, violations, _shabda_validate_onset_msg_a(a, joined));
                }
                consonant_run = vec_new_a(a);   # Rust `consonant_run.clear()`
            } else {
                _shabda_vec_push_a(a, consonant_run, ipa);
            }
        }
        i = i + 1;
    }

    # Final consonant run vs max coda.
    if (vec_len(consonant_run) > max_coda) {
        var joined2 = _shabda_validate_join_a(a, consonant_run);
        _shabda_vec_push_a(a, violations, _shabda_validate_coda_msg_a(a, joined2));
    }

    return violations;
}

# Join a vec of IPA cstrs with the empty separator (Rust `run.join("")`).
# Returns a fresh NUL-terminated cstr.
fn _shabda_validate_join_a(a, run): cstring {
    var sb = str_builder_new_a(a);
    var n = vec_len(run);
    var i = 0;
    while (i < n) {
        _shabda_sb_add_cstr_a(a, sb, vec_get(run, i));
        i = i + 1;
    }
    return _shabda_str_cstr_a(a, str_builder_build_a(a, sb));
}

# "consonant cluster too long for onset: {joined}" (Rust format!).
fn _shabda_validate_onset_msg_a(a, joined): cstring {
    var sb = str_builder_new_a(a);
    _shabda_sb_add_cstr_a(a, sb, "consonant cluster too long for onset: ");
    _shabda_sb_add_cstr_a(a, sb, joined);
    return _shabda_str_cstr_a(a, str_builder_build_a(a, sb));
}

# "consonant cluster too long for coda: {joined}" (Rust format!).
fn _shabda_validate_coda_msg_a(a, joined): cstring {
    var sb = str_builder_new_a(a);
    _shabda_sb_add_cstr_a(a, sb, "consonant cluster too long for coda: ");
    _shabda_sb_add_cstr_a(a, sb, joined);
    return _shabda_str_cstr_a(a, str_builder_build_a(a, sb));
}

# Validate that every phoneme in the vec exists in the given inventory, using
# language-aware IPA mapping (was `validate_phonemes_for`). Returns a vec of IPA
# cstrs NOT in the inventory. Empty vec == all valid. A phoneme with no IPA
# (sentinel 0) is skipped (Rust `if let Some(ipa) = ... && !inventory.has(ipa)`).
#must_use
fn shabda_validate_phonemes_for(phonemes, inventory, language): i64 {
    return _shabda_validate_phonemes_for_a(default_alloc(), phonemes, inventory, language);
}

# shabda_validate_phonemes_for, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_validate_phonemes_for_a(a, phonemes, inventory, language): i64 {
    var invalid = vec_new_a(a);
    var n = vec_len(phonemes);
    var i = 0;
    while (i < n) {
        var ph = vec_get(phonemes, i);
        var ipa = shabda_phoneme_to_ipa_for(ph, language);
        if (ipa != 0) {
            if (phoneme_has(inventory, ipa) == 0) {
                _shabda_vec_push_a(a, invalid, ipa);
            }
        }
        i = i + 1;
    }
    return invalid;
}

# Validate phonemes against the English inventory (was `validate_phonemes`,
# backwards-compatible alias). Returns a vec of invalid IPA cstrs.
#must_use
fn shabda_validate_phonemes(phonemes, inventory): i64 {
    return shabda_validate_phonemes_for(phonemes, inventory, SHABDA_LANG_ENGLISH);
}

# --- engine.cyr ---

# engine.cyr — the G2P engine: ties normalization, dictionary, rules, and prosody
# together.
#
# Ports rust-old/src/engine.rs (751 LOC). Owns Language, TimingProfile,
# ConvertOptions, and G2PEngine, plus the conversion pipeline
# (convert / convert_with / convert_ssml / convert_streaming / speak / speak_with)
# and the varna-gated helpers (detect_language, phoneme_inventory) which are
# ALWAYS compiled here (the Rust #[cfg(feature="varna")] gate is dropped).
#
# DEP POSITION: needs the vendored dep chain (svara for PhonemeEvent/sequence/
# voice, shabdakosh for the dictionary, varna for script detection + inventories)
# plus every earlier shabda module (error, normalize, syllable, heteronym, ssml,
# rules, prosody, validate). The entry file (tests/engine.tcyr / src/main.cyr)
# orders the includes; modules never include each other.
#
# ---------------------------------------------------------------- byte layouts
# ShabdaTimingProfile (24 bytes): three f64-bit scale factors, at the
#   SHABDA_TIMING_VOWEL/CONSONANT/PAUSE offsets (0/8/16) that prosody's
#   shabda_apply_timing reads directly via load64. Rust's TimingProfile.
#     [0]  vowel_scale     (f64 bits)
#     [8]  consonant_scale (f64 bits)
#     [16] pause_scale     (f64 bits)
#
# ShabdaConvertOptions (32 bytes): Rust's ConvertOptions.
#     [0]  emphasis            (i64 bool: 1 = on)
#     [8]  has_rate            (i64 bool: Option<f32> tag; 1 = Some)
#     [16] rate_wpm            (f64 bits; valid only when has_rate == 1)
#     [24] timing              (ShabdaTimingProfile* or 0 == None)
#
# ShabdaG2PEngine (16 bytes): Rust's G2PEngine.
#     [0]  language            (SHABDA_LANG_* tag)
#     [8]  dictionary          (shabdakosh dict handle)
#
# PhonemeEvent is svara's immutable-by-handle triple (phoneme, duration-f64,
# stress); build via svara_phoneme_event_new. Rust's `event.stress = ...` in-place
# mutation (Reduced emphasis) is re-expressed by rebuilding the event.
#
# CONVENTION (fallible fns): convert / convert_with / convert_ssml / speak /
# speak_with RETURN a packed shabda error (0 == ok, tested via shabda_is_err) and
# WRITE their result vec (events / samples) to an out-param pointer. This is the
# idiomatic Cyrius fallible shape (a vec handle is a non-zero heap pointer and can
# NOT be told apart from a packed error by shabda_is_err, so the payload rides an
# out-param instead). convert_streaming has no result vec — it returns the packed
# error directly (0 == ok). The empty-input path returns shabda_err_invalid_input()
# and leaves the out-param untouched.
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`-prefixed (flat link
# namespace; coexists with shbdk_ / svara_ / varna / sakshi). Private helpers are
# `_shabda_engine_*`.

# ================================================================
# Silence durations (Rust f32 literals promoted to f64 bits). Match engine.rs.
# ================================================================
# 0.15 — comma phrase pause
var SHABDA_ENGINE_COMMA_DUR = 0x3FC3_3333_3333_3333;
# 0.30 — period phrase pause
var SHABDA_ENGINE_PERIOD_DUR = 0x3FD3_3333_3333_3333;
# 0.04 — inter-word silence
var SHABDA_ENGINE_WORD_DUR = 0x3FA4_7AE1_47AE_147B;

# ConvertOptions block offsets.
var SHABDA_OPT_EMPHASIS = 0;
var SHABDA_OPT_HAS_RATE = 8;
var SHABDA_OPT_RATE_WPM = 16;
var SHABDA_OPT_TIMING   = 24;
var SHABDA_OPT_SIZE     = 32;

# G2PEngine block offsets.
var SHABDA_ENGINE_LANG = 0;
var SHABDA_ENGINE_DICT = 8;
var SHABDA_ENGINE_SIZE = 16;

# ================================================================
# TimingProfile — three f64-bit scales at SHABDA_TIMING_* offsets. (Rust
# TimingProfile::new / Default.)
# ================================================================
#must_use
fn shabda_timing_new(vowel_scale, consonant_scale, pause_scale): i64 {
    var p = alloc(SHABDA_TIMING_SIZE);
    store64(p + SHABDA_TIMING_VOWEL, vowel_scale);
    store64(p + SHABDA_TIMING_CONSONANT, consonant_scale);
    store64(p + SHABDA_TIMING_PAUSE, pause_scale);
    return p;
}

# Default: 1.0 / 1.0 / 1.0.
#must_use
fn shabda_timing_default(): i64 {
    return shabda_timing_new(f64_from(1), f64_from(1), f64_from(1));
}

# Vowel / diphthong duration scale, an f64 bit pattern (1.0 = unchanged). (Rust vowel_scale)
#must_use
fn shabda_timing_vowel_scale(p): i64 { return load64(p + SHABDA_TIMING_VOWEL); }

# Consonant duration scale, an f64 bit pattern (1.0 = unchanged). (Rust consonant_scale)
#must_use
fn shabda_timing_consonant_scale(p): i64 { return load64(p + SHABDA_TIMING_CONSONANT); }

# Pause / silence duration scale, an f64 bit pattern (1.0 = unchanged). (Rust pause_scale)
#must_use
fn shabda_timing_pause_scale(p): i64 { return load64(p + SHABDA_TIMING_PAUSE); }

# ================================================================
# ConvertOptions — builders mutate in place and return self (chainable), mirroring
# the Rust `with_*(mut self) -> Self`.
# ================================================================
#must_use
fn shabda_convert_options_new(): i64 {
    return _shabda_convert_options_new_a(default_alloc());
}

# shabda_convert_options_new, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_convert_options_new_a(a): i64 {
    var o = alloc_via(a, SHABDA_OPT_SIZE);
    store64(o + SHABDA_OPT_EMPHASIS, 0);
    store64(o + SHABDA_OPT_HAS_RATE, 0);
    store64(o + SHABDA_OPT_RATE_WPM, f64_from(0));
    store64(o + SHABDA_OPT_TIMING, 0);
    return o;
}

# Same as shabda_convert_options_new: emphasis off, no speaking rate, no timing profile.
# (Rust ConvertOptions::default)
#must_use
fn shabda_convert_options_default(): i64 {
    return _shabda_convert_options_default_a(default_alloc());
}

# shabda_convert_options_default, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_convert_options_default_a(a): i64 {
    return _shabda_convert_options_new_a(a);
}

# Shallow copy of an options block — the value semantics the builders below need.
#must_use
fn _shabda_options_clone(o): i64 {
    var c = alloc(SHABDA_OPT_SIZE);
    if (c == 0) { return 0; }
    store64(c + SHABDA_OPT_EMPHASIS, load64(o + SHABDA_OPT_EMPHASIS));
    store64(c + SHABDA_OPT_HAS_RATE, load64(o + SHABDA_OPT_HAS_RATE));
    store64(c + SHABDA_OPT_RATE_WPM, load64(o + SHABDA_OPT_RATE_WPM));
    store64(c + SHABDA_OPT_TIMING, load64(o + SHABDA_OPT_TIMING));
    return c;
}

# The three builders take `mut self` and return `Self` BY VALUE in Rust, so the
# receiver is moved and cannot be reused. The port used to mutate the caller's block
# and hand the SAME pointer back, which turns two option sets built from one base
# into one aliased block:
#     var base = shabda_convert_options_new();
#     var fast = shabda_convert_options_with_speaking_rate(base, wpm200);
#     var slow = shabda_convert_options_with_speaking_rate(base, wpm100);
#     # base, fast and slow were all one block, all at 100 wpm
# That program does not compile in Rust (base is moved), so there was no oracle
# behaviour to preserve. Each builder now clones first, restoring value semantics.
# All three are #must_use, so discarding the returned handle was already an error.
#must_use
fn shabda_convert_options_with_emphasis(o, emphasis): i64 {
    var c = _shabda_options_clone(o);
    if (c == 0) { return o; }
    store64(c + SHABDA_OPT_EMPHASIS, emphasis);
    return c;
}

# wpm is an f64 bit pattern. Rust took f32; the widening is chain-wide and owned by
# svara (SvPhonemeEvent.duration is f64), not something shabda can undo alone — see
# the 3.0.3 CHANGELOG entry.
#must_use
fn shabda_convert_options_with_speaking_rate(o, wpm): i64 {
    var c = _shabda_options_clone(o);
    if (c == 0) { return o; }
    store64(c + SHABDA_OPT_HAS_RATE, 1);
    store64(c + SHABDA_OPT_RATE_WPM, wpm);
    return c;
}

# A copy of `o` with timing profile `timing` (0 = svara's default durations). `o` is
# unchanged; if the copy cannot be allocated, `o` is returned. (Rust with_timing)
#must_use
fn shabda_convert_options_with_timing(o, timing): i64 {
    var c = _shabda_options_clone(o);
    if (c == 0) { return o; }
    store64(c + SHABDA_OPT_TIMING, timing);
    return c;
}

# 1 if emphasis detection (ALL-CAPS and *asterisk* words) is on, 0 if off.
#must_use
fn shabda_convert_options_emphasis(o): i64 { return load64(o + SHABDA_OPT_EMPHASIS); }

# 1 if a speaking rate is set, 0 if not (Rust speaking_rate_wpm is Some / None).
#must_use
fn shabda_convert_options_has_rate(o): i64 { return load64(o + SHABDA_OPT_HAS_RATE); }

# Speaking rate in words per minute, an f64 bit pattern. Meaningful only when has_rate is 1.
#must_use
fn shabda_convert_options_rate_wpm(o): i64 { return load64(o + SHABDA_OPT_RATE_WPM); }

# The timing profile, or 0 when none is set (svara's default durations).
#must_use
fn shabda_convert_options_timing(o): i64 { return load64(o + SHABDA_OPT_TIMING); }

# ================================================================
# Language serde/name (Rust derives Serialize/Deserialize + Debug). Provide the
# string<->tag map + fallback; a roundtrip test pins it.
# ================================================================
#must_use
fn shabda_language_to_str(lang): cstring {
    if (lang == SHABDA_LANG_ENGLISH)  { return "English"; }
    if (lang == SHABDA_LANG_SPANISH)  { return "Spanish"; }
    if (lang == SHABDA_LANG_GERMAN)   { return "German"; }
    if (lang == SHABDA_LANG_HINDI)    { return "Hindi"; }
    if (lang == SHABDA_LANG_ARABIC)   { return "Arabic"; }
    if (lang == SHABDA_LANG_SANSKRIT) { return "Sanskrit"; }
    return "English";                 # #[non_exhaustive] fallback
}

# SHABDA_LANG_* tag for a name shabda_language_to_str gives ("English" .. "Sanskrit").
# An unknown name gives SHABDA_LANG_ENGLISH.
#must_use
fn shabda_language_from_str(s): i64 {
    if (streq(s, "English") == 1)  { return SHABDA_LANG_ENGLISH; }
    if (streq(s, "Spanish") == 1)  { return SHABDA_LANG_SPANISH; }
    if (streq(s, "German") == 1)   { return SHABDA_LANG_GERMAN; }
    if (streq(s, "Hindi") == 1)    { return SHABDA_LANG_HINDI; }
    if (streq(s, "Arabic") == 1)   { return SHABDA_LANG_ARABIC; }
    if (streq(s, "Sanskrit") == 1) { return SHABDA_LANG_SANSKRIT; }
    return SHABDA_LANG_ENGLISH;       # unknown -> English fallback
}

# ================================================================
# detect_language(text) -> Language tag or -1 (Rust Option::None). Always
# compiled. Count codepoints in each known script via varna script_by_code; only
# ("Latn", English) is wired (Rust leaves the rest as future). Return the language
# with the most matching codepoints, or -1.
# ================================================================
#must_use
fn shabda_detect_language(text): i64 {
    # trim empty -> None
    var n = strlen(text);
    var tso = alloc(8);
    var teo = alloc(8);
    if (tso == 0 || teo == 0) { return (0 - 1); }
    _shabda_engine_trim(text, 0, n, tso, teo);
    if (load64(teo) <= load64(tso)) { return (0 - 1); }

    # Only ("Latn", English) is wired.
    var best_lang = (0 - 1);
    var best_count = 0;
    var script = script_by_code("Latn");
    if (script != 0) {
        var count = _shabda_engine_count_script_cps(text, script);
        if (count > 0) {
            best_lang = SHABDA_LANG_ENGLISH;
            best_count = count;
        }
    }
    return best_lang;
}

# Rust str::trim over a byte buffer. Advances `s` past leading whitespace
# CODEPOINTS and pulls `e` back past trailing ones, writing both through the two
# out-params. Was an ASCII-only byte test, so a string of nothing but U+3000 read
# as non-empty and slipped past convert_with's InvalidInput guard.
fn _shabda_engine_trim(buf, start, end, out_s, out_e): i64 {
    var s = start;
    var e = end;
    var n = shabda_ws_len_at(buf, s, e);
    while (n > 0) {
        s = s + n;
        n = shabda_ws_len_at(buf, s, e);
    }
    var m = shabda_ws_len_before(buf, s, e);
    while (m > 0) {
        e = e - m;
        m = shabda_ws_len_before(buf, s, e);
    }
    store64(out_s, s);
    store64(out_e, e);
    return 0;
}

# Count codepoints in `text` that belong to `script` (via script_contains_codepoint).
fn _shabda_engine_count_script_cps(text, script): i64 {
    var count = 0;
    var p = text;
    var cpo = alloc(8);
    var adv = _shabda_utf8_next(p, cpo);
    while (adv > 0) {
        if (script_contains_codepoint(script, load64(cpo)) == 1) { count = count + 1; }
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    return count;
}

# ================================================================
# G2PEngine.
# ================================================================
# Rust: English -> PronunciationDict::english(); every other language ->
# PronunciationDict::new() (EMPTY — NOT a language-specific dict).
#
# It also builds the tables a conversion reads that are built once per process and
# then shared: the heteronym rules, varna's inventory and phonotactics for the
# language, and the English letter-to-sound rules (every language falls back to
# them). Through 3.1.1 the first conversion built them, so with shabda_convert_a they
# would have landed in the caller's Allocator and been reused after it was reset.
# Built here, on the default heap like the engine, no conversion writes anything
# outside its Allocator and the event vec it returns.
#must_use
fn shabda_g2p_new(language): i64 {
    var e = alloc(SHABDA_ENGINE_SIZE);
    store64(e + SHABDA_ENGINE_LANG, language);
    var dict = shbdk_dict_new();
    if (language == SHABDA_LANG_ENGLISH) {
        dict = shbdk_dict_english();
    }
    store64(e + SHABDA_ENGINE_DICT, dict);
    var _rules = _shabda_het_rules();
    var _inv = shabda_inventory_for(language);
    var _pt = shabda_phonotactics_for(language);
    var _en = _shabda_en_rules_table();
    return e;
}

# The engine's SHABDA_LANG_* tag. (Rust G2PEngine::language)
#must_use
fn shabda_g2p_language(e): i64 { return load64(e + SHABDA_ENGINE_LANG); }

# The engine's shabdakosh dictionary handle, for the shbdk_dict_* calls: the built-in
# English dictionary for English, an empty one otherwise. (Rust G2PEngine::dictionary)
#must_use
fn shabda_g2p_dictionary(e): i64 { return load64(e + SHABDA_ENGINE_DICT); }

# Rust dictionary_mut() — returns the same handle; mutation is via shbdk_dict_*.
fn shabda_g2p_dictionary_mut(e): i64 { return load64(e + SHABDA_ENGINE_DICT); }

# phoneme_inventory(e) -> varna inventory for the active language. Always compiled.
#must_use
fn shabda_g2p_phoneme_inventory(e): i64 {
    return shabda_inventory_for(load64(e + SHABDA_ENGINE_LANG));
}

# ================================================================
# <lang>_rules dispatch on the language tag. (Rust match self.language.)
# ================================================================
#must_use
fn _shabda_engine_rules(language, word): i64 {
    return _shabda_engine_rules_a(default_alloc(), language, word);
}

# _shabda_engine_rules, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_engine_rules_a(a, language, word): i64 {
    if (language == SHABDA_LANG_ENGLISH)  { return _shabda_english_rules_a(a, word); }
    if (language == SHABDA_LANG_SPANISH)  { return _shabda_spanish_rules_a(a, word); }
    if (language == SHABDA_LANG_GERMAN)   { return _shabda_german_rules_a(a, word); }
    if (language == SHABDA_LANG_HINDI)    { return _shabda_hindi_rules_a(a, word); }
    if (language == SHABDA_LANG_ARABIC)   { return _shabda_arabic_rules_a(a, word); }
    if (language == SHABDA_LANG_SANSKRIT) { return _shabda_sanskrit_rules_a(a, word); }
    return _shabda_english_rules_a(a, word);    # #[non_exhaustive] fallback
}

# ================================================================
# split a normalized cstring on whitespace -> vec of cstr words. The normalized
# text uses single-space separation plus the ,pause/.pause/<emph></emph> marker
# tokens; this collapses runs and drops empties (Rust str::split_whitespace).
# ================================================================
#must_use
fn _shabda_engine_split_ws(text): i64 {
    return _shabda_engine_split_ws_a(default_alloc(), text);
}

# _shabda_engine_split_ws, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_engine_split_ws_a(a, text): i64 {
    var words = vec_new_a(a);
    var n = strlen(text);
    var i = 0;
    var start = 0;
    var inword = 0;
    while (i < n) {
        # Rust split_whitespace splits on Unicode whitespace CODEPOINTS, so step
        # over the whole sequence rather than one byte.
        var wlen = shabda_ws_len_at(text, i, n);
        if (wlen > 0) {
            if (inword == 1) {
                var len = i - start;
                var buf = alloc_via(a, len + 1);
                if (buf == 0) { return words; }
                memcpy(buf, text + start, len);
                store8(buf + len, 0);
                _shabda_vec_push_a(a, words, buf);
                inword = 0;
            }
            i = i + wlen;
        } else {
            if (inword == 0) { start = i; inword = 1; }
            i = i + 1;
        }
    }
    if (inword == 1) {
        var len2 = n - start;
        var buf2 = alloc_via(a, len2 + 1);
        if (buf2 == 0) { return words; }
        memcpy(buf2, text + start, len2);
        store8(buf2 + len2, 0);
        _shabda_vec_push_a(a, words, buf2);
    }
    return words;
}

# Make a Silence PhonemeEvent of the given f64-bit duration (Unstressed).
#must_use
fn _shabda_engine_silence(duration): i64 {
    return _shabda_engine_silence_a(default_alloc(), duration);
}

# _shabda_engine_silence, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_engine_silence_a(a, duration): i64 {
    return _shabda_event_new_a(a, SVARA_PH_SILENCE, duration, SVARA_STRESS_UNSTRESSED);
}

# 1 if `word` is any of the 4 marker tokens (comma/period pause, emph start/end).
fn _shabda_engine_is_marker(word): i64 {
    if (streq(word, SHABDA_COMMA_PAUSE) == 1) { return 1; }
    if (streq(word, SHABDA_PERIOD_PAUSE) == 1) { return 1; }
    if (streq(word, SHABDA_EMPHASIS_START) == 1) { return 1; }
    if (streq(word, SHABDA_EMPHASIS_END) == 1) { return 1; }
    return 0;
}

# Collect up to 3 preceding non-marker words (indices i-1,i-2,i-3 downward),
# nearest first (Rust words[..i].iter().rev().filter(non-marker).take(3)).
#must_use
fn _shabda_engine_preceding_a(a, words, i): i64 {
    var preceding = vec_new_a(a);
    var j = i - 1;
    while (j >= 0) {
        if (vec_len(preceding) >= 3) { return preceding; }
        var w = vec_get(words, j);
        if (_shabda_engine_is_marker(w) == 0) {
            _shabda_vec_push_a(a, preceding, w);
        }
        j = j - 1;
    }
    return preceding;
}

# Copy a vec of i64 (phoneme ordinals) into a fresh owned vec (Rust .to_vec()).
#must_use
fn _shabda_engine_copy_vec(v): i64 {
    return _shabda_engine_copy_vec_a(default_alloc(), v);
}

# _shabda_engine_copy_vec, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_engine_copy_vec_a(a, v): i64 {
    var out = vec_new_a(a);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        _shabda_vec_push_a(a, out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# ================================================================
# Dictionary lookup with the key drawn from an Allocator.
#
# shbdk_dict_lookup / shbdk_dict_lookup_all take no Allocator, and their lowercase
# fast path allocates the 16-byte Str key on the default heap (shabdakosh 3.1.4,
# shbdk_dict_lookup_entry). This takes that same path with the key from `a`: the
# user overlay first, then the base map, through shabdakosh's public accessors. A
# word that is not already lowercase goes to shbdk_dict_lookup_entry itself, whose
# Unicode lowercasing (U+0130, a final capital sigma) this does not repeat.
# shabda_normalize lowers every letter, so a conversion never takes that branch.
# ================================================================
fn _shabda_dict_entry_a(a, d, word): i64 {
    if (word == 0) { return 0; }
    if (shbdk_is_lower_cstr(word) == 0) { return shbdk_dict_lookup_entry(d, word); }
    var key = str_from_a(a, word);
    if (key == 0) { _shabda_alloc_refused("shabda: allocation refused\n", 27); }
    var e = map_get(shbdk_dict_user_entries(d), key);
    if (e != 0) { return e; }
    return map_get(shbdk_dict_entries(d), key);
}

# shbdk_dict_lookup(d, word) with the key drawn from `a`: the primary
# pronunciation's phonemes (shabdakosh's own vec), or 0.
fn _shabda_dict_lookup_a(a, d, word): i64 {
    var e = _shabda_dict_entry_a(a, d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_primary_phonemes(e);
}

# shbdk_dict_lookup_all(d, word) with the key drawn from `a`: the entry's vec of
# pronunciations (shabdakosh's own), or 0.
fn _shabda_dict_lookup_all_a(a, d, word): i64 {
    var e = _shabda_dict_entry_a(a, d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_all(e);
}

# ================================================================
# Letter names. A spelled-out acronym reaches the engine as one token of letters
# joined by hyphens ("f-b-i", from shabda_expand_acronyms or a dotted "U.S."), and a
# lone letter as itself ("plan b"). English says each letter by its name, as CMUdict
# gives them: /ˌɛf ˌbiː ˈaɪ/. Through 3.1.2 the letters went to the rules one by one,
# which gave the bare sounds /f b aɪ/.
# ================================================================
# The phonemes of the name of lowercase letter `c`, as a cstr of svara ordinals, or 0.
fn _shabda_letter_name(c): cstring {
    if (c == 97) { return "\x12"; }                       # a  EY
    if (c == 98) { return "\x15\x0e"; }                   # b  B IY
    if (c == 99) { return "\x1c\x0e"; }                   # c  S IY
    if (c == 100) { return "\x17\x0e"; }                  # d  D IY
    if (c == 101) { return "\x0e"; }                      # e  IY
    if (c == 102) { return "\x0b\x1a"; }                  # f  EH F
    if (c == 103) { return "\x27\x0e"; }                  # g  JH IY
    if (c == 104) { return "\x12\x26"; }                  # h  EY CH
    if (c == 105) { return "\x0f"; }                      # i  AY
    if (c == 106) { return "\x27\x12"; }                  # j  JH EY
    if (c == 107) { return "\x18\x12"; }                  # k  K EY
    if (c == 108) { return "\x0b\x2a"; }                  # l  EH L
    if (c == 109) { return "\x0b\x23"; }                  # m  EH M
    if (c == 110) { return "\x0b\x24"; }                  # n  EH N
    if (c == 111) { return "\x13"; }                      # o  OW
    if (c == 112) { return "\x14\x0e"; }                  # p  P IY
    if (c == 113) { return "\x18\x2d\x04"; }              # q  K Y UW
    if (c == 114) { return "\x0a\x2b"; }                  # r  AA R
    if (c == 115) { return "\x0b\x1c"; }                  # s  EH S
    if (c == 116) { return "\x16\x0e"; }                  # t  T IY
    if (c == 117) { return "\x2d\x04"; }                  # u  Y UW
    if (c == 118) { return "\x1b\x0e"; }                  # v  V IY
    if (c == 119) { return "\x17\x0c\x15\x05\x2a\x2d\x04"; }   # w  D AH B AH0 L Y UW
    if (c == 120) { return "\x0b\x18\x1c"; }              # x  EH K S
    if (c == 121) { return "\x2c\x0f"; }                  # y  W AY
    if (c == 122) { return "\x1d\x0e"; }                  # z  Z IY
    return 0;
}

# 1 if `word` is letters joined by hyphens ("f-b-i"), at least two of them.
fn _shabda_engine_is_spelled(word): i64 {
    var n = strlen(word);
    if (n < 3 || (n % 2) == 0) { return 0; }
    var k = 0;
    while (k < n) {
        var c = load8(word + k);
        if (c < 97 || c > 122) { return 0; }
        if (k + 1 < n && load8(word + k + 1) != 45) { return 0; }
        k = k + 2;
    }
    return 1;
}

# The events of a spelled token, or of a lone letter the dictionary does not have,
# each letter by its name: the last letter's vowel Primary, the others' Secondary
# (CMUdict's "F.B.I." EH2 F B IY2 AY1). 0 when `word` is neither.
#must_use
fn _shabda_engine_spelled_a(a, dict, word): i64 {
    var n = strlen(word);
    if (_shabda_engine_is_spelled(word) == 0) {
        if (n != 1 || _shabda_letter_name(load8(word)) == 0) { return 0; }
        if (_shabda_dict_lookup_a(a, dict, word) != 0) { return 0; }   # "a", "i": the words
    }
    var events = vec_new_a(a);
    var k = 0;
    while (k < n) {
        var name = _shabda_letter_name(load8(word + k));
        var first_vowel = 1;
        var j = 0;
        while (load8(name + j) != 0) {
            var ph = load8(name + j);
            var st = SVARA_STRESS_UNSTRESSED;
            if (_shabda_prosody_is_vowel_like(ph) == 1 && first_vowel == 1) {
                st = SVARA_STRESS_SECONDARY;
                if (k + 2 >= n) { st = SVARA_STRESS_PRIMARY; }
                first_vowel = 0;
            }
            _shabda_vec_push_a(a, events, _shabda_event_new_a(a, ph, svara_phoneme_duration(ph), st));
            j = j + 1;
        }
        k = k + 2;
    }
    return events;
}

# The phonemes (a copy from `a`) of dictionary pronunciation `pron`, with its stress
# (shabdakosh's own vec, read only, or 0 when the dictionary has none) written to
# *out_stress. An empty pronunciation list (pron 0) gives no phonemes.
fn _shabda_engine_from_pron_a(a, pron, out_stress): i64 {
    if (pron == 0) { return vec_new_a(a); }
    store64(out_stress, shbdk_pronunciation_stress(pron));
    return _shabda_engine_copy_vec_a(a, shbdk_pronunciation_phonemes(pron));
}

# ================================================================
# LOOKUP (the exact fallback order from engine.rs convert_with).
# Returns a phonemes vec (owned), and writes to *out_stress the dictionary's stress
# for them (shabdakosh 3.2.0: one SHBDK_STRESS_* per phoneme), or 0 when they come
# from the rules or the dictionary has no stress for the word.
# ================================================================
#must_use
fn _shabda_engine_lookup_a(a, e, word, preceding, out_stress): i64 {
    var language = load64(e + SHABDA_ENGINE_LANG);
    var dict = load64(e + SHABDA_ENGINE_DICT);
    store64(out_stress, 0);

    var rule = shabda_heteronym_lookup(word);
    if (rule != 0) {
        var prons = _shabda_dict_lookup_all_a(a, dict, word);
        if (prons != 0) {
            return _shabda_engine_from_pron_a(a, _shabda_select_pronunciation_a(a, rule, preceding, prons), out_stress);
        }
        return _shabda_engine_rules_a(a, language, word);
    }

    var dent = _shabda_dict_entry_a(a, dict, word);
    if (dent != 0) {
        return _shabda_engine_from_pron_a(a, shbdk_dict_entry_primary(dent), out_stress);
    }

    # A word with accented Latin letters is a loan word only in English, whose
    # dictionary and rules are ASCII. In Spanish and German the accents are the
    # language's own letters (ñ, á, ü, ö, ß ...), which the rules read: stripping
    # them made "niño" "nino" and "über" "uber".
    if (language == SHABDA_LANG_ENGLISH && _shabda_is_foreign_word_a(a, word) == 1) {
        var stripped = _shabda_strip_diacritics_a(a, word);
        var sent = _shabda_dict_entry_a(a, dict, stripped);
        if (sent != 0) {
            return _shabda_engine_from_pron_a(a, shbdk_dict_entry_primary(sent), out_stress);
        }
        return _shabda_engine_rules_a(a, language, stripped);
    }

    return _shabda_engine_rules_a(a, language, word);
}

# ================================================================
# convert(e, text, out_events) -> packed err (0 ok); writes events vec to
# *out_events. Delegates to convert_with with default options.
# ================================================================
#must_use
fn shabda_convert(e, text, out_events): i64 {
    return shabda_convert_a(default_alloc(), e, text, out_events);
}

# shabda_convert with every allocation drawn from Allocator `a` (the stdlib's `_a`
# convention): the events vec, the events, and everything the conversion builds on
# the way. Nothing is written to the default heap or to the engine, so a caller that
# passes an arena and resets it after reading the events gets all of it back. A
# conversion has no error for a refused allocation, so pass an Allocator that grows,
# such as arena_allocator_growable(): a refused vec or builder grow ends the process,
# as vec_push does.
#must_use
fn shabda_convert_a(a, e, text, out_events): i64 {
    return shabda_convert_with_a(a, e, text, _shabda_convert_options_default_a(a), out_events);
}

# ================================================================
# convert_with(e, text, options, out_events) -> packed err (0 ok); on ok writes
# the events vec to *out_events. THE PIPELINE — replicates engine.rs convert_with.
# ================================================================
#must_use
fn shabda_convert_with(e, text, options, out_events): i64 {
    return shabda_convert_with_a(default_alloc(), e, text, options, out_events);
}

# shabda_convert_with with every allocation drawn from Allocator `a`. See
# shabda_convert_a. `options` is only read; it may live anywhere.
#must_use
fn shabda_convert_with_a(a, e, text, options, out_events): i64 {
    # 1. empty text -> InvalidInput error.
    var tn = strlen(text);
    var tso = alloc_via(a, 8);
    var teo = alloc_via(a, 8);
    if (tso == 0 || teo == 0) { return shabda_err_invalid_input(); }
    _shabda_engine_trim(text, 0, tn, tso, teo);
    if (load64(teo) <= load64(tso)) { return shabda_err_invalid_input(); }

    var language = load64(e + SHABDA_ENGINE_LANG);

    # 2. inventory (always compiled).
    var inv = shabda_inventory_for(language);

    # 3. intonation (computed; used by nothing downstream — parity with Rust).
    var intonation = shabda_detect_intonation(text);

    # 4. normalize (with or without emphasis).
    var normalized = 0;
    if (shabda_convert_options_emphasis(options) != 0) {
        normalized = _shabda_normalize_with_emphasis_a(a, text);
    } else {
        normalized = _shabda_normalize_a(a, text);
    }

    # 5. split on whitespace.
    var words = _shabda_engine_split_ws_a(a, normalized);
    var nwords = vec_len(words);

    # 6. events + emphasis state; the slot a lookup writes the dictionary's stress to.
    var events = vec_new_a(a);
    var emphasis_active = 0;
    var stress_slot = alloc_via(a, 8);
    if (stress_slot == 0) { return shabda_err_invalid_input(); }

    # 7. per-word loop.
    var i = 0;
    while (i < nwords) {
        var word = vec_get(words, i);

        # a/b. emphasis markers.
        if (streq(word, SHABDA_EMPHASIS_START) == 1) {
            emphasis_active = 1;
            i = i + 1;
            continue;
        }
        if (streq(word, SHABDA_EMPHASIS_END) == 1) {
            emphasis_active = 0;
            i = i + 1;
            continue;
        }
        # c/d. phrase-boundary markers.
        if (streq(word, SHABDA_COMMA_PAUSE) == 1) {
            _shabda_vec_push_a(a, events, _shabda_engine_silence_a(a, SHABDA_ENGINE_COMMA_DUR));
            i = i + 1;
            continue;
        }
        if (streq(word, SHABDA_PERIOD_PAUSE) == 1) {
            _shabda_vec_push_a(a, events, _shabda_engine_silence_a(a, SHABDA_ENGINE_PERIOD_DUR));
            i = i + 1;
            continue;
        }

        # e. English letter names (a spelled acronym, a lone letter).
        var word_events = 0;
        if (language == SHABDA_LANG_ENGLISH) {
            word_events = _shabda_engine_spelled_a(a, load64(e + SHABDA_ENGINE_DICT), word);
        }

        if (word_events == 0) {
            # e. preceding context.
            var preceding = _shabda_engine_preceding_a(a, words, i);

            # f. LOOKUP (dict-first, rule fallback).
            var phonemes = _shabda_engine_lookup_a(a, e, word, preceding, stress_slot);
            var dict_stress = load64(stress_slot);

            # g. debug validation — always compiled, results DISCARDED, never abort.
            var _invalid = _shabda_validate_phonemes_for_a(a, phonemes, inv, language);
            var _violations = _shabda_validate_phonotactics_a(a, phonemes, language);

            # h. skip empties.
            if (vec_len(phonemes) == 0) {
                i = i + 1;
                continue;
            }

            # i/j/k. stress: the dictionary's where it has it (shabdakosh 3.2.0);
            # otherwise syllabify and assign it by rule: the language's onsets, and for
            # English its own stress rules (the syllabic rule is Latin's; see
            # shabda_assign_stress_english).
            var is_content = _shabda_is_content_word_a(a, word);
            if (dict_stress != 0) {
                word_events = _shabda_assign_stress_dictionary_a(a, phonemes, dict_stress, is_content);
            } else {
                var syllables = _shabda_syllabify_for_a(a, phonemes, language);
                if (vec_len(syllables) == 0) {
                    word_events = _shabda_assign_stress_a(a, phonemes, is_content);
                } elif (language == SHABDA_LANG_ENGLISH) {
                    word_events = _shabda_assign_stress_english_a(a, word, syllables, is_content);
                } else {
                    word_events = _shabda_assign_stress_syllabic_a(a, syllables, is_content);
                }
            }
        }

        # l. emphasis if active.
        if (emphasis_active == 1) {
            shabda_apply_emphasis(word_events);
        }

        # m. append word events.
        var wn = vec_len(word_events);
        var wi = 0;
        while (wi < wn) {
            _shabda_vec_push_a(a, events, vec_get(word_events, wi));
            wi = wi + 1;
        }

        # n. inter-word silence (not after last word).
        if (i < nwords - 1) {
            _shabda_vec_push_a(a, events, _shabda_engine_silence_a(a, SHABDA_ENGINE_WORD_DUR));
        }

        i = i + 1;
    }

    # 8. rate scaling.
    if (shabda_convert_options_has_rate(options) == 1) {
        shabda_apply_rate(events, shabda_convert_options_rate_wpm(options));
    }
    # 9. timing profile.
    var timing = shabda_convert_options_timing(options);
    if (timing != 0) {
        shabda_apply_timing(events, timing);
    }

    # 10. ok — write out the events vec.
    store64(out_events, events);
    return 0;
}

# ================================================================
# speak(e, text, voice, sr, out_samples) -> packed err (0 ok); writes samples.
# ================================================================
#must_use
fn shabda_speak(e, text, voice, sample_rate, out_samples): i64 {
    return shabda_speak_with(e, text, voice, sample_rate, shabda_convert_options_default(), out_samples);
}

# speak_with: convert, push each event to a sequence, render to samples. Render
# error -> shabda_err_rule_error() (Rust maps the svara error into RuleError).
# Writes the samples vec to *out_samples on ok.
#must_use
fn shabda_speak_with(e, text, voice, sample_rate, options, out_samples): i64 {
    var evslot = alloc(8);
    var cerr = shabda_convert_with(e, text, options, evslot);
    if (shabda_is_err(cerr) == 1) { return cerr; }
    var events = load64(evslot);

    var seq = svara_sequence_new();
    var n = vec_len(events);
    var i = 0;
    while (i < n) {
        svara_sequence_push(seq, vec_get(events, i));
        i = i + 1;
    }

    var samples = svara_sequence_render(seq, voice, sample_rate);
    if (svara_is_err(samples) == 1) { return shabda_err_rule_error(); }
    store64(out_samples, samples);
    return 0;
}

# ================================================================
# convert_ssml(e, ssml, out_events) -> packed err (0 ok); writes events on ok.
# ================================================================
#must_use
fn shabda_convert_ssml(e, ssml, out_events): i64 {
    # trim empty -> InvalidInput.
    var n = strlen(ssml);
    var sso = alloc(8);
    var seo = alloc(8);
    if (sso == 0 || seo == 0) { return shabda_err_invalid_input(); }
    _shabda_engine_trim(ssml, 0, n, sso, seo);
    if (load64(seo) <= load64(sso)) { return shabda_err_invalid_input(); }

    var nodes = shabda_ssml_parse(ssml);
    if (nodes == 0) { return shabda_err_invalid_input(); }   # Rust parse Err

    var events = vec_new();
    var rc = _shabda_engine_render_ssml_nodes(e, nodes, shabda_convert_options_default(), events);
    if (shabda_is_err(rc) == 1) { return rc; }
    store64(out_events, events);
    return 0;
}

# ================================================================
# render_ssml_nodes (recursive). Appends into `events`. Returns 0 on ok, or a
# packed error propagated from a convert_with call (Rust `?`).
# ================================================================
#must_use
fn _shabda_engine_render_ssml_nodes(e, nodes, base_options, events): i64 {
    var n = vec_len(nodes);
    var i = 0;
    while (i < n) {
        var node = vec_get(nodes, i);
        var tag = shabda_ssml_node_tag(node);

        if (tag == SHABDA_SSML_TEXT) {
            var text_str = shabda_ssml_node_text(node);
            var text = str_cstr(text_str);
            # non-empty (trimmed) text only.
            var tn = strlen(text);
            var rso = alloc(8);
            var reo = alloc(8);
            if (rso == 0 || reo == 0) { return shabda_err_invalid_input(); }
            _shabda_engine_trim(text, 0, tn, rso, reo);
            if (load64(reo) > load64(rso)) {
                var teslot = alloc(8);
                var terr = shabda_convert_with(e, text, base_options, teslot);
                if (shabda_is_err(terr) == 1) { return terr; }
                var text_events = load64(teslot);
                var ten = vec_len(text_events);
                var ti = 0;
                while (ti < ten) {
                    vec_push(events, vec_get(text_events, ti));
                    ti = ti + 1;
                }
            }
        } elif (tag == SHABDA_SSML_BREAK) {
            # duration_ms / 1000.0 seconds.
            var duration_ms = shabda_ssml_node_duration(node);
            var duration_secs = f64_div(f64_from(duration_ms), f64_from(1000));
            vec_push(events, _shabda_engine_silence(duration_secs));
        } elif (tag == SHABDA_SSML_EMPHASIS) {
            # base + emphasis detection (on, or off for level="none"); recurse; then
            # mark the content per level. SSML 1.1 §3.2.2: moderate (the default) is
            # emphasis, strong more of it, none prevents it, reduced is its opposite.
            # Through 3.1.2 moderate did nothing to a lowercase word, and none was read
            # as moderate.
            var level = shabda_ssml_node_level(node);
            var eopts = _shabda_engine_opts_with_emphasis(base_options);
            if (level == SHABDA_EMPH_NONE) { store64(eopts + SHABDA_OPT_EMPHASIS, 0); }
            var start = vec_len(events);
            var erc = _shabda_engine_render_ssml_nodes(e, shabda_ssml_node_children(node), eopts, events);
            if (shabda_is_err(erc) == 1) { return erc; }
            if (level == SHABDA_EMPH_STRONG) {
                # Primary stress and 1.3x vowels, as an ALL-CAPS word gets.
                _shabda_engine_apply_emphasis_range(events, start);
            } elif (level == SHABDA_EMPH_REDUCED) {
                _shabda_engine_destress_range(events, start);
            } elif (level == SHABDA_EMPH_MODERATE) {
                # Primary stress without the lengthening: less than strong.
                _shabda_engine_stress_range(events, start);
            }
        } elif (tag == SHABDA_SSML_PROSODY) {
            # rate? base+speaking_rate : base.
            var popts = base_options;
            var rate = shabda_ssml_node_rate(node);
            if (rate == SHABDA_RATE_PERCENT) {
                # A multiplier of the default rate (SSML 1.1 §3.2.4).
                var pbase = shabda_speaking_rate_wpm(SHABDA_RATE_MEDIUM);
                var pwpm = f64_div(f64_mul(pbase, shabda_ssml_node_rate_percent(node)), f64_from(100));
                popts = _shabda_engine_opts_with_rate(base_options, pwpm);
            } elif (rate != SHABDA_RATE_NONE) {
                popts = _shabda_engine_opts_with_rate(base_options, shabda_speaking_rate_wpm(rate));
            }
            var prc = _shabda_engine_render_ssml_nodes(e, shabda_ssml_node_children(node), popts, events);
            if (shabda_is_err(prc) == 1) { return prc; }
        }
        i = i + 1;
    }
    return 0;
}

# Clone `base` options, set emphasis=1 (Rust ConvertOptions{ emphasis:true, ..base }).
#must_use
fn _shabda_engine_opts_with_emphasis(base): i64 {
    var o = alloc(SHABDA_OPT_SIZE);
    store64(o + SHABDA_OPT_EMPHASIS, 1);
    store64(o + SHABDA_OPT_HAS_RATE, load64(base + SHABDA_OPT_HAS_RATE));
    store64(o + SHABDA_OPT_RATE_WPM, load64(base + SHABDA_OPT_RATE_WPM));
    store64(o + SHABDA_OPT_TIMING, load64(base + SHABDA_OPT_TIMING));
    return o;
}

# Clone `base` options, set speaking_rate=wpm (Rust ConvertOptions{ speaking_rate_wpm:Some(r), ..base }).
#must_use
fn _shabda_engine_opts_with_rate(base, wpm): i64 {
    var o = alloc(SHABDA_OPT_SIZE);
    store64(o + SHABDA_OPT_EMPHASIS, load64(base + SHABDA_OPT_EMPHASIS));
    store64(o + SHABDA_OPT_HAS_RATE, 1);
    store64(o + SHABDA_OPT_RATE_WPM, wpm);
    store64(o + SHABDA_OPT_TIMING, load64(base + SHABDA_OPT_TIMING));
    return o;
}

# apply_emphasis over events[start..] (Rust prosody::apply_emphasis on the tail).
fn _shabda_engine_apply_emphasis_range(events, start): i64 {
    var n = vec_len(events);
    var i = start;
    while (i < n) {
        var ev = vec_get(events, i);
        var ph = SvPhonemeEvent_phoneme(ev);
        var c = svara_phoneme_class(ph);
        if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) {
            # In place, as Rust does (`event.stress = ...; event.duration *= ...`).
            # Allocating a replacement made NESTED <emphasis> quadratic in permanent
            # bump-allocator bytes: every level re-walks the whole event tail its
            # children already produced, and each visit minted a fresh SvPhonemeEvent.
            var edur = f64_mul(SvPhonemeEvent_duration(ev), SHABDA_PROSODY_EMPHASIS_DURATION_SCALE);
            SvPhonemeEvent_set_duration(ev, edur);
            SvPhonemeEvent_set_stress(ev, SVARA_STRESS_PRIMARY);
        }
        i = i + 1;
    }
    return 0;
}

# Primary stress on every vowel of events[start..], durations unchanged: SSML
# level="moderate".
fn _shabda_engine_stress_range(events, start): i64 {
    var n = vec_len(events);
    var i = start;
    while (i < n) {
        var ev = vec_get(events, i);
        var c = svara_phoneme_class(SvPhonemeEvent_phoneme(ev));
        if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) {
            SvPhonemeEvent_set_stress(ev, SVARA_STRESS_PRIMARY);
        }
        i = i + 1;
    }
    return 0;
}

# De-stress events[start..] to Unstressed (Rust Reduced: event.stress = Unstressed).
fn _shabda_engine_destress_range(events, start): i64 {
    var n = vec_len(events);
    var i = start;
    while (i < n) {
        # In place, as Rust does — see the note in _shabda_engine_apply_emphasis_range.
        SvPhonemeEvent_set_stress(vec_get(events, i), SVARA_STRESS_UNSTRESSED);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# convert_streaming(e, text, callback_fp) -> 0 (ok) | packed error.
# Simpler than convert_with (NO heteronym/foreign/emphasis) — matches engine.rs.
# callback_fp is a fn pointer called as callptr(fp, word, word_events).
# ================================================================
#must_use
fn shabda_convert_streaming(e, text, callback_fp): i64 {
    # trim empty -> InvalidInput.
    var n = strlen(text);
    var cso = alloc(8);
    var ceo = alloc(8);
    if (cso == 0 || ceo == 0) { return shabda_err_invalid_input(); }
    _shabda_engine_trim(text, 0, n, cso, ceo);
    if (load64(ceo) <= load64(cso)) { return shabda_err_invalid_input(); }

    var language = load64(e + SHABDA_ENGINE_LANG);
    var dict = load64(e + SHABDA_ENGINE_DICT);

    var normalized = shabda_normalize(text);
    var words = _shabda_engine_split_ws(normalized);
    var nwords = vec_len(words);

    var i = 0;
    while (i < nwords) {
        var word = vec_get(words, i);

        if (streq(word, SHABDA_COMMA_PAUSE) == 1) {
            var cev = vec_new();
            vec_push(cev, _shabda_engine_silence(SHABDA_ENGINE_COMMA_DUR));
            var cr = callptr(callback_fp, word, cev);
            i = i + 1;
            continue;
        }
        if (streq(word, SHABDA_PERIOD_PAUSE) == 1) {
            var pev = vec_new();
            vec_push(pev, _shabda_engine_silence(SHABDA_ENGINE_PERIOD_DUR));
            var pr = callptr(callback_fp, word, pev);
            i = i + 1;
            continue;
        }

        var spelled = 0;
        if (language == SHABDA_LANG_ENGLISH) { spelled = _shabda_engine_spelled_a(default_alloc(), dict, word); }
        if (spelled != 0) {
            var sr = callptr(callback_fp, word, spelled);
            i = i + 1;
            continue;
        }

        # dict.lookup | <lang>_rules (no heteronym/foreign/emphasis).
        var phonemes = 0;
        var dict_stress = 0;
        var sentry = shbdk_dict_lookup_entry(dict, word);
        if (sentry != 0) {
            var spron = shbdk_dict_entry_primary(sentry);
            phonemes = _shabda_engine_copy_vec(shbdk_pronunciation_phonemes(spron));
            dict_stress = shbdk_pronunciation_stress(spron);
        } else {
            phonemes = _shabda_engine_rules(language, word);
        }

        if (vec_len(phonemes) == 0) {
            i = i + 1;
            continue;
        }

        var is_content = shabda_is_content_word(word);
        var word_events = 0;
        if (dict_stress != 0) {
            word_events = shabda_assign_stress_dictionary(phonemes, dict_stress, is_content);
        } else {
            var syllables = shabda_syllabify_for(phonemes, language);
            if (vec_len(syllables) == 0) {
                word_events = shabda_assign_stress(phonemes, is_content);
            } elif (language == SHABDA_LANG_ENGLISH) {
                word_events = shabda_assign_stress_english(word, syllables, is_content);
            } else {
                word_events = shabda_assign_stress_syllabic(syllables, is_content);
            }
        }

        var wr = callptr(callback_fp, word, word_events);
        i = i + 1;
    }

    return 0;
}
