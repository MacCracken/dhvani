    _shabda_en_r(t, "", "our", "", "AO1 R");
    _shabda_en_r(t, "", "ould", "", "UH1 D");
    _shabda_en_r(t, "^", "ou", "^l", "AH1");
    _shabda_en_r(t, "", "oup", "", "UW1 P");
    _shabda_en_r(t, "", "ou", "", "AW1");
    _shabda_en_r(t, "", "oing", "", "OW1 IH0 NG");
    _shabda_en_r(t, "", "oi", "", "OY1");
    _shabda_en_r(t, "", "oor", "", "AO1 R");
    _shabda_en_r(t, "", "ook", "", "UH1 K");
    _shabda_en_r(t, "", "ood", "", "UH1 D");
