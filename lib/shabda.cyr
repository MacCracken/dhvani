# shabda.cyr -- bundled distribution
# Version: 3.2.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# error.cyr — shabda error codes + shared L0 constants, built on sakshi's
# packed-i64 error model.
#
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other — the entry file (src/main.cyr / tests/*.tcyr) orders
# includes; the stdlib (incl. sakshi) auto-resolves from cyrius.cyml [deps].
#
# Ports rust-old/src/error.rs (the `ShabdaError` enum — #[non_exhaustive], 5
# variants). Rust carried a String payload per variant + a thiserror Display; the
# Cyrius port drops the payloads and builds on sakshi (साक्षी — the AGNOS
# error/tracing substrate): each error is a packed i64 `[ctx][category][code]`.
# 0 == ok, non-zero == error. Diagnostic text lives in shabda_err_name().
#
# CONVENTION: a fallible fn returns a packed shabda error (0 == ok) and writes any
# payload to an out-param, OR returns a payload pointer with 0 meaning "none" —
# disambiguate with shabda_is_err().
#
# This module also hoists the shared integer tags used across the crate
# (Language, SentenceType, TimingProfile layout, the phoneme sentinel). They live
# in the L0 base so later modules (prosody, validate, engine) reference them
# regardless of include order — mirrors how shabdakosh put SHBDK_PH_NONE in L0.
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`-prefixed (flat link
# namespace; coexists with shbdk_ / svara_ / varna / sakshi).

# ================================================================
# Error codes (was `enum ShabdaError`). One per Rust variant, in order. Stored in
# bits 0-15 of a sakshi packed error; kept above sakshi's common ErrCode block
# (0..7) and clear of shabdakosh's 0x01xx block to avoid collision.
# ================================================================
var SHABDA_ERR_INVALID_INPUT        = 0x0201;   # InvalidInput(String)
var SHABDA_ERR_UNKNOWN_WORD         = 0x0202;   # UnknownWord(String)
var SHABDA_ERR_UNSUPPORTED_LANGUAGE = 0x0203;   # UnsupportedLanguage(String)
var SHABDA_ERR_RULE_ERROR           = 0x0204;   # RuleError(String)
var SHABDA_ERR_DICT_PARSE           = 0x0205;   # DictParseError(String)

# ================================================================
# Shared L0 constants (hoisted here so every module sees ONE definition — flat
# namespace, no forward-declare needed for later includes).
# ================================================================
# "No phoneme" sentinel — a svara phoneme is an ordinal 0..N; this is Rust's
# Option::None on a phoneme lookup.
var SHABDA_PH_NONE = (0 - 1);

# Language tags (was `enum Language`, #[non_exhaustive]). Ctor/name fns in engine.cyr.
var SHABDA_LANG_ENGLISH  = 0;
var SHABDA_LANG_SPANISH  = 1;
var SHABDA_LANG_GERMAN   = 2;
var SHABDA_LANG_HINDI    = 3;
var SHABDA_LANG_ARABIC   = 4;
var SHABDA_LANG_SANSKRIT = 5;

# SentenceType tags (owned by normalize; detect fns there). Statement/Question/
# Exclamation.
var SHABDA_STYPE_STATEMENT   = 0;
var SHABDA_STYPE_QUESTION    = 1;
var SHABDA_STYPE_EXCLAMATION = 2;

# TimingProfile layout (24 bytes): three f64-bit scale factors. Ctor/accessors in
# engine.cyr; prosody reads the offsets directly.
var SHABDA_TIMING_VOWEL     = 0;    # [0]  vowel_scale     (f64 bits)
var SHABDA_TIMING_CONSONANT = 8;    # [8]  consonant_scale (f64 bits)
var SHABDA_TIMING_PAUSE     = 16;   # [16] pause_scale     (f64 bits)
var SHABDA_TIMING_SIZE      = 24;

# "No primary stress" sentinel for the syllabic stress rule (Rust's usize::MAX).
var SHABDA_NO_STRESS_IDX = (0 - 1);

# ================================================================
# Constructors — pack the shabda code + a sakshi category into an i64 error.
# ================================================================
#must_use
fn shabda_err_invalid_input(): i64 {
    return sakshi_err_new(SHABDA_ERR_INVALID_INPUT, ERR_CAT_PARSE);
}

# A word could not be converted to phonemes. Category RUNTIME. (Rust UnknownWord)
#must_use
fn shabda_err_unknown_word(): i64 {
    return sakshi_err_new(SHABDA_ERR_UNKNOWN_WORD, ERR_CAT_RUNTIME);
}

# The requested language is not supported. Category CONFIG. (Rust UnsupportedLanguage)
#must_use
fn shabda_err_unsupported_language(): i64 {
    return sakshi_err_new(SHABDA_ERR_UNSUPPORTED_LANGUAGE, ERR_CAT_CONFIG);
}

# A conversion rule failed. Category RUNTIME. (Rust RuleError)
#must_use
fn shabda_err_rule_error(): i64 {
    return sakshi_err_new(SHABDA_ERR_RULE_ERROR, ERR_CAT_RUNTIME);
}

# Dictionary parsing or I/O failed. Category PARSE. (Rust DictParseError)
#must_use
fn shabda_err_dict_parse(): i64 {
    return sakshi_err_new(SHABDA_ERR_DICT_PARSE, ERR_CAT_PARSE);
}

# From<ShabdakoshError> — Rust folds every shabdakosh error into DictParseError.
# Takes a packed shbdk error, returns a packed shabda DictParse error.
#must_use
fn shabda_from_shabdakosh_err(shbdk_err): i64 {
    return sakshi_err_new(SHABDA_ERR_DICT_PARSE, ERR_CAT_PARSE);
}

# ================================================================
# Predicates + diagnostics (thin over sakshi, prefixed for the shabda surface).
# ================================================================
# 1 if `err` is an error (non-zero), 0 otherwise.
#must_use
fn shabda_is_err(err): i64 {
    return sakshi_is_err(err);
}

# 1 if `err` is ok (zero), 0 otherwise.
#must_use
fn shabda_is_ok(err): i64 {
    return sakshi_is_ok(err);
}

# Static diagnostic text for a shabda error (was thiserror's Display, minus the
# dropped String payload). Matches on the code field; final arm is the
# #[non_exhaustive] fallback. Returns `cstring` so println/fmt print the text.
#must_use
fn shabda_err_name(err): cstring {
    var code = sakshi_err_code(err);
    if (code == SHABDA_ERR_INVALID_INPUT)        { return "invalid input"; }
    if (code == SHABDA_ERR_UNKNOWN_WORD)         { return "unknown word"; }
    if (code == SHABDA_ERR_UNSUPPORTED_LANGUAGE) { return "unsupported language"; }
    if (code == SHABDA_ERR_RULE_ERROR)           { return "rule error"; }
    if (code == SHABDA_ERR_DICT_PARSE)           { return "dictionary parse error"; }
    if (code == 0)                                { return "ok"; }
    return "unknown error";
}

# ================================================================
# Shared Unicode predicates (L0 so every later module gets ONE definition).
#
# The port originally hand-rolled an ASCII-only whitespace test per module
# (normalize / ssml / engine, three byte-identical copies). Rust uses
# `char::is_whitespace` / `str::trim` / `str::split_whitespace`, all of which are
# the Unicode White_Space property — so NBSP-separated words were glued into one
# token, a U+3000-only string slipped past the "empty input" guard, and a trailing
# U+00A0 hid the terminal '?' from sentence-type detection. These are the exact
# property, not an approximation.
# ================================================================
# Rust `char::is_whitespace` — the Unicode White_Space property, in full.
#must_use
fn shabda_is_ws_cp(cp): i64 {
    if (cp == 0x20) { return 1; }                     # SPACE
    if (cp >= 0x09 && cp <= 0x0D) { return 1; }       # TAB LF VT FF CR
    if (cp == 0x85) { return 1; }                     # NEXT LINE
    if (cp == 0xA0) { return 1; }                     # NO-BREAK SPACE
    if (cp == 0x1680) { return 1; }                   # OGHAM SPACE MARK
    if (cp >= 0x2000 && cp <= 0x200A) { return 1; }   # EN QUAD .. HAIR SPACE
    if (cp == 0x2028) { return 1; }                   # LINE SEPARATOR
    if (cp == 0x2029) { return 1; }                   # PARAGRAPH SEPARATOR
    if (cp == 0x202F) { return 1; }                   # NARROW NO-BREAK SPACE
    if (cp == 0x205F) { return 1; }                   # MEDIUM MATHEMATICAL SPACE
    if (cp == 0x3000) { return 1; }                   # IDEOGRAPHIC SPACE
    return 0;
}

# Byte length of the whitespace codepoint starting at buf[i], or 0 if buf[i] does
# not begin one. `end` bounds the read, so a sequence truncated by the end of the
# buffer decodes to nothing rather than reading past it. An invalid or overlong
# sequence is never whitespace, so it also returns 0 — which is what Rust's
# lossy-free `&str` guarantees for the same bytes.
#must_use
fn shabda_ws_len_at(buf, i, end): i64 {
    if (i >= end) { return 0; }
    var b0 = load8(buf + i) & 0xFF;
    if (b0 < 0x80) {
        if (shabda_is_ws_cp(b0) == 1) { return 1; }
        return 0;
    }
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        if (i + 1 >= end) { return 0; }
        var b1 = load8(buf + i + 1) & 0xFF;
        if (b1 < 0x80 || b1 > 0xBF) { return 0; }
        if (shabda_is_ws_cp(((b0 & 0x1F) << 6) | (b1 & 0x3F)) == 1) { return 2; }
        return 0;
    }
    if (b0 >= 0xE0 && b0 <= 0xEF) {
        if (i + 2 >= end) { return 0; }
        var c1 = load8(buf + i + 1) & 0xFF;
        var c2 = load8(buf + i + 2) & 0xFF;
        if (c1 < 0x80 || c1 > 0xBF) { return 0; }
        if (c2 < 0x80 || c2 > 0xBF) { return 0; }
        if (shabda_is_ws_cp(((b0 & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F)) == 1) { return 3; }
        return 0;
    }
    return 0;                                          # 4-byte: no White_Space there
}

# Byte length of the whitespace codepoint ENDING at buf[end-1], or 0. Walks back
# over at most three continuation bytes to find the lead byte, then re-decodes
# forward so the answer is exactly shabda_ws_len_at's.
#must_use
fn shabda_ws_len_before(buf, start, end): i64 {
    if (end <= start) { return 0; }
    var i = end - 1;
    var back = 0;
    while (i > start && back < 3) {
        var b = load8(buf + i) & 0xFF;
        if (b < 0x80 || b > 0xBF) { break; }
        i = i - 1;
        back = back + 1;
    }
    var n = shabda_ws_len_at(buf, i, end);
    if (n == end - i) { return n; }                    # must land exactly on end
    return 0;
}

# ================================================================
# Allocator plumbing for the `_a` forms (3.1.2). Stdlib only, so every suite can
# include it.
#
# Every fn that shabda_convert_with reaches and that allocates has an `_a` twin
# taking the Allocator first, in the stdlib's `vec_new_a` / `alloc_via`
# convention. The original fn is a one-line wrapper over `default_alloc()`, so
# the two share one body and the original allocates exactly what it did before.
# The helpers below stand in for the stdlib calls whose `_a` form behaves
# differently: `vec_push` and `str_builder_add_cstr` end the process when a grow
# is refused, while their `_a` forms return -1 and the caller carries on with the
# value missing, and `str_cstr` and `str_lower_cstr` copy onto the default heap
# with no `_a` form at all.
# ================================================================

# End the process over a refused allocation, writing `msg` (`n` bytes) to stderr
# and exiting with status 1, as the stdlib's aborting wrappers do.
fn _shabda_alloc_refused(msg, n): i64 {
    syscall(SYS_WRITE, 2, msg, n);
    syscall(SYS_EXIT, 1);
    return 0;
}

# vec_push(v, val) with the grow drawn from `a`. A refused grow ends the process
# with vec_push's own message, so the wrapper over default_alloc() behaves as
# vec_push did.
fn _shabda_vec_push_a(a, v, val): i64 {
    if (vec_push_a(a, v, val) < 0) { _shabda_alloc_refused("vec: alloc failed\n", 18); }
    return 0;
}

# str_builder_add_cstr(sb, cstr) with the grow drawn from `a`. A refused grow ends
# the process with str_builder_add_cstr's own message.
fn _shabda_sb_add_cstr_a(a, sb, cstr): i64 {
    if (str_builder_add_cstr_a(a, sb, cstr) < 0) {
        _shabda_alloc_refused("str_builder: alloc failed\n", 26);
    }
    return 0;
}

# str_cstr(s) with the copy drawn from `a`: a NUL-terminated copy of Str `s`'s
# bytes, or 0 if the copy is refused.
#must_use
fn _shabda_str_cstr_a(a, s): i64 {
    var slen = str_len(s);
    var buf = alloc_via(a, slen + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(s), slen);
    store8(buf + slen, 0);
    return buf;
}

# str_lower_cstr(s) with the copy drawn from `a`: a NUL-terminated copy of `s`
# with 'A'..'Z' lowered and every other byte unchanged, or 0 if the copy is refused.
#must_use
fn _shabda_ascii_lower_a(a, s): i64 {
    var n = strlen(s);
    var dst = alloc_via(a, n + 1);
    if (dst == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(dst + i, c);
        i = i + 1;
    }
    store8(dst + n, 0);
    return dst;
}

# --- normalize.cyr ---

# normalize.cyr — text normalization for G2P (ports rust-old/src/normalize.rs).
#
# Leaf module: depends on stdlib only (string/str/vec/fmt/alloc). OWNS the
# SentenceType surface — the SHABDA_STYPE_* tags are hoisted in error.cyr (L0);
# the detect fn (shabda_detect_intonation) lives here.
#
# Ports: normalize, normalize_with_emphasis, expand_abbreviations,
# expand_acronyms, is_foreign_word, strip_diacritics, expand_numbers,
# detect_intonation. Plus the private helpers (match_abbreviation,
# split_trailing_punct, is_acronym, is_pronounceable_acronym, collect_number,
# expand_number_token, digits_to_words, number_to_words, hundreds/tens_to_words,
# is_latin_extended, normalize_token_into).
#
# CYRIUS STRING MODEL: strings are cstr byte pointers (NUL-terminated). Rust's
# `.chars()` scalar iteration is replaced by a UTF-8 decoder (_shabda_utf8_next,
# copied from shabdakosh detect.cyr) that walks code points. Output is built into
# a growable byte buffer (a "SB": a heap struct that owns a cstr + len + cap and
# appends bytes / cstr literals / UTF-8-encoded code points) so we never touch the
# Str<->cstr trap.
#
# SB layout (24 bytes): [0]=data ptr, [8]=len (bytes, excl NUL), [16]=cap (bytes
# of the backing alloc, incl room for NUL).
#
# tracing trace! calls in the Rust are dropped (no-op).
#
# DIVERGENCE (number parsing): Rust parses integer tokens with str::parse::<u64>()
# (range 0..=u64::MAX). Cyrius is i64-only, so _shabda_parse_u64 accepts 0..=i64::MAX
# and falls back to digit-by-digit (Rust digits_to_words) on i64 overflow. This is
# faithful for every value <= i64::MAX; values in (i64::MAX, u64::MAX] parse in Rust
# but overflow here. Rust's own number_to_words only handles up to billions, so it
# renders those huge values as garbage anyway; no ported test covers that range.
#
# Dep position: included after src/error.cyr (which hoists SHABDA_STYPE_*). Never
# includes other modules. NAMING: every top-level symbol is shabda_/SHABDA_-prefixed.

# ================================================================
# Constants — MATCH the Rust literal values in normalize.rs exactly.
# COMMA_PAUSE=",pause"  PERIOD_PAUSE=".pause"
# EMPHASIS_START="<emph>"  EMPHASIS_END="</emph>"
# ================================================================
var SHABDA_COMMA_PAUSE    = ",pause";
var SHABDA_PERIOD_PAUSE   = ".pause";
var SHABDA_EMPHASIS_START = "<emph>";
var SHABDA_EMPHASIS_END   = "</emph>";

# ================================================================
# UTF-8 code-point decoder — verbatim from shabdakosh detect.cyr. Decodes one
# code point at byte pointer p; writes the scalar to *out_cp; returns bytes
# consumed (1..4), or 0 at the NUL terminator.
# ================================================================
fn _shabda_utf8_next(p, out_cp): i64 {
    var b0 = load8(p);
    var b1 = 0;
    var b2 = 0;
    var b3 = 0;
    if (b0 == 0) { return 0; }
    if (b0 < 128) { store64(out_cp, b0); return 1; }
    if (b0 < 224) {
        b1 = load8(p + 1);
        if (b1 == 0) { store64(out_cp, b0); return 1; }
        store64(out_cp, ((b0 & 31) << 6) | (b1 & 63));
        return 2;
    }
    if (b0 < 240) {
        b1 = load8(p + 1);
        if (b1 == 0) { store64(out_cp, b0); return 1; }
        b2 = load8(p + 2);
        if (b2 == 0) { store64(out_cp, b0); return 1; }
        store64(out_cp, ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63));
        return 3;
    }
    b1 = load8(p + 1);
    if (b1 == 0) { store64(out_cp, b0); return 1; }
    b2 = load8(p + 2);
    if (b2 == 0) { store64(out_cp, b0); return 1; }
    b3 = load8(p + 3);
    if (b3 == 0) { store64(out_cp, b0); return 1; }
    store64(out_cp, ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63));
    return 4;
}

# ================================================================
# Growable cstr byte buffer ("SB"). Owns a NUL-terminated backing alloc.
# ================================================================
var SHABDA_SB_DATA = 0;
var SHABDA_SB_LEN  = 8;
var SHABDA_SB_CAP  = 16;
var SHABDA_SB_SIZE = 24;

fn _shabda_sb_new_a(a): i64 {
    var sb = alloc_via(a, SHABDA_SB_SIZE);
    var buf = alloc_via(a, 16);
    store8(buf, 0);
    store64(sb + SHABDA_SB_DATA, buf);
    store64(sb + SHABDA_SB_LEN, 0);
    store64(sb + SHABDA_SB_CAP, 16);
    return sb;
}

# Ensure room for `extra` more bytes plus the NUL terminator. Returns 0, or -1 when
# the larger buffer is refused.
fn _shabda_sb_reserve(sb, extra): i64 {
    return _shabda_sb_reserve_a(default_alloc(), sb, extra);
}

# _shabda_sb_reserve, with every allocation drawn from Allocator `a`.
fn _shabda_sb_reserve_a(a, sb, extra): i64 {
    var len = load64(sb + SHABDA_SB_LEN);
    var cap = load64(sb + SHABDA_SB_CAP);
    var need = len + extra + 1;
    if (need <= cap) { return 0; }
    var newcap = cap;
    while (newcap < need) { newcap = newcap * 2; }
    var old = load64(sb + SHABDA_SB_DATA);
    var buf = alloc_via(a, newcap);
    # alloc returns 0 for a request over ALLOC_MAX (2 GiB) or on exhaustion, and an
    # Allocator may refuse sooner. Leaving the old buffer in place keeps the SB usable
    # at its current capacity; the caller sees a truncated build rather than a write
    # through address 0. Through 3.1.1 this returned 0 here and every push wrote past
    # the old buffer anyway; the pushes now stop on the -1.
    if (buf == 0) { return 0 - 1; }
    memcpy(buf, old, len);
    store8(buf + len, 0);
    store64(sb + SHABDA_SB_DATA, buf);
    store64(sb + SHABDA_SB_CAP, newcap);
    return 0;
}

# Append one raw byte.
fn _shabda_sb_push_byte_a(a, sb, b): i64 {
    if (_shabda_sb_reserve_a(a, sb, 1) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    store8(data + len, b);
    store8(data + len + 1, 0);
    store64(sb + SHABDA_SB_LEN, len + 1);
    return 0;
}

# Append a NUL-terminated cstring.
fn _shabda_sb_push_cstr_a(a, sb, s): i64 {
    var n = strlen(s);
    if (_shabda_sb_reserve_a(a, sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, s, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# Append `n` bytes from a raw pointer.
fn _shabda_sb_push_bytes(sb, p, n): i64 {
    if (_shabda_sb_reserve(sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, p, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# UTF-8-encode a code point and append it.
fn _shabda_sb_push_cp_a(a, sb, cp): i64 {
    if (cp < 128) {
        _shabda_sb_push_byte_a(a, sb, cp);
        return 0;
    }
    if (cp < 2048) {
        _shabda_sb_push_byte_a(a, sb, 192 | (cp >> 6));
        _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
        return 0;
    }
    if (cp < 65536) {
        _shabda_sb_push_byte_a(a, sb, 224 | (cp >> 12));
        _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 6) & 63));
        _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
        return 0;
    }
    _shabda_sb_push_byte_a(a, sb, 240 | (cp >> 18));
    _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 12) & 63));
    _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 6) & 63));
    _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
    return 0;
}

# Finalize: return the cstr pointer (NUL-terminated).
fn _shabda_sb_cstr(sb): cstring {
    return load64(sb + SHABDA_SB_DATA);
}

fn _shabda_sb_len(sb): i64 {
    return load64(sb + SHABDA_SB_LEN);
}

# Last byte of the buffer, or 0 if empty.
fn _shabda_sb_last(sb): i64 {
    var len = load64(sb + SHABDA_SB_LEN);
    if (len == 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    return load8(data + len - 1);
}

# ================================================================
# Code-point predicates (mirror Rust char methods on the paths normalize uses).
# ================================================================
# Rust char::is_alphabetic. Covers the scripts this crate feeds: ASCII letters,
# Latin-1/Extended accented letters, and — for the Hindi/Sanskrit (Devanagari) and
# Arabic G2P engines — those scripts' letters + alphabetic combining marks. Rust's
# Rust char::is_alphabetic() = Alphabetic = L* + Nl + Other_Alphabetic. normalize
# keeps exactly the alphabetic code points, so matching this is load-bearing for
# native-script convert (regression: dropping Devanagari/Arabic here made
# "नमस्ते"/"كتاب" normalize to empty -> 0 events).
#
# L* and Nl come from the stdlib's Unicode 17 GeneralCategory table, so every
# script is covered rather than the five ranges this used to hard-code (which
# silently deleted Greek, Cyrillic, Hebrew, Thai, Han, Hangul ... from normalize
# output). Other_Alphabetic is a derived property the table does not carry, so the
# marks that belong to it stay listed by range below — Devanagari matras /
# anusvara / visarga and Arabic harakat / shadda COUNT, while nukta (093C),
# virama (094D), Vedic tone marks (0951..0954) and sukun (0652) do NOT.
fn _shabda_is_alpha(cp): i64 {
    # ASCII fast path — by far the hottest input, and it skips a binary search.
    if (cp >= 65 && cp <= 90) { return 1; }
    if (cp >= 97 && cp <= 122) { return 1; }
    if (cp < 128) { return 0; }

    # L* (Lu Ll Lt Lm Lo) + Nl.
    var gc = unicode_category(cp);
    if (gc <= GC_LO) { return 1; }
    if (gc == GC_NL) { return 1; }

    # Other_Alphabetic, for the two mark-bearing scripts shabda converts.
    # Devanagari (U+0900..U+0963): matras + anusvara/visarga/chandrabindu.
    if (cp >= 0x0900 && cp <= 0x0963) {
        if (cp == 0x093C) { return 0; }                  # nukta (Mn, not alphabetic)
        if (cp == 0x094D) { return 0; }                  # virama / halant (Mn)
        if (cp >= 0x0951 && cp <= 0x0954) { return 0; }  # Vedic tone/accent marks (Mn)
        return 1;
    }
    # Arabic harakat (fatha/kasra/damma/tanween) + shadda, U+064B..U+0651.
    if (cp >= 0x064B && cp <= 0x0651) { return 1; }
    return 0;
}

# 1 if `cp` is a combining mark (General Category Mn, Mc or Me). normalize keeps a mark
# that follows a letter in the word: the Devanagari virama U+094D and nukta U+093C,
# the Vedic accents, Arabic sukun U+0652, maddah / hamza U+0653..U+0655 and
# superscript alef U+0670 are not Alphabetic, so through 3.1.2 normalize deleted
# them. The rules read them: without the virama Sanskrit धर्मः became धरमः (every
# conjunct gained a vowel), and a nukta letter lost its nukta (NFC keeps ड़ as ड +
# U+093C, U+0958..U+095F being composition exclusions).
fn _shabda_is_mark(cp): i64 {
    if (cp < 0x0300) { return 0; }
    var gc = unicode_category(cp);
    if (gc == GC_MN || gc == GC_MC || gc == GC_ME) { return 1; }
    return 0;
}

fn _shabda_is_ascii_alpha(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }
    if (cp >= 97 && cp <= 122) { return 1; }
    return 0;
}

fn _shabda_is_ascii_upper(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }
    return 0;
}

fn _shabda_is_ascii_digit(cp): i64 {
    if (cp >= 48 && cp <= 57) { return 1; }
    return 0;
}

# Rust char::is_alphanumeric — for our inputs = alpha OR ascii digit.
fn _shabda_is_alnum(cp): i64 {
    if (_shabda_is_alpha(cp) == 1) { return 1; }
    if (_shabda_is_ascii_digit(cp) == 1) { return 1; }
    return 0;
}

# Rust char::is_whitespace — the full Unicode White_Space property (shabda_is_ws_cp
# in L0). Was ASCII-only, which glued NBSP-separated words into one token.
fn _shabda_is_ws(cp): i64 {
    return shabda_is_ws_cp(cp);
}

# Rust char::is_uppercase — the Uppercase property, via the stdlib GeneralCategory
# table. Was ASCII + Latin-1 only, so an ALL-CAPS word in Greek, Cyrillic, or even
# Latin Extended-A (U+0100..U+024F) was silently not emphasised. Residual: Uppercase
# is Lu + Other_Uppercase, and the ~130 Other_Uppercase code points (Roman-numeral
# forms U+2160..216F, circled capitals U+24B6..24CF, some math alphanumerics) are
# not GeneralCategory Lu; none of them is a letter shabda pronounces.
fn _shabda_is_upper(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }      # ASCII fast path
    if (cp < 128) { return 0; }
    return unicode_category(cp) == GC_LU;
}

# Rust `ch.to_lowercase().next().unwrap_or(ch)` — the simple lowercase mapping,
# via the stdlib casefold table. Was ASCII-only, so "CAFÉ" lowered to "cafÉ" and
# every accented capital reached the letter-to-sound rules in the wrong case.
# Residual: Rust takes the first char of the FULL mapping; the two differ only
# where a full mapping expands to several chars, and there the first char is the
# simple mapping anyway (e.g. U+0130 -> 'i' both ways).
fn _shabda_to_lower_cp(cp): i64 {
    if (cp >= 65 && cp <= 90) { return cp + 32; }    # ASCII fast path
    if (cp < 128) { return cp; }
    return unicode_to_lower(cp);
}

# ================================================================
# ASCII-lowercase copy of a cstring (Rust str::to_lowercase for the ASCII-only
# words match_abbreviation / is_pronounceable_acronym pass it — those inputs are
# ASCII, so ASCII folding matches Rust's Unicode folding on them).
# ================================================================
fn _shabda_lower_cstr_a(a, s): cstring {
    var n = strlen(s);
    var out = alloc_via(a, n + 1);
    if (out == 0) { return ""; }
    var i = 0;
    var c = 0;
    while (i < n) {
        c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# cstr starts_with(prefix): 1 if s begins with the bytes of prefix.
fn _shabda_starts_with(s, prefix): i64 {
    var i = 0;
    var pc = 0;
    var sc = 0;
    while (1 == 1) {
        pc = load8(prefix + i);
        if (pc == 0) { return 1; }
        sc = load8(s + i);
        if (sc != pc) { return 0; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# ONES[0..20] / TENS[0..10] number-word tables (static cstrs).
# ================================================================
fn _shabda_ones(i): cstring {
    if (i == 0)  { return "zero"; }
    if (i == 1)  { return "one"; }
    if (i == 2)  { return "two"; }
    if (i == 3)  { return "three"; }
    if (i == 4)  { return "four"; }
    if (i == 5)  { return "five"; }
    if (i == 6)  { return "six"; }
    if (i == 7)  { return "seven"; }
    if (i == 8)  { return "eight"; }
    if (i == 9)  { return "nine"; }
    if (i == 10) { return "ten"; }
    if (i == 11) { return "eleven"; }
    if (i == 12) { return "twelve"; }
    if (i == 13) { return "thirteen"; }
    if (i == 14) { return "fourteen"; }
    if (i == 15) { return "fifteen"; }
    if (i == 16) { return "sixteen"; }
    if (i == 17) { return "seventeen"; }
    if (i == 18) { return "eighteen"; }
    if (i == 19) { return "nineteen"; }
    return "";
}

fn _shabda_tens(i): cstring {
    if (i == 2) { return "twenty"; }
    if (i == 3) { return "thirty"; }
    if (i == 4) { return "forty"; }
    if (i == 5) { return "fifty"; }
    if (i == 6) { return "sixty"; }
    if (i == 7) { return "seventy"; }
    if (i == 8) { return "eighty"; }
    if (i == 9) { return "ninety"; }
    return "";
}

# ================================================================
# number_to_words / hundreds_to_words / tens_to_words — append into an SB.
# Rust builds Vec<String> + join(" "); we append directly with " " separators.
# ================================================================

# Converts 1..99 to words, appended to sb. (Rust tens_to_words)
fn _shabda_tens_to_words_a(a, sb, n): i64 {
    if (n < 20) {
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(n));
        return 0;
    }
    _shabda_sb_push_cstr_a(a, sb, _shabda_tens(n / 10));
    var one = n % 10;
    if (one > 0) {
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(one));
    }
    return 0;
}

# Converts 1..999 to words, appended to sb. (Rust hundreds_to_words)
fn _shabda_hundreds_to_words_a(a, sb, n): i64 {
    var wrote = 0;
    if (n >= 100) {
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(n / 100));
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "hundred");
        wrote = 1;
    }
    var remainder = n % 100;
    if (remainder > 0) {
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_tens_to_words_a(a, sb, remainder);
    }
    return 0;
}

# Converts 0..999,999,999+ to words, appended to sb. (Rust number_to_words)
fn _shabda_number_to_words_a(a, sb, n): i64 {
    if (n == 0) {
        _shabda_sb_push_cstr_a(a, sb, "zero");
        return 0;
    }
    var wrote = 0;
    if (n >= 1000000000) {
        var billions = n / 1000000000;
        _shabda_number_to_words_a(a, sb, billions);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "billion");
        wrote = 1;
    }
    var remainder = n % 1000000000;
    if (remainder >= 1000000) {
        var millions = remainder / 1000000;
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_number_to_words_a(a, sb, millions);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "million");
        wrote = 1;
    }
    remainder = remainder % 1000000;
    if (remainder >= 1000) {
        var thousands = remainder / 1000;
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_number_to_words_a(a, sb, thousands);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "thousand");
        wrote = 1;
    }
    remainder = remainder % 1000;
    if (remainder > 0) {
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_hundreds_to_words_a(a, sb, remainder);
    }
    return 0;
}

# ================================================================
# Number-token parsing. `token` is a cstr of digits + optional single '.'.
# ================================================================

# Parse a cstr of ASCII digits into an integer. Returns the value; sets *ok_out to
# 1 on success (all digits, non-empty, no overflow), 0 on failure -> Rust's
# digits_to_words fallback. Rust used str::parse::<u64>() (accepts up to u64::MAX);
# Cyrius is i64-only, so we accept up to i64::MAX (9223372036854775807) and treat
# genuine i64 overflow as the failure/fallback path. See the DIVERGENCE note in the
# header: values in (i64::MAX, u64::MAX] parse in Rust but overflow here — Rust
# itself renders those as garbage via its billions-only number_to_words, and no
# ported test exercises that range. Bound check: v*10+d overflows i64 when
# v > 922337203685477580, or v == 922337203685477580 && d > 7.
fn _shabda_parse_u64(s, ok_out): i64 {
    var n = strlen(s);
    if (n == 0) { store64(ok_out, 0); return 0; }
    var i = 0;
    var v = 0;
    var c = 0;
    var d = 0;
    while (i < n) {
        c = load8(s + i);
        if (c < 48 || c > 57) { store64(ok_out, 0); return 0; }
        d = c - 48;
        # i64 overflow guard (i64::MAX = 9223372036854775807).
        if (v > 922337203685477580) { store64(ok_out, 0); return 0; }
        if (v == 922337203685477580 && d > 7) { store64(ok_out, 0); return 0; }
        v = v * 10 + d;
        i = i + 1;
    }
    store64(ok_out, 1);
    return v;
}

# Reads digits one by one as fallback for very large numbers. (Rust digits_to_words)
fn _shabda_digits_to_words_a(a, sb, s): i64 {
    var n = strlen(s);
    var i = 0;
    var c = 0;
    var wrote = 0;
    while (i < n) {
        c = load8(s + i);
        if (c >= 48 && c <= 57) {
            if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, _shabda_ones(c - 48));
            wrote = 1;
        }
        i = i + 1;
    }
    return 0;
}

# Expands a number token cstr to words, appended to sb. (Rust expand_number_token)
fn _shabda_expand_number_token_a(a, sb, token): i64 {
    var dot = strchr(token, 46);
    if (dot >= 0) {
        # Decimal: "3.14" -> "three point one four"
        var tlen = strlen(token);
        # integer_part = token[..dot], decimal_part = token[dot+1..]
        var intbuf = alloc_via(a, dot + 1);
        if (intbuf == 0) { return 0; }
        memcpy(intbuf, token, dot);
        store8(intbuf + dot, 0);
        var declen = tlen - dot - 1;
        var decbuf = alloc_via(a, declen + 1);
        if (decbuf == 0) { return 0; }
        memcpy(decbuf, token + dot + 1, declen);
        store8(decbuf + declen, 0);

        if (strlen(intbuf) == 0) {
            _shabda_sb_push_cstr_a(a, sb, "zero");
        } else {
            var ok = alloc_via(a, 8);
            var v = _shabda_parse_u64(intbuf, ok);
            if (load64(ok) == 1) {
                _shabda_number_to_words_a(a, sb, v);
            } else {
                _shabda_digits_to_words_a(a, sb, intbuf);
            }
        }
        _shabda_sb_push_cstr_a(a, sb, " point");
        var i = 0;
        var c = 0;
        while (i < declen) {
            c = load8(decbuf + i);
            if (c >= 48 && c <= 57) {
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, _shabda_ones(c - 48));
            }
            i = i + 1;
        }
        return 0;
    }
    var ok2 = alloc_via(a, 8);
    var v2 = _shabda_parse_u64(token, ok2);
    if (load64(ok2) == 1) {
        _shabda_number_to_words_a(a, sb, v2);
    } else {
        _shabda_digits_to_words_a(a, sb, token);
    }
    return 0;
}

# Collects a contiguous number token from a codepoint vec starting at index `start`.
# Digits go into sb-out buffer; commas between digits skipped; one decimal point.
# Returns bytes... actually returns count of code points consumed; the collected
# token cstr is written via out_tok (a pointer to a cstr slot).
fn _shabda_collect_number_a(a, cps, start, out_tok): i64 {
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = start;
    var has_dot = 0;
    var c = 0;
    var nx = 0;
    var brk = 0;
    while (i < n && brk == 0) {
        c = vec_get(cps, i);
        if (c >= 48 && c <= 57) {
            _shabda_sb_push_byte_a(a, sb, c);
            i = i + 1;
        } elif (c == 44 && i + 1 < n) {
            nx = vec_get(cps, i + 1);
            if (nx >= 48 && nx <= 57) {
                i = i + 1;
            } else {
                brk = 1;
            }
        } elif (c == 46 && has_dot == 0 && i + 1 < n) {
            nx = vec_get(cps, i + 1);
            if (nx >= 48 && nx <= 57) {
                _shabda_sb_push_byte_a(a, sb, 46);
                has_dot = 1;
                i = i + 1;
            } else {
                brk = 1;
            }
        } else {
            brk = 1;
        }
    }
    store64(out_tok, _shabda_sb_cstr(sb));
    return i - start;
}

# ================================================================
# Decode a whole cstring into a vec of code points (Rust `text.chars().collect()`).
# ================================================================
fn _shabda_decode_cps_a(a, text): i64 {
    var cps = vec_new_a(a);
    var p = text;
    var cp = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cp);
    while (adv > 0) {
        _shabda_vec_push_a(a, cps, load64(cp));
        p = p + adv;
        adv = _shabda_utf8_next(p, cp);
    }
    return cps;
}

# ================================================================
# Number readings beyond the cardinal: ordinals, currency, percentages, clock
# times, years, digit strings. Each is how an English reader says the token
# (Chicago Manual of Style 17th ed., ch. 9, for the conventions); through 3.1.2 each
# was read as a plain cardinal with its suffix or sign glued on or dropped: "1st"
# said "onest", "$3.50" "three point five zero", "50%" "fifty", "3:05" "three five",
# "1999" "one thousand nine hundred ninety nine", "10-20" "ten negative twenty".
# ================================================================

# 1 if cps[i] is an ASCII digit (0 past the end).
fn _shabda_cp_digit_at(cps, i): i64 {
    if (i < 0 || i >= vec_len(cps)) { return 0; }
    return _shabda_is_ascii_digit(vec_get(cps, i));
}

# ASCII-lowercase of cps[i], or 0 past the end.
fn _shabda_cp_lower_at(cps, i): i64 {
    if (i < 0 || i >= vec_len(cps)) { return 0; }
    var c = vec_get(cps, i);
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# The ordinal of a cardinal's last word: one -> first, twenty -> twentieth, six -> sixth.
fn _shabda_ordinal_word(w): cstring {
    if (streq(w, "one") == 1) { return "first"; }
    if (streq(w, "two") == 1) { return "second"; }
    if (streq(w, "three") == 1) { return "third"; }
    if (streq(w, "five") == 1) { return "fifth"; }
    if (streq(w, "eight") == 1) { return "eighth"; }
    if (streq(w, "nine") == 1) { return "ninth"; }
    if (streq(w, "twelve") == 1) { return "twelfth"; }
    return 0;
}

# Append the ordinal of `v` ("twenty first", "one hundredth") to sb.
fn _shabda_ordinal_to_words_a(a, sb, v): i64 {
    var tmp = _shabda_sb_new_a(a);
    _shabda_number_to_words_a(a, tmp, v);
    var words = _shabda_sb_cstr(tmp);
    var n = _shabda_sb_len(tmp);
    var ls = n;
    while (ls > 0 && load8(words + ls - 1) != 32) { ls = ls - 1; }
    _shabda_sb_push_bytes_a(a, sb, words, ls);
    var last = words + ls;
    var irregular = _shabda_ordinal_word(last);
    if (irregular != 0) {
        _shabda_sb_push_cstr_a(a, sb, irregular);
        return 0;
    }
    var ln = n - ls;
    if (ln > 0 && load8(last + ln - 1) == 121) {          # -y -> -ieth
        _shabda_sb_push_bytes_a(a, sb, last, ln - 1);
        _shabda_sb_push_cstr_a(a, sb, "ieth");
        return 0;
    }
    _shabda_sb_push_cstr_a(a, sb, last);
    _shabda_sb_push_cstr_a(a, sb, "th");
    return 0;
}

# Append a year 1001..1999 the way it is said: 1999 -> "nineteen ninety nine",
# 1905 -> "nineteen oh five", 1900 -> "nineteen hundred", 1066 -> "ten sixty six".
fn _shabda_year_to_words_a(a, sb, v): i64 {
    _shabda_tens_to_words_a(a, sb, v / 100);
    var lo = v % 100;
    if (lo == 0) {
        _shabda_sb_push_cstr_a(a, sb, " hundred");
    } elif (lo < 10) {
        _shabda_sb_push_cstr_a(a, sb, " oh ");
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(lo));
    } else {
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_tens_to_words_a(a, sb, lo);
    }
    return 0;
}

# 1 if the four-digit number at cps[start..j) is a year by its context: a decade
# plural follows ("1990s"), or BC / AD / BCE / CE, or the word before it is a month
# or one that introduces a date (in, since, from, until, till, by, of, circa, during,
# before, after, around, year). Elsewhere it is a quantity ("1234" "one thousand two
# hundred thirty four").
fn _shabda_year_context_a(a, cps, start, j): i64 {
    var n = vec_len(cps);
    if (_shabda_cp_lower_at(cps, j) == 115 && _shabda_is_alpha(_shabda_cp_lower_at(cps, j + 1)) == 0) { return 1; }
    var k = j;
    while (k < n && _shabda_is_ws(vec_get(cps, k)) == 1) { k = k + 1; }
    if (k > j && k + 1 < n) {
        var e0 = _shabda_cp_lower_at(cps, k);
        var e1 = _shabda_cp_lower_at(cps, k + 1);
        var era = ((e0 == 98) & (e1 == 99)) | ((e0 == 97) & (e1 == 100)) | ((e0 == 99) & (e1 == 101));   # bc ad ce
        if (era == 1 && _shabda_is_alpha(_shabda_cp_lower_at(cps, k + 2)) == 0) { return 1; }
        if (e0 == 98 && e1 == 99 && _shabda_cp_lower_at(cps, k + 2) == 101) { return 1; }                 # bce
    }
    # the word before
    var e = start;
    while (e > 0 && _shabda_is_ws(vec_get(cps, e - 1)) == 1) { e = e - 1; }
    var b = e;
    while (b > 0 && _shabda_is_ascii_alpha(vec_get(cps, b - 1)) == 1) { b = b - 1; }
    var len = e - b;
    if (len == 0 || len > 9 || e == start) { return 0; }
    var w = alloc_via(a, len + 1);
    if (w == 0) { return 0; }
    var q = 0;
    while (q < len) { store8(w + q, _shabda_cp_lower_at(cps, b + q)); q = q + 1; }
    store8(w + len, 0);
    var intro = "in since from until till by of circa during before after around year";
    var months = "january february march april may june july august september october november december";
    if (_shabda_word_in_list(w, intro) == 1) { return 1; }
    return _shabda_word_in_list(w, months);
}

# 1 if cstr `w` is one of the space-separated words of cstr `list`.
fn _shabda_word_in_list(w, list): i64 {
    var n = strlen(w);
    var i = 0;
    while (load8(list + i) != 0) {
        var e = i;
        while (load8(list + e) != 0 && load8(list + e) != 32) { e = e + 1; }
        if (e - i == n) {
            var k = 0;
            while (k < n && load8(list + i + k) == load8(w + k)) { k = k + 1; }
            if (k == n) { return 1; }
        }
        i = e;
        if (load8(list + i) == 32) { i = i + 1; }
    }
    return 0;
}

# Currency units: kind 1 = $, 2 = £, 3 = €. `which` 0 = the main unit, 1 = the
# hundredth; `plural` 1 for anything but exactly one.
fn _shabda_currency_unit(kind, which, plural): cstring {
    if (kind == 2) {
        if (which == 0) { if (plural == 1) { return "pounds"; } return "pound"; }
        if (plural == 1) { return "pence"; }
        return "penny";
    }
    if (which == 1) { if (plural == 1) { return "cents"; } return "cent"; }
    if (kind == 3) { if (plural == 1) { return "euros"; } return "euro"; }
    if (plural == 1) { return "dollars"; }
    return "dollar";
}

# The currency kind of code point `c` ($ £ €), or 0.
fn _shabda_currency_kind(c): i64 {
    if (c == 36) { return 1; }        # $
    if (c == 0xA3) { return 2; }      # £
    if (c == 0x20AC) { return 3; }    # €
    return 0;
}

# If cps[j..] is white space then "thousand" / "million" / "billion" / "trillion"
# and a non-letter, the index after that word; else -1. ("$5 million" is five
# million dollars.)
fn _shabda_magnitude_after_a(a, cps, j): i64 {
    var n = vec_len(cps);
    var k = j;
    while (k < n && _shabda_is_ws(vec_get(cps, k)) == 1) { k = k + 1; }
    if (k == j || k >= n) { return 0 - 1; }
    var e = k;
    while (e < n && _shabda_is_ascii_alpha(vec_get(cps, e)) == 1) { e = e + 1; }
    var len = e - k;
    if (len < 7 || len > 8) { return 0 - 1; }
    var buf = alloc_via(a, 9);
    if (buf == 0) { return 0 - 1; }
    var q = 0;
    while (q < len) { store8(buf + q, _shabda_cp_lower_at(cps, k + q)); q = q + 1; }
    store8(buf + len, 0);
    if (streq(buf, "thousand") == 1 || streq(buf, "million") == 1) { return e; }
    if (streq(buf, "billion") == 1 || streq(buf, "trillion") == 1) { return e; }
    return 0 - 1;
}

# Append the currency reading of number token `tok` (digits, at most one '.') in
# currency `kind`: "$3.50" -> "three dollars and fifty cents", "$1" -> "one dollar",
# "$0.99" -> "ninety nine cents". A fraction of more than two digits is read as a
# decimal, then the unit.
fn _shabda_currency_to_words_a(a, sb, tok, kind): i64 {
    var dot = strchr(tok, 46);
    var tlen = strlen(tok);
    var ok = alloc_via(a, 8);
    if (ok == 0) { return 0; }
    if (dot < 0 || tlen - dot - 1 > 2) {
        var whole = 0;
        if (dot < 0) { whole = _shabda_parse_u64(tok, ok); }
        _shabda_expand_number_token_a(a, sb, tok);
        _shabda_sb_push_byte_a(a, sb, 32);
        var one = (dot < 0) & (load64(ok) == 1) & (whole == 1);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 0, 1 - one));
        return 0;
    }
    var ibuf = alloc_via(a, dot + 1);
    if (ibuf == 0) { return 0; }
    memcpy(ibuf, tok, dot);
    store8(ibuf + dot, 0);
    var units = 0;
    if (dot > 0) { units = _shabda_parse_u64(ibuf, ok); }
    if (dot > 0 && load64(ok) == 0) { _shabda_expand_number_token_a(a, sb, tok); return 0; }
    var cents = load8(tok + dot + 1) - 48;
    if (tlen - dot - 1 == 2) { cents = cents * 10 + (load8(tok + dot + 2) - 48); } else { cents = cents * 10; }
    if (units > 0 || cents == 0) {
        _shabda_number_to_words_a(a, sb, units);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 0, units != 1));
    }
    if (cents > 0) {
        if (units > 0) { _shabda_sb_push_cstr_a(a, sb, " and "); }
        _shabda_tens_to_words_a(a, sb, cents);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 1, cents != 1));
    }
    return 0;
}

# "1990s", "80s": an 's' straight after the number (then no letter) makes its last
# word plural, -y -> -ies ("nineteen nineties", "eighties"). Returns the index after
# the 's', or `j` unchanged.
fn _shabda_decade_plural_a(a, sb, cps, j): i64 {
    if (_shabda_cp_lower_at(cps, j) != 115) { return j; }
    if (_shabda_is_alpha(_shabda_cp_lower_at(cps, j + 1)) == 1) { return j; }
    var len = load64(sb + SHABDA_SB_LEN);
    if (len > 0 && _shabda_sb_last(sb) == 121) {
        store64(sb + SHABDA_SB_LEN, len - 1);
        store8(load64(sb + SHABDA_SB_DATA) + len - 1, 0);
        _shabda_sb_push_cstr_a(a, sb, "ies");
    } else {
        _shabda_sb_push_byte_a(a, sb, 115);
    }
    return j + 1;
}

# Append raw bytes p[0..n) to sb.
fn _shabda_sb_push_bytes_a(a, sb, p, n): i64 {
    if (_shabda_sb_reserve_a(a, sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, p, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# ================================================================
# expand_numbers — public. (Rust expand_numbers)
# ================================================================
#must_use
fn shabda_expand_numbers(text): cstring {
    return _shabda_expand_numbers_a(default_alloc(), text);
}

# shabda_expand_numbers, with every allocation drawn from Allocator `a`.
#
# At each number: a minus sign is a '-' before a digit that does not follow a letter
# or digit ("-5", not "10-20" or "COVID-19"); a currency sign before it gives the
# currency reading; then, in this order, a '%' after it, an ordinal suffix st / nd /
# rd / th, a clock time H:MM, a year 1001..1999 in a date's context, a digit string with a
# leading zero (read digit by digit: "007" "zero zero seven"), else the cardinal or
# decimal reading. A '-' or '–' between two numbers is "to" (a range, CMOS 6.78). A
# letter straight after a number is a separate word ("5km" "five km").
#must_use
fn _shabda_expand_numbers_a(a, text): cstring {
    var cps = _shabda_decode_cps_a(a, text);
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var c = 0;
    var tokslot = alloc_via(a, 8);
    var ok = alloc_via(a, 8);
    var consumed = 0;
    var last = 0;
    while (i < n) {
        c = vec_get(cps, i);
        var start = 0 - 1;
        var neg = 0;
        var cur = 0;
        if (_shabda_is_ascii_digit(c) == 1) {
            start = i;
        } elif (c == 45 && _shabda_cp_digit_at(cps, i + 1) == 1) {
            if (i == 0 || _shabda_is_alnum(vec_get(cps, i - 1)) == 0) {
                neg = 1;
                start = i + 1;
            }
        } elif (_shabda_currency_kind(c) != 0 && _shabda_cp_digit_at(cps, i + 1) == 1) {
            cur = _shabda_currency_kind(c);
            start = i + 1;
        }
        if (start < 0) {
            # A hyphen joining a word to a number ("COVID-19", "F-16") separates them.
            if (c == 45 && _shabda_cp_digit_at(cps, i + 1) == 1) { c = 32; }
            _shabda_sb_push_cp_a(a, sb, c);
            i = i + 1;
            continue;
        }
        consumed = _shabda_collect_number_a(a, cps, start, tokslot);
        var tok = load64(tokslot);
        var j = start + consumed;
        last = _shabda_sb_last(sb);
        if (_shabda_sb_len(sb) != 0 && last != 32) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        if (neg == 1) { _shabda_sb_push_cstr_a(a, sb, "negative "); }
        var tlen = strlen(tok);
        var integer = (strchr(tok, 46) < 0);
        var plain = integer & (tlen == consumed);   # no '.', no grouping comma
        var v = 0;
        store64(ok, 0);
        if (integer == 1) { v = _shabda_parse_u64(tok, ok); }
        var whole = integer & (load64(ok) == 1);    # an integer that fits, grouped or not
        var parsed = plain & whole;
        var s0 = _shabda_cp_lower_at(cps, j);
        var s1 = _shabda_cp_lower_at(cps, j + 1);
        var ord = 0;
        if (whole == 1 && _shabda_is_alpha(_shabda_cp_lower_at(cps, j + 2)) == 0) {
            if ((s0 == 115 && s1 == 116) || (s0 == 110 && s1 == 100)) { ord = 1; }   # st nd
            if ((s0 == 114 && s1 == 100) || (s0 == 116 && s1 == 104)) { ord = 1; }   # rd th
        }
        var clock = 0;
        if (parsed == 1 && consumed <= 2 && v <= 23 && s0 == 58) {                   # ':'
            if (_shabda_cp_digit_at(cps, j + 1) == 1 && _shabda_cp_digit_at(cps, j + 2) == 1) {
                if (_shabda_cp_digit_at(cps, j + 3) == 0 && (s1 - 48) <= 5) { clock = 1; }
            }
        }
        if (cur != 0) {
            var mag = _shabda_magnitude_after_a(a, cps, j);
            if (mag > 0) {
                # "$5 million" -> "five million dollars"
                _shabda_expand_number_token_a(a, sb, tok);
                _shabda_sb_push_byte_a(a, sb, 32);
                var mk = j;
                while (_shabda_is_ws(vec_get(cps, mk)) == 1) { mk = mk + 1; }
                while (mk < mag) { _shabda_sb_push_byte_a(a, sb, _shabda_cp_lower_at(cps, mk)); mk = mk + 1; }
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(cur, 0, 1));
                j = mag;
            } else {
                _shabda_currency_to_words_a(a, sb, tok, cur);
            }
        } elif (s0 == 37) {                                                          # '%'
            _shabda_expand_number_token_a(a, sb, tok);
            _shabda_sb_push_cstr_a(a, sb, " percent");
            j = j + 1;
        } elif (ord == 1) {
            _shabda_ordinal_to_words_a(a, sb, v);
            j = j + 2;
        } elif (clock == 1) {
            var mm = (s1 - 48) * 10 + (vec_get(cps, j + 2) - 48);
            _shabda_number_to_words_a(a, sb, v);
            if (mm > 0 && mm < 10) {
                _shabda_sb_push_cstr_a(a, sb, " oh ");
                _shabda_sb_push_cstr_a(a, sb, _shabda_ones(mm));
            } elif (mm >= 10) {
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_tens_to_words_a(a, sb, mm);
            }
            j = j + 3;
        } elif (parsed == 1 && neg == 0 && consumed == 4 && v >= 1001 && v <= 1999
            && _shabda_year_context_a(a, cps, start, j) == 1) {
            _shabda_year_to_words_a(a, sb, v);
            j = _shabda_decade_plural_a(a, sb, cps, j);
        } elif (plain == 1 && consumed >= 2 && load8(tok) == 48) {
            _shabda_digits_to_words_a(a, sb, tok);
        } else {
            _shabda_expand_number_token_a(a, sb, tok);
            if (whole == 1) { j = _shabda_decade_plural_a(a, sb, cps, j); }
        }
        # A range: "10-20", "1990–1995".
        if (j < n && (vec_get(cps, j) == 45 || vec_get(cps, j) == 0x2013) && _shabda_cp_digit_at(cps, j + 1) == 1) {
            _shabda_sb_push_cstr_a(a, sb, " to");
            j = j + 1;
        } elif (j < n && _shabda_is_alpha(vec_get(cps, j)) == 1) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        i = j;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# Abbreviation table + match_abbreviation. (Rust match_abbreviation)
# Ordered exactly as the Rust ABBREVIATIONS slice.
# ================================================================
fn _shabda_abbr_at(idx, out_expansion): cstring {
    # Returns the abbr cstr for index idx (or 0 past the end); writes expansion.
    if (idx == 0)  { store64(out_expansion, "approximately"); return "approx."; }
    if (idx == 1)  { store64(out_expansion, "boulevard");     return "blvd."; }
    if (idx == 2)  { store64(out_expansion, "captain");       return "capt."; }
    if (idx == 3)  { store64(out_expansion, "colonel");       return "col."; }
    if (idx == 4)  { store64(out_expansion, "corporation");   return "corp."; }
    if (idx == 5)  { store64(out_expansion, "department");    return "dept."; }
    if (idx == 6)  { store64(out_expansion, "government");     return "govt."; }
    if (idx == 7)  { store64(out_expansion, "professor");     return "prof."; }
    if (idx == 8)  { store64(out_expansion, "missus");        return "mrs."; }
    if (idx == 9)  { store64(out_expansion, "mister");        return "mr."; }
    if (idx == 10) { store64(out_expansion, "doctor");        return "dr."; }
    if (idx == 11) { store64(out_expansion, "senior");        return "sr."; }
    if (idx == 12) { store64(out_expansion, "junior");        return "jr."; }
    if (idx == 13) { store64(out_expansion, "saint");         return "st."; }
    if (idx == 14) { store64(out_expansion, "avenue");        return "ave."; }
    if (idx == 15) { store64(out_expansion, "et cetera");     return "etc."; }
    if (idx == 16) { store64(out_expansion, "versus");        return "vs."; }
    if (idx == 17) { store64(out_expansion, "incorporated");  return "inc."; }
    if (idx == 18) { store64(out_expansion, "limited");       return "ltd."; }
    if (idx == 19) { store64(out_expansion, "general");       return "gen."; }
    if (idx == 20) { store64(out_expansion, "sergeant");      return "sgt."; }
    if (idx == 21) { store64(out_expansion, "lieutenant");    return "lt."; }
    if (idx == 22) { store64(out_expansion, "point");         return "pt."; }
    if (idx == 23) { store64(out_expansion, "feet");          return "ft."; }
    if (idx == 24) { store64(out_expansion, "mount");         return "mt."; }
    if (idx == 25) { store64(out_expansion, "for example");   return "e.g."; }
    if (idx == 26) { store64(out_expansion, "that is");       return "i.e."; }
    store64(out_expansion, 0);
    return 0;
}

# Tries to match an abbreviation at the start of `text` (a cstr word).
# Returns bytes_consumed (>0) with *out_exp set to the expansion, or 0 = no match.
fn _shabda_match_abbreviation_a(a, text, out_exp): i64 {
    var lower = _shabda_lower_cstr_a(a, text);
    var idx = 0;
    var abbr = 0;
    var expslot = alloc_via(a, 8);
    var alen = 0;
    var afterc = 0;
    abbr = _shabda_abbr_at(idx, expslot);
    while (abbr != 0) {
        if (_shabda_starts_with(lower, abbr) == 1) {
            alen = strlen(abbr);
            # after = text[abbr.len()..]; must be empty OR start with ws / non-alpha.
            afterc = load8(text + alen);
            if (afterc == 0) {
                store64(out_exp, load64(expslot));
                return alen;
            }
            # Decode the first code point after the abbreviation.
            var cpo = alloc_via(a, 8);
            _shabda_utf8_next(text + alen, cpo);
            var cpa = load64(cpo);
            if (_shabda_is_ws(cpa) == 1 || _shabda_is_alpha(cpa) == 0) {
                store64(out_exp, load64(expslot));
                return alen;
            }
        }
        idx = idx + 1;
        abbr = _shabda_abbr_at(idx, expslot);
    }
    store64(out_exp, 0);
    return 0;
}

# ================================================================
# split_whitespace over a cstr -> vec of cstr words (Rust str::split_whitespace:
# collapses runs, drops leading/trailing ws, no empty tokens).
# ================================================================
fn _shabda_split_ws_a(a, text): i64 {
    var words = vec_new_a(a);
    var cps = _shabda_decode_cps_a(a, text);
    var n = vec_len(cps);
    var i = 0;
    var c = 0;
    var sb = 0;
    var inword = 0;
    while (i < n) {
        c = vec_get(cps, i);
        if (_shabda_is_ws(c) == 1) {
            if (inword == 1) {
                _shabda_vec_push_a(a, words, _shabda_sb_cstr(sb));
                inword = 0;
            }
        } else {
            if (inword == 0) {
                sb = _shabda_sb_new_a(a);
                inword = 1;
            }
            _shabda_sb_push_cp_a(a, sb, c);
        }
        i = i + 1;
    }
    if (inword == 1) {
        _shabda_vec_push_a(a, words, _shabda_sb_cstr(sb));
    }
    return words;
}

# ================================================================
# expand_abbreviations — public. (Rust expand_abbreviations)
# ================================================================
#must_use
fn shabda_expand_abbreviations(text): cstring {
    return _shabda_expand_abbreviations_a(default_alloc(), text);
}

# shabda_expand_abbreviations, with every allocation drawn from Allocator `a`.
#
# Two readings depend on the neighbours. "St." and "Dr." after a capitalized word and
# before a lowercase one (or the end) are "street" / "drive" ("Main St. near"), else
# "saint" / "doctor" ("St. Paul", "Dr. Smith"). And an abbreviation's period also
# ends the sentence when the next word is capitalized or there is none ("pears,
# etc. Then"), so a period is kept after the expansion there for the sentence pause;
# a title (Mr. Mrs. Dr. Prof. Capt. Col. Gen. Sgt. Lt. St. Mt.) is followed by a name,
# so its period never ends one. A dotted initialism ("U.S.", "a.m.") is spelled out as
# shabda_expand_acronyms spells a word ("u-s").
#must_use
fn _shabda_expand_abbreviations_a(a, text): cstring {
    var words = _shabda_split_ws_a(a, text);
    var n = vec_len(words);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var word = 0;
    var expslot = alloc_via(a, 8);
    var consumed = 0;
    while (i < n) {
        if (i > 0) { _shabda_sb_push_byte_a(a, sb, 32); }
        word = vec_get(words, i);
        var prev_cap = 0;
        if (i > 0) { prev_cap = _shabda_is_ascii_upper(load8(vec_get(words, i - 1))); }
        var next_cap = 1;                                  # the end of the text counts
        if (i + 1 < n) { next_cap = _shabda_word_starts_upper(vec_get(words, i + 1)); }
        consumed = _shabda_match_abbreviation_a(a, word, expslot);
        var dotted = 0;
        if (consumed == 0) { dotted = _shabda_dotted_initialism_len(word); }
        if (consumed > 0) {
            var exp = load64(expslot);
            var title = _shabda_abbr_is_title(exp);
            # e.g. and i.e. introduce what follows, so their period ends no sentence,
            # even before a capital ("rock, e.g. Elvis"); "etc. Then" can.
            if (streq(exp, "for example") == 1 || streq(exp, "that is") == 1) { title = 1; }
            var place = prev_cap & ((next_cap == 0) | (i + 1 >= n));
            if (place == 1 && streq(exp, "saint") == 1) { exp = "street"; title = 0; }
            if (place == 1 && streq(exp, "doctor") == 1) { exp = "drive"; title = 0; }
            if (i + 1 >= n && title == 1) { title = 0; }
            _shabda_sb_push_cstr_a(a, sb, exp);
            # Append remaining bytes after the abbreviation: word[consumed..].
            var rest = word + consumed;
            if (title == 0 && next_cap == 1 && load8(rest) == 0) { _shabda_sb_push_byte_a(a, sb, 46); }
            _shabda_sb_push_cstr_a(a, sb, rest);
        } elif (dotted > 0) {
            var k = 0;
            while (k < dotted) {
                if (k > 0) { _shabda_sb_push_byte_a(a, sb, 45); }
                _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(load8(word + k)));
                k = k + 2;
            }
            var drest = word + dotted;
            if (next_cap == 1 && load8(drest) == 0) { _shabda_sb_push_byte_a(a, sb, 46); }
            _shabda_sb_push_cstr_a(a, sb, drest);
        } else {
            _shabda_sb_push_cstr_a(a, sb, word);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# 1 if `word` begins (after any opening quote or bracket) with an uppercase letter.
fn _shabda_word_starts_upper(word): i64 {
    var k = 0;
    var c = load8(word);
    while (c == 34 || c == 39 || c == 40 || c == 91) { k = k + 1; c = load8(word + k); }
    if (c == 0xE2) { return 0; }
    return _shabda_is_ascii_upper(c);
}

# 1 if an abbreviation's expansion is a title, which a name follows.
fn _shabda_abbr_is_title(exp): i64 {
    if (streq(exp, "mister") == 1 || streq(exp, "missus") == 1 || streq(exp, "doctor") == 1) { return 1; }
    if (streq(exp, "professor") == 1 || streq(exp, "captain") == 1 || streq(exp, "colonel") == 1) { return 1; }
    if (streq(exp, "general") == 1 || streq(exp, "sergeant") == 1 || streq(exp, "lieutenant") == 1) { return 1; }
    if (streq(exp, "saint") == 1 || streq(exp, "mount") == 1) { return 1; }
    return 0;
}

# Byte length of a dotted initialism at the start of `word` — two or more letters,
# each followed by '.' ("U.S.", "a.m.", "U.S.A.") — when what follows is not a
# letter, else 0.
fn _shabda_dotted_initialism_len(word): i64 {
    var k = 0;
    while (_shabda_is_ascii_alpha(load8(word + k)) == 1 && load8(word + k + 1) == 46) { k = k + 2; }
    if (k < 4) { return 0; }
    if (_shabda_is_ascii_alpha(load8(word + k)) == 1) { return 0; }
    return k;
}

# ================================================================
# Acronyms. split_trailing_punct / is_acronym / is_pronounceable_acronym.
# ================================================================

# Splits trailing (non-alphanumeric) punctuation from a word. Writes the byte
# offset where trailing punct begins to *out_end (i.e. core = word[..end],
# trailing = word[end..]). (Rust split_trailing_punct)
fn _shabda_split_trailing_punct_a(a, word, out_end): i64 {
    # Decode into (cp, byte_offset) pairs, find the last run of non-alnum at the end.
    var cps = vec_new_a(a);
    var offs = vec_new_a(a);
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var off = 0;
    while (adv > 0) {
        _shabda_vec_push_a(a, cps, load64(cpo));
        _shabda_vec_push_a(a, offs, off);
        off = off + adv;
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    var total = off;
    var m = vec_len(cps);
    # Rust: char_indices().rev().take_while(!alnum).last().map(|(i,_)| i)
    #       .unwrap_or(word.len()). "end" = byte index of the FIRST char (scanning
    # from the tail) in the maximal trailing non-alnum run; if no trailing punct,
    # end = word.len().
    var end = total;
    var j = m - 1;
    var stop = 0;
    while (j >= 0 && stop == 0) {
        if (_shabda_is_alnum(vec_get(cps, j)) == 0) {
            end = vec_get(offs, j);
            j = j - 1;
        } else {
            stop = 1;
        }
    }
    store64(out_end, end);
    return 0;
}

# Returns 1 if `word` (cstr) is an acronym: 3..=5 ASCII-uppercase letters.
# NOTE: Rust checks len (byte length) in 3..=5; core is ASCII so byte==char count.
fn _shabda_is_acronym(word): i64 {
    var n = strlen(word);
    if (n < 3 || n > 5) { return 0; }
    var i = 0;
    var c = 0;
    while (i < n) {
        c = load8(word + i);
        if (c < 65 || c > 90) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _shabda_is_vowel(c): i64 {
    if (c == 97) { return 1; }
    if (c == 101) { return 1; }
    if (c == 105) { return 1; }
    if (c == 111) { return 1; }
    if (c == 117) { return 1; }
    return 0;
}

# Valid onset cluster check: is (a,b) in the Rust valid_onsets table?
fn _shabda_valid_onset(a, b): i64 {
    if (a == 98 && b == 108) { return 1; }  # bl
    if (a == 98 && b == 114) { return 1; }  # br
    if (a == 99 && b == 108) { return 1; }  # cl
    if (a == 99 && b == 114) { return 1; }  # cr
    if (a == 100 && b == 114) { return 1; } # dr
    if (a == 102 && b == 108) { return 1; } # fl
    if (a == 102 && b == 114) { return 1; } # fr
    if (a == 103 && b == 108) { return 1; } # gl
    if (a == 103 && b == 114) { return 1; } # gr
    if (a == 112 && b == 108) { return 1; } # pl
    if (a == 112 && b == 114) { return 1; } # pr
    if (a == 115 && b == 99)  { return 1; } # sc
    if (a == 115 && b == 107) { return 1; } # sk
    if (a == 115 && b == 108) { return 1; } # sl
    if (a == 115 && b == 109) { return 1; } # sm
    if (a == 115 && b == 110) { return 1; } # sn
    if (a == 115 && b == 112) { return 1; } # sp
    if (a == 115 && b == 116) { return 1; } # st
    if (a == 115 && b == 119) { return 1; } # sw
    if (a == 116 && b == 114) { return 1; } # tr
    if (a == 116 && b == 119) { return 1; } # tw
    if (a == 116 && b == 104) { return 1; } # th
    if (a == 115 && b == 104) { return 1; } # sh
    if (a == 99 && b == 104)  { return 1; } # ch
    if (a == 119 && b == 104) { return 1; } # wh
    return 0;
}

# 1 if byte `c` is one of the bytes of cstr `set`.
fn _shabda_byte_in(c, set): i64 {
    var k = 0;
    while (load8(set + k) != 0) {
        if (load8(set + k) == c) { return 1; }
        k = k + 1;
    }
    return 0;
}

# 1 if the two vowel letters (b0, b1) are an English vowel digraph (rain, cause, day,
# sea, see, vein, feud, they, pie, boat, toe, coin, moon, out, boy, cue, suit).
fn _shabda_vowel_digraph(b0, b1): i64 {
    if (b0 == 97) { return _shabda_byte_in(b1, "iuy"); }
    if (b0 == 101) { return _shabda_byte_in(b1, "aeiuy"); }
    if (b0 == 105) { return b1 == 101; }
    if (b0 == 111) { return _shabda_byte_in(b1, "aeiouy"); }
    if (b0 == 117) { return _shabda_byte_in(b1, "ei"); }
    return 0;
}

# 1 if the consonant letters word[s..e) can end an English word: one letter but h j
# q v, or a common two-letter coda (act, gift, cold, golf, milk, film, help, salt,
# lamp, hand, pink, tent, apt, ... , cats, dogs, fish, rich, path, sing).
fn _shabda_letter_coda(word, s, e): i64 {
    var n = e - s;
    if (n == 0) { return 1; }
    var c0 = load8(word + s);
    if (n == 1) { return 1 - _shabda_byte_in(c0, "hjqv"); }
    if (n > 2) { return 0; }
    var c1 = load8(word + s + 1);
    if (c1 == 115) { return _shabda_byte_in(c0, "ptdmnlk"); }      # ps ts ds ms ns ls ks
    if (c1 == 104) { return _shabda_byte_in(c0, "sct"); }          # sh ch th
    if (c1 == 116) { return _shabda_byte_in(c0, "cflnprs"); }      # ct ft lt nt pt rt st
    if (c1 == 100) { return _shabda_byte_in(c0, "lnr"); }          # ld nd rd
    if (c1 == 107) { return _shabda_byte_in(c0, "lnrs"); }         # lk nk rk sk
    if (c1 == 112) { return _shabda_byte_in(c0, "lmrs"); }         # lp mp rp sp
    if (c1 == 109) { return _shabda_byte_in(c0, "lr"); }           # lm rm
    if (c1 == 102) { return _shabda_byte_in(c0, "lr"); }           # lf rf
    if (c1 == 110) { return c0 == 114; }                           # rn
    if (c1 == 103) { return c0 == 110; }                           # ng
    return 0;
}

# 1 if the consonant letters word[s..e) can begin an English word: one letter, a pair
# in the onset table, or s + p / t / c + l / r (split, street, scream).
fn _shabda_letter_onset(word, s, e): i64 {
    var n = e - s;
    if (n <= 1) { return 1; }
    var c0 = load8(word + s);
    var c1 = load8(word + s + 1);
    if (n == 2) { return _shabda_valid_onset(c0, c1); }
    if (n > 3 || c0 != 115) { return 0; }
    var c2 = load8(word + s + 2);
    if (c1 == 112 || c1 == 99) { return (c2 == 108) | (c2 == 114); }
    if (c1 == 116) { return c2 == 114; }
    return 0;
}

# Returns 1 if an acronym (cstr, ASCII upper) is read as a word, 0 if it is spelled.
# (Rust is_pronounceable_acronym.) It is a word when its letters spell a possible
# English word: every vowel run one vowel or a digraph, the consonants before the
# first vowel an onset, those after the last a coda, and each run between two vowels
# a coda + onset. NASA, NATO, SCUBA, LASER, AIDS, OPEC, IKEA, NAFTA are words; IBM
# (bm), ATM (tm), ESPN (spn), FAQ (q), CIA (ia), CEO (eo), NAACP (aa) are spelled.
# A three-letter acronym that starts with a lone vowel is spelled as well (USA, UFO,
# ICU, EPA, IRS, ATV): English reads nearly all of them letter by letter. Through
# 3.1.2 an acronym was a word whenever it started with a vowel or a consonant + vowel,
# so IBM, ATM, ESPN, USA and CIA were read as words.
fn _shabda_is_pronounceable_acronym_a(a, word): i64 {
    var lower = _shabda_lower_cstr_a(a, word);
    var n = strlen(lower);
    if (n == 0) { return 0; }
    var c0 = load8(lower);
    if (n == 3 && _shabda_is_vowel(c0) == 1) {
        if (_shabda_is_vowel(load8(lower + 1)) == 0) { return 0; }
        if (_shabda_vowel_digraph(c0, load8(lower + 1)) == 0) { return 0; }
    }
    var i = 0;
    var runs = 0;          # vowel runs seen
    var cstart = 0;        # start of the current consonant run
    while (i < n) {
        if (_shabda_is_vowel(load8(lower + i)) == 1) {
            var vs = i;
            while (i < n && _shabda_is_vowel(load8(lower + i)) == 1) { i = i + 1; }
            var vlen = i - vs;
            if (vlen > 2) { return 0; }
            if (vlen == 2 && _shabda_vowel_digraph(load8(lower + vs), load8(lower + vs + 1)) == 0) { return 0; }
            if (runs == 0) {
                if (_shabda_letter_onset(lower, cstart, vs) == 0) { return 0; }
            } else {
                # a medial run: some split into coda + onset
                var ok = 0;
                var k = cstart;
                while (k <= vs && ok == 0) {
                    if (_shabda_letter_coda(lower, cstart, k) == 1) { ok = _shabda_letter_onset(lower, k, vs); }
                    k = k + 1;
                }
                if (ok == 0) { return 0; }
            }
            runs = runs + 1;
            cstart = i;
        } else {
            i = i + 1;
        }
    }
    if (runs == 0) { return 0; }
    return _shabda_letter_coda(lower, cstart, n);
}

# ================================================================
# expand_acronyms — public. (Rust expand_acronyms)
# ================================================================
#must_use
fn shabda_expand_acronyms(text): cstring {
    return _shabda_expand_acronyms_a(default_alloc(), text);
}

# shabda_expand_acronyms, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_expand_acronyms_a(a, text): cstring {
    var words = _shabda_split_ws_a(a, text);
    var n = vec_len(words);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var word = 0;
    var endslot = alloc_via(a, 8);
    while (i < n) {
        if (i > 0) { _shabda_sb_push_byte_a(a, sb, 32); }
        word = vec_get(words, i);
        # Split trailing punct: core = word[..end], trailing = word[end..].
        _shabda_split_trailing_punct_a(a, word, endslot);
        var end = load64(endslot);
        var core = alloc_via(a, end + 1);
        if (core == 0) { return _shabda_sb_cstr(sb); }
        memcpy(core, word, end);
        store8(core + end, 0);
        var trailing = word + end;

        if (_shabda_is_acronym(core) == 1) {
            if (_shabda_is_pronounceable_acronym_a(a, core) == 1) {
                # lowercase it as a word.
                var k = 0;
                var clen = strlen(core);
                var cc = 0;
                while (k < clen) {
                    cc = load8(core + k);
                    _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(cc));
                    k = k + 1;
                }
            } else {
                # spell out: "FBI" -> "f-b-i", one token, which the English engine says
                # letter by letter by the letters' names. Through 3.1.2 it was
                # "f b i", three words the rules said as the bare sounds /f b aɪ/.
                var k2 = 0;
                var clen2 = strlen(core);
                var cc2 = 0;
                while (k2 < clen2) {
                    if (k2 > 0) { _shabda_sb_push_byte_a(a, sb, 45); }
                    cc2 = load8(core + k2);
                    _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(cc2));
                    k2 = k2 + 1;
                }
            }
            _shabda_sb_push_cstr_a(a, sb, trailing);
        } else {
            _shabda_sb_push_cstr_a(a, sb, word);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# is_foreign_word / is_latin_extended / strip_diacritics.
# ================================================================
fn _shabda_is_latin_extended(cp): i64 {
    if (cp >= 0x00C0 && cp <= 0x024F) { return 1; }
    return 0;
}

# 1 if `word` contains a non-ASCII Latin letter (accented or extended Latin), suggesting a
# foreign loan word; 0 otherwise. (Rust is_foreign_word)
#must_use
fn shabda_is_foreign_word(word): i64 {
    return _shabda_is_foreign_word_a(default_alloc(), word);
}

# shabda_is_foreign_word, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_is_foreign_word_a(a, word): i64 {
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var cp = 0;
    while (adv > 0) {
        cp = load64(cpo);
        if (_shabda_is_alpha(cp) == 1 && _shabda_is_ascii_alpha(cp) == 0 && _shabda_is_latin_extended(cp) == 1) {
            return 1;
        }
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    return 0;
}

# Map an accented code point to its ASCII base, or return it unchanged.
# (Rust strip_diacritics match arms.)
fn _shabda_strip_cp(cp): i64 {
    # a: á à â ä ã  = 0xE1 0xE0 0xE2 0xE4 0xE3
    if (cp == 0x00E1 || cp == 0x00E0 || cp == 0x00E2 || cp == 0x00E4 || cp == 0x00E3) { return 97; }
    # e: é è ê ë  = 0xE9 0xE8 0xEA 0xEB
    if (cp == 0x00E9 || cp == 0x00E8 || cp == 0x00EA || cp == 0x00EB) { return 101; }
    # i: í ì î ï  = 0xED 0xEC 0xEE 0xEF
    if (cp == 0x00ED || cp == 0x00EC || cp == 0x00EE || cp == 0x00EF) { return 105; }
    # o: ó ò ô ö õ = 0xF3 0xF2 0xF4 0xF6 0xF5
    if (cp == 0x00F3 || cp == 0x00F2 || cp == 0x00F4 || cp == 0x00F6 || cp == 0x00F5) { return 111; }
    # u: ú ù û ü  = 0xFA 0xF9 0xFB 0xFC
    if (cp == 0x00FA || cp == 0x00F9 || cp == 0x00FB || cp == 0x00FC) { return 117; }
    # ñ = 0xF1 -> n
    if (cp == 0x00F1) { return 110; }
    # ç = 0xE7 -> s
    if (cp == 0x00E7) { return 115; }
    return cp;
}

# `word` with accented Latin letters mapped to their ASCII equivalents; other characters pass
# through. (Rust strip_diacritics)
#must_use
fn shabda_strip_diacritics(word): cstring {
    return _shabda_strip_diacritics_a(default_alloc(), word);
}

# shabda_strip_diacritics, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_strip_diacritics_a(a, word): cstring {
    var sb = _shabda_sb_new_a(a);
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var cp = 0;
    while (adv > 0) {
        cp = load64(cpo);
        _shabda_sb_push_cp_a(a, sb, _shabda_strip_cp(cp));
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# normalize / normalize_token_into / normalize_with_emphasis.
# ================================================================

# Append a phrase-boundary marker (SHABDA_COMMA_PAUSE or SHABDA_PERIOD_PAUSE) after
# a space. Consecutive boundaries are one pause: an ellipsis "..." or "?!" makes one
# sentence pause, not three, and a sentence boundary after a comma replaces it.
fn _shabda_push_pause_a(a, sb, marker): i64 {
    var len = _shabda_sb_len(sb);
    var data = _shabda_sb_cstr(sb);
    if (len >= 6 && streq(data + len - 6, SHABDA_PERIOD_PAUSE) == 1) { return 0; }
    if (len >= 6 && streq(data + len - 6, SHABDA_COMMA_PAUSE) == 1) {
        if (streq(marker, SHABDA_PERIOD_PAUSE) == 1) { store8(data + len - 6, 46); }
        return 0;
    }
    _shabda_sb_push_byte_a(a, sb, 32);
    _shabda_sb_push_cstr_a(a, sb, marker);
    return 0;
}

# Process a single token's code points into sb (Rust normalize_token_into).
fn _shabda_normalize_token_into_a(a, token, sb): i64 {
    var cps = _shabda_decode_cps_a(a, token);
    var n = vec_len(cps);
    var i = 0;
    var ch = 0;
    var prev_space = 0;
    var last = 0;
    var inword = 0;
    while (i < n) {
        ch = vec_get(cps, i);
        var mark = inword & _shabda_is_mark(ch);
        if (_shabda_is_alpha(ch) == 1 || ch == 39 || ch == 45 || mark == 1) {
            last = _shabda_sb_last(sb);
            if (prev_space == 1 && _shabda_sb_len(sb) != 0 && last != 32) {
                _shabda_sb_push_byte_a(a, sb, 32);
            }
            _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(ch));
            prev_space = 0;
            inword = (ch != 39) & (ch != 45);
        } elif (ch == 44) {
            _shabda_push_pause_a(a, sb, SHABDA_COMMA_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 46 || ch == 59 || ch == 33 || ch == 63) {
            # '!' and '?' end a sentence as '.' does; through 3.1.2 they made no pause,
            # so "Really? Yes." ran the two sentences together.
            _shabda_push_pause_a(a, sb, SHABDA_PERIOD_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 38) {
            # '&' is the word "and".
            if (_shabda_sb_len(sb) != 0 && _shabda_sb_last(sb) != 32) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, "and");
            prev_space = 1;
            inword = 0;
        } elif (_shabda_is_ws(ch) == 1) {
            prev_space = 1;
            inword = 0;
        }
        i = i + 1;
    }
    return 0;
}

# Normalizes text for G2P: expands abbreviations, acronyms and numbers, lowercases, keeps the
# comma / period pause markers (',' is a comma pause; '.', ';', '!' and '?' a period pause,
# one per run of them), reads '&' as "and", strips the other non-alphabetic characters (keeping
# spaces, apostrophes and hyphens) and collapses runs of spaces. (Rust normalize)
#must_use
fn shabda_normalize(text): cstring {
    return _shabda_normalize_a(default_alloc(), text);
}

# shabda_normalize, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_normalize_a(a, text): cstring {
    var abbr = _shabda_expand_abbreviations_a(a, text);
    var acro = _shabda_expand_acronyms_a(a, abbr);
    var expanded = _shabda_expand_numbers_a(a, acro);

    var cps = _shabda_decode_cps_a(a, expanded);
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var ch = 0;
    var prev_space = 0;
    var inword = 0;          # the last code point kept was a letter or a mark
    while (i < n) {
        ch = vec_get(cps, i);
        var mark = inword & _shabda_is_mark(ch);
        if (_shabda_is_alpha(ch) == 1 || ch == 39 || ch == 45 || mark == 1) {
            if (prev_space == 1 && _shabda_sb_len(sb) != 0) {
                _shabda_sb_push_byte_a(a, sb, 32);
            }
            _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(ch));
            prev_space = 0;
            inword = (ch != 39) & (ch != 45);
        } elif (ch == 44) {
            _shabda_push_pause_a(a, sb, SHABDA_COMMA_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 46 || ch == 59 || ch == 33 || ch == 63) {
            # '!' and '?' end a sentence as '.' does; through 3.1.2 they made no pause,
            # so "Really? Yes." ran the two sentences together.
            _shabda_push_pause_a(a, sb, SHABDA_PERIOD_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 38) {
            # '&' is the word "and".
            if (_shabda_sb_len(sb) != 0 && _shabda_sb_last(sb) != 32) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, "and");
            prev_space = 1;
            inword = 0;
        } elif (_shabda_is_ws(ch) == 1) {
            prev_space = 1;
            inword = 0;
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# As shabda_normalize, but ALL-CAPS words (3+ letters) and *asterisk-wrapped* words are
# wrapped in SHABDA_EMPHASIS_START / SHABDA_EMPHASIS_END, and acronyms are not expanded.
# (Rust normalize_with_emphasis)
#must_use
fn shabda_normalize_with_emphasis(text): cstring {
    return _shabda_normalize_with_emphasis_a(default_alloc(), text);
}

# shabda_normalize_with_emphasis, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_normalize_with_emphasis_a(a, text): cstring {
    var abbr = _shabda_expand_abbreviations_a(a, text);
    var expanded = _shabda_expand_numbers_a(a, abbr);

    var tokens = _shabda_split_ws_a(a, expanded);
    var nt = vec_len(tokens);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var token = 0;
    while (i < nt) {
        if (i > 0 && _shabda_sb_len(sb) != 0) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        token = vec_get(tokens, i);
        var tlen = strlen(token);
        var handled = 0;

        # *asterisk-wrapped* emphasis: token.len() >= 3, starts+ends with '*'.
        if (tlen >= 3 && load8(token) == 42 && load8(token + tlen - 1) == 42) {
            # inner = token[1..len-1].
            var ilen = tlen - 2;
            var inner = alloc_via(a, ilen + 1);
            if (inner == 0) { return _shabda_sb_cstr(sb); }
            memcpy(inner, token + 1, ilen);
            store8(inner + ilen, 0);
            # inner non-empty and all chars alphabetic.
            var icps = _shabda_decode_cps_a(a, inner);
            var im = vec_len(icps);
            var allalpha = 1;
            var k = 0;
            while (k < im) {
                var ic = vec_get(icps, k);
                if (_shabda_is_alpha(ic) == 0 && (k == 0 || _shabda_is_mark(ic) == 0)) { allalpha = 0; }
                k = k + 1;
            }
            if (im > 0 && allalpha == 1) {
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_START);
                _shabda_sb_push_byte_a(a, sb, 32);
                var k2 = 0;
                while (k2 < im) {
                    _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(vec_get(icps, k2)));
                    k2 = k2 + 1;
                }
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_END);
                handled = 1;
            }
        }

        # ALL-CAPS emphasis: >= 3 alphabetic chars, all uppercase.
        if (handled == 0) {
            var tcps = _shabda_decode_cps_a(a, token);
            var tm = vec_len(tcps);
            var alpha_count = 0;
            var all_upper = 1;
            var j = 0;
            var tc = 0;
            while (j < tm) {
                tc = vec_get(tcps, j);
                if (_shabda_is_alpha(tc) == 1) {
                    alpha_count = alpha_count + 1;
                    if (_shabda_is_upper(tc) == 0) { all_upper = 0; }
                }
                j = j + 1;
            }
            if (alpha_count >= 3 && all_upper == 1) {
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_START);
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_normalize_token_into_a(a, token, sb);
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_END);
                handled = 1;
            }
        }

        if (handled == 0) {
            _shabda_normalize_token_into_a(a, token, sb);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# detect_intonation — public. (Rust detect_intonation) Returns a SHABDA_STYPE_* tag.
# ================================================================
#must_use
fn shabda_detect_intonation(text): i64 {
    # Rust str::trim_end — the Unicode White_Space property, not an ASCII subset.
    # A trailing U+00A0 or U+3000 used to hide the terminal '?' / '!' and make every
    # such sentence read as a Statement.
    var n = strlen(text);
    var end = n;
    var m = shabda_ws_len_before(text, 0, end);
    while (m > 0) {
        end = end - m;
        m = shabda_ws_len_before(text, 0, end);
    }
    if (end == 0) { return SHABDA_STYPE_STATEMENT; }
    var lastc = load8(text + end - 1);
    if (lastc == 63) { return SHABDA_STYPE_QUESTION; }
    if (lastc == 33) { return SHABDA_STYPE_EXCLAMATION; }
    return SHABDA_STYPE_STATEMENT;
}

# ================================================================
# sentence_type alias — the spec lists shabda_sentence_type; it is the detector.
# ================================================================
#must_use
fn shabda_sentence_type(text): i64 {
    return shabda_detect_intonation(text);
}

# --- syllable.cyr ---

# syllable.cyr — syllabification of phoneme sequences (Maximal Onset Principle).
#
# Ports rust-old/src/syllable.rs. Splits a phoneme sequence into syllables using
# the Maximal Onset Principle with sonority-based constraints. Each syllable has
# an onset (consonants), a nucleus (vowel/diphthong), and a coda (consonants).
#
# DEP POSITION: svara only. The entry file includes svara.cyr (for
# svara_phoneme_class + SVARA_CLASS_VOWEL/DIPHTHONG + the SVARA_PH_* ordinals)
# and src/error.cyr ABOVE this module. Modules never include each other.
#
# Shabda Syllable layout (24 bytes):
#   [0]  onset   — vec of phoneme ordinals (i64)
#   [8]  nucleus — i64 phoneme ordinal
#   [16] coda    — vec of phoneme ordinals (i64)
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`/`Shabda`-prefixed (flat
# link namespace; coexists with shbdk_ / svara_ / varna / sakshi). Private
# helpers use a leading `_shabda_`.

var SHABDA_SYLLABLE_ONSET   = 0;
var SHABDA_SYLLABLE_NUCLEUS = 8;
var SHABDA_SYLLABLE_CODA    = 16;
var SHABDA_SYLLABLE_SIZE    = 24;

# ---- Syllable constructor / accessors ----------------------------------------
# Build a syllable from an onset vec, a nucleus ordinal, and a coda vec.
#must_use
fn shabda_syllable_new(onset, nucleus, coda): i64 {
    return _shabda_syllable_new_a(default_alloc(), onset, nucleus, coda);
}

# shabda_syllable_new, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_syllable_new_a(a, onset, nucleus, coda): i64 {
    var s = alloc_via(a, SHABDA_SYLLABLE_SIZE);
    store64(s + SHABDA_SYLLABLE_ONSET, onset);
    store64(s + SHABDA_SYLLABLE_NUCLEUS, nucleus);
    store64(s + SHABDA_SYLLABLE_CODA, coda);
    return s;
}

# Onset consonants before the nucleus, a vec of phoneme ordinals.
#must_use
fn shabda_syllable_onset(s): i64 {
    return load64(s + SHABDA_SYLLABLE_ONSET);
}

# Nucleus vowel or diphthong ordinal, the stress-bearing element.
#must_use
fn shabda_syllable_nucleus(s): i64 {
    return load64(s + SHABDA_SYLLABLE_NUCLEUS);
}

# Coda consonants after the nucleus, a vec of phoneme ordinals.
#must_use
fn shabda_syllable_coda(s): i64 {
    return load64(s + SHABDA_SYLLABLE_CODA);
}

# A syllable is "heavy" if it has a non-empty coda OR a diphthong nucleus.
# Heavy syllables attract stress in English.
#must_use
fn shabda_syllable_is_heavy(s): i64 {
    if (vec_len(load64(s + SHABDA_SYLLABLE_CODA)) > 0) { return 1; }
    if (svara_phoneme_class(load64(s + SHABDA_SYLLABLE_NUCLEUS)) == SVARA_CLASS_DIPHTHONG) {
        return 1;
    }
    return 0;
}

# All phonemes in this syllable (onset ++ [nucleus] ++ coda) as a fresh vec.
#must_use
fn shabda_syllable_phonemes(s): i64 {
    var out = vec_new();
    var onset = load64(s + SHABDA_SYLLABLE_ONSET);
    var coda = load64(s + SHABDA_SYLLABLE_CODA);
    var i = 0;
    var n = vec_len(onset);
    while (i < n) {
        vec_push(out, vec_get(onset, i));
        i = i + 1;
    }
    vec_push(out, load64(s + SHABDA_SYLLABLE_NUCLEUS));
    i = 0;
    n = vec_len(coda);
    while (i < n) {
        vec_push(out, vec_get(coda, i));
        i = i + 1;
    }
    return out;
}

# ---- Private helpers ---------------------------------------------------------
# True if a phoneme can serve as a syllable nucleus (Vowel or Diphthong).
fn _shabda_is_nucleus(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL) { return 1; }
    if (c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

# Sonority level of a phoneme (higher = more sonorous), on the usual scale
# (Clements 1990; Parker 2002): obstruent stops / affricates < fricatives < nasals
# < liquids < glides < vowels. Read off svara's class, so every phoneme svara has
# gets a rank:
#   Vowel/Diphthong = 6
#   Approximant (ɹ w j ɻ) = 5
#   Lateral (l ʎ ʟ), trill (r ʀ ʙ), tap / flap (ɾ ɽ ɺ), uvular ʁ = 4
#   Nasal (m n ŋ ɳ ɲ ɴ) = 3
#   Fricative = 2
#   else (plosives, affricates, glottal stop, clicks, ejectives, implosives) = 1
# The taps are liquids here although svara classes them with the plosives (a short
# contact), and so is ʁ although it is a fricative: it is German's (and French's) r,
# and patterns as a liquid in onsets (Wiese 1996, The Phonology of German, ch. 3):
# Frau, Abreise a.bʁaɪ.zə. Through 3.1.2 the tap and every phoneme svara added after
# 1.x ranked 1, so Spanish "otro" /otɾo/ split ot.ɾo, not o.tɾo.
fn _shabda_sonority(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL) { return 6; }
    if (c == SVARA_CLASS_DIPHTHONG) { return 6; }
    if (c == SVARA_CLASS_APPROXIMANT) { return 5; }
    if (c == SVARA_CLASS_LATERAL) { return 4; }
    if (c == SVARA_CLASS_TRILL) { return 4; }
    if (ph == SVARA_PH_TAP_FLAP || ph == SVARA_PH_FLAP_RETRO || ph == SVARA_PH_FLAP_LATERAL) { return 4; }
    if (ph == SVARA_PH_FRIC_UVULAR_R) { return 4; }
    if (c == SVARA_CLASS_NASAL) { return 3; }
    if (c == SVARA_CLASS_FRICATIVE) { return 2; }
    return 1;
}

# Copy v[start..end] into a fresh vec (guarded: empty if start >= end).
fn _shabda_slice_a(a, v, start, end): i64 {
    var out = vec_new_a(a);
    var i = start;
    while (i < end) {
        _shabda_vec_push_a(a, out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# Which onsets a language allows. syllabify's own form has no language: it uses
# English's table when every consonant is an English phoneme and the sonority rule
# otherwise, as shabdakosh's shbdk_syllabify does.
var SHABDA_ONSET_AUTO    = (0 - 1);
var SHABDA_ONSET_ENGLISH = 0;
var SHABDA_ONSET_SSP     = 1;
var SHABDA_ONSET_SPANISH = 2;
var SHABDA_ONSET_SINGLE  = 3;

# The onset rule a SHABDA_LANG_* language uses.
#   English: its onset table (_shabda_syllable_en_onset_range).
#   Spanish: one consonant, or p b t d k g f + l / ɾ, but not tl / dl (RAE,
#     Ortografía 2010: "at-las"). No s + consonant onset: "esto" is es.to.
#   Arabic: one consonant; Arabic has no complex onsets (Watson 2002, Ch. 3).
#   German, Hindi, Sanskrit and anything else: the sonority rule (_shabda_ssp_onset_range).
fn _shabda_onset_mode(language): i64 {
    if (language == SHABDA_LANG_ENGLISH) { return SHABDA_ONSET_ENGLISH; }
    if (language == SHABDA_LANG_SPANISH) { return SHABDA_ONSET_SPANISH; }
    if (language == SHABDA_LANG_ARABIC) { return SHABDA_ONSET_SINGLE; }
    return SHABDA_ONSET_SSP;
}

# 1 if `p` is one of English's consonants (svara 20..45).
fn _shabda_is_english_consonant(p): i64 {
    if (p >= 20 && p <= 45) { return 1; }
    return 0;
}

# 1 if (a, b) is a two-consonant English onset: play, bring, fly; try, dwell, tune;
# clay, grow, quick, cute; three, thwart; shrimp; view, huge, music, new; and s + p t
# k m n l w f j (spin, stay, sky, small, snow, slow, swim, sphere, suit). Not tl / dl
# ("atlas" is at.las), not ŋ-initial, not vl / sr / zl.
fn _shabda_syllable_en_onset2(c0, c1): i64 {
    if (c0 == SVARA_PH_FRIC_S) {
        if (c1 == SVARA_PH_PLOSIVE_P || c1 == SVARA_PH_PLOSIVE_T || c1 == SVARA_PH_PLOSIVE_K) { return 1; }
        if (c1 == SVARA_PH_NASAL_M || c1 == SVARA_PH_NASAL_N || c1 == SVARA_PH_LATERAL_L) { return 1; }
        if (c1 == SVARA_PH_APPROX_W || c1 == SVARA_PH_FRIC_F || c1 == SVARA_PH_APPROX_J) { return 1; }
        return 0;
    }
    var l = (c1 == SVARA_PH_LATERAL_L);
    var r = (c1 == SVARA_PH_APPROX_R);
    var w = (c1 == SVARA_PH_APPROX_W);
    var j = (c1 == SVARA_PH_APPROX_J);
    if (c0 == SVARA_PH_PLOSIVE_P || c0 == SVARA_PH_PLOSIVE_B || c0 == SVARA_PH_FRIC_F) { return l | r | j; }
    if (c0 == SVARA_PH_PLOSIVE_T || c0 == SVARA_PH_PLOSIVE_D) { return r | w | j; }
    if (c0 == SVARA_PH_PLOSIVE_K || c0 == SVARA_PH_PLOSIVE_G) { return l | r | w | j; }
    if (c0 == SVARA_PH_FRIC_TH) { return r | w; }
    if (c0 == SVARA_PH_FRIC_SH) { return r; }
    if (c0 == SVARA_PH_FRIC_V || c0 == SVARA_PH_FRIC_H) { return j; }
    if (c0 == SVARA_PH_NASAL_M || c0 == SVARA_PH_NASAL_N) { return j; }
    return 0;
}

# 1 if v[start..end) is c0 legal English onset: any one consonant but ŋ, c0 pair
# _shabda_syllable_en_onset2 allows, or s + p / t / k + c0 glide or liquid (split, stray,
# scream, squid, spew, stew, skew). English has no onset of four.
fn _shabda_syllable_en_onset_range(v, start, end): i64 {
    var n = end - start;
    if (n <= 0) { return 1; }
    var c0 = vec_get(v, start);
    if (c0 == SVARA_PH_NASAL_NG) { return 0; }
    if (n == 1) { return 1; }
    var c1 = vec_get(v, start + 1);
    if (n == 2) { return _shabda_syllable_en_onset2(c0, c1); }
    if (n == 3) {
        if (c0 != SVARA_PH_FRIC_S) { return 0; }
        var c2 = vec_get(v, start + 2);
        var cl = (c2 == SVARA_PH_LATERAL_L);
        var cr = (c2 == SVARA_PH_APPROX_R);
        var cw = (c2 == SVARA_PH_APPROX_W);
        var cj = (c2 == SVARA_PH_APPROX_J);
        if (c1 == SVARA_PH_PLOSIVE_P) { return cl | cr | cj; }
        if (c1 == SVARA_PH_PLOSIVE_T) { return cr | cj; }
        if (c1 == SVARA_PH_PLOSIVE_K) { return cl | cr | cw | cj; }
        return 0;
    }
    return 0;
}

# 1 if v[start..end) is c0 legal onset by the Sonority Sequencing Principle: sonority
# rises strictly toward the nucleus, except that c0 sibilant (s ʃ ʂ) may precede an
# obstruent (German Stein /ʃt/, Sanskrit sthāna /st/, Hindi spaṣṭ /sp/).
fn _shabda_ssp_onset_range(v, start, end): i64 {
    if (end - start <= 1) { return 1; }
    var k = start;
    var first = vec_get(v, start);
    var sib = (first == SVARA_PH_FRIC_S) | (first == SVARA_PH_FRIC_SH) | (first == SVARA_PH_FRIC_RETRO_S);
    if (sib == 1 && _shabda_sonority(vec_get(v, start + 1)) <= 2) { k = start + 1; }
    while (k + 1 < end) {
        if (_shabda_sonority(vec_get(v, k)) >= _shabda_sonority(vec_get(v, k + 1))) { return 0; }
        k = k + 1;
    }
    return 1;
}

# 1 if v[start..end) is c0 legal Spanish onset (see _shabda_onset_mode).
fn _shabda_es_onset_range(v, start, end): i64 {
    var n = end - start;
    if (n <= 1) { return 1; }
    if (n > 2) { return 0; }
    var c0 = vec_get(v, start);
    var c1 = vec_get(v, start + 1);
    if (c1 != SVARA_PH_LATERAL_L && c1 != SVARA_PH_TAP_FLAP) { return 0; }
    if (c0 == SVARA_PH_PLOSIVE_P || c0 == SVARA_PH_PLOSIVE_B || c0 == SVARA_PH_PLOSIVE_K) { return 1; }
    if (c0 == SVARA_PH_PLOSIVE_G || c0 == SVARA_PH_FRIC_F) { return 1; }
    if (c0 == SVARA_PH_PLOSIVE_T || c0 == SVARA_PH_PLOSIVE_D) { return c1 == SVARA_PH_TAP_FLAP; }
    return 0;
}

# 1 if v[start..end) is a legal onset under onset rule `mode` (SHABDA_ONSET_*).
fn _shabda_onset_ok_range(v, start, end, mode): i64 {
    if (mode == SHABDA_ONSET_SPANISH) { return _shabda_es_onset_range(v, start, end); }
    if (mode == SHABDA_ONSET_SINGLE) { return end - start <= 1; }
    if (mode == SHABDA_ONSET_SSP) { return _shabda_ssp_onset_range(v, start, end); }
    if (mode == SHABDA_ONSET_ENGLISH) { return _shabda_syllable_en_onset_range(v, start, end); }
    # SHABDA_ONSET_AUTO (and any other value): English's table when every consonant is
    # English's, the sonority rule otherwise.
    var k = start;
    while (k < end) {
        if (_shabda_is_english_consonant(vec_get(v, k)) == 0) { return _shabda_ssp_onset_range(v, start, end); }
        k = k + 1;
    }
    return _shabda_syllable_en_onset_range(v, start, end);
}

# Checks if v[start..end) is a legal onset (the language-free rule syllabify uses):
# English's table when every consonant is English, the sonority rule otherwise.
# Through 3.1.2 this was the sonority rule plus an s + obstruent exception for every
# input, which took tl, dl, vl, ŋ- as English onsets ("atlas" a.tlas).
#
# Range-based on purpose. Rust's `is_legal_onset(&cluster[start..])` borrows a
# sub-slice for free; materialising one here (the shape this replaced) made the
# caller below quadratic in BOTH time and permanent bump-allocator bytes.
fn _shabda_is_legal_onset_range(v, start, end): i64 {
    return _shabda_onset_ok_range(v, start, end, SHABDA_ONSET_AUTO);
}

# Whole-vec form (Rust `is_legal_onset(cluster)`).
fn _shabda_is_legal_onset(cluster): i64 {
    return _shabda_is_legal_onset_range(cluster, 0, vec_len(cluster));
}

# Maximum number of consonants from the END of v[start..end) that form a legal
# onset under rule `mode` (SHABDA_ONSET_*). Returns a count.
fn _shabda_max_onset_mode_range(v, start, end, mode): i64 {
    if (end <= start) { return 0; }

    # Try from the full range down to 1 consonant. Rust borrows &cluster[i..]
    # here; we pass the bounds instead of copying.
    var i = start;
    while (i < end) {
        if (_shabda_onset_ok_range(v, i, end, mode) == 1) {
            return end - i;
        }
        i = i + 1;
    }

    # No legal onset at all (only a lone ŋ): the consonants all close the syllable.
    return 0;
}

# Maximum number of consonants from the END of v[start..end) that form a legal
# onset (the language-free rule). Returns a count.
fn _shabda_max_legal_onset_range(v, start, end): i64 {
    return _shabda_max_onset_mode_range(v, start, end, SHABDA_ONSET_AUTO);
}

# Whole-vec form (Rust `max_legal_onset(cluster)`).
fn _shabda_max_legal_onset(cluster): i64 {
    return _shabda_max_legal_onset_range(cluster, 0, vec_len(cluster));
}

# ---- Syllabification ---------------------------------------------------------
# Syllabify a phoneme sequence (vec of ordinals) using the Maximal Onset
# Principle. Returns a vec of Syllable*. Empty input -> empty vec; no vowels ->
# empty vec; else one syllable per nucleus.
#
# The onsets are English's when every consonant is an English phoneme and the
# sonority rule's otherwise; shabda_syllabify_for takes the language.
#must_use
fn shabda_syllabify(phonemes): i64 {
    return _shabda_syllabify_mode_a(default_alloc(), phonemes, SHABDA_ONSET_AUTO);
}

# shabda_syllabify, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_syllabify_a(a, phonemes): i64 {
    return _shabda_syllabify_mode_a(a, phonemes, SHABDA_ONSET_AUTO);
}

# shabda_syllabify with the onsets SHABDA_LANG_* `language` allows: English's
# table, Spanish's obstruent + liquid, Arabic's single consonant, the sonority rule
# for German, Hindi and Sanskrit (see _shabda_onset_mode).
#must_use
fn shabda_syllabify_for(phonemes, language): i64 {
    return _shabda_syllabify_for_a(default_alloc(), phonemes, language);
}

# shabda_syllabify_for, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_syllabify_for_a(a, phonemes, language): i64 {
    return _shabda_syllabify_mode_a(a, phonemes, _shabda_onset_mode(language));
}

# The syllabifier, under onset rule `mode` (SHABDA_ONSET_*).
#must_use
fn _shabda_syllabify_mode_a(a, phonemes, mode): i64 {
    var out = vec_new_a(a);
    var n = vec_len(phonemes);
    if (n == 0) { return out; }

    # Find indices of all nuclei (vowels and diphthongs).
    var nuclei = vec_new_a(a);
    var i = 0;
    while (i < n) {
        if (_shabda_is_nucleus(vec_get(phonemes, i)) == 1) {
            _shabda_vec_push_a(a, nuclei, i);
        }
        i = i + 1;
    }
    var nn = vec_len(nuclei);
    if (nn == 0) { return out; }

    var syl_idx = 0;
    while (syl_idx < nn) {
        var nucleus_idx = vec_get(nuclei, syl_idx);

        # onset_start
        var onset_start = 0;
        if (syl_idx == 0) {
            onset_start = 0;
        } else {
            var prev_nucleus = vec_get(nuclei, syl_idx - 1);
            var cluster_start = prev_nucleus + 1;
            # Rust borrows &phonemes[cluster_start..nucleus_idx]; pass the bounds.
            var onset_len = _shabda_max_onset_mode_range(phonemes, cluster_start, nucleus_idx, mode);
            # PORT-RISK: nucleus_idx - onset_len must not go negative. The cluster
            # spans [cluster_start, nucleus_idx), so onset_len <= that span length,
            # which is <= nucleus_idx; guard anyway.
            if (nucleus_idx >= onset_len) {
                onset_start = nucleus_idx - onset_len;
            } else {
                onset_start = 0;
            }
        }

        var onset = _shabda_slice_a(a, phonemes, onset_start, nucleus_idx);
        var nucleus = vec_get(phonemes, nucleus_idx);

        # coda
        var coda = vec_new_a(a);
        if (syl_idx < nn - 1) {
            var next_nucleus = vec_get(nuclei, syl_idx + 1);
            # Rust borrows &phonemes[nucleus_idx+1..next_nucleus]; pass the bounds.
            var next_onset_len = _shabda_max_onset_mode_range(phonemes, nucleus_idx + 1, next_nucleus, mode);
            # PORT-RISK: next_nucleus - next_onset_len must not go negative. The
            # gap spans [nucleus_idx+1, next_nucleus); next_onset_len <= gap len,
            # so next_nucleus - next_onset_len >= nucleus_idx+1; guard anyway.
            var coda_end = next_nucleus;
            if (next_nucleus >= next_onset_len) {
                coda_end = next_nucleus - next_onset_len;
            } else {
                coda_end = nucleus_idx + 1;
            }
            coda = _shabda_slice_a(a, phonemes, nucleus_idx + 1, coda_end);
        } else {
            coda = _shabda_slice_a(a, phonemes, nucleus_idx + 1, n);
        }

        _shabda_vec_push_a(a, out, _shabda_syllable_new_a(a, onset, nucleus, coda));
        syl_idx = syl_idx + 1;
    }

    return out;
}

# --- heteronym.cyr ---

# heteronym.cyr — heteronym disambiguation via preceding-word context.
#
# Ports rust-old/src/heteronym.rs. Heteronyms are words spelled the same but
# pronounced differently by meaning/part-of-speech ("read" /riːd/ vs /rɛd/).
# Heuristic: if a trigger word appears in the last <=3 preceding words, pick the
# context (non-default) variant; else the default variant.
#
# Depends on svara (phoneme ordinals) + shabdakosh (Pronunciation = a struct
# whose phonemes are a vec of svara ordinals, read via shbdk_pronunciation_phonemes).
# Include position: after src/error.cyr, after the vendored dep chain
# (hisab/goonj/naad/svara/varna/shabdakosh). Modules never include each other.
#
# Rust `struct HeteronymRule { word:&'static str, default_variant:usize,
# context_variant:usize, triggers:&'static [&'static str] }` → an alloc'd block.
#
# HeteronymRule layout (32 bytes):
#   [0]  word            (cstr)
#   [8]  default_variant (i64 index)
#   [16] context_variant (i64 index)
#   [24] triggers        (vec of cstr)
#
# The rule table (Rust's `static HETERONYMS`) is built once via a cached
# lazy-init fn _shabda_het_rules() returning a vec of HeteronymRule*.
#
# The serde twin `HeteronymRuleOwned` (Serialize/Deserialize/PartialEq) has no
# distinct heap shape here — a HeteronymRule already owns cstr/vec fields, so the
# "owned" clone is shabda_heteronym_rule_clone (deep copy) and PartialEq is
# shabda_heteronym_rule_eq (struct-field equality). Their roundtrip lives in the
# test file.
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`/`Shabda`-prefixed.

# ================================================================
# HeteronymRule layout constants.
# ================================================================
var SHABDA_HET_WORD    = 0;
var SHABDA_HET_DEFAULT = 8;
var SHABDA_HET_CONTEXT = 16;
var SHABDA_HET_TRIGGERS = 24;
var SHABDA_HET_SIZE    = 32;

# ================================================================
# Constructor + accessors.
# ================================================================
#must_use
fn shabda_heteronym_rule_new(word, default_variant, context_variant, triggers): i64 {
    var r = alloc(SHABDA_HET_SIZE);
    store64(r + SHABDA_HET_WORD, word);
    store64(r + SHABDA_HET_DEFAULT, default_variant);
    store64(r + SHABDA_HET_CONTEXT, context_variant);
    store64(r + SHABDA_HET_TRIGGERS, triggers);
    return r;
}

# The heteronym word, lowercase.
#must_use
fn shabda_heteronym_rule_word(r): cstring {
    return load64(r + SHABDA_HET_WORD);
}

# Index of the default pronunciation in the dictionary entry.
#must_use
fn shabda_heteronym_rule_default_variant(r): i64 {
    return load64(r + SHABDA_HET_DEFAULT);
}

# Index of the pronunciation used when a trigger word precedes the heteronym.
#must_use
fn shabda_heteronym_rule_context_variant(r): i64 {
    return load64(r + SHABDA_HET_CONTEXT);
}

# The trigger words, a vec of cstrings: one in the preceding context selects context_variant.
#must_use
fn shabda_heteronym_rule_triggers(r): i64 {
    return load64(r + SHABDA_HET_TRIGGERS);
}

# Small helper: build a vec of cstr from a NUL-terminated-list is awkward; instead
# each rule's trigger list is built explicitly in the table init below.

# ================================================================
# Serde twin: HeteronymRuleOwned → a deep clone + struct-field equality.
# clone: fresh block, fresh triggers vec (same cstr contents; cstrs are static).
# ================================================================
#must_use
fn shabda_heteronym_rule_clone(r): i64 {
    var trig = load64(r + SHABDA_HET_TRIGGERS);
    var out_trig = vec_new();
    var i = 0;
    var n = vec_len(trig);
    while (i < n) {
        vec_push(out_trig, vec_get(trig, i));
        i = i + 1;
    }
    return shabda_heteronym_rule_new(
      load64(r + SHABDA_HET_WORD),
      load64(r + SHABDA_HET_DEFAULT),
      load64(r + SHABDA_HET_CONTEXT),
      out_trig);
}

# PartialEq — every field equal (word cstr, both indices, trigger cstr lists).
#must_use
fn shabda_heteronym_rule_eq(a, b): i64 {
    if (streq(load64(a + SHABDA_HET_WORD), load64(b + SHABDA_HET_WORD)) == 0) { return 0; }
    if (load64(a + SHABDA_HET_DEFAULT) != load64(b + SHABDA_HET_DEFAULT)) { return 0; }
    if (load64(a + SHABDA_HET_CONTEXT) != load64(b + SHABDA_HET_CONTEXT)) { return 0; }
    var ta = load64(a + SHABDA_HET_TRIGGERS);
    var tb = load64(b + SHABDA_HET_TRIGGERS);
    if (vec_len(ta) != vec_len(tb)) { return 0; }
    var i = 0;
    var n = vec_len(ta);
    while (i < n) {
        if (streq(vec_get(ta, i), vec_get(tb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# Heteronym table — Rust's `static HETERONYMS`. Built once, cached.
#
# Each rule names its default and its context variant by their index in the
# word's dictionary entry (see the note at the top of _shabda_het_build).
# ================================================================
var _SHABDA_HET_TABLE = 0;

# Build a vec of cstr triggers from a helper; each call takes the words inline.
# (No variadic; we push in the table builder directly.)

fn _shabda_het_build(): i64 {
    var rules = vec_new();

    # Variant indices are positions in the dictionary entry, in shabdakosh's order
    # (CMUdict's): read = [/riːd/, /rɛd/], lead = [/liːd/, /lɛd/], tear = [/tɛr/,
    # /tɪr/], bow = [/baʊ/, /boʊ/], record / refuse / produce = [verb, noun]. Through
    # 3.1.2 these seven rules assumed default-first and picked the other sense in
    # every context ("I will read" said /rɛd/). tests/heteronym.tcyr checks each
    # rule's two picks against the real dictionary.
    #
    # read: default = past /rɛd/, triggers = present /riːd/
    var t_read = vec_new();
    vec_push(t_read, "to");     vec_push(t_read, "will");   vec_push(t_read, "can");
    vec_push(t_read, "could");  vec_push(t_read, "should"); vec_push(t_read, "would");
    vec_push(t_read, "may");    vec_push(t_read, "might");  vec_push(t_read, "must");
    vec_push(t_read, "please"); vec_push(t_read, "let's");  vec_push(t_read, "shall");
    vec_push(rules, shabda_heteronym_rule_new("read", 1, 0, t_read));

    # lead: /liːd/ by default as well as after the verb triggers. The verb and the
    # nouns for a position and a leash are all /liːd/, and far commoner in running
    # text than the metal /lɛd/, which only a following word tells apart ("made of
    # lead", "lead pipe") and the preceding-word window cannot see (3.1.3).
    var t_lead = vec_new();
    vec_push(t_lead, "to");     vec_push(t_lead, "will");   vec_push(t_lead, "can");
    vec_push(t_lead, "could");  vec_push(t_lead, "should"); vec_push(t_lead, "would");
    vec_push(t_lead, "may");    vec_push(t_lead, "might");  vec_push(t_lead, "must");
    vec_push(t_lead, "shall");
    vec_push(rules, shabda_heteronym_rule_new("lead", 0, 0, t_lead));

    # live: default = verb /lɪv/, triggers = adjective /laɪv/
    var t_live = vec_new();
    vec_push(t_live, "a");    vec_push(t_live, "the");  vec_push(t_live, "is");
    vec_push(t_live, "was");  vec_push(t_live, "go");   vec_push(t_live, "went");
    vec_push(t_live, "broadcast"); vec_push(t_live, "on");
    vec_push(rules, shabda_heteronym_rule_new("live", 0, 1, t_live));

    # wind: default = air /wɪnd/, triggers = verb /waɪnd/
    var t_wind = vec_new();
    vec_push(t_wind, "to");    vec_push(t_wind, "will");  vec_push(t_wind, "can");
    vec_push(t_wind, "could"); vec_push(t_wind, "should"); vec_push(t_wind, "would");
    vec_push(t_wind, "must");
    vec_push(rules, shabda_heteronym_rule_new("wind", 0, 1, t_wind));

    # tear: default = eye /tɪər/, triggers = rip /tɛər/
    var t_tear = vec_new();
    vec_push(t_tear, "to");    vec_push(t_tear, "will");  vec_push(t_tear, "can");
    vec_push(t_tear, "could"); vec_push(t_tear, "don't"); vec_push(t_tear, "didn't");
    vec_push(rules, shabda_heteronym_rule_new("tear", 1, 0, t_tear));

    # bow: default = weapon /boʊ/, triggers = bend /baʊ/
    var t_bow = vec_new();
    # Not "a": it precedes the noun in both senses ("a bow and arrow"); "take a bow"
    # is caught by "take" within the window.
    vec_push(t_bow, "to");   vec_push(t_bow, "will"); vec_push(t_bow, "take");
    vec_push(t_bow, "took");
    vec_push(rules, shabda_heteronym_rule_new("bow", 1, 0, t_bow));

    # close: default = verb /kloʊz/, triggers = adjective /kloʊs/
    var t_close = vec_new();
    vec_push(t_close, "a");   vec_push(t_close, "the"); vec_push(t_close, "too");
    vec_push(t_close, "very"); vec_push(t_close, "so"); vec_push(t_close, "how");
    vec_push(t_close, "is");  vec_push(t_close, "was"); vec_push(t_close, "get");
    vec_push(rules, shabda_heteronym_rule_new("close", 0, 1, t_close));

    # record: default = noun /rɛkərd/, triggers = verb /rɪkɔːrd/
    var t_record = vec_new();
    vec_push(t_record, "to");     vec_push(t_record, "will");   vec_push(t_record, "can");
    vec_push(t_record, "could");  vec_push(t_record, "should"); vec_push(t_record, "would");
    vec_push(t_record, "must");   vec_push(t_record, "please");
    vec_push(rules, shabda_heteronym_rule_new("record", 1, 0, t_record));

    # present: default = noun /prɛzənt/, triggers = verb /prɪzɛnt/
    var t_present = vec_new();
    vec_push(t_present, "to");     vec_push(t_present, "will");   vec_push(t_present, "can");
    vec_push(t_present, "could");  vec_push(t_present, "should"); vec_push(t_present, "would");
    vec_push(t_present, "must");   vec_push(t_present, "shall");
    vec_push(rules, shabda_heteronym_rule_new("present", 0, 1, t_present));

    # refuse: default = noun /rɛfjuːs/, triggers = verb /rɪfjuːz/
    var t_refuse = vec_new();
    vec_push(t_refuse, "to");     vec_push(t_refuse, "will");   vec_push(t_refuse, "can");
    vec_push(t_refuse, "could");  vec_push(t_refuse, "should"); vec_push(t_refuse, "would");
    vec_push(t_refuse, "must");   vec_push(t_refuse, "i");
    vec_push(rules, shabda_heteronym_rule_new("refuse", 1, 0, t_refuse));

    # produce: default = noun /proʊduːs/, triggers = verb /prədjuːs/
    var t_produce = vec_new();
    vec_push(t_produce, "to");     vec_push(t_produce, "will");   vec_push(t_produce, "can");
    vec_push(t_produce, "could");  vec_push(t_produce, "should"); vec_push(t_produce, "would");
    vec_push(t_produce, "must");
    vec_push(rules, shabda_heteronym_rule_new("produce", 1, 0, t_produce));

    # object: default = noun /ɒbdʒɛkt/, triggers = verb /əbdʒɛkt/
    var t_object = vec_new();
    vec_push(t_object, "to");     vec_push(t_object, "will");   vec_push(t_object, "can");
    vec_push(t_object, "could");  vec_push(t_object, "should"); vec_push(t_object, "would");
    vec_push(t_object, "must");   vec_push(t_object, "i");      vec_push(t_object, "we");
    vec_push(t_object, "they");
    vec_push(rules, shabda_heteronym_rule_new("object", 0, 1, t_object));

    # project: default = noun /prɒdʒɛkt/, triggers = verb /prədʒɛkt/
    var t_project = vec_new();
    vec_push(t_project, "to");     vec_push(t_project, "will");   vec_push(t_project, "can");
    vec_push(t_project, "could");  vec_push(t_project, "should"); vec_push(t_project, "would");
    vec_push(t_project, "must");
    vec_push(rules, shabda_heteronym_rule_new("project", 0, 1, t_project));

    # permit: default = noun /pɜːrmɪt/, triggers = verb /pərmɪt/
    var t_permit = vec_new();
    vec_push(t_permit, "to");     vec_push(t_permit, "will");   vec_push(t_permit, "can");
    vec_push(t_permit, "could");  vec_push(t_permit, "should"); vec_push(t_permit, "would");
    vec_push(t_permit, "must");   vec_push(t_permit, "not");
    vec_push(rules, shabda_heteronym_rule_new("permit", 0, 1, t_permit));

    # desert: default = noun /dɛzərt/, triggers = verb /dɪzɜːrt/
    var t_desert = vec_new();
    vec_push(t_desert, "to");     vec_push(t_desert, "will");   vec_push(t_desert, "can");
    vec_push(t_desert, "could");  vec_push(t_desert, "should"); vec_push(t_desert, "would");
    vec_push(t_desert, "must");   vec_push(t_desert, "don't");
    vec_push(rules, shabda_heteronym_rule_new("desert", 0, 1, t_desert));

    # minute: default = time /mɪnɪt/, triggers = adjective /maɪnjuːt/
    var t_minute = vec_new();
    # Degree words only. "a" and "the" precede the noun far more often than the
    # adjective, so "wait a minute" said /maɪˈnjuːt/.
    vec_push(t_minute, "very");
    vec_push(t_minute, "most"); vec_push(t_minute, "so");  vec_push(t_minute, "how");
    vec_push(t_minute, "extremely");
    vec_push(rules, shabda_heteronym_rule_new("minute", 0, 1, t_minute));

    # bass: default = music /beɪs/, triggers = fish /bæs/
    var t_bass = vec_new();
    # Not "a" / "the": both senses take them ("the bass guitar" said the fish).
    vec_push(t_bass, "caught");
    vec_push(t_bass, "fishing"); vec_push(t_bass, "lake"); vec_push(t_bass, "sea");
    vec_push(t_bass, "striped"); vec_push(t_bass, "largemouth");
    vec_push(rules, shabda_heteronym_rule_new("bass", 0, 1, t_bass));

    # wound: default = injury /wuːnd/, triggers = past of wind /waʊnd/
    var t_wound = vec_new();
    vec_push(t_wound, "he");  vec_push(t_wound, "she"); vec_push(t_wound, "they");
    vec_push(t_wound, "i");   vec_push(t_wound, "we");  vec_push(t_wound, "had");
    vec_push(t_wound, "was"); vec_push(t_wound, "were");
    vec_push(rules, shabda_heteronym_rule_new("wound", 0, 1, t_wound));

    # dove: default = bird /dʌv/, triggers = past of dive /doʊv/
    var t_dove = vec_new();
    vec_push(t_dove, "he");  vec_push(t_dove, "she"); vec_push(t_dove, "they");
    vec_push(t_dove, "i");   vec_push(t_dove, "we");  vec_push(t_dove, "then");
    vec_push(t_dove, "and");
    vec_push(rules, shabda_heteronym_rule_new("dove", 0, 1, t_dove));

    # sow: default = verb plant /soʊ/, triggers = female pig /saʊ/
    var t_sow = vec_new();
    vec_push(t_sow, "a");   vec_push(t_sow, "the"); vec_push(t_sow, "old");
    vec_push(t_sow, "fat");
    vec_push(rules, shabda_heteronym_rule_new("sow", 0, 1, t_sow));

    return rules;
}

# Cached lazy-init accessor for the rule table (vec of HeteronymRule*).
#must_use
fn _shabda_het_rules(): i64 {
    if (_SHABDA_HET_TABLE == 0) {
        _SHABDA_HET_TABLE = _shabda_het_build();
    }
    return _SHABDA_HET_TABLE;
}

# ================================================================
# lookup(word) -> rule* | 0  (Rust Option::None → 0).
# ================================================================
#must_use
fn shabda_heteronym_lookup(word): i64 {
    var rules = _shabda_het_rules();
    var i = 0;
    var n = vec_len(rules);
    while (i < n) {
        var r = vec_get(rules, i);
        if (streq(load64(r + SHABDA_HET_WORD), word) == 1) {
            return r;
        }
        i = i + 1;
    }
    return 0;
}

# 1 if `word` (cstr) is present in the trigger vec, else 0.
#must_use
fn _shabda_het_triggers_contain(triggers, word): i64 {
    var i = 0;
    var n = vec_len(triggers);
    while (i < n) {
        if (streq(vec_get(triggers, i), word) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# select_variant(rule, preceding_words) -> variant index.
#
# Rust: scan the LAST <=3 preceding words (reverse .take(3)), lowercased; if any
# matches a trigger, return context_variant, else default_variant.
# preceding_words is a vec of cstr.
# ================================================================
#must_use
fn shabda_select_variant(rule, preceding_words): i64 {
    return _shabda_select_variant_a(default_alloc(), rule, preceding_words);
}

# shabda_select_variant, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_select_variant_a(a, rule, preceding_words): i64 {
    var triggers = load64(rule + SHABDA_HET_TRIGGERS);
    var len = vec_len(preceding_words);
    # last <=3, iterated from the nearest preceding word backwards
    var count = 0;
    var i = len - 1;
    while (i >= 0) {
        if (count >= 3) { return load64(rule + SHABDA_HET_DEFAULT); }
        var lower = _shabda_ascii_lower_a(a, vec_get(preceding_words, i));
        if (_shabda_het_triggers_contain(triggers, lower) == 1) {
            return load64(rule + SHABDA_HET_CONTEXT);
        }
        count = count + 1;
        i = i - 1;
    }
    return load64(rule + SHABDA_HET_DEFAULT);
}

# ================================================================
# select_phonemes(rule, preceding_words, pronunciations) -> phonemes vec.
#
# pronunciations = a vec of shabdakosh Pronunciation* (each read via
# shbdk_pronunciation_phonemes). Bounds-checked: if the selected variant index is
# out of range, fall back to pronunciations[0] (matches Rust).
# ================================================================
#must_use
fn shabda_select_phonemes(rule, preceding_words, pronunciations): i64 {
    return _shabda_select_phonemes_a(default_alloc(), rule, preceding_words, pronunciations);
}

# shabda_select_phonemes, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_select_phonemes_a(a, rule, preceding_words, pronunciations): i64 {
    var n = vec_len(pronunciations);
    # DIVERGENCE (hardening). Rust's fallback arm is `pronunciations[0]`, which
    # panics on an empty slice. Here vec_get(v, 0) on an empty vec reaches
    # lib/vec.cyr's _vec_die() -> syscall(SYS_EXIT, 1), which does not unwind and
    # does not return a code — it terminates the HOST process, so a consumer like
    # dhvani would lose its audio daemon. An empty pronunciation vec is reachable:
    # shbdk_dict_lookup_all returns shbdk_dict_entry_all(e) verbatim, and a
    # caller-built entry can hold zero pronunciations. Returning an empty vec keeps
    # the crate's zero-panic contract (CLAUDE.md) and leaves the caller with
    # "no phonemes", which its rules fallback already handles.
    if (n == 0) { return vec_new_a(a); }
    return shbdk_pronunciation_phonemes(_shabda_select_pronunciation_a(a, rule, preceding_words, pronunciations));
}

# The Pronunciation* select_phonemes reads: the selected variant, or
# pronunciations[0] when the index is out of range, or 0 when there is none. The
# engine reads the dictionary's stress from it (shabdakosh 3.2.0).
#must_use
fn _shabda_select_pronunciation_a(a, rule, preceding_words, pronunciations): i64 {
    var n = vec_len(pronunciations);
    if (n == 0) { return 0; }
    var idx = _shabda_select_variant_a(a, rule, preceding_words);
    if (idx < n) { return vec_get(pronunciations, idx); }
    return vec_get(pronunciations, 0);
}

# --- ssml.cyr ---

# ssml.cyr — SSML subset parser for speech synthesis markup.
#
# Ports rust-old/src/ssml.rs (the hand-rolled, no_std+alloc SSML subset parser —
# no XML crate). Parses <speak>/<break>/<emphasis>/<prosody>/<phoneme> into a
# flat vec of SsmlNode heap blocks. Self-contained: the Rust module's only dep is
# serde; here the codec is hand-written integer/tag round-trips (§ serde below).
#
# DEP POSITION: needs only src/error.cyr (L0) above it, plus the stdlib string/
# str/vec/math/alloc modules (auto-resolved from cyrius.cyml). Modules never
# include each other — the entry file (src/main.cyr / tests/ssml.tcyr) orders the
# includes.
#
# The parser walks the raw input cstring by BYTE INDEX exactly like the Rust
# (`input.as_bytes()[pos]`), so all offset arithmetic stays valid. '<' == 60,
# '>' == 62, '/' == 47.
#
# ---------------------------------------------------------------- byte layouts
# SsmlNode = a tagged heap block. Word [0] is the tag; payload follows.
#   Text     : alloc(16)  [0]=SHABDA_SSML_TEXT     [8]=text (Str fat pointer)
#   Break    : alloc(16)  [0]=SHABDA_SSML_BREAK    [8]=duration_ms (i64)
#   Emphasis : alloc(24)  [0]=SHABDA_SSML_EMPHASIS [8]=level (EmphasisLevel tag)
#                                                  [16]=children (vec of SsmlNode*)
#   Prosody  : alloc(32)  [0]=SHABDA_SSML_PROSODY  [8]=rate (SpeakingRate tag or
#                                                       SHABDA_RATE_NONE sentinel)
#                                                  [16]=children (vec of SsmlNode*)
#                                                  [24]=percent (f64 bits; read when
#                                                       rate is SHABDA_RATE_PERCENT)
# Text payload is a Str (str.cyr fat pointer {data,len}); str_cstr() yields a cstr
# for assert_streq. EmphasisLevel + SpeakingRate are Rust Copy enums -> int tags.
# Option<SpeakingRate> -> SHABDA_RATE_NONE (== -1) sentinel in the rate slot.
#
# shabda_ssml_parse(input) -> vec of SsmlNode* | 0 on parse error (Rust's Err).
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`/`Shabda`-prefixed (flat
# link namespace; coexists with shbdk_ / svara_ / varna / sakshi).

# ================================================================
# Node tags (was `enum SsmlNode`, #[non_exhaustive]). Stored at block offset 0.
# ================================================================
var SHABDA_SSML_TEXT     = 0;
var SHABDA_SSML_BREAK    = 1;
var SHABDA_SSML_EMPHASIS = 2;
var SHABDA_SSML_PROSODY  = 3;

# Node block offsets.
var SHABDA_SSML_OFF_TAG      = 0;
var SHABDA_SSML_OFF_TEXT     = 8;    # Text: Str payload
var SHABDA_SSML_OFF_DURATION = 8;    # Break: duration_ms
var SHABDA_SSML_OFF_LEVEL    = 8;    # Emphasis: level tag
var SHABDA_SSML_OFF_RATE     = 8;    # Prosody: rate tag/sentinel
var SHABDA_SSML_OFF_CHILDREN = 16;   # Emphasis/Prosody: children vec
var SHABDA_SSML_OFF_PERCENT  = 24;   # Prosody: rate percentage (f64 bits)

# EmphasisLevel (was `enum EmphasisLevel`, #[non_exhaustive], Copy). Int tags.
var SHABDA_EMPH_STRONG   = 0;
var SHABDA_EMPH_MODERATE = 1;
var SHABDA_EMPH_REDUCED  = 2;
# level="none" (SSML 1.1 §3.2.2): "used to prevent the synthesis processor from
# emphasizing words that it might typically emphasize". Through 3.1.2 it parsed as
# the default, moderate.
var SHABDA_EMPH_NONE     = 3;

# SpeakingRate (was `enum SpeakingRate`, #[non_exhaustive], Copy). Int tags.
var SHABDA_RATE_XSLOW  = 0;
var SHABDA_RATE_SLOW   = 1;
var SHABDA_RATE_MEDIUM = 2;
var SHABDA_RATE_FAST   = 3;
var SHABDA_RATE_XFAST  = 4;
# rate="N%" (SSML 1.1 §3.2.4): "a non-negative percentage ... acts as a multiplier of
# the default rate". The percentage rides the node's percent slot.
var SHABDA_RATE_PERCENT = 5;
# Option<SpeakingRate>::None sentinel (Rust `rate: Option<SpeakingRate>`).
var SHABDA_RATE_NONE = (0 - 1);

# ================================================================
# SpeakingRate::wpm — approximate words-per-minute. Rust returns f32; promoted to
# f64 (math is f64-only). Values match ssml.rs EXACTLY: 75/100/150/200/250.
# Returns an f64 bit pattern.
# ================================================================
#must_use
fn shabda_speaking_rate_wpm(rate): i64 {
    if (rate == SHABDA_RATE_XSLOW)  { return f64_from(75); }
    if (rate == SHABDA_RATE_SLOW)   { return f64_from(100); }
    if (rate == SHABDA_RATE_MEDIUM) { return f64_from(150); }
    if (rate == SHABDA_RATE_FAST)   { return f64_from(200); }
    if (rate == SHABDA_RATE_XFAST)  { return f64_from(250); }
    if (rate == SHABDA_RATE_PERCENT) { return f64_from(150); }   # the rate the percentage scales
    return f64_from(0);              # #[non_exhaustive] fallback
}

# ================================================================
# Node constructors.
# ================================================================
#must_use
fn shabda_ssml_text(text_str): i64 {
    var p = alloc(16);
    store64(p + SHABDA_SSML_OFF_TAG, SHABDA_SSML_TEXT);
    store64(p + SHABDA_SSML_OFF_TEXT, text_str);
    return p;
}

# A Break node of `duration_ms` milliseconds.
#must_use
fn shabda_ssml_break(duration_ms): i64 {
    var p = alloc(16);
    store64(p + SHABDA_SSML_OFF_TAG, SHABDA_SSML_BREAK);
    store64(p + SHABDA_SSML_OFF_DURATION, duration_ms);
    return p;
}

# An Emphasis node: `level` is a SHABDA_EMPH_* tag, `children` a vec of SsmlNode*.
#must_use
fn shabda_ssml_emphasis(level, children): i64 {
    var p = alloc(24);
    store64(p + SHABDA_SSML_OFF_TAG, SHABDA_SSML_EMPHASIS);
    store64(p + SHABDA_SSML_OFF_LEVEL, level);
    store64(p + SHABDA_SSML_OFF_CHILDREN, children);
    return p;
}

# A Prosody node: `rate` is a SHABDA_RATE_* tag or SHABDA_RATE_NONE, `children` a vec of SsmlNode*.
#must_use
fn shabda_ssml_prosody(rate, children): i64 {
    var p = alloc(32);
    store64(p + SHABDA_SSML_OFF_TAG, SHABDA_SSML_PROSODY);
    store64(p + SHABDA_SSML_OFF_RATE, rate);
    store64(p + SHABDA_SSML_OFF_CHILDREN, children);
    store64(p + SHABDA_SSML_OFF_PERCENT, f64_from(100));
    return p;
}

# A Prosody node at `percent` (f64 bits) of the default rate: rate SHABDA_RATE_PERCENT.
#must_use
fn shabda_ssml_prosody_percent(percent, children): i64 {
    var p = shabda_ssml_prosody(SHABDA_RATE_PERCENT, children);
    store64(p + SHABDA_SSML_OFF_PERCENT, percent);
    return p;
}

# ================================================================
# Node accessors.
# ================================================================
#must_use
fn shabda_ssml_node_tag(node): i64 { return load64(node + SHABDA_SSML_OFF_TAG); }

# A Text node's payload, a Str. These accessors do not check the tag: read only the slot
# that shabda_ssml_node_tag says the node has.
#must_use
fn shabda_ssml_node_text(node): i64 { return load64(node + SHABDA_SSML_OFF_TEXT); }

# A Break node's duration in milliseconds.
#must_use
fn shabda_ssml_node_duration(node): i64 { return load64(node + SHABDA_SSML_OFF_DURATION); }

# An Emphasis node's SHABDA_EMPH_* level.
#must_use
fn shabda_ssml_node_level(node): i64 { return load64(node + SHABDA_SSML_OFF_LEVEL); }

# A Prosody node's SHABDA_RATE_* rate, or SHABDA_RATE_NONE.
#must_use
fn shabda_ssml_node_rate(node): i64 { return load64(node + SHABDA_SSML_OFF_RATE); }

# A Prosody node's rate as a percentage of the default (f64 bits): the N of rate="N%"
# when the rate is SHABDA_RATE_PERCENT, 100 otherwise.
#must_use
fn shabda_ssml_node_rate_percent(node): i64 { return load64(node + SHABDA_SSML_OFF_PERCENT); }

# An Emphasis or Prosody node's children, a vec of SsmlNode*.
#must_use
fn shabda_ssml_node_children(node): i64 { return load64(node + SHABDA_SSML_OFF_CHILDREN); }

# ================================================================
# Byte-scan primitives (over a raw cstring, mirroring `input.as_bytes()`).
# ================================================================
# Rust str::trim over input[start..end). Writes the trimmed bounds through the two
# out-params. Codepoint-aware: Rust trims the Unicode White_Space property, so an
# attribute list separated from its tag name by U+00A0 — or a text run padded with
# U+3000 — must trim exactly as the oracle does.
fn _shabda_ssml_trim(input, start, end, out_s, out_e): i64 {
    var s = start;
    var e = end;
    var n = shabda_ws_len_at(input, s, e);
    while (n > 0) {
        s = s + n;
        n = shabda_ws_len_at(input, s, e);
    }
    var m = shabda_ws_len_before(input, s, e);
    while (m > 0) {
        e = e - m;
        m = shabda_ws_len_before(input, s, e);
    }
    store64(out_s, s);
    store64(out_e, e);
    return 0;
}

# find_tag_end: index of the '>' closing the tag starting at `pos` ('<'),
# scanning from pos+1. Returns -1 when none (Rust's Option::None).
#must_use
fn _shabda_find_tag_end(input, len, pos): i64 {
    var i = pos + 1;
    while (i < len) {
        if (load8(input + i) == 62) { return i; }   # '>'
        i = i + 1;
    }
    return (0 - 1);
}

# Byte-compare bytes[a_off..a_off+n] against cstring `lit` (which must be exactly
# n long). 1 if equal.
#must_use
fn _shabda_slice_eq_cstr(input, a_off, n, lit): i64 {
    var i = 0;
    while (i < n) {
        if (load8(lit + i) == 0) { return 0; }
        if (load8(input + a_off + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    if (load8(lit + n) != 0) { return 0; }
    return 1;
}

# Does bytes[off..] start with cstring `lit`? (Rust str::starts_with)
#must_use
fn _shabda_ssml_starts_with(input, len, off, lit): i64 {
    var i = 0;
    while (load8(lit + i) != 0) {
        if (off + i >= len) { return 0; }
        if (load8(input + off + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# Attribute extraction (was extract_attr). Scans the tag's attribute region
# [attr_start, attr_end) inside `input` for `name = "..."` or `name = '...'` and
# returns the value, entity references replaced, as a fresh Str; 0 (Rust None) when
# it is absent. XML 1.0 (§3.1, Eq) allows white space around the '=', and the name
# must be a whole attribute name: through 3.1.2 `time = "1s"` was missed and
# `xtime="1s"` was read as time.
# ================================================================
#must_use
fn _shabda_extract_attr(input, attr_start, attr_end, name): i64 {
    var nlen = strlen(name);
    var i = attr_start;
    while (i + nlen <= attr_end) {
        var boundary = 1;
        if (i > attr_start && shabda_ws_len_before(input, attr_start, i) == 0) { boundary = 0; }
        if (boundary == 1 && _shabda_slice_eq_at(input, i, name, nlen) == 1) {
            var k = i + nlen;
            while (k < attr_end && shabda_ws_len_at(input, k, attr_end) > 0) {
                k = k + shabda_ws_len_at(input, k, attr_end);
            }
            if (k < attr_end && load8(input + k) == 61) {             # '='
                k = k + 1;
                while (k < attr_end && shabda_ws_len_at(input, k, attr_end) > 0) {
                    k = k + shabda_ws_len_at(input, k, attr_end);
                }
                var q = 0;
                if (k < attr_end) { q = load8(input + k); }
                if (q == 34 || q == 39) {                             # '"' or '\''
                    var vstart = k + 1;
                    var j = vstart;
                    while (j < attr_end) {
                        if (load8(input + j) == q) { return _shabda_ssml_unescape(input, vstart, j); }
                        j = j + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Character and entity references (XML 1.0 §4.1, §4.6): &amp; &lt; &gt; &quot; &apos;
# and &#N; / &#xH; are replaced by the character they name, in text and in attribute
# values. Through 3.1.2 they reached the normalizer as written, so "AT&amp;T" said
# "at amp t". A reference that is malformed or names no character is kept as written.
# ================================================================
# Append code point `cp` to str_builder `sb` as UTF-8.
fn _shabda_ssml_put_cp(sb, cp): i64 {
    if (cp < 128) { str_builder_putc(sb, cp); return 0; }
    if (cp < 2048) {
        str_builder_putc(sb, 192 | (cp >> 6));
        str_builder_putc(sb, 128 | (cp & 63));
        return 0;
    }
    if (cp < 65536) {
        str_builder_putc(sb, 224 | (cp >> 12));
        str_builder_putc(sb, 128 | ((cp >> 6) & 63));
        str_builder_putc(sb, 128 | (cp & 63));
        return 0;
    }
    str_builder_putc(sb, 240 | (cp >> 18));
    str_builder_putc(sb, 128 | ((cp >> 12) & 63));
    str_builder_putc(sb, 128 | ((cp >> 6) & 63));
    str_builder_putc(sb, 128 | (cp & 63));
    return 0;
}

# The code point the reference input[s..e) names (the bytes between '&' and ';'), or
# -1 when it names none.
fn _shabda_ssml_entity_cp(input, s, e): i64 {
    var n = e - s;
    if (n <= 0) { return 0 - 1; }
    if (_shabda_slice_eq_cstr(input, s, n, "amp") == 1) { return 38; }
    if (_shabda_slice_eq_cstr(input, s, n, "lt") == 1) { return 60; }
    if (_shabda_slice_eq_cstr(input, s, n, "gt") == 1) { return 62; }
    if (_shabda_slice_eq_cstr(input, s, n, "quot") == 1) { return 34; }
    if (_shabda_slice_eq_cstr(input, s, n, "apos") == 1) { return 39; }
    if (load8(input + s) != 35 || n < 2) { return 0 - 1; }   # '#'
    var k = s + 1;
    var base = 10;
    if (load8(input + k) == 120) { base = 16; k = k + 1; }   # 'x'
    if (k >= e) { return 0 - 1; }
    var v = 0;
    while (k < e) {
        var c = load8(input + k);
        var d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        if (base == 16 && c >= 97 && c <= 102) { d = c - 87; }
        if (base == 16 && c >= 65 && c <= 70) { d = c - 55; }
        if (d < 0) { return 0 - 1; }
        v = v * base + d;
        if (v > 0x10FFFF) { return 0 - 1; }
        k = k + 1;
    }
    if (v == 0) { return 0 - 1; }
    if (v >= 0xD800 && v <= 0xDFFF) { return 0 - 1; }       # surrogates are no characters
    return v;
}

# input[s..e) with its references replaced, as a fresh Str.
#must_use
fn _shabda_ssml_unescape(input, s, e): i64 {
    var sb = str_builder_new();
    var i = s;
    while (i < e) {
        var c = load8(input + i);
        if (c == 38) {                                       # '&'
            var semi = i + 1;
            while (semi < e && semi < i + 12 && load8(input + semi) != 59) { semi = semi + 1; }
            if (semi < e && load8(input + semi) == 59) {
                var cp = _shabda_ssml_entity_cp(input, i + 1, semi);
                if (cp >= 0) {
                    _shabda_ssml_put_cp(sb, cp);
                    i = semi + 1;
                    continue;
                }
            }
        }
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return str_builder_build(sb);
}

# bytes[off..off+n] == name[0..n], not requiring name to terminate (used inside
# extract_attr where name is followed by '=').
#must_use
fn _shabda_slice_eq_at(input, off, name, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(input + off + i) != load8(name + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# Tag-name split (was split_tag_name): given the tag-content region
# [start, end) inside `input`, return the length of the leading tag name (up to
# the first whitespace); the attrs region is then [start+name_len, end) trimmed.
# ================================================================
#must_use
fn _shabda_tag_name_len(input, start, end): i64 {
    var i = start;
    while (i < end) {
        if (shabda_ws_len_at(input, i, end) > 0) { return i - start; }
        i = i + 1;
    }
    return end - start;
}

# Compare the tag name region [start, start+n) to cstring `lit` (exact).
#must_use
fn _shabda_name_eq(input, start, n, lit): i64 {
    return _shabda_slice_eq_cstr(input, start, n, lit);
}

# ================================================================
# break duration parsing (was parse_break_duration). Packs a status+value: on
# success returns duration_ms >= 0; on error returns SHABDA_SSML_PARSE_ERR.
# attrs region is [astart, aend).
# ================================================================
var SHABDA_SSML_PARSE_ERR = (0 - 1);

# The break strength="medium" gives, and so a <break/> with neither attribute.
var SHABDA_SSML_BREAK_MEDIUM_MS = 400;

# Maximum element nesting depth the parser will descend. _shabda_parse_until and
# _shabda_parse_tag are mutually recursive once per level, so without a ceiling the
# depth is whatever the caller's string says: ~19,400 levels (a ~408 KB document)
# exhausts an 8 MB stack and the process takes SIGSEGV. rust-old/src/ssml.rs has the
# same shape and the same crash — capping is a deliberate divergence from the oracle,
# recorded in the 3.0.3 CHANGELOG entry. 256 is the depth libxml2 defaults to and is ~50x deeper than
# any real SSML document; past it the parse fails as SHABDA_SSML_PARSE_ERR, which
# shabda_ssml_parse reports as 0 and shabda_convert_ssml as InvalidInput. A document
# nested exactly 256 deep parses; 257 does not.
var SHABDA_SSML_MAX_DEPTH = 256;

#must_use
fn _shabda_parse_break_duration(input, astart, aend): i64 {
    var time_str = _shabda_extract_attr(input, astart, aend, "time");
    if (time_str != 0) {
        var tcstr = str_cstr(time_str);
        var tlen = strlen(tcstr);
        # SSML 1.1 §3.3.1.1: a time designation is a real number ("0.7s", ".5s",
        # "+1.5s") then "ms" or "s". A leading '+' is the number's sign.
        if (tlen >= 1 && load8(tcstr) == 43) {
            tcstr = tcstr + 1;
            tlen = tlen - 1;
        }
        # strip_suffix("ms")
        if (tlen >= 2 && load8(tcstr + tlen - 2) == 109 && load8(tcstr + tlen - 1) == 115) {
            # ms_str = tcstr[..tlen-2]; parse::<u32>. Must be all digits.
            var mok = alloc(8);
            if (mok == 0) { return SHABDA_SSML_PARSE_ERR; }
            var mv = _shabda_atoi_u32(tcstr, tlen - 2, mok);
            if (load64(mok) == 1) { return mv; }
            # A fraction of a millisecond ("1.5ms") is a real number too: through 3.1.2
            # it failed the whole document. Whole milliseconds, saturating as for "s".
            if (strchr(tcstr, 46) >= 0) {
                var mbuf = alloc(tlen);
                var mout = alloc(8);
                if (mbuf == 0 || mout == 0) { return SHABDA_SSML_PARSE_ERR; }
                memcpy(mbuf, tcstr, tlen - 2);
                store8(mbuf + tlen - 2, 0);
                if (f64_parse_ok(mbuf, mout) == 0) { return SHABDA_SSML_PARSE_ERR; }
                return _shabda_ms_to_u32(load64(mout));
            }
            return SHABDA_SSML_PARSE_ERR;        # invalid break time (Rust parse::<u32> Err)
        }
        # strip_suffix('s')
        if (tlen >= 1 && load8(tcstr + tlen - 1) == 115) {
            # s_str = tcstr[..tlen-1]; parse::<f32>. (secs * 1000.0) as u32.
            var sbuf = alloc(tlen);
            if (sbuf == 0) { return SHABDA_SSML_PARSE_ERR; }
            memcpy(sbuf, tcstr, tlen - 1);
            store8(sbuf + tlen - 1, 0);
            var fout = alloc(8);
            var ok = f64_parse_ok(sbuf, fout);
            if (ok == 0) { return SHABDA_SSML_PARSE_ERR; }
            return _shabda_secs_to_ms_u32(load64(fout));
        }
        # unknown time unit
        return SHABDA_SSML_PARSE_ERR;
    }
    var strength = _shabda_extract_attr(input, astart, aend, "strength");
    if (strength != 0) {
        var scstr = str_cstr(strength);
        if (streq(scstr, "none") == 1)     { return 0; }
        if (streq(scstr, "x-weak") == 1)   { return 100; }
        if (streq(scstr, "weak") == 1)     { return 200; }
        if (streq(scstr, "medium") == 1)   { return SHABDA_SSML_BREAK_MEDIUM_MS; }
        if (streq(scstr, "strong") == 1)   { return 600; }
        if (streq(scstr, "x-strong") == 1) { return 1000; }
        return SHABDA_SSML_BREAK_MEDIUM_MS;
    }
    # SSML 1.1 §3.2.3: strength is "medium" (default value). Through 3.1.2 a bare
    # <break/> (and an unknown strength) was 300 ms while strength="medium" was 400.
    return SHABDA_SSML_BREAK_MEDIUM_MS;
}

# All of the first n bytes of cstr are ASCII digits (n>0 required for validity).
#must_use
fn _shabda_all_digits(s, n): i64 {
    if (n <= 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

# u32::MAX — the domain of Rust's `ms_str.parse::<u32>()`.
var SHABDA_SSML_U32_MAX = 4294967295;

# Rust `parse::<u32>()` over the first n bytes: returns the value and sets *ok_out
# to 1, or sets it to 0 for an empty string, a non-digit, or a value above
# u32::MAX. The old form accumulated into an i64 with no ceiling, so
# `<break time="5000000000ms">` returned 5,000,000,000 where Rust returns Err, and
# a 20-digit run wrapped the i64 outright.
#must_use
fn _shabda_atoi_u32(s, n, ok_out): i64 {
    store64(ok_out, 0);
    if (n <= 0) { return 0; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        v = v * 10 + (c - 48);
        if (v > SHABDA_SSML_U32_MAX) { return 0; }   # cannot wrap: v <= u32::MAX*10+9
        i = i + 1;
    }
    store64(ok_out, 1);
    return v;
}

# Rust `(secs * 1000.0) as u32` on an f32. `as` on a float is a SATURATING cast in
# Rust: NaN -> 0, negative -> 0, above u32::MAX -> u32::MAX. The port used a bare
# f64_to, so `<break time="-5s">` produced -5000 — which is not just wrong but
# collides with SHABDA_SSML_PARSE_ERR (-1) for `time="-0.001s"`.
#
# The multiply is done in NATIVE single precision because Rust's is:
# `s_str.parse::<f32>()` then an f32 multiply. Typing the params `f32` puts the bit
# patterns in xmm lanes as singles and `a * b` emits `mulss`; the result comes back
# as its bit pattern through an i64 return (cyrius accepts f32 params but not an f32
# return type). Same shape ganita 1.2.0 uses for its arithmetic tier.
#must_use
fn _shabda_f32_mul(a: f32, b: f32): i64 {
    var s: f32 = a * b;
    return s;
}

# Whole milliseconds for a millisecond count `ms_f64` (f64 bits), saturating into u32
# as _shabda_secs_to_ms_u32 does.
#must_use
fn _shabda_ms_to_u32(ms_f64): i64 {
    if (f64_eq(ms_f64, ms_f64) == 0) { return 0; }
    if (f64_lt(ms_f64, f64_from(0)) == 1) { return 0; }
    if (f64_ge(ms_f64, f64_from(SHABDA_SSML_U32_MAX)) == 1) { return SHABDA_SSML_U32_MAX; }
    return f64_to(ms_f64);
}

#must_use
fn _shabda_secs_to_ms_u32(secs_f64): i64 {
    var secs32 = f32_from(secs_f64);                             # parse::<f32>()
    var k1000 = f32_from(f64_from(1000));
    var ms32 = f32_to(_shabda_f32_mul(secs32, k1000));           # * 1000.0f32
    if (f64_eq(ms32, ms32) == 0) { return 0; }                   # NaN -> 0 (NaN != NaN)
    if (f64_lt(ms32, f64_from(0)) == 1) { return 0; }            # negative -> 0
    if (f64_ge(ms32, f64_from(SHABDA_SSML_U32_MAX)) == 1) { return SHABDA_SSML_U32_MAX; }
    return f64_to(ms32);
}

# ================================================================
# emphasis level parsing (was parse_emphasis_level). Default = Moderate.
# ================================================================
#must_use
fn _shabda_parse_emphasis_level(input, astart, aend): i64 {
    var lvl = _shabda_extract_attr(input, astart, aend, "level");
    if (lvl != 0) {
        var s = str_cstr(lvl);
        if (streq(s, "strong") == 1)   { return SHABDA_EMPH_STRONG; }
        if (streq(s, "moderate") == 1) { return SHABDA_EMPH_MODERATE; }
        if (streq(s, "reduced") == 1)  { return SHABDA_EMPH_REDUCED; }
        if (streq(s, "none") == 1)     { return SHABDA_EMPH_NONE; }
    }
    return SHABDA_EMPH_MODERATE;
}

# ================================================================
# prosody rate parsing (was parse_prosody_rate). Default = None (sentinel).
# ================================================================
#must_use
fn _shabda_parse_prosody_rate(input, astart, aend): i64 {
    var r = _shabda_extract_attr(input, astart, aend, "rate");
    if (r != 0) {
        var s = str_cstr(r);
        if (streq(s, "x-slow") == 1) { return SHABDA_RATE_XSLOW; }
        if (streq(s, "slow") == 1)   { return SHABDA_RATE_SLOW; }
        if (streq(s, "medium") == 1) { return SHABDA_RATE_MEDIUM; }
        if (streq(s, "fast") == 1)   { return SHABDA_RATE_FAST; }
        if (streq(s, "x-fast") == 1) { return SHABDA_RATE_XFAST; }
        if (_shabda_parse_rate_percent(s) >= 0) { return SHABDA_RATE_PERCENT; }
    }
    return SHABDA_RATE_NONE;
}

# rate="N%": N (f64 bits) for a non-negative real number N followed by '%', or -1.
#must_use
fn _shabda_parse_rate_percent(s): i64 {
    var n = strlen(s);
    if (n < 2 || load8(s + n - 1) != 37) { return 0 - 1; }   # '%'
    var c0 = load8(s);
    if (c0 == 43 || c0 == 45) { return 0 - 1; }   # signed: SSML 1.0's relative change, not 1.1's multiplier
    var k = 0;
    var digits = 0;
    while (k < n - 1) {
        var c = load8(s + k);
        if (c >= 48 && c <= 57) { digits = digits + 1; } elif (c != 46) { return 0 - 1; }
        k = k + 1;
    }
    if (digits == 0) { return 0 - 1; }
    var buf = alloc(n);
    var out = alloc(8);
    if (buf == 0 || out == 0) { return 0 - 1; }
    memcpy(buf, s, n - 1);
    store8(buf + n - 1, 0);
    if (f64_parse_ok(buf, out) == 0) { return 0 - 1; }
    return load64(out);
}

# ================================================================
# children_to_text (was children_to_text): concat all Text children's text with
# single-space joins. Returns a Str.
# ================================================================
#must_use
fn _shabda_children_to_text(children): i64 {
    var sb = str_builder_new();
    var n = vec_len(children);
    var i = 0;
    var wrote = 0;
    while (i < n) {
        var child = vec_get(children, i);
        if (shabda_ssml_node_tag(child) == SHABDA_SSML_TEXT) {
            if (wrote == 1) { str_builder_putc(sb, 32); }
            str_builder_add(sb, shabda_ssml_node_text(child));
            wrote = 1;
        }
        i = i + 1;
    }
    return str_builder_build(sb);
}

# ================================================================
# Push a trimmed text run bytes[start..end) as a Text node if non-empty (mirrors
# the Rust text-run branch shared by parse() and parse_until()).
# ================================================================
fn _shabda_push_text(nodes, input, start, end): i64 {
    # Trim Unicode whitespace both ends (Rust str::trim).
    var s = start;
    var e = end;
    var pso = alloc(8);
    var peo = alloc(8);
    if (pso == 0 || peo == 0) { return 0; }
    _shabda_ssml_trim(input, s, e, pso, peo);
    s = load64(pso);
    e = load64(peo);
    if (e > s) {
        vec_push(nodes, shabda_ssml_text(_shabda_ssml_unescape(input, s, e)));
    }
    return 0;
}

# ================================================================
# Markup that is not an element (XML 1.0 §2.5, §2.6, §2.7, §2.8): a comment
# <!-- ... -->, a processing instruction or the XML declaration <? ... ?>, a CDATA
# section <![CDATA[ ... ]]> (its text is pushed to `nodes` as written), and a
# document type declaration <!DOCTYPE ...>. Through 3.1.2 each was read as an
# unknown element whose content ran to the end of the input, of which only the first
# node survived: a document that began with <?xml version="1.0"?> said one word.
# Returns the position after it, -2 when the '<' at `pos` opens none of these, or
# SHABDA_SSML_PARSE_ERR when it is not closed.
# ================================================================
var SHABDA_SSML_NOT_SPECIAL = (0 - 2);

# Index of the first occurrence of cstring `lit` in input[from..len), or -1.
#must_use
fn _shabda_ssml_find(input, len, from, lit): i64 {
    var i = from;
    while (i < len) {
        if (_shabda_ssml_starts_with(input, len, i, lit) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

#must_use
fn _shabda_ssml_skip_special(input, len, pos, nodes): i64 {
    var end = 0;
    if (_shabda_ssml_starts_with(input, len, pos, "<!--") == 1) {
        end = _shabda_ssml_find(input, len, pos + 4, "-->");
        if (end < 0) { return SHABDA_SSML_PARSE_ERR; }
        return end + 3;
    }
    if (_shabda_ssml_starts_with(input, len, pos, "<![CDATA[") == 1) {
        end = _shabda_ssml_find(input, len, pos + 9, "]]>");
        if (end < 0) { return SHABDA_SSML_PARSE_ERR; }
        var cso = alloc(8);
        var ceo = alloc(8);
        if (cso == 0 || ceo == 0) { return SHABDA_SSML_PARSE_ERR; }
        _shabda_ssml_trim(input, pos + 9, end, cso, ceo);
        if (load64(ceo) > load64(cso)) {
            vec_push(nodes, shabda_ssml_text(str_from_buf(input + load64(cso), load64(ceo) - load64(cso))));
        }
        return end + 3;
    }
    if (_shabda_ssml_starts_with(input, len, pos, "<?") == 1) {
        end = _shabda_ssml_find(input, len, pos + 2, "?>");
        if (end < 0) { return SHABDA_SSML_PARSE_ERR; }
        return end + 2;
    }
    if (_shabda_ssml_starts_with(input, len, pos, "<!") == 1) {
        # <!DOCTYPE ...>, with an internal subset [ ... ] when it has one.
        var i = pos + 2;
        var depth = 0;
        while (i < len) {
            var c = load8(input + i);
            if (c == 91) { depth = depth + 1; }
            if (c == 93 && depth > 0) { depth = depth - 1; }
            if (c == 62 && depth == 0) { return i + 1; }
            i = i + 1;
        }
        return SHABDA_SSML_PARSE_ERR;
    }
    return SHABDA_SSML_NOT_SPECIAL;
}

# ================================================================
# parse_tag (was parse_tag): parse the single tag/element starting at `pos` (a
# '<'). Pushes the nodes it produces (none, one, or an unknown element's children)
# to `nodes` and returns the new position, OR returns SHABDA_SSML_PARSE_ERR on
# malformed input.
# ================================================================
#must_use
fn _shabda_parse_tag(input, len, pos, nodes, depth): i64 {
    if (depth >= SHABDA_SSML_MAX_DEPTH) { return SHABDA_SSML_PARSE_ERR; }
    var tag_end = _shabda_find_tag_end(input, len, pos);
    if (tag_end < 0) { return SHABDA_SSML_PARSE_ERR; }   # unclosed tag bracket

    # tag_content = input[pos+1..tag_end]
    var cstart = pos + 1;
    var cend = tag_end;

    # self-closing? content ends with '/'
    var self_closing = 0;
    if (cend > cstart && load8(input + cend - 1) == 47) {
        self_closing = 1;
        cend = cend - 1;                          # drop trailing '/'
    }
    # trim the (possibly '/'-stripped) content
    var cso = alloc(8);
    var ceo = alloc(8);
    if (cso == 0 || ceo == 0) { return SHABDA_SSML_PARSE_ERR; }
    _shabda_ssml_trim(input, cstart, cend, cso, ceo);
    cstart = load64(cso);
    cend = load64(ceo);

    # split tag name / attrs
    var name_len = _shabda_tag_name_len(input, cstart, cend);
    var astart = cstart + name_len;
    var aend = cend;
    var aso = alloc(8);
    var aeo = alloc(8);
    if (aso == 0 || aeo == 0) { return SHABDA_SSML_PARSE_ERR; }
    _shabda_ssml_trim(input, astart, aend, aso, aeo);
    astart = load64(aso);
    aend = load64(aeo);

    # break
    if (_shabda_name_eq(input, cstart, name_len, "break") == 1) {
        var dur = _shabda_parse_break_duration(input, astart, aend);
        if (dur == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
        vec_push(nodes, shabda_ssml_break(dur));
        return tag_end + 1;
    }
    # emphasis
    if (_shabda_name_eq(input, cstart, name_len, "emphasis") == 1) {
        var level = _shabda_parse_emphasis_level(input, astart, aend);
        if (self_closing == 1) {
            vec_push(nodes, shabda_ssml_emphasis(level, vec_new()));
            return tag_end + 1;
        }
        var kids = vec_new();
        var np = _shabda_parse_until(input, len, tag_end + 1, "emphasis", kids, depth + 1);
        if (np == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
        vec_push(nodes, shabda_ssml_emphasis(level, kids));
        return np;
    }
    # prosody
    if (_shabda_name_eq(input, cstart, name_len, "prosody") == 1) {
        var rate = _shabda_parse_prosody_rate(input, astart, aend);
        var pct = f64_from(100);
        if (rate == SHABDA_RATE_PERCENT) {
            pct = _shabda_parse_rate_percent(str_cstr(_shabda_extract_attr(input, astart, aend, "rate")));
        }
        var pkids = vec_new();
        var pnp = tag_end + 1;
        if (self_closing == 0) {
            pnp = _shabda_parse_until(input, len, tag_end + 1, "prosody", pkids, depth + 1);
            if (pnp == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
        }
        var pnode = shabda_ssml_prosody(rate, pkids);
        if (rate == SHABDA_RATE_PERCENT) { pnode = shabda_ssml_prosody_percent(pct, pkids); }
        vec_push(nodes, pnode);
        return pnp;
    }
    # phoneme
    if (_shabda_name_eq(input, cstart, name_len, "phoneme") == 1) {
        if (self_closing == 1) {
            var ph = _shabda_extract_attr(input, astart, aend, "ph");
            if (ph != 0) {
                vec_push(nodes, shabda_ssml_text(ph));
            }
            return tag_end + 1;
        }
        var phkids = vec_new();
        var phnp = _shabda_parse_until(input, len, tag_end + 1, "phoneme", phkids, depth + 1);
        if (phnp == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
        vec_push(nodes, shabda_ssml_text(_shabda_children_to_text(phkids)));
        return phnp;
    }
    # unknown tag
    if (self_closing == 1) {
        return tag_end + 1;
    }
    var ukids = vec_new();
    # parse_until with the unknown tag name (as a fresh cstr for the closer match)
    var uname = _shabda_dup_name(input, cstart, name_len);
    var unp = _shabda_parse_until(input, len, tag_end + 1, uname, ukids, depth + 1);
    if (unp == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
    # Its content, as if the tag were not there (SSML 1.1 §2.2.4.1: "ignore the
    # non-standard elements"; §3.1.9: an unsupported say-as "MUST render the contained
    # text"). Through 3.1.2 only the first child was kept, so <p><s>One.</s>
    # <s>Two.</s></p> said "One." and dropped the rest.
    var ui = 0;
    while (ui < vec_len(ukids)) {
        vec_push(nodes, vec_get(ukids, ui));
        ui = ui + 1;
    }
    return unp;
}

# Copy the tag name [start, start+n) to a fresh NUL-terminated cstr.
#must_use
fn _shabda_dup_name(input, start, n): i64 {
    var buf = alloc(n + 1);
    if (buf == 0) { return ""; }
    memcpy(buf, input + start, n);
    store8(buf + n, 0);
    return buf;
}

# ================================================================
# parse_until (was parse_until): parse content into `nodes` until a matching
# </tag_name> closer. Returns position after the closer, OR the end-of-input
# position if no closer (Rust "return what we have"), OR SHABDA_SSML_PARSE_ERR.
# tag_name is a cstr. `depth` is the current nesting level (see
# SHABDA_SSML_MAX_DEPTH).
# ================================================================
#must_use
fn _shabda_parse_until(input, len, start, tag_name, nodes, depth): i64 {
    var pos = start;
    while (pos < len) {
        var sp = SHABDA_SSML_NOT_SPECIAL;
        if (load8(input + pos) == 60) { sp = _shabda_ssml_skip_special(input, len, pos, nodes); }
        if (sp == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
        if (sp != SHABDA_SSML_NOT_SPECIAL) {
            pos = sp;
        } elif (load8(input + pos) == 60) {          # '<'
            var tag_end = _shabda_find_tag_end(input, len, pos);
            if (tag_end < 0) { return SHABDA_SSML_PARSE_ERR; }
            var cstart = pos + 1;
            # closing tag? content starts with '/'
            if (cstart < tag_end && load8(input + cstart) == 47) {
                # close_name = content[1..].trim()
                var ns = cstart + 1;
                var ne = tag_end;
                var nso = alloc(8);
                var neo = alloc(8);
                if (nso == 0 || neo == 0) { return SHABDA_SSML_PARSE_ERR; }
                _shabda_ssml_trim(input, ns, ne, nso, neo);
                ns = load64(nso);
                ne = load64(neo);
                if (_shabda_name_eq(input, ns, ne - ns, tag_name) == 1) {
                    return tag_end + 1;
                }
                # mismatched close — skip it
                pos = tag_end + 1;
            } else {
                var np = _shabda_parse_tag(input, len, pos, nodes, depth);
                if (np == SHABDA_SSML_PARSE_ERR) { return SHABDA_SSML_PARSE_ERR; }
                pos = np;
            }
        } else {
            var text_end = _shabda_next_lt(input, len, pos);
            _shabda_push_text(nodes, input, pos, text_end);
            pos = text_end;
        }
    }
    return pos;
}

# Index of the next '<' at or after `pos`, or `len` (Rust find('<').map_or(len)).
#must_use
fn _shabda_next_lt(input, len, pos): i64 {
    var i = pos;
    while (i < len) {
        if (load8(input + i) == 60) { return i; }
        i = i + 1;
    }
    return len;
}

# ================================================================
# parse (was parse): top-level. Returns a vec of SsmlNode* on success, or 0 on
# parse error (Rust Err). The <speak> wrapper is optional and its children are
# flattened into the top-level vec.
# ================================================================
#must_use
fn shabda_ssml_parse(input): i64 {
    var nodes = vec_new();
    var len = strlen(input);
    var pos = 0;
    while (pos < len) {
        var sp = SHABDA_SSML_NOT_SPECIAL;
        if (load8(input + pos) == 60) { sp = _shabda_ssml_skip_special(input, len, pos, nodes); }
        if (sp == SHABDA_SSML_PARSE_ERR) { return 0; }
        if (sp != SHABDA_SSML_NOT_SPECIAL) {
            pos = sp;
        } elif (load8(input + pos) == 60) {          # '<'
            var tag_end = _shabda_find_tag_end(input, len, pos);
            if (tag_end < 0) { return 0; }        # unclosed tag bracket -> Err
            var cstart = pos + 1;
            if (cstart < tag_end && load8(input + cstart) == 47) {
                # closing tag at top level — skip
                pos = tag_end + 1;
            } elif (_shabda_is_speak(input, len, cstart) == 1) {
                pos = tag_end + 1;
                var kids = vec_new();
                var np = _shabda_parse_until(input, len, pos, "speak", kids, 1);
                if (np == SHABDA_SSML_PARSE_ERR) { return 0; }
                var kn = vec_len(kids);
                var ki = 0;
                while (ki < kn) {
                    vec_push(nodes, vec_get(kids, ki));
                    ki = ki + 1;
                }
                pos = np;
            } else {
                var tnp = _shabda_parse_tag(input, len, pos, nodes, 0);
                if (tnp == SHABDA_SSML_PARSE_ERR) { return 0; }
                pos = tnp;
            }
        } else {
            var text_end = _shabda_next_lt(input, len, pos);
            _shabda_push_text(nodes, input, pos, text_end);
            pos = text_end;
        }
    }
    return nodes;
}

# tag_content.starts_with("speak") || starts_with("speak ") — the Rust guard.
# Since "speak " implies "speak", a single prefix check suffices, matching Rust.
#must_use
fn _shabda_is_speak(input, len, cstart): i64 {
    return _shabda_ssml_starts_with(input, len, cstart, "speak");
}

# ================================================================
# serde codec (Rust `derive(Serialize, Deserialize)`). Self-contained: no bayan
# dependency — the port encodes each Copy enum via its stable integer tag, and an
# SsmlNode is (de)serialized structurally through the constructors/accessors. The
# roundtrip identity is exercised in the tests. These are the "codec" surface a
# format layer would call.
# ================================================================
# EmphasisLevel <-> code (identity; tags are the wire form).
#must_use
fn shabda_emphasis_level_encode(level): i64 { return level; }
# SHABDA_EMPH_* tag for a wire code; an unknown code gives SHABDA_EMPH_MODERATE.
#must_use
fn shabda_emphasis_level_decode(code): i64 {
    if (code == SHABDA_EMPH_STRONG)   { return SHABDA_EMPH_STRONG; }
    if (code == SHABDA_EMPH_MODERATE) { return SHABDA_EMPH_MODERATE; }
    if (code == SHABDA_EMPH_REDUCED)  { return SHABDA_EMPH_REDUCED; }
    if (code == SHABDA_EMPH_NONE)     { return SHABDA_EMPH_NONE; }
    return SHABDA_EMPH_MODERATE;                  # #[non_exhaustive] fallback
}

# SpeakingRate <-> code (identity; tags are the wire form).
#must_use
fn shabda_speaking_rate_encode(rate): i64 { return rate; }
# SHABDA_RATE_* tag for a wire code; an unknown code gives SHABDA_RATE_NONE.
#must_use
fn shabda_speaking_rate_decode(code): i64 {
    if (code == SHABDA_RATE_XSLOW)  { return SHABDA_RATE_XSLOW; }
    if (code == SHABDA_RATE_SLOW)   { return SHABDA_RATE_SLOW; }
    if (code == SHABDA_RATE_MEDIUM) { return SHABDA_RATE_MEDIUM; }
    if (code == SHABDA_RATE_FAST)   { return SHABDA_RATE_FAST; }
    if (code == SHABDA_RATE_XFAST)  { return SHABDA_RATE_XFAST; }
    if (code == SHABDA_RATE_PERCENT) { return SHABDA_RATE_PERCENT; }
    return SHABDA_RATE_NONE;                       # unknown/None fallback
}

# SsmlNode deep-clone as a serde round-trip proxy: reconstructs an equal node
# tree via the public constructors (mirrors serialize -> deserialize identity).
#must_use
fn shabda_ssml_node_clone(node): i64 {
    var tag = shabda_ssml_node_tag(node);
    if (tag == SHABDA_SSML_TEXT) {
        return shabda_ssml_text(str_clone(shabda_ssml_node_text(node)));
    }
    if (tag == SHABDA_SSML_BREAK) {
        return shabda_ssml_break(shabda_ssml_node_duration(node));
    }
    if (tag == SHABDA_SSML_EMPHASIS) {
        return shabda_ssml_emphasis(shabda_ssml_node_level(node),
          _shabda_clone_children(shabda_ssml_node_children(node)));
    }
    if (tag == SHABDA_SSML_PROSODY) {
        var pc = shabda_ssml_prosody(shabda_ssml_node_rate(node),
          _shabda_clone_children(shabda_ssml_node_children(node)));
        store64(pc + SHABDA_SSML_OFF_PERCENT, shabda_ssml_node_rate_percent(node));
        return pc;
    }
    return 0;                                      # #[non_exhaustive] fallback
}

#must_use
fn _shabda_clone_children(children): i64 {
    var out = vec_new();
    var n = vec_len(children);
    var i = 0;
    while (i < n) {
        vec_push(out, shabda_ssml_node_clone(vec_get(children, i)));
        i = i + 1;
    }
    return out;
}

# Structural equality of two SsmlNode trees (Rust derive(PartialEq)) — used by
# tests to assert parse results and serde round-trips.
#must_use
fn shabda_ssml_node_eq(a, b): i64 {
    var ta = shabda_ssml_node_tag(a);
    var tb = shabda_ssml_node_tag(b);
    if (ta != tb) { return 0; }
    if (ta == SHABDA_SSML_TEXT) {
        return str_eq(shabda_ssml_node_text(a), shabda_ssml_node_text(b));
    }
    if (ta == SHABDA_SSML_BREAK) {
        if (shabda_ssml_node_duration(a) == shabda_ssml_node_duration(b)) { return 1; }
        return 0;
    }
    if (ta == SHABDA_SSML_EMPHASIS) {
        if (shabda_ssml_node_level(a) != shabda_ssml_node_level(b)) { return 0; }
        return _shabda_children_eq(shabda_ssml_node_children(a), shabda_ssml_node_children(b));
    }
    if (ta == SHABDA_SSML_PROSODY) {
        if (shabda_ssml_node_rate(a) != shabda_ssml_node_rate(b)) { return 0; }
        if (shabda_ssml_node_rate_percent(a) != shabda_ssml_node_rate_percent(b)) { return 0; }
        return _shabda_children_eq(shabda_ssml_node_children(a), shabda_ssml_node_children(b));
    }
    return 0;
}

#must_use
fn _shabda_children_eq(a, b): i64 {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (shabda_ssml_node_eq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# --- rules.cyr ---

# rules.cyr — rule-based grapheme-to-phoneme conversion (6 language engines).
#
# The capabilities of rust-old/src/rules.rs (1545 LOC); since 3.1.3 their output is
# accurate rather than the Rust's (ADR-0002, the 3.1.3 CHANGELOG entry). Six public
# #must_use engines, each taking a cstring word and returning a `vec` of svara
# phoneme ordinals:
#   shabda_english_rules(word)   — context-sensitive NRL rules + vowel reduction
#   shabda_spanish_rules(word)   — /a e i o u/, glides, trill / tap, yeísmo
#   shabda_german_rules(word)    — vowel length, schwa, ç / χ, ʁ, affricates, devoicing
#   shabda_hindi_rules(word)     — Devanagari + Ohala's final and medial schwa deletion
#   shabda_sanskrit_rules(word)  — Devanagari + IAST, schwa PRESERVATION
#   shabda_arabic_rules(word)    — abjad + harakat/tanween/shadda, matres, the article
#
# DEPENDENCY POSITION: needs the vendored svara bundle (SVARA_PH_* ordinals) and
# src/error.cyr (for shared L0 tags — not strictly used here but part of the
# include chain). Modules never `include` each other; the entry file orders
# includes: lib/hisab, lib/goonj, lib/naad, lib/svara, src/error, src/rules.
#
# PORTING MODEL — everything operates on a codepoint array:
#   _shabda_word_chars(word) UTF-8-decodes the cstring into a `vec` of i64
#   codepoints ONCE; every engine indexes that vec. Devanagari/Arabic literals
#   port as exact codepoint compares against the hex values (load-bearing).
#
# Rust's PatternResult{Static/Dynamic} + custom iterator is FLATTENED: each
# match helper returns the number of chars 'consumed' and pushes the phoneme
# sequence directly into the caller's out vec. No iterator adapter.
#
# Rust `char` `to_lowercase()` → we ASCII-lowercase codepoints in
# _shabda_word_chars for the Latin engines (matching Rust's word.to_lowercase()
# for the ASCII range; the non-ASCII accented literals á/é/ñ/ä/ö/ü/ß are already
# lowercase in the test inputs, same as Rust). The Devanagari/Arabic engines take
# the raw (un-lowercased) codepoints, mirroring Rust's `word.chars()` there.
#
# Option<Phoneme> / sentinels: SHABDA_PH_NONE from error.cyr. Every match helper
# has a mandatory final fallback arm (the #[non_exhaustive]-style default).
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`/`_shabda_`-prefixed
# (flat link namespace; coexists with shbdk_ / svara_ / varna / sakshi).

# ================================================================
# Codepoint helpers
# ================================================================

# Is `cp` an ASCII vowel letter (a/e/i/o/u)? Ports is_vowel_char.
#must_use
fn _shabda_is_vowel_char(cp): i64 {
    if (cp == 0x61) { return 1; }   # a
    if (cp == 0x65) { return 1; }   # e
    if (cp == 0x69) { return 1; }   # i
    if (cp == 0x6F) { return 1; }   # o
    if (cp == 0x75) { return 1; }   # u
    return 0;
}

# ASCII-lowercase a single codepoint (A..Z -> a..z), leaving all else untouched.
# Mirrors Rust `char::to_lowercase().next()` for the ASCII range.
#must_use
fn _shabda_ascii_lower(cp): i64 {
    if (cp >= 0x41) {
        if (cp <= 0x5A) {
            return cp + 0x20;
        }
    }
    return cp;
}

# UTF-8-decode a NUL-terminated cstring into a `vec` of i64 codepoints.
# Optionally ASCII-lowercases each (lower != 0) — Latin engines lowercase, the
# Devanagari/Arabic engines pass raw. Returns a vec of codepoints.
#must_use
fn _shabda_decode_chars(word, lower): i64 {
    return _shabda_decode_chars_a(default_alloc(), word, lower);
}

# _shabda_decode_chars, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_decode_chars_a(a, word, lower): i64 {
    var out = vec_new_a(a);
    var n = strlen(word);
    var i = 0;
    while (i < n) {
        var b0 = load8(word + i);
        var cp = 0;
        var adv = 1;
        # Every continuation byte is bounds-checked against `n`. A sequence whose
        # lead byte promises more bytes than the string holds decodes as the lead
        # byte alone and advances 1 — exactly what _shabda_utf8_next (normalize.cyr)
        # does at its NUL guard, so the crate's two decoders agree. Without this the
        # loads ran up to 3 bytes past the NUL terminator, reading whatever the bump
        # allocator held there and turning it into phonemes.
        if (b0 < 0x80) {
            cp = b0;
        } elif (b0 < 0xE0) {
            # 2-byte sequence
            if (i + 1 >= n) { cp = b0; } else {
                var b1 = load8(word + i + 1);
                cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                adv = 2;
            }
        } elif (b0 < 0xF0) {
            # 3-byte sequence (Devanagari, Arabic presentation etc.)
            if (i + 2 >= n) { cp = b0; } else {
                var b1b = load8(word + i + 1);
                var b2b = load8(word + i + 2);
                cp = ((b0 & 0x0F) << 12) | ((b1b & 0x3F) << 6) | (b2b & 0x3F);
                adv = 3;
            }
        } else {
            # 4-byte sequence
            if (i + 3 >= n) { cp = b0; } else {
                var b1c = load8(word + i + 1);
                var b2c = load8(word + i + 2);
                var b3c = load8(word + i + 3);
                cp = ((b0 & 0x07) << 18) | ((b1c & 0x3F) << 12) | ((b2c & 0x3F) << 6) | (b3c & 0x3F);
                adv = 4;
            }
        }
        if (lower != 0) {
            cp = _shabda_ascii_lower(cp);
        }
        _shabda_vec_push_a(a, out, cp);
        i = i + adv;
    }
    return out;
}

# Build the lowercased codepoint array for a word (Latin engines).
#must_use
fn _shabda_word_chars(word): i64 {
    return _shabda_word_chars_a(default_alloc(), word);
}

# _shabda_word_chars, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_word_chars_a(a, word): i64 {
    return _shabda_decode_chars_a(a, word, 1);
}

# Safe vec_get: returns -1 when idx is out of bounds (Rust's chars.get(i)).
#must_use
fn _shabda_cp_at(chars, idx): i64 {
    if (idx < 0) { return (0 - 1); }
    if (idx >= vec_len(chars)) { return (0 - 1); }
    return vec_get(chars, idx);
}

# ================================================================
# English letter-to-sound rules (3.1.3).
#
# A context-sensitive rule set after Elovitz, Johnson, McHugh and Shore, "Letter-to-Sound
# Rules for Automatic Translation of English Text to Phonetics", NRL Report 7948 (1976;
# a US Government work, public domain), with additions measured against CMUdict (the
# 3.1.3 CHANGELOG entry lists them and the accuracy). Through 3.1.2 the rules were the
# Rust's: one phoneme per letter plus 2- to 4-letter patterns with no context, which got
# 13.5% of CMUdict's words exactly right.
#
# A rule is LEFT [MATCH] RIGHT -> ARPABET. The word is scanned left to right; at each
# position the first rule for the letter there whose MATCH spells the next letters and
# whose LEFT / RIGHT contexts fit gives the phonemes, and the scan moves past MATCH.
# Context symbols (NRL's):
#   ' '  a word boundary (any non-letter)     #  one or more vowels (a e i o u)
#   ':'  zero or more consonants              ^  one consonant (y counts as one)
#   '.'  a voiced consonant b d v g j l m n r w z
#   '+'  a front vowel e i y                  %  a suffix: er e es ed ing ely
#   '&'  a sibilant s c g z x j ch sh         @  t s r d l z n j th ch sh
# Letters match themselves. LEFT is read right to left from the letter before MATCH.
#
# The ARPABET maps to svara exactly as shabdakosh maps CMUdict (AH0 is schwa, AH1 / AH2
# is /ʌ/, IY is /iː/), so the rules and the dictionary never disagree on a symbol;
# tests/engine.tcyr checks every symbol against shbdk_arpabet_to_phoneme_with_stress.
#
# The table is built once per process on the default heap, like the heteronym rules,
# and shabda_g2p_new builds it, so a conversion through an Allocator never builds it.
# ================================================================

var _SHABDA_EN_RULES = 0;

# Rule record (40 bytes): left, match, right (cstrings), phonemes (vec), match length.
var SHABDA_EN_LEFT   = 0;
var SHABDA_EN_MATCH  = 8;
var SHABDA_EN_RIGHT  = 16;
var SHABDA_EN_PH     = 24;
var SHABDA_EN_MLEN   = 32;
var SHABDA_EN_SIZE   = 40;

# ARPABET symbol (the `len` bytes at `s`, with or without a stress digit) -> svara
# ordinal, or -1. shabdakosh's mapping: AH with stress 0 is schwa.
fn _shabda_en_arpabet(s, len): i64 {
    var d = load8(s + len - 1);
    var base = len;
    if (d >= 48 && d <= 50) { base = len - 1; }
    var c0 = load8(s);
    var c1 = 0;
    if (base >= 2) { c1 = load8(s + 1); }
    if (base == 2) {
        if (c0 == 65 && c1 == 65) { return SVARA_PH_VOWEL_OPEN_A; }                   # AA
        if (c0 == 65 && c1 == 69) { return SVARA_PH_VOWEL_ASH; }                      # AE
        if (c0 == 65 && c1 == 72) {                                                    # AH
            if (d == 48) { return SVARA_PH_VOWEL_SCHWA; }
            return SVARA_PH_VOWEL_CUP_V;
        }
        if (c0 == 65 && c1 == 79) { return SVARA_PH_VOWEL_OPEN_O; }                   # AO
        if (c0 == 65 && c1 == 87) { return SVARA_PH_DIPH_AU; }                        # AW
        if (c0 == 65 && c1 == 89) { return SVARA_PH_DIPH_AI; }                        # AY
        if (c0 == 69 && c1 == 72) { return SVARA_PH_VOWEL_OPEN_E; }                   # EH
        if (c0 == 69 && c1 == 82) { return SVARA_PH_VOWEL_BIRD; }                     # ER
        if (c0 == 69 && c1 == 89) { return SVARA_PH_DIPH_EI; }                        # EY
        if (c0 == 73 && c1 == 72) { return SVARA_PH_VOWEL_NEAR_I; }                   # IH
        if (c0 == 73 && c1 == 89) { return SVARA_PH_VOWEL_LONG_I; }                   # IY
        if (c0 == 79 && c1 == 87) { return SVARA_PH_DIPH_OU; }                        # OW
        if (c0 == 79 && c1 == 89) { return SVARA_PH_DIPH_OI; }                        # OY
        if (c0 == 85 && c1 == 72) { return SVARA_PH_VOWEL_NEAR_U; }                   # UH
        if (c0 == 85 && c1 == 87) { return SVARA_PH_VOWEL_U; }                        # UW
        if (c0 == 67 && c1 == 72) { return SVARA_PH_AFFR_CH; }                        # CH
        if (c0 == 68 && c1 == 72) { return SVARA_PH_FRIC_DH; }                        # DH
        if (c0 == 72 && c1 == 72) { return SVARA_PH_FRIC_H; }                         # HH
        if (c0 == 74 && c1 == 72) { return SVARA_PH_AFFR_J; }                         # JH
        if (c0 == 78 && c1 == 71) { return SVARA_PH_NASAL_NG; }                       # NG
        if (c0 == 83 && c1 == 72) { return SVARA_PH_FRIC_SH; }                        # SH
        if (c0 == 84 && c1 == 72) { return SVARA_PH_FRIC_TH; }                        # TH
        if (c0 == 90 && c1 == 72) { return SVARA_PH_FRIC_ZH; }                        # ZH
        return 0 - 1;
    }
    if (base != 1) { return 0 - 1; }
    if (c0 == 66) { return SVARA_PH_PLOSIVE_B; }
    if (c0 == 68) { return SVARA_PH_PLOSIVE_D; }
    if (c0 == 70) { return SVARA_PH_FRIC_F; }
    if (c0 == 71) { return SVARA_PH_PLOSIVE_G; }
    if (c0 == 75) { return SVARA_PH_PLOSIVE_K; }
    if (c0 == 76) { return SVARA_PH_LATERAL_L; }
    if (c0 == 77) { return SVARA_PH_NASAL_M; }
    if (c0 == 78) { return SVARA_PH_NASAL_N; }
    if (c0 == 80) { return SVARA_PH_PLOSIVE_P; }
    if (c0 == 82) { return SVARA_PH_APPROX_R; }
    if (c0 == 83) { return SVARA_PH_FRIC_S; }
    if (c0 == 84) { return SVARA_PH_PLOSIVE_T; }
    if (c0 == 86) { return SVARA_PH_FRIC_V; }
    if (c0 == 87) { return SVARA_PH_APPROX_W; }
    if (c0 == 89) { return SVARA_PH_APPROX_J; }
    if (c0 == 90) { return SVARA_PH_FRIC_Z; }
    return 0 - 1;
}

# Space-separated ARPABET -> vec of svara ordinals (default heap; the table only).
fn _shabda_en_phonemes(spec): i64 {
    var v = vec_new();
    var n = strlen(spec);
    var i = 0;
    while (i < n) {
        while (i < n && load8(spec + i) == 32) { i = i + 1; }
        var j = i;
        while (j < n && load8(spec + j) != 32) { j = j + 1; }
        if (j > i) {
            var ph = _shabda_en_arpabet(spec + i, j - i);
            if (ph >= 0) { vec_push(v, ph); }
        }
        i = j;
    }
    return v;
}

# Bucket index of a letter: a..z -> 0..25, apostrophe 26, anything else -1.
fn _shabda_en_bucket(c): i64 {
    if (c >= 97 && c <= 122) { return c - 97; }
    if (c == 39) { return 26; }
    return 0 - 1;
}

# Append one rule to the bucket of its first MATCH letter.
fn _shabda_en_r(tab, left, spell, right, spec): i64 {
    var r = alloc(SHABDA_EN_SIZE);
    store64(r + SHABDA_EN_LEFT, left);
    store64(r + SHABDA_EN_MATCH, spell);
    store64(r + SHABDA_EN_RIGHT, right);
    store64(r + SHABDA_EN_PH, _shabda_en_phonemes(spec));
    store64(r + SHABDA_EN_MLEN, strlen(spell));
    vec_push(vec_get(tab, _shabda_en_bucket(load8(spell))), r);
    return 0;
}

# The rule table, built on first use (on the default heap) and kept.
fn _shabda_en_rules_table(): i64 {
    if (_SHABDA_EN_RULES != 0) { return _SHABDA_EN_RULES; }
    var tab = vec_new();
    var k = 0;
    while (k < 27) { vec_push(tab, vec_new()); k = k + 1; }
    _shabda_en_rules_a_e(tab);
    _shabda_en_rules_f_n(tab);
    _shabda_en_rules_o_s(tab);
    _shabda_en_rules_t_z(tab);
    _shabda_en_stress_lists();
    _SHABDA_EN_RULES = tab;
    return tab;
}

# ASCII alphabetic test (Rust char::is_alphabetic for ASCII inputs). The Hindi, Sanskrit
# and Arabic rules use it for their romanized input.
#must_use
fn _shabda_rules_is_ascii_alpha(cp): i64 {
    if (cp >= 0x61) { if (cp <= 0x7A) { return 1; } }
    if (cp >= 0x41) { if (cp <= 0x5A) { return 1; } }
    return 0;
}

# ---- character classes over the word, with a boundary outside it ----------------
# The letter at i, or 32 (a boundary) outside the word or at a non-letter. An
# apostrophe stays itself so the rules can name it.
fn _shabda_en_ch(chars, i): i64 {
    if (i < 0) { return 32; }
    if (i >= vec_len(chars)) { return 32; }
    var c = vec_get(chars, i);
    if (c >= 97 && c <= 122) { return c; }
    if (c == 39) { return 39; }
    return 32;
}

fn _shabda_en_is_vowel(c): i64 {
    if (c == 97 || c == 101 || c == 105 || c == 111 || c == 117) { return 1; }
    return 0;
}

fn _shabda_en_is_cons(c): i64 {
    if (c < 97 || c > 122) { return 0; }
    if (_shabda_en_is_vowel(c) == 1) { return 0; }
    return 1;
}

fn _shabda_en_is_voiced(c): i64 {
    if (c == 98 || c == 100 || c == 118 || c == 103 || c == 106 || c == 108) { return 1; }
    if (c == 109 || c == 110 || c == 114 || c == 119 || c == 122) { return 1; }
    return 0;
}

fn _shabda_en_is_front(c): i64 {
    if (c == 101 || c == 105 || c == 121) { return 1; }
    return 0;
}

fn _shabda_en_is_sib1(c): i64 {
    if (c == 115 || c == 99 || c == 103 || c == 122 || c == 120 || c == 106) { return 1; }
    return 0;
}

fn _shabda_en_is_at1(c): i64 {
    if (c == 116 || c == 115 || c == 114 || c == 100 || c == 108 || c == 122) { return 1; }
    if (c == 110 || c == 106) { return 1; }
    return 0;
}

# LEFT context `pat` against the letters before `pos`, read right to left. 1 or 0.
fn _shabda_en_left_ok(chars, pos, pat): i64 {
    var t = pos - 1;
    var k = strlen(pat) - 1;
    while (k >= 0) {
        var p = load8(pat + k);
        var c = _shabda_en_ch(chars, t);
        if (p == 35) {                                       # '#'
            if (_shabda_en_is_vowel(c) == 0) { return 0; }
            t = t - 1;
            while (_shabda_en_is_vowel(_shabda_en_ch(chars, t)) == 1) { t = t - 1; }
        } elif (p == 58) {                                   # ':'
            while (_shabda_en_is_cons(_shabda_en_ch(chars, t)) == 1) { t = t - 1; }
        } elif (p == 94) {                                   # '^'
            if (_shabda_en_is_cons(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 46) {                                   # '.'
            if (_shabda_en_is_voiced(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 43) {                                   # '+'
            if (_shabda_en_is_front(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 38) {                                   # '&'
            if (_shabda_en_is_sib1(c) == 1) {
                t = t - 1;
            } elif (c == 104 && (_shabda_en_ch(chars, t - 1) == 99 || _shabda_en_ch(chars, t - 1) == 115)) {
                t = t - 2;
            } else { return 0; }
        } elif (p == 64) {                                   # '@'
            if (_shabda_en_is_at1(c) == 1) {
                t = t - 1;
            } elif (c == 104 && (_shabda_en_ch(chars, t - 1) == 116 || _shabda_en_ch(chars, t - 1) == 99
                || _shabda_en_ch(chars, t - 1) == 115)) {
                t = t - 2;
            } else { return 0; }
        } elif (p == 32) {                                   # boundary
            if (c != 32) { return 0; }
            t = t - 1;
        } else {
            if (c != p) { return 0; }
            t = t - 1;
        }
        k = k - 1;
    }
    return 1;
}

# RIGHT context `pat` against the letters from `pos` on, read left to right. 1 or 0.
fn _shabda_en_right_ok(chars, pos, pat): i64 {
    var t = pos;
    var n = strlen(pat);
    var k = 0;
    while (k < n) {
        var p = load8(pat + k);
        var c = _shabda_en_ch(chars, t);
        if (p == 35) {
            if (_shabda_en_is_vowel(c) == 0) { return 0; }
            t = t + 1;
            while (_shabda_en_is_vowel(_shabda_en_ch(chars, t)) == 1) { t = t + 1; }
        } elif (p == 58) {
            while (_shabda_en_is_cons(_shabda_en_ch(chars, t)) == 1) { t = t + 1; }
        } elif (p == 94) {
            if (_shabda_en_is_cons(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 46) {
            if (_shabda_en_is_voiced(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 43) {
            if (_shabda_en_is_front(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 37) {                                   # '%': er e es ed ing ely
            if (c == 101) {
                t = t + 1;
                var c2 = _shabda_en_ch(chars, t);
                if (c2 == 108 && _shabda_en_ch(chars, t + 1) == 121) {
                    t = t + 2;
                } elif (c2 == 114 || c2 == 115 || c2 == 100) {
                    t = t + 1;
                }
            } elif (c == 105 && _shabda_en_ch(chars, t + 1) == 110 && _shabda_en_ch(chars, t + 2) == 103) {
                t = t + 3;
            } else { return 0; }
        } elif (p == 38) {
            if (c == 99 || c == 115) {
                if (_shabda_en_ch(chars, t + 1) == 104) { t = t + 2; } else { t = t + 1; }
            } elif (_shabda_en_is_sib1(c) == 1) {
                t = t + 1;
            } else { return 0; }
        } elif (p == 64) {
            if ((c == 116 || c == 99 || c == 115) && _shabda_en_ch(chars, t + 1) == 104) {
                t = t + 2;
            } elif (_shabda_en_is_at1(c) == 1) {
                t = t + 1;
            } else { return 0; }
        } elif (p == 32) {
            if (c != 32) { return 0; }
            t = t + 1;
        } else {
            if (c != p) { return 0; }
            t = t + 1;
        }
        k = k + 1;
    }
    return 1;
}

# 1 if rule `r`'s MATCH spells the letters at `pos` and both contexts fit.
fn _shabda_en_fits(chars, pos, r): i64 {
    var m = load64(r + SHABDA_EN_MATCH);
    var ml = load64(r + SHABDA_EN_MLEN);
    var k = 0;
    while (k < ml) {
        if (_shabda_en_ch(chars, pos + k) != load8(m + k)) { return 0; }
        k = k + 1;
    }
    if (_shabda_en_left_ok(chars, pos, load64(r + SHABDA_EN_LEFT)) == 0) { return 0; }
    if (_shabda_en_right_ok(chars, pos + ml, load64(r + SHABDA_EN_RIGHT)) == 0) { return 0; }
    return 1;
}

# Public English engine. Returns a fresh vec of svara phoneme ordinals.
#must_use
fn shabda_english_rules(word): i64 {
    return _shabda_english_rules_a(default_alloc(), word);
}

# shabda_english_rules, with every allocation drawn from Allocator `a`. The rule table
# itself is the process's, built on the default heap (shabda_g2p_new builds it first).
#must_use
fn _shabda_english_rules_a(a, word): i64 {
    var chars = _shabda_word_chars_a(a, word);
    var out = vec_new_a(a);
    var tab = _shabda_en_rules_table();
    var n = vec_len(chars);
    var i = 0;
    while (i < n) {
        var c = vec_get(chars, i);
        if (c == 45) {                                       # '-': a pause
            _shabda_vec_push_a(a, out, SVARA_PH_SILENCE);
            i = i + 1;
            continue;
        }
        var b = _shabda_en_bucket(_shabda_en_ch(chars, i));
        if (b < 0) { i = i + 1; continue; }                  # not a letter: no sound
        var rules = vec_get(tab, b);
        var nr = vec_len(rules);
        var step = 1;
        var k = 0;
        while (k < nr) {
            var r = vec_get(rules, k);
            if (_shabda_en_fits(chars, i, r) == 1) {
                var ph = load64(r + SHABDA_EN_PH);
                var q = 0;
                while (q < vec_len(ph)) { _shabda_vec_push_a(a, out, vec_get(ph, q)); q = q + 1; }
                step = load64(r + SHABDA_EN_MLEN);
                break;
            }
            k = k + 1;
        }
        i = i + step;
    }
    _shabda_en_ed_voicing(chars, out);
    _shabda_en_reduce(chars, out);
    return out;
}

# The -ed of a past tense after a silent e is /t/ after a voiceless consonant and /d/
# otherwise ("walked", "played", "hoped"): the letter rules only see letters, and y or
# a vowel before the e is neither of their voiced-consonant contexts. Fixes the output
# in place.
fn _shabda_en_ed_voicing(chars, out): i64 {
    var n = vec_len(out);
    if (vec_len(chars) < 4 || n < 2) { return 0; }
    if (_shabda_en_ends(chars, "ed") == 0) { return 0; }
    var last = vec_get(out, n - 1);
    if (last != SVARA_PH_PLOSIVE_T && last != SVARA_PH_PLOSIVE_D) { return 0; }
    var prev = vec_get(out, n - 2);
    if (prev == SVARA_PH_PLOSIVE_T || prev == SVARA_PH_PLOSIVE_D) { return 0; }
    if (prev == SVARA_PH_PLOSIVE_P || prev == SVARA_PH_PLOSIVE_K || prev == SVARA_PH_FRIC_F
      || prev == SVARA_PH_FRIC_S || prev == SVARA_PH_FRIC_SH || prev == SVARA_PH_AFFR_CH
      || prev == SVARA_PH_FRIC_TH) {
        vec_set(out, n - 1, SVARA_PH_PLOSIVE_T);
    } else {
        vec_set(out, n - 1, SVARA_PH_PLOSIVE_D);
    }
    return 0;
}

# ---- vowel reduction --------------------------------------------------------------------
# Letter rules cannot see stress, so they give a full vowel where English reduces an
# unstressed one to schwa: CMUdict's AH0 in "abandon", "absolute", "academy". This pass
# predicts the primary stress, keeps a secondary two syllables before it (CMUdict's 2),
# and turns AA, AE, AH, AO and EH in every other syllable into schwa. IH, IY, UW, the
# diphthongs and ER stay: CMUdict keeps them unstressed (IH0, IY0, OW0).
#
# The stress guess, in order: a stress-taking suffix (-ee, -eer, -ese, -ique, -oon,
# -ette, -esque, -aire, -ade) stresses the last syllable; -ity, -ify, -ible, -ical,
# -graphy, -logy, -ometer, -inal, -itive, -ative stress the third from last; -tion,
# -sion, -cian, -tian, -ic, -ically, -ial, -ian, -ious, -eous, -ual, -uous, -ient,
# -ience, -itis, -osis the second from last. Otherwise a two-syllable word is stressed
# on the first syllable unless it starts with an unstressed prefix (a-, be-, de-, re-,
# con-, ex-, …) before a consonant; a longer word follows the Latin rule: the second
# from last if that syllable is heavy (a long vowel or diphthong, or two consonants
# after it), else the third from last. Measured on CMUdict: +3.5 points of exact words
# on both halves (the 3.1.3 CHANGELOG entry).

# 1 if the last letters of `chars` spell `suf`.
fn _shabda_en_ends(chars, suf): i64 {
    var n = vec_len(chars);
    var m = strlen(suf);
    if (m > n) { return 0; }
    var k = 0;
    while (k < m) {
        if (vec_get(chars, n - m + k) != load8(suf + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# 1 if `chars` starts with `pre`, has more than two letters after it, and the letter
# right after it is a consonant.
fn _shabda_en_unstressed_prefix(chars, pre): i64 {
    var n = vec_len(chars);
    var m = strlen(pre);
    if (n <= m + 2) { return 0; }
    var k = 0;
    while (k < m) {
        if (vec_get(chars, k) != load8(pre + k)) { return 0; }
        k = k + 1;
    }
    if (_shabda_en_is_vowel(_shabda_en_ch(chars, m)) == 1) { return 0; }
    return 1;
}

fn _shabda_en_any_suffix(chars, list, count): i64 {
    var k = 0;
    while (k < count) {
        if (_shabda_en_ends(chars, load64(list + k * 8)) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

var _SHABDA_EN_SUF_LAST = 0;
var _SHABDA_EN_SUF_ANTE = 0;
var _SHABDA_EN_SUF_PEN = 0;
var _SHABDA_EN_PREFIXES = 0;
var _SHABDA_EN_PREFIXES2 = 0;

# A list of 17 cstring pointers, built once on the default heap ("" fills the tail).
fn _shabda_en_list(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16): i64 {
    var l = alloc(17 * 8);
    store64(l, a0); store64(l + 8, a1); store64(l + 16, a2); store64(l + 24, a3);
    store64(l + 32, a4); store64(l + 40, a5); store64(l + 48, a6); store64(l + 56, a7);
    store64(l + 64, a8); store64(l + 72, a9); store64(l + 80, a10); store64(l + 88, a11);
    store64(l + 96, a12); store64(l + 104, a13); store64(l + 112, a14); store64(l + 120, a15);
    store64(l + 128, a16);
    return l;
}

fn _shabda_en_stress_lists(): i64 {
    if (_SHABDA_EN_SUF_LAST != 0) { return 0; }
    _SHABDA_EN_SUF_ANTE = _shabda_en_list("ity", "ify", "ible", "ical", "graphy", "logy", "ometer",
      "inal", "itive", "ative", "", "", "", "", "", "", "");
    _SHABDA_EN_SUF_PEN = _shabda_en_list("tion", "sion", "cian", "tian", "ic", "ical", "ically", "ial",
      "ian", "ious", "eous", "ual", "uous", "ient", "ience", "itis", "osis");
    _SHABDA_EN_PREFIXES = _shabda_en_list("a", "be", "de", "re", "pre", "con", "com", "ex", "in", "dis",
      "mis", "ob", "sub", "per", "pro", "sus", "e");
    _SHABDA_EN_PREFIXES2 = _shabda_en_list("en", "em", "ad", "ac", "ap", "as", "at", "af", "al", "an",
      "ar", "im", "un", "for", "fore", "", "");
    _SHABDA_EN_SUF_LAST = _shabda_en_list("ee", "eer", "ese", "ique", "oon", "ette", "esque", "aire",
      "ade", "", "", "", "", "", "", "", "");
    return 0;
}

fn _shabda_en_is_long(ph): i64 {
    if (ph >= SVARA_PH_DIPH_AI && ph <= SVARA_PH_DIPH_OU) { return 1; }
    if (ph == SVARA_PH_VOWEL_LONG_I || ph == SVARA_PH_VOWEL_U || ph == SVARA_PH_VOWEL_O) { return 1; }
    return 0;
}

fn _shabda_en_is_nucleus(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

fn _shabda_en_reducible(ph): i64 {
    if (ph == SVARA_PH_VOWEL_OPEN_A || ph == SVARA_PH_VOWEL_ASH || ph == SVARA_PH_VOWEL_CUP_V) { return 1; }
    if (ph == SVARA_PH_VOWEL_OPEN_O || ph == SVARA_PH_VOWEL_OPEN_E) { return 1; }
    return 0;
}

# The predicted primary-stress syllable (0-based) of an `n`-syllable word.
fn _shabda_en_stress_index(chars, out, n): i64 {
    if (n <= 1) { return 0; }
    if (_shabda_en_any_suffix(chars, _SHABDA_EN_SUF_LAST, 9) == 1) { return n - 1; }
    if (n >= 3 && _shabda_en_any_suffix(chars, _SHABDA_EN_SUF_ANTE, 10) == 1) { return n - 3; }
    if (_shabda_en_any_suffix(chars, _SHABDA_EN_SUF_PEN, 17) == 1) { return n - 2; }
    if (n == 2) {
        var k = 0;
        while (k < 17) {
            if (_shabda_en_unstressed_prefix(chars, load64(_SHABDA_EN_PREFIXES + k * 8)) == 1) { return 1; }
            k = k + 1;
        }
        k = 0;
        while (k < 15) {
            if (_shabda_en_unstressed_prefix(chars, load64(_SHABDA_EN_PREFIXES2 + k * 8)) == 1) { return 1; }
            k = k + 1;
        }
        return 0;
    }
    # Latin rule over the last two nuclei.
    var pen = 0 - 1;
    var fin = 0 - 1;
    var i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { pen = fin; fin = i; }
        i = i + 1;
    }
    if (_shabda_en_is_long(vec_get(out, pen)) == 1 || fin - pen - 1 >= 2) { return n - 2; }
    return n - 3;
}

# Reduce the unstressed full vowels of `out` (in place) to schwa.
fn _shabda_en_reduce(chars, out): i64 {
    _shabda_en_stress_lists();
    var n = 0;
    var i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { n = n + 1; }
        i = i + 1;
    }
    if (n <= 1) { return 0; }
    var s = _shabda_en_stress_index(chars, out, n);
    var k = 0;
    i = 0;
    while (i < vec_len(out)) {
        var ph = vec_get(out, i);
        if (_shabda_en_is_nucleus(ph) == 1) {
            if (k != s && k != s - 2 && _shabda_en_reducible(ph) == 1) { vec_set(out, i, SVARA_PH_VOWEL_SCHWA); }
            k = k + 1;
        }
        i = i + 1;
    }
    # A schwa, r and a vowel after a first syllable is CMUdict's ER0 + vowel ("memory",
    # "accessory"): the r is the vowel's colouring, not a consonant of its own.
    i = 1;
    while (i + 2 < vec_len(out)) {
        if (vec_get(out, i) == SVARA_PH_VOWEL_SCHWA && vec_get(out, i + 1) == SVARA_PH_APPROX_R
          && _shabda_en_is_nucleus(vec_get(out, i + 2)) == 1) {
            vec_set(out, i, SVARA_PH_VOWEL_BIRD);
            vec_remove(out, i + 1);
        }
        i = i + 1;
    }
    # A medial /ɪ/ after a full vowel is unstressed and reduces too ("accident", "ability").
    n = 0;
    i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { n = n + 1; }
        i = i + 1;
    }
    if (n < 3) { return 0; }
    k = 0;
    var prev = 0 - 1;
    i = 0;
    while (i < vec_len(out)) {
        var q = vec_get(out, i);
        if (_shabda_en_is_nucleus(q) == 1) {
            if (k > 0 && k < n - 1 && q == SVARA_PH_VOWEL_NEAR_I && prev != SVARA_PH_VOWEL_SCHWA) {
                vec_set(out, i, SVARA_PH_VOWEL_SCHWA);
            }
            prev = vec_get(out, i);
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ---- the rules, by first letter -------------------------------------------------------
# NRL Report 7948's rules in its order, its phoneme codes written as ARPABET (its AX is
# AH0, its AH is AH1). Lines marked `+` are additions beyond NRL (see the CHANGELOG).
fn _shabda_en_rules_a_e(t): i64 {
    # a
    _shabda_en_r(t, "", "a", " ", "AH0");
    _shabda_en_r(t, "", "ay", "", "EY1");
    _shabda_en_r(t, "", "a", "x", "AE1");
    _shabda_en_r(t, "", "alm", "", "AA1 M");
    _shabda_en_r(t, "#:", "ance", " ", "AH0 N S");
    _shabda_en_r(t, "#:", "ancy", " ", "AH0 N S IY0");
    _shabda_en_r(t, "#:", "ant", " ", "AH0 N T");
    _shabda_en_r(t, "#:", "ants", " ", "AH0 N T S");
    _shabda_en_r(t, " ", "are", " ", "AA1 R");
    _shabda_en_r(t, " ", "ar", "o", "AH0 R");
    _shabda_en_r(t, "", "ar", "#", "EH1 R");
    _shabda_en_r(t, "^", "as", "#", "EY1 S");
    _shabda_en_r(t, "", "a", "wa", "AH0");
    _shabda_en_r(t, "", "aw", "", "AO1");
    _shabda_en_r(t, " :", "any", "", "EH1 N IY0");
    _shabda_en_r(t, "", "a", "^+#", "EY1");
    _shabda_en_r(t, "#:", "ally", "", "AH0 L IY0");
    _shabda_en_r(t, " ", "al", "#", "AH0 L");
    _shabda_en_r(t, "", "again", "", "AH0 G EH1 N");
    _shabda_en_r(t, "#:", "ag", "e", "IH0 JH");
    _shabda_en_r(t, "", "a", "^+:#", "AE1");
    _shabda_en_r(t, " :", "a", "^+ ", "EY1");
    _shabda_en_r(t, "", "a", "^%", "EY1");
    _shabda_en_r(t, " ", "arr", "", "AH0 R");
    _shabda_en_r(t, "", "arr", "", "AE1 R");
    _shabda_en_r(t, " :", "ar", " ", "AA1 R");
    _shabda_en_r(t, "", "ar", " ", "ER0");
    _shabda_en_r(t, "", "ar", "", "AA1 R");
    _shabda_en_r(t, "", "air", "", "EH1 R");
    _shabda_en_r(t, "", "ai", "", "EY1");
    _shabda_en_r(t, "", "au", "", "AO1");
    _shabda_en_r(t, "#:", "al", " ", "AH0 L");
    _shabda_en_r(t, "#:", "als", " ", "AH0 L Z");
    _shabda_en_r(t, "", "alk", "", "AO1 K");
    _shabda_en_r(t, "", "al", "^", "AO1 L");
    _shabda_en_r(t, " :", "able", "", "EY1 B AH0 L");
    _shabda_en_r(t, "", "able", "", "AH0 B AH0 L");
    _shabda_en_r(t, "", "ang", "+", "EY1 N JH");
    _shabda_en_r(t, "", "a", "", "AE1");
    # b
    _shabda_en_r(t, "b", "b", "", "");
    _shabda_en_r(t, " ", "be", "^#", "B IH0");
    _shabda_en_r(t, "", "being", "", "B IY1 IH0 NG");
    _shabda_en_r(t, " ", "both", " ", "B OW1 TH");
    _shabda_en_r(t, " ", "bus", "#", "B IH1 Z");
    _shabda_en_r(t, "", "buil", "", "B IH1 L");
    _shabda_en_r(t, "m", "b", " ", "");                                     # + lamb, climb
    _shabda_en_r(t, "", "b", "t ", "");                                     # + debt, doubt
    _shabda_en_r(t, "", "b", "", "B");
    # c
    _shabda_en_r(t, "", "cc", "+", "K S");
    _shabda_en_r(t, "", "cc", "", "K");
    _shabda_en_r(t, " ", "ch", "^", "K");
    _shabda_en_r(t, "^e", "ch", "", "K");
    _shabda_en_r(t, "", "ch", "", "CH");
    _shabda_en_r(t, " s", "ci", "#", "S AY1");
    _shabda_en_r(t, "", "ci", "a", "SH");
    _shabda_en_r(t, "", "ci", "o", "SH");
    _shabda_en_r(t, "", "ci", "en", "SH");
    _shabda_en_r(t, "", "c", "+", "S");
    _shabda_en_r(t, "", "ck", "", "K");
    _shabda_en_r(t, "", "com", "%", "K AH1 M");
    _shabda_en_r(t, "", "c", "", "K");
    # d
    _shabda_en_r(t, "d", "d", "", "");
    _shabda_en_r(t, "", "dg", "+", "JH");
    _shabda_en_r(t, "", "dj", "", "JH");
    _shabda_en_r(t, "#:", "ded", " ", "D IH0 D");
    _shabda_en_r(t, ".e", "d", " ", "D");
    _shabda_en_r(t, "#:^e", "d", " ", "T");
    _shabda_en_r(t, " ", "de", "^#", "D IH0");
    _shabda_en_r(t, " ", "do", " ", "D UW1");
    _shabda_en_r(t, " ", "does", "", "D AH1 Z");
    _shabda_en_r(t, " ", "doing", "", "D UW1 IH0 NG");
    _shabda_en_r(t, " ", "dow", "", "D AW1");
    _shabda_en_r(t, "", "du", "a", "JH UW1");
    _shabda_en_r(t, "", "d", "", "D");
    # e
    _shabda_en_r(t, "#:", "ence", " ", "AH0 N S");
    _shabda_en_r(t, "#:", "ency", " ", "AH0 N S IY0");
    _shabda_en_r(t, "#:", "ent", " ", "AH0 N T");
    _shabda_en_r(t, "#:", "ents", " ", "AH0 N T S");
    _shabda_en_r(t, "#:", "e", " ", "");
    _shabda_en_r(t, "'^:", "e", " ", "");
    _shabda_en_r(t, " :", "e", " ", "IY1");
    _shabda_en_r(t, "#", "ed", " ", "D");
    _shabda_en_r(t, "#:", "e", "d ", "");
    _shabda_en_r(t, "#:", "ere", " ", "IH1 R");
    _shabda_en_r(t, " :", "ere", " ", "IH1 R");
    _shabda_en_r(t, "", "ey", "", "IY0");
    _shabda_en_r(t, "", "ev", "er", "EH1 V");
    _shabda_en_r(t, "", "e", "^%", "IY1");
    _shabda_en_r(t, "", "eri", "#", "IY1 R IY0");
    _shabda_en_r(t, "", "eri", "", "EH1 R IH0");
    _shabda_en_r(t, "#:", "er", "#", "ER0");
    _shabda_en_r(t, "", "er", "#", "EH1 R");
    _shabda_en_r(t, "", "er", "", "ER0");
    _shabda_en_r(t, " ", "even", "", "IY1 V EH0 N");
    _shabda_en_r(t, "#:", "e", "w", "");
    _shabda_en_r(t, "@", "ew", "", "UW1");
    _shabda_en_r(t, "", "ew", "", "Y UW1");
    _shabda_en_r(t, "", "e", "o", "IY0");
    _shabda_en_r(t, "#:&", "es", " ", "IH0 Z");
    _shabda_en_r(t, "#:", "e", "s ", "");
    _shabda_en_r(t, "#:", "ely", " ", "L IY0");
    _shabda_en_r(t, "#:", "ement", "", "M AH0 N T");
    _shabda_en_r(t, "", "eful", "", "F UH0 L");
    _shabda_en_r(t, "", "ee", "", "IY1");
    _shabda_en_r(t, "", "ear", "#", "IH1 R");
    _shabda_en_r(t, "", "ear", " ", "IH1 R");
    _shabda_en_r(t, "", "ear", "s ", "IH1 R");
    _shabda_en_r(t, "", "earn", "", "ER1 N");
    _shabda_en_r(t, " ", "ear", "^", "ER1");
    _shabda_en_r(t, "", "ead", "", "EH1 D");
    _shabda_en_r(t, "#:", "ea", " ", "IY0 AH0");
    _shabda_en_r(t, "", "ea", "su", "EH1");
    _shabda_en_r(t, "", "ea", "", "IY1");
    _shabda_en_r(t, "", "eigh", "", "EY1");
    _shabda_en_r(t, "", "ei", "", "IY1");
    _shabda_en_r(t, " ", "eye", "", "AY1");
    _shabda_en_r(t, "", "eu", "", "Y UW1");
    _shabda_en_r(t, "", "e", "", "EH1");
    return 0;
}

fn _shabda_en_rules_f_n(t): i64 {
    # f
    _shabda_en_r(t, "f", "f", "", "");
    _shabda_en_r(t, "", "ful", "", "F UH0 L");
    _shabda_en_r(t, "", "f", "", "F");
    # g
    _shabda_en_r(t, "", "giv", "", "G IH1 V");
    _shabda_en_r(t, " ", "g", "i^", "G");
    _shabda_en_r(t, "", "ge", "t", "G EH1");
    _shabda_en_r(t, "su", "gges", "", "G JH EH1 S");
    _shabda_en_r(t, "", "gg", "", "G");
    _shabda_en_r(t, " b#", "g", "", "G");
    _shabda_en_r(t, " ", "gn", "", "N");                                    # + gnome, gnaw
    _shabda_en_r(t, "", "gn", " ", "N");                                    # + sign, design
    _shabda_en_r(t, "", "g", "+", "JH");
    _shabda_en_r(t, "", "great", "", "G R EY1 T");
    _shabda_en_r(t, "#", "gh", "", "");
    _shabda_en_r(t, "", "g", "", "G");
    # h
    _shabda_en_r(t, " ", "hav", "", "HH AE1 V");
    _shabda_en_r(t, " ", "here", "", "HH IH1 R");
    _shabda_en_r(t, " ", "hour", "", "AW1 ER0");
    _shabda_en_r(t, "", "how", "", "HH AW1");
    _shabda_en_r(t, "", "h", "#", "HH");
    _shabda_en_r(t, "", "h", "", "");
    # i
    _shabda_en_r(t, "#:^", "ity", " ", "AH0 T IY0");
    _shabda_en_r(t, "", "ible", "", "AH0 B AH0 L");
    _shabda_en_r(t, "t", "ive", " ", "IH0 V");
    _shabda_en_r(t, "s", "ive", " ", "IH0 V");
    _shabda_en_r(t, " ", "in", "", "IH0 N");
    _shabda_en_r(t, " ", "i", " ", "AY1");
    _shabda_en_r(t, "", "in", "d", "AY1 N");
    _shabda_en_r(t, "", "ier", "", "IY0 ER0");
    _shabda_en_r(t, "#:r", "ied", "", "IY0 D");
    _shabda_en_r(t, "", "ied", " ", "AY1 D");
    _shabda_en_r(t, "", "ien", "", "IY0 EH0 N");
    _shabda_en_r(t, "", "ie", "t", "AY1 EH0");
    _shabda_en_r(t, "", "ie", "^e", "IY1");
    _shabda_en_r(t, " :", "i", "%", "AY1");
    _shabda_en_r(t, "", "i", "%", "IY1");
    _shabda_en_r(t, "", "ie", "", "IY1");
    _shabda_en_r(t, "#:^", "i", "#", "IY0");
    _shabda_en_r(t, "", "i", "^+:#", "IH1");
    _shabda_en_r(t, "", "ir", "#", "AY1 R");
    _shabda_en_r(t, "", "iz", "%", "AY1 Z");
    _shabda_en_r(t, "", "is", "%", "AY1 Z");
    _shabda_en_r(t, "", "i", "d%", "AY1");
    _shabda_en_r(t, "+^", "i", "^+", "IH1");
    _shabda_en_r(t, "", "i", "t%", "AY1");
    _shabda_en_r(t, "#:^", "i", "^+", "IH1");
    _shabda_en_r(t, "", "i", "^+", "AY1");
    _shabda_en_r(t, "", "ir", "", "ER1");
    _shabda_en_r(t, "", "igh", "", "AY1");
    _shabda_en_r(t, "", "ild", "", "AY1 L D");
    _shabda_en_r(t, "", "ign", " ", "AY1 N");
    _shabda_en_r(t, "", "ign", "^", "AY1 N");
    _shabda_en_r(t, "", "ign", "%", "AY1 N");
    _shabda_en_r(t, "", "ique", "", "IY1 K");
    _shabda_en_r(t, "", "i", "", "IH1");
    # j
    _shabda_en_r(t, "", "j", "", "JH");
    # k
    _shabda_en_r(t, " ", "k", "n", "");
    _shabda_en_r(t, "", "k", "", "K");
    # l
    _shabda_en_r(t, "", "lo", "c#", "L OW1");
    _shabda_en_r(t, "l", "l", "", "");
    _shabda_en_r(t, "#:^", "l", "%", "AH0 L");
    _shabda_en_r(t, "", "lead", "", "L IY1 D");
    _shabda_en_r(t, "", "l", "", "L");
    # m
    _shabda_en_r(t, "m", "m", "", "");
    _shabda_en_r(t, "#:", "ment", "", "M AH0 N T");
    _shabda_en_r(t, "", "mov", "", "M UW1 V");
    _shabda_en_r(t, "", "m", "", "M");
    # n
    _shabda_en_r(t, "n", "n", "", "");
    _shabda_en_r(t, "e", "ng", "+", "N JH");
    _shabda_en_r(t, "", "ng", "r", "NG G");
    _shabda_en_r(t, "", "ng", "#", "NG G");
    _shabda_en_r(t, "", "ngl", "%", "NG G AH0 L");
    _shabda_en_r(t, "", "ng", "", "NG");
    _shabda_en_r(t, "", "nk", "", "NG K");
    _shabda_en_r(t, " ", "now", " ", "N AW1");
    _shabda_en_r(t, "", "n", "", "N");
    return 0;
}

fn _shabda_en_rules_o_s(t): i64 {
    # o
    _shabda_en_r(t, "", "of", " ", "AH0 V");
    _shabda_en_r(t, "", "oy", "", "OY1");
    _shabda_en_r(t, "", "orough", "", "ER1 OW0");
    _shabda_en_r(t, "#:", "or", " ", "ER0");
    _shabda_en_r(t, "#:", "ors", " ", "ER0 Z");
    _shabda_en_r(t, "", "or", "", "AO1 R");
    _shabda_en_r(t, " ", "one", "", "W AH1 N");
    _shabda_en_r(t, "", "ow", "", "OW1");
    _shabda_en_r(t, " ", "over", "", "OW1 V ER0");
    _shabda_en_r(t, "", "ov", "", "AH1 V");
    _shabda_en_r(t, "", "o", "^%", "OW1");
    _shabda_en_r(t, "", "o", "^en", "OW1");
    _shabda_en_r(t, "", "o", "^i#", "OW1");
    _shabda_en_r(t, "", "ol", "d", "OW1 L");
    _shabda_en_r(t, "", "ought", "", "AO1 T");
    _shabda_en_r(t, "", "ough", "", "AH1 F");
