    _tt_add(tt, "ृ", "ṛ");
    _tt_add(tt, "े", "e");
    _tt_add(tt, "ै", "ai");
    _tt_add(tt, "ो", "o");
    _tt_add(tt, "ौ", "au");
    _tt_add(tt, "क", "ka");
    _tt_add(tt, "ख", "kha");
    _tt_add(tt, "ग", "ga");
    _tt_add(tt, "घ", "gha");
    _tt_add(tt, "ङ", "ṅa");
    _tt_add(tt, "च", "ca");
