var _c_phoneme_thai = 0;
fn phoneme_thai() {
    if (_c_phoneme_thai != 0) { return _c_phoneme_thai; }

    var b = phoneme_builder_with_capacity("th", "Thai", 30);
    phoneme_builder_stress(b, StressPattern.Tonal);
    # Five tones in the canonical order สามัญ / เอก / โท / ตรี / จัตวา, all from one
    # description: Tingsabadh & Abramson (1993), "Thai", JIPA 23(1), the IPA
    # Handbook illustration of Standard (Bangkok) Thai — 33 / 21 / 41 / 45 / 214.
    #
    # Corrected at 2.4.1. The falling tone โท was absent entirely and ˨˩˦ sat in its
    # slot, while slot 5 held ˩˧˥ — a value no description of Thai contains, and the
    # corpus's only other unsourced tone string (it also appears in the Lao row).
    # ˨˩˦ itself was never wrong: [214] is จัตวา, and its matching Mandarin's third
    # tone is a real coincidence, not the copy-paste the roadmap once diagnosed.
    #
    # Falling is ˦˩ [41], not the ˥˩ [51] of the Gandour tradition, because the other
    # four slots are Tingsabadh & Abramson's. Moving to ˥˩ means re-sourcing the whole
    # row to Gandour, not swapping one cell — mixing traditions is what caused this.
    var t = vec_new();
    vec_push(t, "˧");
    vec_push(t, "˨˩");
    vec_push(t, "˦˩");
    vec_push(t, "˦˥");
    vec_push(t, "˨˩˦");
    phoneme_builder_tones(b, t);
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    phoneme_builder_consonant_full(b, "t͡ɕʰ", Manner.Affricate, Place.Palatal, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ɤ", Height.CloseMid, Backness.Back, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɯ", Height.Close, Backness.Back, 0);
    _c_phoneme_thai = phoneme_builder_build(b);
    return _c_phoneme_thai;
}

var _c_phoneme_vietnamese = 0;
fn phoneme_vietnamese() {
    if (_c_phoneme_vietnamese != 0) { return _c_phoneme_vietnamese; }

    var b = phoneme_builder_with_capacity("vi", "Vietnamese", 33);
    phoneme_builder_stress(b, StressPattern.Tonal);
    # Six tones in the order ngang / huyền / sắc / hỏi / ngã / nặng, Northern (Hanoi)
    # Vietnamese after Nguyễn Văn Lợi & Edmondson (1998), which slots 4 and 6 already
    # followed (hỏi 313, ngã 3ˀ5).
    #
    # Corrected at 2.4.1: huyền was ˨˩˦, a dipping contour no description of any
    # dialect gives it — it is a low FALLING tone, [21]. This one WAS the copy-paste
    # the roadmap suspected: ˨˩˦ is Mandarin's third tone. ˨˩ not ˧˩, since [31] is
    # the Southern value and the rest of this row is Northern. No ˀ is added: N&E find
    # the breathiness speaker-variable, and tone.cyr models creak, not breathy voice.
    # nặng keeps ˨˩ˀ (Thompson 1965 / Kirby 2011) rather than N&E's ˧ˀ˨ʔ — a final ʔ
    # would assert a stopped syllable, false for open and sonorant-final rhymes.
    var t = vec_new();
    vec_push(t, "˧");
    vec_push(t, "˨˩");
    vec_push(t, "˧˥");
    vec_push(t, "˧˩˧");
    vec_push(t, "˧ˀ˥");
    vec_push(t, "˨˩ˀ");
    phoneme_builder_tones(b, t);
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "v", Manner.Fricative, Place.Labiodental, 1);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɣ", Manner.Fricative, Place.Velar, 1);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɯ", Height.Close, Backness.Back, 0);
    phoneme_builder_vowel(b, "ɤ", Height.CloseMid, Backness.Back, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ă", Height.NearOpen, Backness.Central, 0);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "ɤ̆", Height.CloseMid, Backness.Back, 0, PhonemeFeature.ExtraShort);
    _c_phoneme_vietnamese = phoneme_builder_build(b);
