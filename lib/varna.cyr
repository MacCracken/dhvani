var _c_gematria_cyrillic = 0;
# Church Slavonic letter-numerals, inherited from Greek.
#
# The rule is POSITIONAL, not genealogical: values follow the Greek numeral
# SEQUENCE slot by slot, including the three slots held by numeral-only signs
# rather than letters (stigma 6, koppa 90, sampi 900). Slavic letters were
# dropped into some of those slots and the rest of the Slavic-only letters were
# skipped. It is tempting to state this as "only letters with a Greek ancestor
# carry a value", and that is false — its own table refutes it: ц descends from
# Hebrew tsade via Glagolitic, not from any Greek letter, and carries 900 in the
# sampi slot, while ч is Slavic and carries 90 in the koppa slot. Extending this
# table by the genealogical rule will get the extension wrong.
#
# Absent, and deliberately so — char_value returns the unmapped sentinel: б, ж,
# ш, щ, ъ, ь, ы, ѣ (yat), and the big and iotated yuses ѫ ѭ ѩ. Note the
# asymmetry that makes the yuses worth naming: little yus ѧ carries 900 in Early
# Cyrillic while big yus carries nothing. я is absent as the modern ia-ligature;
# for early material the glyph written for /ja/ is ѧ, which is 900.
#
# Scope. This is the standardised (post-1300) recension. Before roughly 1300, 90
# is koppa ҁ and ч has no value; some Western Cyrillic varieties instead give
# ч=60 and ҁ=90. Variant glyphs exist for two slots — 400 is у, ѹ, ѵ (izhitsa)
# or ꙋ, and 800 is ѡ or ѿ (ot) — and only the conventional carrier is mapped
# here. Glagolitic is a different system entirely, numbering in its own
# alphabetical order, where buky=2 and zhivete=7 rather than nothing; it would
# be a separate "Glag" table, not an edit to this one.
#
# Variant glyphs and period alternatives stay OUT of this table on purpose. It
# is a canonical alphabet, and a decoder that must accept them wants an alias
# map that normalises a glyph to its canonical letter before lookup.
fn gematria_cyrillic() {
    if (_c_gematria_cyrillic != 0) { return _c_gematria_cyrillic; }
    var sys = _nsys_new("Cyrl", "Church Slavonic Numerals (standardised recension)", NumeralSystemKind.Alphabetic);
    _nsys_add(sys, "а", 1);
    _nsys_add(sys, "в", 2);
    _nsys_add(sys, "г", 3);
    _nsys_add(sys, "д", 4);
    _nsys_add(sys, "є", 5);
    _nsys_add(sys, "ѕ", 6);
    _nsys_add(sys, "з", 7);
    _nsys_add(sys, "и", 8);
    _nsys_add(sys, "ѳ", 9);
    _nsys_add(sys, "і", 10);
    _nsys_add(sys, "к", 20);
    _nsys_add(sys, "л", 30);
    _nsys_add(sys, "м", 40);
    _nsys_add(sys, "н", 50);
    _nsys_add(sys, "ѯ", 60);
    _nsys_add(sys, "о", 70);
    _nsys_add(sys, "п", 80);
    _nsys_add(sys, "ч", 90);
    _nsys_add(sys, "р", 100);
    _nsys_add(sys, "с", 200);
    _nsys_add(sys, "т", 300);
    _nsys_add(sys, "у", 400);
    _nsys_add(sys, "ф", 500);
    _nsys_add(sys, "х", 600);
    _nsys_add(sys, "ѱ", 700);
    _nsys_add(sys, "ѡ", 800);
    _nsys_add(sys, "ц", 900);
    _c_gematria_cyrillic = sys;
    return _c_gematria_cyrillic;
}

# --- transliteration.cyr ---

# src/transliteration.cyr — bidirectional script transliteration tables.
# Ported from v1.x Rust src/script/transliteration.rs (data transpiled byte-exact).
#
# TransliterationTable (40B): [0]=scheme [8]=source_script [16]=target_script
#                             [24]=forward(vec of pairs) [32]=max_target(cache|0)
# pair (16B): [0]=src(cstr) [8]=tgt(cstr)
# Requires src/util.cyr (_utf8_step). transliterate_char/reverse-lookup return 0
# when unmapped; transliterate() returns a fresh cstring.

fn _tt_new(scheme, src_script, tgt_script) {
    var tt = alloc(40);
    store64(tt, scheme);
    store64(tt + 8, src_script);
    store64(tt + 16, tgt_script);
    store64(tt + 24, vec_new());
    store64(tt + 32, 0);
    return tt;
}

fn _tt_add(tt, src, tgt) {
    var pair = alloc(16);
    store64(pair, src);
    store64(pair + 8, tgt);
    vec_push(load64(tt + 24), pair);
    store64(tt + 32, 0);
    return tt;
}

fn translit_scheme(tt) { return load64(tt); }
fn translit_source_script(tt) { return load64(tt + 8); }
fn translit_target_script(tt) { return load64(tt + 16); }
fn translit_forward(tt) { return load64(tt + 24); }

# Transliterate a single source grapheme — target cstr, or 0 if unmapped.
fn translit_char(tt, ch) {
    return _translit_lookup(tt, ch, strlen(ch));
}

# Longest target string in the table, used to size the output buffer in
# `translit_apply`. Computed on demand and memoised in the table.
fn _translit_max_target(tt) {
    var cached = load64(tt + 32);
    if (cached != 0) { return cached; }
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var max = 1;
    var i = 0;
    while (i < n) {
        var tlen = strlen(load64(vec_get(fwd, i) + 8));
        if (tlen > max) { max = tlen; }
        i = i + 1;
    }
    store64(tt + 32, max);
    return max;
}

# Look up the `len` bytes at `ch` in the forward table — target cstr, or 0.
#
# Compares in place against each source literal instead of copying the candidate
# into a NUL-terminated scratch buffer first: `translit_apply` probes up to four
# candidates per input grapheme, and allocating each one leaked a buffer per
# probe (the bump allocator never frees).
fn _translit_lookup(tt, ch, len) {
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var i = 0;
    while (i < n) {
        var pair = vec_get(fwd, i);
        var src = load64(pair);
        if (strlen(src) == len) {
            if (memeq(src, ch, len) == 1) { return load64(pair + 8); }
        }
        i = i + 1;
    }
    return 0;
}

# Reverse map (target -> source) as a hashmap; last source wins on collision.
fn translit_reverse_map(tt) {
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var rev = map_new();
    var i = 0;
    while (i < n) {
        var pair = vec_get(fwd, i);
        map_set(rev, load64(pair + 8), load64(pair));
        i = i + 1;
    }
    return rev;
}

# Transliterate a string by greedily matching the longest source sequence
# (up to 4 codepoints). Unmapped graphemes pass through unchanged.
#
# Output sizing: one input byte can expand to at most `_translit_max_target`
# bytes, since the shortest match consumes one codepoint (>= 1 byte) and emits
# at most the table's longest target. The old fixed `inlen * 4` held only
# because both bundled tables happen to shrink; a caller-built table mapping a
# short source to a long target overflowed it.
#
# Every write is still bounds-checked against `cap` and the walk is clamped to
# `inlen`, so neither a table with an unexpected expansion ratio nor malformed
# UTF-8 at the tail can run past the buffer.
fn translit_apply(tt, input) {
    var inlen = strlen(input);
    var cap = inlen * _translit_max_target(tt) + 16;
    var out = alloc(cap);
    var olen = 0;
    var p = 0;
    while (p < inlen) {
        var l1 = _utf8_step(input, p, inlen);
        var b2 = p + l1;
        var l2 = 0;
        if (b2 < inlen) { l2 = _utf8_step(input, b2, inlen); }
        var b3 = b2 + l2;
        var l3 = 0;
        if (b3 < inlen) { l3 = _utf8_step(input, b3, inlen); }
        var b4 = b3 + l3;
        var l4 = 0;
        if (b4 < inlen) { l4 = _utf8_step(input, b4, inlen); }
        var e1 = l1;
        var e2 = e1 + l2;
        var e3 = e2 + l3;
        var e4 = e3 + l4;
        var matched = 0;
        var k = 4;
        while (k >= 1 && matched == 0) {
            var elen = e1;
            if (k == 2) { elen = e2; }
            if (k == 3) { elen = e3; }
            if (k == 4) { elen = e4; }
            var rep = _translit_lookup(tt, input + p, elen);
            if (rep != 0) {
                var rlen = strlen(rep);
                if (olen + rlen + 1 > cap) { rlen = cap - olen - 1; }
                memcpy(out + olen, rep, rlen);
                olen = olen + rlen;
                p = p + elen;
                matched = 1;
            }
            k = k - 1;
        }
        if (matched == 0) {
            var passlen = l1;
            if (olen + passlen + 1 > cap) { passlen = cap - olen - 1; }
            memcpy(out + olen, input + p, passlen);
            olen = olen + passlen;
            p = p + l1;
        }
    }
    store8(out + olen, 0);
    return out;
}

# --- Pre-built tables ----------------------------------------------

