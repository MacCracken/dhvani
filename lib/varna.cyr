      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant_full(b, "ɮ", Manner.LateralFricative, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Approximants
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Clicks (dental, alveolar, lateral)
    phoneme_builder_consonant_airstream(b, "ǀ", Manner.Plosive, Place.Dental, 0, Airstream.Click);
    phoneme_builder_consonant_full(b, "ǀʰ", Manner.Plosive, Place.Dental, 0,
      Airstream.Click, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_airstream(b, "ɡǀ", Manner.Plosive, Place.Dental, 1, Airstream.Click);
    phoneme_builder_consonant_airstream(b, "ŋǀ", Manner.Nasal, Place.Dental, 1, Airstream.Click);
    phoneme_builder_consonant_airstream(b, "ǃ", Manner.Plosive, Place.Alveolar, 0, Airstream.Click);
    phoneme_builder_consonant_full(b, "ǃʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Click, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_airstream(b, "ɡǃ", Manner.Plosive, Place.Alveolar, 1, Airstream.Click);
    phoneme_builder_consonant_airstream(b, "ŋǃ", Manner.Nasal, Place.Alveolar, 1, Airstream.Click);
    phoneme_builder_consonant_full(b, "ǁ", Manner.Plosive, Place.Alveolar, 0, Airstream.Click, PhonemeFeature.Lateral);
