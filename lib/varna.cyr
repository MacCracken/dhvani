# --- error.cyr ---

# src/error.cyr — VarnaError codes for varna
#
# Cyrius has no throw/catch; fallible calls return a sentinel (0 / -1) and the
# caller checks. This enum gives stable codes for the conditions the v1.x Rust
# crate modeled as the VarnaError enum. `varna_error_str` renders a message.
#
# Ported from v1.x Rust src/error.rs (VarnaError).

enum VarnaError {
    VARNA_OK = 0;
    VARNA_UNKNOWN_LANGUAGE = 1;
    VARNA_UNKNOWN_SCRIPT = 2;
    VARNA_PHONEME_NOT_IN_INVENTORY = 3;
    VARNA_INVALID_IPA = 4;
    VARNA_WORD_NOT_FOUND = 5;
}

fn varna_error_str(code) {
    if (code == VARNA_OK) { return "ok"; }
    if (code == VARNA_UNKNOWN_LANGUAGE) { return "unknown language"; }
    if (code == VARNA_UNKNOWN_SCRIPT) { return "unknown script"; }
    if (code == VARNA_PHONEME_NOT_IN_INVENTORY) { return "phoneme not in inventory"; }
    if (code == VARNA_INVALID_IPA) { return "invalid IPA symbol"; }
    if (code == VARNA_WORD_NOT_FOUND) { return "word not found"; }
    return "unknown error";
}

# --- util.cyr ---

# src/util.cyr — shared low-level helpers.

# UTF-8 byte length of the codepoint whose lead byte is b (0-255).
# Valid lead bytes: 0x00-0x7F=1, 0xC0-0xDF=2, 0xE0-0xEF=3, 0xF0-0xF7=4.
#
# This is a pure classification of the lead byte and does NOT validate that the
# continuation bytes are present. Callers walking a buffer must clamp the result
# to the bytes they actually have — use `_utf8_step` rather than calling this
# directly, or a truncated/malformed sequence at the tail reads past the end.
fn _utf8_len(b) {
    if (b < 0x80) { return 1; }
    if (b < 0xE0) { return 2; }
    if (b < 0xF0) { return 3; }
    return 4;
}

# Bytes to advance from offset `p` in a buffer of `n` bytes, clamped so that
# `p + step <= n` and `step >= 1`.
#
# `_utf8_len` trusts the lead byte, so a truncated codepoint at the tail (a lone
# 0xF0, say) or a stray continuation byte would otherwise carry the cursor past
# the end of the buffer and let the following memcpy over-read. Clamping keeps
# every walk inside the input; malformed trailing bytes are consumed one
# codepoint's worth at a time rather than trusted.
fn _utf8_step(s, p, n) {
    if (p >= n) { return 1; }
    var len = _utf8_len(load8(s + p) & 0xFF);
    var avail = n - p;
    if (len > avail) { return avail; }
    return len;
}

# --- tone.cyr ---

# src/tone.cyr — structured tone, parsed from Chao tone-letter notation.
#
# Added at 2.2.4. Until now an inventory's tones were a vec of opaque strings:
# "˧˩˧" told a reader nothing without knowing the Chao letters by sight, and
# nothing could answer "which of these tones fall?" or "does this language have a
# checked tone?".
#
# The strings stay the source of truth and are parsed into records rather than
# transcribed by hand into a second representation — the same choice
# src/features.cyr made, for the same reason: two hand-maintained encodings of one
# fact drift apart. `tone_letters` gives the original string back, so nothing the
# old representation carried is lost.
#
# --- Chao tone letters ----------------------------------------------
# A pitch level is written U+02E5..U+02E9, extra-high down to extra-low, which
# this module normalises to the conventional 5..1 scale:
#   ˥ U+02E5 = 5   ˦ U+02E6 = 4   ˧ U+02E7 = 3   ˨ U+02E8 = 2   ˩ U+02E9 = 1
# Two further marks appear in the corpus and are recorded as features rather than
# pitch: ˀ (U+02C0) for a glottalised/creaky tone, and a final ʔ (U+0294) for a
# checked tone — the short, stopped syllable of Burmese and Literary Chinese.
#
# Tone (48B): [0]=letters(cstr) [8]=contour [16]=register
#             [24]=start_level  [32]=end_level [40]=features

enum ToneContour {
    TONE_LEVEL = 0;
    TONE_RISING = 1;
    TONE_FALLING = 2;
    TONE_DIPPING = 3;    # falls then rises (Mandarin 214)
    TONE_PEAKING = 4;    # rises then falls
}

# Overall pitch band, from the mean of the tone's levels: >=4 high, <=2 low.
enum ToneRegister {
    TONE_HIGH = 0;
    TONE_MID = 1;
    TONE_LOW = 2;
}

enum ToneFeature {
    TONE_GLOTTALIZED = 1;   # ˀ U+02C0 — creaky phonation through the tone
    TONE_CHECKED = 2;       # final ʔ  — stopped syllable, inherently short
}

fn tone_letters(t) { return load64(t); }
fn tone_contour(t) { return load64(t + 8); }
fn tone_register(t) { return load64(t + 16); }
fn tone_start_level(t) { return load64(t + 24); }
fn tone_end_level(t) { return load64(t + 32); }
fn tone_features(t) { return load64(t + 40); }

fn tone_has_feature(t, feature) {
    if ((load64(t + 40) & feature) != 0) { return 1; }
    return 0;
}

# Is this tone a contour (its pitch moves) rather than level?
fn tone_is_contour(t) {
    if (load64(t + 8) == ToneContour.TONE_LEVEL) { return 0; }
    return 1;
}

# Parse a Chao tone-letter string into a Tone record.
#
# Unrecognised bytes are skipped rather than rejected: the notation admits marks
# this module does not model, and dropping one should degrade the record, not
# discard the tone. A string with no pitch letters at all yields a mid level tone
# so callers never receive a null.
fn tone_parse(letters) {
    var n = strlen(letters);
    var levels = vec_new();
    var feats = 0;
    var i = 0;
    while (i < n) {
        var b0 = load8(letters + i) & 0xFF;
        if (b0 == 0xCB) {
            if (i + 1 < n) {
                var b1 = load8(letters + i + 1) & 0xFF;
                # U+02E5..U+02E9 -> 5..1
                if (b1 >= 0xA5 && b1 <= 0xA9) { vec_push(levels, 5 - (b1 - 0xA5)); }
                # U+02C0 modifier glottal stop
                if (b1 == 0x80) { feats = feats | ToneFeature.TONE_GLOTTALIZED; }
            }
            i = i + 2;
        }
        elif (b0 == 0xCA) {
            # U+0294 latin letter glottal stop — a checked tone.
            if (i + 1 < n) {
                if ((load8(letters + i + 1) & 0xFF) == 0x94) { feats = feats | ToneFeature.TONE_CHECKED; }
            }
            i = i + 2;
        }
        else {
            i = i + 1;
        }
    }

    var count = vec_len(levels);
    var start = 3;
    var end = 3;
    if (count > 0) {
        start = vec_get(levels, 0);
        end = vec_get(levels, count - 1);
    }

    # Contour shape. Three or more levels can turn: a middle point below both ends
    # dips, above both ends peaks. Otherwise the shape follows start vs end.
    var contour = ToneContour.TONE_LEVEL;
    if (count >= 3) {
        var mid = vec_get(levels, 1);
        var lowest = start;
        var highest = start;
        var k = 0;
        while (k < count) {
            var lv = vec_get(levels, k);
            if (lv < lowest) { lowest = lv; }
            if (lv > highest) { highest = lv; }
            k = k + 1;
        }
        if (lowest < start && lowest < end) { contour = ToneContour.TONE_DIPPING; }
        elif (highest > start && highest > end) { contour = ToneContour.TONE_PEAKING; }
        elif (end > start) { contour = ToneContour.TONE_RISING; }
        elif (end < start) { contour = ToneContour.TONE_FALLING; }
    }
    elif (end > start) { contour = ToneContour.TONE_RISING; }
    elif (end < start) { contour = ToneContour.TONE_FALLING; }

    # Register from the mean level, rounded to nearest.
    var sum = 0;
    var j = 0;
    while (j < count) {
        sum = sum + vec_get(levels, j);
        j = j + 1;
    }
    var mean = 3;
    if (count > 0) { mean = (sum * 2 + count) / (count * 2); }
    var register = ToneRegister.TONE_MID;
    if (mean >= 4) { register = ToneRegister.TONE_HIGH; }
    if (mean <= 2) { register = ToneRegister.TONE_LOW; }

    var t = alloc(48);
    store64(t, letters);
    store64(t + 8, contour);
    store64(t + 16, register);
    store64(t + 24, start);
    store64(t + 32, end);
    store64(t + 40, feats);
    return t;
}

fn tone_contour_name(contour) {
    if (contour == ToneContour.TONE_LEVEL) { return "level"; }
    if (contour == ToneContour.TONE_RISING) { return "rising"; }
    if (contour == ToneContour.TONE_FALLING) { return "falling"; }
    if (contour == ToneContour.TONE_DIPPING) { return "dipping"; }
    if (contour == ToneContour.TONE_PEAKING) { return "peaking"; }
    return "unknown contour";
}

fn tone_register_name(register) {
    if (register == ToneRegister.TONE_HIGH) { return "high"; }
    if (register == ToneRegister.TONE_MID) { return "mid"; }
    if (register == ToneRegister.TONE_LOW) { return "low"; }
    return "unknown register";
}

# --- phoneme.cyr ---

# src/phoneme.cyr — IPA phoneme inventories, articulatory features.
#
# Ported from v1.x Rust src/phoneme/mod.rs. Records are heap structs (alloc +
# store64/load64 at 8-byte slots); enums are integer constants; IPA symbols are
# cstring literals compared with streq. Sentinel 0 = "not found" (was Option).
#
# Memory layout
#   Phoneme   (56B): [0]=ipa  [8]=kind  [16]=f0  [24]=f1  [32]=f2  [40]=airstream
#                    [48]=features (PhonemeFeature bitmask)
#                    consonant → f0=manner f1=place    f2=voiced(0/1)
#                    vowel     → f0=height f1=backness f2=rounded(0/1)
#   Inventory (40B): [0]=code  [8]=name  [16]=phonemes(vec)  [24]=stress
#                    [32]=tones(vec of Tone records | 0)

# Airstream mechanism — orthogonal to manner of articulation.
#
# Added at 2.2.0. The roadmap originally proposed folding Click/Implosive/Ejective
# into `Manner`, but they are airstream mechanisms, not manners, and the data shows
# the collision directly: /ŋǀ/ is a *nasal* click, /t͡sʼ/ an *ejective affricate*,
# /ǁ/ a *lateral* click. A single enum can only record one of the two, so that
# change would have destroyed the manner information on 19 of the 38 affected
# phonemes. PHOIBLE models the two axes separately; so do we.
#
# `Pulmonic` is the default and covers every vowel and all but 38 consonants in
# the corpus, so `phoneme_consonant` keeps its arity and sets it implicitly.
enum Airstream {
    Pulmonic = 0;
    Ejective = 1;
    Implosive = 2;
    Click = 3;
}

# Secondary articulation and phonation features, as a bitmask.
#
# Added at 2.2.1. These were previously recoverable only by inspecting the IPA
# string: /pʰ/ and /p/ differ by a character, and nothing could answer "which
# consonants in this inventory are aspirated?".
#
# A bitmask rather than a field per feature: they combine freely (Hindi /d̪ʱ/ is
# breathy *and* dental, Korean /t͡ɕ͈/ is tense *and* an affricate), several are
# rare enough that a slot each would be mostly zeroes, and 2.2.3's distinctive
# feature bundle can extend the same word.
#
# The roadmap named five (aspirated, labialized, palatalized, prenasalized, long).
# A scan of all 1,193 corpus consonants found four more that are real and
# unrepresentable without them — breathy voice carries the entire Indic voiced-
# aspirate series, and pharyngealization is the Arabic emphatic contrast — plus
# `Raised` and `Lateral`. `Velarized` is deliberately absent: no corpus segment
# needs it yet, and bits are additive.
enum PhonemeFeature {
    Aspirated = 1;        # ʰ  — voiceless aspiration
    Breathy = 2;          # ʱ  — breathy/murmured voice (Indic voiced aspirates)
    Palatalized = 4;      # ʲ
    Labialized = 8;       # ʷ
    Pharyngealized = 16;  # ˤ  — Arabic emphatics
    Tense = 32;           # ͈  — Korean fortis
    Devoiced = 64;        # ̥ / ̊ — voiceless sonorant
    Prenasalized = 128;   # homorganic nasal onset (Wolof mb, nd, ŋɡ, ɲɟ)
    Long = 256;           # ː  — geminate/long (consonants and vowels)
    Raised = 512;         # ̝  — raised articulation (Czech /r̝/)
    Lateral = 1024;       # lateral airflow, including the lateral clicks
    # --- vowel features, added at 2.2.2 (Long above is shared) ---------
    Nasalized = 2048;     # ̃  — French /ɛ̃ ɑ̃ œ̃ ɔ̃/, Guarani /ɨ̃/
    Syllabic = 4096;      # ̩  — syllabic sonorant (Sanskrit /r̩ l̩ r̩ː l̩ː/)
    ExtraShort = 8192;    # ̆  — extra-short (Vietnamese /ɤ̆/)
}

enum Manner {
    Plosive = 0;
    Nasal = 1;
    Trill = 2;
    TapFlap = 3;
    Fricative = 4;
    LateralFricative = 5;
    Approximant = 6;
    LateralApproximant = 7;
    Affricate = 8;
}

enum Place {
    Bilabial = 0;
    Labiodental = 1;
    Dental = 2;
    Alveolar = 3;
    Postalveolar = 4;
    Retroflex = 5;
    Palatal = 6;
    Velar = 7;
    Uvular = 8;
    Pharyngeal = 9;
    Glottal = 10;
    LabialVelar = 11;
}

enum Height {
    Close = 0;
    NearClose = 1;
    CloseMid = 2;
    Mid = 3;
    OpenMid = 4;
    NearOpen = 5;
    Open = 6;
}

enum Backness {
    Front = 0;
    Central = 1;
    Back = 2;
}

enum StressPattern {
    Fixed = 0;
    Free = 1;
    PitchAccent = 2;
    Tonal = 3;
}

enum PhonemeKind {
    Consonant = 0;
    Vowel = 1;
}

# --- Phoneme constructors + accessors ------------------------------

# Pulmonic consonant — the common case.
fn phoneme_consonant(ipa, manner, place, voiced) {
    return phoneme_consonant_airstream(ipa, manner, place, voiced, Airstream.Pulmonic);
}

# Consonant with an explicit airstream mechanism (ejective, implosive, click).
# Manner stays the manner: /ŋǀ/ is Nasal + Click, /t͡sʼ/ is Affricate + Ejective.
fn phoneme_consonant_airstream(ipa, manner, place, voiced, airstream) {
    return phoneme_consonant_full(ipa, manner, place, voiced, airstream, 0);
}

# Consonant with airstream and a PhonemeFeature bitmask — the full form the other
# consonant constructors delegate to.
fn phoneme_consonant_full(ipa, manner, place, voiced, airstream, features) {
    var p = alloc(56);
    store64(p, ipa);
    store64(p + 8, PhonemeKind.Consonant);
    store64(p + 16, manner);
    store64(p + 24, place);
    store64(p + 32, voiced);
    store64(p + 40, airstream);
    store64(p + 48, features);
    return p;
}

# Vowels are pulmonic egressive without exception in the corpus.
fn phoneme_vowel(ipa, height, backness, rounded) {
    return phoneme_vowel_full(ipa, height, backness, rounded, 0);
}

# Vowel carrying secondary features (length, nasalization, syllabicity).
fn phoneme_vowel_full(ipa, height, backness, rounded, features) {
    var p = alloc(56);
    store64(p, ipa);
    store64(p + 8, PhonemeKind.Vowel);
    store64(p + 16, height);
    store64(p + 24, backness);
    store64(p + 32, rounded);
    store64(p + 40, Airstream.Pulmonic);
    store64(p + 48, features);
    return p;
}

fn phoneme_ipa(p) { return load64(p); }
fn phoneme_kind(p) { return load64(p + 8); }
fn phoneme_manner(p) { return load64(p + 16); }
fn phoneme_place(p) { return load64(p + 24); }
fn phoneme_voiced(p) { return load64(p + 32); }
fn phoneme_height(p) { return load64(p + 16); }
fn phoneme_backness(p) { return load64(p + 24); }
fn phoneme_rounded(p) { return load64(p + 32); }
fn phoneme_airstream(p) { return load64(p + 40); }
fn phoneme_features(p) { return load64(p + 48); }

# Is `feature` (a PhonemeFeature constant) set on this phoneme?
fn phoneme_has_feature(p, feature) {
    if ((load64(p + 48) & feature) != 0) { return 1; }
    return 0;
}

# Is this segment breathy-voiced (murmured), whatever diacritic spells it?
#
# Ask this rather than the raw `Breathy` bit when the question is phonetic. The bit
# records the TRANSCRIPTION, and the corpus deliberately carries two, each correct in
# its own literature. Hindi, Bengali and Urdu write the Indo-Aryan voiced aspirates
# with U+02B1 ʱ and so carry `Breathy`. Sanskrit follows the Pāṇinian varga analysis
# its inventory is built on, writing all ten mahāprāṇa with U+02B0 ʰ so that the class
# Grassmann's Law and Bartholomae's Law operate over stays intact — and ⟨bʰ⟩ on a
# voiced base is the IPA chart's own example, read as murmured release, not as a claim
# of voicelessness. Retranscribing Sanskrit to match its siblings was considered at
# 2.4.1 and rejected: it would break `phoneme_find(sa, "bʰ")` for every consumer to
# fix a query that has a correct answer either way.
#
# So: a voiced segment marked `Aspirated` IS breathy. Without this, "which segments
# are breathy?" answers inconsistently across four sibling languages.
#
# For the wider class — anything that spreads the glottis, aspirates and breathy
# segments alike — use `DF_SPREAD_GLOTTIS` from src/features.cyr, which already
# derives identically from both bits.
#must_use
fn phoneme_is_breathy(p) {
    if (phoneme_has_feature(p, PhonemeFeature.Breathy) == 1) { return 1; }
    if (phoneme_voiced(p) == 1) {
        if (phoneme_has_feature(p, PhonemeFeature.Aspirated) == 1) { return 1; }
    }
    return 0;
}

# --- Inventory builder ---------------------------------------------
# The builder and the inventory share one 40-byte layout; build() is identity.

# `cap` is accepted for source compatibility with the v1.x Rust builder and is
# currently ignored: lib/vec.cyr exposes no capacity-taking constructor, so the
# backing vec always starts at its default size and grows. Kept in the signature
# rather than dropped because the bundle is a published consumer API; it becomes
# load-bearing the moment the stdlib grows `vec_new_with_capacity`.
fn phoneme_builder_with_capacity(code, name, cap) {
    var inv = alloc(40);
    store64(inv, code);
    store64(inv + 8, name);
    store64(inv + 16, vec_new());
    store64(inv + 24, StressPattern.Free);
    store64(inv + 32, 0);
    return inv;
}

fn phoneme_builder_new(code, name) {
    return phoneme_builder_with_capacity(code, name, 48);
}

fn phoneme_builder_stress(inv, pattern) {
    store64(inv + 24, pattern);
    return inv;
}

# Set the inventory's tone inventory from a vec of Chao tone-letter strings.
#
# BREAKING at 2.2.4: the strings are parsed into Tone records (src/tone.cyr), so
# `phoneme_tones` now returns a vec of records rather than a vec of cstrings. The
# builder still takes strings — that keeps the corpus declarative and means the
# letters remain the single source of truth. `tone_letters(t)` returns the original
# string, so nothing the old representation carried is lost.
fn phoneme_builder_tones(inv, tones) {
    var parsed = vec_new();
    var n = vec_len(tones);
    var i = 0;
    while (i < n) {
        vec_push(parsed, tone_parse(vec_get(tones, i)));
        i = i + 1;
    }
    store64(inv + 32, parsed);
    return inv;
}

fn phoneme_builder_consonant(inv, ipa, manner, place, voiced) {
    vec_push(load64(inv + 16), phoneme_consonant(ipa, manner, place, voiced));
    return inv;
}

# Push a consonant with a non-pulmonic airstream.
fn phoneme_builder_consonant_airstream(inv, ipa, manner, place, voiced, airstream) {
    vec_push(load64(inv + 16), phoneme_consonant_airstream(ipa, manner, place, voiced, airstream));
    return inv;
}

# Push a consonant carrying secondary features (and optionally an airstream).
fn phoneme_builder_consonant_full(inv, ipa, manner, place, voiced, airstream, features) {
    vec_push(load64(inv + 16), phoneme_consonant_full(ipa, manner, place, voiced, airstream, features));
    return inv;
}

fn phoneme_builder_vowel(inv, ipa, height, backness, rounded) {
    vec_push(load64(inv + 16), phoneme_vowel(ipa, height, backness, rounded));
    return inv;
}

# Push a vowel carrying secondary features.
fn phoneme_builder_vowel_full(inv, ipa, height, backness, rounded, features) {
    vec_push(load64(inv + 16), phoneme_vowel_full(ipa, height, backness, rounded, features));
    return inv;
}

fn phoneme_builder_phoneme(inv, p) {
    vec_push(load64(inv + 16), p);
    return inv;
}

fn phoneme_builder_build(inv) { return inv; }

# Independent copy of `inv`, safe to mutate through the `phoneme_builder_*`
# functions without touching the original.
#
# The pre-built inventories are shared singletons (see below), so this is the
# supported way to derive a modified inventory from one. The copy is shallow in
# the same sense `dialect_apply` has always been: the Phoneme records themselves
# are shared, because nothing in the API mutates a Phoneme in place — only the
# inventory's own vec, stress and tone slots, all of which are fresh here.
fn phoneme_clone(inv) {
    var out = alloc(40);
    store64(out, load64(inv));
    store64(out + 8, load64(inv + 8));
    var dst = vec_new();
    var src = load64(inv + 16);
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    store64(out + 16, dst);
    store64(out + 24, load64(inv + 24));
    store64(out + 32, load64(inv + 32));
    return out;
}

# --- Inventory accessors + queries ---------------------------------

fn phoneme_language_code(inv) { return load64(inv); }
fn phoneme_language_name(inv) { return load64(inv + 8); }
fn phoneme_list(inv) { return load64(inv + 16); }
fn phoneme_stress(inv) { return load64(inv + 24); }
fn phoneme_tones(inv) { return load64(inv + 32); }

fn phoneme_consonant_count(inv) {
    var ph = load64(inv + 16);
    var n = vec_len(ph);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (phoneme_kind(vec_get(ph, i)) == PhonemeKind.Consonant) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn phoneme_vowel_count(inv) {
    var ph = load64(inv + 16);
    var n = vec_len(ph);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (phoneme_kind(vec_get(ph, i)) == PhonemeKind.Vowel) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# Look up a phoneme by IPA symbol — returns the Phoneme ptr, or 0 if absent.
fn phoneme_find(inv, ipa) {
    var ph = load64(inv + 16);
    var n = vec_len(ph);
    var i = 0;
    while (i < n) {
        var p = vec_get(ph, i);
        if (streq(phoneme_ipa(p), ipa) == 1) { return p; }
        i = i + 1;
    }
    return 0;
}

fn phoneme_has(inv, ipa) {
    if (phoneme_find(inv, ipa) != 0) { return 1; }
    return 0;
}

# --- Pre-built inventories ------------------------------------------
#
# SHARED AND READ-ONLY since 2.1.5. Every constructor below (and every
# `script_*` / `grammar_*` / `swadesh_*` / `translit_*` / `numerals_*` /
# `allophone_*` / `phonotactics_*` / `dialect_*` / `cognate_*` constructor in the
# other modules) builds its structure once and returns the same pointer to every
# later caller.
#
# They used to rebuild on each call — `phoneme_english()` allocated an inventory,
# a vec and 36 phoneme records every time, and `registry_phonemes` called it fresh
# on every lookup. The bump allocator never frees, so a consumer polling the
# registry leaked steadily.
#
# The consequence: do NOT mutate a returned inventory through the
# `phoneme_builder_*` functions — you would be editing what every other caller
# sees. Use `phoneme_clone` first if you need a mutable copy.

var _c_phoneme_english = 0;
# English (General American): 24 consonants + 12 vowels. Stress: free.
fn phoneme_english() {
    if (_c_phoneme_english != 0) { return _c_phoneme_english; }
    var b = phoneme_builder_with_capacity("en", "English", 36);
    phoneme_builder_stress(b, StressPattern.Free);
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "v", Manner.Fricative, Place.Labiodental, 1);
    phoneme_builder_consonant(b, "θ", Manner.Fricative, Place.Dental, 0);
    phoneme_builder_consonant(b, "ð", Manner.Fricative, Place.Dental, 1);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ʃ", Manner.Fricative, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "ʒ", Manner.Fricative, Place.Postalveolar, 1);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Approximants
    phoneme_builder_consonant(b, "ɹ", Manner.Approximant, Place.Alveolar, 1);
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Affricates
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "d͡ʒ", Manner.Affricate, Place.Postalveolar, 1);
    # Vowels (General American)
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɪ", Height.NearClose, Backness.Front, 0);
    phoneme_builder_vowel(b, "eɪ", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "æ", Height.NearOpen, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "ɑː", Height.Open, Backness.Back, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "ɔː", Height.OpenMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "oʊ", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ʊ", Height.NearClose, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ʌ", Height.OpenMid, Backness.Central, 0);
    phoneme_builder_vowel(b, "ə", Height.Mid, Backness.Central, 0);
    _c_phoneme_english = phoneme_builder_build(b);
    return _c_phoneme_english;
}

var _c_phoneme_sanskrit = 0;
# Sanskrit (Classical): 36 consonants + 14 vowels. Stress: pitch accent.
fn phoneme_sanskrit() {
    if (_c_phoneme_sanskrit != 0) { return _c_phoneme_sanskrit; }
    var b = phoneme_builder_with_capacity("sa", "Sanskrit", 50);
    phoneme_builder_stress(b, StressPattern.PitchAccent);
    # Kavarga (velar)
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    phoneme_builder_consonant_full(b, "ɡʰ", Manner.Plosive, Place.Velar, 1,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Chavarga (palatal)
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    phoneme_builder_consonant_full(b, "t͡ɕʰ", Manner.Affricate, Place.Palatal, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d͡ʑ", Manner.Affricate, Place.Palatal, 1);
    phoneme_builder_consonant_full(b, "d͡ʑʰ", Manner.Affricate, Place.Palatal, 1,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    # Tavarga (retroflex)
    phoneme_builder_consonant(b, "ʈ", Manner.Plosive, Place.Retroflex, 0);
    phoneme_builder_consonant_full(b, "ʈʰ", Manner.Plosive, Place.Retroflex, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɖ", Manner.Plosive, Place.Retroflex, 1);
    phoneme_builder_consonant_full(b, "ɖʰ", Manner.Plosive, Place.Retroflex, 1,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɳ", Manner.Nasal, Place.Retroflex, 1);
    # Tavarga (dental)
    phoneme_builder_consonant(b, "t̪", Manner.Plosive, Place.Dental, 0);
    phoneme_builder_consonant_full(b, "t̪ʰ", Manner.Plosive, Place.Dental, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d̪", Manner.Plosive, Place.Dental, 1);
    phoneme_builder_consonant_full(b, "d̪ʰ", Manner.Plosive, Place.Dental, 1,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "n̪", Manner.Nasal, Place.Dental, 1);
    # Pavarga (bilabial)
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant_full(b, "bʰ", Manner.Plosive, Place.Bilabial, 1,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    # Antastha (semivowels/approximants)
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "ʋ", Manner.Approximant, Place.Labiodental, 1);
    # Ushman (sibilants/fricatives)
    phoneme_builder_consonant(b, "ɕ", Manner.Fricative, Place.Palatal, 0);
    phoneme_builder_consonant(b, "ʂ", Manner.Fricative, Place.Retroflex, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "ɦ", Manner.Fricative, Place.Glottal, 1);
    # Additional
    phoneme_builder_consonant_full(b, "ɭ", Manner.LateralApproximant, Place.Retroflex, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "kʂ", Manner.Affricate, Place.Velar, 0);
    phoneme_builder_consonant(b, "d͡ʑɲ", Manner.Affricate, Place.Palatal, 1);
    # Vowels (svara) — short
    phoneme_builder_vowel(b, "ɐ", Height.NearOpen, Backness.Central, 0);
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "r̩", Height.Close, Backness.Central, 0, PhonemeFeature.Syllabic);
    phoneme_builder_vowel_full(b, "l̩", Height.Close, Backness.Central, 0, PhonemeFeature.Syllabic);
    # Long
    phoneme_builder_vowel_full(b, "ɐː", Height.NearOpen, Backness.Central, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "r̩ː", Height.Close, Backness.Central, 0,
      PhonemeFeature.Long | PhonemeFeature.Syllabic);
    phoneme_builder_vowel_full(b, "l̩ː", Height.Close, Backness.Central, 0,
      PhonemeFeature.Long | PhonemeFeature.Syllabic);
    # Diphthongs
    phoneme_builder_vowel_full(b, "eː", Height.CloseMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɐi", Height.NearOpen, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɐu", Height.NearOpen, Backness.Back, 1);
    _c_phoneme_sanskrit = phoneme_builder_build(b);
    return _c_phoneme_sanskrit;
}

var _c_phoneme_greek = 0;
# Greek (Modern Standard): 20 consonants + 5 vowels. Stress: free.
fn phoneme_greek() {
    if (_c_phoneme_greek != 0) { return _c_phoneme_greek; }
    var b = phoneme_builder_with_capacity("el", "Greek", 25);
    phoneme_builder_stress(b, StressPattern.Free);
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "v", Manner.Fricative, Place.Labiodental, 1);
    phoneme_builder_consonant(b, "θ", Manner.Fricative, Place.Dental, 0);
    phoneme_builder_consonant(b, "ð", Manner.Fricative, Place.Dental, 1);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɣ", Manner.Fricative, Place.Velar, 1);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    # Liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    # Affricates
    phoneme_builder_consonant(b, "t͡s", Manner.Affricate, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d͡z", Manner.Affricate, Place.Alveolar, 1);
    # Vowels (5-vowel system)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    _c_phoneme_greek = phoneme_builder_build(b);
    return _c_phoneme_greek;
}

# --- features.cyr ---

# src/features.cyr — SPE/Hayes distinctive features, derived from the phoneme record.
#
# Added at 2.2.3, and deliberately **derived rather than stored**. By this point the
# record already carries manner, place, voicing, height, backness, rounding, airstream
# (2.2.0) and the secondary-articulation mask (2.2.1/2.2.2); almost every distinctive
# feature is a function of those. Storing them again would double the per-phoneme cost,
# and — worse — let the two representations drift: an inventory edited to change a
# manner would silently keep a stale [±sonorant]. Derived, that cannot happen, and the
# Phoneme record stays 56 bytes.
#
# --- Three values, not two ---------------------------------------
# Feature systems are not binary. A feature can be +, −, or genuinely *unspecified*
# for a segment: [±anterior] is only defined for coronals, [±delayed release] only for
# stops and affricates, and [±ATR] is not transcribed anywhere in this corpus at all
# (see roadmap "Data: ATR vowel systems"). Collapsing unspecified into − would assert
# things the data does not support, so the reader returns a tri-state and the two
# masks are exposed separately:
#
#   phoneme_df(p, f)         ->  1 (+),  0 (−),  (0-1) unspecified
#   phoneme_df_present(p)    ->  bitmask of features that are +
#   phoneme_df_defined(p)    ->  bitmask of features that are specified at all
#
# --- Sourcing ------------------------------------------------------
# Definitions follow Hayes, *Introductory Phonetics* (2009), ch. 4-5, which is also
# the framework PHOIBLE's feature set is closest to. Where treatments genuinely
# disagree the feature is left unspecified rather than silently resolved — the two
# cases are trills/taps for [±continuant] and central vowels for [±back], both noted
# at the point of decision below.
#
# Variant names carry a `DF_` prefix: Cyrius enum variants share one flat symbol
# namespace, and `Nasal`, `Lateral`, `Long`, `Syllabic`, `Back` and `Trill` are all
# already taken by Manner, PhonemeFeature and Backness. `VarnaError` sets the
# precedent for a prefixed enum in this tree.

enum DistinctiveFeature {
    # Major class
    DF_SYLLABIC = 1;
    DF_CONSONANTAL = 2;
    DF_SONORANT = 4;
    DF_APPROXIMANT = 8;
    # Manner
    DF_CONTINUANT = 16;
    DF_DELAYED_RELEASE = 32;
    DF_NASAL = 64;
    DF_LATERAL = 128;
    DF_STRIDENT = 256;
    DF_TRILL = 512;
    DF_TAP = 1024;
    # Laryngeal
    DF_VOICE = 2048;
    DF_SPREAD_GLOTTIS = 4096;
    DF_CONSTRICTED_GLOTTIS = 8192;
    # Place
    DF_LABIAL = 16384;
    DF_ROUND = 32768;
    DF_CORONAL = 65536;
    DF_ANTERIOR = 131072;
    DF_DISTRIBUTED = 262144;
    DF_DORSAL = 524288;
    DF_HIGH = 1048576;
    DF_LOW = 2097152;
    DF_BACK = 4194304;
    # Vowel quality / length
    DF_TENSE_ATR = 8388608;
    DF_LONG = 16777216;
}

# Every feature the enum defines, for iteration and for masking.
fn df_all_mask() {
    return 33554431;
}

fn df_count() {
    return 25;
}

# --- internal accumulator -------------------------------------------------
# Cyrius has no tuples, so the two masks are accumulated into a 2-slot record and
# both readers below pull from the same derivation.
#   acc (16B): [0]=present  [8]=defined

# One scratch record, reused for every derivation.
#
# The obvious shape is `alloc(16)` per call — but the bump allocator never frees,
# so a consumer reading features in a loop would leak 16 bytes a call (measured:
# 16,000 bytes per 1,000 reads before this was changed). That is precisely the
# defect 2.1.5 swept out of the rest of the tree, so it is not reintroduced here.
#
# Safe because the record never escapes: `_df_derive` is private, and the three
# public readers all extract an i64 from it before returning. varna is
# single-threaded; if that ever changes this becomes thread-local state.
var _df_scratch = 0;

fn _df_acc() {
    if (_df_scratch == 0) { _df_scratch = alloc(16); }
    store64(_df_scratch, 0);
    store64(_df_scratch + 8, 0);
    return _df_scratch;
}

# Record feature `f` as + (value 1) or − (value 0). Anything not passed through
# here stays unspecified.
fn _df_set(a, f, value) {
    store64(a + 8, load64(a + 8) | f);
    if (value == 1) { store64(a, load64(a) | f); }
    return a;
}

fn _df_consonant(a, p) {
    var manner = phoneme_manner(p);
    var place = phoneme_place(p);
    var air = phoneme_airstream(p);

    # --- major class ---
    _df_set(a, DistinctiveFeature.DF_SYLLABIC, 0);

    # [−consonantal] for the glottals /h ʔ/ and for the glides /j w/, which have no
    # constriction in the oral cavity; everything else is [+consonantal].
    var cons = 1;
    if (place == Place.Glottal) { cons = 0; }
    if (manner == Manner.Approximant) {
        if (place == Place.Palatal || place == Place.LabialVelar) { cons = 0; }
    }
    _df_set(a, DistinctiveFeature.DF_CONSONANTAL, cons);

    var son = 0;
    if (manner == Manner.Nasal) { son = 1; }
    if (manner == Manner.Trill) { son = 1; }
    if (manner == Manner.TapFlap) { son = 1; }
    if (manner == Manner.Approximant) { son = 1; }
    if (manner == Manner.LateralApproximant) { son = 1; }
    _df_set(a, DistinctiveFeature.DF_SONORANT, son);

    var appr = 0;
    if (manner == Manner.Approximant) { appr = 1; }
    if (manner == Manner.LateralApproximant) { appr = 1; }
    _df_set(a, DistinctiveFeature.DF_APPROXIMANT, appr);

    # --- manner ---
    # Trills and taps are left UNSPECIFIED for [±continuant] on purpose: they involve
    # intermittent closure, and treatments split on whether that counts. Asserting
    # either value would be inventing a commitment the data does not make.
    if (manner == Manner.Fricative || manner == Manner.LateralFricative) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    }
    elif (manner == Manner.Approximant || manner == Manner.LateralApproximant) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    }
    elif (manner == Manner.Plosive || manner == Manner.Nasal || manner == Manner.Affricate) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 0);
    }

    # [±delayed release] is only defined for stops and affricates.
    if (manner == Manner.Affricate) { _df_set(a, DistinctiveFeature.DF_DELAYED_RELEASE, 1); }
    elif (manner == Manner.Plosive) { _df_set(a, DistinctiveFeature.DF_DELAYED_RELEASE, 0); }

    var nas = 0;
    if (manner == Manner.Nasal) { nas = 1; }
    _df_set(a, DistinctiveFeature.DF_NASAL, nas);

    _df_set(a, DistinctiveFeature.DF_LATERAL, phoneme_has_feature(p, PhonemeFeature.Lateral));

    # [±strident] distinguishes the noisy sibilants and labiodentals from the quieter
    # obstruents at the same manner: /f v s z ʃ ʒ/ are +, /ɸ β θ ð x ɣ/ are −. It is
    # only defined for obstruents.
    if (manner == Manner.Fricative || manner == Manner.Affricate || manner == Manner.LateralFricative) {
        var strid = 0;
        if (place == Place.Labiodental) { strid = 1; }
        if (place == Place.Alveolar) { strid = 1; }
        if (place == Place.Postalveolar) { strid = 1; }
        if (place == Place.Uvular) { strid = 1; }
        # Lateral fricatives /ɬ ɮ/ are non-strident despite being alveolar.
        if (manner == Manner.LateralFricative) { strid = 0; }
        _df_set(a, DistinctiveFeature.DF_STRIDENT, strid);
    }

    var tri = 0;
    if (manner == Manner.Trill) { tri = 1; }
    _df_set(a, DistinctiveFeature.DF_TRILL, tri);
    var tap = 0;
    if (manner == Manner.TapFlap) { tap = 1; }
    _df_set(a, DistinctiveFeature.DF_TAP, tap);

    # --- laryngeal ---
    _df_set(a, DistinctiveFeature.DF_VOICE, phoneme_voiced(p));

    # Aspiration and breathy voice both spread the glottis.
    var spread = 0;
    if (phoneme_has_feature(p, PhonemeFeature.Aspirated) == 1) { spread = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Breathy) == 1) { spread = 1; }
    _df_set(a, DistinctiveFeature.DF_SPREAD_GLOTTIS, spread);

    # Ejectives and implosives use a closed glottis as the airstream source; so does
    # the glottal stop itself.
    var constr = 0;
    if (air == Airstream.Ejective || air == Airstream.Implosive) { constr = 1; }
    if (manner == Manner.Plosive && place == Place.Glottal) { constr = 1; }
    _df_set(a, DistinctiveFeature.DF_CONSTRICTED_GLOTTIS, constr);

    # --- place ---
    var lab = 0;
    if (place == Place.Bilabial || place == Place.Labiodental || place == Place.LabialVelar) { lab = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Labialized) == 1) { lab = 1; }
    _df_set(a, DistinctiveFeature.DF_LABIAL, lab);
    _df_set(a, DistinctiveFeature.DF_ROUND, phoneme_has_feature(p, PhonemeFeature.Labialized));

    var cor = 0;
    if (place == Place.Dental || place == Place.Alveolar) { cor = 1; }
    if (place == Place.Postalveolar || place == Place.Retroflex) { cor = 1; }
    _df_set(a, DistinctiveFeature.DF_CORONAL, cor);

    # [±anterior] and [±distributed] are coronal-only features.
    if (cor == 1) {
        var ant = 0;
        if (place == Place.Dental || place == Place.Alveolar) { ant = 1; }
        _df_set(a, DistinctiveFeature.DF_ANTERIOR, ant);
        # Laminal (dental, postalveolar) is [+distributed]; apical (alveolar,
        # retroflex) is [−distributed].
        var dist = 0;
        if (place == Place.Dental || place == Place.Postalveolar) { dist = 1; }
        _df_set(a, DistinctiveFeature.DF_DISTRIBUTED, dist);
    }

    var dors = 0;
    if (place == Place.Palatal || place == Place.Velar) { dors = 1; }
    if (place == Place.Uvular || place == Place.LabialVelar) { dors = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Palatalized) == 1) { dors = 1; }
    _df_set(a, DistinctiveFeature.DF_DORSAL, dors);

    # [±high/low/back] describe tongue-body position, so they are defined for dorsals
    # and for the pharyngeals that recruit the tongue root; elsewhere unspecified.
    if (dors == 1) {
        var high = 0;
        if (place == Place.Palatal || place == Place.Velar || place == Place.LabialVelar) { high = 1; }
        if (phoneme_has_feature(p, PhonemeFeature.Palatalized) == 1) { high = 1; }
        _df_set(a, DistinctiveFeature.DF_HIGH, high);
        _df_set(a, DistinctiveFeature.DF_LOW, 0);
        var back = 0;
        if (place == Place.Velar || place == Place.Uvular || place == Place.LabialVelar) { back = 1; }
        if (place == Place.Palatal) { back = 0; }
        _df_set(a, DistinctiveFeature.DF_BACK, back);
    }
    elif (place == Place.Pharyngeal) {
        _df_set(a, DistinctiveFeature.DF_HIGH, 0);
        _df_set(a, DistinctiveFeature.DF_LOW, 1);
        _df_set(a, DistinctiveFeature.DF_BACK, 1);
    }
    elif (phoneme_has_feature(p, PhonemeFeature.Pharyngealized) == 1) {
        # Arabic emphatics retract the tongue root without being pharyngeal by place.
        _df_set(a, DistinctiveFeature.DF_LOW, 1);
        _df_set(a, DistinctiveFeature.DF_BACK, 1);
    }

    # --- length; ATR is never specified (see the header) ---
    _df_set(a, DistinctiveFeature.DF_LONG, phoneme_has_feature(p, PhonemeFeature.Long));
    return a;
}

fn _df_vowel(a, p) {
    var height = phoneme_height(p);
    var backness = phoneme_backness(p);
    var rounded = phoneme_rounded(p);
    var syllabic_c = phoneme_has_feature(p, PhonemeFeature.Syllabic);

    _df_set(a, DistinctiveFeature.DF_SYLLABIC, 1);
    # Sanskrit's /r̩ l̩ r̩ː l̩ː/ are filed as vowels but are syllabic *consonants*:
    # they keep [+consonantal] where a true vowel is [−consonantal].
    _df_set(a, DistinctiveFeature.DF_CONSONANTAL, syllabic_c);
    _df_set(a, DistinctiveFeature.DF_SONORANT, 1);
    _df_set(a, DistinctiveFeature.DF_APPROXIMANT, 1);
    _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    _df_set(a, DistinctiveFeature.DF_NASAL, phoneme_has_feature(p, PhonemeFeature.Nasalized));
    _df_set(a, DistinctiveFeature.DF_LATERAL, 0);
    _df_set(a, DistinctiveFeature.DF_TRILL, 0);
    _df_set(a, DistinctiveFeature.DF_TAP, 0);
    # Every vowel in the corpus is voiced; none carries the Devoiced bit.
    _df_set(a, DistinctiveFeature.DF_VOICE, 1);
    _df_set(a, DistinctiveFeature.DF_SPREAD_GLOTTIS, 0);
    _df_set(a, DistinctiveFeature.DF_CONSTRICTED_GLOTTIS, 0);

    _df_set(a, DistinctiveFeature.DF_LABIAL, rounded);
    _df_set(a, DistinctiveFeature.DF_ROUND, rounded);
    _df_set(a, DistinctiveFeature.DF_CORONAL, 0);
    _df_set(a, DistinctiveFeature.DF_DORSAL, 1);

    var high = 0;
    if (height == Height.Close || height == Height.NearClose) { high = 1; }
    _df_set(a, DistinctiveFeature.DF_HIGH, high);
    var low = 0;
    if (height == Height.Open || height == Height.NearOpen) { low = 1; }
    _df_set(a, DistinctiveFeature.DF_LOW, low);

    # Central vowels are left UNSPECIFIED for [±back]. A two-valued feature cannot
    # express a three-way front/central/back contrast, and treatments differ on which
    # way central should fall; the Backness axis already records the truth exactly.
    if (backness == Backness.Back) { _df_set(a, DistinctiveFeature.DF_BACK, 1); }
    elif (backness == Backness.Front) { _df_set(a, DistinctiveFeature.DF_BACK, 0); }

    _df_set(a, DistinctiveFeature.DF_LONG, phoneme_has_feature(p, PhonemeFeature.Long));
    return a;
}

fn _df_derive(p) {
    var a = _df_acc();
    if (phoneme_kind(p) == PhonemeKind.Vowel) { return _df_vowel(a, p); }
    return _df_consonant(a, p);
}

# Bitmask of the distinctive features this phoneme has a **+** value for.
fn phoneme_df_present(p) {
    return load64(_df_derive(p));
}

# Bitmask of the distinctive features that are **specified** for this phoneme,
# whether + or −. A feature outside this mask is genuinely undefined for the segment,
# not merely negative.
fn phoneme_df_defined(p) {
    return load64(_df_derive(p) + 8);
}

# Tri-state read of one feature: 1 (+), 0 (−), (0-1) unspecified.
fn phoneme_df(p, feature) {
    var a = _df_derive(p);
    if ((load64(a + 8) & feature) == 0) { return 0 - 1; }
    if ((load64(a) & feature) != 0) { return 1; }
    return 0;
}

# Human-readable name for a single DistinctiveFeature constant, or "unknown feature".
fn df_name(feature) {
    if (feature == DistinctiveFeature.DF_SYLLABIC) { return "syllabic"; }
    if (feature == DistinctiveFeature.DF_CONSONANTAL) { return "consonantal"; }
    if (feature == DistinctiveFeature.DF_SONORANT) { return "sonorant"; }
    if (feature == DistinctiveFeature.DF_APPROXIMANT) { return "approximant"; }
    if (feature == DistinctiveFeature.DF_CONTINUANT) { return "continuant"; }
    if (feature == DistinctiveFeature.DF_DELAYED_RELEASE) { return "delayed release"; }
    if (feature == DistinctiveFeature.DF_NASAL) { return "nasal"; }
    if (feature == DistinctiveFeature.DF_LATERAL) { return "lateral"; }
    if (feature == DistinctiveFeature.DF_STRIDENT) { return "strident"; }
    if (feature == DistinctiveFeature.DF_TRILL) { return "trill"; }
    if (feature == DistinctiveFeature.DF_TAP) { return "tap"; }
    if (feature == DistinctiveFeature.DF_VOICE) { return "voice"; }
    if (feature == DistinctiveFeature.DF_SPREAD_GLOTTIS) { return "spread glottis"; }
    if (feature == DistinctiveFeature.DF_CONSTRICTED_GLOTTIS) { return "constricted glottis"; }
    if (feature == DistinctiveFeature.DF_LABIAL) { return "labial"; }
    if (feature == DistinctiveFeature.DF_ROUND) { return "round"; }
    if (feature == DistinctiveFeature.DF_CORONAL) { return "coronal"; }
    if (feature == DistinctiveFeature.DF_ANTERIOR) { return "anterior"; }
    if (feature == DistinctiveFeature.DF_DISTRIBUTED) { return "distributed"; }
    if (feature == DistinctiveFeature.DF_DORSAL) { return "dorsal"; }
    if (feature == DistinctiveFeature.DF_HIGH) { return "high"; }
    if (feature == DistinctiveFeature.DF_LOW) { return "low"; }
    if (feature == DistinctiveFeature.DF_BACK) { return "back"; }
    if (feature == DistinctiveFeature.DF_TENSE_ATR) { return "ATR"; }
    if (feature == DistinctiveFeature.DF_LONG) { return "long"; }
    return "unknown feature";
}

# Do two phonemes differ in exactly one specified feature? Returns that feature's
# constant, or 0 if they form no minimal pair.
#
# This is what a feature system is *for*: /p/ and /b/ differ only in [voice], /s/ and
# /ʃ/ only in [anterior]. Features that are unspecified on either side are skipped,
# since an undefined value is not a contrast.
fn phoneme_minimal_contrast(a, b) {
    var da = phoneme_df_defined(a);
    var db = phoneme_df_defined(b);
    var both_defined = da & db;
    var diff = (phoneme_df_present(a) ^ phoneme_df_present(b)) & both_defined;
    if (diff == 0) { return 0; }
    # Exactly one bit set?
    if ((diff & (diff - 1)) != 0) { return 0; }
    return diff;
}

# --- inventories.cyr ---

# src/inventories.cyr — extended language phoneme inventories.
# Ported from v1.x Rust src/phoneme/inventories.rs (transpiled, byte-exact IPA).
# Uses the phoneme.cyr builder API + enums. 48 inventories.

var _c_phoneme_yucatec_maya = 0;
fn phoneme_yucatec_maya() {
    if (_c_phoneme_yucatec_maya != 0) { return _c_phoneme_yucatec_maya; }

    var b = phoneme_builder_with_capacity("yua", "Yucatec Maya", 31);
    phoneme_builder_stress(b, StressPattern.Fixed);
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    # Ejectives
    phoneme_builder_consonant_airstream(b, "pʼ", Manner.Plosive, Place.Bilabial, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "tʼ", Manner.Plosive, Place.Alveolar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "kʼ", Manner.Plosive, Place.Velar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "t͡sʼ", Manner.Affricate, Place.Alveolar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "t͡ʃʼ", Manner.Affricate, Place.Postalveolar, 0, Airstream.Ejective);
    # Affricates
    phoneme_builder_consonant(b, "t͡s", Manner.Affricate, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    # Fricatives
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "ʃ", Manner.Fricative, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    # Approximants
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels (5 short + 5 long)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "eː", Height.CloseMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel_full(b, "aː", Height.Open, Backness.Central, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    _c_phoneme_yucatec_maya = phoneme_builder_build(b);
    return _c_phoneme_yucatec_maya;
}

