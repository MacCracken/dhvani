var _c_phoneme_burmese = 0;
fn phoneme_burmese() {
    if (_c_phoneme_burmese != 0) { return _c_phoneme_burmese; }

    var b = phoneme_builder_with_capacity("my", "Burmese", 37);
    phoneme_builder_stress(b, StressPattern.Tonal);
    # Four tones in the order high / creaky / low / checked.
    #
    # Corrected at 2.4.1: the checked ("killed") tone was ˩ʔ, a LOW level — the
    # opposite of every description. Wheatley (1987:842) has "the pitch of the checked
    # tone (high, in citation)"; Chang (2008:45) "very short duration, high pitch";
    # Gruber (2011) Table 1 "initial high, fall". ˩ʔ was the corpus's generic checked
    # placeholder, also used for Literary Chinese.
    #
    # ˥˧ʔ rather than Watkins' ˥˩ʔ because tone.cyr derives register from the rounded
    # mean of the levels: ˥˩ means 3 and would come out TONE_MID, the very register
    # this fix exists to correct, while ˥˧ means 4 and gives TONE_HIGH.
    #
    # KNOWN RESIDUE: this row is now sourced in one cell and unsourced in three. The
    # creaky and low values were reviewed and left alone (˨˩ is well supported by
    # Watkins' own F0 data), but creaky ˧ˀ now sits two levels from checked where the
    # literature puts them nearly level. The row wants a single-source pass — Wheatley
    # 1987 (˥˥˦ / ˥˧ˀ / ˧˧˦ / ˥˧ʔ) or Watkins 2001 (˦ / ˥˩ˀ / ˨ / ˥˩ʔ) — see the
    # roadmap. That is not a reason to keep a value wrong under every source.
    var t = vec_new();
    vec_push(t, "˥");
    vec_push(t, "˧ˀ");
    vec_push(t, "˨˩");
    vec_push(t, "˥˧ʔ");
    phoneme_builder_tones(b, t);
    # Bilabial plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    # Alveolar plosives
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    # Velar plosives
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Glottal stop
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    # Affricates
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    phoneme_builder_consonant_full(b, "t͡ɕʰ", Manner.Affricate, Place.Palatal, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d͡ʑ", Manner.Affricate, Place.Palatal, 1);
    # Fricatives
    phoneme_builder_consonant(b, "θ", Manner.Fricative, Place.Dental, 0);
    phoneme_builder_consonant(b, "ð", Manner.Fricative, Place.Dental, 1);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ʃ", Manner.Fricative, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Voiced nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Voiceless nasals (modal voiceless)
    phoneme_builder_consonant_full(b, "m̥", Manner.Nasal, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    phoneme_builder_consonant_full(b, "n̥", Manner.Nasal, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    phoneme_builder_consonant_full(b, "ŋ̊", Manner.Nasal, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    # Approximants & liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels (7-vowel system)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    _c_phoneme_burmese = phoneme_builder_build(b);
    return _c_phoneme_burmese;
