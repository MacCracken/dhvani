var _SHBDK_CMUDICT_PIECE_COUNT = 14;

fn _shbdk_cmudict_piece(i): cstring {
    if (i == 0) { return _SHBDK_CMUDICT_PIECE_0; }
    if (i == 1) { return _SHBDK_CMUDICT_PIECE_1; }
    if (i == 2) { return _SHBDK_CMUDICT_PIECE_2; }
    if (i == 3) { return _SHBDK_CMUDICT_PIECE_3; }
    if (i == 4) { return _SHBDK_CMUDICT_PIECE_4; }
    if (i == 5) { return _SHBDK_CMUDICT_PIECE_5; }
    if (i == 6) { return _SHBDK_CMUDICT_PIECE_6; }
    if (i == 7) { return _SHBDK_CMUDICT_PIECE_7; }
    if (i == 8) { return _SHBDK_CMUDICT_PIECE_8; }
    if (i == 9) { return _SHBDK_CMUDICT_PIECE_9; }
    if (i == 10) { return _SHBDK_CMUDICT_PIECE_10; }
    if (i == 11) { return _SHBDK_CMUDICT_PIECE_11; }
    if (i == 12) { return _SHBDK_CMUDICT_PIECE_12; }
    if (i == 13) { return _SHBDK_CMUDICT_PIECE_13; }
    return 0;
}

# --- cmudict.cyr ---

# cmudict.cyr — loads the generated base English dictionary into a hashmap.
#
# The runtime counterpart to programs/gen_cmudict.cyr: parses the packed pieces
# from _cmudict_data.cyr (entry = word|o,o,o[!ddd][~freq][^RR]; ) into a lib/hashmap
# of word(Str) -> ShbdkDictEntry*. Hand-written (stable); the DATA is generated.
#
# Included after _cmudict_data.cyr (piece globals) and src/dictionary/entry.cyr
# (ShbdkDictEntry / ShbdkPronunciation / region). Keys share the static piece bytes.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# Decode the pronunciations of one packed entry into a ShbdkDictEntry. The word
# ends at `wsep` (its first '|') and the entry at `e` (its ';'). Shared by the map
# loader below and by static_dict.cyr, which decodes one entry per looked-up word.
fn _shbdk_cmudict_decode_entry(piece, wsep, e): i64 {
    var prons = vec_new();
    var p = wsep;
    while (p < e) {
        # each pron: p is at '|'; content is (p+1 .. next '|' or e)
        p = p + 1;
        var ps = p;
        while (p < e) {
            if (load8(piece + p) == 124) { break; }   # next '|'
            p = p + 1;
        }
        var pe = p;

        # phonemes: comma-separated ordinals until '!' / '~' / '^' / pe
        var phon = vec_new();
        var freq = SHBDK_FREQ_NONE;
        var region = SHBDK_REGION_NONE;
        var q = ps;
        var cur = 0;
        var indig = 0;
        var ch = 0;
        while (q < pe) {
            ch = load8(piece + q);
            if (ch == 44) {
                vec_push(phon, cur);
                cur = 0;
                indig = 0;
            } else {
                if (ch == 33) { break; }    # '!'
                if (ch == 126) { break; }   # '~'
                if (ch == 94) { break; }    # '^'
                cur = cur * 10 + (ch - 48);
                indig = 1;
            }
            q = q + 1;
        }
        if (indig == 1) { vec_push(phon, cur); }

        # optional !ddd: the stress digit of each vowel, in order (3.2.0). The generator
        # checks there is one per vowel; a count that does not fit leaves the stress unknown.
        var stress = 0;
        if (q < pe) {
            if (load8(piece + q) == 33) {
                q = q + 1;
                var np2 = vec_len(phon);
                stress = _shbdk_vec_sized(np2);
                var sdat = load64(stress);
                var pdat = load64(phon);
                var k = 0;
                var phk = 0;
                while (k < np2) {
                    # shbdk_phoneme_takes_stress, written out: the call per phoneme was a
                    # sixth of the English map's build time
                    phk = load64(pdat + k * 8);
                    if (phk >= SVARA_PH_VOWEL_I && phk <= SVARA_PH_DIPH_OU && phk != SVARA_PH_VOWEL_O) {
                        ch = 0;
                        if (q < pe) { ch = load8(piece + q); }
                        if (ch < 48 || ch > 50) { stress = 0; break; }
                        store64(sdat + k * 8, ch - 48);
                        q = q + 1;
                    } else {
                        store64(sdat + k * 8, SHBDK_STRESS_NONE);
                    }
                    k = k + 1;
                }
                while (q < pe) {
                    ch = load8(piece + q);
                    if (ch == 126 || ch == 94) { break; }
                    stress = 0;   # more digits than vowels
                    q = q + 1;
                }
            }
        }

        # optional ~freq
        if (q < pe) {
            if (load8(piece + q) == 126) {
                q = q + 1;
                var fs = q;
                while (q < pe) {
                    if (load8(piece + q) == 94) { break; }   # '^'
                    q = q + 1;
                }
                freq = f64_parse(piece + fs);
            }
        }
        # optional ^region (2-char code). Defense-in-depth: require both region
        # bytes to sit within the pron bound (q+3 <= pe, i.e. '^' + 2 chars) before
        # reading them — the generated shards never emit a clipped '^', but this keeps
        # the read bounded if the data format ever changes (audit 2026-07-05 hardening).
        if (q < pe) {
            if (load8(piece + q) == 94) {
                if (q + 3 <= pe) {
                    q = q + 1;
                    var rbuf = alloc(3);
                    store8(rbuf + 0, load8(piece + q));
                    store8(rbuf + 1, load8(piece + q + 1));
                    store8(rbuf + 2, 0);
                    region = shbdk_region_from_code(rbuf);
                }
            }
        }

        var pron = shbdk_pronunciation_new(phon);
        # generator-checked data: gen_cmudict refuses an invalid @freq and writes only
        # GA / RP, so the stores skip the builders' validation (3.1.3)
        if (freq != SHBDK_FREQ_NONE) { store64(pron + 8, freq); }
        if (region != SHBDK_REGION_NONE) { store64(pron + 16, region); }
        if (stress != 0) { store64(pron + 24, stress); }
        vec_push(prons, pron);
    }

    # 1 pron -> DictEntry::new; >1 -> from_pronunciations (sorts by freq), as build.rs did.
    if (vec_len(prons) == 1) { return shbdk_dict_entry_new(vec_get(prons, 0)); }
    return shbdk_dict_entry_from_pronunciations(prons);
}

# Parse one packed entry piece[s..e) and insert it into map `m`.
fn _shbdk_cmudict_parse_entry(m, piece, s, e): i64 {
    # word = [s .. wsep), wsep at the first '|'
    var wsep = s;
    while (wsep < e) {
        if (load8(piece + wsep) == 124) { break; }   # '|'
        wsep = wsep + 1;
    }
    var wkey = str_new(piece + s, wsep - s);
    map_set(m, wkey, _shbdk_cmudict_decode_entry(piece, wsep, e));
    return 0;
}

# Load every packed piece into `m` (word Str -> ShbdkDictEntry*). Returns map size.
fn shbdk_cmudict_load(m): i64 {
    var np = _SHBDK_CMUDICT_PIECE_COUNT;
    var pi = 0;
    var piece = 0;
    var len = 0;
    var s = 0;
    var i = 0;
    while (pi < np) {
        piece = _shbdk_cmudict_piece(pi);
        len = strlen(piece);
        # An entry is word|pron|...; — find the word's '|' first, then the ';' after
        # it, so a word may itself hold ';' (CMUdict's ;SEMI-COLON). 3.1.3: every ';'
        # was taken as an entry boundary.
        s = 0;
        while (s < len) {
            i = s;
            while (i < len && load8(piece + i) != 124) { i = i + 1; }   # '|'
            while (i < len && load8(piece + i) != 59) { i = i + 1; }    # ';'
            if (i > s) { _shbdk_cmudict_parse_entry(m, piece, s, i); }
            s = i + 1;
        }
        pi = pi + 1;
    }
    return map_size(m);
}

# Convenience: a fresh map populated with the base English dictionary.
#must_use
fn shbdk_cmudict_english(): i64 {
    var m = map_new_str();
    shbdk_cmudict_load(m);
    return m;
}

# --- mod.cyr ---

# mod.cyr — PronunciationDict: the dictionary keystone.
#
# Ports 3.1.3:rust-old/src/dictionary/mod.rs (the core surface). A two-layer store:
# a base hashmap + a user-overlay hashmap (Rust's BTreeMap — Cyrius has no
# ordered map, so a hashmap here; sorted export lives in the format layer L5),
# plus an optional language code. Lookups check the overlay first, then base.
#
# Included after svara + error + entry + _cmudict_data + cmudict (english() uses
# the loaded base dict) — the entry file orders it.
#
# Cross-tier surface (defined in other modules): with_fallback -> g2p (L4),
# prefix_search -> trie (L4), validate -> validate (L6), JSON serde -> format (L5),
# the varna-lexicon constructors (from_lexicon / spanish / hindi / german /
# sanskrit) -> lexicon.cyr (L6). The Rust v0.1->v0.2 serde compat shim is dropped
# for the 3.0.0 major.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkPronunciationDict layout (24 bytes): [0]=entries(map) [8]=user_entries(map)
#   [16]=language(cstr or 0).
#
# KEY CONTRACT (bit us in 3.0.4 — read this before touching a map key): entry-map
# keys are `Str`, and they are NOT all NUL-terminated. Keys inserted through
# shbdk_dict_insert* come from str_from(shbdk_lower_cstr(...)) and happen to be;
# the BASE dictionary's keys come from cmudict.cyr as str_new(piece + s, len) —
# VIEWS into the packed _cmudict_data string literals, where the byte after the
# key is '|', not NUL. So a key is only ever safe to use as (str_data, str_len)
# or via str_cstr() (which copies and terminates). Passing str_data(key) to a
# cstr API reads to the end of the whole ~22 KB piece: that is exactly how
# shbdk_to_cmudict(shbdk_dict_english()) came to emit 128 MB instead of 300 KB.

# ---- small string helpers ----------------------------------------------------
# 1 if Str a sorts before Str b (byte-lexicographic).
fn _shbdk_str_lt(a, b): i64 {
    var ad = str_data(a);
    var al = str_len(a);
    var bd = str_data(b);
    var bl = str_len(b);
    var n = al;
    if (bl < al) { n = bl; }
    var i = 0;
    var ca = 0;
    var cb = 0;
    while (i < n) {
        ca = load8(ad + i);
        cb = load8(bd + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (al < bl) { return 1; }
    return 0;
}

# ---- generic stable sort -----------------------------------------------------
# Stable bottom-up merge sort of vec `v`, ordering by the comparator fn-pointer
# `le_fp(a, b)` -> 1 if `a` may precede `b` (i.e. a <= b), 0 otherwise. O(n log n)
# with one scratch vec; ties keep their input order (the left run wins), so it is
# a drop-in for the stable insertion sorts it replaces.
#
# 3.0.4: the sorts here, in validate.cyr and in detect.cyr were all O(n^2)
# insertion sorts. That is fine for a handful of pronunciation variants but the
# EXPORT paths sort every dictionary key — 10,617 for the built-in English dict,
# i.e. ~56M byte-wise Str compares, ~870 ms per to_cmudict / to_ipa / to_pls /
# diff / prefix_search call. One shared merge sort fixes all three call sites.
# (entry.cyr's _shbdk_sort_by_frequency stays an insertion sort: it runs over
# 1-5 pronunciations, its NaN ordering is parity-audited, and entry.cyr is L1 —
# below this module in the include order.)
fn _shbdk_msort(v, le_fp): i64 {
    var n = vec_len(v);
    if (n < 2) { return 0; }
    var buf = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(buf, vec_get(v, i));
        i = i + 1;
    }
    var width = 1;
    var lo = 0;
    var mid = 0;
    var hi = 0;
    var a = 0;
    var b = 0;
    var k = 0;
    var take_left = 0;
    while (width < n) {
        lo = 0;
        while (lo < n) {
            mid = lo + width;
            if (mid > n) { mid = n; }
            hi = mid + width;
            if (hi > n) { hi = n; }
            a = lo;
            b = mid;
            k = lo;
            while (k < hi) {
                if (a >= mid) {
                    take_left = 0;
                } else {
                    if (b >= hi) {
                        take_left = 1;
                    } else {
                        take_left = fncall2(le_fp, vec_get(v, a), vec_get(v, b));
                    }
                }
                if (take_left == 1) {
                    vec_set(buf, k, vec_get(v, a));
                    a = a + 1;
                } else {
                    vec_set(buf, k, vec_get(v, b));
                    b = b + 1;
                }
                k = k + 1;
            }
            lo = hi;   # == min(lo + 2*width, n); reaching n ends the pass
        }
        i = 0;
        while (i < n) {
            vec_set(v, i, vec_get(buf, i));
            i = i + 1;
        }
        width = width + width;
    }
    return 0;
}

# Comparator: 1 if Str `a` sorts at or before Str `b` (a <= b, i.e. NOT b < a).
fn _shbdk_str_le(a, b): i64 {
    if (_shbdk_str_lt(b, a) == 1) { return 0; }
    return 1;
}

# Str `s`'s first 8 bytes as one big-endian integer (zero padded past its length), with the
# sign bit flipped so that a signed compare of two keys orders those bytes as unsigned.
fn _shbdk_str_key8(s): i64 {
    var d = str_data(s);
    var l = str_len(s);
    var k = 0;
    var i = 0;
    while (i < 8) {
        k = k << 8;
        if (i < l) { k = k | load8(d + i); }
        i = i + 1;
    }
    return k ^ (1 << 63);
}

# Sort a vec of Str ascending in byte order (unsigned bytes; a prefix sorts before its
# extensions), stably, in place. Used for every deterministic export and diff.
#
# 3.1.0: its own bottom-up merge sort instead of _shbdk_msort with _shbdk_str_le, which cost a
# fncall2, vec_get / vec_set per access and a copy-back per pass: about 10 ms for the 10,617
# English keys. Each Str gets a 16-byte record, [0] = _shbdk_str_key8, [8] = the Str, so most
# comparisons are one integer compare. Equal keys (the same first 8 bytes, or a real NUL
# meeting the padding) fall back to _shbdk_str_lt. Two raw buffers swap roles each pass, and
# the left run wins ties, so the sort stays stable.
fn _shbdk_sort_strs(v): i64 {
    var n = vec_len(v);
    if (n < 2) { return 0; }
    var src = alloc(n * 32);
    if (src == 0) { return _shbdk_msort(v, &_shbdk_str_le); }
    var dst = src + n * 16;
    var i = 0;
    var s = 0;
    while (i < n) {
        s = vec_get(v, i);
        store64(src + i * 16, _shbdk_str_key8(s));
        store64(src + i * 16 + 8, s);
        i = i + 1;
    }
    var width = 1;
    var lo = 0;
    var mid = 0;
    var hi = 0;
    var a = 0;
    var b = 0;
    var k = 0;
    var r = 0;
    var ra = 0;
    var rb = 0;
    var ka = 0;
    var kb = 0;
    var take_right = 0;
    var t = 0;
    while (width < n) {
        lo = 0;
        while (lo < n) {
            mid = lo + width;
            if (mid > n) { mid = n; }
            hi = mid + width;
            if (hi > n) { hi = n; }
            a = lo;
            b = mid;
            k = lo;
            while (k < hi) {
                if (a >= mid) {
                    take_right = 1;
                } else {
                    if (b >= hi) {
                        take_right = 0;
                    } else {
                        ra = src + a * 16;
                        rb = src + b * 16;
                        ka = load64(ra);
                        kb = load64(rb);
                        take_right = 0;
                        if (kb < ka) {
                            take_right = 1;
                        } else {
                            if (kb == ka) {
                                take_right = _shbdk_str_lt(load64(rb + 8), load64(ra + 8));
                            }
                        }
                    }
                }
                if (take_right == 1) {
                    r = src + b * 16;
                    b = b + 1;
                } else {
                    r = src + a * 16;
                    a = a + 1;
                }
                store64(dst + k * 16, load64(r));
                store64(dst + k * 16 + 8, load64(r + 8));
                k = k + 1;
            }
            lo = hi;   # == min(lo + 2*width, n); reaching n ends the pass
        }
        t = src;
        src = dst;
        dst = t;
        width = width + width;
    }
    i = 0;
    while (i < n) {
        vec_set(v, i, load64(src + i * 16 + 8));
        i = i + 1;
    }
    return 0;
}

# phoneme-vec builders for english_minimal.
fn _shbdk_pv1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _shbdk_pv2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _shbdk_pv3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _shbdk_pv4(a, b, c, d): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    return v;
}

# ---- shared file-load limits / sizing ----------------------------------------
# 3.1.3: there is no load ceiling any more. SHBDK_MAX_FILE_BYTES (8 MB, 3.0.4) made
# every loader refuse files its saver had just written; buffers follow the file.

# Byte size of `path`, or negative if it cannot be opened / sized.
#
# io.cyr has no stat/size call; xlseek(fd, 0, SEEK_END) is the portable one (its
# SYS_LSEEK number is carried in every syscall peer — Linux #8, aarch64 #62,
# macos #8, agnos #58). Lives in the keystone because it is the lowest module
# that format/mod.cyr, format/binary.cyr and lazy.cyr all already depend on;
# duplicating it per module (or making binary.cyr depend on the text-format
# module) would be worse.
fn _shbdk_file_size_of(path): i64 {
    var fd = file_open(path, 0, 0);   # O_RDONLY
    if (fd < 0) { return (0 - 1); }
    var n = xlseek(fd, 0, 2);         # SEEK_END
    file_close(fd);
    return n;
}

# Read a whole file into a fresh buffer (NUL-terminated past its end) and return
# it as a Str of the bytes read, or 0 with the reason in shbdk_last_error(). Shared
# by the CMUdict and binary loaders (3.1.3).
fn _shbdk_read_file_str(path): i64 {
    if (path == 0) { return _shbdk_fail("no path"); }
    var size = _shbdk_file_size_of(path);
    if (size < 0) { return _shbdk_fail_line(0, "failed to read file: ", path, 0, strlen(path), 0); }
    var buf = alloc(size + 1);
    if (buf == 0) { return _shbdk_fail("failed to read file: out of memory"); }
    var n = 0;
    if (size > 0) { n = file_read_all(path, buf, size); }
    if (n < 0) { return _shbdk_fail_line(0, "failed to read file: ", path, 0, strlen(path), 0); }
    store8(buf + n, 0);
    return str_new(buf, n);
}

# ---- construction ------------------------------------------------------------
#must_use
fn shbdk_dict_new(): i64 {
    var d = alloc(24);
    store64(d + 0, map_new_str());
    store64(d + 8, map_new_str());
    store64(d + 16, 0);
    return d;
}

# The built-in English dictionary (10,617 entries from the generated data).
#must_use
fn shbdk_dict_english(): i64 {
    var d = alloc(24);
    store64(d + 0, shbdk_cmudict_english());
    store64(d + 8, map_new_str());
    store64(d + 16, "en");
    return d;
}

# From a pre-built base entries map.
#must_use
fn shbdk_dict_from_entries(entries): i64 {
    var d = alloc(24);
    store64(d + 0, entries);
    store64(d + 8, map_new_str());
    store64(d + 16, 0);
    return d;
}

# From a map of word(Str) -> phonemes(vec): wraps each in a single-pron DictEntry.
#must_use
fn shbdk_dict_from_simple_entries(simple): i64 {
    var d = shbdk_dict_new();
    var base = load64(d + 0);
    var ks = map_keys(simple);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        map_set(base, k, shbdk_dict_entry_from_phonemes(map_get(simple, k)));
        i = i + 1;
    }
    return d;
}

# ---- inserts / removal -------------------------------------------------------
# OWNERSHIP (3.1.3): insert / insert_user copy the phoneme vec, as the Rust's
# `&[Phoneme]` did — a caller may reuse its buffer. insert_entry /
# insert_user_entry take the entry itself (the Rust moved a DictEntry in), so the
# dictionary owns it afterwards. Keys are lowercased with Unicode semantics.
fn shbdk_dict_insert(d, word, phonemes): i64 {
    map_set(load64(d + 0), str_from(shbdk_lower_cstr(word)), shbdk_dict_entry_from_phonemes(phonemes));
    return 0;
}

# Inserts a full entry into the base dictionary, keyed by the lowercased word.
fn shbdk_dict_insert_entry(d, word, entry): i64 {
    map_set(load64(d + 0), str_from(shbdk_lower_cstr(word)), entry);
    return 0;
}

# Inserts a word into the user overlay with a single pronunciation. User entries take
# precedence over base entries during lookup.
fn shbdk_dict_insert_user(d, word, phonemes): i64 {
    map_set(load64(d + 8), str_from(shbdk_lower_cstr(word)), shbdk_dict_entry_from_phonemes(phonemes));
    return 0;
}

# Inserts a full entry into the user overlay, keyed by the lowercased word.
fn shbdk_dict_insert_user_entry(d, word, entry): i64 {
    map_set(load64(d + 8), str_from(shbdk_lower_cstr(word)), entry);
    return 0;
}

# Remove from the user overlay; 1 if it was present.
fn shbdk_dict_remove_user(d, word): i64 {
    return map_delete(load64(d + 8), str_from(shbdk_lower_cstr(word)));
}

# ---- language ----------------------------------------------------------------
#must_use
fn shbdk_dict_language(d): cstring {
    return load64(d + 16);
}

# Sets the ISO 639 language code (copied; a null code clears it).
# 3.1.3: was stored as given, so mutating the caller's buffer changed the dictionary.
fn shbdk_dict_set_language(d, code): i64 {
    if (code == 0) { store64(d + 16, 0); return 0; }
    store64(d + 16, shbdk_copyz(code, strlen(code)));
    return 0;
}

# Builder form of shbdk_dict_set_language: sets the code on `d` and returns `d`.
#must_use
fn shbdk_dict_with_language(d, code): i64 {
    shbdk_dict_set_language(d, code);
    return d;
}

# ---- accessors ---------------------------------------------------------------
#must_use
fn shbdk_dict_entries(d): i64 {
    return load64(d + 0);
}

# The user overlay map (word -> entry): the live map, not a copy.
#must_use
fn shbdk_dict_user_entries(d): i64 {
    return load64(d + 8);
}

# Number of user overlay entries.
#must_use
fn shbdk_dict_user_len(d): i64 {
    return map_size(load64(d + 8));
}

# Number of base dictionary entries. The user overlay is not counted.
#must_use
fn shbdk_dict_len(d): i64 {
    return map_size(load64(d + 0));
}

# 1 if the base dictionary is empty, else 0. The user overlay is not counted.
#must_use
fn shbdk_dict_is_empty(d): i64 {
    if (map_size(load64(d + 0)) == 0) { return 1; }
    return 0;
}

# ---- lookup ------------------------------------------------------------------
# Internal: look up an already-lowercase Str key (overlay first, then base).
fn _shbdk_dict_lookup_entry_str(d, key): i64 {
    var e = map_get(load64(d + 8), key);
    if (e != 0) { return e; }
    return map_get(load64(d + 0), key);
}

# Full entry for a word (cstr), or 0. Overlay first, then base; lowercase
# fast-path avoids a copy when the word is already lowercase.
#must_use
fn shbdk_dict_lookup_entry(d, word): i64 {
    var key = 0;
    # 3.0.4: Rust took &str, so a null word was unrepresentable; here it would
    # deref address 0 in the case scan below. One predictable branch on the hot
    # path (measured: no change to the ~130 ns lookup).
    if (word == 0) { return 0; }
    # 3.1.3: Unicode lowercase (was ASCII only, so "ÜBER" never found "über").
    if (shbdk_is_lower_cstr(word) == 1) {
        key = str_from(word);
    } else {
        key = str_from(shbdk_lower_cstr(word));
    }
    return _shbdk_dict_lookup_entry_str(d, key);
}

# Primary pronunciation phonemes (vec), or 0.
#must_use
fn shbdk_dict_lookup(d, word): i64 {
    var e = shbdk_dict_lookup_entry(d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_primary_phonemes(e);
}

# All pronunciations (vec of ShbdkPronunciation*), or 0.
#must_use
fn shbdk_dict_lookup_all(d, word): i64 {
    var e = shbdk_dict_lookup_entry(d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_all(e);
}

# ---- merge -------------------------------------------------------------------
# Insert every key of map `src` into map `dst` (replace-on-conflict).
#
# 3.0.4 PARITY FIX: this used to do `map_set(dst, k, map_get(src, k))`, sharing
# the ShbdkDictEntry pointer, where Rust's merge inserts `entry.clone()`.
# Observably, after `a.merge(b)` a shbdk_dict_entry_add_pronunciation through
# either dictionary mutated BOTH. Entries are now deep-cloned, as in the oracle.
fn _shbdk_map_merge_into(dst, src): i64 {
    var ks = map_keys(src);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        map_set(dst, k, shbdk_dict_entry_clone(map_get(src, k)));
        i = i + 1;
    }
    return 0;
}

# Merge `other` into `d`; on conflict, other's entries win.
fn shbdk_dict_merge(d, other): i64 {
    _shbdk_map_merge_into(load64(d + 0), shbdk_dict_entries(other));
    _shbdk_map_merge_into(load64(d + 8), shbdk_dict_user_entries(other));
    return 0;
}

# Insert every missing key of `src` into `dst` (keep-on-conflict). Entries are
# deep-cloned, as in _shbdk_map_merge_into above.
fn _shbdk_map_merge_cons(dst, src): i64 {
    var ks = map_keys(src);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        if (map_has(dst, k) == 0) { map_set(dst, k, shbdk_dict_entry_clone(map_get(src, k))); }
        i = i + 1;
    }
    return 0;
}

# Merge `other` into `d`, keeping d's entries on conflict.
fn shbdk_dict_merge_conservative(d, other): i64 {
    _shbdk_map_merge_cons(load64(d + 0), shbdk_dict_entries(other));
    _shbdk_map_merge_cons(load64(d + 8), shbdk_dict_user_entries(other));
    return 0;
}

# Deep copy of a dictionary: both layers' entries are cloned, the language code is
# copied. (The Rust derived Clone on PronunciationDict.)
#must_use
fn shbdk_dict_clone(d): i64 {
    var c = shbdk_dict_new();
    _shbdk_map_merge_into(load64(c + 0), load64(d + 0));
    _shbdk_map_merge_into(load64(c + 8), load64(d + 8));
    shbdk_dict_set_language(c, load64(d + 16));
    return c;
}

# ---- english_minimal ---------------------------------------------------------
# ~29 common function words (testing / memory-constrained use).
#must_use
fn shbdk_dict_english_minimal(): i64 {
    var d = shbdk_dict_new();
    store64(d + 16, "en");
    shbdk_dict_insert(d, "the", _shbdk_pv2(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_SCHWA));
    shbdk_dict_insert(d, "a", _shbdk_pv1(SVARA_PH_VOWEL_SCHWA));
    shbdk_dict_insert(d, "an", _shbdk_pv2(SVARA_PH_VOWEL_SCHWA, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "i", _shbdk_pv1(SVARA_PH_DIPH_AI));
    shbdk_dict_insert(d, "is", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_Z));
    shbdk_dict_insert(d, "was", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_FRIC_Z));
    shbdk_dict_insert(d, "are", _shbdk_pv2(SVARA_PH_VOWEL_OPEN_A, SVARA_PH_APPROX_R));
    shbdk_dict_insert(d, "to", _shbdk_pv2(SVARA_PH_PLOSIVE_T, SVARA_PH_VOWEL_U));
    shbdk_dict_insert(d, "of", _shbdk_pv2(SVARA_PH_VOWEL_OPEN_O, SVARA_PH_FRIC_V));
    shbdk_dict_insert(d, "in", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "it", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "and", _shbdk_pv3(SVARA_PH_VOWEL_ASH, SVARA_PH_NASAL_N, SVARA_PH_PLOSIVE_D));
    shbdk_dict_insert(d, "that", _shbdk_pv3(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "for", _shbdk_pv3(SVARA_PH_FRIC_F, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_APPROX_R));
    shbdk_dict_insert(d, "you", _shbdk_pv2(SVARA_PH_APPROX_J, SVARA_PH_VOWEL_U));
    shbdk_dict_insert(d, "he", _shbdk_pv2(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_LONG_I));
    shbdk_dict_insert(d, "she", _shbdk_pv2(SVARA_PH_FRIC_SH, SVARA_PH_VOWEL_LONG_I));
    shbdk_dict_insert(d, "we", _shbdk_pv2(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_LONG_I));
    shbdk_dict_insert(d, "they", _shbdk_pv2(SVARA_PH_FRIC_DH, SVARA_PH_DIPH_EI));
    shbdk_dict_insert(d, "this", _shbdk_pv3(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_S));
    shbdk_dict_insert(d, "with", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_TH));
    shbdk_dict_insert(d, "not", _shbdk_pv3(SVARA_PH_NASAL_N, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "but", _shbdk_pv3(SVARA_PH_PLOSIVE_B, SVARA_PH_VOWEL_CUP_V, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "have", _shbdk_pv3(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_ASH, SVARA_PH_FRIC_V));
    shbdk_dict_insert(d, "one", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_CUP_V, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "hello",
      _shbdk_pv4(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_LATERAL_L, SVARA_PH_DIPH_OU));
    shbdk_dict_insert(d, "world",
      _shbdk_pv4(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_BIRD, SVARA_PH_LATERAL_L, SVARA_PH_PLOSIVE_D));
    shbdk_dict_insert(d, "yes", _shbdk_pv3(SVARA_PH_APPROX_J, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_FRIC_S));
    shbdk_dict_insert(d, "no", _shbdk_pv2(SVARA_PH_NASAL_N, SVARA_PH_DIPH_OU));
    return d;
}

# ---- DictDiff ----------------------------------------------------------------
# Layout (24 bytes): [0]=added(vec<Str>) [8]=removed(vec<Str>) [16]=changed(vec<Str>).
#must_use
fn shbdk_dict_diff_new(): i64 {
    var dd = alloc(24);
    store64(dd + 0, vec_new());
    store64(dd + 8, vec_new());
    store64(dd + 16, vec_new());
    return dd;
}

# Words present in `right` but not `left` (vec<Str>).
#must_use
fn shbdk_dict_diff_added(dd): i64 { return load64(dd + 0); }

# Words present in `left` but not `right` (vec<Str>).
#must_use
fn shbdk_dict_diff_removed(dd): i64 { return load64(dd + 8); }

# Words in both dictionaries whose entries differ (vec<Str>).
#must_use
fn shbdk_dict_diff_changed(dd): i64 { return load64(dd + 16); }

# Total number of differences.
#must_use
fn shbdk_dict_diff_len(dd): i64 {
    return vec_len(load64(dd + 0)) + vec_len(load64(dd + 8)) + vec_len(load64(dd + 16));
}

# 1 if the dictionaries are identical, else 0.
#must_use
fn shbdk_dict_diff_is_empty(dd): i64 {
    if (shbdk_dict_diff_len(dd) == 0) { return 1; }
    return 0;
}

# Frequency equality: the same value. 0.0 equals -0.0 (IEEE), and a NaN equals
# the same NaN — a dictionary diffed against itself has no changes. (3.1.3: was a bit
# compare, which split 0.0 / -0.0; the Rust's f32 `==` instead never matched a NaN.)
fn _shbdk_freq_eq(a, b): i64 {
    if (a == b) { return 1; }
    if (f64_ge(a, b) == 1 && f64_ge(b, a) == 1) { return 1; }
    return 0;
}

# Deep pronunciation equality (phonemes + frequency + region). The Rust derived
# PartialEq on Pronunciation.
#must_use
fn shbdk_pronunciation_eq(a, b): i64 {
    if (_shbdk_freq_eq(load64(a + 8), load64(b + 8)) == 0) { return 0; }
    if (load64(a + 16) != load64(b + 16)) { return 0; }
    # 3.2.0: the lexical stress too, known or not
    var sa = shbdk_pronunciation_stress(a);
    var sb = shbdk_pronunciation_stress(b);
    if ((sa == 0) != (sb == 0)) { return 0; }
    if (sa != 0) {
        if (vec_len(sa) != vec_len(sb)) { return 0; }
        var k = 0;
        while (k < vec_len(sa)) {
            if (vec_get(sa, k) != vec_get(sb, k)) { return 0; }
            k = k + 1;
        }
    }
    var pa = load64(a + 0);
    var pb = load64(b + 0);
    var na = vec_len(pa);
    if (na != vec_len(pb)) { return 0; }
    var i = 0;
    while (i < na) {
        if (vec_get(pa, i) != vec_get(pb, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Deep DictEntry equality (same pronunciations in order). The Rust derived
# PartialEq on DictEntry.
#must_use
fn shbdk_dict_entry_eq(a, b): i64 {
    var pa = shbdk_dict_entry_all(a);
    var pb = shbdk_dict_entry_all(b);
    var na = vec_len(pa);
    if (na != vec_len(pb)) { return 0; }
    var i = 0;
    while (i < na) {
        if (shbdk_pronunciation_eq(vec_get(pa, i), vec_get(pb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Add every key of map `m` into the dedup set `seen`.
fn _shbdk_collect_keys(seen, m): i64 {
    var ks = map_keys(m);
    var n = vec_len(ks);
    var i = 0;
    while (i < n) {
        map_set(seen, vec_get(ks, i), 1);
        i = i + 1;
    }
    return 0;
}

# Diff two dictionaries by effective lookup (overlay over base), sorted. Returns
# a DictDiff (added = in right only, removed = in left only, changed = differing).
#must_use
fn shbdk_dict_diff(left, right): i64 {
    var dd = shbdk_dict_diff_new();
    var seen = map_new_str();
    _shbdk_collect_keys(seen, shbdk_dict_entries(left));
    _shbdk_collect_keys(seen, shbdk_dict_user_entries(left));
    _shbdk_collect_keys(seen, shbdk_dict_entries(right));
    _shbdk_collect_keys(seen, shbdk_dict_user_entries(right));
    var words = map_keys(seen);
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var w = 0;
    var l = 0;
    var r = 0;
    while (i < n) {
        w = vec_get(words, i);
        # Route through lookup_entry (re-applies the lowercase gate) to match Rust's
        # diff, so non-lowercased base keys (from from_entries) classify identically.
        l = shbdk_dict_lookup_entry(left, str_cstr(w));
        r = shbdk_dict_lookup_entry(right, str_cstr(w));
        if (l == 0) {
            if (r != 0) { vec_push(load64(dd + 0), w); }
        } else {
            if (r == 0) {
                vec_push(load64(dd + 8), w);
            } else {
                if (shbdk_dict_entry_eq(l, r) == 0) { vec_push(load64(dd + 16), w); }
            }
        }
        i = i + 1;
    }
    return dd;
}

# --- coverage.cyr ---

# coverage.cyr — text-corpus coverage analysis against a PronunciationDict.
#
# Ports 3.1.3:rust-old/src/dictionary/coverage.rs. Extends the keystone: tokenizes
# text, strips punctuation, lowercases, and checks each token against the dict.
# Included after src/dictionary/mod.cyr (uses shbdk_dict_lookup_entry +
# _shbdk_sort_strs). Phoneme-agnostic.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkCoverageReport layout (24 bytes): [0]=total_tokens [8]=covered_tokens
#   [16]=uncovered_words(vec of Str, sorted, unique).

# 3.1.3: tokens split on Unicode White_Space (was ASCII only, so "hello<NBSP>world"
# was one uncovered token); the edges strip Unicode punctuation and symbols too
# (curly quotes, the ellipsis, guillemets: "\u201Cthe\u201D" was uncovered); a
# word-internal U+2019 / U+02BC apostrophe reads as the dictionary's ASCII `'`
# ("don\u2019t" now finds "don't"); and the token lowercases with Unicode
# semantics ("\u00C9COLE" -> "\u00E9cole"). Each was wrong in the Rust as well, bar the
# whitespace and the lowercase.

# Normalize text[start..end]: strip leading/trailing punctuation and symbols, read
# a typographic apostrophe as `'`, and lowercase. Returns a fresh NUL-terminated
# cstr (empty if the token was all punctuation).
fn _shbdk_normalize_token(text, start, end): i64 {
    var cpb[8];
    var s = start;
    var k = 0;
    while (s < end) {
        k = shbdk_utf8_decode(text, s, end, &cpb);
        if (shbdk_cp_is_punct(load64(&cpb)) == 0) { break; }
        s = s + k;
    }
    var e = end;
    while (e > s) {
        k = shbdk_utf8_decode_before(text, s, e, &cpb);
        if (shbdk_cp_is_punct(load64(&cpb)) == 0) { break; }
        e = e - k;
    }
    var n = e - s;
    if (n < 0) { n = 0; }
    var buf = alloc(n + 1);
    if (buf == 0) { return ""; }   # 3.0.4: alloc failure -> empty token, not a null write
    var i = 0;
    var o = 0;
    var c = 0;
    while (i < n) {
        c = load8(text + s + i);
        if (c == 226 && i + 2 < n && load8(text + s + i + 1) == 128 && load8(text + s + i + 2) == 153) {
            store8(buf + o, 39);   # U+2019 RIGHT SINGLE QUOTATION MARK -> '
            o = o + 1;
            i = i + 3;
        } else {
            if (c == 202 && i + 1 < n && load8(text + s + i + 1) == 188) {
                store8(buf + o, 39);   # U+02BC MODIFIER LETTER APOSTROPHE -> '
                o = o + 1;
                i = i + 2;
            } else {
                store8(buf + o, c);
                o = o + 1;
                i = i + 1;
            }
        }
    }
    store8(buf + o, 0);
    return shbdk_lower_n(buf, o);
}

# ---- CoverageReport ----------------------------------------------------------
# A report from its fields: token counts and the uncovered words (vec of Str,
# sorted, unique). The Rust's fields were public; this is the constructor (3.1.3).
#must_use
fn shbdk_coverage_report_new(total, covered, uncovered): i64 {
    return _shbdk_coverage_report_new(total, covered, uncovered);
}

fn _shbdk_coverage_report_new(total, covered, uncovered): i64 {
    var r = alloc(24);
    store64(r + 0, total);
    store64(r + 8, covered);
    store64(r + 16, uncovered);
    return r;
}

# Total number of word tokens in the corpus.
#must_use
fn shbdk_coverage_total_tokens(r): i64 {
    return load64(r + 0);
}

# Number of tokens found in the dictionary.
#must_use
fn shbdk_coverage_covered_tokens(r): i64 {
    return load64(r + 8);
}

# Unique words not found in the dictionary, sorted (vec).
#must_use
fn shbdk_coverage_uncovered_words(r): i64 {
    return load64(r + 16);
}

# Number of unique uncovered words.
#must_use
fn shbdk_coverage_uncovered_count(r): i64 {
    return vec_len(load64(r + 16));
}

# 1 if every token was covered, else 0.
#must_use
fn shbdk_coverage_is_fully_covered(r): i64 {
    if (vec_len(load64(r + 16)) == 0) { return 1; }
    return 0;
}

# Coverage percentage (0.0-100.0) as f64 bits; 0.0 if the corpus is empty.
#must_use
fn shbdk_coverage_pct(r): i64 {
    var total = load64(r + 0);
    if (total == 0) { return 0; }
    return f64_mul(f64_div(f64_from(load64(r + 8)), f64_from(total)), f64_from(100));
}

# ---- coverage() --------------------------------------------------------------
# Analyze how well dict `d` covers `text` (a cstr). Returns a CoverageReport.
#must_use
fn shbdk_dict_coverage(d, text): i64 {
    var total = 0;
    var covered = 0;
    var uncovered_set = map_new_str();
    var len = strlen(text);
    var i = 0;
    var w = 0;
    var ts = 0;
    var in_tok = 0;
    var norm = 0;
    while (i < len) {
        w = shbdk_ws_len(text, i, len);
        if (w > 0) {
            if (in_tok == 1) {
                norm = _shbdk_normalize_token(text, ts, i);
                if (load8(norm) != 0) {
                    total = total + 1;
                    if (shbdk_dict_lookup_entry(d, norm) != 0) {
                        covered = covered + 1;
                    } else {
                        map_set(uncovered_set, str_from(norm), 1);
                    }
                }
                in_tok = 0;
            }
            i = i + w;
        } else {
            if (in_tok == 0) {
                ts = i;
                in_tok = 1;
            }
            i = i + 1;
        }
    }
    if (in_tok == 1) {
        norm = _shbdk_normalize_token(text, ts, len);
        if (load8(norm) != 0) {
            total = total + 1;
            if (shbdk_dict_lookup_entry(d, norm) != 0) {
                covered = covered + 1;
            } else {
                map_set(uncovered_set, str_from(norm), 1);
            }
        }
    }
    var uncovered = map_keys(uncovered_set);
    _shbdk_sort_strs(uncovered);
    return _shbdk_coverage_report_new(total, covered, uncovered);
}

# --- stream.cyr ---

# stream.cyr — streaming word-to-phoneme lookup.
#
# Ports 3.1.3:rust-old/src/dictionary/stream.rs (the LookupStream iterator). CYRIUS has
# no Iterator trait, so this is a stateful cursor over a vec of word cstrs: each
# shbdk_lookup_stream_next(s) advances and stashes the current (word, phonemes)
# in the stream struct — zero-alloc per step (no per-item tuple). Extends the
# keystone (shbdk_dict_lookup); included after src/dictionary/mod.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkLookupStream layout (40 bytes): [0]=dict [8]=words(vec of word cstr) [16]=pos
#   [24]=cur_word(cstr) [32]=cur_phonemes(vec or 0).

# Create a streaming lookup over `words` (a vec of word cstrs).
#must_use
fn shbdk_dict_lookup_stream(dict, words): i64 {
    var s = alloc(40);
    store64(s + 0, dict);
    store64(s + 8, words);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    return s;
}

# Advance to the next word: 1 if there is one (read it via shbdk_stream_word /
# shbdk_stream_phonemes), 0 when exhausted.
fn shbdk_lookup_stream_next(s): i64 {
    var pos = load64(s + 16);
    var words = load64(s + 8);
    if (pos >= vec_len(words)) { return 0; }
    var word = vec_get(words, pos);
    store64(s + 24, word);
    store64(s + 32, shbdk_dict_lookup(load64(s + 0), word));
    store64(s + 16, pos + 1);
    return 1;
}

# Current word (cstr) after a successful next().
#must_use
fn shbdk_stream_word(s): i64 {
    return load64(s + 24);
}

# Current pronunciation phonemes (vec), or 0 if the word was not found.
#must_use
fn shbdk_stream_phonemes(s): i64 {
    return load64(s + 32);
}

# Remaining word count (Rust's size_hint upper/lower bound).
#must_use
fn shbdk_lookup_stream_size_hint(s): i64 {
    return vec_len(load64(s + 8)) - load64(s + 16);
}

# --- trie.cyr ---

# trie.cyr — prefix trie for word lookup / autocomplete.
#
# Ports 3.1.3:rust-old/src/dictionary/trie.rs (PrefixTrie). Rust keyed children by
# `char`; this keys by BYTE — equivalent for ASCII words, and correct at the
# byte level for UTF-8 (prefix search over bytes). Each node's children are a
# small vec of (byte, node) pairs (sparse fan-out; linear scan is fine). Extends
# the keystone (from_dict / prefix_search); included after src/dictionary/mod.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# TrieNode layout (16 bytes): [0]=children(vec of pair*) [8]=is_word(0/1).
# child pair (16 bytes): [0]=byte [8]=child node.
# PrefixTrie layout (24 bytes): [0]=root(node) [8]=word_count [16]=max_word_len
#   (3.0.4: max_word_len sizes the collect buffer exactly — see search_prefix).

fn _shbdk_trie_node_new(): i64 {
    var n = alloc(16);
    store64(n + 0, vec_new());
    store64(n + 8, 0);
    return n;
}

# Child node for `byte`, or 0.
fn _shbdk_trie_get_child(node, byte): i64 {
    var ch = load64(node + 0);
    var n = vec_len(ch);
    var i = 0;
    var pair = 0;
    while (i < n) {
        pair = vec_get(ch, i);
        if (load64(pair + 0) == byte) { return load64(pair + 8); }
        i = i + 1;
    }
    return 0;
}

# Child node for `byte`, creating it if absent.
fn _shbdk_trie_get_or_add_child(node, byte): i64 {
    var existing = _shbdk_trie_get_child(node, byte);
    if (existing != 0) { return existing; }
    var child = _shbdk_trie_node_new();
    var pair = alloc(16);
    store64(pair + 0, byte);
    store64(pair + 8, child);
    vec_push(load64(node + 0), pair);
    return child;
}

# A result word: a Str over a fresh NUL-terminated copy of buf[0..n), carrying its
# length, so a key with an embedded NUL comes back whole (3.1.3: str_from re-measured
# it with strlen and cut it at the NUL). Allocation failure gives the empty Str.
fn _shbdk_trie_str(buf, n): i64 {
    var c = alloc(n + 1);
    if (c == 0) { return str_from(""); }
    memcpy(c, buf, n);
    store8(c + n, 0);
    return str_new(c, n);
}

# Creates an empty trie.
#must_use
fn shbdk_trie_new(): i64 {
    var t = alloc(24);
    store64(t + 0, _shbdk_trie_node_new());
    store64(t + 8, 0);
    store64(t + 16, 0);   # max inserted word length
    return t;
}

# Insert the `len` bytes at `data` (internal — used for both cstr and Str inserts).
fn _shbdk_trie_insert_bytes(t, data, len): i64 {
    var node = load64(t + 0);
    var i = 0;
    while (i < len) {
        node = _shbdk_trie_get_or_add_child(node, load8(data + i));
        i = i + 1;
    }
    if (load64(node + 8) == 0) {
        store64(node + 8, 1);
        store64(t + 8, load64(t + 8) + 1);
    }
    if (len > load64(t + 16)) { store64(t + 16, len); }
    return 0;
}

# Insert a word (cstr).
fn shbdk_trie_insert(t, word): i64 {
    if (word == 0) { return 0; }   # 3.1.3: a null word is no word (it crashed)
    return _shbdk_trie_insert_bytes(t, word, strlen(word));
}

# Build a trie from all dictionary words (base + user overlay). Keys may be
# non-NUL-terminated Str (cmudict), so insert by (data, len).
#must_use
fn shbdk_trie_from_dict(dict): i64 {
    var t = shbdk_trie_new();
    var bkeys = map_keys(shbdk_dict_entries(dict));
    var n = vec_len(bkeys);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(bkeys, i);
        _shbdk_trie_insert_bytes(t, str_data(k), str_len(k));
        i = i + 1;
    }
    var ukeys = map_keys(shbdk_dict_user_entries(dict));
    var un = vec_len(ukeys);
    i = 0;
    while (i < un) {
        k = vec_get(ukeys, i);
        _shbdk_trie_insert_bytes(t, str_data(k), str_len(k));
        i = i + 1;
    }
    return t;
}

# 1 if the trie contains the exact word (cstr).
#must_use
fn shbdk_trie_contains(t, word): i64 {
    if (word == 0) { return 0; }
    var node = load64(t + 0);
    var i = 0;
    while (load8(word + i) != 0) {
        node = _shbdk_trie_get_child(node, load8(word + i));
        if (node == 0) { return 0; }
        i = i + 1;
    }
    return load64(node + 8);
}

# Number of words in the trie.
#must_use
fn shbdk_trie_len(t): i64 {
    return load64(t + 8);
}

# 1 if the trie contains no words, else 0.
#must_use
fn shbdk_trie_is_empty(t): i64 {
    if (load64(t + 8) == 0) { return 1; }
    return 0;
}

# Collect all words under `node` in pre-order; `buf[0..depth)` is the path so far
# and `cap` bounds the buffer (a path longer than `cap` is never written past the
# allocation). `results` receives one Str per word.
#
# SECURITY (3.0.4): this walk used to RECURSE once per byte of the path, so its
# stack depth was the word length — attacker-controlled. shbdk_from_binary accepts
# words up to u16 (65,535 bytes) and shbdk_parse_cmudict has no length limit at
# all, and a word of ~63 KB already overflowed the 8 MB default stack: a corrupt
# .bin plus one prefix_search was a reliable SIGSEGV. It is now ITERATIVE over an
# explicit heap stack of (node, next_child_index, depth) frames, so depth costs
# heap (proportional to the path) instead of call frames, and no input length can
# exhaust the stack.
fn _shbdk_trie_collect(node, buf, depth, cap, results): i64 {
    # Frames are indexed by descent level, so they preallocate exactly once:
    # level `sp` is at path depth `depth + sp`, and sp never exceeds cap - depth.
    # (A push/pop work-vec was measurably slower — this does no per-node alloc.)
    var frames = cap - depth + 2;
    if (frames < 2) { frames = 2; }
    var nodes = alloc(frames * 8);
    var idxs = alloc(frames * 8);
    if (nodes == 0) { return 0; }
    if (idxs == 0) { return 0; }
    var sp = 0;
    store64(nodes + 0, node);
    store64(idxs + 0, 0);
    if (load64(node + 8) == 1) {
        vec_push(results, _shbdk_trie_str(buf, depth));
    }
    var cur = 0;
    var ci = 0;
    var d = 0;
    var ch = 0;
    var pair = 0;
    var child = 0;
    while (sp >= 0) {
        cur = load64(nodes + sp * 8);
        ci = load64(idxs + sp * 8);
        ch = load64(cur + 0);
        if (ci >= vec_len(ch)) {
            sp = sp - 1;
        } else {
            store64(idxs + sp * 8, ci + 1);
            d = depth + sp;
            if (d < cap) {
                pair = vec_get(ch, ci);
                store8(buf + d, load64(pair + 0));
                child = load64(pair + 8);
                if (load64(child + 8) == 1) {
                    vec_push(results, _shbdk_trie_str(buf, d + 1));
                }
                sp = sp + 1;
                store64(nodes + sp * 8, child);
                store64(idxs + sp * 8, 0);
            }
        }
    }
    return 0;
}

# All words starting with `prefix` (cstr), sorted alphabetically (by byte).
#must_use
fn shbdk_trie_search_prefix(t, prefix): i64 {
    var results = vec_new();
    if (prefix == 0) { return results; }   # 3.1.3: a null prefix matches nothing (it crashed)
    var node = load64(t + 0);
    var i = 0;
    while (load8(prefix + i) != 0) {
        node = _shbdk_trie_get_child(node, load8(prefix + i));
        if (node == 0) { return results; }
        i = i + 1;
    }
    # 3.0.4: size the path buffer to the trie's longest word instead of a flat
    # `plen + 65536`. That constant cost 64 KB of never-freed bump arena on EVERY
    # call (autocomplete-per-keystroke burns it fast) while still silently
    # dropping any longer word. max_word_len is exact, so nothing is dropped and
    # a normal dictionary needs ~30 bytes.
    var plen = strlen(prefix);
    var cap = load64(t + 16);
    if (plen > cap) { cap = plen; }
    var buf = alloc(cap + 1);
    if (buf == 0) { return results; }   # 3.0.4: alloc failure -> empty result, not a null write
    var k = 0;
    while (k < plen) {
        store8(buf + k, load8(prefix + k));
        k = k + 1;
    }
    _shbdk_trie_collect(node, buf, plen, cap, results);
    _shbdk_sort_strs(results);
    return results;
}

# The keystone's prefix_search (lives here since it builds a trie): all base+user
# words starting with `prefix` (cstr), sorted. Builds a trie per call — reuse a
# from_dict trie for repeated searches.
#must_use
fn shbdk_dict_prefix_search(d, prefix): i64 {
    return shbdk_trie_search_prefix(shbdk_trie_from_dict(d), prefix);
}

# --- heteronym.cyr ---

# heteronym.cyr — heteronym disambiguation via a resolver callback.
#
# Ports 3.1.3:rust-old/src/dictionary/heteronym.rs. Rust's `&dyn HeteronymResolver`
# trait object becomes a FN POINTER: a resolver is `fn(word, context) -> i64`
# returning a variant index, or -1 (Rust's None) to fall back to the primary.
# lookup_with_context calls it via fncall2. Extends the keystone; included after
# src/dictionary/mod.cyr. Phoneme-agnostic.
#
# HeteronymContext::new panics in Rust on out-of-bounds position; here we do NOT
# panic (zero-panic principle) — the accessors clamp defensively, as the Rust
# accessors already do for deserialized data.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkHeteronymContext layout (16 bytes): [0]=words(vec of word cstr) [8]=position.

# Context for the target at index `position` of `words` (a vec of word cstrs). An
# out-of-bounds position does not panic: the accessors below handle it (see the header).
#must_use
fn shbdk_heteronym_context_new(words, position): i64 {
    var c = alloc(16);
    store64(c + 0, words);
    store64(c + 8, position);
    return c;
}

# All words in the context: the vec passed to new, not a copy.
#must_use
fn shbdk_heteronym_context_words(c): i64 {
    return load64(c + 0);
}

# Index of the target word as stored, which may be out of bounds.
#must_use
fn shbdk_heteronym_context_position(c): i64 {
    return load64(c + 8);
}

# Move the target to index `position` (the Rust's field was public). Returns `c`.
fn shbdk_heteronym_context_set_position(c, position): i64 {
    store64(c + 8, position);
    return c;
}

# Target word (cstr), or "" if the position is out of bounds.
#must_use
fn shbdk_heteronym_target_word(c): cstring {
    var words = load64(c + 0);
    var pos = load64(c + 8);
    if (pos < 0) { return ""; }
    if (pos >= vec_len(words)) { return ""; }
    return vec_get(words, pos);
}

# Words before the target (a fresh vec), clamped to [0, min(pos, len)).
#must_use
fn shbdk_heteronym_preceding_words(c): i64 {
    var words = load64(c + 0);
    var pos = load64(c + 8);
    var len = vec_len(words);
    var end = pos;
    if (end > len) { end = len; }
    if (end < 0) { end = 0; }
    var out = vec_new();
    var i = 0;
    while (i < end) {
        vec_push(out, vec_get(words, i));
        i = i + 1;
    }
    return out;
}

# Words after the target (a fresh vec); empty if the target is last / out of range.
#must_use
fn shbdk_heteronym_following_words(c): i64 {
    var words = load64(c + 0);
    var pos = load64(c + 8);
    var len = vec_len(words);
    var out = vec_new();
    var i = pos + 1;
    if (i < 0) { i = 0; }
    while (i < len) {
        vec_push(out, vec_get(words, i));
        i = i + 1;
    }
    return out;
}

# Look up `word` (cstr) using a heteronym `resolver` fn-pointer for disambiguation.
# The resolver is fn(word, context) -> variant index, or -1 for None. Returns the
# selected variant's phonemes (vec), or the primary's; 0 if the word is absent.
#must_use
fn shbdk_dict_lookup_with_context(d, word, resolver, context): i64 {
    var entry = shbdk_dict_lookup_entry(d, word);
    if (entry == 0) { return 0; }
    # 3.0.4: a 0 resolver would be an indirect call to address 0. Zero-panic
    # contract: fall through to the primary pronunciation instead of crashing.
    if (shbdk_dict_entry_len(entry) > 1 && resolver != 0) {
        var idx = fncall2(resolver, word, context);
        if (idx >= 0) {
            if (idx < shbdk_dict_entry_len(entry)) {
                return shbdk_pronunciation_phonemes(vec_get(shbdk_dict_entry_all(entry), idx));
            }
        }
    }
    return shbdk_dict_entry_primary_phonemes(entry);
}

# --- g2p.cyr ---

# g2p.cyr — grapheme-to-phoneme model integration + fallback dictionary.
#
# Ports 3.1.3:rust-old/src/dictionary/g2p.rs. Rust's G2PModel trait objects carry state
# (MockG2PModel's confidence, FstModel's path), so a bare fn-pointer is not
# enough: a "model" here is a (predict_fp, model_state) PAIR — predict_fp is
# fn(word, state) -> G2PResult* (or 0 for None), invoked via fncall2. Extends the
# keystone (with_fallback); included after src/dictionary/mod.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- G2PResult (16 bytes): [0]=phonemes(vec) [8]=confidence(f64 bits) ----------
#must_use
fn shbdk_g2p_result_new(phonemes, confidence): i64 {
    var r = alloc(16);
    store64(r + 0, phonemes);
    store64(r + 8, confidence);
    return r;
}

# Predicted phoneme sequence (vec).
#must_use
fn shbdk_g2p_result_phonemes(r): i64 {
    return load64(r + 0);
}

# Confidence score, 0.0 to 1.0 (f64 bits).
#must_use
fn shbdk_g2p_result_confidence(r): i64 {
    return load64(r + 8);
}

# into_phonemes: consumes the result, yields the phoneme vec (same handle).
#must_use
fn shbdk_g2p_result_into_phonemes(r): i64 {
    return load64(r + 0);
}

# ---- LookupSource (#[non_exhaustive] enum) -----------------------------------
var SHBDK_SOURCE_USER_OVERLAY    = 0;
var SHBDK_SOURCE_BASE_DICTIONARY = 1;
var SHBDK_SOURCE_G2P_MODEL       = 2;

# ShbdkLookupResult (24 bytes): [0]=phonemes(vec) [8]=source(tag)
#   [16]=confidence(f64 bits; only meaningful for G2P_MODEL). 0 == None.
fn _shbdk_lookup_result_new(phonemes, source, confidence): i64 {
    var r = alloc(24);
    store64(r + 0, phonemes);
    store64(r + 8, source);
    store64(r + 16, confidence);
    return r;
}

# Phonemes the lookup produced (vec).
#must_use
fn shbdk_lookup_result_phonemes(r): i64 { return load64(r + 0); }

# Where the phonemes came from: a SHBDK_SOURCE_* tag.
#must_use
fn shbdk_lookup_result_source(r): i64 { return load64(r + 8); }

# Confidence (f64 bits). Only meaningful when the source is SHBDK_SOURCE_G2P_MODEL.
#must_use
fn shbdk_lookup_result_confidence(r): i64 { return load64(r + 16); }

# Clone an int (phoneme) vec — dict lookups return owned Vecs in Rust.
fn _shbdk_clone_iv(v): i64 {
    var out = vec_new();
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        vec_push(out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# ---- FallbackDict (24 bytes): [0]=dict [8]=predict_fp [16]=model_state ---------
# 3.0.4: every G2P entry point below routes its model call through this guard. A
# FallbackDict built with a 0 predict_fp (Rust could not express that — the trait
# object was non-null by construction) would otherwise be an indirect call to
# address 0. Zero-panic contract: a missing model behaves as "predicts nothing".
fn _shbdk_g2p_predict(f, key): i64 {
    var fp = load64(f + 8);
    if (fp == 0) { return 0; }
    return fncall2(fp, str_data(key), load64(f + 16));
}

# Fallback dictionary over `dict`, using the model pair (predict_fp, model_state).
#must_use
fn shbdk_fallback_dict_new(dict, predict_fp, model_state): i64 {
    var f = alloc(24);
    store64(f + 0, dict);
    store64(f + 8, predict_fp);
    store64(f + 16, model_state);
    return f;
}

# The underlying dictionary (also serves as dict_mut / the dict half of into_parts).
#must_use
fn shbdk_fallback_dict_dict(f): i64 {
    return load64(f + 0);
}

# The model state (the model half of into_parts).
#must_use
fn shbdk_fallback_dict_model(f): i64 {
    return load64(f + 16);
}

# Primary pronunciation: user overlay -> base dict -> G2P model. Returns an
# (owned) phoneme vec, or 0 if none.
#must_use
fn shbdk_fallback_dict_lookup(f, word): i64 {
    if (word == 0) { return 0; }   # 3.1.3: a null word is no word (it crashed)
    var phonemes = shbdk_dict_lookup(load64(f + 0), word);
    if (phonemes != 0) { return _shbdk_clone_iv(phonemes); }
    var key = str_from(shbdk_lower_cstr(word));
    var result = _shbdk_g2p_predict(f, key);
    if (result == 0) { return 0; }
    # 3.1.3: a copy, like the dictionary paths — a model may reuse its output vec.
    return _shbdk_clone_iv(shbdk_g2p_result_into_phonemes(result));
}

# Look up with source: user overlay -> base -> G2P. Returns a ShbdkLookupResult
# (phonemes + source tag + confidence), or 0 if none.
#must_use
fn shbdk_fallback_dict_lookup_with_source(f, word): i64 {
    if (word == 0) { return 0; }
    var dict = load64(f + 0);
    var key = str_from(shbdk_lower_cstr(word));
    var e = map_get(shbdk_dict_user_entries(dict), key);
    if (e != 0) {
        var up = _shbdk_clone_iv(shbdk_dict_entry_primary_phonemes(e));
        return _shbdk_lookup_result_new(up, SHBDK_SOURCE_USER_OVERLAY, 0);
    }
    e = map_get(shbdk_dict_entries(dict), key);
    if (e != 0) {
        var bp = _shbdk_clone_iv(shbdk_dict_entry_primary_phonemes(e));
        return _shbdk_lookup_result_new(bp, SHBDK_SOURCE_BASE_DICTIONARY, 0);
    }
    var result = _shbdk_g2p_predict(f, key);
    if (result == 0) { return 0; }
    var gp = _shbdk_clone_iv(shbdk_g2p_result_into_phonemes(result));
    var gc = shbdk_g2p_result_confidence(result);
    return _shbdk_lookup_result_new(gp, SHBDK_SOURCE_G2P_MODEL, gc);
}

# Full dictionary entry (dict layers only, no G2P), or 0.
#must_use
fn shbdk_fallback_dict_lookup_entry(f, word): i64 {
    return shbdk_dict_lookup_entry(load64(f + 0), word);
}

# Promote a G2P prediction to the user overlay (no-op if already in the dict).
# Returns 1 if promoted.
fn shbdk_fallback_dict_promote_prediction(f, word): i64 {
    if (word == 0) { return 0; }
    var dict = load64(f + 0);
    if (shbdk_dict_lookup_entry(dict, word) != 0) { return 0; }
    var key = str_from(shbdk_lower_cstr(word));
    var result = _shbdk_g2p_predict(f, key);
    if (result == 0) { return 0; }
    shbdk_dict_insert_user(dict, word, shbdk_g2p_result_phonemes(result));
    return 1;
}

# Promote only if confidence >= threshold (f64 bits). Returns 1 if promoted.
fn shbdk_fallback_dict_promote_if_confident(f, word, threshold): i64 {
    if (word == 0) { return 0; }
    var dict = load64(f + 0);
    if (shbdk_dict_lookup_entry(dict, word) != 0) { return 0; }
    var key = str_from(shbdk_lower_cstr(word));
    var result = _shbdk_g2p_predict(f, key);
    if (result == 0) { return 0; }
    if (f64_ge(shbdk_g2p_result_confidence(result), threshold) == 1) {
        shbdk_dict_insert_user(dict, word, shbdk_g2p_result_phonemes(result));
        return 1;
    }
    return 0;
}

# The keystone's with_fallback (lives here since it builds a FallbackDict).
#must_use
fn shbdk_dict_with_fallback(dict, predict_fp, model_state): i64 {
    return shbdk_fallback_dict_new(dict, predict_fp, model_state);
}

# ---- FstModel (Phonetisaurus WFST wrapper) -----------------------------------
var SHBDK_FST_NOTATION_ARPABET = 0;
var SHBDK_FST_NOTATION_IPA     = 1;

# ShbdkFstModel (16 bytes): [0]=model_path(cstr) [8]=notation(SHBDK_FST_NOTATION_*).
#must_use
fn shbdk_fst_model_new(model_path, notation): i64 {
    var m = alloc(16);
    if (model_path == 0) { model_path = ""; }
    store64(m + 0, shbdk_copyz(model_path, strlen(model_path)));   # 3.1.3: copied, as the Rust's String
    store64(m + 8, notation);
    return m;
}

# Path to the model file, as given to shbdk_fst_model_new.
#must_use
fn shbdk_fst_model_path(m): cstring {
    return load64(m + 0);
}

# Output notation of this model: a SHBDK_FST_NOTATION_* tag.
#must_use
fn shbdk_fst_model_notation(m): i64 {
    return load64(m + 8);
}

# G2PModel predict for FstModel — a STUB that always returns None (0). Wire in a
# real WFST engine here. Signature is (word, state) for use as a predict_fp.
fn shbdk_fst_model_predict(word, state): i64 {
    return 0;
}

# --- phf.cyr ---

# phf.cyr — the compile-time perfect hash behind static_dict.cyr.
#
# The Rust crate's `phf` feature baked the English dictionary into a phf::Map at build
# time (build.rs + phf_codegen). This is the same scheme, CHD "hash and displace":
#
#   h      = _shbdk_phf_hash(key, seed)            one 64-bit hash per key
#   bucket = (h >> 44) % buckets                   about 5 keys per bucket
#   slot   = (f2 + f1 * d1 + d2) % len             f1 = h bits 22..43, f2 = bits 0..21
#
# where (d1, d2) is the displacement the generator found for that bucket, so that
# every key lands in its own slot and every slot holds exactly one key (len slots
# for len keys, as phf does). A lookup is one hash, one displacement read, one key
# compare: no probing, so no input is slower than any other, whatever the keys.
#
# programs/gen_cmudict.cyr searches the seed and the displacements and writes them
# to src/dictionary/_static_phf_data.cyr. The generator and the runtime both
# include THIS file, so the hash and the slot math have one definition.
#
# The tables are text in string literals: each value is fixed-width base-32
# ("0"-"9", "a"-"v", 5 bits a character), which keeps `"` and `\` out of them.
#
# Self-contained: load8 / store8 only. NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

var SHBDK_PHF_LAMBDA = 5;       # keys per bucket the generator aims for
var SHBDK_PHF_DISP_W = 3;       # base-32 characters per displacement value (15 bits)
var SHBDK_PHF_LOC_W = 4;        # base-32 characters per slot locator (20 bits)
var SHBDK_PHF_OFF_BITS = 15;    # locator = piece << 15 | byte offset in that piece
var SHBDK_PHF_LOC_CHUNK = 4096; # slots per locator string literal (16 KB of text)

# MurmurHash3's fmix64 finalizer: every input bit reaches every output bit.
# `>>` is logical in Cyrius, which the finalizer needs.
fn _shbdk_phf_fmix(h): i64 {
    h = h ^ (h >> 33);
    h = h * 0xFF51AFD7ED558CCD;
    h = h ^ (h >> 33);
    h = h * 0xC4CEB9FE1A85EC53;
    h = h ^ (h >> 33);
    return h;
}

# Hash bytes [p, p + n) with `seed`: FNV-1a over the ASCII-lowercased bytes, then
# fmix64. Folding A-Z here lets a lookup of "Hello" hash as "hello" without a copy.
# A word with any non-ASCII byte is lowercased with Unicode semantics before it
# gets here (static_dict.cyr), so the fold matches shbdk_dict_lookup_entry's.
fn _shbdk_phf_hash(p, n, seed): i64 {
    var h = 0xCBF29CE484222325 ^ _shbdk_phf_fmix(seed + 1);
    var i = 0;
    var c = 0;
    while (i < n) {
        c = load8(p + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        h = (h ^ c) * 0x100000001B3;
        i = i + 1;
    }
    return _shbdk_phf_fmix(h);
}

# The bucket a hash falls in (its top 20 bits, so it is independent of f1 and f2).
fn _shbdk_phf_bucket(h, buckets): i64 {
    return (h >> 44) % buckets;
}

# The slot a hash lands in under displacement (d1, d2). Every term is non-negative
# and below 2^38, so the sum cannot overflow and `%` stays non-negative.
fn _shbdk_phf_index(h, d1, d2, len): i64 {
    var f1 = (h >> 22) & 0x3FFFFF;
    var f2 = h & 0x3FFFFF;
    return (f2 + f1 * d1 + d2) % len;
}

# Read a k-character base-32 value at s[off].
fn _shbdk_phf_read(s, off, k): i64 {
    var v = 0;
    var i = 0;
    var c = 0;
    while (i < k) {
        c = load8(s + off + i);
        if (c <= 57) { c = c - 48; } else { c = c - 87; }   # '0'-'9' -> 0-9, 'a'-'v' -> 10-31
        v = (v << 5) | c;
        i = i + 1;
    }
    return v;
}

# Write v as k base-32 characters at buf[off] (most significant first). Returns k.
fn _shbdk_phf_write(buf, off, v, k): i64 {
    var i = k - 1;
    var d = 0;
    while (i >= 0) {
        d = v & 31;
        if (d < 10) { store8(buf + off + i, 48 + d); } else { store8(buf + off + i, 87 + d); }
        v = v >> 5;
        i = i - 1;
    }
    return k;
}

# --- _static_phf_data.cyr ---

# _static_phf_data.cyr - AUTO-GENERATED by programs/gen_cmudict.cyr from
# data/cmudict-5k.txt. Do NOT edit by hand; regeneration overwrites.
# The perfect hash over _cmudict_data.cyr's keys; src/dictionary/phf.cyr has the scheme.

var _SHBDK_PHF_SEED = 0;
var _SHBDK_PHF_LEN = 10617;
var _SHBDK_PHF_BUCKETS = 2124;

# Per bucket: d1 then d2, SHBDK_PHF_DISP_W base-32 characters each.
var _SHBDK_PHF_DISP = "";

# Per slot: piece << 15 | byte offset of its entry, SHBDK_PHF_LOC_W base-32
# characters each, SHBDK_PHF_LOC_CHUNK slots per literal.
var _SHBDK_PHF_LOC_0 = "";
var _SHBDK_PHF_LOC_1 = "";
var _SHBDK_PHF_LOC_2 = "";

var _SHBDK_PHF_LOC_COUNT = 3;

fn _shbdk_phf_loc_piece(i): cstring {
    if (i == 0) { return _SHBDK_PHF_LOC_0; }
    if (i == 1) { return _SHBDK_PHF_LOC_1; }
    if (i == 2) { return _SHBDK_PHF_LOC_2; }
    return 0;
}

# --- static_dict.cyr ---

# static_dict.cyr — static English dictionary over a compile-time perfect hash
# (ports 3.1.3:rust-old/src/dictionary/static_dict.rs).
#
# The Rust baked the dictionary into a phf::Map with build.rs + phf_codegen. Since
# 3.1.2 this is the same thing: programs/gen_cmudict.cyr computes a CHD perfect
# hash over the base dictionary's keys and writes it to _static_phf_data.cyr (the
# scheme is in phf.cyr). Each of its slots points at one entry in the packed
# _cmudict_data.cyr pieces, so the data is shared with shbdk_dict_english(), not
# written twice.
#
# What a lookup costs:
#   - no dictionary load. Through 3.1.1 the first lookup built the whole
#     10,617-entry dictionary (about 10 ms); now nothing is built up front.
#   - one hash, one displacement, one key compare against the packed bytes. A miss
#     allocates nothing, and neither does a word with capitals (the hash and the
#     compare fold A-Z themselves, where the dictionary lookup copies).
#   - the first hit on a word decodes that one entry and caches it by slot, so the
#     same word returns the same entry pointer every time after, as Rust's
#     &'static StaticEntry does, and allocates nothing more. The slot cache
#     (8 bytes a slot, 85 KB) is allocated by the first hit.
#
# StaticEntry / StaticPronunciation collapse onto ShbdkDictEntry / ShbdkPronunciation:
# their accessors (shbdk_dict_entry_primary_phonemes / _all / _len) give the
# surface. An entry returned here is the static dictionary's own; mutating it
# changes what later lookups return, which Rust's &'static could not do.
#
# Requires: dictionary/entry.cyr, _cmudict_data.cyr + cmudict.cyr (the pieces and
# _shbdk_cmudict_decode_entry), phf.cyr + _static_phf_data.cyr (the table), and
# dictionary/mod.cyr for shbdk_static_dict().
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

var _SHBDK_STATIC_CACHE = 0;   # slot -> decoded ShbdkDictEntry* (0 = not decoded yet)
var _SHBDK_STATIC_DICT = 0;    # shbdk_static_dict()'s handle (0 = unbuilt)

# Forget the decoded-entry cache and shbdk_static_dict()'s handle. Both live in the
# allocator like any other allocation, so a consumer that calls alloc_reset() must
# call this too before the next static lookup (3.1.3). The table itself is constant
# data and is never affected.
fn shbdk_static_reset(): i64 {
    _SHBDK_STATIC_CACHE = 0;
    _SHBDK_STATIC_DICT = 0;
    return 0;
}

# The packed-entry locator of `slot`: piece << SHBDK_PHF_OFF_BITS | byte offset.
fn _shbdk_static_loc(slot): i64 {
    var chunk = _shbdk_phf_loc_piece(slot / SHBDK_PHF_LOC_CHUNK);
    return _shbdk_phf_read(chunk, (slot % SHBDK_PHF_LOC_CHUNK) * SHBDK_PHF_LOC_W, SHBDK_PHF_LOC_W);
}

# The slot the perfect hash sends bytes [word, word + n) to. Every input has one,
# key or not; _shbdk_static_slot decides whether the key there is this word.
fn _shbdk_static_probe(word, n): i64 {
    var h = _shbdk_phf_hash(word, n, _SHBDK_PHF_SEED);
    var g = _shbdk_phf_bucket(h, _SHBDK_PHF_BUCKETS);
    var dw = SHBDK_PHF_DISP_W;
    var d1 = _shbdk_phf_read(_SHBDK_PHF_DISP, g * 2 * dw, dw);
    var d2 = _shbdk_phf_read(_SHBDK_PHF_DISP, g * 2 * dw + dw, dw);
    return _shbdk_phf_index(h, d1, d2, _SHBDK_PHF_LEN);
}

# The slot holding `word` (a cstr, A-Z folded), or -1 when the word is absent. The
# key in the probed slot must equal the folded word byte for byte and end ('|')
# where the word ends.
fn _shbdk_static_slot(word): i64 {
    if (word == 0) { return 0 - 1; }
    if (_SHBDK_PHF_LEN == 0) { return 0 - 1; }
    # The hash and the compare fold A-Z in place. A word with any non-ASCII byte is
    # lowercased with Unicode semantics first (3.1.3), as shbdk_dict_lookup_entry
    # does: the KELVIN SIGN U+212A lowercases to "k", so it can still be a key.
    # One pass finds the length and any non-ASCII byte.
    var n = 0;
    var wide = 0;
    var c = load8(word);
    while (c != 0) {
        if (c >= 128) { wide = 1; }
        n = n + 1;
        c = load8(word + n);
    }
    if (wide == 1) {
        word = shbdk_lower_n(word, n);
        n = strlen(word);
    }
    var slot = _shbdk_static_probe(word, n);
    var loc = _shbdk_static_loc(slot);
    var key = _shbdk_cmudict_piece(loc >> SHBDK_PHF_OFF_BITS) + (loc & ((1 << SHBDK_PHF_OFF_BITS) - 1));
    if (_shbdk_static_key_is(key, word, n) == 0) { return 0 - 1; }
    return slot;
}

# 1 if the packed entry at `key` ("word|pron|...;") has exactly the n-byte `word`
# (A-Z folded) as its key, else 0.
fn _shbdk_static_key_is(key, word, n): i64 {
    var i = 0;
    var c = 0;
    var k = 0;
    while (i < n) {
        k = load8(key + i);
        # A key holds no '|', so meeting the separator first means the key is
        # shorter. Without this stop, "read|43,1,23~0.7" would match through the
        # first pronunciation and end at the second one's '|'. It also keeps the
        # read inside the entry.
        if (k == 124) { return 0; }
        c = load8(word + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (k != c) { return 0; }
        i = i + 1;
    }
    if (load8(key + n) != 124) { return 0; }   # the key is longer than the word
    return 1;
}

# Decode the entry in `slot` from its packed piece (uncached).
fn _shbdk_static_decode(slot): i64 {
    var loc = _shbdk_static_loc(slot);
    var piece = _shbdk_cmudict_piece(loc >> SHBDK_PHF_OFF_BITS);
    var s = loc & ((1 << SHBDK_PHF_OFF_BITS) - 1);
    var wsep = s;
    while (load8(piece + wsep) != 124) { wsep = wsep + 1; }   # '|' ends the word
    var e = wsep;
    while (load8(piece + e) != 59) { e = e + 1; }             # ';' ends the entry
    return _shbdk_cmudict_decode_entry(piece, wsep, e);
}

# Look up a word's full static entry, or 0 (None). (Rust static_dict::lookup_entry)
#must_use
fn shbdk_static_lookup_entry(word): i64 {
    var slot = _shbdk_static_slot(word);
    if (slot < 0) { return 0; }
    if (_SHBDK_STATIC_CACHE == 0) {
        var cache = alloc(_SHBDK_PHF_LEN * 8);
        # without a cache the entry is still right, only decoded on every lookup
        if (cache == 0) { return _shbdk_static_decode(slot); }
        # one store a slot: the stdlib memset is a byte loop, 8x the stores
        var ci = 0;
        while (ci < _SHBDK_PHF_LEN) {
            store64(cache + ci * 8, 0);
            ci = ci + 1;
        }
        _SHBDK_STATIC_CACHE = cache;
    }
    var e = load64(_SHBDK_STATIC_CACHE + slot * 8);
    if (e == 0) {
        e = _shbdk_static_decode(slot);
        store64(_SHBDK_STATIC_CACHE + slot * 8, e);
    }
    return e;
}

# Look up a word's primary pronunciation phonemes, or 0 (None). (Rust static_dict::lookup)
#must_use
fn shbdk_static_lookup(word): i64 {
    var e = shbdk_static_lookup_entry(word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_primary_phonemes(e);
}

# Number of entries in the static dictionary: a generated constant. (Rust static_dict::len)
#must_use
fn shbdk_static_len(): i64 {
    return _SHBDK_PHF_LEN;
}

# Whether the static dictionary is empty. (Rust static_dict::is_empty)
#must_use
fn shbdk_static_is_empty(): i64 {
    if (_SHBDK_PHF_LEN == 0) { return 1; }
    return 0;
}

# The base English dictionary as a PronunciationDict handle, built on first use and
# cached. Not in the Rust; kept from 3.0.0 for callers that want a dict handle (for
# prefix search, export, or merging). The lookups above do not use it, so they do
# not pay for building it, and the entries they return are not this dict's.
#must_use
fn shbdk_static_dict(): i64 {
    if (_SHBDK_STATIC_DICT == 0) {
        _SHBDK_STATIC_DICT = shbdk_dict_english();
    }
    return _SHBDK_STATIC_DICT;
}

# --- mod.cyr ---

# format/mod.cyr — dictionary import/export: CMUdict + IPA text formats, XML
# escape helpers (shared by pls/ssml), and file I/O.
#
# Ports 3.1.3:rust-old/src/dictionary/format/mod.rs (minus the JSON codec, which is its
# own bite per the serde stance). Parsers return a PronunciationDict pointer, or
# 0 on a parse error (Rust's Err(DictParseError)); shbdk_last_error() then says
# why, with the line number, as the Rust's message did. Writers return 0 when the
# dictionary holds something the format cannot represent (a word with a newline,
# a pronunciation with no ARPABET symbol), rather than write a file that will not
# load back. Included after arpabet + ipa + mod.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- byte-scan helpers -------------------------------------------------------
# Whitespace is Unicode White_Space (error.cyr's shbdk_ws_len), what Rust's trim()
# and split_whitespace() use; LF never reaches these, since it ends the line.
#
# 3.1.3: this was ASCII only, so a word followed by NBSP or U+3000 kept it in its
# key, and a phoneme list split on U+2003 failed as one unknown symbol.

# First non-whitespace offset in s[i..e).
fn _shbdk_fmt_skip_ws(s, i, e): i64 {
    var w = 0;
    while (i < e) {
        w = shbdk_ws_len(s, i, e);
        if (w == 0) { return i; }
        i = i + w;
    }
    return e;
}

# End of s[i..e) with trailing whitespace removed (i is the floor).
fn _shbdk_fmt_trim_end(s, i, e): i64 {
    var w = 0;
    while (e > i) {
        w = shbdk_ws_len_before(s, i, e);
        if (w == 0) { return e; }
        e = e - w;
    }
    return i;
}

# Offset of the first whitespace code point in s[i..e), or e.
fn _shbdk_fmt_find_ws(s, i, e): i64 {
    while (i < e) {
        if (shbdk_ws_len(s, i, e) > 0) { return i; }
        i = i + 1;
    }
    return e;
}

fn _shbdk_fmt_line_end(s, off, end): i64 {
    while (off < end) {
        if (load8(s + off) == 10) { return off; }
        off = off + 1;
    }
    return off;
}

# Lowercased NUL-terminated copy of s[start..end), Unicode semantics (3.1.3; it
# folded ASCII only). shbdk_lower_n returns "" on allocation failure.
fn _shbdk_fmt_lower_dup(s, start, end): i64 {
    return shbdk_lower_n(s + start, end - start);
}

# NUL-terminated copy of s[start..end) (no case change).
fn _shbdk_fmt_dup(s, start, end): i64 {
    return shbdk_copyz(s + start, end - start);
}

# 1 if s[pos..] begins with cstr `lit`.
fn _shbdk_starts_at(s, pos, lit): i64 {
    var j = 0;
    var n = strlen(lit);
    while (j < n) {
        if (load8(s + pos + j) != load8(lit + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# ---- XML escape / unescape (shared with pls / ssml) --------------------------
fn _shbdk_xml_entity(c): i64 {
    if (c == 38) { return "&amp;"; }
    if (c == 60) { return "&lt;"; }
    if (c == 62) { return "&gt;"; }
    if (c == 34) { return "&quot;"; }
    if (c == 39) { return "&apos;"; }
    return 0;
}

# Escape XML special chars (& < > " ') in `s`. Returns a fresh cstr.
#must_use
fn shbdk_xml_escape(s): cstring {
    var sb = str_builder_new();
    var i = 0;
    var ent = 0;
    while (load8(s + i) != 0) {
        ent = _shbdk_xml_entity(load8(s + i));
        if (ent != 0) {
            str_builder_add_cstr(sb, ent);
        } else {
            str_builder_add_byte(sb, load8(s + i));
        }
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# A numeric character reference at s[i] ("&#65;" / "&#x41;"): writes the code point
# to store64(out) and returns the reference's length, or 0 if there is none or it
# names no character (0, a surrogate, or past U+10FFFF).
fn _shbdk_xml_numref(s, i, out): i64 {
    if (load8(s + i) != 38 || load8(s + i + 1) != 35) { return 0; }   # "&#"
    var j = i + 2;
    var hex = 0;
    if (load8(s + j) == 120) { hex = 1; j = j + 1; }                   # 'x'
    var cp = 0;
    var digits = 0;
    var c = 0;
    var d = 0;
    while (digits < 8) {
        c = load8(s + j);
        d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        if (hex == 1 && c >= 97 && c <= 102) { d = c - 87; }
        if (hex == 1 && c >= 65 && c <= 70) { d = c - 55; }
        if (d < 0) { break; }
        if (hex == 1) { cp = cp * 16 + d; } else { cp = cp * 10 + d; }
        digits = digits + 1;
        j = j + 1;
    }
    if (digits == 0 || load8(s + j) != 59) { return 0; }   # ';'
    if (cp == 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { return 0; }
    store64(out, cp);
    return j + 1 - i;
}

# Decode one unit at s[i]: append the decoded byte(s) to `sb`, return bytes read.
# 3.1.3: numeric references (&#233; &#xE9;) decode as well as the five named ones
# (the Rust decoded only the five).
fn _shbdk_xml_decode_at(s, i, sb): i64 {
    var cpb[8];
    var nr = _shbdk_xml_numref(s, i, &cpb);
    if (nr > 0) {
        var ub = alloc(8);
        var k = _uc_emit_utf8(ub, load64(&cpb));
        var q = 0;
        while (q < k) { str_builder_add_byte(sb, load8(ub + q)); q = q + 1; }
        return nr;
    }
    if (_shbdk_starts_at(s, i, "&amp;") == 1) { str_builder_add_byte(sb, 38); return 5; }
    if (_shbdk_starts_at(s, i, "&lt;") == 1) { str_builder_add_byte(sb, 60); return 4; }
    if (_shbdk_starts_at(s, i, "&gt;") == 1) { str_builder_add_byte(sb, 62); return 4; }
    if (_shbdk_starts_at(s, i, "&quot;") == 1) { str_builder_add_byte(sb, 34); return 6; }
    if (_shbdk_starts_at(s, i, "&apos;") == 1) { str_builder_add_byte(sb, 39); return 6; }
    str_builder_add_byte(sb, load8(s + i));
    return 1;
}

# Unescape XML entities in `s`. Returns a fresh cstr.
#must_use
fn shbdk_xml_unescape(s): cstring {
    var sb = str_builder_new();
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        i = i + _shbdk_xml_decode_at(s, i, sb);
    }
    return str_data(str_builder_build(sb));
}

# ---- shared field checks -----------------------------------------------------
# Read the frequency in input[vs..ve) into store64(out). Returns 1 on success, 0
# if it is not a number, -1 if it is a number but not a frequency (0.0-1.0).
fn _shbdk_fmt_read_freq(input, vs, ve, out): i64 {
    if (shbdk_decimal_syntax(input, vs, ve) == 0) { return 0; }
    if (f64_parse_ok(_shbdk_fmt_dup(input, vs, ve), out) == 0) { return 0; }
    if (shbdk_frequency_is_valid(load64(out)) == 0) { return 0 - 1; }
    return 1;
}

# 1 if Str key `k` can be written as a CMUdict word that reads back as itself:
# non-empty well-formed UTF-8 with no NUL, CR or LF, no leading / trailing
# whitespace, no two-space run (the separator), not a ";;;" comment, and no
# trailing "(digits)" (it would read as a variant marker).
fn _shbdk_cmudict_word_ok(k): i64 {
    var p = str_data(k);
    var n = str_len(k);
    if (n == 0) { return 0; }
    var i = 0;
    var c = 0;
    var wide = 0;
    while (i < n) {
        c = load8(p + i);
        if (c == 0 || c == 10 || c == 13) { return 0; }
        if (c == 32 && i + 1 < n && load8(p + i + 1) == 32) { return 0; }
        if (c >= 128) { wide = 1; }
        i = i + 1;
    }
    if (wide == 1 && shbdk_utf8_valid(p, n) == 0) { return 0; }
    if (shbdk_ws_len(p, 0, n) > 0) { return 0; }
    if (shbdk_ws_len_before(p, 0, n) > 0) { return 0; }
    if (n >= 3 && load8(p) == 59 && load8(p + 1) == 59 && load8(p + 2) == 59) { return 0; }
    if (shbdk_cmudict_word_end(p, 0, n) != n) { return 0; }
    return 1;
}

# ---- CMUdict parse -----------------------------------------------------------
# Parse extended CMUdict text into a PronunciationDict, or 0 on a parse error,
# with the reason in shbdk_last_error(): a malformed or out-of-range @freq, an
# unknown @region, a line with no two-space separator, an empty word, an unknown
# ARPABET symbol, a word with no phonemes, or input that is not UTF-8.
#must_use
fn shbdk_parse_cmudict(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var len = strlen(input);
    if (shbdk_utf8_valid(input, len) == 0) { return _shbdk_fail("input is not valid UTF-8"); }
    var word_map = map_new_str();
    var order = vec_new();
    var pending_freq = SHBDK_FREQ_NONE;
    var pending_region = SHBDK_REGION_NONE;
    var pos = 0;
    var line = 0;
    var le = 0;
    var s = 0;
    var e = 0;
    var sep = 0;
    var found = 0;
    var ws = 0;
    var we = 0;
    var phon = 0;
    var pp = 0;
    var ss = 0;
    var ph = 0;
    var pron = 0;
    var wkey = 0;
    var acc = 0;
    var ti = 0;
    var vs = 0;
    var ve = 0;
    var rf = 0;
    var fc = alloc(8);
    while (pos < len) {
        le = _shbdk_fmt_line_end(input, pos, len);
        line = line + 1;
        s = _shbdk_fmt_skip_ws(input, pos, le);
        e = _shbdk_fmt_trim_end(input, s, le);
        if (s >= e) { pos = le + 1; continue; }

        # comment / annotation line: an annotation is a whitespace-delimited token
        # that STARTS with @freq= / @region= (Rust's split_whitespace +
        # strip_prefix), so `;;; note@freq=0.5` carries none.
        if (_shbdk_starts_at(input, s, ";;;") == 1) {
            ti = s + 3;
            while (ti < e) {
                ti = _shbdk_fmt_skip_ws(input, ti, e);
                if (ti >= e) { break; }
                ve = _shbdk_fmt_find_ws(input, ti, e);
                if (_shbdk_starts_at(input, ti, "@freq=") == 1 && ti + 6 <= ve) {
                    vs = ti + 6;
                    rf = _shbdk_fmt_read_freq(input, vs, ve, fc);
                    if (rf == 0) { return _shbdk_fail_line(line, "invalid @freq value: ", input, vs, ve, 0); }
                    if (rf < 0) {
                        return _shbdk_fail_line(line, "@freq out of range (0.0-1.0): ", input, vs, ve, 0);
                    }
                    pending_freq = load64(fc);
                } else {
                    if (_shbdk_starts_at(input, ti, "@region=") == 1 && ti + 8 <= ve) {
                        vs = ti + 8;
                        pending_region = shbdk_region_from_code(_shbdk_fmt_dup(input, vs, ve));
                        if (pending_region == SHBDK_REGION_NONE) {
                            return _shbdk_fail_line(line, "unknown region code: ", input, vs, ve, 0);
                        }
                    }
                }
                ti = ve;
            }
            pos = le + 1;
            continue;
        }

        # entry line: the first two-space separator splits word from phonemes
        sep = s;
        found = 0;
        while (sep < e - 1) {
            if (load8(input + sep) == 32 && load8(input + sep + 1) == 32) { found = 1; break; }
            sep = sep + 1;
        }
        if (found == 0) { return _shbdk_fail_line(line, "missing two-space separator", 0, 0, 0, 0); }

        # the word: trimmed, its "(n)" variant marker cut, trimmed again, lowercased.
        # 3.1.3: the second trim is new ("read (1)" stored "read "), and an empty word
        # is an error (it stored the key "").
        ws = s;
        we = _shbdk_fmt_trim_end(input, ws, sep);
        we = _shbdk_fmt_trim_end(input, ws, shbdk_cmudict_word_end(input, ws, we));
        if (we <= ws) { return _shbdk_fail_line(line, "empty word", 0, 0, 0, 0); }
        # a word still ending in "(n)" after its marker is cut ("a(2)(3)") cannot be
        # written back unambiguously, so it is refused rather than stored
        if (shbdk_cmudict_word_end(input, ws, we) != we) {
            return _shbdk_fail_line(line, "a word may not end in a (n) variant marker", 0, 0, 0, 0);
        }

        # phonemes, and each symbol's stress digit (3.2.0: the digits were read and
        # dropped, so every export gave every vowel a 1)
        phon = vec_new();
        var stress = vec_new();
        var any_digit = 0;
        pp = sep + 2;
        while (pp < e) {
            pp = _shbdk_fmt_skip_ws(input, pp, e);
            if (pp >= e) { break; }
            ss = pp;
            pp = _shbdk_fmt_find_ws(input, pp, e);
            var sym = _shbdk_fmt_dup(input, ss, pp);
            ph = shbdk_arpabet_to_phoneme_with_stress(sym);
            if (ph == SHBDK_PH_NONE) { return _shbdk_fail_line(line, "unknown ARPABET symbol '", input, ss, pp, "'"); }
            vec_push(phon, ph);
            # a digit counts on a vowel only: a consonant has no stress, and "Y1" read as
            # Y before 3.2.0 too (keeping the 1 would give stress no writer can write)
            var dg = shbdk_arpabet_stress(sym);
            if (shbdk_phoneme_takes_stress(ph) == 0) { dg = SHBDK_STRESS_NONE; }
            if (dg != SHBDK_STRESS_NONE) { any_digit = 1; }
            vec_push(stress, dg);
        }
        if (vec_len(phon) == 0) { return _shbdk_fail_line(line, "no phonemes for word '", input, ws, we, "'"); }

        pron = shbdk_pronunciation_new(phon);
        if (any_digit == 1) { pron = shbdk_pronunciation_with_stress(pron, stress); }
        if (pending_freq != SHBDK_FREQ_NONE) {
            pron = shbdk_pronunciation_with_frequency(pron, pending_freq);
            pending_freq = SHBDK_FREQ_NONE;
        }
        if (pending_region != SHBDK_REGION_NONE) {
            pron = shbdk_pronunciation_with_region(pron, pending_region);
            pending_region = SHBDK_REGION_NONE;
        }

        wkey = str_from(_shbdk_fmt_lower_dup(input, ws, we));
        acc = map_get(word_map, wkey);
        if (acc == 0) {
            acc = vec_new();
            vec_push(acc, pron);
            map_set(word_map, wkey, acc);
            vec_push(order, wkey);
        } else {
            vec_push(acc, pron);
        }
        pos = le + 1;
    }

    # build the dict
    var dict = shbdk_dict_new();
    var i = 0;
    var nw = vec_len(order);
    var wk = 0;
    var entry = 0;
    while (i < nw) {
        wk = vec_get(order, i);
        entry = shbdk_dict_entry_from_pronunciations(map_get(word_map, wk));
        if (entry != 0) {
            shbdk_dict_insert_entry(dict, str_data(wk), entry);
        }
        i = i + 1;
    }
    return dict;
}

# ---- CMUdict emit ------------------------------------------------------------
# `arp` (phoneme `ph`'s ARPABET symbol, which ends in a default digit for a vowel) with
# its digit set to the known stress `st` (SHBDK_STRESS_*), into `buf` (>= 8 bytes).
# Returns 1, or 0 when the stress cannot be written so that it reads back: a stressed
# schwa (AH1 is /ʌ/), an unstressed /ʌ/ (AH0 is schwa), or stress on a consonant. A
# phoneme whose stress is unknown is written as `arp` itself (1, schwa 0, as before 3.2.0).
fn _shbdk_arpabet_stressed(ph, arp, st, buf): i64 {
    if (shbdk_phoneme_takes_stress(ph) == 0) { return 0; }
    if (ph == SVARA_PH_VOWEL_SCHWA && st != SHBDK_STRESS_UNSTRESSED) { return 0; }
    if (ph == SVARA_PH_VOWEL_CUP_V && st == SHBDK_STRESS_UNSTRESSED) { return 0; }
    var n = strlen(arp);
    memcpy(buf, arp, n);
    store8(buf + n - 1, 48 + st);
    store8(buf + n, 0);
    return 1;
}

# Append one entry (all its pronunciations) to `sb` in CMUdict format. Returns 1,
# or 0 (with the reason recorded) if a pronunciation has no ARPABET symbol at all:
# its line would read back as "no phonemes", or if its stress cannot be written (see
# _shbdk_arpabet_stressed). A phoneme with no ARPABET symbol is otherwise left
# out, with its stress, ARPABET being an English phoneme set.
fn _shbdk_write_entry_cmudict(sb, word, entry): i64 {
    var prons = shbdk_dict_entry_all(entry);
    var n = vec_len(prons);
    var i = 0;
    var pron = 0;
    var hasf = 0;
    var hasr = 0;
    var fbuf = alloc(32);
    var phon = 0;
    var np = 0;
    var k = 0;
    var arp = 0;
    var emitted = 0;
    var symbuf = alloc(8);
    var stv = 0;
    var ph = 0;
    var st = 0;
    while (i < n) {
        pron = vec_get(prons, i);
        hasf = shbdk_pronunciation_has_frequency(pron);
        hasr = shbdk_pronunciation_has_region(pron);
        if (hasf == 1) {
            # 3.1.3: the shortest text that reads back as the same value (was a fixed
            # 6 decimals, so 1/3 came back as 0.333333 and 1e-9 as 0).
            str_builder_add_cstr(sb, ";;; @freq=");
            shbdk_frequency_text(shbdk_pronunciation_frequency(pron), fbuf);
            str_builder_add_cstr(sb, fbuf);
            if (hasr == 1) {
                str_builder_add_cstr(sb, " @region=");
                str_builder_add_cstr(sb, shbdk_region_code(shbdk_pronunciation_region(pron)));
            }
            str_builder_add_cstr(sb, "\n");
        } else {
            if (hasr == 1) {
                str_builder_add_cstr(sb, ";;; @region=");
                str_builder_add_cstr(sb, shbdk_region_code(shbdk_pronunciation_region(pron)));
                str_builder_add_cstr(sb, "\n");
            }
        }
        str_builder_add_cstr(sb, word);
        if (i > 0) {
            str_builder_add_cstr(sb, "(");
            str_builder_add_int(sb, i + 1);
            str_builder_add_cstr(sb, ")");
        }
        str_builder_add_cstr(sb, "  ");
        phon = shbdk_pronunciation_phonemes(pron);
        np = vec_len(phon);
        k = 0;
        emitted = 0;
        stv = shbdk_pronunciation_stress(pron);
        while (k < np) {
            ph = vec_get(phon, k);
            arp = shbdk_phoneme_to_arpabet(ph);
            st = SHBDK_STRESS_NONE;
            if (stv != 0) { st = vec_get(stv, k); }
            if (arp != 0 && st != SHBDK_STRESS_NONE) {
                if (_shbdk_arpabet_stressed(ph, arp, st, symbuf) == 0) {
                    return _shbdk_fail_line(0, "stress that ARPABET cannot write back in '", word, 0,
                      strlen(word), "'");
                }
                arp = symbuf;
            }
            if (arp != 0) {
                # separator only BETWEEN emitted symbols (Rust filter_map + join(" "))
                if (emitted > 0) { str_builder_add_cstr(sb, " "); }
                str_builder_add_cstr(sb, arp);
                emitted = emitted + 1;
            }
            k = k + 1;
        }
        if (emitted == 0) {
            return _shbdk_fail_line(0, "no ARPABET symbol for any phoneme of '", word, 0, strlen(word), "'");
        }
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    return 1;
}

# Write every entry of map `m` (sorted) whose key is not in `skip` (0 = none).
# Returns 1, or 0 with the reason recorded.
fn _shbdk_write_map_cmudict(sb, m, skip): i64 {
    var words = map_keys(m);
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    while (i < n) {
        wk = vec_get(words, i);
        if (skip == 0 || map_has(skip, wk) == 0) {
            if (_shbdk_cmudict_word_ok(wk) == 0) {
                return _shbdk_fail_line(0, "cannot write the word '", str_data(wk), 0, str_len(wk),
                  "' as CMUdict text");
            }
            if (_shbdk_write_entry_cmudict(sb, str_cstr(wk), map_get(m, wk)) == 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# Serialize base entries to CMUdict text (sorted). Returns a cstr, or 0 (with
# shbdk_last_error() set) if an entry cannot be written so that it reads back.
#must_use
fn shbdk_to_cmudict(dict): cstring {
    shbdk_clear_error();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ";;; Generated by shabdakosh\n");
    if (_shbdk_write_map_cmudict(sb, shbdk_dict_entries(dict), 0) == 0) { return 0; }
    return str_data(str_builder_build(sb));
}

# Serialize base + user overlay to CMUdict text (base words the overlay shadows
# are left out). Returns a cstr, or 0 as shbdk_to_cmudict does.
#must_use
fn shbdk_to_cmudict_with_user(dict): cstring {
    shbdk_clear_error();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ";;; Generated by shabdakosh\n");
    var user = shbdk_dict_user_entries(dict);
    if (_shbdk_write_map_cmudict(sb, shbdk_dict_entries(dict), user) == 0) { return 0; }
    if (_shbdk_write_map_cmudict(sb, user, 0) == 0) { return 0; }
    return str_data(str_builder_build(sb));
}

# ---- IPA parse / emit --------------------------------------------------------
# Parse an IPA dictionary (`word /IPA/` or `word IPA` per line; `#` comments), or
# 0 on error with the reason in shbdk_last_error(): a line with no transcription,
# an empty word, a transcription with no phonemes, or input that is not UTF-8.
#must_use
fn shbdk_parse_ipa(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var len = strlen(input);
    if (shbdk_utf8_valid(input, len) == 0) { return _shbdk_fail("input is not valid UTF-8"); }
    var dict = shbdk_dict_new();
    var pos = 0;
    var line = 0;
    var le = 0;
    var s = 0;
    var e = 0;
    var slash = 0;
    var wend = 0;
    var istart = 0;
    var iend = 0;
    var phon = 0;
    while (pos < len) {
        le = _shbdk_fmt_line_end(input, pos, len);
        line = line + 1;
        s = _shbdk_fmt_skip_ws(input, pos, le);
        e = _shbdk_fmt_trim_end(input, s, le);
        if (s >= e) { pos = le + 1; continue; }
        if (load8(input + s) == 35) { pos = le + 1; continue; }   # '#' comment

        # find a '/' -> "word /IPA/"
        slash = s;
        while (slash < e) {
            if (load8(input + slash) == 47) { break; }
            slash = slash + 1;
        }
        if (slash < e) {
            wend = _shbdk_fmt_trim_end(input, s, slash);
            istart = slash + 1;
            iend = e;
            while (iend > istart && load8(input + iend - 1) == 47) { iend = iend - 1; }   # trim_end_matches('/')
            istart = _shbdk_fmt_skip_ws(input, istart, iend);
            iend = _shbdk_fmt_trim_end(input, istart, iend);
        } else {
            # "word IPA" — split on the first whitespace
            wend = _shbdk_fmt_find_ws(input, s, e);
            if (wend >= e) { return _shbdk_fail_line(line, "missing IPA transcription", 0, 0, 0, 0); }
            istart = _shbdk_fmt_skip_ws(input, wend, e);
            iend = e;
        }
        # 3.1.3: "/kæt/" with no word stored the key "" (the Rust too).
        if (wend <= s) { return _shbdk_fail_line(line, "empty word", 0, 0, 0, 0); }
        phon = shbdk_parse_ipa_word(_shbdk_fmt_dup(input, istart, iend));
        if (vec_len(phon) == 0) {
            return _shbdk_fail_line(line, "no phonemes parsed from IPA '", input, istart, iend, "'");
        }
        shbdk_dict_insert(dict, _shbdk_fmt_dup(input, s, wend), phon);
        pos = le + 1;
    }
    return dict;
}

# 1 if Str key `k` can be written as an IPA-format word that reads back as itself:
# non-empty well-formed UTF-8 with no NUL, CR, LF or '/', no leading / trailing
# whitespace, and not starting with '#'.
fn _shbdk_ipa_word_ok(k): i64 {
    var p = str_data(k);
    var n = str_len(k);
    if (n == 0) { return 0; }
    if (load8(p) == 35) { return 0; }
    var i = 0;
    var c = 0;
    var wide = 0;
    while (i < n) {
        c = load8(p + i);
        if (c == 0 || c == 10 || c == 13 || c == 47) { return 0; }
        if (c >= 128) { wide = 1; }
        i = i + 1;
    }
    if (wide == 1 && shbdk_utf8_valid(p, n) == 0) { return 0; }
    if (shbdk_ws_len(p, 0, n) > 0) { return 0; }
    if (shbdk_ws_len_before(p, 0, n) > 0) { return 0; }
    return 1;
}

# Serialize to IPA format (`word /IPA/`, sorted, primary only). Returns a cstr, or
# 0 (with shbdk_last_error() set) if a word cannot be written or its primary
# pronunciation has no IPA (only silence), since that line would not read back.
#must_use
fn shbdk_to_ipa(dict): cstring {
    shbdk_clear_error();
    var sb = str_builder_new();
    var words = map_keys(shbdk_dict_entries(dict));
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    var entry = 0;
    var ipa = 0;
    while (i < n) {
        wk = vec_get(words, i);
        if (_shbdk_ipa_word_ok(wk) == 0) {
            return _shbdk_fail_line(0, "cannot write the word '", str_data(wk), 0, str_len(wk), "' as IPA text");
        }
        entry = map_get(shbdk_dict_entries(dict), wk);
        ipa = shbdk_phonemes_to_ipa(shbdk_dict_entry_primary_phonemes(entry));
        if (load8(ipa) == 0) {
            return _shbdk_fail_line(0, "no IPA for the pronunciation of '", str_data(wk), 0, str_len(wk), "'");
        }
        str_builder_add_cstr(sb, str_cstr(wk));
        str_builder_add_cstr(sb, " /");
        str_builder_add_cstr(sb, ipa);
        str_builder_add_cstr(sb, "/\n");
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# ---- file I/O ----------------------------------------------------------------
# Load + parse a CMUdict file, or 0 on read / parse error (shbdk_last_error() says which).
#must_use
fn shbdk_load_cmudict_file(path): i64 {
    # 3.1.3: no 8 MB ceiling (it refused files the saver wrote); sized to the file.
    shbdk_clear_error();
    var data = _shbdk_read_file_str(path);
    if (data == 0) { return 0; }
    return shbdk_parse_cmudict(str_data(data));
}

# Save a dict to a CMUdict file. Returns 0 on success, negative on a write error
# or a dictionary CMUdict text cannot hold (shbdk_last_error() says which).
fn shbdk_save_cmudict_file(dict, path): i64 {
    var data = shbdk_to_cmudict(dict);
    if (data == 0) { return (0 - 1); }
    var n = file_write_all(path, data, strlen(data));
    if (n < 0) { _shbdk_fail_line(0, "failed to write file: ", path, 0, strlen(path), 0); return (0 - 1); }
    return 0;
}

# --- json.cyr ---

# json.cyr — PronunciationDict JSON codec (the hand-written serde replacement).
#
# Ports from_json/to_json of 3.1.3:rust-old/src/dictionary/format/mod.rs. Per the locked
# serde stance this is PERMANENT format-layer code (not a throwaway #derive stub);
# it uses bayan's typed json_v_* DOM for BOTH directions. Included after
# src/dictionary/mod.cyr (+ bayan stdlib).
#
# bayan cstr/Str contract: json_v_obj_set KEYS and json_v_str_new VALUES are Str
# (fat pointers) — wrap cstr literals with str_from().
# bayan_json_v_obj_get_by_cstr takes a cstr key. json_v_str / json_v_obj_key
# RETURN Str — str_cstr() them for the dict API (which wants NUL-terminated cstrs).
#
# 3.0.0 JSON schema (Cyrius-native — phonemes are integer ordinals):
#   {"language":"en",
#    "entries":{"cat":{"pronunciations":[{"phonemes":[24,7,22],"frequency":0.5,"region":"GA",
#                                         "stress":[-1,1,-1]}]}},
# "stress" (3.2.0) is optional: one SHBDK_STRESS_* per phoneme, written when known.
#    "user_entries":{ ... }}
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- to_json (build via the DOM) ---------------------------------------------
fn _shbdk_pron_to_jsonv(pron): i64 {
    var obj = json_v_obj_new();
    var arr = json_v_arr_new();
    var phon = shbdk_pronunciation_phonemes(pron);
    var n = vec_len(phon);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, json_v_int_new(vec_get(phon, i)));
        i = i + 1;
    }
    json_v_obj_set(obj, str_from("phonemes"), arr);
    if (shbdk_pronunciation_has_frequency(pron) == 1) {
        json_v_obj_set(obj, str_from("frequency"), json_v_float_new(shbdk_pronunciation_frequency(pron)));
    }
    if (shbdk_pronunciation_has_region(pron) == 1) {
        var rc = shbdk_region_code(shbdk_pronunciation_region(pron));
        json_v_obj_set(obj, str_from("region"), json_v_str_new(str_from(rc)));
    }
    if (shbdk_pronunciation_has_stress(pron) == 1) {
        var sarr = json_v_arr_new();
        var st = shbdk_pronunciation_stress(pron);
        var k = 0;
        while (k < vec_len(st)) {
            json_v_arr_push(sarr, json_v_int_new(vec_get(st, k)));
            k = k + 1;
        }
        json_v_obj_set(obj, str_from("stress"), sarr);
    }
    return obj;
}

fn _shbdk_entry_to_jsonv(entry): i64 {
    var obj = json_v_obj_new();
    var arr = json_v_arr_new();
    var prons = shbdk_dict_entry_all(entry);
    var n = vec_len(prons);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, _shbdk_pron_to_jsonv(vec_get(prons, i)));
        i = i + 1;
    }
    json_v_obj_set(obj, str_from("pronunciations"), arr);
    return obj;
}

# Keys go out sorted: user_entries is a BTreeMap in Rust. Rust leaves entries (a HashMap)
# unspecified, and sorting it too makes the export byte-reproducible despite the per-process
# hash seed.
fn _shbdk_map_to_jsonv(m): i64 {
    var obj = json_v_obj_new();
    var keys = map_keys(m);
    _shbdk_sort_strs(keys);
    var n = vec_len(keys);
    var i = 0;
    var wk = 0;
    while (i < n) {
        wk = vec_get(keys, i);
        # wk is already a Str (map key) — pass it directly as the object key.
        json_v_obj_set(obj, wk, _shbdk_entry_to_jsonv(map_get(m, wk)));
        i = i + 1;
    }
    return obj;
}

# Serialize a PronunciationDict to a JSON cstr.
#must_use
fn shbdk_to_json(dict): cstring {
    var root = json_v_obj_new();
    var lang = shbdk_dict_language(dict);
    if (lang != 0) {
        json_v_obj_set(root, str_from("language"), json_v_str_new(str_from(lang)));
    }
    json_v_obj_set(root, str_from("entries"), _shbdk_map_to_jsonv(shbdk_dict_entries(dict)));
    json_v_obj_set(root, str_from("user_entries"), _shbdk_map_to_jsonv(shbdk_dict_user_entries(dict)));
    return str_data(json_v_build(root));
}

# ---- from_json (parse via the DOM) -------------------------------------------
# 3.1.3: the reader checks the document against the schema instead of defaulting
# whatever it did not recognise. It used to load `{}`, `"entries":5`, a missing
# or non-array `phonemes`, a phoneme of 9999 or "Bogus" (read as 0, VowelA), a
# `"frequency":"0.5"` (read as 0.0), a region "XX" (dropped), and an entry with no
# pronunciations (dropped) — 16 of 40 malformed documents in the 3.1.3 sweep. Each
# is now an error with a reason. Unknown fields are still ignored, as serde does.
#
# It also reads the v0.1 shape the Rust accepted (EntryCompat::Old), where an
# entry is just its phoneme array: {"entries":{"cat":[24,7,22]}}.

# Read a JSON phoneme array into a fresh vec, or 0 (reason recorded) if `arr` is
# not an array of integers 0..100.
fn _shbdk_phonemes_from_jsonv(arr, word): i64 {
    if (arr == 0 || json_v_is_arr(arr) == 0) { return _shbdk_json_bad(word, "\"phonemes\" must be an array"); }
    var phon = vec_new();
    var n = json_v_arr_len(arr);
    var i = 0;
    var el = 0;
    var ph = 0;
    while (i < n) {
        el = json_v_arr_get(arr, i);
        if (json_v_is_int(el) == 0) { return _shbdk_json_bad(word, "a phoneme must be an integer"); }
        ph = json_v_int(el);
        if (ph < 0 || ph > 100) { return _shbdk_json_bad(word, "a phoneme is not a svara phoneme (0-100)"); }
        vec_push(phon, ph);
        i = i + 1;
    }
    return phon;
}

# Record "JSON parse error: entry '<word>': <msg>" (or without the entry when
# word is 0) and return 0.
fn _shbdk_json_bad(word, msg): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "JSON parse error: ");
    if (word != 0) {
        str_builder_add_cstr(sb, "entry '");
        str_builder_add_cstr(sb, word);
        str_builder_add_cstr(sb, "': ");
    }
    str_builder_add_cstr(sb, msg);
    return _shbdk_fail(str_data(str_builder_build(sb)));
}

fn _shbdk_pron_from_jsonv(pobj, word): i64 {
    if (json_v_is_obj(pobj) == 0) { return _shbdk_json_bad(word, "a pronunciation must be an object"); }
    var phon = _shbdk_phonemes_from_jsonv(bayan_json_v_obj_get_by_cstr(pobj, "phonemes"), word);
    if (phon == 0) { return 0; }
    var pron = shbdk_pronunciation_new(phon);
    var fq = bayan_json_v_obj_get_by_cstr(pobj, "frequency");
    if (fq != 0 && json_v_is_null(fq) == 0) {
        if (json_v_is_int(fq) == 0 && json_v_is_float(fq) == 0) {
            return _shbdk_json_bad(word, "\"frequency\" must be a number");
        }
        if (shbdk_frequency_is_valid(json_v_float(fq)) == 0) {
            return _shbdk_json_bad(word, "\"frequency\" is outside 0.0-1.0");
        }
        pron = shbdk_pronunciation_with_frequency(pron, json_v_float(fq));
    }
    var rg = bayan_json_v_obj_get_by_cstr(pobj, "region");
    if (rg != 0 && json_v_is_null(rg) == 0) {
        # SECURITY: require a STRING — json_v_str on a wrong-typed node returns a 0
        # Str, and str_cstr(0) would deref null (audit 2026-07-05).
        if (json_v_is_str(rg) == 0) { return _shbdk_json_bad(word, "\"region\" must be a string"); }
        var region = shbdk_region_from_code(str_cstr(json_v_str(rg)));
        if (region == SHBDK_REGION_NONE) { return _shbdk_json_bad(word, "unknown region code"); }
        pron = shbdk_pronunciation_with_region(pron, region);
    }
    var sv = bayan_json_v_obj_get_by_cstr(pobj, "stress");
    if (sv != 0 && json_v_is_null(sv) == 0) {
        if (json_v_is_arr(sv) == 0) { return _shbdk_json_bad(word, "\"stress\" must be an array"); }
        var stress = vec_new();
        var sn = json_v_arr_len(sv);
        var si = 0;
        while (si < sn) {
            var se = json_v_arr_get(sv, si);
            if (json_v_is_int(se) == 0) { return _shbdk_json_bad(word, "a stress value must be an integer"); }
            vec_push(stress, json_v_int(se));
            si = si + 1;
        }
        if (shbdk_stress_is_valid(stress, vec_len(phon)) == 0) {
            return _shbdk_json_bad(word, "\"stress\" must hold one value from -1 to 2 per phoneme");
        }
        pron = shbdk_pronunciation_with_stress(pron, stress);
    }
    return pron;
}

fn _shbdk_entry_from_jsonv(ev, word): i64 {
    # v0.1 shape: the entry is its phoneme array (Rust EntryCompat::Old)
    if (json_v_is_arr(ev) == 1) {
        var old = _shbdk_phonemes_from_jsonv(ev, word);
        if (old == 0) { return 0; }
        return shbdk_dict_entry_new(shbdk_pronunciation_new(old));
    }
    if (json_v_is_obj(ev) == 0) { return _shbdk_json_bad(word, "an entry must be an object or a phoneme array"); }
    var parr = bayan_json_v_obj_get_by_cstr(ev, "pronunciations");
    if (parr == 0 || json_v_is_arr(parr) == 0) { return _shbdk_json_bad(word, "\"pronunciations\" must be an array"); }
    var n = json_v_arr_len(parr);
    if (n == 0) { return _shbdk_json_bad(word, "an entry needs at least one pronunciation"); }
    var prons = vec_new();
    var i = 0;
    var pron = 0;
    while (i < n) {
        pron = _shbdk_pron_from_jsonv(json_v_arr_get(parr, i), word);
        if (pron == 0) { return 0; }
        vec_push(prons, pron);
        i = i + 1;
    }
    return shbdk_dict_entry_from_pronunciations(prons);
}

# Parse the word -> entry object `obj` into the base (is_user 0) or the overlay.
# Returns 1, or 0 with the reason recorded.
fn _shbdk_parse_entries_into(dict, obj, is_user, field): i64 {
    if (json_v_is_obj(obj) == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, field);
        str_builder_add_cstr(sb, "\" must be an object");
        return _shbdk_json_bad(0, str_data(str_builder_build(sb)));
    }
    var n = json_v_obj_len(obj);
    var i = 0;
    var entry = 0;
    var word = 0;
    while (i < n) {
        word = str_cstr(json_v_obj_key(obj, i));
        if (load8(word) == 0) { return _shbdk_json_bad(0, "an entry has an empty word"); }
        entry = _shbdk_entry_from_jsonv(json_v_obj_val(obj, i), word);
        if (entry == 0) { return 0; }
        if (is_user == 1) {
            shbdk_dict_insert_user_entry(dict, word, entry);
        } else {
            shbdk_dict_insert_entry(dict, word, entry);
        }
        i = i + 1;
    }
    return 1;
}

# Parse a JSON string into a PronunciationDict, or 0 on error with the reason in
# shbdk_last_error(). "entries" is required; "user_entries" and "language" are
# optional (a null language is no language), as in the Rust's schema.
#must_use
fn shbdk_from_json(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    if (json_v_is_obj(root) == 0) { return _shbdk_json_bad(0, "the document must be an object"); }
    var dict = shbdk_dict_new();
    var lang = bayan_json_v_obj_get_by_cstr(root, "language");
    if (lang != 0 && json_v_is_null(lang) == 0) {
        # SECURITY: require a STRING — a wrong-typed language (e.g. {"language":42})
        # makes json_v_str return a 0 Str, and str_cstr(0) would deref null.
        if (json_v_is_str(lang) == 0) { return _shbdk_json_bad(0, "\"language\" must be a string"); }
        shbdk_dict_set_language(dict, str_cstr(json_v_str(lang)));
    }
    var entries = bayan_json_v_obj_get_by_cstr(root, "entries");
    if (entries == 0) { return _shbdk_json_bad(0, "missing field \"entries\""); }
    if (_shbdk_parse_entries_into(dict, entries, 0, "entries") == 0) { return 0; }
    var user = bayan_json_v_obj_get_by_cstr(root, "user_entries");
    if (user != 0) {
        if (_shbdk_parse_entries_into(dict, user, 1, "user_entries") == 0) { return 0; }
    }
    return dict;
}

# --- records.cyr ---

# records.cyr — JSON codecs and equality for every record type the Rust derived
# Serialize / Deserialize / PartialEq on, beyond PronunciationDict itself.
#
# 3.1.3: the Rust's serde derives made each of these types serializable on its own,
# and CLAUDE.md's invariant is "every type Serialize+Deserialize with roundtrip
# tests", but through 3.1.2 the port serialized only the dictionary (json.cyr), the
# two validation reports (validate.cyr) and nothing else. This module closes it:
# Region, Pronunciation, DictEntry, DictDiff, MorphemeKind / Morpheme /
# Decomposition, StressLevel / Syllable, CoverageReport, PrefixTrie,
# HeteronymContext, G2PResult, LookupSource, FstNotation / FstModel and the error.
#
# The shapes are serde's: a struct is an object of its fields, a unit enum is its
# variant name ("Prefix", "Primary", "UserOverlay", "Arpabet"), and LookupSource's
# data-carrying variant is {"G2PModel":{"confidence":0.8}}. As in json.cyr, a
# phoneme is its svara ordinal and a region its code ("GA" / "RP"). PrefixTrie is
# carried as its sorted word list ({"words":[...]}), from which it rebuilds — the
# same trie, without the node layout. Each from_json returns 0 (or the stated
# failure value) with the reason in shbdk_last_error().
#
# Included after format/json.cyr (its pronunciation / entry codecs) and every
# module whose type it serializes (entry, morphology, syllable, mod, coverage,
# trie, heteronym, g2p).
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- shared helpers ----------------------------------------------------------
fn _shbdk_rec_parse(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    return root;
}

fn _shbdk_rec_bad(msg): i64 {
    return _shbdk_json_bad(0, msg);
}

fn _shbdk_rec_build(v): cstring {
    return str_data(json_v_build(v));
}

# JSON array of the ints in vec `v`.
fn _shbdk_rec_int_arr(v): i64 {
    var arr = json_v_arr_new();
    var i = 0;
    while (i < vec_len(v)) {
        json_v_arr_push(arr, json_v_int_new(vec_get(v, i)));
        i = i + 1;
    }
    return arr;
}

# JSON array of the strings in vec `v` (Str elements when is_str, else cstr).
fn _shbdk_rec_str_arr(v, is_str): i64 {
    var arr = json_v_arr_new();
    var i = 0;
    var e = 0;
    while (i < vec_len(v)) {
        e = vec_get(v, i);
        if (is_str == 1) { json_v_arr_push(arr, json_v_str_new(e)); } else { json_v_arr_push(arr,
              json_v_str_new(str_from(e))); }
        i = i + 1;
    }
    return arr;
}

# The string array field `key` of `obj` as a vec (of Str when as_str, else cstr),
# or 0 with the reason recorded.
fn _shbdk_rec_get_strs(obj, key, as_str): i64 {
    var arr = bayan_json_v_obj_get_by_cstr(obj, key);
    if (arr == 0 || json_v_is_arr(arr) == 0) { return _shbdk_rec_field_bad(key, "an array of strings"); }
    var out = vec_new();
    var i = 0;
    var el = 0;
    while (i < json_v_arr_len(arr)) {
        el = json_v_arr_get(arr, i);
        if (json_v_is_str(el) == 0) { return _shbdk_rec_field_bad(key, "an array of strings"); }
        if (as_str == 1) { vec_push(out, str_from(str_cstr(json_v_str(el)))); } else { vec_push(out,
              str_cstr(json_v_str(el))); }
        i = i + 1;
    }
    return out;
}

# The integer field `key` of `obj` into store64(out). 1, or 0 with the reason recorded.
fn _shbdk_rec_get_int(obj, key, out): i64 {
    var v = bayan_json_v_obj_get_by_cstr(obj, key);
    if (v == 0 || json_v_is_int(v) == 0) { return _shbdk_rec_field_bad(key, "an integer"); }
    store64(out, json_v_int(v));
    return 1;
}

# The number field `key` of `obj` (f64 bits) into store64(out). 1, or 0.
fn _shbdk_rec_get_num(obj, key, out): i64 {
    var v = bayan_json_v_obj_get_by_cstr(obj, key);
    if (v == 0 || (json_v_is_int(v) == 0 && json_v_is_float(v) == 0)) { return _shbdk_rec_field_bad(key, "a number"); }
    store64(out, json_v_float(v));
    return 1;
}

# The string field `key` of `obj` as a cstr, or 0 with the reason recorded.
fn _shbdk_rec_get_str(obj, key): cstring {
    var v = bayan_json_v_obj_get_by_cstr(obj, key);
    if (v == 0 || json_v_is_str(v) == 0) { return _shbdk_rec_field_bad(key, "a string"); }
    return str_cstr(json_v_str(v));
}

fn _shbdk_rec_field_bad(key, what): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\" must be ");
    str_builder_add_cstr(sb, what);
    return _shbdk_rec_bad(str_data(str_builder_build(sb)));
}

# 1 if two int vecs hold the same values in order.
fn _shbdk_rec_ivec_eq(a, b): i64 {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if two string vecs (Str elements when is_str, else cstr) hold the same strings in order.
fn _shbdk_rec_svec_eq(a, b, is_str): i64 {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (is_str == 1) {
            if (str_eq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        } else {
            if (streq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# 1 if two f64 bit patterns are the same number (as _shbdk_freq_eq).
fn _shbdk_rec_num_eq(a, b): i64 {
    return _shbdk_freq_eq(a, b);
}

# ---- Region ------------------------------------------------------------------
# Region -> JSON text ("\"GA\"" / "\"RP\""), or 0 for no region.
#must_use
fn shbdk_region_to_json(region): cstring {
    var code = shbdk_region_code(region);
    if (code == 0) { return 0; }
    return _shbdk_rec_build(json_v_str_new(str_from(code)));
}

# JSON text -> SHBDK_REGION_*, or SHBDK_REGION_NONE (reason recorded) if it is not one.
#must_use
fn shbdk_region_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return SHBDK_REGION_NONE; }
    if (json_v_is_str(root) == 0) { _shbdk_rec_bad("a region must be a string"); return SHBDK_REGION_NONE; }
    var r = shbdk_region_from_code(str_cstr(json_v_str(root)));
    if (r == SHBDK_REGION_NONE) { _shbdk_rec_bad("unknown region code"); }
    return r;
}

# ---- Pronunciation / DictEntry -----------------------------------------------
# The same objects json.cyr writes inside a dictionary.
#must_use
fn shbdk_pronunciation_to_json(p): cstring { return _shbdk_rec_build(_shbdk_pron_to_jsonv(p)); }
# JSON text -> a pronunciation, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_pronunciation_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    return _shbdk_pron_from_jsonv(root, 0);
}
# A DictEntry -> JSON text {"pronunciations":[...]}.
#must_use
fn shbdk_dict_entry_to_json(e): cstring { return _shbdk_rec_build(_shbdk_entry_to_jsonv(e)); }
# JSON text -> a DictEntry (also the v0.1 phoneme-array shape), or 0.
#must_use
fn shbdk_dict_entry_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    return _shbdk_entry_from_jsonv(root, 0);
}

# ---- DictDiff ----------------------------------------------------------------
# {"added":[..],"removed":[..],"changed":[..]}
#must_use
fn shbdk_dict_diff_to_json(dd): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("added"), _shbdk_rec_str_arr(shbdk_dict_diff_added(dd), 1));
    json_v_obj_set(o, str_from("removed"), _shbdk_rec_str_arr(shbdk_dict_diff_removed(dd), 1));
    json_v_obj_set(o, str_from("changed"), _shbdk_rec_str_arr(shbdk_dict_diff_changed(dd), 1));
    return _shbdk_rec_build(o);
}
# JSON text -> a DictDiff, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_dict_diff_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a DictDiff must be an object"); }
    var a = _shbdk_rec_get_strs(root, "added", 1);
    if (a == 0) { return 0; }
    var r = _shbdk_rec_get_strs(root, "removed", 1);
    if (r == 0) { return 0; }
    var c = _shbdk_rec_get_strs(root, "changed", 1);
    if (c == 0) { return 0; }
    var dd = alloc(24);
    store64(dd + 0, a);
    store64(dd + 8, r);
    store64(dd + 16, c);
    return dd;
}
# 1 if two diffs list the same added, removed and changed words in order.
#must_use
fn shbdk_dict_diff_eq(a, b): i64 {
    if (_shbdk_rec_svec_eq(shbdk_dict_diff_added(a), shbdk_dict_diff_added(b), 1) == 0) { return 0; }
    if (_shbdk_rec_svec_eq(shbdk_dict_diff_removed(a), shbdk_dict_diff_removed(b), 1) == 0) { return 0; }
    return _shbdk_rec_svec_eq(shbdk_dict_diff_changed(a), shbdk_dict_diff_changed(b), 1);
}

# ---- MorphemeKind / Morpheme / Decomposition ---------------------------------
#must_use
fn shbdk_morpheme_kind_name(kind): cstring {
    if (kind == SHBDK_MORPH_PREFIX) { return "Prefix"; }
    if (kind == SHBDK_MORPH_ROOT) { return "Root"; }
    if (kind == SHBDK_MORPH_SUFFIX) { return "Suffix"; }
    if (kind == SHBDK_MORPH_INFIX) { return "Infix"; }
    return 0;
}
# A MorphemeKind name -> SHBDK_MORPH_*, or -1.
#must_use
fn shbdk_morpheme_kind_from_name(name): i64 {
    if (name == 0) { return 0 - 1; }
    if (streq(name, "Prefix") == 1) { return SHBDK_MORPH_PREFIX; }
    if (streq(name, "Root") == 1) { return SHBDK_MORPH_ROOT; }
    if (streq(name, "Suffix") == 1) { return SHBDK_MORPH_SUFFIX; }
    if (streq(name, "Infix") == 1) { return SHBDK_MORPH_INFIX; }
    return 0 - 1;
}
fn _shbdk_morpheme_to_jsonv(m): i64 {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("text"), json_v_str_new(str_from(shbdk_morpheme_text(m))));
    json_v_obj_set(o, str_from("kind"), json_v_str_new(str_from(shbdk_morpheme_kind_name(shbdk_morpheme_kind(m)))));
    json_v_obj_set(o, str_from("phonemes"), _shbdk_rec_int_arr(shbdk_morpheme_phonemes(m)));
    return o;
}
fn _shbdk_morpheme_from_jsonv(o): i64 {
    if (json_v_is_obj(o) == 0) { return _shbdk_rec_bad("a Morpheme must be an object"); }
    var text = _shbdk_rec_get_str(o, "text");
    if (text == 0) { return 0; }
    var kind = shbdk_morpheme_kind_from_name(_shbdk_rec_get_str(o, "kind"));
    if (kind < 0) { return _shbdk_rec_bad("\"kind\" must be Prefix, Root, Suffix or Infix"); }
    var phon = _shbdk_phonemes_from_jsonv(bayan_json_v_obj_get_by_cstr(o, "phonemes"), 0);
    if (phon == 0) { return 0; }
    return shbdk_morpheme_new(text, kind, phon);
}
# A Morpheme -> JSON text {"text":..,"kind":"Prefix","phonemes":[..]}.
#must_use
fn shbdk_morpheme_to_json(m): cstring { return _shbdk_rec_build(_shbdk_morpheme_to_jsonv(m)); }
# JSON text -> a Morpheme, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_morpheme_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    return _shbdk_morpheme_from_jsonv(root);
}
# 1 if two morphemes have the same text, kind and phonemes.
#must_use
fn shbdk_morpheme_eq(a, b): i64 {
    if (streq(shbdk_morpheme_text(a), shbdk_morpheme_text(b)) == 0) { return 0; }
    if (shbdk_morpheme_kind(a) != shbdk_morpheme_kind(b)) { return 0; }
    return _shbdk_rec_ivec_eq(shbdk_morpheme_phonemes(a), shbdk_morpheme_phonemes(b));
}
# {"morphemes":[...]}
#must_use
fn shbdk_decomposition_to_json(d): cstring {
    var o = json_v_obj_new();
    var arr = json_v_arr_new();
    var ms = shbdk_decomposition_morphemes(d);
    var i = 0;
    while (i < vec_len(ms)) { json_v_arr_push(arr, _shbdk_morpheme_to_jsonv(vec_get(ms, i))); i = i + 1; }
    json_v_obj_set(o, str_from("morphemes"), arr);
    return _shbdk_rec_build(o);
}
# JSON text -> a Decomposition, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_decomposition_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a Decomposition must be an object"); }
    var arr = bayan_json_v_obj_get_by_cstr(root, "morphemes");
    if (arr == 0 || json_v_is_arr(arr) == 0) { return _shbdk_rec_field_bad("morphemes", "an array"); }
    var ms = vec_new();
    var i = 0;
    var m = 0;
    while (i < json_v_arr_len(arr)) {
        m = _shbdk_morpheme_from_jsonv(json_v_arr_get(arr, i));
        if (m == 0) { return 0; }
        vec_push(ms, m);
        i = i + 1;
    }
    return shbdk_decomposition_new(ms);
}
# 1 if two decompositions hold equal morphemes in order.
#must_use
fn shbdk_decomposition_eq(a, b): i64 {
    var ma = shbdk_decomposition_morphemes(a);
    var mb = shbdk_decomposition_morphemes(b);
    if (vec_len(ma) != vec_len(mb)) { return 0; }
    var i = 0;
    while (i < vec_len(ma)) {
        if (shbdk_morpheme_eq(vec_get(ma, i), vec_get(mb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ---- StressLevel / Syllable --------------------------------------------------
#must_use
fn shbdk_stress_name(stress): cstring {
    if (stress == SHBDK_STRESS_UNSTRESSED) { return "Unstressed"; }
    if (stress == SHBDK_STRESS_PRIMARY) { return "Primary"; }
    if (stress == SHBDK_STRESS_SECONDARY) { return "Secondary"; }
    return 0;
}
# A StressLevel name -> SHBDK_STRESS_*, or -1.
#must_use
fn shbdk_stress_from_name(name): i64 {
    if (name == 0) { return 0 - 1; }
    if (streq(name, "Unstressed") == 1) { return SHBDK_STRESS_UNSTRESSED; }
    if (streq(name, "Primary") == 1) { return SHBDK_STRESS_PRIMARY; }
    if (streq(name, "Secondary") == 1) { return SHBDK_STRESS_SECONDARY; }
    return 0 - 1;
}
# {"phonemes":[..],"stress":"Primary"}
#must_use
fn shbdk_syllable_to_json(s): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("phonemes"), _shbdk_rec_int_arr(shbdk_syllable_phonemes(s)));
    json_v_obj_set(o, str_from("stress"), json_v_str_new(str_from(shbdk_stress_name(shbdk_syllable_stress(s)))));
    return _shbdk_rec_build(o);
}
# JSON text -> a Syllable, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_syllable_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a Syllable must be an object"); }
    var phon = _shbdk_phonemes_from_jsonv(bayan_json_v_obj_get_by_cstr(root, "phonemes"), 0);
    if (phon == 0) { return 0; }
    var st = shbdk_stress_from_name(_shbdk_rec_get_str(root, "stress"));
    if (st < 0) { return _shbdk_rec_bad("\"stress\" must be Unstressed, Primary or Secondary"); }
    return shbdk_syllable_with_stress(shbdk_syllable_new(phon), st);
}
# 1 if two syllables have the same phonemes and stress.
#must_use
fn shbdk_syllable_eq(a, b): i64 {
    if (shbdk_syllable_stress(a) != shbdk_syllable_stress(b)) { return 0; }
    return _shbdk_rec_ivec_eq(shbdk_syllable_phonemes(a), shbdk_syllable_phonemes(b));
}

# ---- CoverageReport ----------------------------------------------------------
# {"total_tokens":N,"covered_tokens":N,"uncovered_words":[..]} (the wasm shape)
#must_use
fn shbdk_coverage_report_to_json(r): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("total_tokens"), json_v_int_new(shbdk_coverage_total_tokens(r)));
    json_v_obj_set(o, str_from("covered_tokens"), json_v_int_new(shbdk_coverage_covered_tokens(r)));
    json_v_obj_set(o, str_from("uncovered_words"), _shbdk_rec_str_arr(shbdk_coverage_uncovered_words(r), 1));
    return _shbdk_rec_build(o);
}
# JSON text -> a CoverageReport, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_coverage_report_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a CoverageReport must be an object"); }
    var cell = alloc(8);
    if (_shbdk_rec_get_int(root, "total_tokens", cell) == 0) { return 0; }
    var total = load64(cell);
    if (_shbdk_rec_get_int(root, "covered_tokens", cell) == 0) { return 0; }
    var covered = load64(cell);
    if (total < 0 || covered < 0 || covered > total) { return _shbdk_rec_bad("token counts are inconsistent"); }
    var unc = _shbdk_rec_get_strs(root, "uncovered_words", 1);
    if (unc == 0) { return 0; }
    return shbdk_coverage_report_new(total, covered, unc);
}
# 1 if two reports have the same counts and uncovered words.
#must_use
fn shbdk_coverage_report_eq(a, b): i64 {
    if (shbdk_coverage_total_tokens(a) != shbdk_coverage_total_tokens(b)) { return 0; }
    if (shbdk_coverage_covered_tokens(a) != shbdk_coverage_covered_tokens(b)) { return 0; }
    return _shbdk_rec_svec_eq(shbdk_coverage_uncovered_words(a), shbdk_coverage_uncovered_words(b), 1);
}

# ---- PrefixTrie --------------------------------------------------------------
# {"words":[...]} — every word, sorted; from_json rebuilds the trie.
#must_use
fn shbdk_trie_to_json(t): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("words"), _shbdk_rec_str_arr(shbdk_trie_search_prefix(t, ""), 1));
    return _shbdk_rec_build(o);
}
# JSON text {"words":[..]} -> a PrefixTrie of those words, or 0.
#must_use
fn shbdk_trie_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a PrefixTrie must be an object"); }
    var words = _shbdk_rec_get_strs(root, "words", 0);
    if (words == 0) { return 0; }
    var t = shbdk_trie_new();
    var i = 0;
    while (i < vec_len(words)) { shbdk_trie_insert(t, vec_get(words, i)); i = i + 1; }
    return t;
}
# 1 if two tries hold the same words.
#must_use
fn shbdk_trie_eq(a, b): i64 {
    if (shbdk_trie_len(a) != shbdk_trie_len(b)) { return 0; }
    return _shbdk_rec_svec_eq(shbdk_trie_search_prefix(a, ""), shbdk_trie_search_prefix(b, ""), 1);
}

# ---- HeteronymContext --------------------------------------------------------
# {"words":[..],"position":N}
#must_use
fn shbdk_heteronym_context_to_json(c): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("words"), _shbdk_rec_str_arr(shbdk_heteronym_context_words(c), 0));
    json_v_obj_set(o, str_from("position"), json_v_int_new(shbdk_heteronym_context_position(c)));
    return _shbdk_rec_build(o);
}
# JSON text -> a HeteronymContext, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_heteronym_context_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a HeteronymContext must be an object"); }
    var words = _shbdk_rec_get_strs(root, "words", 0);
    if (words == 0) { return 0; }
    var cell = alloc(8);
    if (_shbdk_rec_get_int(root, "position", cell) == 0) { return 0; }
    if (load64(cell) < 0) { return _shbdk_rec_bad("\"position\" must not be negative"); }
    return shbdk_heteronym_context_new(words, load64(cell));
}
# 1 if two contexts have the same words and position.
#must_use
fn shbdk_heteronym_context_eq(a, b): i64 {
    if (shbdk_heteronym_context_position(a) != shbdk_heteronym_context_position(b)) { return 0; }
    return _shbdk_rec_svec_eq(shbdk_heteronym_context_words(a), shbdk_heteronym_context_words(b), 0);
}

# ---- G2PResult / LookupSource / FstNotation / FstModel -----------------------
# {"phonemes":[..],"confidence":0.75}
#must_use
fn shbdk_g2p_result_to_json(r): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("phonemes"), _shbdk_rec_int_arr(shbdk_g2p_result_phonemes(r)));
    json_v_obj_set(o, str_from("confidence"), json_v_float_new(shbdk_g2p_result_confidence(r)));
    return _shbdk_rec_build(o);
}
# JSON text -> a G2PResult, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_g2p_result_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("a G2PResult must be an object"); }
    var phon = _shbdk_phonemes_from_jsonv(bayan_json_v_obj_get_by_cstr(root, "phonemes"), 0);
    if (phon == 0) { return 0; }
    var cell = alloc(8);
    if (_shbdk_rec_get_num(root, "confidence", cell) == 0) { return 0; }
    return shbdk_g2p_result_new(phon, load64(cell));
}
# 1 if two results have the same phonemes and confidence.
#must_use
fn shbdk_g2p_result_eq(a, b): i64 {
    if (_shbdk_rec_num_eq(shbdk_g2p_result_confidence(a), shbdk_g2p_result_confidence(b)) == 0) { return 0; }
    return _shbdk_rec_ivec_eq(shbdk_g2p_result_phonemes(a), shbdk_g2p_result_phonemes(b));
}

# LookupSource -> "UserOverlay" | "BaseDictionary" | {"G2PModel":{"confidence":f}}.
# `confidence` (f64 bits) is used only for SHBDK_SOURCE_G2P_MODEL. 0 for an unknown tag.
#must_use
fn shbdk_lookup_source_to_json(source, confidence): cstring {
    if (source == SHBDK_SOURCE_USER_OVERLAY) { return _shbdk_rec_build(json_v_str_new(str_from("UserOverlay"))); }
    if (source == SHBDK_SOURCE_BASE_DICTIONARY) { return _shbdk_rec_build(json_v_str_new(str_from("BaseDictionary"))); }
    if (source == SHBDK_SOURCE_G2P_MODEL) {
        var inner = json_v_obj_new();
        json_v_obj_set(inner, str_from("confidence"), json_v_float_new(confidence));
        var o = json_v_obj_new();
        json_v_obj_set(o, str_from("G2PModel"), inner);
        return _shbdk_rec_build(o);
    }
    return 0;
}
# JSON text -> a SHBDK_SOURCE_* tag (the G2P confidence into store64(conf_out),
# 0.0 for the others), or -1 with the reason recorded.
#must_use
fn shbdk_lookup_source_from_json(input, conf_out): i64 {
    store64(conf_out, 0);
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0 - 1; }
    if (json_v_is_str(root) == 1) {
        var name = str_cstr(json_v_str(root));
        if (streq(name, "UserOverlay") == 1) { return SHBDK_SOURCE_USER_OVERLAY; }
        if (streq(name, "BaseDictionary") == 1) { return SHBDK_SOURCE_BASE_DICTIONARY; }
        _shbdk_rec_bad("unknown LookupSource");
        return 0 - 1;
    }
    if (json_v_is_obj(root) == 1) {
        var inner = bayan_json_v_obj_get_by_cstr(root, "G2PModel");
        if (inner != 0 && json_v_is_obj(inner) == 1) {
            if (_shbdk_rec_get_num(inner, "confidence", conf_out) == 0) { return 0 - 1; }
            return SHBDK_SOURCE_G2P_MODEL;
        }
    }
    _shbdk_rec_bad("unknown LookupSource");
    return 0 - 1;
}

# An FstNotation tag -> its name ("Arpabet" / "Ipa"), or 0.
#must_use
fn shbdk_fst_notation_name(n): cstring {
    if (n == SHBDK_FST_NOTATION_ARPABET) { return "Arpabet"; }
    if (n == SHBDK_FST_NOTATION_IPA) { return "Ipa"; }
    return 0;
}
# An FstNotation name -> SHBDK_FST_NOTATION_*, or -1.
#must_use
fn shbdk_fst_notation_from_name(name): i64 {
    if (name == 0) { return 0 - 1; }
    if (streq(name, "Arpabet") == 1) { return SHBDK_FST_NOTATION_ARPABET; }
    if (streq(name, "Ipa") == 1) { return SHBDK_FST_NOTATION_IPA; }
    return 0 - 1;
}
# {"model_path":"...","notation":"Arpabet"}
#must_use
fn shbdk_fst_model_to_json(m): cstring {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("model_path"), json_v_str_new(str_from(shbdk_fst_model_path(m))));
    json_v_obj_set(o, str_from("notation"),
      json_v_str_new(str_from(shbdk_fst_notation_name(shbdk_fst_model_notation(m)))));
    return _shbdk_rec_build(o);
}
# JSON text -> an FstModel, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_fst_model_from_json(input): i64 {
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0) { return _shbdk_rec_bad("an FstModel must be an object"); }
    var path = _shbdk_rec_get_str(root, "model_path");
    if (path == 0) { return 0; }
    var n = shbdk_fst_notation_from_name(_shbdk_rec_get_str(root, "notation"));
    if (n < 0) { return _shbdk_rec_bad("\"notation\" must be Arpabet or Ipa"); }
    return shbdk_fst_model_new(path, n);
}
# 1 if two models have the same path and notation.
#must_use
fn shbdk_fst_model_eq(a, b): i64 {
    if (shbdk_fst_model_notation(a) != shbdk_fst_model_notation(b)) { return 0; }
    return streq(shbdk_fst_model_path(a), shbdk_fst_model_path(b));
}

# ---- the error ---------------------------------------------------------------
# {"<Variant>":"<detail>"} — the Rust's externally tagged ShabdakoshError, with
# its message: {"DictParseError":"line 3: unknown ARPABET symbol 'XX1'"}. `detail`
# is the text (shbdk_last_error() for the last failure). 0 for an ok / unknown code.
#must_use
fn shbdk_err_to_json(err, detail): cstring {
    var name = 0;
    var code = sakshi_err_code(err);
    if (code == SHBDK_ERR_DICT_PARSE) { name = "DictParseError"; }
    if (code == SHBDK_ERR_UNKNOWN_SYMBOL) { name = "UnknownSymbol"; }
    if (code == SHBDK_ERR_PHONEME_NOT_IN_INV) { name = "PhonemeNotInInventory"; }
    if (code == SHBDK_ERR_UNKNOWN_LANGUAGE) { name = "UnknownLanguage"; }
    if (name == 0) { return 0; }
    if (detail == 0) { detail = ""; }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from(name), json_v_str_new(str_from(detail)));
    return _shbdk_rec_build(o);
}
# JSON text -> a packed error (its detail copied into store64(detail_out)), or 0
# (ok is not an error) with the reason recorded.
#must_use
fn shbdk_err_from_json(input, detail_out): i64 {
    store64(detail_out, "");
    var root = _shbdk_rec_parse(input);
    if (root == 0) { return 0; }
    if (json_v_is_obj(root) == 0 ||
      json_v_obj_len(root) != 1) { return _shbdk_rec_bad("an error must be a one-key object"); }
    var name = str_cstr(json_v_obj_key(root, 0));
    var v = json_v_obj_val(root, 0);
    if (json_v_is_str(v) == 0) { return _shbdk_rec_bad("an error's detail must be a string"); }
    var err = 0;
    if (streq(name, "DictParseError") == 1) { err = shbdk_err_dict_parse(); }
    if (streq(name, "UnknownSymbol") == 1) { err = shbdk_err_unknown_symbol(); }
    if (streq(name, "PhonemeNotInInventory") == 1) { err = shbdk_err_phoneme_not_in_inventory(); }
    if (streq(name, "UnknownLanguage") == 1) { err = shbdk_err_unknown_language(); }
    if (err == 0) { return _shbdk_rec_bad("unknown error variant"); }
    store64(detail_out, str_cstr(json_v_str(v)));
    return err;
}

# --- pls.cyr ---

# pls.cyr — W3C PLS (Pronunciation Lexicon Specification) XML import/export, and
# the small XML reader it and ssml.cyr share.
#
# Ports 3.1.3:rust-old/src/dictionary/format/pls.rs. Only the `ipa` alphabet is
# supported. Reuses shbdk_xml_escape / _shbdk_xml_decode_at, _shbdk_starts_at and
# _shbdk_fmt_dup from format/mod.cyr, and _shbdk_sort_strs / _shbdk_collect_keys /
# _shbdk_dict_lookup_entry_str from mod.cyr. Included after format/mod.cyr.
#
# 3.1.3: the Rust (and the port through 3.1.2) found elements by substring search, so
# a lexeme kept only its FIRST <grapheme> (PLS 1.0 allows several, all sharing the
# pronunciations), an attribute on <phoneme> (`prefer="true"`) made that phoneme
# vanish, single-quoted attributes were missed (alphabet='x-sampa' slipped past
# the alphabet check), CDATA and numeric references were not decoded, and the
# lang attribute was written unescaped. This reads the XML properly: tags with
# attributes in either quote style, self-closing tags, comments, processing
# instructions, a DOCTYPE, CDATA, the five named entities and numeric references,
# and an end tag must close its start tag. A malformed document is an error with
# a reason.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- XML reader -----------------------------------------------------------------
# XML white space: space, tab, CR, LF (the XML `S` production).
fn _shbdk_pls_ws(c): i64 {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

# Index of cstr `pat` in s within [from, limit), or -1.
fn _shbdk_pls_find(s, from, limit, pat): i64 {
    var plen = strlen(pat);
    var i = from;
    while (i + plen <= limit) {
        if (_shbdk_starts_at(s, i, pat) == 1) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}

# 1 if byte c can be part of an XML name (ASCII letters, digits, - _ . : and any
# non-ASCII byte).
fn _shbdk_xml_namech(c): i64 {
    if (c >= 128) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 45 || c == 95 || c == 46 || c == 58) { return 1; }
    return 0;
}

# A tag record (48 bytes), filled by _shbdk_xml_tag:
#   [0] kind: 1 start, 2 end, 3 self-closing   [8] name start  [16] name end
#   [24] attributes start  [32] attributes end  [40] index just past '>'
var SHBDK_XML_START = 1;
var SHBDK_XML_END   = 2;
var SHBDK_XML_EMPTY = 3;

# Read the tag at s[i] == '<' into `t`. Returns 1, or 0 if it is malformed.
fn _shbdk_xml_tag(s, i, n, t): i64 {
    var j = i + 1;
    var kind = SHBDK_XML_START;
    if (j < n && load8(s + j) == 47) { kind = SHBDK_XML_END; j = j + 1; }   # '/'
    var ns = j;
    while (j < n && _shbdk_xml_namech(load8(s + j)) == 1) { j = j + 1; }
    if (j == ns) { return 0; }
    store64(t + 8, ns);
    store64(t + 16, j);
    var as = j;
    var q = 0;
    var c = 0;
    while (j < n) {
        c = load8(s + j);
        if (q != 0) {
            if (c == q) { q = 0; }
            if (c == 60) { return 0; }   # '<' inside an attribute value
        } else {
            if (c == 34 || c == 39) { q = c; }
            if (c == 62) { break; }      # '>'
            if (c == 60) { return 0; }
        }
        j = j + 1;
    }
    if (j >= n) { return 0; }
    var ae = j;
    if (load8(s + j - 1) == 47 && kind == SHBDK_XML_START) { kind = SHBDK_XML_EMPTY; ae = j - 1; }
    store64(t + 0, kind);
    store64(t + 24, as);
    store64(t + 32, ae);
    store64(t + 40, j + 1);
    return 1;
}

# 1 if the tag's name, with any namespace prefix dropped, is `local`.
fn _shbdk_xml_is(s, t, local): i64 {
    var ns = load64(t + 8);
    var ne = load64(t + 16);
    var k = ns;
    while (k < ne) {
        if (load8(s + k) == 58) { ns = k + 1; }   # ':' -> drop the prefix
        k = k + 1;
    }
    var ln = strlen(local);
    if (ne - ns != ln) { return 0; }
    return memeq(s + ns, local, ln);
}

# Decode s[i..j) (character data or an attribute value): entities, numeric
# references and CDATA sections. Returns a fresh cstr.
fn _shbdk_xml_text(s, i, j): cstring {
    var sb = str_builder_new();
    var k = i;
    var ce = 0;
    while (k < j) {
        if (_shbdk_starts_at(s, k, "<!--") == 1) {   # a comment inside text is not text
            ce = _shbdk_pls_find(s, k + 4, j, "-->");
            if (ce < 0) { ce = j; }
            k = ce + 3;
            continue;
        }
        if (_shbdk_starts_at(s, k, "<![CDATA[") == 1) {
            ce = _shbdk_pls_find(s, k + 9, j, "]]>");
            if (ce < 0) { ce = j; }
            var q = k + 9;
            while (q < ce) { str_builder_add_byte(sb, load8(s + q)); q = q + 1; }
            k = ce + 3;
        } else {
            k = k + _shbdk_xml_decode_at(s, k, sb);
        }
    }
    return str_data(str_builder_build(sb));
}

# The decoded value of attribute `name` in the tag (either quote style), or 0.
fn _shbdk_xml_attr(s, t, name): cstring {
    var i = load64(t + 24);
    var e = load64(t + 32);
    var nl = strlen(name);
    var ns = 0;
    var q = 0;
    var vs = 0;
    while (i < e) {
        while (i < e && _shbdk_pls_ws(load8(s + i)) == 1) { i = i + 1; }
        ns = i;
        while (i < e && _shbdk_xml_namech(load8(s + i)) == 1) { i = i + 1; }
        if (i == ns) { return 0; }
        var nend = i;
        while (i < e && _shbdk_pls_ws(load8(s + i)) == 1) { i = i + 1; }
        if (i >= e || load8(s + i) != 61) { return 0; }   # '='
        i = i + 1;
        while (i < e && _shbdk_pls_ws(load8(s + i)) == 1) { i = i + 1; }
        if (i >= e) { return 0; }
        q = load8(s + i);
        if (q != 34 && q != 39) { return 0; }
        vs = i + 1;
        i = vs;
        while (i < e && load8(s + i) != q) { i = i + 1; }
        if (i >= e) { return 0; }
        if (nend - ns == nl && memeq(s + ns, name, nl) == 1) { return _shbdk_xml_text(s, vs, i); }
        i = i + 1;
    }
    return 0;
}

# Past a comment, processing instruction, DOCTYPE or CDATA at s[i] == '<', or -1
# if it is none of those (or is unterminated: -2).
fn _shbdk_xml_skip_special(s, i, n): i64 {
    var e = 0;
    if (_shbdk_starts_at(s, i, "<!--") == 1) {
        e = _shbdk_pls_find(s, i + 4, n, "-->");
        if (e < 0) { return 0 - 2; }
        return e + 3;
    }
    if (_shbdk_starts_at(s, i, "<?") == 1) {
        e = _shbdk_pls_find(s, i + 2, n, "?>");
        if (e < 0) { return 0 - 2; }
        return e + 2;
    }
    if (_shbdk_starts_at(s, i, "<![CDATA[") == 1) {
        e = _shbdk_pls_find(s, i + 9, n, "]]>");
        if (e < 0) { return 0 - 2; }
        return e + 3;
    }
    if (_shbdk_starts_at(s, i, "<!") == 1) {
        # DOCTYPE: to the matching '>' (an internal subset in [] may hold '>')
        var depth = 0;
        e = i + 2;
        while (e < n) {
            if (load8(s + e) == 91) { depth = depth + 1; }
            if (load8(s + e) == 93) { depth = depth - 1; }
            if (load8(s + e) == 62 && depth <= 0) { return e + 1; }
            e = e + 1;
        }
        return 0 - 2;
    }
    return 0 - 1;
}

# Index of the next '<' that starts markup other than CDATA, from i (or n).
fn _shbdk_xml_next_markup(s, i, n): i64 {
    while (i < n) {
        if (load8(s + i) == 60 && _shbdk_starts_at(s, i, "<![CDATA[") == 0) { return i; }
        if (_shbdk_starts_at(s, i, "<![CDATA[") == 1) {
            var ce = _shbdk_pls_find(s, i + 9, n, "]]>");
            if (ce < 0) { return n; }
            i = ce + 3;
        } else {
            i = i + 1;
        }
    }
    return n;
}

# XML-whitespace-trimmed copy of cstr s.
fn _shbdk_xml_trim(s): cstring {
    var n = strlen(s);
    var a = 0;
    while (a < n && _shbdk_pls_ws(load8(s + a)) == 1) { a = a + 1; }
    while (n > a && _shbdk_pls_ws(load8(s + n - 1)) == 1) { n = n - 1; }
    return _shbdk_fmt_dup(s, a, n);
}

# ---- PLS parse -------------------------------------------------------------------
# 1 if an alphabet attribute value is IPA (absent counts as IPA, as in the Rust).
fn _shbdk_pls_alpha_ok(a): i64 {
    if (a == 0) { return 1; }
    if (streq(a, "ipa") == 1) { return 1; }
    return 0;
}

# Add every grapheme of a finished lexeme to `dict` with its pronunciations
# (preferred ones first, then document order).
fn _shbdk_pls_emit(dict, graphemes, preferred, others): i64 {
    var all = vec_new();
    var i = 0;
    while (i < vec_len(preferred)) { vec_push(all, vec_get(preferred, i)); i = i + 1; }
    i = 0;
    while (i < vec_len(others)) { vec_push(all, vec_get(others, i)); i = i + 1; }
    if (vec_len(all) == 0) { return 0; }   # aliases / examples only: nothing to say
    i = 0;
    var prons = 0;
    var j = 0;
    while (i < vec_len(graphemes)) {
        prons = vec_new();
        j = 0;
        while (j < vec_len(all)) {
            vec_push(prons, shbdk_pronunciation_new(shbdk_phonemes_clone(vec_get(all, j))));
            j = j + 1;
        }
        shbdk_dict_insert_entry(dict, vec_get(graphemes, i), shbdk_dict_entry_from_pronunciations(prons));
        i = i + 1;
    }
    return 0;
}

# Parse a W3C PLS XML string into a PronunciationDict, or 0 on error with the
# reason in shbdk_last_error(): an alphabet other than ipa (on the lexicon or on a
# phoneme), malformed XML, a root that is not <lexicon>, or input that is not UTF-8.
# Every <grapheme> of a <lexeme> gets every <phoneme> of it; `prefer="true"` ones
# come first. <alias> and <example> are read past (an alias names no phonemes).
#must_use
fn shbdk_parse_pls(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var n = strlen(input);
    if (shbdk_utf8_valid(input, n) == 0) { return _shbdk_fail("input is not valid UTF-8"); }
    var dict = shbdk_dict_new();
    var t = alloc(48);
    var open_els = vec_new();     # names of open elements: 1 lexicon, 2 lexeme, 3 grapheme, 4 phoneme, 0 other
    var i = 0;
    var k = 0;
    var tx = 0;
    var top = 0;
    var seen_root = 0;
    var graphemes = 0;
    var preferred = 0;
    var others = 0;
    var text_start = 0;
    var prefer = 0;
    var code = 0;
    while (i < n) {
        if (load8(input + i) != 60) {
            # character data: only matters inside a grapheme / phoneme (collected on close)
            i = _shbdk_xml_next_markup(input, i, n);
            continue;
        }
        k = _shbdk_xml_skip_special(input, i, n);
        if (k == 0 - 2) { return _shbdk_fail("malformed XML: unterminated comment, PI or CDATA"); }
        if (k >= 0) { i = k; continue; }
        if (_shbdk_xml_tag(input, i, n, t) == 0) { return _shbdk_fail("malformed XML: bad tag"); }
        code = 0;
        if (_shbdk_xml_is(input, t, "lexicon") == 1) { code = 1; }
        if (_shbdk_xml_is(input, t, "lexeme") == 1) { code = 2; }
        if (_shbdk_xml_is(input, t, "grapheme") == 1) { code = 3; }
        if (_shbdk_xml_is(input, t, "phoneme") == 1) { code = 4; }
        if (load64(t) == SHBDK_XML_END) {
            if (vec_len(open_els) == 0) { return _shbdk_fail("malformed XML: an end tag with no start tag"); }
            top = vec_get(open_els, vec_len(open_els) - 1);
            if (top != code) { return _shbdk_fail("malformed XML: an end tag does not match its start tag"); }
            if (code == 3) {
                tx = _shbdk_xml_trim(_shbdk_xml_text(input, text_start, i));
                if (load8(tx) != 0) { vec_push(graphemes, tx); }
            }
            if (code == 4) {
                var phon = shbdk_parse_ipa_word(_shbdk_xml_text(input, text_start, i));
                if (vec_len(phon) > 0) {
                    if (prefer == 1) { vec_push(preferred, phon); } else { vec_push(others, phon); }
                }
            }
            if (code == 2) { _shbdk_pls_emit(dict, graphemes, preferred, others); }
            vec_pop(open_els);
            i = load64(t + 40);
            continue;
        }
        if (seen_root == 0) {
            if (code != 1) { return _shbdk_fail("malformed PLS: the root element is not <lexicon>"); }
            seen_root = 1;
            var la = _shbdk_xml_attr(input, t, "alphabet");
            if (_shbdk_pls_alpha_ok(la) == 0) {
                var sb = str_builder_new();
                str_builder_add_cstr(sb, "unsupported PLS alphabet: '");
                str_builder_add_cstr(sb, la);
                str_builder_add_cstr(sb, "' (only 'ipa' is supported)");
                return _shbdk_fail(str_data(str_builder_build(sb)));
            }
        }
        if (code == 2) { graphemes = vec_new(); preferred = vec_new(); others = vec_new(); }
        if (code == 4) {
            var pa = _shbdk_xml_attr(input, t, "alphabet");
            if (_shbdk_pls_alpha_ok(pa) == 0) {
                var sb2 = str_builder_new();
                str_builder_add_cstr(sb2, "unsupported PLS alphabet: '");
                str_builder_add_cstr(sb2, pa);
                str_builder_add_cstr(sb2, "' (only 'ipa' is supported)");
                return _shbdk_fail(str_data(str_builder_build(sb2)));
            }
            prefer = 0;
            var pf = _shbdk_xml_attr(input, t, "prefer");
            if (pf != 0 && streq(pf, "true") == 1) { prefer = 1; }
        }
        if (load64(t) == SHBDK_XML_START) {
            if ((code == 3 || code == 4) && (vec_len(open_els) == 0 || vec_get(open_els, vec_len(open_els) - 1) != 2)) {
                code = 0;   # a grapheme / phoneme outside a lexeme is not one
            }
            vec_push(open_els, code);
            text_start = load64(t + 40);
        } else {
            if (code == 2) { _shbdk_pls_emit(dict, graphemes, preferred, others); }   # <lexeme/>
        }
        i = load64(t + 40);
    }
    if (vec_len(open_els) != 0) { return _shbdk_fail("malformed XML: an element is not closed"); }
    if (seen_root == 0) { return _shbdk_fail("malformed PLS: no <lexicon> element"); }
    return dict;
}

# Append the PLS header + <lexicon> open to `sb`.
fn _shbdk_pls_header(sb, lang): i64 {
    str_builder_add_cstr(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    str_builder_add_cstr(sb, "<lexicon version=\"1.0\" ");
    str_builder_add_cstr(sb, "xmlns=\"http://www.w3.org/2005/01/pronunciation-lexicon\" ");
    str_builder_add_cstr(sb, "alphabet=\"ipa\" xml:lang=\"");
    str_builder_add_cstr(sb, shbdk_xml_escape(lang));   # 3.1.3: escaped (en"US broke the XML)
    str_builder_add_cstr(sb, "\">\n");
    return 0;
}

# Append one <lexeme> (grapheme + all phonemes) to `sb`.
fn _shbdk_pls_write_lexeme(sb, word, entry): i64 {
    str_builder_add_cstr(sb, "  <lexeme>\n");
    str_builder_add_cstr(sb, "    <grapheme>");
    str_builder_add_cstr(sb, shbdk_xml_escape(word));
    str_builder_add_cstr(sb, "</grapheme>\n");
    var prons = shbdk_dict_entry_all(entry);
    var n = vec_len(prons);
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, "    <phoneme>");
        str_builder_add_cstr(sb,
          shbdk_xml_escape(shbdk_phonemes_to_ipa(shbdk_pronunciation_phonemes(vec_get(prons, i)))));
        str_builder_add_cstr(sb, "</phoneme>\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "  </lexeme>\n");
    return 0;
}

# Serialize base entries to PLS XML (IPA alphabet). Returns a cstr.
#must_use
fn shbdk_to_pls(dict, lang): cstring {
    var sb = str_builder_new();
    _shbdk_pls_header(sb, lang);
    var words = map_keys(shbdk_dict_entries(dict));
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    while (i < n) {
        wk = vec_get(words, i);
        _shbdk_pls_write_lexeme(sb, str_cstr(wk), map_get(shbdk_dict_entries(dict), wk));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "</lexicon>\n");
    return str_data(str_builder_build(sb));
}

# Serialize all effective entries (user overrides base) to PLS XML. Returns a cstr.
#must_use
fn shbdk_to_pls_with_user(dict, lang): cstring {
    var sb = str_builder_new();
    _shbdk_pls_header(sb, lang);
    var seen = map_new_str();
    _shbdk_collect_keys(seen, shbdk_dict_entries(dict));
    _shbdk_collect_keys(seen, shbdk_dict_user_entries(dict));
    var words = map_keys(seen);
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    var entry = 0;
    while (i < n) {
        wk = vec_get(words, i);
        entry = _shbdk_dict_lookup_entry_str(dict, wk);
        if (entry != 0) { _shbdk_pls_write_lexeme(sb, str_cstr(wk), entry); }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "</lexicon>\n");
    return str_data(str_builder_build(sb));
}

# --- ssml.cyr ---

# ssml.cyr — SSML <phoneme> tag parse / emit.
#
# Ports 3.1.3:rust-old/src/dictionary/format/ssml.rs. Handles the SSML phoneme element
# `<phoneme alphabet="ipa" ph="IPA">word</phoneme>`. Reads it with the XML reader
# in pls.cyr (_shbdk_xml_tag / _xml_attr / _xml_text) and writes it with
# shbdk_xml_escape from format/mod.cyr.
# Included after src/dictionary/format/pls.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkSsmlResult layout (16 bytes): [0]=word(cstr) [8]=phonemes(vec of ordinals).

# Parse an SSML <phoneme> tag into a (word, phonemes) result, or 0 on error with
# the reason in shbdk_last_error(): not a <phoneme> tag, an alphabet other than
# ipa, a missing ph, no phonemes in it, markup inside the word, a missing
# </phoneme>, or anything but white space after it.
#
# 3.1.3: on the shared XML reader (pls.cyr). Attributes may come in any order and
# either quote style (ph='kæt' was refused), the word's entities, numeric
# references and CDATA decode, and a malformed tag is refused — `ph="</phoneme>kæt"`
# returned the word `kæt">cat` with ten junk phonemes, and the Rust panicked.
#must_use
fn shbdk_parse_ssml_phoneme(tag): i64 {
    shbdk_clear_error();
    if (tag == 0) { return _shbdk_fail("no input"); }
    var len = strlen(tag);
    var s = 0;
    while (s < len && _shbdk_pls_ws(load8(tag + s)) == 1) { s = s + 1; }
    var t = alloc(48);
    if (s >= len || load8(tag + s) != 60 || _shbdk_xml_tag(tag, s, len, t) == 0) {
        return _shbdk_fail("not an SSML <phoneme> tag");
    }
    if (load64(t) == SHBDK_XML_END || _shbdk_xml_is(tag, t, "phoneme") == 0) {
        return _shbdk_fail("not an SSML <phoneme> tag");
    }
    var alpha = _shbdk_xml_attr(tag, t, "alphabet");
    if (alpha != 0 && streq(alpha, "ipa") == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "unsupported SSML alphabet: '");
        str_builder_add_cstr(sb, alpha);
        str_builder_add_cstr(sb, "' (only 'ipa' is supported)");
        return _shbdk_fail(str_data(str_builder_build(sb)));
    }
    var ph = _shbdk_xml_attr(tag, t, "ph");
    if (ph == 0) { return _shbdk_fail("missing ph attribute"); }
    var phon = shbdk_parse_ipa_word(ph);
    if (vec_len(phon) == 0) { return _shbdk_fail("no phonemes in the ph attribute"); }
    if (load64(t) == SHBDK_XML_EMPTY) { return _shbdk_fail("missing </phoneme> close tag"); }

    # the word: character data up to </phoneme>, with no markup in it
    var cs = load64(t + 40);
    var ce = _shbdk_xml_next_markup(tag, cs, len);
    if (ce >= len) { return _shbdk_fail("missing </phoneme> close tag"); }
    var t2 = alloc(48);
    if (_shbdk_xml_tag(tag, ce, len, t2) == 0) { return _shbdk_fail("malformed tag"); }
    if (load64(t2) != SHBDK_XML_END || _shbdk_xml_is(tag, t2, "phoneme") == 0) {
        return _shbdk_fail("the word of a <phoneme> holds markup");
    }
    var rest = load64(t2 + 40);
    while (rest < len && _shbdk_pls_ws(load8(tag + rest)) == 1) { rest = rest + 1; }
    if (rest < len) { return _shbdk_fail("content after </phoneme>"); }

    var r = alloc(16);
    store64(r + 0, _shbdk_xml_trim(_shbdk_xml_text(tag, cs, ce)));
    store64(r + 8, phon);
    return r;
}

# Word (cstr) from a parse_ssml_phoneme result.
#must_use
fn shbdk_ssml_result_word(r): cstring {
    return load64(r + 0);
}

# Phonemes (vec) from a parse_ssml_phoneme result.
#must_use
fn shbdk_ssml_result_phonemes(r): i64 {
    return load64(r + 8);
}

# Emit an SSML <phoneme> tag (IPA alphabet) for a word + phoneme sequence.
#must_use
fn shbdk_to_ssml_phoneme(word, phonemes): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "<phoneme alphabet=\"ipa\" ph=\"");
    str_builder_add_cstr(sb, shbdk_xml_escape(shbdk_phonemes_to_ipa(phonemes)));
    str_builder_add_cstr(sb, "\">");
    str_builder_add_cstr(sb, shbdk_xml_escape(word));
    str_builder_add_cstr(sb, "</phoneme>");
    return str_data(str_builder_build(sb));
}

# --- binary.cyr ---

# binary.cyr — compact binary serialization for pronunciation dictionaries.
#
# Ports 3.1.3:rust-old/src/dictionary/format/binary.rs. The Rust used postcard; CYRIUS
# has no postcard, so this is a hand-rolled little-endian binary format (the
# maximal-scope decision). Layout: "SHBD" magic (4) + version (1), then
#   lang: u8 flag [+ u16 len + bytes]
#   entries:      u32 count, each { u16 wlen + word, u16 npron, prons... }
#   user_entries: same
# Words go out in byte order in both maps, as Rust's BTreeMaps do, so the same dictionary
# always gives the same bytes. The reader takes them in any order.
#   pron: u16 nphon + nphon×u8 (phoneme ordinals) + u8 freq-flag [+ u64 f64 bits]
#         + u8 region-flag [+ u8 region]
#         + (version 2 only) u8 stress-flag [+ nphon×u8, each SHBDK_STRESS_* + 1]
# Version 2 (3.2.0) adds the stress. It is written only when some pronunciation has
# stress, so a dictionary without any gives the same version-1 bytes as before 3.2.0,
# which older readers still load. The reader takes both versions.
# to_binary returns a Str (blob may contain NULs); from_binary takes a Str.
# Included after src/dictionary/mod.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

var SHBDK_BIN_VERSION = 2;           # the newest version this reader takes
var SHBDK_BIN_VERSION_NO_STRESS = 1; # written when no pronunciation has stress
var SHBDK_BIN_HEADER  = 5;

# The version being written or read: 1, or 2 with a stress field per pronunciation.
var _SHBDK_BIN_V = 1;
# Set by the sizing pass: the bytes version 2's stress fields add, and whether any
# pronunciation has stress (so the writer picks the version without a second scan).
var _SHBDK_BIN_STRESS_BYTES = 0;
var _SHBDK_BIN_ANY_STRESS = 0;

# "SHBD" magic, one byte per const (3.0.5 — these were bare 83/72/66/68 literals
# at the write site and again at the read site).
var SHBDK_BIN_MAGIC_S = 83;
var SHBDK_BIN_MAGIC_H = 72;
var SHBDK_BIN_MAGIC_B = 66;
var SHBDK_BIN_MAGIC_D = 68;

# ---- little-endian put helpers (return bytes written) ------------------------
fn _shbdk_bin_put_u16(buf, off, v): i64 {
    store8(buf + off + 0, v & 255);
    store8(buf + off + 1, (v >> 8) & 255);
    return 2;
}

fn _shbdk_bin_put_u32(buf, off, v): i64 {
    store8(buf + off + 0, v & 255);
    store8(buf + off + 1, (v >> 8) & 255);
    store8(buf + off + 2, (v >> 16) & 255);
    store8(buf + off + 3, (v >> 24) & 255);
    return 4;
}

fn _shbdk_bin_put_u64(buf, off, v): i64 {
    store8(buf + off + 0, v & 255);
    store8(buf + off + 1, (v >> 8) & 255);
    store8(buf + off + 2, (v >> 16) & 255);
    store8(buf + off + 3, (v >> 24) & 255);
    store8(buf + off + 4, (v >> 32) & 255);
    store8(buf + off + 5, (v >> 40) & 255);
    store8(buf + off + 6, (v >> 48) & 255);
    store8(buf + off + 7, (v >> 56) & 255);
    return 8;
}

fn _shbdk_bin_put_strn(buf, off, data, len): i64 {
    _shbdk_bin_put_u16(buf, off, len);
    var i = 0;
    while (i < len) {
        store8(buf + off + 2 + i, load8(data + i));
        i = i + 1;
    }
    return 2 + len;
}

# ---- little-endian get helpers -----------------------------------------------
fn _shbdk_bin_get_u16(buf, off): i64 {
    return load8(buf + off) | (load8(buf + off + 1) << 8);
}

fn _shbdk_bin_get_u32(buf, off): i64 {
    var v = load8(buf + off);
    v = v | (load8(buf + off + 1) << 8);
    v = v | (load8(buf + off + 2) << 16);
    v = v | (load8(buf + off + 3) << 24);
    return v;
}

fn _shbdk_bin_get_u64(buf, off): i64 {
    var v = load8(buf + off);
    v = v | (load8(buf + off + 1) << 8);
    v = v | (load8(buf + off + 2) << 16);
    v = v | (load8(buf + off + 3) << 24);
    v = v | (load8(buf + off + 4) << 32);
    v = v | (load8(buf + off + 5) << 40);
    v = v | (load8(buf + off + 6) << 48);
    v = v | (load8(buf + off + 7) << 56);
    return v;
}

# NUL-terminated cstr copy of buf[off..off+len). `len` is a u16 read from an
# untrusted blob; shbdk_copyz (error.cyr) clamps it and checks the allocation.
fn _shbdk_bin_dup(buf, off, len): i64 {
    return shbdk_copyz(buf + off, len);
}

# ---- to_binary ---------------------------------------------------------------
var _SHBDK_BIN_BAD_PHONEME = 0;   # set by _shbdk_bin_put_pron: a phoneme outside 0..100 was met

fn _shbdk_bin_put_pron(buf, off, pron): i64 {
    var start = off;
    var phon = shbdk_pronunciation_phonemes(pron);
    var np = vec_len(phon);
    off = off + _shbdk_bin_put_u16(buf, off, np);
    var i = 0;
    var ph = 0;
    while (i < np) {
        ph = vec_get(phon, i);
        if (ph < 0 || ph > 100) { _SHBDK_BIN_BAD_PHONEME = 1; }
        store8(buf + off, ph);
        off = off + 1;
        i = i + 1;
    }
    if (shbdk_pronunciation_has_frequency(pron) == 1) {
        store8(buf + off, 1);
        off = off + 1;
        off = off + _shbdk_bin_put_u64(buf, off, shbdk_pronunciation_frequency(pron));
    } else {
        store8(buf + off, 0);
        off = off + 1;
    }
    if (shbdk_pronunciation_has_region(pron) == 1) {
        store8(buf + off, 1);
        off = off + 1;
        store8(buf + off, shbdk_pronunciation_region(pron));
        off = off + 1;
    } else {
        store8(buf + off, 0);
        off = off + 1;
    }
    if (_SHBDK_BIN_V >= 2) {
        if (shbdk_pronunciation_has_stress(pron) == 1) {
            store8(buf + off, 1);
            off = off + 1;
            var st = shbdk_pronunciation_stress(pron);
            i = 0;
            while (i < np) {
                store8(buf + off, vec_get(st, i) + 1);
                off = off + 1;
                i = i + 1;
            }
        } else {
            store8(buf + off, 0);
            off = off + 1;
        }
    }
    return off - start;
}

fn _shbdk_bin_put_map(buf, off, map): i64 {
    var start = off;
    var keys = map_keys(map);
    _shbdk_sort_strs(keys);
    var n = vec_len(keys);
    off = off + _shbdk_bin_put_u32(buf, off, n);
    var i = 0;
    var wk = 0;
    var prons = 0;
    var np = 0;
    var j = 0;
    while (i < n) {
        wk = vec_get(keys, i);
        off = off + _shbdk_bin_put_strn(buf, off, str_data(wk), str_len(wk));
        prons = shbdk_dict_entry_all(map_get(map, wk));
        np = vec_len(prons);
        off = off + _shbdk_bin_put_u16(buf, off, np);
        j = 0;
        while (j < np) {
            off = off + _shbdk_bin_put_pron(buf, off, vec_get(prons, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return off - start;
}

# ---- exact serialized-size computation (mirrors the put_* layout) ------------
# SECURITY: size the output buffer to the dict instead of a fixed 2 MB alloc, so a
# large dict (many/long user entries) can never overflow the write buffer.
#
# 3.1.3: the sizing pass also checks that the dictionary FITS the format, and
# returns -1 (with the reason recorded) if it does not: a u16 field over 65535 (a
# word, a phoneme list, a variant count, the language code), or a word / language
# that is not well-formed UTF-8 or holds a NUL. (A phoneme outside svara's 0..100
# is caught as it is written.) These used to be written anyway — a 65,536-byte word
# made the whole file undecodable, and 65,537 variants wrapped to 1.
fn _shbdk_bin_pron_size(pron): i64 {
    var np = vec_len(shbdk_pronunciation_phonemes(pron));
    if (np > 65535) { return _shbdk_bin_unfit("a pronunciation has more than 65535 phonemes"); }
    var sz = 2 + np + 1;   # u16 nphon + nphon x u8 + freq flag (each phoneme is range-checked as it is written)
    if (shbdk_pronunciation_has_frequency(pron) == 1) { sz = sz + 8; }   # u64 freq
    sz = sz + 1;   # region flag
    if (shbdk_pronunciation_has_region(pron) == 1) { sz = sz + 1; }      # u8 region
    # version 2's stress flag [+ u8 per phoneme], counted apart: the version is not
    # known until every pronunciation has been seen
    _SHBDK_BIN_STRESS_BYTES = _SHBDK_BIN_STRESS_BYTES + 1;
    if (shbdk_pronunciation_has_stress(pron) == 1) {
        _SHBDK_BIN_STRESS_BYTES = _SHBDK_BIN_STRESS_BYTES + np;
        _SHBDK_BIN_ANY_STRESS = 1;
    }
    return sz;
}

fn _shbdk_bin_unfit(msg): i64 {
    _shbdk_fail(msg);
    return 0 - 1;
}

# 1 if p[0..n) can be a word / language in the format: well-formed UTF-8, no NUL.
fn _shbdk_bin_text_ok(p, n): i64 {
    var i = 0;
    var c = 0;
    var wide = 0;
    while (i < n) {
        c = load8(p + i);
        if (c == 0) { return 0; }
        if (c >= 128) { wide = 1; }
        i = i + 1;
    }
    if (wide == 1) { return shbdk_utf8_valid(p, n); }
    return 1;
}

fn _shbdk_bin_map_size(map): i64 {
    var sz = 4;   # u32 count
    var keys = map_keys(map);
    var n = vec_len(keys);
    var i = 0;
    var wk = 0;
    var prons = 0;
    var np = 0;
    var j = 0;
    var ps = 0;
    while (i < n) {
        wk = vec_get(keys, i);
        if (str_len(wk) > 65535) { return _shbdk_bin_unfit("a word is longer than 65535 bytes"); }
        if (_shbdk_bin_text_ok(str_data(wk), str_len(wk)) == 0) {
            return _shbdk_bin_unfit("a word is not well-formed UTF-8, or holds a NUL");
        }
        sz = sz + 2 + str_len(wk);   # u16 wlen + word bytes
        prons = shbdk_dict_entry_all(map_get(map, wk));
        np = vec_len(prons);
        if (np > 65535) { return _shbdk_bin_unfit("a word has more than 65535 pronunciations"); }
        sz = sz + 2;   # u16 npron
        j = 0;
        while (j < np) {
            ps = _shbdk_bin_pron_size(vec_get(prons, j));
            if (ps < 0) { return 0 - 1; }
            sz = sz + ps;
            j = j + 1;
        }
        i = i + 1;
    }
    return sz;
}

fn _shbdk_bin_total_size(dict): i64 {
    var sz = SHBDK_BIN_HEADER;   # magic(4) + version(1)
    sz = sz + 1;   # language flag
    var lang = shbdk_dict_language(dict);
    if (lang != 0) {
        if (strlen(lang) > 65535) { return _shbdk_bin_unfit("the language code is longer than 65535 bytes"); }
        if (_shbdk_bin_text_ok(lang, strlen(lang)) == 0) {
            return _shbdk_bin_unfit("the language code is not well-formed UTF-8");
        }
        sz = sz + 2 + strlen(lang);   # u16 llen + lang bytes
    }
    var ms = _shbdk_bin_map_size(shbdk_dict_entries(dict));
    if (ms < 0) { return 0 - 1; }
    sz = sz + ms;
    ms = _shbdk_bin_map_size(shbdk_dict_user_entries(dict));
    if (ms < 0) { return 0 - 1; }
    return sz + ms;
}

# Serialize a PronunciationDict to a compact binary blob (a Str). An empty Str
# means it could not be (out of memory, or a dictionary the format cannot hold);
# shbdk_last_error() says which.
#must_use
fn shbdk_to_binary(dict): i64 {
    shbdk_clear_error();
    _SHBDK_BIN_STRESS_BYTES = 0;
    _SHBDK_BIN_ANY_STRESS = 0;
    var total = _shbdk_bin_total_size(dict);
    if (total < 0) { return str_new(0, 0); }
    _SHBDK_BIN_V = SHBDK_BIN_VERSION_NO_STRESS;
    if (_SHBDK_BIN_ANY_STRESS == 1) {
        _SHBDK_BIN_V = SHBDK_BIN_VERSION;
        total = total + _SHBDK_BIN_STRESS_BYTES;
    }
    # 3.0.4: a dict whose serialized form exceeds ALLOC_MAX makes alloc() return 0,
    # and the header stores below would write to address 0. Fail as an empty Str —
    # from_binary rejects it (len < header) and save_binary_file reports the error.
    var buf = alloc(total + 16);
    if (buf == 0) { _shbdk_fail("binary serialize error: out of memory"); return str_new(0, 0); }
    store8(buf + 0, SHBDK_BIN_MAGIC_S);
    store8(buf + 1, SHBDK_BIN_MAGIC_H);
    store8(buf + 2, SHBDK_BIN_MAGIC_B);
    store8(buf + 3, SHBDK_BIN_MAGIC_D);
    store8(buf + 4, _SHBDK_BIN_V);
    var off = 5;
    var lang = shbdk_dict_language(dict);
    if (lang != 0) {
        store8(buf + off, 1);
        off = off + 1;
        off = off + _shbdk_bin_put_strn(buf, off, lang, strlen(lang));
    } else {
        store8(buf + off, 0);
        off = off + 1;
    }
    _SHBDK_BIN_BAD_PHONEME = 0;
    off = off + _shbdk_bin_put_map(buf, off, shbdk_dict_entries(dict));
    off = off + _shbdk_bin_put_map(buf, off, shbdk_dict_user_entries(dict));
    if (_SHBDK_BIN_BAD_PHONEME == 1) {
        _shbdk_fail("a phoneme is not a svara phoneme (0-100)");
        return str_new(0, 0);
    }
    return str_new(buf, off);
}

# ---- from_binary -------------------------------------------------------------
# SECURITY: every length/count field below is attacker-controlled (the blob may
# be a corrupt or malicious .bin from disk/mmap). The Rust got this bound for free
# from postcard's bounds-checked reader; this port enforces it by hand.
# `_shbdk_bin_oob(off, need, len)` returns 1 if reading `need` bytes at `off`
# would run past the blob end (`len`); the get helpers return -1 on any overrun,
# which propagates up to shbdk_from_binary -> 0.
#
# 3.1.3: every VALUE is checked as well as every length, and a failure says what it
# was. An option flag must be 0 or 1, a phoneme 0..100, a region GA or RP, a
# frequency 0.0-1.0, a stress byte 0..3 (SHBDK_STRESS_* + 1; 3.2.0), a word or
# language well-formed UTF-8 with no NUL, an entry
# must have a pronunciation, and nothing may follow the user map. A region byte of
# 7 used to load and then crash to_cmudict / to_json.
fn _shbdk_bin_oob(off, need, len): i64 {
    if (off + need > len) { return 1; }
    return 0;
}

# Record a decode failure and return -1 (the get helpers' error value).
fn _shbdk_bin_bad(msg): i64 {
    _shbdk_fail(msg);
    return 0 - 1;
}

fn _shbdk_bin_truncated(): i64 {
    return _shbdk_bin_bad("binary deserialize error: unexpected end of data");
}

fn _shbdk_bin_get_pron(buf, off, prons, len): i64 {
    if (_shbdk_bin_oob(off, 2, len) == 1) { return _shbdk_bin_truncated(); }
    var np = _shbdk_bin_get_u16(buf, off);
    off = off + 2;
    if (_shbdk_bin_oob(off, np, len) == 1) { return _shbdk_bin_truncated(); }
    var phon = vec_new();
    var i = 0;
    var ph = 0;
    while (i < np) {
        ph = load8(buf + off);
        if (ph > 100) { return _shbdk_bin_bad("binary deserialize error: a phoneme is not a svara phoneme (0-100)"); }
        vec_push(phon, ph);
        off = off + 1;
        i = i + 1;
    }
    var pron = shbdk_pronunciation_new(phon);
    if (_shbdk_bin_oob(off, 1, len) == 1) { return _shbdk_bin_truncated(); }
    var flag = load8(buf + off);
    off = off + 1;
    var f = 0;
    if (flag == 1) {
        if (_shbdk_bin_oob(off, 8, len) == 1) { return _shbdk_bin_truncated(); }
        f = _shbdk_bin_get_u64(buf, off);
        if (shbdk_frequency_is_valid(f) == 0) {
            return _shbdk_bin_bad("binary deserialize error: a frequency is outside 0.0-1.0");
        }
        pron = shbdk_pronunciation_with_frequency(pron, f);
        off = off + 8;
    } else {
        if (flag != 0) { return _shbdk_bin_bad("binary deserialize error: an option flag is not 0 or 1"); }
    }
    if (_shbdk_bin_oob(off, 1, len) == 1) { return _shbdk_bin_truncated(); }
    flag = load8(buf + off);
    off = off + 1;
    if (flag == 1) {
        if (_shbdk_bin_oob(off, 1, len) == 1) { return _shbdk_bin_truncated(); }
        if (shbdk_region_code(load8(buf + off)) == 0) {
            return _shbdk_bin_bad("binary deserialize error: a region is not GA or RP");
        }
        pron = shbdk_pronunciation_with_region(pron, load8(buf + off));
        off = off + 1;
    } else {
        if (flag != 0) { return _shbdk_bin_bad("binary deserialize error: an option flag is not 0 or 1"); }
    }
    if (_SHBDK_BIN_V >= 2) {
        if (_shbdk_bin_oob(off, 1, len) == 1) { return _shbdk_bin_truncated(); }
        flag = load8(buf + off);
        off = off + 1;
        if (flag == 1) {
            if (_shbdk_bin_oob(off, np, len) == 1) { return _shbdk_bin_truncated(); }
            var stress = _shbdk_vec_sized(np);
            var sdat = load64(stress);
            var sb = 0;
            i = 0;
            while (i < np) {
                sb = load8(buf + off);
                if (sb > 3) { return _shbdk_bin_bad("binary deserialize error: a stress value is not -1 to 2"); }
                store64(sdat + i * 8, sb - 1);
                off = off + 1;
                i = i + 1;
            }
            store64(pron + 24, stress);   # each value checked above, one per phoneme
        } else {
            if (flag != 0) { return _shbdk_bin_bad("binary deserialize error: an option flag is not 0 or 1"); }
        }
    }
    vec_push(prons, pron);
    return off;
}

fn _shbdk_bin_get_map(dict, buf, off, is_user, len): i64 {
    if (_shbdk_bin_oob(off, 4, len) == 1) { return _shbdk_bin_truncated(); }
    var n = _shbdk_bin_get_u32(buf, off);
    off = off + 4;
    var i = 0;
    var wlen = 0;
    var word = 0;
    var np = 0;
    var prons = 0;
    var j = 0;
    var entry = 0;
    while (i < n) {
        if (_shbdk_bin_oob(off, 2, len) == 1) { return _shbdk_bin_truncated(); }
        wlen = _shbdk_bin_get_u16(buf, off);
        off = off + 2;
        if (_shbdk_bin_oob(off, wlen, len) == 1) { return _shbdk_bin_truncated(); }
        if (_shbdk_bin_text_ok(buf + off, wlen) == 0) {
            return _shbdk_bin_bad("binary deserialize error: a word is not well-formed UTF-8, or holds a NUL");
        }
        word = _shbdk_bin_dup(buf, off, wlen);
        off = off + wlen;
        if (_shbdk_bin_oob(off, 2, len) == 1) { return _shbdk_bin_truncated(); }
        np = _shbdk_bin_get_u16(buf, off);
        off = off + 2;
        if (np == 0) { return _shbdk_bin_bad("binary deserialize error: an entry has no pronunciation"); }
        prons = vec_new();
        j = 0;
        while (j < np) {
            off = _shbdk_bin_get_pron(buf, off, prons, len);
            if (off < 0) { return (0 - 1); }
            j = j + 1;
        }
        entry = shbdk_dict_entry_from_pronunciations(prons);
        if (is_user == 1) {
            shbdk_dict_insert_user_entry(dict, word, entry);
        } else {
            shbdk_dict_insert_entry(dict, word, entry);
        }
        i = i + 1;
    }
    return off;
}

# Deserialize a PronunciationDict from a binary blob (a Str), or 0 on error with
# the reason in shbdk_last_error(): too short, bad magic, unsupported version, a
# field that overruns the blob, a value the format does not allow, or trailing
# bytes. A malformed blob decodes to 0, never to an OOB read or a bad value.
#must_use
fn shbdk_from_binary(data): i64 {
    shbdk_clear_error();
    if (data == 0) { return _shbdk_fail("no input"); }
    var buf = str_data(data);
    var len = str_len(data);
    if (len < SHBDK_BIN_HEADER) { return _shbdk_fail("binary data too short for header"); }
    if (load8(buf + 0) != SHBDK_BIN_MAGIC_S || load8(buf + 1) != SHBDK_BIN_MAGIC_H
      || load8(buf + 2) != SHBDK_BIN_MAGIC_B || load8(buf + 3) != SHBDK_BIN_MAGIC_D) {
        return _shbdk_fail("invalid magic number: not a shabdakosh binary dictionary");
    }
    var ver = load8(buf + 4);
    if (ver != SHBDK_BIN_VERSION_NO_STRESS && ver != SHBDK_BIN_VERSION) {
        return _shbdk_fail("unsupported binary format version (expected 1 or 2)");
    }
    _SHBDK_BIN_V = ver;
    var off = 5;
    var dict = shbdk_dict_new();
    if (_shbdk_bin_oob(off, 1, len) == 1) { _shbdk_bin_truncated(); return 0; }
    var flag = load8(buf + off);
    off = off + 1;
    if (flag == 1) {
        if (_shbdk_bin_oob(off, 2, len) == 1) { _shbdk_bin_truncated(); return 0; }
        var llen = _shbdk_bin_get_u16(buf, off);
        off = off + 2;
        if (_shbdk_bin_oob(off, llen, len) == 1) { _shbdk_bin_truncated(); return 0; }
        if (_shbdk_bin_text_ok(buf + off, llen) == 0) {
            return _shbdk_fail("binary deserialize error: the language is not well-formed UTF-8");
        }
        shbdk_dict_set_language(dict, _shbdk_bin_dup(buf, off, llen));
        off = off + llen;
    } else {
        if (flag != 0) { return _shbdk_fail("binary deserialize error: an option flag is not 0 or 1"); }
    }
    off = _shbdk_bin_get_map(dict, buf, off, 0, len);
    if (off < 0) { return 0; }
    off = _shbdk_bin_get_map(dict, buf, off, 1, len);
    if (off < 0) { return 0; }
    if (off != len) { return _shbdk_fail("binary deserialize error: trailing bytes after the dictionary"); }
    return dict;
}

# ---- file I/O ----------------------------------------------------------------
# Save a dict to a binary file. 0 on success, negative on error (shbdk_last_error()
# says why).
fn shbdk_save_binary_file(dict, path): i64 {
    var blob = shbdk_to_binary(dict);
    # 3.0.4: an empty blob means to_binary could not — never write a zero-byte
    # file that would silently decode to "no dictionary".
    if (str_len(blob) == 0) { return (0 - 1); }
    var n = file_write_all(path, str_data(blob), str_len(blob));
    if (n < 0) { _shbdk_fail("failed to write binary file"); return (0 - 1); }
    return 0;
}

# Load a dict from a binary file, or 0 on read / decode error (shbdk_last_error()
# says why). 3.1.3: no 8 MB ceiling; the buffer is sized to the file.
#must_use
fn shbdk_load_binary_file(path): i64 {
    shbdk_clear_error();
    var data = _shbdk_read_file_str(path);
    if (data == 0) { return 0; }
    return shbdk_from_binary(data);
}

# --- lazy.cyr ---

# lazy.cyr — lazy-loading dictionary (ports 3.1.3:rust-old/src/dictionary/lazy.rs).
#
# PARITY NOTE: Rust's LazyDict mmap'd the binary file but decoded it EAGERLY in
# open() (from_binary over the whole map), so every accessor read the owned dict
# and the map itself bought nothing observable. This port keeps the mmap path
# (MAXIMAL scope): open() maps the file read-only and decodes from the mapping,
# but falls back to a plain file_read_all load when mmap is unavailable (the AGNOS
# target — lib/mmap.cyr's cyr_mmap returns -1 there) or fails. Either way the
# decoded dict is byte-identical, and a "lazy dict" handle IS a plain dict handle
# usable with every shbdk_dict_* accessor (the Rust accessors just delegate to
# self.dict, so the shbdk_lazy_* methods below are 1:1 aliases).
#
# Requires (entry include order): dictionary/mod.cyr + dictionary/format/binary.cyr
# (shbdk_from_binary / shbdk_load_binary_file); mmap + syscalls (stdlib).
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# File size via lseek(fd, 0, SEEK_END). Returns the size, or negative on error.
#
# 3.0.4: was a raw `syscall(8, ...)`. #8 is lseek only on x86_64 Linux/macOS — on
# aarch64 Linux it is a different call entirely, and on AGNOS lseek is #58, so the
# mmap path silently misbehaved off x86_64. io.cyr's xlseek resolves SYS_LSEEK per
# target and is portable as written.
fn _shbdk_file_size(fd): i64 {
    return xlseek(fd, 0, 2);   # SEEK_END
}

# Open a binary dictionary file, mmap-backed with a file_read_all fallback.
# Returns a dict handle, or 0 on open / decode failure, with the reason in
# shbdk_last_error() (Rust Err(DictParseError(..))).
#must_use
fn shbdk_lazy_open(path): i64 {
    shbdk_clear_error();
    if (path == 0) { return _shbdk_fail("no path"); }
    var fd = file_open(path, 0, 0);           # O_RDONLY
    if (fd < 0) { return _shbdk_fail("failed to open file"); }
    var len = _shbdk_file_size(fd);
    if (len <= 0) { file_close(fd); return _shbdk_fail("binary data too short for header"); }
    # 3.1.3: no 8 MB ceiling (3.0.4 added one to match the other loaders, which have
    # dropped theirs): a file the saver wrote always opens. Decoding is linear in
    # the file and bounds-checked.
    var addr = mmap_file_ro(fd, len);         # 0 on failure (incl. AGNOS)
    file_close(fd);                           # the mapping outlives the fd
    if (addr == 0) {
        # mmap unavailable (AGNOS) or failed — fall back to a direct blob load.
        return shbdk_load_binary_file(path);
    }
    var dict = shbdk_from_binary(str_new(addr, len));
    cyr_munmap(addr, len);                    # eager decode done; unmap now
    return dict;                              # 0 if decode failed
}

# Look up a word's primary pronunciation (phoneme vec), or 0 if absent.
#must_use
fn shbdk_lazy_lookup(l, word): i64 { return shbdk_dict_lookup(l, word); }

# Look up a word's full entry, or 0 if absent.
#must_use
fn shbdk_lazy_lookup_entry(l, word): i64 { return shbdk_dict_lookup_entry(l, word); }

# Number of base entries.
#must_use
fn shbdk_lazy_len(l): i64 { return shbdk_dict_len(l); }

# Whether the dictionary is empty.
#must_use
fn shbdk_lazy_is_empty(l): i64 { return shbdk_dict_is_empty(l); }

# Borrow the underlying dict (Rust dict()); the handle already IS the dict.
#must_use
fn shbdk_lazy_dict(l): i64 { return l; }

# Consume the lazy dict, yielding the owned dict (Rust into_dict()); identity —
# releasing the mmap already happened in open().
#must_use
fn shbdk_lazy_into_dict(l): i64 { return l; }

# Debug string: "LazyDict { entries: N, user_entries: M }" (Rust Debug impl).
#must_use
fn shbdk_lazy_debug(l): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "LazyDict { entries: ");
    str_builder_add_int(sb, shbdk_dict_len(l));
    str_builder_add_cstr(sb, ", user_entries: ");
    str_builder_add_int(sb, shbdk_dict_user_len(l));
    str_builder_add_cstr(sb, " }");
    return str_data(str_builder_build(sb));
}

# --- detect.cyr ---

# detect.cyr — script + language detection (ports 3.1.3:rust-old/src/dictionary/detect.rs).
#
# Matches a word's Unicode code points against varna's script ranges (majority
# vote), then suggests languages registered for the winning script. Pure-function
# module — no types, no serde. varna is unconditionally linked here (the Rust
# `varna` feature gate is dropped); its symbols are bare (script_*/registry_*).
#
# CYRIUS strings are cstr byte pointers, so words decode through error.cyr's strict
# shbdk_utf8_decode (Rust got char scalars free from `str::chars()`).
#
# 3.1.3: the old local decoder read ill-formed UTF-8 as real code points (a lone
# 0xF0 as U+00F0, so "Latn"; 0xC3 0x28 as one letter that swallowed the "(").
# Ill-formed bytes now decode as U+FFFD, which is in no script, and never consume
# the byte after them.
#
# Requires: lib/varna.cyr (script_*/registry_*) and src/error.cyr (shbdk_cstrcmp,
# shbdk_utf8_decode).
# NAMING: shbdk_/SHBDK_ prefixes.

# Decode a word's UTF-8 code points into a fresh vec of scalars.
#
# 3.0.4: detect_script tests the word against every varna script, and this used to
# be done by re-walking the raw bytes per script AND heap-allocating an 8-byte
# out-cell per walk — 19 decodes and 19 never-freed cells per detect_script call.
# Decoding once up front makes it 1 decode and 0 heap cells (the out-cell is a
# stack slot now).
fn _shbdk_decode_cps(word): i64 {
    var out = vec_new();
    var cp[8];
    var n = strlen(word);
    var i = 0;
    while (i < n) {
        i = i + shbdk_utf8_decode(word, i, n, &cp);
        vec_push(out, load64(&cp));
    }
    return out;
}

# Count how many of the pre-decoded code points fall inside a varna script's ranges.
fn _shbdk_count_cp_in_script(cps, script): i64 {
    var cnt = 0;
    var n = vec_len(cps);
    var i = 0;
    while (i < n) {
        if (script_contains_codepoint(script, vec_get(cps, i)) == 1) { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

# Membership test: is cstring s present in a vec of cstrings?
fn _shbdk_vec_has_cstr(v, s): i64 {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# In-place ascending insertion sort of a vec of cstrings (matches Rust
# Vec::sort_unstable() lexicographic order for the ASCII language codes).
#
# Deliberately NOT mod.cyr's shared merge sort (unlike the dictionary-scale sorts
# converted in 3.0.4): this module is self-contained by design — it needs only
# varna, and tests/detect.tcyr links it without dictionary/mod.cyr. The input is
# the registry language codes for one script (a handful), so O(n^2) is free here.
fn _shbdk_sort_cstrs(v): i64 {
    var n = vec_len(v);
    var i = 1;
    var j = 0;
    var key = 0;
    var placed = 0;
    while (i < n) {
        key = vec_get(v, i);
        j = i - 1;
        placed = 0;
        while (j >= 0 && placed == 0) {
            if (shbdk_cstrcmp(vec_get(v, j), key) == 1) {
                vec_set(v, j + 1, vec_get(v, j));
                j = j - 1;
            } else {
                placed = 1;
            }
        }
        vec_set(v, j + 1, key);
        i = i + 1;
    }
    return 0;
}

# Detect the ISO 15924 script of a word by majority vote over its code points, or
# 0 if none match. Historical scripts (Xsux/Egyp) are skipped; ties keep the
# earlier code (script_all_codes order); strict-greater update. (Rust detect_script)
#
# Han mixed with kana or Hangul (3.1.4): Han is shared by Chinese, Japanese
# and Korean, while kana writes only Japanese and Hangul only Korean. So a word
# whose vote Han wins (or ties) but which holds any kana reports the kana script,
# and one holding Hangul reports Hangul: ISO 15924 calls such writing Jpan (Han +
# kana) and Kore (Han + Hangul). The Rust's plain vote made ひら漢字 (two kana, two
# kanji) Han, so its language hints were Chinese only.
#must_use
fn shbdk_detect_script(word): cstring {
    var cps = _shbdk_decode_cps(word);
    if (vec_len(cps) == 0) { return 0; }   # empty word matches no script
    var codes = script_all_codes();
    var n = vec_len(codes);
    var best = 0;
    var best_cnt = 0;
    var i = 0;
    var code = 0;
    var script = 0;
    var cnt = 0;
    var kana = 0;
    var kana_cnt = 0;
    var hang = 0;
    var hang_cnt = 0;
    while (i < n) {
        code = vec_get(codes, i);
        i = i + 1;
        if (streq(code, "Xsux") == 1) { continue; }
        if (streq(code, "Egyp") == 1) { continue; }
        script = script_by_code(code);
        if (script == 0) { continue; }
        cnt = _shbdk_count_cp_in_script(cps, script);
        if (streq(code, "Kana") == 1) { kana = code; kana_cnt = cnt; }
        if (streq(code, "Hang") == 1) { hang = code; hang_cnt = cnt; }
        if (cnt > best_cnt) {
            best_cnt = cnt;
            best = code;
        }
    }
    if (best_cnt == 0) { return 0; }
    if (streq(best, "Hani") == 1) {
        # the script that names the language wins over the shared one
        if (kana_cnt > 0 && kana_cnt >= hang_cnt) { return kana; }
        if (hang_cnt > 0) { return hang; }
    }
    return best;
}

# Suggest candidate ISO 639 language codes for a word: all registry languages
# using the detected script, sorted ascending. Empty vec if no script detected.
# (Rust detect_language_hint)
#must_use
fn shbdk_detect_language_hint(word): i64 {
    var out = vec_new();
    var sc = shbdk_detect_script(word);
    if (sc == 0) { return out; }
    var langs = registry_languages();
    var n = vec_len(langs);
    var i = 0;
    var li = 0;
    while (i < n) {
        li = vec_get(langs, i);
        if (_shbdk_vec_has_cstr(registry_info_scripts(li), sc) == 1) {
            vec_push(out, registry_info_code(li));
        }
        i = i + 1;
    }
    _shbdk_sort_cstrs(out);
    return out;
}

# Detect script and return its (code, name) via out-params; returns 1 on success,
# 0 if no script detected. Both out values are static cstrings. (Rust detect_script_name)
#must_use
fn shbdk_detect_script_name(word, out_code, out_name): i64 {
    var code = shbdk_detect_script(word);
    if (code == 0) { return 0; }
    var script = script_by_code(code);
    if (script == 0) { return 0; }
    store64(out_code, code);
    store64(out_name, script_name(script));
    return 1;
}

# --- validate.cyr ---

# validate.cyr — dictionary validation against varna phoneme inventories +
# phonotactics (ports 3.1.3:rust-old/src/dictionary/validate.rs).
#
# Two validators: validate_inventory (every entry's phonemes must exist in a
# language's varna PhonemeInventory, with length-mark and affricate-tie
# normalization) and validate_phonotactics (each pronunciation syllabified, then
# its onsets / nuclei / codas / syllable boundaries checked against the profile's
# Forbidden constraints and its onset / coda size limits).
# Four report structs, each with a hand-written bayan JSON codec (String/Vec
# fields → not #derive; mirrors format/json.cyr). varna is unconditionally linked
# (the Rust `varna` feature gate is dropped).
#
# Requires: lib/varna.cyr (phoneme_*/phonotactics_*/registry_*), src/ipa.cyr
# (shbdk_phoneme_to_ipa), dictionary/syllable.cyr (shbdk_syllabify),
# dictionary/entry.cyr + mod.cyr, bayan json_v_*.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- small helpers -----------------------------------------------------------
# Owned NUL-terminated copy of a cstring (Rust String::from).
fn _shbdk_dupz(s): cstring {
    return shbdk_copyz(s, strlen(s));
}

# Is int x present in a vec of ints?
fn _shbdk_vec_has_int(v, x): i64 {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (vec_get(v, i) == x) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Concatenate two cstrings into a fresh cstring.
fn _shbdk_concat2(a, b): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}

# ---- report structs: constructors + accessors --------------------------------
# ShbdkInvalidEntry (16B): [0]=word cstr, [8]=invalid_phonemes vec<i64>.
#must_use
fn shbdk_invalid_entry_new(word, invalid_phonemes): i64 {
    var e = alloc(16);
    store64(e + 0, _shbdk_dupz(word));
    store64(e + 8, invalid_phonemes);
    return e;
}
# The word with invalid phonemes.
#must_use
fn shbdk_invalid_entry_word(e): cstring { return load64(e + 0); }
# Phonemes not found in the target language's inventory (vec).
#must_use
fn shbdk_invalid_entry_invalid_phonemes(e): i64 { return load64(e + 8); }

# ShbdkValidationReport (16B): [0]=language cstr, [8]=invalid_entries vec<ShbdkInvalidEntry*>.
#must_use
fn shbdk_validation_report_new(language, invalid_entries): i64 {
    var r = alloc(16);
    store64(r + 0, _shbdk_dupz(language));
    store64(r + 8, invalid_entries);
    return r;
}
# Language code of the inventory used for validation.
#must_use
fn shbdk_validation_report_language(r): cstring { return load64(r + 0); }
# Entries containing phonemes outside the inventory (vec of ShbdkInvalidEntry).
#must_use
fn shbdk_validation_report_invalid_entries(r): i64 { return load64(r + 8); }
# 1 if all entries passed validation, else 0.
#must_use
fn shbdk_validation_report_is_valid(r): i64 {
    if (vec_len(load64(r + 8)) == 0) { return 1; }
    return 0;
}
# Number of entries with invalid phonemes.
#must_use
fn shbdk_validation_report_invalid_count(r): i64 { return vec_len(load64(r + 8)); }

# ShbdkPhonotacticViolation (24B): [0]=word, [8]=description, [16]=sequence (all cstr).
#must_use
fn shbdk_phonotactic_violation_new(word, description, sequence): i64 {
    var v = alloc(24);
    store64(v + 0, _shbdk_dupz(word));
    store64(v + 8, _shbdk_dupz(description));
    store64(v + 16, _shbdk_dupz(sequence));
    return v;
}
# The word containing the violation.
#must_use
fn shbdk_phonotactic_violation_word(v): cstring { return load64(v + 0); }
# Description of the violation.
#must_use
fn shbdk_phonotactic_violation_description(v): cstring { return load64(v + 8); }
# The IPA sequence that violated phonotactic constraints.
#must_use
fn shbdk_phonotactic_violation_sequence(v): cstring { return load64(v + 16); }

# ShbdkPhonotacticReport (16B): [0]=language cstr, [8]=violations vec<ShbdkPhonotacticViolation*>.
#must_use
fn shbdk_phonotactic_report_new(language, violations): i64 {
    var r = alloc(16);
    store64(r + 0, _shbdk_dupz(language));
    store64(r + 8, violations);
    return r;
}
# Language code of the phonotactic profile used.
#must_use
fn shbdk_phonotactic_report_language(r): cstring { return load64(r + 0); }
# Violations found (vec of ShbdkPhonotacticViolation).
#must_use
fn shbdk_phonotactic_report_violations(r): i64 { return load64(r + 8); }
# 1 if no violations were found, else 0.
#must_use
fn shbdk_phonotactic_report_is_valid(r): i64 {
    if (vec_len(load64(r + 8)) == 0) { return 1; }
    return 0;
}
# Number of violations found.
#must_use
fn shbdk_phonotactic_report_violation_count(r): i64 { return vec_len(load64(r + 8)); }

# Comparator for records carrying their `word` cstr at byte offset 0
# (ShbdkInvalidEntry / ShbdkPhonotacticViolation): 1 if a <= b by word.
fn _shbdk_word_rec_le(a, b): i64 {
    if (shbdk_cstrcmp(load64(a), load64(b)) == 1) { return 0; }
    return 1;
}

# In-place STABLE ascending sort of a vec whose elements carry their `word` cstr
# at byte offset 0. 3.0.4: was an O(n^2) insertion sort — validating the built-in
# English dict against a foreign inventory yields thousands of records, so it now
# shares mod.cyr's merge sort (same stable ordering, O(n log n)).
fn _shbdk_sort_by_word(v): i64 {
    return _shbdk_msort(v, &_shbdk_word_rec_le);
}

# ---- inventory validation ----------------------------------------------------
# `ipa` with every tie bar (U+0361, bytes 0xCD 0xA1) removed, or 0 if it has none.
fn _shbdk_strip_tie(ipa): cstring {
    var n = strlen(ipa);
    var out = alloc(n + 1);
    if (out == 0) { return 0; }
    var i = 0;
    var o = 0;
    var found = 0;
    while (i < n) {
        if (i + 1 < n && load8(ipa + i) == 205 && load8(ipa + i + 1) == 161) {
            found = 1;
            i = i + 2;
        } else {
            store8(out + o, load8(ipa + i));
            o = o + 1;
            i = i + 1;
        }
    }
    store8(out + o, 0);
    if (found == 0) { return 0; }
    return out;
}

# `ipa` as a tied affricate (first code point + U+0361 + the rest) when it is a
# bare two-code-point stop + fricative like "tʃ", else 0.
fn _shbdk_add_tie(ipa): cstring {
    var n = strlen(ipa);
    if (n < 2 || load8(ipa) >= 128) { return 0; }
    var cpb[8];
    if (shbdk_utf8_decode(ipa, 1, n, &cpb) != n - 1) { return 0; }   # exactly two code points
    var sb = str_builder_new();
    str_builder_add_byte(sb, load8(ipa));
    str_builder_add_cstr(sb, "͡");
    str_builder_add_cstr(sb, ipa + 1);
    return str_data(str_builder_build(sb));
}

# Membership with length-mark normalization: exact, then +ː, then strip trailing
# ː (U+02D0 = bytes 0xCB 0x90), as Rust's inventory_has_normalized; then (3.1.3) the
# affricate tie bar either way, so t͡ʃ and tʃ are one phoneme. The port wrote bare
# tʃ / dʒ while varna lists t͡ʃ / d͡ʒ, which flagged 1,070 English entries.
fn _shbdk_inventory_has_normalized(inv, ipa): i64 {
    if (_shbdk_inventory_has_len(inv, ipa) == 1) { return 1; }
    var alt = _shbdk_strip_tie(ipa);
    if (alt != 0) { if (_shbdk_inventory_has_len(inv, alt) == 1) { return 1; } }
    alt = _shbdk_add_tie(ipa);
    if (alt != 0) { if (_shbdk_inventory_has_len(inv, alt) == 1) { return 1; } }
    return 0;
}

# The length-mark half of _shbdk_inventory_has_normalized.
fn _shbdk_inventory_has_len(inv, ipa): i64 {
    var sb = 0;
    var with_long = 0;
    var n = 0;
    var base = 0;
    var i = 0;
    if (phoneme_has(inv, ipa) == 1) { return 1; }
    sb = str_builder_new();
    str_builder_add_cstr(sb, ipa);
    str_builder_add_cstr(sb, "ː");
    with_long = str_data(str_builder_build(sb));
    if (phoneme_has(inv, with_long) == 1) { return 1; }
    n = strlen(ipa);
    if (n >= 2) {
        if (load8(ipa + n - 2) == 203) {
            if (load8(ipa + n - 1) == 144) {
                base = alloc(n - 1);
                i = 0;
                while (i < n - 2) {
                    store8(base + i, load8(ipa + i));
                    i = i + 1;
                }
                store8(base + n - 2, 0);
                if (phoneme_has(inv, base) == 1) { return 1; }
            }
        }
    }
    return 0;
}

# Check one entry against an inventory; returns a ShbdkInvalidEntry* if it has any
# phonemes outside the inventory (deduped), else 0. Phonemes with no IPA are
# silently skipped (Rust if let Some(ipa)).
fn _shbdk_check_entry(word, entry, inventory): i64 {
    var invalid_ph = vec_new();
    var prons = shbdk_dict_entry_all(entry);
    var np = vec_len(prons);
    var i = 0;
    var phon = 0;
    var m = 0;
    var jj = 0;
    var ph = 0;
    var ipa = 0;
    while (i < np) {
        phon = shbdk_pronunciation_phonemes(vec_get(prons, i));
        m = vec_len(phon);
        jj = 0;
        while (jj < m) {
            ph = vec_get(phon, jj);
            ipa = shbdk_phoneme_to_ipa(ph);
            if (ipa != 0) {
                if (_shbdk_inventory_has_normalized(inventory, ipa) == 0) {
                    if (_shbdk_vec_has_int(invalid_ph, ph) == 0) {
                        vec_push(invalid_ph, ph);
                    }
                }
            }
            jj = jj + 1;
        }
        i = i + 1;
    }
    if (vec_len(invalid_ph) == 0) { return 0; }
    return shbdk_invalid_entry_new(word, invalid_ph);
}

fn _shbdk_validate_collect(inventory, map, out): i64 {
    var keys = map_keys(map);
    var n = vec_len(keys);
    var i = 0;
    var wk = 0;
    var ie = 0;
    while (i < n) {
        wk = vec_get(keys, i);
        # str_cstr, NOT str_data: base-dict keys are Str views into the packed
        # _cmudict_data pieces and are NOT NUL-terminated (see mod.cyr).
        ie = _shbdk_check_entry(str_cstr(wk), map_get(map, wk), inventory);
        if (ie != 0) { vec_push(out, ie); }
        i = i + 1;
    }
    return 0;
}

# Validate every base + user entry against a varna PhonemeInventory; returns a
# ShbdkValidationReport (entries sorted by word). (Rust validate_inventory)
#must_use
fn shbdk_validate_inventory(dict, inventory): i64 {
    var invalid = vec_new();
    _shbdk_validate_collect(inventory, shbdk_dict_entries(dict), invalid);
    _shbdk_validate_collect(inventory, shbdk_dict_user_entries(dict), invalid);
    _shbdk_sort_by_word(invalid);
    return shbdk_validation_report_new(phoneme_language_code(inventory), invalid);
}

# ---- phonotactics validation -------------------------------------------------
# 3.1.3: rewritten for accuracy; the Rust and the port through 3.1.2 both
# (a) checked every ADJACENT PAIR of the word against the onset constraints, so
#     the English ban on onset /tl/ and /dl/ fired mid-word — all 182 violations
#     the built-in English dictionary produced ("abruptly", "deadline") were false;
# (b) could never fire a one-segment constraint (English's onset /ŋ/) or a
#     three-segment one, and ignored Nucleus and AcrossBoundary constraints;
# (c) held every consonant run to max_onset + max_coda, so a word-initial cluster
#     was never held to max_onset nor a word-final one to max_coda;
# (d) counted /iː/ and the extended vowels (y ø œ ɯ ɤ ɨ ʉ) as consonants.
# Now each pronunciation is syllabified (shbdk_syllabify, Maximal Onset), and each
# syllable's onset, nucleus and coda — and each coda + next onset pair — is checked
# against the constraints for that position: every contiguous run of segments in
# it is looked up, so one-, two- and three-segment constraints all apply. An onset
# longer than max_onset or a coda longer than max_coda is a violation. Silence is
# not a segment and is skipped.

# Is a phoneme a consonant? 0 for vowels, diphthongs and silence (by svara's class).
#must_use
fn _shbdk_is_consonant(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG || c == SVARA_CLASS_SILENCE) { return 0; }
    return 1;
}

# IPA of phonemes v[i..j) concatenated, or 0 if one of them has no IPA.
fn _shbdk_ipa_span(v, i, j): cstring {
    var sb = str_builder_new();
    var k = i;
    var s = 0;
    while (k < j) {
        s = shbdk_phoneme_to_ipa(vec_get(v, k));
        if (s == 0) { return 0; }
        str_builder_add_cstr(sb, s);
        k = k + 1;
    }
    return str_data(str_builder_build(sb));
}

fn _shbdk_position_name(position): cstring {
    if (position == SyllablePosition.Onset) { return "onset"; }
    if (position == SyllablePosition.Coda) { return "coda"; }
    if (position == SyllablePosition.Nucleus) { return "nucleus"; }
    return "cross-syllable";
}

# Push a violation for every contiguous run inside v[i..j) that the profile forbids
# at `position`. With `must_span` set (AcrossBoundary), only runs that cross the
# boundary at index `split` count.
fn _shbdk_check_runs(word, v, i, j, phonotactics, position, must_span, split, violations): i64 {
    var a = i;
    var b = 0;
    var seq = 0;
    var sb = 0;
    while (a < j) {
        b = a + 1;
        while (b <= j) {
            if (must_span == 0 || (a < split && b > split)) {
                seq = _shbdk_ipa_span(v, a, b);
                if (seq != 0 && phonotactics_is_permitted(phonotactics, seq, position) == 0) {
                    sb = str_builder_new();
                    str_builder_add_cstr(sb, "forbidden ");
                    str_builder_add_cstr(sb, _shbdk_position_name(position));
                    str_builder_add_cstr(sb, " sequence '");
                    str_builder_add_cstr(sb, seq);
                    str_builder_add_cstr(sb, "'");
                    vec_push(violations, shbdk_phonotactic_violation_new(word, str_data(str_builder_build(sb)), seq));
                }
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return 0;
}

# Push a violation if v[i..j) (an onset or a coda) is longer than `limit`.
fn _shbdk_check_size(word, v, i, j, limit, what, violations): i64 {
    if (j - i <= limit) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " of ");
    str_builder_add_int(sb, j - i);
    str_builder_add_cstr(sb, " consonants exceeds max ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " (");
    str_builder_add_int(sb, limit);
    str_builder_add_cstr(sb, ")");
    var seq = _shbdk_ipa_span(v, i, j);
    if (seq == 0) { seq = ""; }
    vec_push(violations, shbdk_phonotactic_violation_new(word, str_data(str_builder_build(sb)), seq));
    return 0;
}

# Check one pronunciation's phonemes against a phonotactics profile, pushing any
# violations. (Rust check_pronunciation, made syllable-aware in 3.1.3.)
fn _shbdk_check_pronunciation(word, phonemes, phonotactics, violations): i64 {
    # silence is not a segment
    var v = vec_new();
    var n = vec_len(phonemes);
    var i = 0;
    while (i < n) {
        if (vec_get(phonemes, i) != SVARA_PH_SILENCE) { vec_push(v, vec_get(phonemes, i)); }
        i = i + 1;
    }
    var syl = shbdk_syllabify(v);
    var ns = vec_len(syl);
    var max_onset = phonotactics_max_onset(phonotactics);
    var max_coda = phonotactics_max_coda(phonotactics);
    # walk the syllables over `v`, tracking each one's onset / nucleus / coda span
    var at = 0;
    var k = 0;
    var len = 0;
    var nuc = 0;
    var cend = 0;
    var prev_coda_start = 0 - 1;
    var prev_coda_end = 0;
    while (k < ns) {
        len = shbdk_syllable_len(vec_get(syl, k));
        nuc = at;
        while (nuc < at + len && _shbdk_is_consonant(vec_get(v, nuc)) == 1) { nuc = nuc + 1; }
        cend = at + len;
        if (nuc == at + len) {
            # no nucleus: the whole syllable is a consonant cluster, held as an onset
            _shbdk_check_runs(word, v, at, nuc, phonotactics, SyllablePosition.Onset, 0, 0, violations);
            _shbdk_check_size(word, v, at, nuc, max_onset, "onset", violations);
        } else {
            _shbdk_check_runs(word, v, at, nuc, phonotactics, SyllablePosition.Onset, 0, 0, violations);
            _shbdk_check_size(word, v, at, nuc, max_onset, "onset", violations);
            _shbdk_check_runs(word, v, nuc, nuc + 1, phonotactics, SyllablePosition.Nucleus, 0, 0, violations);
            _shbdk_check_runs(word, v, nuc + 1, cend, phonotactics, SyllablePosition.Coda, 0, 0, violations);
            _shbdk_check_size(word, v, nuc + 1, cend, max_coda, "coda", violations);
            if (prev_coda_start >= 0 && (prev_coda_end > prev_coda_start || nuc > at)) {
                _shbdk_check_runs(word, v, prev_coda_start, nuc, phonotactics, SyllablePosition.AcrossBoundary,
                  1, prev_coda_end, violations);
            }
            prev_coda_start = nuc + 1;
            prev_coda_end = cend;
        }
        at = at + len;
        k = k + 1;
    }
    return 0;
}

fn _shbdk_phono_collect(phonotactics, map, out): i64 {
    var keys = map_keys(map);
    var n = vec_len(keys);
    var i = 0;
    var wk = 0;
    var prons = 0;
    var np = 0;
    var j = 0;
    var phs = 0;
    var wcstr = 0;
    while (i < n) {
        wk = vec_get(keys, i);
        # str_cstr, NOT str_data: base-dict keys are Str views into the packed
        # _cmudict_data pieces and are NOT NUL-terminated (see mod.cyr). Hoisted
        # out of the per-pronunciation loop — one copy per word, not per variant.
        wcstr = str_cstr(wk);
        prons = shbdk_dict_entry_all(map_get(map, wk));
        np = vec_len(prons);
        j = 0;
        while (j < np) {
            phs = shbdk_pronunciation_phonemes(vec_get(prons, j));
            _shbdk_check_pronunciation(wcstr, phs, phonotactics, out);
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Validate every base + user pronunciation against a varna Phonotactics profile;
# returns a ShbdkPhonotacticReport (violations sorted by word). (Rust validate_phonotactics)
#must_use
fn shbdk_validate_phonotactics(dict, phonotactics): i64 {
    var violations = vec_new();
    _shbdk_phono_collect(phonotactics, shbdk_dict_entries(dict), violations);
    _shbdk_phono_collect(phonotactics, shbdk_dict_user_entries(dict), violations);
    _shbdk_sort_by_word(violations);
    return shbdk_phonotactic_report_new(phonotactics_language_code(phonotactics), violations);
}

# ---- convenience methods (dict.language -> pick inventory / profile) ----------
# The primary subtag of a BCP 47 code ("pt-BR" -> "pt", "en_US" -> "en"), or 0
# when the code has none.
fn _shbdk_lang_primary(code): cstring {
    var n = 0;
    while (load8(code + n) != 0 && load8(code + n) != 45 && load8(code + n) != 95) { n = n + 1; }
    if (load8(code + n) == 0) { return 0; }
    return shbdk_copyz(code, n);
}

# Validate against the dict's language inventory (registry_phonemes), or 0 (None)
# if the dict has no language or varna has no inventory for it. A regional code
# ("pt-BR") uses its own inventory when varna has one, else its language's (3.1.3).
# (Rust PronunciationDict::validate)
#must_use
fn shbdk_dict_validate(dict): i64 {
    var code = shbdk_dict_language(dict);
    if (code == 0) { return 0; }
    var inventory = registry_phonemes(code);
    if (inventory == 0) {
        var base = _shbdk_lang_primary(code);
        if (base != 0) { inventory = registry_phonemes(base); }
    }
    if (inventory == 0) { return 0; }
    return shbdk_validate_inventory(dict, inventory);
}

# Validate against the dict language's phonotactics profile, or 0 (None) when
# varna has none for it. 3.1.3: every language varna profiles (en ar zh hi ja es fr
# de ru ko pt sa) — the Rust's (and the port's) only knew en / sa / ja. A regional
# code uses its language's profile. (Rust PronunciationDict::validate_phonotactics)
#must_use
fn shbdk_dict_validate_phonotactics(dict): i64 {
    var code = shbdk_dict_language(dict);
    if (code == 0) { return 0; }
    var phono = phonotactics_by_code(code);
    if (phono == 0) {
        var base = _shbdk_lang_primary(code);
        if (base != 0) { phono = phonotactics_by_code(base); }
    }
    if (phono == 0) { return 0; }
    return shbdk_validate_phonotactics(dict, phono);
}

# ---- JSON codecs (hand-written, bayan DOM; mirrors format/json.cyr) -----------
fn _shbdk_invalid_entry_to_jsonv(e): i64 {
    var obj = json_v_obj_new();
    var arr = json_v_arr_new();
    var ph = shbdk_invalid_entry_invalid_phonemes(e);
    var n = vec_len(ph);
    var i = 0;
    json_v_obj_set(obj, str_from("word"), json_v_str_new(str_from(shbdk_invalid_entry_word(e))));
    while (i < n) {
        json_v_arr_push(arr, json_v_int_new(vec_get(ph, i)));
        i = i + 1;
    }
    json_v_obj_set(obj, str_from("invalid_phonemes"), arr);
    return obj;
}

# 3.1.3: the report readers check the schema, as serde did, instead of defaulting a
# missing or wrong-typed field ("Bogus" read as phoneme 0, a missing word as "").
# A failure returns 0 with the reason in shbdk_last_error().

# The string field `key` of `obj` as a cstr, or 0 (reason recorded) if it is
# missing or not a string.
fn _shbdk_json_field_str(obj, key): cstring {
    var v = bayan_json_v_obj_get_by_cstr(obj, key);
    if (v == 0 || json_v_is_str(v) == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "JSON parse error: \"");
        str_builder_add_cstr(sb, key);
        str_builder_add_cstr(sb, "\" must be a string");
        return _shbdk_fail(str_data(str_builder_build(sb)));
    }
    return str_cstr(json_v_str(v));
}

# The array field `key` of `obj`, or 0 (reason recorded).
fn _shbdk_json_field_arr(obj, key): i64 {
    var v = bayan_json_v_obj_get_by_cstr(obj, key);
    if (v == 0 || json_v_is_arr(v) == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "JSON parse error: \"");
        str_builder_add_cstr(sb, key);
        str_builder_add_cstr(sb, "\" must be an array");
        return _shbdk_fail(str_data(str_builder_build(sb)));
    }
    return v;
}

# A ShbdkInvalidEntry from a parsed JSON object (bayan DOM node), or 0 with the reason recorded.
#must_use
fn shbdk_invalid_entry_from_jsonv(obj): i64 {
    if (json_v_is_obj(obj) == 0) { return _shbdk_fail("JSON parse error: an invalid entry must be an object"); }
    var word = _shbdk_json_field_str(obj, "word");
    if (word == 0) { return 0; }
    var arr = _shbdk_json_field_arr(obj, "invalid_phonemes");
    if (arr == 0) { return 0; }
    var ph = vec_new();
    var n = json_v_arr_len(arr);
    var i = 0;
    var el = 0;
    while (i < n) {
        el = json_v_arr_get(arr, i);
        if (json_v_is_int(el) == 0 || json_v_int(el) < 0 || json_v_int(el) > 100) {
            return _shbdk_fail("JSON parse error: an invalid phoneme must be a svara phoneme (0-100)");
        }
        vec_push(ph, json_v_int(el));
        i = i + 1;
    }
    return shbdk_invalid_entry_new(word, ph);
}

# Serialize a ShbdkValidationReport to JSON. (serde roundtrip)
#must_use
fn shbdk_validation_report_to_json(r): cstring {
    var root = json_v_obj_new();
    var arr = json_v_arr_new();
    var ie = shbdk_validation_report_invalid_entries(r);
    var n = vec_len(ie);
    var i = 0;
    json_v_obj_set(root, str_from("language"), json_v_str_new(str_from(shbdk_validation_report_language(r))));
    while (i < n) {
        json_v_arr_push(arr, _shbdk_invalid_entry_to_jsonv(vec_get(ie, i)));
        i = i + 1;
    }
    json_v_obj_set(root, str_from("invalid_entries"), arr);
    return str_data(json_v_build(root));
}

# Deserialize a ShbdkValidationReport from JSON, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_validation_report_from_json(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    if (json_v_is_obj(root) == 0) { return _shbdk_fail("JSON parse error: the document must be an object"); }
    var lang = _shbdk_json_field_str(root, "language");
    if (lang == 0) { return 0; }
    var arr = _shbdk_json_field_arr(root, "invalid_entries");
    if (arr == 0) { return 0; }
    var ie = vec_new();
    var n = json_v_arr_len(arr);
    var i = 0;
    var e = 0;
    while (i < n) {
        e = shbdk_invalid_entry_from_jsonv(json_v_arr_get(arr, i));
        if (e == 0) { return 0; }
        vec_push(ie, e);
        i = i + 1;
    }
    return shbdk_validation_report_new(lang, ie);
}

fn _shbdk_phonotactic_violation_to_jsonv(v): i64 {
    var obj = json_v_obj_new();
    json_v_obj_set(obj, str_from("word"), json_v_str_new(str_from(shbdk_phonotactic_violation_word(v))));
    json_v_obj_set(obj, str_from("description"), json_v_str_new(str_from(shbdk_phonotactic_violation_description(v))));
    json_v_obj_set(obj, str_from("sequence"), json_v_str_new(str_from(shbdk_phonotactic_violation_sequence(v))));
    return obj;
}

# A ShbdkPhonotacticViolation from a parsed JSON object, or 0 with the reason recorded.
#must_use
fn shbdk_phonotactic_violation_from_jsonv(obj): i64 {
    if (json_v_is_obj(obj) == 0) { return _shbdk_fail("JSON parse error: a violation must be an object"); }
    var word = _shbdk_json_field_str(obj, "word");
    if (word == 0) { return 0; }
    var desc = _shbdk_json_field_str(obj, "description");
    if (desc == 0) { return 0; }
    var seq = _shbdk_json_field_str(obj, "sequence");
    if (seq == 0) { return 0; }
    return shbdk_phonotactic_violation_new(word, desc, seq);
}

# Serialize a ShbdkPhonotacticReport to JSON. (serde roundtrip)
#must_use
fn shbdk_phonotactic_report_to_json(r): cstring {
    var root = json_v_obj_new();
    var arr = json_v_arr_new();
    var vs = shbdk_phonotactic_report_violations(r);
    var n = vec_len(vs);
    var i = 0;
    json_v_obj_set(root, str_from("language"), json_v_str_new(str_from(shbdk_phonotactic_report_language(r))));
    while (i < n) {
        json_v_arr_push(arr, _shbdk_phonotactic_violation_to_jsonv(vec_get(vs, i)));
        i = i + 1;
    }
    json_v_obj_set(root, str_from("violations"), arr);
    return str_data(json_v_build(root));
}

# Deserialize a ShbdkPhonotacticReport from JSON, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_phonotactic_report_from_json(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    if (json_v_is_obj(root) == 0) { return _shbdk_fail("JSON parse error: the document must be an object"); }
    var lang = _shbdk_json_field_str(root, "language");
    if (lang == 0) { return 0; }
    var arr = _shbdk_json_field_arr(root, "violations");
    if (arr == 0) { return 0; }
    var vs = vec_new();
    var n = json_v_arr_len(arr);
    var i = 0;
    var v = 0;
    while (i < n) {
        v = shbdk_phonotactic_violation_from_jsonv(json_v_arr_get(arr, i));
        if (v == 0) { return 0; }
        vec_push(vs, v);
        i = i + 1;
    }
    return shbdk_phonotactic_report_new(lang, vs);
}

# ---- standalone record codecs + equality (the Rust derived Serialize, Deserialize
# and PartialEq on InvalidEntry and PhonotacticViolation, and PartialEq on the
# reports) -------------------------------------------------------------------
# InvalidEntry <-> JSON text {"word":..,"invalid_phonemes":[..]}.
#must_use
fn shbdk_invalid_entry_to_json(e): cstring { return str_data(json_v_build(_shbdk_invalid_entry_to_jsonv(e))); }
# JSON text -> a ShbdkInvalidEntry, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_invalid_entry_from_json(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    return shbdk_invalid_entry_from_jsonv(root);
}
# PhonotacticViolation <-> JSON text {"word":..,"description":..,"sequence":..}.
#must_use
fn shbdk_phonotactic_violation_to_json(v): cstring {
    return str_data(json_v_build(_shbdk_phonotactic_violation_to_jsonv(v)));
}
# JSON text -> a ShbdkPhonotacticViolation, or 0 (shbdk_last_error() says why).
#must_use
fn shbdk_phonotactic_violation_from_json(input): i64 {
    shbdk_clear_error();
    if (input == 0) { return _shbdk_fail("no input"); }
    var root = json_v_parse_buf(input, strlen(input));
    if (root == 0) { return _shbdk_fail("JSON parse error: not valid JSON"); }
    return shbdk_phonotactic_violation_from_jsonv(root);
}

# 1 if two invalid entries have the same word and the same phonemes in order.
#must_use
fn shbdk_invalid_entry_eq(a, b): i64 {
    if (streq(shbdk_invalid_entry_word(a), shbdk_invalid_entry_word(b)) == 0) { return 0; }
    var pa = shbdk_invalid_entry_invalid_phonemes(a);
    var pb = shbdk_invalid_entry_invalid_phonemes(b);
    if (vec_len(pa) != vec_len(pb)) { return 0; }
    var i = 0;
    while (i < vec_len(pa)) {
        if (vec_get(pa, i) != vec_get(pb, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}
# 1 if two validation reports have the same language and equal entries in order.
#must_use
fn shbdk_validation_report_eq(a, b): i64 {
    if (streq(shbdk_validation_report_language(a), shbdk_validation_report_language(b)) == 0) { return 0; }
    var ea = shbdk_validation_report_invalid_entries(a);
    var eb = shbdk_validation_report_invalid_entries(b);
    if (vec_len(ea) != vec_len(eb)) { return 0; }
    var i = 0;
    while (i < vec_len(ea)) {
        if (shbdk_invalid_entry_eq(vec_get(ea, i), vec_get(eb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}
# 1 if two violations have the same word, description and sequence.
#must_use
fn shbdk_phonotactic_violation_eq(a, b): i64 {
    if (streq(shbdk_phonotactic_violation_word(a), shbdk_phonotactic_violation_word(b)) == 0) { return 0; }
    if (streq(shbdk_phonotactic_violation_description(a),
        shbdk_phonotactic_violation_description(b)) == 0) { return 0; }
    if (streq(shbdk_phonotactic_violation_sequence(a), shbdk_phonotactic_violation_sequence(b)) == 0) { return 0; }
    return 1;
}
# 1 if two phonotactic reports have the same language and equal violations in order.
#must_use
fn shbdk_phonotactic_report_eq(a, b): i64 {
    if (streq(shbdk_phonotactic_report_language(a), shbdk_phonotactic_report_language(b)) == 0) { return 0; }
    var va = shbdk_phonotactic_report_violations(a);
    var vb = shbdk_phonotactic_report_violations(b);
    if (vec_len(va) != vec_len(vb)) { return 0; }
    var i = 0;
    while (i < vec_len(va)) {
        if (shbdk_phonotactic_violation_eq(vec_get(va, i), vec_get(vb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# --- lexicon.cyr ---

# lexicon.cyr — varna-lexicon dictionary constructors
# (ports 3.1.3:rust-old/src/dictionary/mod.rs from_lexicon / spanish / hindi / german / sanskrit).
#
# Builds a PronunciationDict from a varna lexicon: each entry's IPA is parsed to
# svara phonemes, its frequency rank (if any) becomes a 1/(1+rank) frequency, keyed
# by the lowercased native word (entries whose IPA doesn't parse are skipped, as in
# Rust). varna-gated — like detect/validate, it lives in its own module included
# after varna + ipa + mod (mod.cyr is included by non-varna tests, so these can't
# live there).
#
# Requires: lib/varna.cyr (lexicon_*/swadesh_*/lex_*), src/ipa.cyr (parse_ipa_word),
# dictionary/mod.cyr + entry.cyr; f64_from/f64_div (stdlib).
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# Build a dict from a varna Lexicon: IPA -> phonemes, frequency rank -> 1/(1+rank)
# frequency (none without a rank), lowercased native word as the key. (Rust from_lexicon)
#must_use
fn shbdk_from_lexicon(lexicon): i64 {
    var dict = shbdk_dict_new();
    var entries = lexicon_entries(lexicon);
    var n = vec_len(entries);
    var i = 0;
    var e = 0;
    var phon = 0;
    var pron = 0;
    var rank = 0;
    shbdk_dict_set_language(dict, lexicon_language_code(lexicon));
    while (i < n) {
        e = vec_get(entries, i);
        phon = shbdk_parse_ipa_word(swadesh_entry_ipa(e));
        if (vec_len(phon) > 0) {
            pron = shbdk_pronunciation_new(phon);
            # The frequency comes from the entry's frequency RANK (lower = more
            # common), as 1/(1+rank); an entry without one has no frequency.
            # 3.1.3: this read swadesh_index, a concept number, so every Swadesh word
            # got an invented 1/(1+index) and a ranked, unindexed entry got +inf.
            rank = lex_frequency_rank(e);
            if (rank >= 0) {
                pron = shbdk_pronunciation_with_frequency(pron, f64_div(f64_from(1), f64_from(1 + rank)));
            }
            shbdk_dict_insert_entry(dict, swadesh_entry_word(e), shbdk_dict_entry_new(pron));
        }
        i = i + 1;
    }
    return dict;
}

# Seed dict from varna's Swadesh list for a language code, or an empty
# language-tagged dict if the code has no Swadesh data (mirrors Rust's
# unwrap_or_else(empty Lexicon)).
fn _shbdk_dict_from_swadesh(code): i64 {
    var lex = swadesh_by_code(code);
    if (lex == 0) { return shbdk_dict_with_language(shbdk_dict_new(), code); }
    return shbdk_from_lexicon(lex);
}

# Seed Spanish dictionary from varna's Swadesh list (~core vocabulary). (Rust spanish)
#must_use
fn shbdk_dict_spanish(): i64 { return _shbdk_dict_from_swadesh("es"); }

# Seed Hindi dictionary from varna's Swadesh list. (Rust hindi)
#must_use
fn shbdk_dict_hindi(): i64 { return _shbdk_dict_from_swadesh("hi"); }

# Seed German dictionary from varna's Swadesh list. (Rust german)
#must_use
fn shbdk_dict_german(): i64 { return _shbdk_dict_from_swadesh("de"); }

# Seed Sanskrit dictionary — language-tagged, empty (no Swadesh data in varna). (Rust sanskrit)
#must_use
fn shbdk_dict_sanskrit(): i64 { return shbdk_dict_with_language(shbdk_dict_new(), "sa"); }

# --- wasm.cyr ---

# wasm.cyr — WebAssembly-facing dictionary bindings (ports 3.1.3:rust-old/src/wasm.rs).
#
# The Rust used wasm-bindgen to expose a JS-friendly WasmDict over
# PronunciationDict; phoneme arrays and reports cross the boundary as JSON
# strings. This is the faithful .cyr surface: a WasmDict handle wrapping an
# inner dict, with the same 12 methods. JSON is built with bayan (str_from on
# cstr keys/values, str_data on the built Str). How this surface is exposed to a
# browser is the toolchain's concern, not this module's.
#
# Included after coverage.cyr (coverage), trie.cyr (prefix_search), ipa.cyr
# (phoneme_to_ipa / parse_ipa_word), mod.cyr and entry.cyr. Uses bayan json_v_*.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- WasmDict handle: [inner dict] -------------------------------------------
fn _shbdk_wasm_inner(w): i64 { return load64(w + 0); }

fn _shbdk_wasm_wrap(dict): i64 {
    var w = alloc(8);
    store64(w + 0, dict);
    return w;
}

# Create a new empty WasmDict. (Rust WasmDict::new / Default)
#must_use
fn shbdk_wasm_dict_new(): i64 { return _shbdk_wasm_wrap(shbdk_dict_new()); }

# Built-in English dictionary (10,000+ entries). (Rust WasmDict::english)
#must_use
fn shbdk_wasm_dict_english(): i64 { return _shbdk_wasm_wrap(shbdk_dict_english()); }

# Minimal English dictionary (~29 entries). (Rust WasmDict::english_minimal)
#must_use
fn shbdk_wasm_dict_english_minimal(): i64 {
    return _shbdk_wasm_wrap(shbdk_dict_english_minimal());
}

# Number of base entries. (Rust WasmDict::len)
#must_use
fn shbdk_wasm_dict_len(w): i64 { return shbdk_dict_len(_shbdk_wasm_inner(w)); }

# Whether the dictionary is empty. (Rust WasmDict::is_empty)
#must_use
fn shbdk_wasm_dict_is_empty(w): i64 { return shbdk_dict_is_empty(_shbdk_wasm_inner(w)); }

# Look up a word; returns a JSON array of IPA strings (a cstr), or 0 (null) when
# the word is not found. Phonemes with no IPA equivalent are dropped (mirrors
# Rust's filter_map). (Rust WasmDict::lookup -> Option<String>)
#must_use
fn shbdk_wasm_dict_lookup(w, word): cstring {
    var phon = shbdk_dict_lookup(_shbdk_wasm_inner(w), word);
    if (phon == 0) { return 0; }
    var arr = json_v_arr_new();
    var n = vec_len(phon);
    var i = 0;
    var ip = 0;
    while (i < n) {
        ip = shbdk_phoneme_to_ipa(vec_get(phon, i));
        if (ip != 0) { json_v_arr_push(arr, json_v_str_new(str_from(ip))); }
        i = i + 1;
    }
    return str_data(json_v_build(arr));
}

# Number of pronunciation variants for a word (0 if not found).
# (Rust WasmDict::variant_count)
#must_use
fn shbdk_wasm_dict_variant_count(w, word): i64 {
    var e = shbdk_dict_lookup_entry(_shbdk_wasm_inner(w), word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_len(e);
}

# Insert a word into the user overlay from an IPA string (parsed to phonemes).
# No-op when the IPA parses to no phonemes. (Rust WasmDict::insert_user_ipa)
fn shbdk_wasm_dict_insert_user_ipa(w, word, ipa): i64 {
    var phon = shbdk_parse_ipa_word(ipa);
    if (vec_len(phon) > 0) {
        shbdk_dict_insert_user(_shbdk_wasm_inner(w), word, phon);
    }
    return 0;
}

# Remove a word from the user overlay; 1 if removed, else 0.
# (Rust WasmDict::remove_user)
fn shbdk_wasm_dict_remove_user(w, word): i64 {
    return shbdk_dict_remove_user(_shbdk_wasm_inner(w), word);
}

# Number of user overlay entries. (Rust WasmDict::user_len)
#must_use
fn shbdk_wasm_dict_user_len(w): i64 { return shbdk_dict_user_len(_shbdk_wasm_inner(w)); }

# Words matching a prefix, as a JSON array (a cstr). (Rust WasmDict::prefix_search)
#must_use
fn shbdk_wasm_dict_prefix_search(w, prefix): cstring {
    var results = shbdk_dict_prefix_search(_shbdk_wasm_inner(w), prefix);
    var arr = json_v_arr_new();
    var n = vec_len(results);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, json_v_str_new(vec_get(results, i)));
        i = i + 1;
    }
    return str_data(json_v_build(arr));
}

# Coverage analysis of a text, as a JSON object (a cstr):
# {"total_tokens":N,"covered_tokens":M,"uncovered_words":[...]}.
# (Rust WasmDict::coverage)
#must_use
fn shbdk_wasm_dict_coverage(w, text): cstring {
    var r = shbdk_dict_coverage(_shbdk_wasm_inner(w), text);
    var obj = json_v_obj_new();
    json_v_obj_set(obj, str_from("total_tokens"), json_v_int_new(shbdk_coverage_total_tokens(r)));
    json_v_obj_set(obj, str_from("covered_tokens"), json_v_int_new(shbdk_coverage_covered_tokens(r)));
    var arr = json_v_arr_new();
    var uw = shbdk_coverage_uncovered_words(r);
    var n = vec_len(uw);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, json_v_str_new(vec_get(uw, i)));
        i = i + 1;
    }
    json_v_obj_set(obj, str_from("uncovered_words"), arr);
    return str_data(json_v_build(obj));
}
