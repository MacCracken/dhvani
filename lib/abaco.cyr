    # Temperature
    reg_alias(r, "degc", "C");
    reg_alias(r, "degf", "F");
    reg_alias(r, "centigrade", "C");
    # Length (British singulars; the plural strip covers "metres" etc.)
    reg_alias(r, "metre", "m");
    reg_alias(r, "kilometre", "km");
    reg_alias(r, "centimetre", "cm");
    reg_alias(r, "millimetre", "mm");
