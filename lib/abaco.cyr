    reg_spelling(r, "g/ml", "g/mL");
    reg_spelling(r, "kg/l", "kg/L");
    reg_spelling(r, "cp", "cP");
    reg_spelling(r, "pas", "Pas");
    reg_spelling(r, "mpas", "mPas");
    # Tempo / audio
    reg_alias(r, "bpm", "bpm");
    reg_alias(r, "bpms", "bpm");
    reg_alias(r, "beats_per_min", "bpm");
    # Pitch
    reg_alias(r, "semitones", "semi");
