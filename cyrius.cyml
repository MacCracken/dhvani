[package]
name = "dhvani"
version = "${file:VERSION}"
description = "dhvani — core audio engine (buffers, format conversion, mixing, resampling, DSP, analysis, MIDI, graph, synthesis, capture). Cyrius port of a 23,695-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/dhvani"
language = "cyrius"
cyrius = "6.5.41"

[build]
entry = "src/main.cyr"
output = "build/dhvani"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/dhvani.cyr` — every ported module concatenated in dependency order
# (deps before dependents), each self-contained (no `include` lines), sharing
# one flat namespace. Order = the L0→L4 topological layering in
# docs/development/port-audit.md. The bundle EXTERNALIZES abaco + the synthesis
# siblings (naad/svara/…): the Wave F wrappers reference their bare symbols, and
# a consumer supplies those bundles (in dep order) alongside dist/dhvani.cyr —
# unused feature refs DCE-prune. Do NOT edit dist/dhvani.cyr; rebuild with distlib.
[lib]
modules = [
    # L0 — error base + error-only leaves
    "src/error.cyr",
    "src/simd.cyr",
    "src/clock.cyr",
    "src/oscillator.cyr",
    "src/gain_smoother.cyr",
    "src/envelope.cyr",
    "src/lfo.cyr",
    "src/automation.cyr",
    "src/midi.cyr",
    "src/voice.cyr",
    "src/capture.cyr",
    "src/record.cyr",
    # L1 — buffer + its dependents
    "src/buffer.cyr",
    "src/convert.cyr",
    "src/dither.cyr",
    "src/resample.cyr",
    "src/waveform.cyr",
    "src/zcr.cyr",
    "src/pan.cyr",
    "src/svf.cyr",
    "src/biquad.cyr",
    "src/routing.cyr",
    "src/dsp.cyr",
    "src/compressor.cyr",
    "src/limiter.cyr",
    "src/delay.cyr",
    "src/reverb.cyr",
    "src/analysis.cyr",
    "src/fft.cyr",
    "src/loudness.cyr",
    "src/dynamics.cyr",
    # L2 — analysis/dsp dependents
    "src/stft.cyr",
    "src/chroma.cyr",
    "src/convolution.cyr",
    "src/noise_reduction.cyr",
    "src/eq.cyr",
    "src/deesser.cyr",
    "src/ops.cyr",              # needs loudness (normalize_to_lufs)
    "src/meter.cyr",
    "src/midi_routing.cyr",
    "src/midi_v2.cyr",
    "src/translate.cyr",
    "src/graph.cyr",
    # L3/L4
    "src/graphic_eq.cyr",
    "src/key.cyr",
    "src/onset.cyr",
    "src/beat.cyr",
    # Wave F — synthesis stack (externalize naad/svara/prani/nidhi/garjan/ghurni/goonj)
    "src/synthesis.cyr",
    "src/sampler.cyr",
    "src/voice_synth.cyr",
    "src/g2p.cyr",              # g2p feature — externalizes shabda/shabdakosh/varna (over voice)
    "src/creature.cyr",
    "src/environment.cyr",
    "src/mechanical.cyr",
    "src/acoustics.cyr",
    # Device I/O (2.1.0) — externalizes vani (ALSA PCM) + its yukti/sakshi deps
    "src/playback.cyr",
]

# stdlib: base set + the DSP/math set naad/svara use. `math` gives
# clamp/min/max/lerp/sign + F64_* constants; `ganita` the transcendentals
# dhvani's DSP leans on (sin/cos/exp/ln/pow/sqrt/tanh/…); `tagged` for the
# Option-shaped payload returns; `fnptr`/`callback` for the closure→fn-ptr
# port pattern; `bench` for `.bcyr` harnesses. The g2p (shabda) chain adds TWO
# leaves: `hashmap` — shabdakosh's pronunciation dictionary is a string→phoneme
# `map_*`, reachable via shabda_convert — and `unicode` (added 2.2.2), which
# shabda 3.0.2's Unicode rewrite made reachable: is_alphabetic/to_lowercase/
# is_whitespace now go through real Unicode tables (unicode_category,
# unicode_to_lower, GC_LU/GC_LO/GC_NL) instead of ASCII-only checks. NOTE
# `unicode` vendors as a DIRECTORY (lib/unicode/), not a flat lib/*.cyr.
# Deliberately NOT added: `atomic` (alloc.cyr already
# self-includes it), `mmap` (its only shabdakosh caller shbdk_lazy_open is itself
# uncalled — DCE-prunes like the json_*/http_* refs), `bayan` (0 reachable calls;
# the 136 KB fold would overflow the compiler's LEXID cap).
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "fnptr",
    "callback",
    "hashmap",
    "unicode",
    "bench",
]

# ── Dependency wiring — grows per port wave (see port-audit.md) ─────────────
#
# Math base. Decision (Wave B): **keep abaco** for dhvani's own DSP helpers
# (amplitude_to_db, db_to_amplitude, db_gain_factor, angular_frequency,
# time_constant, sanitize_sample, poly_blep, constant_power_pan,
# equal_power_crossfade). `path` for local dev, `git`+`tag` for CI/release.
# NOTE: abaco's dist also carries json/http/net helpers dhvani never calls —
# they resolve as unreachable-undefined and are DCE-pruned (benign warnings).
[deps.abaco]
git = "https://github.com/MacCracken/abaco.git"
path = "../abaco"
tag = "2.4.5"
modules = ["dist/abaco.cyr"]

# ── Synthesis stack (Wave F) — sibling dist bundles are NOT wired as [deps]. ──
#    The `[deps.X] modules=["dist/X.cyr"]` path auto-includes each bundle's
#    transitive deps in an order that breaks cross-bundle *type* refs (naad
#    `sizeof(CoupledRooms)` before goonj) AND forces stdlib `hashmap`+`bayan`
#    (bayan is 136 KB — force-including it overflows the compiler LEXID cap).
#    Instead the 10 bundles (naad/svara/prani/nidhi/garjan/ghurni/goonj + sakshi
#    + hisab + shravan) are vendored into `lib/` (committed) and each Wave F
#    test/module `include`s the ones it needs IN DEPENDENCY ORDER:
#        sakshi → hisab → goonj → naad → shravan → svara → ghurni → garjan → prani
#    (shravan = WAV codec, needed by nidhi for STREAM_EVT_*/wav_* — like every
#    dist, nidhi externalizes it; the consumer supplies it.) hisab compiles clean
#    under this ordering (the "array size" error was a mis-ordered-concatenation
#    artifact, not a 6.4.4 break). Full rationale in port-audit.md Wave F.
#    (naad 2.1.1 removed its own amplitude_to_db/db_to_amplitude — the former
#    abaco↔naad duplicate-symbol warning is gone; only abaco defines them now.)
#
# ── g2p (shabda) — ported 2026-07-06, same vendored-include pattern as Wave F. ──
#    shabda 3.0.4 + its subtree (shabdakosh 3.0.6 pronunciation dictionary, varna
#    2.4.1 phoneme inventories) are vendored into lib/ and included in dependency
#    order AFTER the naad/svara chain (shabda's own main.cyr order):
#        … svara → varna → shabdakosh → shabda
#    The g2p wrapper (src/g2p.cyr) EXTERNALIZES them from the dist like every Wave
#    F wrapper — a consumer links the shabda chain to use g2p (unused refs
#    DCE-prune). shabda/shabdakosh both fold hisab/goonj/naad (already present).
#    Reachable stdlib leaves: `hashmap` (the dictionary map_*) + `unicode`
#    (shabda 3.0.2+ Unicode tables). `mmap` (dead lazy
#    loader shbdk_lazy_open) and `bayan` (0 calls) stay OUT — they DCE-prune like
#    the json_*/http_* refs. Validated by tests/g2p.tcyr + tests/bundle_g2p.tcyr.
#
# ── BLOCKED — dependency not yet ported to Cyrius (still Rust) ──────────────
#    bhava  → `bhava-voice` / voice_synth/bhava_bridge  (port bhava first)
