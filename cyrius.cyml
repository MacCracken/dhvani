[package]
name = "dhvani"
version = "${file:VERSION}"
description = "dhvani — core audio engine (buffers, format conversion, mixing, resampling, DSP, analysis, MIDI, graph, synthesis, capture). Cyrius port of a 23,695-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/dhvani"
language = "cyrius"
cyrius = "6.5.41"

[build]
entry = "src/main.cyr"
output = "build/dhvani"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/dhvani.cyr` — every ported module concatenated in dependency order
# (deps before dependents), each self-contained (no `include` lines), sharing
# one flat namespace. Order = the L0→L4 topological layering in
# docs/development/port-audit.md. The bundle EXTERNALIZES abaco + the synthesis
# siblings (naad/svara/…): the Wave F wrappers reference their bare symbols, and
# a consumer supplies those bundles (in dep order) alongside dist/dhvani.cyr —
# unused feature refs DCE-prune. Do NOT edit dist/dhvani.cyr; rebuild with distlib.
[lib]
modules = [
    # L0 — error base + error-only leaves
    "src/error.cyr",
    "src/simd.cyr",
    "src/clock.cyr",
    "src/oscillator.cyr",
    "src/gain_smoother.cyr",
    "src/envelope.cyr",
    "src/lfo.cyr",
    "src/automation.cyr",
    "src/midi.cyr",
    "src/voice.cyr",
    "src/capture.cyr",
    "src/record.cyr",
    # L1 — buffer + its dependents
    "src/buffer.cyr",
    "src/convert.cyr",
    "src/dither.cyr",
    "src/resample.cyr",
    "src/waveform.cyr",
    "src/zcr.cyr",
    "src/pan.cyr",
    "src/svf.cyr",
    "src/biquad.cyr",
    "src/routing.cyr",
    "src/dsp.cyr",
    "src/compressor.cyr",
    "src/limiter.cyr",
    "src/delay.cyr",
    "src/reverb.cyr",
    "src/analysis.cyr",
    "src/fft.cyr",
    "src/loudness.cyr",
    "src/dynamics.cyr",
    # L2 — analysis/dsp dependents
    "src/stft.cyr",
    "src/chroma.cyr",
    "src/convolution.cyr",
    "src/noise_reduction.cyr",
    "src/eq.cyr",
    "src/deesser.cyr",
    "src/ops.cyr",              # needs loudness (normalize_to_lufs)
    "src/meter.cyr",
    "src/midi_routing.cyr",
    "src/midi_v2.cyr",
    "src/translate.cyr",
    "src/graph.cyr",
    # L3/L4
    "src/graphic_eq.cyr",
    "src/key.cyr",
    "src/onset.cyr",
    "src/beat.cyr",
    # Wave F — synthesis stack (externalize naad/svara/prani/nidhi/garjan/ghurni/goonj)
    "src/synthesis.cyr",
    "src/sampler.cyr",
    "src/voice_synth.cyr",
    "src/g2p.cyr",              # g2p feature — externalizes shabda/shabdakosh/varna (over voice)
    "src/creature.cyr",
    "src/environment.cyr",
    "src/mechanical.cyr",
    "src/acoustics.cyr",
    # Device I/O (2.1.0) — externalizes vani (ALSA PCM) + its yukti/sakshi deps
    "src/playback.cyr",
]

# stdlib: base set + the DSP/math set naad/svara use. `math` gives
# clamp/min/max/lerp/sign + F64_* constants; `ganita` the transcendentals
# dhvani's DSP leans on (sin/cos/exp/ln/pow/sqrt/tanh/…); `tagged` for the
# Option-shaped payload returns; `fnptr`/`callback` for the closure→fn-ptr
# port pattern; `bench` for `.bcyr` harnesses. The g2p (shabda) chain adds TWO
# leaves: `hashmap` — shabdakosh's pronunciation dictionary is a string→phoneme
# `map_*`, reachable via shabda_convert — and `unicode` (added 2.2.2), which
# shabda 3.0.2's Unicode rewrite made reachable: is_alphabetic/to_lowercase/
# is_whitespace now go through real Unicode tables (unicode_category,
# unicode_to_lower, GC_LU/GC_LO/GC_NL) instead of ASCII-only checks. NOTE
# `unicode` vendors as a DIRECTORY (lib/unicode/), not a flat lib/*.cyr.
# Deliberately NOT added: `atomic` (alloc.cyr already
# self-includes it), `mmap` (its only shabdakosh caller shbdk_lazy_open is itself
# uncalled — DCE-prunes like the json_*/http_* refs), `bayan` (0 reachable calls;
# the 136 KB fold would overflow the compiler's LEXID cap).
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "fnptr",
    "callback",
    "hashmap",
    "unicode",
    "bench",
]

# ── Dependency wiring — grows per port wave (see port-audit.md) ─────────────
#
# Math base. Decision (Wave B): **keep abaco** for dhvani's own DSP helpers
# (amplitude_to_db, db_to_amplitude, db_gain_factor, angular_frequency,
# time_constant, sanitize_sample, poly_blep, constant_power_pan,
# equal_power_crossfade). `path` for local dev, `git`+`tag` for CI/release.
# NOTE: abaco's dist also carries json/http/net helpers dhvani never calls —
# they resolve as unreachable-undefined and are DCE-pruned (benign warnings).
[deps.abaco]
git = "https://github.com/MacCracken/abaco.git"
path = "../abaco"
tag = "2.4.5"
modules = ["dist/abaco.cyr"]

# ── Sibling bundles — WIRED AS REAL `[deps]` as of 2.2.3 ────────────────────
#    Declared in DEPENDENCY ORDER (the same order the `include` lines use):
#        sakshi → hisab → goonj → naad → shravan → svara → nidhi → ghurni
#        → garjan → prani → varna → shabdakosh → shabda → patra → yukti → vani
#
#    HISTORY — why these used to be hand-vendored. Through 2.2.2 the 16 sibling
#    bundles were copied into `lib/` by hand and pulled in by explicit ordered
#    `include`, because `[deps]` had two blocking defects: (a) it auto-included
#    each bundle's transitive deps in an order that broke cross-bundle *type*
#    refs (naad `sizeof(CoupledRooms)` compiled before goonj), and (b) it
#    force-included stdlib `bayan` (136 KB), overflowing the compiler's 16384
#    LEXID identifier-dedup cap.
#
#    BOTH are now resolved, so the workaround is retired:
#      (a) every sibling now declares its FULL transitive closure explicitly and
#          in order (naad wires hisab+goonj, prani wires svara+naad+hisab+goonj+
#          sakshi, …), and each dist ships a `.deps` sidecar that `cyrius deps`
#          consumes — so ordering is declared, not inferred.
#      (b) the LEXID cap went 16384 → 65536 (cyrius 6.4.21) and the identifier
#          pool 256 KB → 512 KB (6.4.76). Measured headroom at 6.5.41 is
#          ~20k/8.4M identifiers — the bayan ceiling is no longer reachable.
#
#    What this buys: versions are DECLARED and hash-LOCKED in `cyrius.lock`
#    instead of living in an uncommitted copy step, CI resolves them from git
#    tags, and the dep surface is auditable from one file. `path` is for local
#    dev, `git`+`tag` for CI/release — same dual form abaco already used.
#    The `include "lib/<x>.cyr"` lines in src/ and tests/ are UNCHANGED: `[deps]`
#    governs vendoring into `lib/`, the includes still govern compile order.
#

# logging base — goonj/garjan/ghurni/prani call sakshi_*
[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
path = "../sakshi"
tag = "2.4.12"
modules = ["dist/sakshi.cyr"]

# math; goonj needs its HVec3 (hvec3_*/HVec3_*) — REACHABLE, not DCE
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
path = "../hisab"
tag = "2.11.2"
modules = ["dist/hisab.cyr"]

# acoustics; defines CoupledRooms (naad sizeof's it)
[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
path = "../goonj"
tag = "2.0.4"
modules = ["dist/goonj.cyr"]

# synthesis; sizeof(CoupledRooms) from goonj. Owns NAAD_FILTER_*
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
path = "../naad"
tag = "2.2.2"
modules = ["dist/naad.cyr"]

# codec substrate under shravan/nidhi. Declared explicitly so the whole closure
# is TAG-pinned: left implicit, `cyrius deps` resolves it to a bare commit hash.
# dhvani makes 0 direct sankoch_* calls — it DCE-prunes — but it must still be
# declared to be auditable and reproducible.
[deps.sankoch]
git = "https://github.com/MacCracken/sankoch.git"
path = "../sankoch"
tag = "2.7.10"
modules = ["dist/sankoch.cyr"]

# THE audio codec — nidhi needs its STREAM_EVT_*/wav_*
[deps.shravan]
git = "https://github.com/MacCracken/shravan.git"
path = "../shravan"
tag = "2.8.0"
modules = ["dist/shravan.cyr"]

# voice; references naad's NOISE_WHITE etc.
[deps.svara]
git = "https://github.com/MacCracken/svara.git"
path = "../svara"
tag = "3.5.4"
modules = ["dist/svara.cyr"]

# sampler engine; needs naad + shravan
[deps.nidhi]
git = "https://github.com/MacCracken/nidhi.git"
path = "../nidhi"
tag = "2.1.1"
modules = ["dist/nidhi.cyr"]

# mechanical; naad + sakshi
[deps.ghurni]
git = "https://github.com/MacCracken/ghurni.git"
path = "../ghurni"
tag = "2.6.0"
modules = ["dist/ghurni.cyr"]

# environment; sakshi + goonj
[deps.garjan]
git = "https://github.com/MacCracken/garjan.git"
path = "../garjan"
tag = "2.5.1"
modules = ["dist/garjan.cyr"]

# creature; svara + sakshi
[deps.prani]
git = "https://github.com/MacCracken/prani.git"
path = "../prani"
tag = "2.0.12"
modules = ["dist/prani.cyr"]

# g2p: phoneme inventories (shared singletons — READ-ONLY)
[deps.varna]
git = "https://github.com/MacCracken/varna.git"
path = "../varna"
tag = "2.4.1"
modules = ["dist/varna.cyr"]

# g2p: pronunciation dictionary (the hashmap map_*)
[deps.shabdakosh]
git = "https://github.com/MacCracken/shabdakosh.git"
path = "../shabdakosh"
tag = "3.0.6"
modules = ["dist/shabdakosh.cyr"]

# g2p engine; needs varna + shabdakosh + svara
[deps.shabda]
git = "https://github.com/MacCracken/shabda.git"
path = "../shabda"
tag = "3.0.4"
modules = ["dist/shabda.cyr"]

# device I/O: procfs/text reads — yukti 2.3.8 reads /proc/asound through it
[deps.patra]
git = "https://github.com/MacCracken/patra.git"
path = "../patra"
tag = "1.13.11"
modules = ["dist/patra.cyr"]

# device I/O: PCM endpoint discovery
[deps.yukti]
git = "https://github.com/MacCracken/yukti.git"
path = "../yukti"
tag = "2.3.8"
modules = ["dist/yukti.cyr"]

# device I/O: raw /dev/snd ALSA PCM — drives src/playback.cyr
[deps.vani]
git = "https://github.com/MacCracken/vani.git"
path = "../vani"
tag = "1.2.2"
modules = ["dist/vani.cyr"]

# ── BLOCKED — dependency not yet ported to Cyrius (still Rust) ──────────────
#    bhava  → `bhava-voice` / voice_synth/bhava_bridge  (port bhava first)
