#must_use
fn dhvani_midi2_pitch_bend_value(e) { return DhPitchBendV2_value(e); }

# --- translate.cyr ---

# translate.cyr -- MIDI 1.0 <-> 2.0 translation: velocity/CC/pitch-bend scaling
# + NoteEvent/ControlChange <-> V2 struct conversion.
# Ports rust-old/src/midi/translate.rs. L1: deps error + midi (DhNoteEvent /
# DhControlChange consumed) + midi_v2 (DhNoteOnV2 / DhControlChangeV2 target
# types + dhvani_midi2_* constructors/accessors -- reused, not redefined here).
# Pure INTEGER bit logic -- no floats. Rust gets its widths from the types; the
# Cyrius port uses i64 slots, so every scaler masks its INPUT to the Rust type
# width (u8 & 0xFF, u16 & 0xFFFF, u32 & 0xFFFFFFFF -- what the Rust argument
# type would have held) and its OUTPUT to the result width (u16/u32 for the
# up-scalers, the 7/14-bit domain for the down-scalers). For every in-type input
# the result is bit-identical to rust-old; out-of-type input (a negative or
# sign-extended word, >32-bit garbage) can no longer leak past the 7/14-bit range.
#
# UP-SCALING IS BIT REPLICATION, NOT THE MIDI 2.0 MIN-CENTER-MAX RULE. rust-old's
# doc calls `v << 9 | v << 2 | v >> 5` "MIDI 2.0 spec scaling"; it is plain bit
# replication, kept here for oracle parity. Consequence: centre values are NOT
# preserved -- 7-bit velocity 64 -> 0x8102 (not 0x8000), CC 64 -> 0x81020408
# (not 0x80000000), and pitch bend 8192 -> 0x80020008, which is NOT
# DH_MIDITX_PITCH_BEND_CENTER (a consumer testing `== CENTER` for "no bend" on an
# up-scaled MIDI 1.0 bend never matches). Up-then-down round-trips are exact.
#
# The struct conversions allocate (free-less bump allocator); each has a
# zero-alloc `*_into(..., out)` twin that writes a caller-owned handle.
# serde + Display tests dropped (none in this oracle).

# Pitch bend center value in MIDI 2.0 (32-bit).
var DH_MIDITX_PITCH_BEND_CENTER = 0x80000000;

# ---- scalar scaling (pure integer bit logic) ----

# Scale 7-bit MIDI 1.0 velocity (u8) to 16-bit MIDI 2.0: bit replication
# v << 9 | v << 2 | v >> 5 (see header -- not min-center-max).
#must_use
fn dhvani_miditx_velocity_7_to_16(v) {
    var x = v & 0xFF;
    if (x == 0) { return 0; }
    return ((x << 9) | (x << 2) | (x >> 5)) & 0xFFFF;
}

# Scale 16-bit MIDI 2.0 velocity (u16) to 7-bit MIDI 1.0 (lossy). Pure scaler:
# 1..511 -> 0. Note-on conversion applies the 0 -> 1 rule on top (below).
#inline
#must_use
fn dhvani_miditx_velocity_16_to_7(v) {
    return ((v & 0xFFFF) >> 9) & 0x7F;
}

# Scale 7-bit CC value (u8) to 32-bit MIDI 2.0 (bit replication).
#must_use
fn dhvani_miditx_cc_7_to_32(v) {
    var x = v & 0xFF;
    return ((x << 25) | (x << 18) | (x << 11) | (x << 4) | (x >> 3)) & 0xFFFFFFFF;
}

# Scale 32-bit CC value (u32) to 7-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_cc_32_to_7(v) {
    return ((v & 0xFFFFFFFF) >> 25) & 0x7F;
}

# Convert 14-bit MIDI 1.0 pitch bend (u16) to 32-bit MIDI 2.0 (bit replication).
#must_use
fn dhvani_miditx_pitch_bend_14_to_32(v) {
    var x = v & 0xFFFF;
    return ((x << 18) | (x << 4) | (x >> 10)) & 0xFFFFFFFF;
}

# Convert 32-bit MIDI 2.0 pitch bend (u32) to 14-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_pitch_bend_32_to_14(v) {
    return ((v & 0xFFFFFFFF) >> 18) & 0x3FFF;
}

# ---- struct conversions (V2 types from midi_v2.cyr) ----

# MIDI 1.0 NoteEvent -> caller-owned NoteOnV2 `out` (zero-alloc). Returns out.
fn dhvani_miditx_note_event_to_v2_into(event, out) {
    return dhvani_midi2_note_on_init(
      out,
      dhvani_note_event_position(event),
      dhvani_note_event_note(event),
      dhvani_miditx_velocity_7_to_16(dhvani_note_event_velocity(event)),
      dhvani_note_event_channel(event),
      0,
      0);
}

# Convert a MIDI 1.0 NoteEvent to a MIDI 2.0 NoteOnV2 (allocates 48 B).
#must_use
fn dhvani_miditx_note_event_to_v2(event) {
    return dhvani_miditx_note_event_to_v2_into(event, alloc(sizeof(DhNoteOnV2)));
}

# MIDI 2.0 NoteOnV2 -> caller-owned NoteEvent `out` (lossy, zero-alloc).
# Requires a duration since NoteOnV2 doesn't carry duration. Returns out.
# DIVERGES from rust-old (translate.rs:83 uses velocity_16_to_7 as-is): a 16-bit
# velocity that down-scales to 0 (0..511) becomes 1, per the MIDI 2.0 -> 1.0
# translation rule -- a note-on must not turn into a MIDI 1.0 velocity-0 note-off.
fn dhvani_miditx_note_on_v2_to_event_into(event, duration, out) {
    var vel = dhvani_miditx_velocity_16_to_7(dhvani_midi2_note_on_velocity(event));
    if (vel == 0) { vel = 1; }
    return dhvani_note_event_init(
      out,
      dhvani_midi2_note_on_position(event),
      duration,
      dhvani_midi2_note_on_note(event),
      vel,
      dhvani_midi2_note_on_channel(event));
}

# Convert a MIDI 2.0 NoteOnV2 back to a MIDI 1.0 NoteEvent (lossy, allocates).
#must_use
fn dhvani_miditx_note_on_v2_to_event(event, duration) {
    return dhvani_miditx_note_on_v2_to_event_into(event, duration, alloc(sizeof(DhNoteEvent)));
}

# MIDI 1.0 ControlChange -> caller-owned ControlChangeV2 `out`. Returns out.
fn dhvani_miditx_cc_to_v2_into(cc, out) {
    return dhvani_midi2_cc_init(
      out,
      dhvani_cc_position(cc),
      dhvani_cc_controller(cc),
      dhvani_miditx_cc_7_to_32(dhvani_cc_value(cc)),
      dhvani_cc_channel(cc));
}

# Convert a MIDI 1.0 ControlChange to MIDI 2.0 ControlChangeV2 (allocates).
#must_use
fn dhvani_miditx_cc_to_v2(cc) {
    return dhvani_miditx_cc_to_v2_into(cc, alloc(sizeof(DhControlChangeV2)));
}

# MIDI 2.0 ControlChangeV2 -> caller-owned ControlChange `out` (lossy). Returns out.
fn dhvani_miditx_cc_v2_to_cc_into(cc, out) {
    return dhvani_cc_init(
      out,
      dhvani_midi2_cc_position(cc),
      dhvani_midi2_cc_controller(cc),
      dhvani_miditx_cc_32_to_7(dhvani_midi2_cc_value(cc)),
      dhvani_midi2_cc_channel(cc));
}

# Convert a MIDI 2.0 ControlChangeV2 to MIDI 1.0 ControlChange (lossy, allocates).
#must_use
fn dhvani_miditx_cc_v2_to_cc(cc) {
    return dhvani_miditx_cc_v2_to_cc_into(cc, alloc(sizeof(DhControlChange)));
}

# --- graph.cyr ---

# graph.cyr -- audio graph: node-based processing with topological execution.
# Ported one-for-one from rust-old/src/graph/mod.rs. Depends on buffer.cyr
# (dhvani_buffer_silence / dhvani_buffer_samples / dh_vec_zeros / dh_vec_copy),
# simd.cyr (dh_vec_data) and the fnptr stdlib (fncall3).
#
# Design notes (Rust -> Cyrius):
#   * AudioNode trait  -> fn-ptr dispatch. A node is a DhGraphNode struct holding
#     a `process_fp` fn-ptr + opaque `state` pointer + the metadata the trait's
#     default methods carried (finished/bypassed/supports-bypass/latency). The
#     process() call dispatches via fncall3(process_fp, state, inputs, output).
#     Concrete node types (Generator/Gain/...) live in the test unit, exactly as
#     they lived in `mod tests` in Rust.
#   * NodeId(u32) atomic counter -> module-level `var DH_GRAPH_NEXT_ID`.
#   * HashMap<NodeId, _> -> parallel vecs (id-vec + value-vec) + linear scan.
#     Those scans are compile-time / query-time only: compile() also assigns every
#     node a DENSE SLOT (its position in the execution order) and precomputes, per
#     slot, the node pointer and its predecessors' slots, so the per-cycle render
#     path is O(nodes + edges) and a node id never indexes or sizes anything (a
#     negative or huge id is just a key).
#   * Result<_, &str>    -> plan pointer, or 0 (null) on the Err case. Every plan
#     accessor treats a 0 plan as absent (returns 0); swap(h, 0) is an error.
#   * Option<AudioBuffer> slots -> buffer pointer, or 0 for None.
#   * Arc<Mutex<Option<plan>>> pending-plan cell -> a shared length-1 vec.
#   * process_parallel (#[cfg(feature="parallel")], rayon) -> dropped (no threads).
#
# NODE INPUT CONTRACT: rust-old hands a node `&[&AudioBuffer]` -- read-only
# clones. Here `inputs` holds the predecessors' LIVE output buffers (no copy per
# cycle), so a node must treat every input as read-only: writing into an input
# corrupts what that predecessor's other consumers receive this cycle. Write only
# into `output`. The `inputs` vec itself is processor scratch, valid only for the
# duration of the call.

# ---- NodeId (atomic unique id generator) ----

var DH_GRAPH_NEXT_ID = 1;

# NodeId::next() -- next unique node id (u32 counter, starts at 1).
#must_use
fn dhvani_node_id_next() {
    var id = DH_GRAPH_NEXT_ID;
    DH_GRAPH_NEXT_ID = DH_GRAPH_NEXT_ID + 1;
    return id;
}

# ---- linear-scan helper for HashMap<NodeId,_> ports ----

# index of `id` in the id-vec, or -1 if absent.
fn dh_graph_find(ids, id) {
    var n = vec_len(ids);
    var i = 0;
    while (i < n) {
        if (vec_get(ids, i) == id) { return i; }
        i = i + 1;
    }
    return -1;
}

# Vec::insert(pos, val): shift the tail right by one, then place val at pos.
fn dh_graph_vec_insert(v, pos, val) {
    vec_push(v, 0);
    var i = vec_len(v) - 1;
    while (i > pos) {
        vec_set(v, i, vec_get(v, i - 1));
        i = i - 1;
    }
    vec_set(v, pos, val);
    return 0;
}

# ---- AudioNode (trait object -> fn-ptr node) ----

#derive(accessors)
struct DhGraphNode { process_fp; state; ninputs; noutputs; finished; bypassed; supports_byp; latency; name; }

# Construct a node: process fn-ptr, opaque state, port counts, and the flags the
# trait's default methods encode (finished / initial bypass / supports-bypass /
# latency frames) plus a name.
fn dhvani_graph_node_new(process_fp, state, ninputs, noutputs, finished, bypassed, supports_byp, latency, name) {
    var self = alloc(sizeof(DhGraphNode));
    DhGraphNode_set_process_fp(self, process_fp);
    DhGraphNode_set_state(self, state);
    DhGraphNode_set_ninputs(self, ninputs);
    DhGraphNode_set_noutputs(self, noutputs);
    DhGraphNode_set_finished(self, finished);
    DhGraphNode_set_bypassed(self, bypassed);
    DhGraphNode_set_supports_byp(self, supports_byp);
    DhGraphNode_set_latency(self, latency);
    DhGraphNode_set_name(self, name);
    return self;
}

fn dhvani_graph_node_name(node) { return DhGraphNode_name(node); }
fn dhvani_graph_node_num_inputs(node) { return DhGraphNode_ninputs(node); }
fn dhvani_graph_node_num_outputs(node) { return DhGraphNode_noutputs(node); }
fn dhvani_graph_node_is_finished(node) { return DhGraphNode_finished(node); }
fn dhvani_graph_node_is_bypassed(node) { return DhGraphNode_bypassed(node); }
fn dhvani_graph_node_latency(node) { return DhGraphNode_latency(node); }

# process(): dispatch through the stored fn-ptr. inputs = vec of buffer ptrs
# (read-only -- see NODE INPUT CONTRACT), output = a buffer ptr. The concrete fn
# reads its own `state`.
fn dhvani_graph_node_process(node, inputs, output) {
    return fncall3(DhGraphNode_process_fp(node), DhGraphNode_state(node), inputs, output);
}

# set_bypass(): only nodes that support it change state; returns 1 on success, 0
# if unsupported (matches the trait default returning false).
fn dhvani_graph_node_set_bypass(node, bypassed) {
    if (DhGraphNode_supports_byp(node) == 1) {
        DhGraphNode_set_bypassed(node, bypassed);
        return 1;
    }
    return 0;
}

# ---- Connection ----

#derive(accessors)
struct DhConnection { cfrom; cto; }

fn dhvani_connection_from(self) { return DhConnection_cfrom(self); }
fn dhvani_connection_to(self) { return DhConnection_cto(self); }

# ---- Graph (non-RT builder) ----

# nodes HashMap -> parallel node_ids / node_ptrs; connections -> conns vec.
#derive(accessors)
struct DhGraph { node_ids; node_ptrs; conns; }

fn dhvani_graph_new() {
    var self = alloc(sizeof(DhGraph));
    DhGraph_set_node_ids(self, vec_new());
    DhGraph_set_node_ptrs(self, vec_new());
    DhGraph_set_conns(self, vec_new());
    return self;
}

# add_node: HashMap insert semantics -- replace an existing id, else append.
fn dhvani_graph_add_node(self, id, node) {
    var ids = DhGraph_node_ids(self);
    var ptrs = DhGraph_node_ptrs(self);
    var idx = dh_graph_find(ids, id);
    if (idx >= 0) {
        vec_set(ptrs, idx, node);
    } else {
        vec_push(ids, id);
        vec_push(ptrs, node);
    }
    return 0;
}

fn dhvani_graph_connect(self, from, to) {
    var c = alloc(sizeof(DhConnection));
    DhConnection_set_cfrom(c, from);
    DhConnection_set_cto(c, to);
    vec_push(DhGraph_conns(self), c);
    return 0;
}

fn dhvani_graph_node_count(self) { return vec_len(DhGraph_node_ids(self)); }
fn dhvani_graph_connection_count(self) { return vec_len(DhGraph_conns(self)); }

# ---- Topological sort (Kahn's algorithm, rust-old's queue reproduced) ----

# rust-old inserts a newly ready node at `queue.partition_point(|id| id.0 >=
# succ.0)`. The queue starts ASCENDING, so that predicate is inverted relative to
# the order it is applied to; the result is whatever std's binary search lands on.
# This is that search, step for step (core::slice::binary_search_by as of the
# rust-version 1.89 pin; partition_point maps pred -> Less, !pred -> Greater):
# halve with `base = mid` on Less, then `base + (last cmp == Less)`.
# Verified against rust-old compiled with rustc 1.89 and 1.100 on 400 random DAGs
# (40 of them are embedded in tests/graph.tcyr).
# queue holds node-table indices; node_ids gives their ids.
fn dh_graph_partition_point(queue, node_ids, sid) {
    var size = vec_len(queue);
    if (size == 0) { return 0; }
    var base = 0;
    while (size > 1) {
        var half = size / 2;
        var mid = base + half;
        if (vec_get(node_ids, vec_get(queue, mid)) >= sid) { base = mid; }
        size = size - half;
    }
    if (vec_get(node_ids, vec_get(queue, base)) >= sid) { return base + 1; }
    return base;
}

# Fill out_order with rust-old's topological order of node_ids given conns.
# Returns 0 on success, -1 on the Err case: a cycle, or a connection whose
# endpoint was never added (rust-old: such an edge leaves order.len() !=
# nodes.len() -> "cycle detected"). Order: the ready queue is sorted ascending
# and popped from the END (largest id first); nodes that become ready later are
# inserted where Rust's partition_point puts them (dh_graph_partition_point), so
# the resulting order -- and therefore which node is "last" (the graph output,
# is_finished) -- matches rust-old, not a max-ready-first rule.
fn dh_topological_sort(node_ids, conns, out_order) {
    var n = vec_len(node_ids);
    # in-degree + successor index lists, parallel to node_ids
    var in_deg = dh_vec_zeros(n);
    var succ = vec_new();
    var b = 0;
    while (b < n) { vec_push(succ, vec_new()); b = b + 1; }
    var m = vec_len(conns);
    var c = 0;
    while (c < m) {
        var conn = vec_get(conns, c);
        var fi = dh_graph_find(node_ids, DhConnection_cfrom(conn));
        var ti = dh_graph_find(node_ids, DhConnection_cto(conn));
        if (fi < 0) { return -1; }
        if (ti < 0) { return -1; }
        vec_set(in_deg, ti, vec_get(in_deg, ti) + 1);
        vec_push(vec_get(succ, fi), ti);
        c = c + 1;
    }
    # initial queue: every in-degree-0 node, ascending by id (ids are unique)
    var queue = vec_new();
    var i = 0;
    while (i < n) {
        if (vec_get(in_deg, i) == 0) {
            var id = vec_get(node_ids, i);
            var pos = 0;
            var ql = vec_len(queue);
            while (pos < ql) {
                if (vec_get(node_ids, vec_get(queue, pos)) > id) { break; }
                pos = pos + 1;
            }
            dh_graph_vec_insert(queue, pos, i);
        }
        i = i + 1;
    }
    # while let Some(node) = queue.pop()
    while (vec_len(queue) > 0) {
        var node = vec_pop(queue);
        vec_push(out_order, vec_get(node_ids, node));
        var sl = vec_get(succ, node);
        var k = 0;
        var kn = vec_len(sl);
        while (k < kn) {
            var si = vec_get(sl, k);
            var d = vec_get(in_deg, si) - 1;
            vec_set(in_deg, si, d);
            if (d == 0) {
                var p = dh_graph_partition_point(queue, node_ids, vec_get(node_ids, si));
                dh_graph_vec_insert(queue, p, si);
            }
            k = k + 1;
        }
    }
    if (vec_len(out_order) != n) { return -1; }
    return 0;
}

# ---- Level computation (dependency-depth grouping) ----

# Group `order` into levels by max input depth. im_ids/im_lists = input_map
# (node -> its predecessor ids). Returns a vec of levels (each a vec of ids),
# empty levels removed.
fn dh_compute_levels(order, im_ids, im_lists) {
    var d_ids = vec_new();
    var d_vals = vec_new();
    var n = vec_len(order);
    var maxdepth = 0;
    var i = 0;
    while (i < n) {
        var id = vec_get(order, i);
        var dep = 0;
        var imi = dh_graph_find(im_ids, id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var kn = vec_len(preds);
            var found = 0;
            var maxin = 0;
            var k = 0;
            while (k < kn) {
                var pi = dh_graph_find(d_ids, vec_get(preds, k));
                if (pi >= 0) {
                    var pv = vec_get(d_vals, pi);
                    if (found == 0) { maxin = pv; found = 1; }
                    elif (pv > maxin) { maxin = pv; }
                }
                k = k + 1;
            }
            if (found == 1) { dep = maxin + 1; }
        }
        vec_push(d_ids, id);
        vec_push(d_vals, dep);
        if (dep > maxdepth) { maxdepth = dep; }
        i = i + 1;
    }
    # bucket ids into (maxdepth + 1) levels
    var buckets = vec_new();
    var b = 0;
    while (b <= maxdepth) { vec_push(buckets, vec_new()); b = b + 1; }
    var j = 0;
    while (j < n) {
        var id2 = vec_get(order, j);
        var di = dh_graph_find(d_ids, id2);
        vec_push(vec_get(buckets, vec_get(d_vals, di)), id2);
        j = j + 1;
    }
    # retain non-empty levels
    var out = vec_new();
    var l = 0;
    var ln = vec_len(buckets);
    while (l < ln) {
        var lv = vec_get(buckets, l);
        if (vec_len(lv) > 0) { vec_push(out, lv); }
        l = l + 1;
    }
    return out;
}

# ---- ExecutionPlan (compiled, topologically sorted) ----

# order/levels/node table/input_map/latency_comp mirror rust-old's fields.
# Render-path tables, one entry per DENSE SLOT (slot p = order position p):
#   ord_nodes[p] = node ptr; ord_preds[p] = vec of predecessor SLOTS in
#   input_map order, or 0 (no input_map entry). total_lat = total_latency(),
#   computed once here (node latency is a fixed per-node field).
#derive(accessors)
struct DhExecPlan {
    order;
    levels;
    node_ids;
    node_ptrs;
    im_ids;
    im_lists;
    lc_ids;
    lc_vals;
    ord_nodes;
    ord_preds;
    total_lat;
}

# node lookup by id inside a plan -> node ptr, or 0 if absent.
fn dh_plan_node(plan, id) {
    var idx = dh_graph_find(DhExecPlan_node_ids(plan), id);
    if (idx < 0) { return 0; }
    return vec_get(DhExecPlan_node_ptrs(plan), idx);
}

# node lookup against raw parallel vecs (used during compile before the plan exists).
fn dh_plan_node2(node_ids, node_ptrs, id) {
    var idx = dh_graph_find(node_ids, id);
    if (idx < 0) { return 0; }
    return vec_get(node_ptrs, idx);
}

# Graph::compile -> ExecutionPlan pointer, or 0 on the Err case (cycle, or an
# edge to/from a node that was never added).
# rust-old's compile(self) MOVES the node table into the plan, so the graph can
# never touch a compiled plan again. The plan here takes its own COPY of the
# graph's node-id / node-ptr vecs: a later add_node (new id or replacement) or a
# second compile cannot change a live plan's node table. The node objects (and
# their opaque state) are shared, not cloned -- compiling one graph twice and
# running both plans runs the same node state twice.
fn dhvani_graph_compile(self) {
    if (self == 0) { return 0; }
    var node_ids = dh_vec_copy(DhGraph_node_ids(self));
    var node_ptrs = dh_vec_copy(DhGraph_node_ptrs(self));
    var conns = DhGraph_conns(self);

    var order = vec_new();
    if (dh_topological_sort(node_ids, conns, order) != 0) { return 0; }

    # input_map: for each connection in order, im[to].push(from)
    var im_ids = vec_new();
    var im_lists = vec_new();
    var m = vec_len(conns);
    var c = 0;
    while (c < m) {
        var conn = vec_get(conns, c);
        var to = DhConnection_cto(conn);
        var ii = dh_graph_find(im_ids, to);
        if (ii < 0) {
            vec_push(im_ids, to);
            var fresh = vec_new();
            vec_push(fresh, DhConnection_cfrom(conn));
            vec_push(im_lists, fresh);
        } else {
            vec_push(vec_get(im_lists, ii), DhConnection_cfrom(conn));
        }
        c = c + 1;
    }

    # path_latency: accumulated latency along the longest input path + own.
    # Its max is total_latency() (rust-old recomputes the same pass per call).
    var pl_ids = vec_new();
    var pl_vals = vec_new();
    var total_lat = 0;
    var no = vec_len(order);
    var oi = 0;
    while (oi < no) {
        var id = vec_get(order, oi);
        var node = dh_plan_node2(node_ids, node_ptrs, id);
        var own = 0;
        if (node != 0) { own = dhvani_graph_node_latency(node); }
        var input_max = 0;
        var imi = dh_graph_find(im_ids, id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var pk = 0;
            var pkn = vec_len(preds);
            while (pk < pkn) {
                var ppi = dh_graph_find(pl_ids, vec_get(preds, pk));
                if (ppi >= 0) {
                    var pv = vec_get(pl_vals, ppi);
                    if (pv > input_max) { input_max = pv; }
                }
                pk = pk + 1;
            }
        }
        vec_push(pl_ids, id);
        vec_push(pl_vals, input_max + own);
        if (input_max + own > total_lat) { total_lat = input_max + own; }
        oi = oi + 1;
    }

    # latency_comp: for multi-input nodes, delay shorter input paths to align.
    var lc_ids = vec_new();
    var lc_vals = vec_new();
    var oj = 0;
    while (oj < no) {
        var id3 = vec_get(order, oj);
        var imj = dh_graph_find(im_ids, id3);
        if (imj >= 0) {
            var inp = vec_get(im_lists, imj);
            var inn = vec_len(inp);
            if (inn > 1) {
                # max input path latency
                var mil = 0;
                var q = 0;
                while (q < inn) {
                    var qi = dh_graph_find(pl_ids, vec_get(inp, q));
                    if (qi >= 0) {
                        var qv = vec_get(pl_vals, qi);
                        if (qv > mil) { mil = qv; }
                    }
                    q = q + 1;
                }
                # per-input compensation delay
                var r = 0;
                while (r < inn) {
                    var inpid = vec_get(inp, r);
                    var ri = dh_graph_find(pl_ids, inpid);
                    var il = 0;
                    if (ri >= 0) { il = vec_get(pl_vals, ri); }
                    var comp = mil - il;
                    if (comp > 0) {
                        var ei = dh_graph_find(lc_ids, inpid);
                        if (ei >= 0) { vec_set(lc_vals, ei, comp); }
                        else { vec_push(lc_ids, inpid); vec_push(lc_vals, comp); }
                    }
                    r = r + 1;
                }
            }
        }
        oj = oj + 1;
    }

    var levels = dh_compute_levels(order, im_ids, im_lists);

    # dense-slot render tables (every endpoint is a node, so every pred has a slot)
    var ord_nodes = dh_vec_zeros(no);
    var ord_preds = dh_vec_zeros(no);
    var sp = 0;
    while (sp < no) {
        var sid = vec_get(order, sp);
        vec_set(ord_nodes, sp, dh_plan_node2(node_ids, node_ptrs, sid));
        var ims = dh_graph_find(im_ids, sid);
        if (ims >= 0) {
            var plist = vec_get(im_lists, ims);
            var pn = vec_len(plist);
            var slots = vec_new();
            var pj = 0;
            while (pj < pn) {
                vec_push(slots, dh_graph_find(order, vec_get(plist, pj)));
                pj = pj + 1;
            }
            vec_set(ord_preds, sp, slots);
        }
        sp = sp + 1;
    }

    var plan = alloc(sizeof(DhExecPlan));
    DhExecPlan_set_order(plan, order);
    DhExecPlan_set_levels(plan, levels);
    DhExecPlan_set_node_ids(plan, node_ids);
    DhExecPlan_set_node_ptrs(plan, node_ptrs);
    DhExecPlan_set_im_ids(plan, im_ids);
    DhExecPlan_set_im_lists(plan, im_lists);
    DhExecPlan_set_lc_ids(plan, lc_ids);
    DhExecPlan_set_lc_vals(plan, lc_vals);
    DhExecPlan_set_ord_nodes(plan, ord_nodes);
    DhExecPlan_set_ord_preds(plan, ord_preds);
    DhExecPlan_set_total_lat(plan, total_lat);
    return plan;
}

# Plan accessors: a 0 plan (failed compile) reads as absent -> 0.
fn dhvani_plan_order(plan) {
    if (plan == 0) { return 0; }
    return DhExecPlan_order(plan);
}

fn dhvani_plan_levels(plan) {
    if (plan == 0) { return 0; }
    return DhExecPlan_levels(plan);
}

# is the last node in topo order finished?
fn dhvani_plan_is_finished(plan) {
    if (plan == 0) { return 0; }
    var nodes = DhExecPlan_ord_nodes(plan);
    var n = vec_len(nodes);
    if (n == 0) { return 0; }
    var node = vec_get(nodes, n - 1);
    if (node == 0) { return 0; }
    return dhvani_graph_node_is_finished(node);
}

# set bypass for a node; 0 if absent or unsupported.
fn dhvani_plan_set_bypass(plan, id, bypassed) {
    if (plan == 0) { return 0; }
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_set_bypass(node, bypassed);
}

fn dhvani_plan_is_bypassed(plan, id) {
    if (plan == 0) { return 0; }
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_is_bypassed(node);
}

fn dhvani_plan_latency_frames(plan, id) {
    if (plan == 0) { return 0; }
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_latency(node);
}

# compensation delay for a node's output (0 if none).
fn dhvani_plan_compensation_delay(plan, id) {
    if (plan == 0) { return 0; }
    var idx = dh_graph_find(DhExecPlan_lc_ids(plan), id);
    if (idx < 0) { return 0; }
    return vec_get(DhExecPlan_lc_vals(plan), idx);
}

# total pipeline latency = max accumulated path latency from source to sink.
# Computed once by compile (no per-call allocation).
#must_use
fn dhvani_plan_total_latency(plan) {
    if (plan == 0) { return 0; }
    return DhExecPlan_total_lat(plan);
}

# ---- GraphProcessor (RT-thread, double-buffered plan swap) ----

# pending = a shared length-1 vec cell (Arc<Mutex<Option<plan>>>); node_outputs
# indexed by DENSE SLOT (0 = None); buf_pool = spare output buffers. Every
# buffer this processor makes is channels x buffer_frames, so a plan swap parks
# the outgoing plan's buffers in buf_pool and the new plan's slots draw from it:
# a swap allocates nothing once the processor has held that many buffers.
#derive(accessors)
struct DhGraphProc {
    current_plan;
    pending;
    node_outputs;
    channels;
    sample_rate;
    buffer_frames;
    input_scratch;
    buf_pool;
}

fn dhvani_graph_proc_new(channels, sample_rate, buffer_frames) {
    var self = alloc(sizeof(DhGraphProc));
    DhGraphProc_set_current_plan(self, 0);
    var cell = vec_new();
    vec_push(cell, 0);
    DhGraphProc_set_pending(self, cell);
    DhGraphProc_set_node_outputs(self, vec_new());
    DhGraphProc_set_channels(self, channels);
    DhGraphProc_set_sample_rate(self, sample_rate);
    DhGraphProc_set_buffer_frames(self, buffer_frames);
    # Reusable per-node input-gather vec. rust-old carries the same field
    # (`input_scratch: Vec<AudioBuffer>` on GraphProcessor, cleared per node);
    # vec_truncate rewinds len and keeps capacity, so steady state is 0 bytes/cycle.
    DhGraphProc_set_input_scratch(self, vec_new());
    DhGraphProc_set_buf_pool(self, vec_new());
    return self;
}

# ---- GraphSwapHandle (non-RT thread hands new plans over the pending cell) ----

#derive(accessors)
struct DhSwapHandle { pending; }

fn dhvani_graph_proc_swap_handle(self) {
    if (self == 0) { return 0; }
    var h = alloc(sizeof(DhSwapHandle));
    DhSwapHandle_set_pending(h, DhGraphProc_pending(self));
    return h;
}

# swap(plan): hand a compiled plan to the processor's next cycle. Returns
# DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER (nothing queued) for a 0
# handle or a 0 plan -- a failed compile is not silently ignored.
fn dhvani_swap_handle_swap(self, plan) {
    if (self == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (plan == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    vec_set(DhSwapHandle_pending(self), 0, plan);
    return DHVANI_ERR_NONE;
}

# Arc clone -> another handle over the same pending cell.
fn dhvani_swap_handle_clone(self) {
    if (self == 0) { return 0; }
    var h = alloc(sizeof(DhSwapHandle));
    DhSwapHandle_set_pending(h, DhSwapHandle_pending(self));
    return h;
}

# An output buffer for a fresh slot: a pooled one (re-stamped with this
# processor's format) when its storage still holds channels x frames samples,
# else a new silent buffer. A pooled buffer a node reshaped is dropped.
fn dh_graph_proc_take_buffer(self) {
    var ch = DhGraphProc_channels(self);
    var bf = DhGraphProc_buffer_frames(self);
    var sr = DhGraphProc_sample_rate(self);
    var pool = DhGraphProc_buf_pool(self);
    while (vec_len(pool) > 0) {
        var b = vec_pop(pool);
        if (vec_len(DhAudioBuffer_samples(b)) == ch * bf) {
            DhAudioBuffer_set_channels(b, ch);
            DhAudioBuffer_set_frames(b, bf);
            DhAudioBuffer_set_sample_rate(b, sr);
            return b;
        }
    }
    return dhvani_buffer_silence(ch, bf, sr);
}

# Process one buffer cycle. Returns the last node's output buffer ptr, or 0 if
# no plan is active.
fn dhvani_graph_proc_process(self) {
    if (self == 0) { return 0; }
    # pick up a pending plan (take() the cell)
    var cell = DhGraphProc_pending(self);
    var newplan = vec_get(cell, 0);
    if (newplan != 0) {
        vec_set(cell, 0, 0);
        # park the outgoing plan's buffers, then one None slot per node of the
        # new plan (rust-old: clear() + resize_with(max_id + 1, None)) -- reusing
        # the slot vec's and the pool's capacity.
        var old = DhGraphProc_node_outputs(self);
        var pool = DhGraphProc_buf_pool(self);
        var oi = 0;
        var on = vec_len(old);
        while (oi < on) {
            var ob = vec_get(old, oi);
            if (ob != 0) { vec_push(pool, ob); }
            oi = oi + 1;
        }
        vec_truncate(old, 0);
        var ns = vec_len(DhExecPlan_ord_nodes(newplan));
        var z = 0;
        while (z < ns) { vec_push(old, 0); z = z + 1; }
        DhGraphProc_set_current_plan(self, newplan);
    }

    var plan = DhGraphProc_current_plan(self);
    if (plan == 0) { return 0; }

    var outputs = DhGraphProc_node_outputs(self);
    var ord_nodes = DhExecPlan_ord_nodes(plan);
    var ord_preds = DhExecPlan_ord_preds(plan);
    var scratch = DhGraphProc_input_scratch(self);

    var np = vec_len(ord_nodes);
    var p = 0;
    while (p < np) {
        # gather input buffers from predecessor slots (reused scratch)
        vec_truncate(scratch, 0);
        var preds = vec_get(ord_preds, p);
        if (preds != 0) {
            var k = 0;
            var kn = vec_len(preds);
            while (k < kn) {
                var pbuf = vec_get(outputs, vec_get(preds, k));
                if (pbuf != 0) { vec_push(scratch, pbuf); }
                k = k + 1;
            }
        }

        # take (or create) this slot's output buffer, then zero it
        var output = vec_get(outputs, p);
        if (output == 0) { output = dh_graph_proc_take_buffer(self); }
        var osamp = dhvani_buffer_samples(output);
        var zn = vec_len(osamp);
        var od = dh_vec_data(osamp);
        var zp = od;
        var zend = od + zn * 8;
        while (zp < zend) { store64(zp, 0); zp = zp + 8; }

        # process (or bypass: copy the first input straight through)
        var node = vec_get(ord_nodes, p);
        if (node != 0) {
            if (dhvani_graph_node_is_bypassed(node) == 1) {
                if (vec_len(scratch) > 0) {
                    # rust-old copy_from_slice panics on a length mismatch; copy
                    # the common prefix instead (the rest stays silent).
                    var fs = dhvani_buffer_samples(vec_get(scratch, 0));
                    var cn = vec_len(fs);
                    if (cn > zn) { cn = zn; }
                    var cs = dh_vec_data(fs);
                    var cend = cs + cn * 8;
                    var cd = od;
                    while (cs < cend) {
                        store64(cd, load64(cs));
                        cs = cs + 8;
                        cd = cd + 8;
                    }
                }
            } else {
                dhvani_graph_node_process(node, scratch, output);
            }
        }

        vec_set(outputs, p, output);
        p = p + 1;
    }

    # return the last node's output slot (0 if None)
    if (np == 0) { return 0; }
    return vec_get(outputs, np - 1);
}

fn dhvani_graph_proc_is_finished(self) {
    if (self == 0) { return 0; }
    var plan = DhGraphProc_current_plan(self);
    if (plan == 0) { return 0; }
    return dhvani_plan_is_finished(plan);
}

# --- graphic_eq.cyr ---

# graphic_eq.cyr -- 10-band ISO graphic equalizer with named presets.
# Ports rust-old/src/dsp/graphic_eq.rs. L2: deps error + simd + buffer + abaco
# + biquad + eq. Wraps ParametricEq (dhvani_eq_*) with fixed ISO center
# frequencies at Q=1.4.
#
# GraphicEqSettings.bands (Rust [f32;10]) -> a `vec` of 10 f64 slots. enabled ->
# integer flag (0/1). preset(name) matches string literals via streq(...) ==
# (the abaco pattern) and returns a settings handle with the 10-band vec.
# ISO_BANDS / BAND_NAMES are functions returning the i-th entry (Cyrius has no
# static array tables; a small if-chain is the idiom, mirroring dhvani_err_name).
#
# rebuild() -- ALLOC-FREE (0 bytes per call): the inner ParametricEq always has
# exactly 10 bands (one per ISO frequency), so rebuild() rewrites each band's
# eq-owned config (gain, enabled) and coefficients in place
# (dhvani_biquad_set_params) instead of allocating a fresh ParametricEq per
# load_preset / set_band / set_settings -- the bump allocator never frees, so a
# fresh eq per parameter change would leak 10 biquads + configs each time. Like the
# oracle's fresh ParametricEq, rebuild() also ZEROES every band's filter state.
#
# Settings are instance-owned: new() starts from the default, load_preset() fills
# the owned settings in place, set_settings() copies the caller's settings in (the
# oracle moves them), so a caller mutating its own handle afterwards changes
# nothing. dhvani_geq_settings() returns the LIVE owned handle (no per-call copy);
# editing it -- e.g. dhvani_geq_settings_set_band(dhvani_geq_settings(eq), b, g) --
# is picked up by the next process(), which rebuilds when the gains differ from the
# ones last applied (the same rebuild set_band does, filter state zeroed).
# serde round-trip + Display tests are the only drops.

# GRAPHIC_EQ_Q = 1.4 (exact hex; 1.4 has no finite binary form so the decimal literal would misparse)
var DH_GEQ_Q          = 0x3FF6666666666666;
var DH_GEQ_MAX_GAIN   = 12.0;                  # MAX_GAIN_DB
# 0.01 (is_flat / enabled threshold; 0.01 is not exactly representable -> hex)
var DH_GEQ_FLAT_EPS   = 0x3F847AE147AE147B;

# ISO center frequency (Hz) for band index i (0..9). All integer-valued so
# decimal literals below 2^24 are safe.
#must_use
fn dhvani_geq_iso_band(i) {
    if (i == 0) { return 31.0; }
    if (i == 1) { return 62.0; }
    if (i == 2) { return 125.0; }
    if (i == 3) { return 250.0; }
    if (i == 4) { return 500.0; }
    if (i == 5) { return 1000.0; }
    if (i == 6) { return 2000.0; }
    if (i == 7) { return 4000.0; }
    if (i == 8) { return 8000.0; }
    return 16000.0;
}

# Display name for band index i (was BAND_NAMES). Out of range -> "?".
#must_use
fn dhvani_geq_band_name(i) {
    if (i == 0) { return "31 Hz"; }
    if (i == 1) { return "62 Hz"; }
    if (i == 2) { return "125 Hz"; }
    if (i == 3) { return "250 Hz"; }
    if (i == 4) { return "500 Hz"; }
    if (i == 5) { return "1 kHz"; }
    if (i == 6) { return "2 kHz"; }
    if (i == 7) { return "4 kHz"; }
    if (i == 8) { return "8 kHz"; }
    if (i == 9) { return "16 kHz"; }
    return "?";
}

# ---- GraphicEqSettings ----
# bands is a `vec` of 10 f64 gains (dB). enabled is 0/1.
#derive(accessors)
struct DhGraphicEqSettings { bands; enabled; }

# default() -- all bands 0 dB, disabled.
#must_use
fn dhvani_geq_settings_default() {
    var s = alloc(sizeof(DhGraphicEqSettings));
    DhGraphicEqSettings_set_bands(s, dh_vec_zeros(10));
    DhGraphicEqSettings_set_enabled(s, 0);
    return s;
}

# flat() -- alias for default (all bands 0 dB, disabled).
#must_use
fn dhvani_geq_settings_flat() {
    return dhvani_geq_settings_default();
}

# is_flat -- true if disabled OR every band's |gain| < 0.01.
#must_use
fn dhvani_geq_settings_is_flat(self) {
    if (DhGraphicEqSettings_enabled(self) == 0) { return 1; }
    var bands = DhGraphicEqSettings_bands(self);
    var i = 0;
    while (i < 10) {
        if (f64_ge(f64_abs(vec_get(bands, i)), DH_GEQ_FLAT_EPS) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# set_band(band, gain_db) -- set a band's gain, clamped to [-12, 12]. No-op if
# band is outside 0..9.
fn dhvani_geq_settings_set_band(self, band, gain_db) {
    if (band < 0) { return 0; }
    if (band < 10) {
        vec_set(DhGraphicEqSettings_bands(self), band,
          f64_clamp(gain_db, f64_neg(DH_GEQ_MAX_GAIN), DH_GEQ_MAX_GAIN));
    }
    return 0;
}

# write preset `name`'s 10 gains into the 10-slot vec b (unknown -> all 0).
#                          31   62  125  250  500   1k   2k   4k   8k  16k
fn dh_geq_preset_fill(b, name) {
    var z = 0;
    while (z < 10) { vec_set(b, z, 0); z = z + 1; }
    if (streq(name, "rock") == 1) {
        vec_set(
          b,
          0,
          4.0); vec_set(b, 1, 3.0); vec_set(b, 2, 1.0); vec_set(b, 3, f64_neg(1.0)); vec_set(b, 4, f64_neg(2.0));
        vec_set(b, 5, 0); vec_set(b, 6, 2.0); vec_set(b, 7, 3.0); vec_set(b, 8, 4.0); vec_set(b, 9, 4.0);
    } elif (streq(name, "pop") == 1) {
        vec_set(b, 0, f64_neg(1.0)); vec_set(b, 1, 1.0); vec_set(b, 2, 3.0); vec_set(b, 3, 4.0); vec_set(b, 4, 3.0);
        vec_set(b, 5, 0); vec_set(b, 6, f64_neg(1.0)); vec_set(b, 7, 0); vec_set(b, 8, 1.0); vec_set(b, 9, 2.0);
    } elif (streq(name, "jazz") == 1) {
        vec_set(b, 0, 2.0); vec_set(b, 1, 1.0); vec_set(b, 2, 0); vec_set(b, 3, 1.0); vec_set(b, 4, f64_neg(1.0));
        vec_set(b, 5, f64_neg(1.0)); vec_set(b, 6, 0); vec_set(b, 7, 1.0); vec_set(b, 8, 2.0); vec_set(b, 9, 3.0);
    } elif (streq(name, "classical") == 1) {
        vec_set(b, 0, 0); vec_set(b, 1, 0); vec_set(b, 2, 0); vec_set(b, 3, 0); vec_set(b, 4, 0);
        vec_set(
          b,
          5,
          0); vec_set(b, 6, f64_neg(2.0)); vec_set(b, 7, f64_neg(3.0)); vec_set(b, 8, f64_neg(2.0)); vec_set(b, 9, 0);
    } elif (streq(name, "bass") == 1) {
        vec_set(b, 0, 6.0); vec_set(b, 1, 5.0); vec_set(b, 2, 4.0); vec_set(b, 3, 2.0); vec_set(b, 4, 0);
        vec_set(b, 5, 0); vec_set(b, 6, 0); vec_set(b, 7, 0); vec_set(b, 8, 0); vec_set(b, 9, 0);
    } elif (streq(name, "treble") == 1) {
        vec_set(b, 0, 0); vec_set(b, 1, 0); vec_set(b, 2, 0); vec_set(b, 3, 0); vec_set(b, 4, 0);
        vec_set(b, 5, 0); vec_set(b, 6, 2.0); vec_set(b, 7, 4.0); vec_set(b, 8, 5.0); vec_set(b, 9, 6.0);
    } elif (streq(name, "vocal") == 1) {
        vec_set(
          b,
          0,
          f64_neg(2.0)); vec_set(b, 1, f64_neg(1.0)); vec_set(b, 2, 0); vec_set(b, 3, 2.0); vec_set(b, 4, 4.0);
        vec_set(b, 5, 4.0); vec_set(b, 6, 3.0); vec_set(b, 7, 1.0); vec_set(b, 8, 0); vec_set(b, 9, f64_neg(1.0));
    } elif (streq(name, "electronic") == 1) {
        vec_set(b, 0, 5.0); vec_set(b, 1, 4.0); vec_set(b, 2, 1.0); vec_set(b, 3, 0); vec_set(b, 4, f64_neg(2.0));
        vec_set(b, 5, 0); vec_set(b, 6, 1.0); vec_set(b, 7, 3.0); vec_set(b, 8, 4.0); vec_set(b, 9, 5.0);
    } elif (streq(name, "acoustic") == 1) {
        vec_set(b, 0, 2.0); vec_set(b, 1, 1.0); vec_set(b, 2, 0); vec_set(b, 3, 1.0); vec_set(b, 4, 2.0);
        vec_set(b, 5, 1.0); vec_set(b, 6, 2.0); vec_set(b, 7, 3.0); vec_set(b, 8, 2.0); vec_set(b, 9, 1.0);
    }
    # else: unknown -> all zeros (already zeroed).
    return 0;
}

# preset(name) -- named preset. Unknown names -> flat (all 0), enabled=true.
#must_use
fn dhvani_geq_settings_preset(name) {
    var b = dh_vec_zeros(10);
    dh_geq_preset_fill(b, name);
    var s = alloc(sizeof(DhGraphicEqSettings));
    DhGraphicEqSettings_set_bands(s, b);
    DhGraphicEqSettings_set_enabled(s, 1);
    return s;
}

# preset_count / preset_name(i) -- the available preset names (was
# preset_names() -> &'static [&str]). "flat" first, then the 9 named presets.
#must_use
fn dhvani_geq_preset_count() { return 10; }
#must_use
fn dhvani_geq_preset_name(i) {
    if (i == 0) { return "flat"; }
    if (i == 1) { return "rock"; }
    if (i == 2) { return "pop"; }
    if (i == 3) { return "jazz"; }
    if (i == 4) { return "classical"; }
    if (i == 5) { return "bass"; }
    if (i == 6) { return "treble"; }
    if (i == 7) { return "vocal"; }
    if (i == 8) { return "electronic"; }
    if (i == 9) { return "acoustic"; }
    return "?";
}

# --- GraphicEqSettings accessors ---
#inline
#must_use
fn dhvani_geq_settings_bands(self) { return DhGraphicEqSettings_bands(self); }
# band gain at index i (0 if outside 0..9).
#must_use
fn dhvani_geq_settings_band(self, i) {
    if (i < 0) { return 0; }
    if (i < 10) { return vec_get(DhGraphicEqSettings_bands(self), i); }
    return 0;
}

# copy src's 10 gains + enabled into dst (no allocation). A caller-built settings
# whose bands vec is shorter than 10 reads as 0 dB for the missing bands.
fn dh_geq_settings_copy_into(dst, src) {
    var db = DhGraphicEqSettings_bands(dst);
    var sb = DhGraphicEqSettings_bands(src);
    var n = dh_imin(vec_len(sb), 10);
    var i = 0;
    while (i < 10) {
        var g = 0;
        if (i < n) { g = vec_get(sb, i); }
        vec_set(db, i, g);
        i = i + 1;
    }
    DhGraphicEqSettings_set_enabled(dst, DhGraphicEqSettings_enabled(src));
    return 0;
}
#inline
#must_use
fn dhvani_geq_settings_enabled(self) { return DhGraphicEqSettings_enabled(self); }

# ---- GraphicEq ----
# applied = the 10 gains the inner eq was last rebuilt with (see header).
#derive(accessors)
struct DhGraphicEq { inner; settings; sample_rate; channels; applied; }

# build_eq(settings, sample_rate, channels) -- a fresh ParametricEq with 10
# peaking bands at the ISO frequencies, Q=1.4, each enabled iff |gain| >= 0.01.
#must_use
fn dhvani_geq_build_eq(settings, sample_rate, channels) {
    var bands = DhGraphicEqSettings_bands(settings);
    var cfgs = vec_new();
    var i = 0;
    while (i < 10) {
        var gain_db = vec_get(bands, i);
        var enabled = 0;
        if (f64_ge(f64_abs(gain_db), DH_GEQ_FLAT_EPS) == 1) { enabled = 1; }
        vec_push(cfgs, dhvani_eq_band_config_new(DH_BAND_PEAKING, dhvani_geq_iso_band(i), gain_db, DH_GEQ_Q, enabled));
        i = i + 1;
    }
    return dhvani_eq_new(cfgs, sample_rate, channels);
}

# new(sample_rate, channels) -- all bands flat, disabled.
#must_use
fn dhvani_geq_new(sample_rate, channels) {
    var self = alloc(sizeof(DhGraphicEq));
    var settings = dhvani_geq_settings_default();
    DhGraphicEq_set_settings(self, settings);
    DhGraphicEq_set_inner(self, dhvani_geq_build_eq(settings, sample_rate, channels));
    DhGraphicEq_set_sample_rate(self, sample_rate);
    DhGraphicEq_set_channels(self, channels);
    DhGraphicEq_set_applied(self, dh_vec_zeros(10));
    return self;
}

# rebuild -- ALLOC-FREE: re-derive the 10 bands from the current settings into
# the existing inner ParametricEq: each band's owned config gets its gain + enabled
# flag (|gain| >= 0.01), its coefficients are redesigned in place at the inner
# eq's rate, and its filter state is zeroed -- the values of the oracle's fresh
# `build_eq`, with no eq/biquad/config allocation.
fn dhvani_geq_rebuild(self) {
    var inner = DhGraphicEq_inner(self);
    var cfgs = DhParametricEq_configs(inner);
    var filts = DhParametricEq_filts(inner);
    var bands = DhGraphicEqSettings_bands(DhGraphicEq_settings(self));
    var applied = DhGraphicEq_applied(self);
    var i = 0;
    while (i < 10) {
        var gain_db = vec_get(bands, i);
        var enabled = 0;
        if (f64_ge(f64_abs(gain_db), DH_GEQ_FLAT_EPS) == 1) { enabled = 1; }
        var cfg = vec_get(cfgs, i);
        DhEqBandConfig_set_gain_db(cfg, gain_db);
        DhEqBandConfig_set_enabled(cfg, enabled);
        var filt = vec_get(filts, i);
        dhvani_biquad_set_params(filt, DH_BQ_PEAKING, gain_db, dhvani_geq_iso_band(i), DH_GEQ_Q);
        dhvani_biquad_reset(filt);
        vec_set(applied, i, gain_db);
        i = i + 1;
    }
    return 0;
}

# 1 iff the settings' gains differ (bitwise) from the ones last applied.
#must_use
fn dh_geq_settings_changed(self) {
    var bands = DhGraphicEqSettings_bands(DhGraphicEq_settings(self));
    var applied = DhGraphicEq_applied(self);
    var i = 0;
    while (i < 10) {
        if (vec_get(bands, i) != vec_get(applied, i)) { return 1; }
        i = i + 1;
    }
    return 0;
}

# process(buf) -- run the 10-band EQ in place. Bypass entirely if flat/disabled.
# Adapts to a changed sample rate (or to settings edited through the live
# dhvani_geq_settings handle) with a rebuild before processing.
fn dhvani_geq_process(self, buf) {
    if (dhvani_geq_settings_is_flat(DhGraphicEq_settings(self)) == 1) { return 0; }
    var bsr = DhAudioBuffer_sample_rate(buf);
    if (bsr != DhGraphicEq_sample_rate(self)) {
        DhGraphicEq_set_sample_rate(self, bsr);
        # sample rate changed: move the inner eq + its filters to the new rate
        # (fields only), then one rebuild designs every band at it.
        var inner = DhGraphicEq_inner(self);
        DhParametricEq_set_sample_rate(inner, bsr);
        var filts = DhParametricEq_filts(inner);
        var f = 0;
        while (f < vec_len(filts)) { DhBiquadFilter_set_sample_rate(vec_get(filts, f), bsr); f = f + 1; }
        dhvani_geq_rebuild(self);
    } elif (dh_geq_settings_changed(self) == 1) {
        dhvani_geq_rebuild(self);
    }
    dhvani_eq_process(DhGraphicEq_inner(self), buf);
    return 0;
}

# load_preset(name) -- fill the owned settings with a named preset (enabled),
# rebuild coeffs. Zero bytes per call.
fn dhvani_geq_load_preset(self, name) {
    var settings = DhGraphicEq_settings(self);
    dh_geq_preset_fill(DhGraphicEqSettings_bands(settings), name);
    DhGraphicEqSettings_set_enabled(settings, 1);
    dhvani_geq_rebuild(self);
    return 0;
}

# set_band(band, gain_db) -- set a band's gain, rebuild coeffs (state zeroed, as
# the oracle; an out-of-range band still rebuilds, as the oracle). Zero bytes.
fn dhvani_geq_set_band(self, band, gain_db) {
    dhvani_geq_settings_set_band(DhGraphicEq_settings(self), band, gain_db);
    dhvani_geq_rebuild(self);
    return 0;
}

# set_settings(settings) -- copy the caller's settings into the owned ones (the
# caller keeps its handle), rebuild coeffs. Zero bytes per call.
fn dhvani_geq_set_settings(self, settings) {
    var own = DhGraphicEq_settings(self);
    if (settings != own) { dh_geq_settings_copy_into(own, settings); }
    dhvani_geq_rebuild(self);
    return 0;
}

# settings() -- the LIVE owned settings handle (no copy, no allocation). Gains
# edited through it are applied by the next process() (see header).
#inline
#must_use
fn dhvani_geq_settings(self) { return DhGraphicEq_settings(self); }

# set_enabled(enabled) -- toggle the EQ without rebuilding.
fn dhvani_geq_set_enabled(self, enabled) {
    DhGraphicEqSettings_set_enabled(DhGraphicEq_settings(self), enabled);
    return 0;
}

# reset() -- clear inner filter state (call on seek / track change).
fn dhvani_geq_reset(self) {
    dhvani_eq_reset(DhGraphicEq_inner(self));
    return 0;
}

# --- key.cyr ---

# key.cyr -- Krumhansl-Schmuckler key detection from a chromagram.
# Ports rust-old/src/analysis/key.rs. Classifies audio into one of 24 keys
# (12 major + 12 minor) by correlating the 12-bin chromagram against rotated
# Krumhansl-Kessler major/minor profiles (Pearson correlation).
# L1: deps error + simd + buffer + abaco + analysis (Spectrum) + fft +
# chroma (Chromagram). serde + Display dropped.
#
# KeyResult fields: key (name string), root (0..11 pitch class), is_major (0/1),
# confidence (0..1), correlations (24-slot vec: [12 major..., 12 minor...]).

# ---- PITCH_NAMES lookup (was [&str; 12]) -- the same table as chroma's
# PITCH_CLASSES, so it delegates rather than keeping a second copy.
#must_use
fn dhvani_key_pitch_name(idx) { return dhvani_chroma_pitch_class_name(idx); }

# ---- MAJOR_PROFILE (Krumhansl-Kessler) as a 12-slot vec ----
# [6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88]
#must_use
fn dhvani_key_major_profile() {
    var p = vec_new();
    vec_push(p, 6.35);
    vec_push(p, 2.23);
    vec_push(p, 3.48);
    vec_push(p, 2.33);
    vec_push(p, 4.38);
    vec_push(p, 4.09);
    vec_push(p, 2.52);
    vec_push(p, 5.19);
    vec_push(p, 2.39);
    vec_push(p, 3.66);
    vec_push(p, 2.29);
    vec_push(p, 2.88);
    return p;
}

# ---- MINOR_PROFILE (Krumhansl-Kessler) as a 12-slot vec ----
# [6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17]
#must_use
fn dhvani_key_minor_profile() {
    var p = vec_new();
    vec_push(p, 6.33);
    vec_push(p, 2.68);
    vec_push(p, 3.52);
    vec_push(p, 5.38);
    vec_push(p, 2.60);
    vec_push(p, 3.53);
    vec_push(p, 2.54);
    vec_push(p, 4.75);
    vec_push(p, 3.98);
    vec_push(p, 2.69);
    vec_push(p, 3.34);
    vec_push(p, 3.17);
    return p;
}

#derive(accessors)
struct DhKeyResult { key; root; is_major; confidence; correlations; }

# --- accessors ---
#inline
#must_use
fn dhvani_key_result_key(self) { return DhKeyResult_key(self); }
#inline
#must_use
fn dhvani_key_result_root(self) { return DhKeyResult_root(self); }
#inline
#must_use
fn dhvani_key_result_is_major(self) { return DhKeyResult_is_major(self); }
#inline
#must_use
fn dhvani_key_result_confidence(self) { return DhKeyResult_confidence(self); }
#inline
#must_use
fn dhvani_key_result_correlations(self) { return DhKeyResult_correlations(self); }

# Full key name for (root, is_major): e.g. "C major", "A minor".
# (Replaces the Rust format!("{} {mode}", PITCH_NAMES[root]).)
#must_use
fn dhvani_key_name(root, is_major) {
    if (is_major == 1) {
        if (root == 0)  { return "C major"; }
        if (root == 1)  { return "C# major"; }
        if (root == 2)  { return "D major"; }
        if (root == 3)  { return "D# major"; }
        if (root == 4)  { return "E major"; }
        if (root == 5)  { return "F major"; }
        if (root == 6)  { return "F# major"; }
        if (root == 7)  { return "G major"; }
        if (root == 8)  { return "G# major"; }
        if (root == 9)  { return "A major"; }
        if (root == 10) { return "A# major"; }
        if (root == 11) { return "B major"; }
        return "unknown major";
    }
    if (root == 0)  { return "C minor"; }
    if (root == 1)  { return "C# minor"; }
    if (root == 2)  { return "D minor"; }
    if (root == 3)  { return "D# minor"; }
    if (root == 4)  { return "E minor"; }
    if (root == 5)  { return "F minor"; }
    if (root == 6)  { return "F# minor"; }
    if (root == 7)  { return "G minor"; }
    if (root == 8)  { return "G# minor"; }
    if (root == 9)  { return "A minor"; }
    if (root == 10) { return "A# minor"; }
    if (root == 11) { return "B minor"; }
    return "unknown minor";
}

# Pearson correlation between a 12-slot chroma `vec` and a 12-slot key profile
# `vec` rotated to `root`. Mirrors the Rust helper exactly.
#must_use
fn dhvani_key_pearson_correlation(chroma, profile, root) {
    var n = 12.0;

    # Compute means.
    var chroma_sum = 0;
    var profile_sum = 0;
    var s = 0;
    while (s < 12) {
        chroma_sum = f64_add(chroma_sum, vec_get(chroma, s));
        profile_sum = f64_add(profile_sum, vec_get(profile, s));
        s = s + 1;
    }
    var chroma_mean = f64_div(chroma_sum, n);
    var profile_mean = f64_div(profile_sum, n);

    var cov = 0;
    var var_chroma = 0;
    var var_profile = 0;
    var i = 0;
    while (i < 12) {
        var c = f64_sub(vec_get(chroma, (i + root) % 12), chroma_mean);
        var p = f64_sub(vec_get(profile, i), profile_mean);
        cov = f64_add(cov, f64_mul(c, p));
        var_chroma = f64_add(var_chroma, f64_mul(c, c));
        var_profile = f64_add(var_profile, f64_mul(p, p));
        i = i + 1;
    }

    var denom = f64_sqrt(f64_mul(var_chroma, var_profile));
    if (f64_gt(denom, 0.0000000001) == 1) { return f64_div(cov, denom); }
    return 0;
}

# Descending in-place insertion sort of a `vec` of f64 (mirrors Rust
# sort_by(|a,b| b.partial_cmp(a)) with the correlations we produce being finite).
fn dhvani_key_sort_desc(v) {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var key_v = vec_get(v, i);
        var j = i - 1;
        var cont = 1;
        while (cont == 1) {
            if (j < 0) { cont = 0; }
            elif (f64_lt(vec_get(v, j), key_v) == 1) {
                vec_set(v, j + 1, vec_get(v, j));
                j = j - 1;
            } else { cont = 0; }
        }
        vec_set(v, j + 1, key_v);
        i = i + 1;
    }
    return 0;
}

# detect_key_from_chroma(chroma) -- detect key from a pre-computed chromagram;
# 0 (null) for a null chromagram (e.g. a rejected dhvani_chromagram_from_array).
#must_use
fn dhvani_key_detect_from_chroma(chroma) {
    if (chroma == 0) { return 0; }
    var chroma_vals = dhvani_chromagram_chroma(chroma);
    var major_profile = dhvani_key_major_profile();
    var minor_profile = dhvani_key_minor_profile();
    var correlations = dh_vec_zeros(24);
    var best_idx = 0;
    var best_corr = DH_NEG_INF;

    # Test all 24 keys (12 major + 12 minor).
    var root = 0;
    while (root < 12) {
        var major_corr = dhvani_key_pearson_correlation(chroma_vals, major_profile, root);
        vec_set(correlations, root, major_corr);
        if (f64_gt(major_corr, best_corr) == 1) {
            best_corr = major_corr;
            best_idx = root;
        }

        var minor_corr = dhvani_key_pearson_correlation(chroma_vals, minor_profile, root);
        vec_set(correlations, 12 + root, minor_corr);
        if (f64_gt(minor_corr, best_corr) == 1) {
            best_corr = minor_corr;
            best_idx = 12 + root;
        }
        root = root + 1;
    }

    var is_major = 0;
    if (best_idx < 12) { is_major = 1; }
    var root_out = best_idx % 12;
    var key = dhvani_key_name(root_out, is_major);

    # Confidence: how much better is the best match vs second-best?
    var sorted = vec_new();
    var si = 0;
    while (si < 24) { vec_push(sorted, vec_get(correlations, si)); si = si + 1; }
    dhvani_key_sort_desc(sorted);
    var confidence = 0;
    if (f64_gt(vec_get(sorted, 0), 0.0) == 1) {
        var s0 = vec_get(sorted, 0);
        var s1 = vec_get(sorted, 1);
        var raw = f64_div(f64_sub(s0, s1), f64_max(f64_abs(s0), 0.001));
        confidence = f64_clamp(raw, 0.0, 1.0);
    }

    var self = alloc(sizeof(DhKeyResult));
    DhKeyResult_set_key(self, key);
    DhKeyResult_set_root(self, root_out);
    DhKeyResult_set_is_major(self, is_major);
    DhKeyResult_set_confidence(self, confidence);
    DhKeyResult_set_correlations(self, correlations);
    return self;
}

# detect_key(buf, window_size) -- compute a chromagram, then detect the key.
# Returns a KeyResult handle, or 0 if the chromagram computation fails.
#must_use
fn dhvani_key_detect(buf, window_size) {
    var chroma = dhvani_chroma_chromagram(buf, window_size);
    if (chroma == 0) { return 0; }
    return dhvani_key_detect_from_chroma(chroma);
}

# --- onset.cyr ---

# onset.cyr -- Onset detection via spectral flux.
# Ports rust-old/src/analysis/onset.rs. L1: deps error + simd + buffer +
# abaco + analysis + fft + stft (dhvani_stft). Frames the signal, computes the
# per-frame spectral difference (sum of positive bin-to-bin increases), normalizes
# the flux by its peak, and peak-picks local maxima above a threshold.
#
# OnsetResult.positions was Vec<usize> (sample positions), strengths Vec<f32>.
# Here each is a `vec`: positions holds integer sample offsets, strengths holds
# f64 flux values. detect_onsets is fallible in Rust (STFT can fail) -> returns a
# valid result handle, or 0 (null) on STFT error. On < 2 frames it returns an
# empty (but non-null) result, matching the Rust Ok(empty).

#derive(accessors)
struct DhOnsetResult { positions; strengths; }

# frame positions (in samples) of detected onsets.
#inline
#must_use
fn dhvani_onset_positions(self) { return DhOnsetResult_positions(self); }

# spectral flux values at each onset.
#inline
#must_use
fn dhvani_onset_strengths(self) { return DhOnsetResult_strengths(self); }

# number of detected onsets.
#inline
#must_use
fn dhvani_onset_count(self) { return vec_len(DhOnsetResult_positions(self)); }

# position (sample offset) of onset index i.
#inline
#must_use
fn dhvani_onset_position(self, i) { return vec_get(DhOnsetResult_positions(self), i); }

# strength (flux) of onset index i.
#inline
#must_use
fn dhvani_onset_strength(self, i) { return vec_get(DhOnsetResult_strengths(self), i); }

# spectral_flux(sg) -- the onset strength envelope shared by detect_onsets and
# beat's onset_strength_envelope (identical in rust-old: onset.rs's flux before
# peak-picking == beat.rs's envelope). flux[0] = 0 (no predecessor), flux[i] =
# sum over bins of the positive increases frame[i] - frame[i-1], then normalized
# by its peak (folded from 0.0, NaN-ignoring like the oracle's f32::max).
# Returns a `vec` of num_frames f64 values, or an empty vec when < 2 frames.
#must_use
fn dhvani_spectral_flux(sg) {
    var flux = vec_new();
    var num_frames = dhvani_spectrogram_num_frames(sg);
    if (num_frames < 2) { return flux; }
    var num_bins = dhvani_spectrogram_num_bins(sg);

    vec_push(flux, 0); # First frame has no predecessor.
    var prevv = dhvani_spectrogram_frame(sg, 0);
    var i = 1;
    while (i < num_frames) {
        var diff_sum = 0;
        var curv = dhvani_spectrogram_frame(sg, i);
        # raw reads: never past either frame (stft frames are num_bins long)
        var nb = dh_imin(num_bins, dh_imin(vec_len(curv), vec_len(prevv)));
        var cur = dh_vec_data(curv);
        var prev = dh_vec_data(prevv);
        var bin = 0;
        while (bin < nb) {
            var diff = f64_sub(load64(cur + bin * 8), load64(prev + bin * 8));
            if (f64_gt(diff, 0) == 1) { diff_sum = f64_add(diff_sum, diff); }
            bin = bin + 1;
        }
        vec_push(flux, diff_sum);
        prevv = curv;
        i = i + 1;
    }

    # Normalize flux by its peak (fold over 0.0, so >= 0). Storage taken after
    # the last push (a push may move it).
    var flux_len = vec_len(flux);
    var fd = dh_vec_data(flux);
    var max_flux = 0;
    var m = 0;
    while (m < flux_len) { max_flux = dh_max_ignore_nan(max_flux, load64(fd + m * 8)); m = m + 1; }
    if (f64_gt(max_flux, 0) == 1) {
        var n = 0;
        while (n < flux_len) { store64(fd + n * 8, f64_div(load64(fd + n * 8), max_flux)); n = n + 1; }
    }
    return flux;
}

# build an OnsetResult from positions + strengths vecs.
#must_use
fn dhvani_onset_make_result(positions, strengths) {
    var self = alloc(sizeof(DhOnsetResult));
    DhOnsetResult_set_positions(self, positions);
    DhOnsetResult_set_strengths(self, strengths);
    return self;
}

# detect_onsets(buf, window_size, hop_size, threshold) -- spectral-flux onsets.
# Returns a result handle, or 0 on STFT error (incl. hop_size <= 0). With < 2
# STFT frames returns an empty result. threshold is an f64 sensitivity (lower =
# more sensitive).
#must_use
fn dhvani_detect_onsets(buf, window_size, hop_size, threshold) {
    var sg = dhvani_stft(buf, window_size, hop_size);
    if (sg == 0) { return 0; }

    # Spectral flux: sum of positive differences between consecutive frames,
    # normalized by its peak (dhvani_spectral_flux, shared with beat).
    var flux = dhvani_spectral_flux(sg);
    var flux_len = vec_len(flux);
    if (flux_len < 2) {
        return dhvani_onset_make_result(vec_new(), vec_new());
    }

    # Peak-pick: flux values above threshold that are local maxima.
    var positions = vec_new();
    var strengths = vec_new();

    # flux.len().saturating_sub(1); num_frames >= 2 so flux_len >= 2.
    var upper = flux_len - 1;
    var p = 1;
    while (p < upper) {
        var fp = vec_get(flux, p);
        if (f64_gt(fp, threshold) == 1) {
            if (f64_gt(fp, vec_get(flux, p - 1)) == 1) {
                if (f64_ge(fp, vec_get(flux, p + 1)) == 1) {
                    vec_push(positions, p * hop_size);
                    vec_push(strengths, fp);
                }
            }
        }
        p = p + 1;
    }

    return dhvani_onset_make_result(positions, strengths);
}

# --- beat.cyr ---

# beat.cyr -- Beat and tempo detection via autocorrelation of the onset
# strength function. Ports rust-old/src/analysis/beat.rs. L1: deps error +
# simd + buffer + abaco + analysis + fft + stft (dhvani_stft) + onset
# (dhvani_spectral_flux).
#
# BeatResult had bpm (f32), confidence (f32), beat_positions (Vec<usize>).
# Here bpm/confidence are f64 slots and beat_positions is a `vec` of integer
# sample offsets. detect_tempo is fallible in Rust: the < 1s guard is an Err ->
# here returns 0 (null) so tests can check `!= 0`. STFT failure also -> 0. All
# other early-return Ok(empty/zero) cases return a valid (non-null) handle with
# bpm=0, confidence=0, empty beat_positions.
#
# The onset strength envelope is spectral flux over EVERY STFT frame
# (envelope[0] = 0), normalized by its peak -- exactly the flux onset.cyr's
# detect_onsets peak-picks, so both use dhvani_spectral_flux (onset.cyr).

#derive(accessors)
struct DhBeatResult { bpm; confidence; beat_positions; }

# ---- BeatResult accessors ----
#inline
#must_use
fn dhvani_beat_bpm(self) { return DhBeatResult_bpm(self); }
#inline
#must_use
fn dhvani_beat_confidence(self) { return DhBeatResult_confidence(self); }
#inline
#must_use
fn dhvani_beat_positions(self) { return DhBeatResult_beat_positions(self); }
#inline
#must_use
fn dhvani_beat_count(self) { return vec_len(DhBeatResult_beat_positions(self)); }
#inline
#must_use
fn dhvani_beat_position(self, i) { return vec_get(DhBeatResult_beat_positions(self), i); }

# build a BeatResult from bpm + confidence + beat_positions vec.
#must_use
fn dhvani_beat_make_result(bpm, confidence, beat_positions) {
    var self = alloc(sizeof(DhBeatResult));
    DhBeatResult_set_bpm(self, bpm);
    DhBeatResult_set_confidence(self, confidence);
    DhBeatResult_set_beat_positions(self, beat_positions);
    return self;
}

# a zero result: bpm=0, confidence=0, empty beat_positions (the Ok(empty) cases).
#must_use
fn dhvani_beat_zero_result() {
    return dhvani_beat_make_result(0, 0, vec_new());
}

# Compute onset strength envelope (spectral flux per STFT frame). Returns a
# `vec` of f64 flux values (envelope[0] = 0), normalized by its peak; or 0
# (null) on STFT error, or an empty vec (non-null) when < 2 frames.
#must_use
fn dhvani_beat_onset_strength_envelope(buf, window_size, hop_size) {
    var sg = dhvani_stft(buf, window_size, hop_size);
    if (sg == 0) { return 0; }
    return dhvani_spectral_flux(sg);
}

# Autocorrelation of a signal over a lag range. result has length max_lag+1;
# result[lag] = (sum_i signal[i]*signal[i+lag]) / (n - lag) for lag in
# min_lag..=max_lag, zero elsewhere.
#inline
#must_use
fn dhvani_beat_autocorrelation(signal, min_lag, max_lag) {
    var n = vec_len(signal);
    var result = dh_vec_zeros(max_lag + 1);

    var lag = min_lag;
    while (lag <= max_lag) {
        var sum = 0;
        var count = n - lag;
        var i = 0;
        while (i < count) {
            sum = f64_add(sum, f64_mul(vec_get(signal, i), vec_get(signal, i + lag)));
            i = i + 1;
        }
        vec_set(result, lag, f64_div(sum, f64_from(count)));
        lag = lag + 1;
    }

    return result;
}

# Find the peak in the autocorrelation result. Writes best_lag, best_val,
# max_val via out-pointers (Rust returned a 3-tuple). Iterates lag from min_lag
# to len-1 (autocorr.iter().enumerate().skip(min_lag)).
fn dhvani_beat_find_peak(autocorr, min_lag, out_best_lag, out_best_val, out_max_val) {
    var best_lag = min_lag;
    var best_val = 0;
    var max_val = 0;

    var len = vec_len(autocorr);
    var lag = min_lag;
    while (lag < len) {
        var val = vec_get(autocorr, lag);
        if (f64_gt(val, max_val) == 1) { max_val = val; }
        if (f64_gt(val, best_val) == 1) { best_val = val; best_lag = lag; }
        lag = lag + 1;
    }

    store64(out_best_lag, best_lag);
    store64(out_best_val, best_val);
    store64(out_max_val, max_val);
    return 0;
}

# Extract beat positions from the onset envelope using the detected period.
# Returns a `vec` of integer sample offsets.
#must_use
fn dhvani_beat_extract_beats(buf, onset_env, hop_size, period_frames) {
    var beats = vec_new();
    var env_len = vec_len(onset_env);
    if (period_frames == 0) { return beats; }
    if (env_len == 0) { return beats; }

    var half_window = period_frames / 4;
    # buf.frames * buf.channels (interleaved sample count; the oracle compares a
    # mono-frame position against it -- kept for parity).
    var total = DhAudioBuffer_frames(buf) * DhAudioBuffer_channels(buf);

    var pos = 0;
    while (pos < env_len) {
        # start = pos.saturating_sub(half_window)
        var start = 0;
        if (pos > half_window) { start = pos - half_window; }
        # end = (pos + half_window).min(env_len)
        var end = pos + half_window;
        if (end > env_len) { end = env_len; }

        # Find strongest onset in window; default best_idx = min(pos, env_len-1).
        var best_idx = pos;
        if (best_idx > env_len - 1) { best_idx = env_len - 1; }
        var best_strength = 0;
        var i = start;
        while (i < end) {
            var strength = vec_get(onset_env, i);
            if (f64_gt(strength, best_strength) == 1) {
                best_strength = strength;
                best_idx = i;
            }
            i = i + 1;
        }

        var sample_pos = best_idx * hop_size;
        if (sample_pos < total) { vec_push(beats, sample_pos); }

        pos = pos + period_frames;
    }

    return beats;
}

# detect_tempo(buf, min_bpm, max_bpm) -- tempo + beat positions.
# Returns a BeatResult handle, or 0 (null) if the buffer is < 1 second (Err)
# or on STFT failure. min_bpm/max_bpm are f64.
#must_use
fn dhvani_detect_tempo(buf, min_bpm, max_bpm) {
    var duration_s = f64_div(f64_from(DhAudioBuffer_frames(buf)), f64_from(DhAudioBuffer_sample_rate(buf)));
    if (f64_lt(duration_s, 1.0) == 1) { return 0; }

    # Step 1: onset strength envelope via spectral flux.
    var window_size = 2048;
    var hop_size = 512;
    var onset_env = dhvani_beat_onset_strength_envelope(buf, window_size, hop_size);
    if (onset_env == 0) { return 0; }

    if (vec_len(onset_env) < 4) { return dhvani_beat_zero_result(); }

    # Step 2: autocorrelation of the onset envelope.
    # onset_sr = sample_rate / hop_size (frames per second)
    var onset_sr = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(hop_size));
    # min_lag = (onset_sr * 60 / max_bpm) as usize
    var min_lag = f64_to(f64_trunc(f64_div(f64_mul(onset_sr, 60.0), max_bpm)));
    # max_lag = (onset_sr * 60 / min_bpm) as usize
    var max_lag = f64_to(f64_trunc(f64_div(f64_mul(onset_sr, 60.0), min_bpm)));
    # Rust's float->int `as usize` SATURATES to 0..=usize::MAX. f64_to saturates
    # too (NaN -> 0, +inf / too large -> i64::MAX, so min_bpm = 0 still means "no
    # lower bound" and max_bpm = 0 an empty range, as in the oracle), but its
    # range is signed: a negative bpm gives a negative lag, which reached vec_get
    # as a negative index and aborted. Clamp it to usize's floor of 0.
    if (min_lag < 0) { min_lag = 0; }
    if (max_lag < 0) { max_lag = 0; }
    # max_lag = max_lag.min(onset_env.len() / 2)
    var half_env = vec_len(onset_env) / 2;
    if (max_lag > half_env) { max_lag = half_env; }

    if (min_lag >= max_lag) { return dhvani_beat_zero_result(); }
    if (max_lag == 0) { return dhvani_beat_zero_result(); }

    var autocorr = dhvani_beat_autocorrelation(onset_env, min_lag, max_lag);

    # Step 3: find peak -> dominant tempo.
    # out-slots on the stack (a heap alloc(8) per slot leaked under the bump allocator)
    var best_lag_p[8];
    var best_val_p[8];
    var max_val_p[8];
    dhvani_beat_find_peak(autocorr, min_lag, &best_lag_p, &best_val_p, &max_val_p);
    var best_lag = load64(&best_lag_p);
    var best_val = load64(&best_val_p);
    var max_val = load64(&max_val_p);

    if (f64_le(max_val, 0) == 1) { return dhvani_beat_zero_result(); }

    var bpm = f64_div(f64_mul(onset_sr, 60.0), f64_from(best_lag));
    var confidence = f64_clamp(f64_div(best_val, max_val), 0, 1.0);

    # Step 4: extract beat positions using the detected period.
    var beat_positions = dhvani_beat_extract_beats(buf, onset_env, hop_size, best_lag);

    return dhvani_beat_make_result(bpm, confidence, beat_positions);
}

# --- synthesis.cyr ---

# synthesis.cyr -- naad synthesis engines bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/synthesis/mod.rs. The Rust module is ~90 lines of
# `pub use naad::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call naad's bare symbols -- osc_new / fm_engine_new / drum_kick_new / ... --
# directly) plus two closure-based render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + naad (via ordered include; see
# docs/development/port-audit.md Wave F include order). Rust `impl FnMut()`
# closures -> fn-ptr + opaque state, dispatched with fncall1 / fncall3 (fnptr
# stdlib). The per-frame sample callback returns an f64 (bit pattern in the
# i64 return slot), so naad's `*_next_sample(self)` fns are valid callbacks as-is.
#
# `state` is opaque and may legitimately be 0 (a stateless callback), but it is
# never NEGATIVE: that is a sibling constructor's error code (naad's osc_new etc.),
# which the callback would dereference. The bridges refuse a negative state and a
# null fn-ptr (0) before calling anything.
#
# Output is built with ONE exact allocation (dh_vec_zeros, then walked stores):
# the push-grown vec this replaced allocated ~2x the payload per call. For
# per-block rendering use the `_into` forms, which write a caller-owned buffer and
# allocate nothing.

# render_to_buffer: call sample_fp(state) once per frame, duplicate the mono
# sample across `channels`, and assemble an interleaved AudioBuffer. Falls back
# to silence if construction fails (matches the Rust unwrap_or_else). 0 for a null
# sample_fp, a negative (error-code) state, or a refused allocation.
#must_use
fn dhvani_synth_render_to_buffer(sample_fp, state, channels, frames, sample_rate) {
    if (sample_fp == 0) { return 0; }
    if (state < 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var n = 0;
    if (channels > 0) { n = nf * channels; }
    var samples = dh_vec_zeros(n);
    if (vec_len(samples) != n) { return 0; }
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < nf) {
        var s = fncall1(sample_fp, state);
        var c = 0;
        while (c < channels) { store64(d, s); d = d + 8; c = c + 1; }
        i = i + 1;
    }
    # channels < 1: rust-old's from_interleaved fails (u32 0) -> silence(1, ..); a
    # negative count must not reach from_interleaved, which only rejects 0.
    var buf = 0;
    if (channels > 0) { buf = dhvani_buffer_from_interleaved(samples, channels, sample_rate); }
    if (buf == 0) {
        var ch = channels;
        if (ch < 1) { ch = 1; }
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(ch, nf, sr);
    }
    return buf;
}

# render_into: the alloc-free per-block form. Calls sample_fp(state) once per frame
# of `buf` (its own frame count) and writes the sample into every channel, in
# place. DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for a null buffer / fn-ptr
# or a negative state (buf untouched).
fn dhvani_synth_render_into(sample_fp, state, buf) {
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (sample_fp == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (state < 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var ch = dhvani_buffer_channels(buf);
    if (ch < 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var samples = dhvani_buffer_samples(buf);
    var frames = dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch);
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < frames) {
        var s = fncall1(sample_fp, state);
        var c = 0;
        while (c < ch) { store64(d, s); d = d + 8; c = c + 1; }
        i = i + 1;
    }
    return DHVANI_ERR_NONE;
}

# render_stereo_to_buffer: sample_fp(state, out_l, out_r) writes (left, right)
# per frame through out-pointers (the Rust closure returned an (f32, f32) tuple).
# The out slots live on this frame's stack. 0 for a null fn-ptr, a negative state,
# or a refused allocation.
#must_use
fn dhvani_synth_render_stereo_to_buffer(sample_fp, state, frames, sample_rate) {
    if (sample_fp == 0) { return 0; }
    if (state < 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var samples = dh_vec_zeros(nf * 2);
    if (vec_len(samples) != nf * 2) { return 0; }
    var lr[16];
    store64(&lr, 0);
    store64(&lr + 8, 0);
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < nf) {
        fncall3(sample_fp, state, &lr, &lr + 8);
        store64(d, load64(&lr));
        store64(d + 8, load64(&lr + 8));
        d = d + 16;
        i = i + 1;
    }
    var buf = dhvani_buffer_from_interleaved(samples, 2, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(2, nf, sr);
    }
    return buf;
}

# render_stereo_into: alloc-free per-block form over a caller-owned STEREO buffer.
# DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER (null buffer / fn-ptr, negative
# state, or a buffer that is not 2-channel).
fn dhvani_synth_render_stereo_into(sample_fp, state, buf) {
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (sample_fp == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (state < 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dhvani_buffer_channels(buf) != 2) { return DHVANI_ERR_INVALID_PARAMETER; }
    var samples = dhvani_buffer_samples(buf);
    var frames = dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / 2);
    var lr[16];
    store64(&lr, 0);
    store64(&lr + 8, 0);
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < frames) {
        fncall3(sample_fp, state, &lr, &lr + 8);
        store64(d, load64(&lr));
        store64(d + 8, load64(&lr + 8));
        d = d + 16;
        i = i + 1;
    }
    return DHVANI_ERR_NONE;
}

# --- sampler.cyr ---

# sampler.cyr -- nidhi sample-playback engine bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/sampler/mod.rs. The Rust module is `pub use nidhi::...`
# re-exports (no-ops in Cyrius's flat namespace) + one render bridge. Only the
# bridge carries over. Requires the nidhi bundle (n_engine_next_sample) to be
# included before this unit, in dependency order:
#   sakshi -> hisab -> goonj -> naad -> shravan -> nidhi   (see port-audit.md).
#
# n_engine_new answers 0 when an allocation is refused, and n_engine_next_sample
# reads the engine's fields with no check, so both bridges refuse an engine
# handle <= 0 before calling it.

# render_to_buffer: pull `frames` mono samples from the engine's active voices,
# duplicate across `channels`, assemble an interleaved AudioBuffer (silence
# fallback on construction failure, matching the Rust unwrap_or_else). One exact
# allocation for the samples. 0 for an engine handle <= 0 or a refused allocation.
#must_use
fn dhvani_sampler_render_to_buffer(engine, channels, frames, sample_rate) {
    if (engine <= 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var n = 0;
    if (channels > 0) { n = nf * channels; }
    var samples = dh_vec_zeros(n);
    if (vec_len(samples) != n) { return 0; }
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < nf) {
        var s = n_engine_next_sample(engine);
        var c = 0;
        while (c < channels) { store64(d, s); d = d + 8; c = c + 1; }
        i = i + 1;
    }
    var buf = 0;
    if (channels > 0) { buf = dhvani_buffer_from_interleaved(samples, channels, sample_rate); }
    if (buf == 0) {
        var ch = channels;
        if (ch < 1) { ch = 1; }
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(ch, nf, sr);
    }
    return buf;
}

# render_into: alloc-free per-block form. Pulls one engine sample per frame of the
# caller-owned `buf` and writes it into every channel, in place. DHVANI_ERR_NONE, or
# DHVANI_ERR_INVALID_PARAMETER for a null buffer, an engine handle <= 0, or a
# buffer with no channels (buf untouched).
fn dhvani_sampler_render_into(engine, buf) {
    if (engine <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var ch = dhvani_buffer_channels(buf);
    if (ch < 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var samples = dhvani_buffer_samples(buf);
    var frames = dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch);
    var d = dh_vec_data(samples);
    var i = 0;
    while (i < frames) {
        var s = n_engine_next_sample(engine);
        var c = 0;
        while (c < ch) { store64(d, s); d = d + 8; c = c + 1; }
        i = i + 1;
    }
    return DHVANI_ERR_NONE;
}

# --- voice_synth.cyr ---

# voice_synth.cyr -- svara vocal synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/voice_synth/mod.rs. The Rust module is ~150 lines of
# `pub use svara::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call svara's bare symbols -- svara_voice_new_male / svara_phoneme_synthesize /
# svara_tract_new / ... -- directly) plus three render bridges. Only the bridges
# carry over. The bhava_bridge.rs submodule is a separate dep-blocked file
# (bhava) and is NOT ported here.
#
# Requires the svara bundle (+ its deps naad/goonj/hisab/sakshi) included before
# this unit, in dependency order, then dhvani's error -> simd -> buffer:
#   sakshi -> hisab -> goonj -> naad -> svara -> error -> simd -> buffer.
# See docs/development/port-audit.md Wave F include order.
#
# svara synth fns return either a `vec` of f64 samples (success) or a negative
# error code (svara_is_err). The bridges convert a success vec into an
# interleaved mono AudioBuffer, or 0 (null) on synth failure -- mapping the Rust
# `crate::Result<AudioBuffer>` fallible returns to dhvani's null-handle sentinel.

# render_sequence(sequence, voice, sample_rate) -- render a PhonemeSequence to a
# mono AudioBuffer. Returns 0 (null) on synth failure or buffer-construction
# failure (matching the Rust map_err chains that produced NadaError::Dsp), and for
# a sequence or voice handle <= 0 (svara reads both with no check).
#must_use
fn dhvani_vsynth_render_sequence(sequence, voice, sample_rate) {
    if (sequence <= 0) { return 0; }
    if (voice <= 0) { return 0; }
    var samples = svara_sequence_render(sequence, voice, f64_from(sample_rate));
    if (svara_is_err(samples) == 1) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_phoneme(phoneme, voice, sample_rate, duration) -- render a single
# phoneme to a mono AudioBuffer. Returns 0 (null) on synth failure or buffer
# construction failure, and for a voice handle <= 0. (`phoneme` is a code, which
# svara validates itself; 0 is a valid one.)
#must_use
fn dhvani_vsynth_render_phoneme(phoneme, voice, sample_rate, duration) {
    if (voice <= 0) { return 0; }
    var samples = svara_phoneme_synthesize(phoneme, voice, f64_from(sample_rate), duration);
    if (svara_is_err(samples) == 1) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# 1 iff source and tract are both usable handles. Both are raw i64 that share their
# value space with svara's negative error codes (svara_glottal_new ->
# SVARA_ERR_INVALID_PITCH, svara_tract_new -> a mapped naad error). The consumers
# do raw load64/store64 off the handle -- no vec bounds check stands behind them --
# so an unchecked negative or null handle is a wild access. Rust took &mut refs
# here, which made an error value unrepresentable; the flattened port has to say
# it. svara_is_err only tests `code < 0`, so 0 needs its own test.
fn dh_vsynth_handles_ok(source, tract) {
    if (source == 0) { return 0; }
    if (svara_is_err(source) == 1) { return 0; }
    if (tract == 0) { return 0; }
    if (svara_is_err(tract) == 1) { return 0; }
    return 1;
}

# render_vocal_tract(source, tract, frames, sample_rate) -- the lowest-level
# voice bridge: pull `frames` samples from a GlottalSource through a VocalTract,
# assemble a mono AudioBuffer. Silence fallback on construction failure (matches
# the Rust unwrap_or_else). No closure needed -- the glottal/tract fns are called
# directly per frame. One exact allocation for the samples; 0 for an error/null
# handle or a refused allocation.
#must_use
fn dhvani_vsynth_render_vocal_tract(source, tract, frames, sample_rate) {
    if (dh_vsynth_handles_ok(source, tract) == 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var samples = dh_vec_zeros(nf);
    if (vec_len(samples) != nf) { return 0; }
    var d = dh_vec_data(samples);
    var end = d + nf * 8;
    while (d < end) {
        var glottal = svara_glottal_next_sample(source);
        store64(d, svara_tract_process_sample(tract, glottal));
        d = d + 8;
    }
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, nf, sr);
    }
    return buf;
}

# render_vocal_tract_into: alloc-free per-block form over a caller-owned MONO
# buffer (its own frame count). DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for
# an error/null handle, a null buffer or a buffer that is not 1-channel.
fn dhvani_vsynth_render_vocal_tract_into(source, tract, buf) {
    if (dh_vsynth_handles_ok(source, tract) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dhvani_buffer_channels(buf) != 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var samples = dhvani_buffer_samples(buf);
    var nf = dh_imin(dhvani_buffer_frames(buf), vec_len(samples));
    var d = dh_vec_data(samples);
    var end = d + nf * 8;
    while (d < end) {
        var glottal = svara_glottal_next_sample(source);
        store64(d, svara_tract_process_sample(tract, glottal));
        d = d + 8;
    }
    return DHVANI_ERR_NONE;
}

# --- g2p.cyr ---

# g2p.cyr -- text->phoneme / text->AudioBuffer bridges over shabda's G2P engine.
# Ported from rust-old/src/g2p/mod.rs. The Rust module is almost entirely
# `pub use shabda::{engine,rules,normalize,syllable,prosody,arpabet,dictionary,
# heteronym,ssml,error}` + `pub use svara::sequence::{PhonemeEvent,
# PhonemeSequence}` re-exports -- no-ops in Cyrius's flat namespace, where a
# consumer calls the bare shabda_* / svara_* / SvPhonemeEvent_* symbols directly
# once the bundles are included. Only the two text_to_phonemes / speak bridges
# carry real code, so only they carry over.
#
# Feature: `g2p` (= shabda + voice). Requires, in dependency order before this
# unit (Wave F chain -- see tests/g2p.tcyr and port-audit.md Wave F):
#   sakshi -> hisab -> goonj -> naad -> svara -> varna -> shabdakosh -> shabda
#   -> dhvani error -> simd -> buffer.
#
# shabda's fallible fns use the out-param + packed-err form (0 == ok, tested
# with shabda_is_err). The Rust `map_err(NadaError::Dsp)` chains collapse to
# dhvani's null-handle sentinel: these handle-returning bridges return 0 on any
# failure (the DHVANI_ERR_DSP signal for a handle return), exactly matching
# dhvani_vsynth_render_sequence in voice_synth.cyr.

# text_to_phonemes(engine, text) -- convert text to a vec of SvPhonemeEvent*
# handles. Returns the events vec on success, or 0 (null == DSP error) on
# empty/whitespace/invalid input (shabda_convert -> shabda_err_invalid_input).
# A successful English convert always yields a non-empty vec, so 0 is an
# unambiguous failure sentinel. An engine handle <= 0 or a null text is refused
# (0) before shabda reads either.
#must_use
fn dhvani_g2p_text_to_phonemes(engine, text) {
    if (engine <= 0) { return 0; }
    if (text == 0) { return 0; }
    var slot = alloc(8);
    if (slot == 0) { return 0; }
    var err = shabda_convert(engine, text, slot);
    if (shabda_is_err(err) == 1) { return 0; }
    return load64(slot);
}

# speak(engine, text, voice, sample_rate) -- G2P + voice synthesis in one call,
# to a mono AudioBuffer. sample_rate is an INTEGER (like the rest of dhvani's
# buffer API). shabda_speak wants an f64 sample_rate (the f32->f64 port rule), so
# we widen with f64_from; dhvani_buffer_from_interleaved wants the raw integer.
# shabda_speak already runs the full convert -> sequence -> render pipeline and
# emits a raw f64 sample vec (shabda_speak_with); the only seam this bridge adds
# is wrapping those samples in a mono AudioBuffer -- svara/shabda deliberately
# don't depend on dhvani. Returns the AudioBuffer handle, or 0 (null == DSP
# error) on convert/render/buffer-construction failure, and for an engine / voice
# handle <= 0 or a null text.
#must_use
fn dhvani_g2p_speak(engine, text, voice, sample_rate) {
    if (engine <= 0) { return 0; }
    if (text == 0) { return 0; }
    if (voice <= 0) { return 0; }
    var slot = alloc(8);
    if (slot == 0) { return 0; }
    var err = shabda_speak(engine, text, voice, f64_from(sample_rate), slot);
    if (shabda_is_err(err) == 1) { return 0; }
    var samples = load64(slot);                 # vec of f64 samples
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# --- creature.cyr ---

# creature.cyr -- prani creature vocal synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/creature/mod.rs. The Rust module is `pub use prani::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call prani's bare
# symbols -- crvoice_new / crvoice_vocalize / species_supports_vocalization / ...
# -- directly) plus two render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + prani (via ordered include; prani itself
# externalizes svara + sakshi, so those precede it -- see port-audit.md Wave F).
# crvoice_vocalize / crvoice_vocalize_with_intent return a vec ptr of mono
# samples on success or a NEGATIVE PRANI_ERR_* sentinel on failure; on failure
# we return 0 (the Rust `?` propagated a NadaError::Dsp). prani itself refuses a
# voice handle <= 0 (crvoice_vocalize_with_intent, 2.2.1), so an error code from
# crvoice_new comes back as a negative result and maps to 0 here too.

# render_vocalization: vocalize the voice (mono samples), wrap in a 1-channel
# AudioBuffer. sample_rate is an integer (u32 in Rust); prani wants it as f64.
fn dhvani_creature_render_vocalization(voice, vocalization, sample_rate, duration) {
    var samples = crvoice_vocalize(voice, vocalization, f64_from(sample_rate), duration);
    if (samples < 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_vocalization_with_intent: same, threading a CallIntent through prani's
# intent-modifier chain.
fn dhvani_creature_render_vocalization_with_intent(voice, vocalization, intent, sample_rate, duration) {
    var samples = crvoice_vocalize_with_intent(voice, vocalization, intent, f64_from(sample_rate), duration);
    if (samples < 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# --- environment.cyr ---

# environment.cyr -- garjan environmental synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/environment/mod.rs. The Rust module is mostly
# `pub use garjan::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call garjan's bare symbols -- rain_new / thunder_new / impact_synthesize / ...
# -- directly) plus three render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + garjan (via ordered include; see
# docs/development/port-audit.md Wave F include order). The Rust generic
# `render_environment<S: EnvironmentSynth>` -> fn-ptr + opaque state: the caller
# passes a `synthesize(state, duration)` fn (e.g. &rain_synthesize) that returns
# an interleaved-mono samples vec (or a negative garjan error code). render_impact
# and render_block are concrete (impact_synthesize / process_block).
#
# ERRORS: every bridge here returns an AudioBuffer handle or 0, the null-handle
# sentinel the other Wave F bridges use. garjan's constructors (rain_new,
# impact_new, ...) return NEGATIVE codes on failure and its synthesize /
# process_block fns read the handle's fields without a check, so a handle <= 0 is
# refused (0) before garjan is called. Through 2.3.1 render_environment /
# render_impact forwarded garjan's negative code instead of 0.

# render_environment: call synth_fp(state, duration) to get a mono samples vec,
# then wrap it in an AudioBuffer. 0 when the synthesizer fails, when the buffer
# cannot be built (bad sample rate: rust-old's map_err returns Err there -- it is
# not a silence fallback), or for a null fn-ptr / state handle <= 0.
#must_use
fn dhvani_env_render_environment(synth_fp, state, sample_rate, duration) {
    if (synth_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    var samples = fncall2(synth_fp, state, duration);
    if (samples <= 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_impact: synthesize a one-shot impact of the given type, wrap in an
# AudioBuffer. 0 when garjan fails (bad impact type, ...), when the buffer cannot be
# built (rust-old's map_err -> Err), or for an impact handle <= 0.
#must_use
fn dhvani_env_render_impact(impact, impact_type, sample_rate) {
    if (impact <= 0) { return 0; }
    var samples = impact_synthesize(impact, impact_type);
    if (samples <= 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_block: fill a `frames`-length mono buffer via block_fp(state, output),
# then assemble an interleaved AudioBuffer (silence fallback on construction
# failure, matching the Rust unwrap_or_else). block_fp is a process_block fn (e.g.
# &rain_process_block). One exact allocation for the samples; 0 for a null fn-ptr,
# a state handle <= 0, or a refused allocation. Per block: dhvani_env_render_block_into.
#must_use
fn dhvani_env_render_block(block_fp, state, frames, sample_rate) {
    if (block_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var samples = dh_vec_zeros(nf);
    if (vec_len(samples) != nf) { return 0; }
    fncall2(block_fp, state, samples);
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, nf, sr);
    }
    return buf;
}

# render_block_into: alloc-free per-block form. block_fp(state, samples) fills the
# caller-owned MONO buffer's sample vec in place (garjan's process_block fns are
# sized by the vec). DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for a null
# fn-ptr / buffer, a state handle <= 0, or a buffer that is not 1-channel.
fn dhvani_env_render_block_into(block_fp, state, buf) {
    if (block_fp == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (state <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dhvani_buffer_channels(buf) != 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    fncall2(block_fp, state, dhvani_buffer_samples(buf));
    return DHVANI_ERR_NONE;
}

# --- mechanical.cyr ---

# mechanical.cyr -- ghurni mechanical-sound engines bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/mechanical/mod.rs. The Rust module is `pub use ghurni::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call ghurni's bare
# symbols -- ghurni_engine_new / ghurni_motor_new / ... -- directly) plus three
# render bridges. Only the bridges carry over.
#
# Requires the ghurni bundle (+ its deps sakshi -> hisab -> goonj -> naad) to be
# included before this unit, in dependency order (see port-audit.md Wave F note).
#
# The Rust `render_mechanical<S: Synthesizer>` is generic over the Synthesizer
# trait (process_block + set_rpm). In Cyrius that generic dispatch becomes a
# fn-ptr pair: `process_fp(state, out)` fills a pre-sized vec, `setrpm_fp(state,
# rpm)` retargets the RPM. Each ghurni type's `*_process_block` / `*_set_rpm` fn
# is a valid callback as-is (pass `&ghurni_motor_process_block` + the state ptr).
#
# ERRORS: every bridge returns an AudioBuffer handle or 0. ghurni's constructors
# return NEGATIVE GH_ERR_* codes and its synthesize / process_block / set_rpm fns
# read the handle's fields without a check, so a handle <= 0 is refused (0) before
# ghurni is called. Through 2.3.1 render_engine returned DHVANI_ERR_DSP (-5).

# render_mechanical: fill a `frames`-length mono buffer via process_fp(state,out),
# then assemble a 1-channel interleaved AudioBuffer (silence fallback on failure,
# matching the Rust unwrap_or_else). One exact allocation for the samples; 0 for a
# null fn-ptr, a state handle <= 0, or a refused allocation.
#must_use
fn dhvani_mech_render(process_fp, state, frames, sample_rate) {
    if (process_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var samples = dh_vec_zeros(nf);
    if (vec_len(samples) != nf) { return 0; }
    fncall2(process_fp, state, samples);
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, nf, sr);
    }
    return buf;
}

# render_mechanical_at_rpm: set RPM via setrpm_fp(state,rpm), then render. 0 (and
# setrpm_fp not called) for a null fn-ptr or a state handle <= 0.
#must_use
fn dhvani_mech_render_at_rpm(process_fp, setrpm_fp, state, rpm, frames, sample_rate) {
    if (setrpm_fp == 0) { return 0; }
    if (process_fp == 0) { return 0; }
    if (state <= 0) { return 0; }
    fncall2(setrpm_fp, state, rpm);
    return dhvani_mech_render(process_fp, state, frames, sample_rate);
}

# render_into: alloc-free per-block form. process_fp(state, samples) fills the
# caller-owned MONO buffer's sample vec in place. DHVANI_ERR_NONE, or
# DHVANI_ERR_INVALID_PARAMETER for a null fn-ptr / buffer, a state handle <= 0, or a
# buffer that is not 1-channel.
fn dhvani_mech_render_into(process_fp, state, buf) {
    if (process_fp == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (state <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dhvani_buffer_channels(buf) != 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    fncall2(process_fp, state, dhvani_buffer_samples(buf));
    return DHVANI_ERR_NONE;
}

# render_engine(engine, rpm, load, sample_rate, duration) -> AudioBuffer, or 0.
# Calls ghurni_engine_synthesize (returns vec<f64> or GH_ERR_*); a synthesis error,
# a buffer-construction failure (rust-old's map_err -> Err) or an engine handle
# <= 0 answers 0.
#must_use
fn dhvani_mech_render_engine(engine, rpm, load, sample_rate, duration) {
    if (engine <= 0) { return 0; }
    var samples = ghurni_engine_synthesize(engine, rpm, load, duration);
    if (samples <= 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# --- acoustics.cyr ---

# acoustics.cyr -- goonj room-simulation / FDN / ambisonics bridged into
# dhvani's AudioBuffer + ConvolutionReverb. Ported from
# rust-old/src/acoustics/mod.rs. The Rust module is mostly `pub use goonj::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call goonj's bare
# symbols -- acoustic_room_shoebox / fdn_new / new_bformat_ir / write_wav_mono /
# generate_dhvani_ir / ... -- directly). Only the module's own bridge fns +
# room presets carry over.
#
# Requires (in dependency order before this unit): sakshi -> hisab -> goonj,
# then dhvani's error -> simd -> buffer -> fft -> analysis -> convolution.
# goonj IR structs (ImpulseResponse / MultibandIr / DhvaniIr / BFormatIr / Fdn /
# WavBytes) are goonj symbols; dhvani's ConvolutionReverb lives in convolution.cyr.

# ERRORS: the handle-returning bridges answer 0 on failure, the null-handle sentinel
# the other Wave F bridges use (export_ir_wav used to forward goonj's negative
# ERR_COMPUTATION). Every bridge refuses a goonj / dhvani handle <= 0 before
# reading it: goonj's accessors are raw field loads.

# ── Bridge: generate a DhvaniIr from (x,y,z) source/listener positions ──
# Rust `generate_ir((sx,sy,sz),(lx,ly,lz), room, config)` builds Vec3s and
# defers to goonj's generate_dhvani_ir. Here we take scalar coords, build
# hisab hvec3s, and call generate_dhvani_ir. 0 for a room / config handle <= 0.
#must_use
fn dhvani_acoustics_generate_ir(sx, sy, sz, lx, ly, lz, room, config) {
    if (room <= 0) { return 0; }
    if (config <= 0) { return 0; }
    var src = hvec3_new(sx, sy, sz);
    var lis = hvec3_new(lx, ly, lz);
    return generate_dhvani_ir(src, lis, room, config);
}

# ── Bridge: goonj ImpulseResponse -> dhvani ConvolutionReverb ──
# ConvolutionReverb::new(&ir.samples, mix, ir.sample_rate). 0 for an ir <= 0.
#must_use
fn dhvani_acoustics_convolution_from_ir(ir, mix) {
    if (ir <= 0) { return 0; }
    return dhvani_conv_new(ImpulseResponse_samples(ir), mix,
      ImpulseResponse_sample_rate(ir));
}

# ── Bridge: DhvaniIr (broadband) -> ConvolutionReverb ──
#must_use
fn dhvani_acoustics_convolution_from_dhvani_ir(ir, mix) {
    if (ir <= 0) { return 0; }
    return dhvani_acoustics_convolution_from_ir(dhvani_ir_ir(ir), mix);
}

# ── Bridge: MultibandIr (collapsed to broadband) -> ConvolutionReverb ──
# The reusable form of convolve_multiband: build once, then dhvani_conv_process
# per block -- the reverb carries its tail across blocks, allocates nothing in
# steady state, and delays its output by dhvani_conv_latency_frames (one block).
# 0 for a multiband <= 0.
#must_use
fn dhvani_acoustics_convolution_from_multiband(multiband, mix) {
    if (multiband <= 0) { return 0; }
    var broadband = multiband_ir_to_broadband(multiband);
    return dhvani_conv_new(ImpulseResponse_samples(broadband), mix,
      ImpulseResponse_sample_rate(broadband));
}

# ── Multiband convolution (OFFLINE) ──
# Collapse the MultibandIr to a broadband IR, build a ConvolutionReverb, and
# convolve the buffer in place, aligned with its input. OFFLINE / one-shot: it builds
# a reverb (IR partitions + per-channel delay line, megabytes for a long IR) on EVERY
# call, which the bump allocator never reclaims, and each call starts with an empty
# tail. For per-block use build one with dhvani_acoustics_convolution_from_multiband
# and stream it with dhvani_conv_process (one block of latency).
#
# It runs dhvani_conv_render: every frame is convolved, the last partial block
# included, with no added latency. rust-old returned the last frames % 512 frames raw
# (2.3.2 padded to whole blocks to fix that; 2.3.3's render does it for any length).
# Returns DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for a null buffer, a
# multiband <= 0, or a buffer whose samples do not cover frames * channels.
fn dhvani_acoustics_convolve_multiband(buf, multiband, mix) {
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (multiband <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var reverb = dhvani_acoustics_convolution_from_multiband(multiband, mix);
    return dhvani_conv_render(reverb, buf);
}

# ── FDN reverb over an AudioBuffer ──
# Sum channels to mono per frame, run through the FDN, mix wet back into all
# channels. mix is clamped to [0,1]. Walks the sample storage (no per-sample vec
# call), in the same order and with the same arithmetic as before -- bit-identical.
# Alloc-free. 0, or DHVANI_ERR_INVALID_PARAMETER for an fdn <= 0, a null buffer, or
# a buffer whose samples do not cover frames * channels.
fn dhvani_acoustics_process_fdn(fdn, buf, mix) {
    if (fdn <= 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var m = f64_clamp(mix, 0, 1.0);
    var dry = f64_sub(1.0, m);
    var ch = DhAudioBuffer_channels(buf);
    var chmax = ch;
    if (chmax < 1) { chmax = 1; }
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (ch > 0) {
        if (frames * ch > vec_len(samples)) { return DHVANI_ERR_INVALID_PARAMETER; }
    }
    var div = f64_from(chmax);
    var p = dh_vec_data(samples);

    var frame = 0;
    while (frame < frames) {
        var mono_in = 0;
        var q = p;
        var qend = p + ch * 8;
        while (q < qend) {
            mono_in = f64_add(mono_in, load64(q));
            q = q + 8;
        }
        mono_in = f64_div(mono_in, div);

        var wet = fdn_process_sample(fdn, mono_in);
        var wm = f64_mul(wet, m);

        q = p;
        while (q < qend) {
            store64(q, f64_add(f64_mul(load64(q), dry), wm));
            q = q + 8;
        }
        p = qend;
        frame = frame + 1;
    }
    return 0;
}

# ── Ambisonics: decode a B-Format IR to a stereo AudioBuffer ──
# Cardioid decode: L = W + Y, R = W - Y. Returns 0 on length mismatch, buffer
# construction failure, or a bformat <= 0. One exact allocation for the samples.
#must_use
fn dhvani_acoustics_decode_bformat_stereo(bformat) {
    if (bformat <= 0) { return 0; }
    var w = BFormatIr_w(bformat);
    var y = BFormatIr_y(bformat);
    var len = vec_len(w);
    if (vec_len(y) != len) { return 0; }

    var samples = dh_vec_zeros(len * 2);
    if (vec_len(samples) != len * 2) { return 0; }
    var wp = dh_vec_data(w);
    var yp = dh_vec_data(y);
    var d = dh_vec_data(samples);
    var wend = wp + len * 8;
    while (wp < wend) {
        var wv = load64(wp);
        var yv = load64(yp);
        store64(d, f64_add(wv, yv));
        store64(d + 8, f64_sub(wv, yv));
        wp = wp + 8;
        yp = yp + 8;
        d = d + 16;
    }
    return dhvani_buffer_from_interleaved(samples, 2, BFormatIr_sample_rate(bformat));
}

# ── WAV export ──
# Write the IR as a 16-bit PCM mono WAV; returns a goonj WavBytes handle
# (data pointer + byte length), or 0 when goonj refuses (bad sample rate, data
# over 4 GiB, a refused allocation) or for an ir <= 0. The Rust version writes
# into a std::io::Write; in Cyrius write_wav_mono materializes the bytes.
#must_use
fn dhvani_acoustics_export_ir_wav(ir) {
    if (ir <= 0) { return 0; }
    var w = write_wav_mono(ImpulseResponse_samples(ir),
      ImpulseResponse_sample_rate(ir));
    if (w <= 0) { return 0; }
    return w;
}

# ── Room presets (goonj AcousticRoom + AcousticMaterial) ──
#must_use
fn dhvani_acoustics_preset_studio() {
    return acoustic_room_shoebox(4.5, 3.5, 2.8, acoustic_material_carpet());
}
#must_use
fn dhvani_acoustics_preset_rehearsal_room() {
    return acoustic_room_shoebox(8.0, 5.0, 3.0, acoustic_material_wood());
}
#must_use
fn dhvani_acoustics_preset_concert_hall() {
    return acoustic_room_shoebox(f64_from(40), f64_from(25), f64_from(15),
      acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_bathroom() {
    return acoustic_room_shoebox(2.5, f64_from(2), 2.4, acoustic_material_glass());
}
#must_use
fn dhvani_acoustics_preset_cathedral() {
    return acoustic_room_shoebox(f64_from(60), f64_from(30), f64_from(28),
      acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_outdoor() {
    return acoustic_room_shoebox(f64_from(100), f64_from(100), f64_from(50),
      acoustic_material_carpet());
}

# --- playback.cyr ---

# playback.cyr -- dhvani AudioBuffer <-> vani ALSA device I/O (2.1.x feature).
#
# vani (dh(vani)'s sibling) owns raw /dev/snd PCM playback/capture via ioctls
# (no libasound, no FFI) — the real-hardware sink/source the Rust dhvani only had
# via the platform-blocked PipeWire backend. This module bridges dhvani's f64
# AudioBuffer to vani's interleaved little-endian signed PCM (S16 / S24 / S32).
#
# Requires (in dependency order before this unit): yukti -> sakshi -> vani, then
# dhvani error -> simd -> buffer. Externalizes vani exactly like the Wave F
# wrappers externalize the synthesis siblings — a consumer that wants device I/O
# links vani alongside dhvani. It references vani through FUNCTIONS ONLY (never a
# vani const/var) so the whole module DCE-prunes for vani-free consumers of the
# dist bundle. The PURE format bridges need no hardware and are unit-tested; the
# device glue needs /dev/snd. S16 helpers stay as thin wrappers (2.1.0 API).
#
# Supported depths are signed little-endian 16 / 24 / 32 (dh_pcm_depth_ok). Every
# public entry point refuses anything else -- returning 0 (handle / buffer / PCM
# pointer) or -1 (counts) -- rather than packing it as some other width: vani will
# happily configure S8, and an 8-bit device fed 4-byte words plays noise.

# ── PCM format params ───────────────────────────────

# 1 iff dhvani carries this bit depth (signed little-endian 16 / 24 / 32).
#must_use
fn dh_pcm_depth_ok(bit_depth) {
    if (bit_depth == 16) { return 1; }
    if (bit_depth == 24) { return 1; }
    if (bit_depth == 32) { return 1; }
    return 0;
}

# PACKED bytes per sample (the rust-old `f32_to_i24_packed` layout: 24-bit is 3
# bytes). 0 for an unsupported depth, so a size computed from it fails closed.
fn dh_pcm_bytes(bit_depth) {
    if (bit_depth == 16) { return 2; }
    if (bit_depth == 24) { return 3; }
    if (bit_depth == 32) { return 4; }
    return 0;
}

# ENCODE full scale, 2^(bits-1) - 1: rust-old's `clamp(-1,1) * 32767 / 8388607 /
# 2147483647` then truncate. 32-bit is f64_from(): 2147483647 > 2^24, where a
# decimal literal would misparse.
fn dh_pcm_scale(bit_depth) {
    if (bit_depth == 16) { return 32767.0; }
    if (bit_depth == 24) { return 8388607.0; }
    if (bit_depth == 32) { return f64_from(2147483647); }
    return 0;
}

# DECODE full scale, 2^(bits-1): rust-old's i16_to_f32 / i24_packed_to_f32 /
# i32_to_f32 divide by 32768 / 8388608 / 2147483648 (and so do dhvani's own
# dhvani_simd_i16_to_f32 / dhvani_convert_i32_to_f32), so the most negative code
# decodes to exactly -1.0. Through 2.3.1 this divided by the ENCODE scale, which put
# -32768 at -1.0000305 (outside [-1, 1]) and 16384 at 0.500015.
fn dh_pcm_dscale(bit_depth) {
    if (bit_depth == 16) { return 32768.0; }
    if (bit_depth == 24) { return 8388608.0; }
    if (bit_depth == 32) { return f64_from(2147483648); }
    return 0;
}

# ALSA *storage* width, which is NOT dh_pcm_bytes for 24-bit. `SND_PCM_FORMAT_S24_LE`
# carries 24 significant bits inside a 32-bit word (vani_bytes_per_sample returns 4
# for it, lib/vani.cyr), whereas dh_pcm_bytes(24) == 3 — the *packed* layout the
# pure bridge uses to match rust-old's `f32_to_i24_packed`. Sizing a device buffer
# with the packed width makes the kernel read/write 33% past the allocation, so
# every vani-facing path MUST use this one instead. 0 for an unsupported depth.
fn dh_pcm_store_bytes(bit_depth) {
    if (bit_depth == 16) { return 2; }
    if (bit_depth == 24) { return 4; }   # S24_LE: 24 bits inside a 32-bit word
    if (bit_depth == 32) { return 4; }
    return 0;
}

# ── Pure format bridge (no vani, no hardware) ───────────────────────

# pack `n` f64 samples from raw storage `src` -> `dst` as little-endian signed PCM at
# `bit_depth`, `bytes` of storage per sample (2, 3 or 4): clamp[-1,1], then
# trunc(* encode full-scale). One store16/store32 per sample (store16 + store8 for a
# 3-byte slot); the high byte of a 4-byte S24 slot carries the sign, as before. NaN
# packs to 0 (f64_to of NaN), +/-inf to +/-full-scale. 0, or -1 for an unsupported
# depth or width.
fn dh_pack_ptr(src, n, dst, bit_depth, bytes) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    if (bytes < 2) { return 0 - 1; }
    if (bytes > 4) { return 0 - 1; }
    var scale = dh_pcm_scale(bit_depth);
    var s = src;
    var end = src + n * 8;
    var d = dst;
    while (s < end) {
        var c = f64_clamp(load64(s), DH_NEG_ONE, 1.0);
        var v = f64_to(f64_trunc(f64_mul(c, scale)));
        if (bytes == 4) {
            store32(d, v);
        } elif (bytes == 2) {
            store16(d, v);
        } else {
            store16(d, v);
            store8(d + 2, v >> 16);
        }
        s = s + 8;
        d = d + bytes;
    }
    return 0;
}

# vec form: packs the first `n` samples of `samples` (clamped to its length).
# Alloc-free (caller-owned dst) -> the RT path uses this straight into a scratch.
fn dh_pack_le_w(samples, n, dst, bit_depth, bytes) {
    return dh_pack_ptr(dh_vec_data(samples), dh_imin(n, vec_len(samples)), dst, bit_depth, bytes);
}
# packed-width pack (logical layout — the rust-old-parity bridge).
fn dh_pack_le(samples, n, dst, bit_depth) {
    return dh_pack_le_w(samples, n, dst, bit_depth, dh_pcm_bytes(bit_depth));
}

# unpack `n` little-endian signed PCM samples at `bit_depth` from `src` into raw f64
# storage `dst` (sign-extend from bit_depth bits, / decode full-scale), reading
# `bytes` (2, 3 or 4) of storage per sample. `bytes` may exceed bit_depth/8 (S24_LE
# in a 32-bit word), so the raw word is masked to bit_depth bits BEFORE the sign
# fold — otherwise a negative sample's 0xFF sign padding would read as a huge
# positive value. 0, or -1 for an unsupported depth or width.
fn dh_unpack_ptr(src, n, dst, bit_depth, bytes) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    if (bytes < 2) { return 0 - 1; }
    if (bytes > 4) { return 0 - 1; }
    # x * 2^-k == x / 2^k exactly (power-of-two scaling), so the multiply is the
    # oracle's divide, bit for bit.
    var inv = f64_div(1.0, dh_pcm_dscale(bit_depth));
    var mask = (1 << bit_depth) - 1;
    var half = 1 << (bit_depth - 1);
    var full = 1 << bit_depth;
    var s = src;
    var d = dst;
    var end = dst + n * 8;
    while (d < end) {
        var v = 0;
        if (bytes == 4) {
            v = load32(s);
        } elif (bytes == 2) {
            v = load16(s);
        } else {
            v = load16(s) | (load8(s + 2) << 16);
        }
        v = v & mask;
        if (v >= half) { v = v - full; }
        store64(d, f64_mul(f64_from(v), inv));
        s = s + bytes;
        d = d + 8;
    }
    return 0;
}

# vec form: decodes into the first `n` slots of `dst` (clamped to its length).
fn dh_unpack_le_w(src, n, dst, bit_depth, bytes) {
    return dh_unpack_ptr(src, dh_imin(n, vec_len(dst)), dh_vec_data(dst), bit_depth, bytes);
}
# packed-width unpack (logical layout — the rust-old-parity bridge).
fn dh_unpack_le(src, n, dst, bit_depth) {
    return dh_unpack_le_w(src, n, dst, bit_depth, dh_pcm_bytes(bit_depth));
}

# AudioBuffer f64 -> freshly-allocated little-endian PCM at `bit_depth`
# (channels*frames*bytes). Caller owns it. 0 for a null buffer, an unsupported
# depth or an empty buffer. Per-block use: dhvani_playback_to_pcm_into, or the
# ring player (dhvani_player_push).
#must_use
fn dhvani_playback_to_pcm(buf, bit_depth) {
    if (buf == 0) { return 0; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var pcm = alloc(n * dh_pcm_bytes(bit_depth));
    if (pcm == 0) { return 0; }
    dh_pack_le(samples, n, pcm, bit_depth);
    return pcm;
}
#must_use
fn dhvani_playback_to_s16le(buf) { return dhvani_playback_to_pcm(buf, 16); }

# Alloc-free form: pack the whole buffer (packed layout) into caller-owned `dst` of
# `dst_bytes`. Bytes written, or -1 for a null buffer/dst, an unsupported depth or a
# dst too small for the whole buffer (nothing is written then).
#must_use
fn dhvani_playback_to_pcm_into(buf, bit_depth, dst, dst_bytes) {
    if (buf == 0) { return 0 - 1; }
    if (dst == 0) { return 0 - 1; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var need = n * dh_pcm_bytes(bit_depth);
    if (need > dst_bytes) { return 0 - 1; }
    dh_pack_le(samples, n, dst, bit_depth);
    return need;
}

# little-endian PCM bytes at `bit_depth` (packed layout) -> AudioBuffer. 0 for a null
# pcm pointer, channels < 1, an unsupported depth, or a bad sample rate.
#must_use
fn dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, bit_depth) {
    if (pcm == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var nf = frames;
    if (nf < 0) { nf = 0; }
    var n = nf * channels;
    var f = dh_vec_zeros(n);
    if (vec_len(f) != n) { return 0; }
    dh_unpack_le(pcm, n, f, bit_depth);
    return dhvani_buffer_from_interleaved(f, channels, sample_rate);
}
#must_use
fn dhvani_capture_from_s16le(pcm, frames, channels, sample_rate) {
    return dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, 16);
}

# Alloc-free form: decode up to `frames` frames of packed PCM into the caller-owned
# AudioBuffer `buf` (its channel count; at most its frame count). Frames decoded, or
# -1 for a null pcm/buffer or an unsupported depth. buf's frame count is unchanged.
#must_use
fn dhvani_capture_from_pcm_into(pcm, frames, bit_depth, buf) {
    if (pcm == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (ch < 1) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var nf = dh_imin(frames, dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch));
    if (nf <= 0) { return 0; }
    dh_unpack_le(pcm, nf * ch, samples, bit_depth);
    return nf;
}

# ── Device glue (over vani; needs /dev/snd) ───────────────────────

# Transfer scratch for the blocking device paths, owned here and GROW-ONLY: one per
# direction, reused by every dhvani_playback_write / dhvani_capture_read* call and
# grown only when a call needs more than the high-water mark. Through 2.3.1 each
# call allocated its PCM buffer, which the free-less bump allocator never reclaims
# (4 KiB per 1024-frame S16 stereo block, unbounded over a stream). NOT REENTRANT:
# drive each direction from one thread at a time. The ring player/recorder below own
# their scratch per handle and carry no such restriction.
var _dh_pb_scratch = 0;
var _dh_pb_scratch_cap = 0;
var _dh_cap_scratch = 0;
var _dh_cap_scratch_cap = 0;

# playback scratch of at least `need` bytes, or 0 (need <= 0 / allocation refused).
fn dh_pb_scratch(need) {
    if (need <= 0) { return 0; }
    if (_dh_pb_scratch_cap >= need) { return _dh_pb_scratch; }
    var p = alloc(need);
    if (p == 0) { return 0; }
    _dh_pb_scratch = p;
    _dh_pb_scratch_cap = need;
    return p;
}

# capture scratch of at least `need` bytes, or 0.
fn dh_cap_scratch(need) {
    if (need <= 0) { return 0; }
    if (_dh_cap_scratch_cap >= need) { return _dh_cap_scratch; }
    var p = alloc(need);
    if (p == 0) { return 0; }
    _dh_cap_scratch = p;
    _dh_cap_scratch_cap = need;
    return p;
}

# The device's NEGOTIATED bit depth when dhvani can carry its wire format (signed LE
# 16/24/32, as dhvani_*_open_fmt configures it), else 0 -- also for a null handle or a
# device that was never configured. A FLOAT_LE / U8 / BE device answers 0: its bytes
# are not the integer layout the packers write.
fn dh_dev_depth(dev) {
    if (dev == 0) { return 0; }
    var fmt = vani_format_get(dev);
    if (fmt == 0) { return 0; }
    var depth = vani_format_bit_depth(fmt);
    if (dh_pcm_depth_ok(depth) == 0) { return 0; }
    if (vani_format_alsa(fmt) != vani_alsa_for(depth, 1)) { return 0; }
    return depth;
}

# The device's negotiated channel count, or 0 (null / unconfigured handle).
fn dh_dev_channels(dev) {
    if (dev == 0) { return 0; }
    var fmt = vani_format_get(dev);
    if (fmt == 0) { return 0; }
    return vani_format_channels(fmt);
}

# Open + configure + prepare a playback device at `bit_depth`. vani handle, or 0.
# HW_PARAMS leaves the stream in SETUP, and only PREPARE makes it accept frames
# (vani's programs/play_tone.cyr runs open -> configure -> prepare -> play). There
# is deliberately NO START: the kernel starts a playback stream itself once
# start_threshold frames are queued (1 by default after HW_PARAMS), while an explicit
# START on an empty playback buffer fails. Through 2.3.1 this skipped PREPARE and
# called START unchecked, so the stream never left SETUP.
fn dhvani_playback_open_fmt(card, device, sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var ores_tag, d = vani_open_playback(card, device);
    if (is_ok(ores_tag) == 0) { return 0; }
    var cres_tag, cres = vani_configure(d,
      vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres_tag) == 0) { vani_close(d); return 0; }
    var pres_tag, pres = vani_prepare(d);
    if (is_ok(pres_tag) == 0) { vani_close(d); return 0; }
    return d;
}
fn dhvani_playback_open(card, device, sample_rate, channels) {
    return dhvani_playback_open_fmt(card, device, sample_rate, channels, 16);
}

# Convert an AudioBuffer to the DEVICE's negotiated PCM format and play it.
# Frames written, or -1. The depth AND channel count are read back off the handle
# rather than assumed: `frames` goes straight to the kernel, which reads
# frames * <device channels> * <negotiated width> bytes, so a buffer that disagrees
# with either would have the kernel read past the PCM. -1 for a null device or
# buffer, an unconfigured / unsupported device, or a channel-count mismatch; 0 for an
# empty buffer. Alloc-free in steady state (module-owned grow-only scratch: one
# thread at a time per direction).
fn dhvani_playback_write(dev, buf) {
    if (buf == 0) { return 0 - 1; }
    var depth = dh_dev_depth(dev);
    if (depth == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (dh_dev_channels(dev) != ch) { return 0 - 1; }
    var frames = dhvani_buffer_frames(buf);
    if (frames <= 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    var n = frames * ch;
    if (n > vec_len(samples)) { return 0 - 1; }
    var bpp = dh_pcm_store_bytes(depth);
    var pcm = dh_pb_scratch(n * bpp);
    if (pcm == 0) { return 0 - 1; }
    dh_pack_ptr(dh_vec_data(samples), n, pcm, depth, bpp);
    var pres_tag, pres = vani_play(dev, pcm, frames);
    if (is_ok(pres_tag) == 0) { return 0 - 1; }
    return pres;
}

fn dhvani_playback_close(dev) { return vani_close(dev); }

# Open + configure + prepare + start a capture device at `bit_depth`. Handle, or 0.
# A capture stream does need START (it has nothing queued to start on), and a failed
# START now closes the device and answers 0 instead of handing back a dead stream.
fn dhvani_capture_open_fmt(card, device, sample_rate, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    var ores_tag, d = vani_open_capture(card, device);
    if (is_ok(ores_tag) == 0) { return 0; }
    var cres_tag, cres = vani_configure(d,
      vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres_tag) == 0) { vani_close(d); return 0; }
    var pres_tag, pres = vani_prepare(d);
    if (is_ok(pres_tag) == 0) { vani_close(d); return 0; }
    var sres_tag, sres = vani_start(d);
    if (is_ok(sres_tag) == 0) { vani_close(d); return 0; }
    return d;
}
fn dhvani_capture_open(card, device, sample_rate, channels) {
    return dhvani_capture_open_fmt(card, device, sample_rate, channels, 16);
}

# Read up to `frames` frames of `ch` channels at `depth` into the capture scratch.
# Frames ACTUALLY read (the kernel's count, clamped to [0, frames]), or -1. The
# scratch is sized from the format the caller already checked against the device.
fn dh_capture_raw(dev, frames, ch, depth) {
    var pcm = dh_cap_scratch(frames * ch * dh_pcm_store_bytes(depth));
    if (pcm == 0) { return 0 - 1; }
    var rres_tag, rres = vani_record(dev, pcm, frames);
    if (is_ok(rres_tag) == 0) { return 0 - 1; }
    var got = rres;
    if (got < 0) { got = 0; }
    if (got > frames) { got = frames; }
    return got;
}

# Record `frames` at `bit_depth` into a new AudioBuffer, or 0 on failure. The PCM
# transfer is sized from the DEVICE's negotiated format, and the call refuses (0,
# before any kernel I/O) when `channels` / `bit_depth` disagree with it: the kernel
# writes frames * <device channels> * <device width> bytes, so trusting the arguments
# let a 16-bit read of a 24/32-bit device write past the buffer. The result holds
# the frames ACTUALLY read (a short read is a shorter buffer, not zero padding).
# Allocates only the returned buffer; per-block use: dhvani_capture_read_into.
#must_use
fn dhvani_capture_read_fmt(dev, frames, channels, sample_rate, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (frames <= 0) { return 0; }
    if (dh_dev_depth(dev) != bit_depth) { return 0; }
    if (dh_dev_channels(dev) != channels) { return 0; }
    var got = dh_capture_raw(dev, frames, channels, bit_depth);
    if (got < 0) { return 0; }
    var n = got * channels;
    var f = dh_vec_zeros(n);
    if (vec_len(f) != n) { return 0; }
    dh_unpack_ptr(_dh_cap_scratch, n, dh_vec_data(f), bit_depth, dh_pcm_store_bytes(bit_depth));
    return dhvani_buffer_from_interleaved(f, channels, sample_rate);
}
#must_use
fn dhvani_capture_read(dev, frames, channels, sample_rate) {
    return dhvani_capture_read_fmt(dev, frames, channels, sample_rate, 16);
}

# Alloc-free capture into a caller-owned AudioBuffer: up to dhvani_buffer_frames(buf)
# frames at the device's negotiated format, decoded into buf's samples. Frames
# actually read (samples past them keep their old values; buf's frame count is not
# changed), or -1 for a null device/buffer, an unconfigured or unsupported device, a
# channel-count mismatch, or a vani error. Module scratch: one thread at a time.
#must_use
fn dhvani_capture_read_into(dev, buf) {
    if (buf == 0) { return 0 - 1; }
    var depth = dh_dev_depth(dev);
    if (depth == 0) { return 0 - 1; }
    var ch = dhvani_buffer_channels(buf);
    if (dh_dev_channels(dev) != ch) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var frames = dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch);
    if (frames <= 0) { return 0; }
    var got = dh_capture_raw(dev, frames, ch, depth);
    if (got < 0) { return 0 - 1; }
    dh_unpack_ptr(_dh_cap_scratch, got * ch, dh_vec_data(samples), depth, dh_pcm_store_bytes(depth));
    return got;
}

# ── Ring-buffer RT playback (lock-free, alloc-free producer) ────────────────
# A player owns a vani ring + a reusable scratch PCM buffer, so pushing a block
# converts into scratch and copies into the ring with ZERO per-block allocation
# (the free-less bump allocator demands it). The RT loop: push producer blocks,
# then drain to the device via vani_play_from_ring. The player's depth and channel
# count are fixed at construction and must match the device it drains to.

#derive(accessors)
struct DhPlayer { ring; scratch; scratch_bytes; bit_depth; channels; }

# ring_bytes = ring capacity (rounded up to pow2 by vani); scratch is sized for
# the largest block (max_frames * channels samples at `bit_depth`). 0 when vani
# refuses the ring (ring_bytes <= 0 or > 1 GiB), for channels < 1, max_frames < 1,
# an unsupported depth, or a refused allocation.
#must_use
fn dhvani_player_new_fmt(ring_bytes, max_frames, channels, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (max_frames < 1) { return 0; }
    var ring = vani_ring_new(ring_bytes);
    if (ring == 0) { return 0; }
    # STORAGE width: this scratch is copied into the ring, which vani drains
    # straight to the device, so it must carry the device's wire layout.
    var bytes = max_frames * channels * dh_pcm_store_bytes(bit_depth);
    var scratch = alloc(bytes);
    if (scratch == 0) { return 0; }
    var self = alloc(sizeof(DhPlayer));
    if (self == 0) { return 0; }
    DhPlayer_set_ring(self, ring);
    DhPlayer_set_scratch(self, scratch);
    DhPlayer_set_scratch_bytes(self, bytes);
    DhPlayer_set_bit_depth(self, bit_depth);
    DhPlayer_set_channels(self, channels);
    return self;
}
#must_use
fn dhvani_player_new(ring_bytes, max_frames, channels) {
    return dhvani_player_new_fmt(ring_bytes, max_frames, channels, 16);
}

# the underlying vani ring (pass to vani_play_from_ring / the drain helper); 0 for a
# null player.
fn dhvani_player_ring(self) {
    if (self == 0) { return 0; }
    return DhPlayer_ring(self);
}

# Enqueue frames [start_frame, ...) of `buf`: as many WHOLE frames as fit the block,
# the scratch (max_frames) and the ring's free space, packed into the reusable
# scratch. No allocation. Returns FRAMES enqueued (0 when not one whole frame fits),
# or -1 for a null player/buffer, a buffer whose channel count is not the player's,
# or start_frame outside [0, frames]. A ring never receives part of a frame: with a
# non-power-of-two frame (5.1 S16 = 12 bytes) the free space is often not a frame
# multiple, and a fragment there misaligned every later sample.
fn dhvani_player_push_from(self, buf, start_frame) {
    if (self == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    var ch = DhPlayer_channels(self);
    if (dhvani_buffer_channels(buf) != ch) { return 0 - 1; }
    var frames = dhvani_buffer_frames(buf);
    if (start_frame < 0) { return 0 - 1; }
    if (start_frame > frames) { return 0 - 1; }
    var depth = DhPlayer_bit_depth(self);
    var bpp = dh_pcm_store_bytes(depth);
    var frame_bytes = ch * bpp;
    var ring = DhPlayer_ring(self);
    var nf = frames - start_frame;
    nf = dh_imin(nf, DhPlayer_scratch_bytes(self) / frame_bytes);
    nf = dh_imin(nf, vani_ring_free(ring) / frame_bytes);
    if (nf <= 0) { return 0; }
    var samples = dhvani_buffer_samples(buf);
    if ((start_frame + nf) * ch > vec_len(samples)) { return 0 - 1; }
    var scratch = DhPlayer_scratch(self);
    dh_pack_ptr(dh_vec_data(samples) + start_frame * ch * 8, nf * ch, scratch, depth, bpp);
    var wrote = vani_ring_write(ring, scratch, nf * frame_bytes);
    return wrote / frame_bytes;
}

# Convert an AudioBuffer into the reusable scratch and enqueue it in the ring.
# No allocation. Returns BYTES enqueued, always a whole number of frames
# (frames = bytes / (channels * storage width)); 0 when not one frame fits, for a
# null handle, or for a buffer whose channel count is not the player's. Frames past
# that count were NOT enqueued: resume them next cycle with
# dhvani_player_push_from(self, buf, bytes / (channels * storage width)).
fn dhvani_player_push(self, buf) {
    var nf = dhvani_player_push_from(self, buf, 0);
    if (nf <= 0) { return 0; }
    return nf * DhPlayer_channels(self) * dh_pcm_store_bytes(DhPlayer_bit_depth(self));
}

# Drain queued audio to the device (call from the RT loop after pushing). A null
# player is reported as vani's own Err for a null ring.
fn dhvani_player_drain(self, dev) {
    if (self == 0) { return vani_play_from_ring(dev, 0); }
    return vani_play_from_ring(dev, DhPlayer_ring(self));
}

# ── Ring-buffer RT capture (mirror of the player) ─────────────────────
# A recorder owns a vani ring, a reusable PCM scratch and a reusable output
# AudioBuffer. The RT loop: fill the ring from the device (vani_record_to_ring),
# then read decoded blocks back. Neither side allocates per block.

#derive(accessors)
struct DhRecorder { ring; scratch; scratch_bytes; bit_depth; channels; sample_rate; out; }

# 0 when vani refuses the ring, for channels < 1, max_frames < 1, an unsupported
# depth, a sample rate dhvani_buffer_from_interleaved rejects, or a refused
# allocation.
#must_use
fn dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, bit_depth) {
    if (dh_pcm_depth_ok(bit_depth) == 0) { return 0; }
    if (channels < 1) { return 0; }
    if (max_frames < 1) { return 0; }
    var ring = vani_ring_new(ring_bytes);
    if (ring == 0) { return 0; }
    # STORAGE width — the ring is filled by vani straight from the device.
    var bytes = max_frames * channels * dh_pcm_store_bytes(bit_depth);
    var scratch = alloc(bytes);
    if (scratch == 0) { return 0; }
    var n = max_frames * channels;
    var outv = dh_vec_zeros(n);
    if (vec_len(outv) != n) { return 0; }
    var out = dhvani_buffer_from_interleaved(outv, channels, sample_rate);
    if (out == 0) { return 0; }
    var self = alloc(sizeof(DhRecorder));
    if (self == 0) { return 0; }
    DhRecorder_set_ring(self, ring);
    DhRecorder_set_scratch(self, scratch);
    DhRecorder_set_scratch_bytes(self, bytes);
    DhRecorder_set_bit_depth(self, bit_depth);
    DhRecorder_set_channels(self, channels);
    DhRecorder_set_sample_rate(self, sample_rate);
    DhRecorder_set_out(self, out);
    return self;
}
#must_use
fn dhvani_recorder_new(ring_bytes, max_frames, channels, sample_rate) {
    return dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, 16);
}

fn dhvani_recorder_ring(self) {
    if (self == 0) { return 0; }
    return DhRecorder_ring(self);
}

# Fill the ring from the device (call from the RT loop). Returns the vani result; a
# null recorder is reported as vani's own Err for a null ring.
fn dhvani_recorder_fill(self, dev, frames) {
    if (self == 0) { return vani_record_to_ring(dev, 0, frames); }
    return vani_record_to_ring(dev, DhRecorder_ring(self), frames);
}

# Move up to `frames` WHOLE frames (also capped by the scratch) from the ring into
# the scratch; frames moved. Computed from what the ring holds BEFORE reading, so a
# trailing partial frame stays in the ring for the next call (through 2.3.1 it was
# consumed and then dropped, misaligning everything after it).
fn dh_recorder_take(self, frames) {
    var frame_bytes = DhRecorder_channels(self) * dh_pcm_store_bytes(DhRecorder_bit_depth(self));
    var ring = DhRecorder_ring(self);
    var nf = frames;
    nf = dh_imin(nf, DhRecorder_scratch_bytes(self) / frame_bytes);
    nf = dh_imin(nf, vani_ring_used(ring) / frame_bytes);
    if (nf <= 0) { return 0; }
    var got = vani_ring_read(ring, DhRecorder_scratch(self), nf * frame_bytes);
    return got / frame_bytes;
}

# Drain up to `frames` whole frames from the ring, decoded per the recorder's bit
# depth, into the recorder-OWNED AudioBuffer, which is returned: zero allocation per
# call. The buffer is REUSED — its samples and frame count are valid until the next
# read on this recorder (copy them out to keep them, or decode into storage you own
# with dhvani_recorder_read_into). Its frame count is the whole frames read: 0 when
# the ring held less than one frame. 0 for a null recorder.
#must_use
fn dhvani_recorder_read(self, frames) {
    if (self == 0) { return 0; }
    var ch = DhRecorder_channels(self);
    var out = DhRecorder_out(self);
    var samples = dhvani_buffer_samples(out);
    var nf = dh_recorder_take(self, frames);
    var n = nf * ch;
    # vec layout { data, len, cap } (lib/vec.cyr, as dh_vec_data relies on): n never
    # exceeds the capacity reserved at construction (max_frames * channels).
    store64(samples + 8, dh_imin(n, vec_cap(samples)));
    DhAudioBuffer_set_frames(out, nf);
    dh_unpack_ptr(DhRecorder_scratch(self), n, dh_vec_data(samples), DhRecorder_bit_depth(self),
      dh_pcm_store_bytes(DhRecorder_bit_depth(self)));
    return out;
}

# Alloc-free drain into a caller-owned AudioBuffer of the recorder's channel count:
# up to dhvani_buffer_frames(buf) whole frames, decoded into buf's samples. Frames
# read (samples past them keep their old values; buf's frame count is not changed),
# or -1 for a null recorder/buffer or a channel-count mismatch.
#must_use
fn dhvani_recorder_read_into(self, buf) {
    if (self == 0) { return 0 - 1; }
    if (buf == 0) { return 0 - 1; }
    var ch = DhRecorder_channels(self);
    if (dhvani_buffer_channels(buf) != ch) { return 0 - 1; }
    var samples = dhvani_buffer_samples(buf);
    var nf = dh_recorder_take(self, dh_imin(dhvani_buffer_frames(buf), vec_len(samples) / ch));
    dh_unpack_ptr(DhRecorder_scratch(self), nf * ch, dh_vec_data(samples), DhRecorder_bit_depth(self),
      dh_pcm_store_bytes(DhRecorder_bit_depth(self)));
    return nf;
}
