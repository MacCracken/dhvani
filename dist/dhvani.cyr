# dhvani.cyr -- bundled distribution
# Version: 2.3.3
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# error.cyr -- dhvani error codes + shared f64 tolerances/sentinels + base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports rust-old/src/error.rs (the `NadaError` enum, 9 variants). Rust carried
# a String/int payload per variant; the Cyrius port uses integer codes --
# fallible fns return DHVANI_ERR_NONE (0) on success or a negative code on
# failure. Diagnostic text via dhvani_err_name(). The rich struct-variant
# context (expected/actual strings) is dropped (can't ride an i64 code).
#
# NAMING: every dhvani top-level symbol is `dhvani_`/`DHVANI_`/`DH_`-prefixed so
# the dhvani distlib coexists with the sibling bundles it pulls (naad exports
# bare ERR_NONE / validate_sample_rate / flush_denormal; svara exports SVARA_*)
# in one flat namespace.
#
# FLOATS: dhvani's Rust stored f32 samples; the Cyrius port is f64 throughout
# (the audio-stack math is f64-only). DH_EPSILON preserves the f32::EPSILON
# (2^-23) tolerance the Rust tests used, promoted to f64.

# ================================================================
# Error codes (was `enum NadaError`). One per Rust variant, in order.
# ================================================================
var DHVANI_ERR_NONE                = 0;
var DHVANI_ERR_FORMAT_MISMATCH     = (0 - 1);   # buffer format (rate/channels) mismatch
var DHVANI_ERR_LENGTH_MISMATCH     = (0 - 2);   # buffer sample count mismatch
var DHVANI_ERR_INVALID_SAMPLE_RATE = (0 - 3);   # sample rate zero / out of range
var DHVANI_ERR_INVALID_CHANNELS    = (0 - 4);   # channel count zero / exceeds max
var DHVANI_ERR_DSP                 = (0 - 5);   # DSP processing error
var DHVANI_ERR_CAPTURE             = (0 - 6);   # audio capture/output error
var DHVANI_ERR_INVALID_PARAMETER   = (0 - 7);   # a named parameter out of range
var DHVANI_ERR_CONVERSION          = (0 - 8);   # format conversion error
var DHVANI_ERR_OTHER               = (0 - 9);   # wrapped external error

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for the
# whole crate (converters, filters, tests). DH_EPSILON = f32::EPSILON promoted.
# ================================================================
var DH_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var DH_POS_INF = 0x7FF0000000000000;   # +inf
var DH_NEG_INF = 0xFFF0000000000000;   # -inf (amplitude_to_db(<=0) sentinel)
var DH_NAN     = 0x7FF8000000000000;   # quiet NaN (f64 Err sentinel; not finite)

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn dhvani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (for diagnostics / logging). Mirrors the Rust
# Display messages, minus the runtime payload (expected/actual/name/value).
#must_use
fn dhvani_err_name(code) {
    if (code == DHVANI_ERR_NONE)                { return "none"; }
    if (code == DHVANI_ERR_FORMAT_MISMATCH)     { return "buffer format mismatch"; }
    if (code == DHVANI_ERR_LENGTH_MISMATCH)     { return "buffer length mismatch"; }
    if (code == DHVANI_ERR_INVALID_SAMPLE_RATE) { return "invalid sample rate"; }
    if (code == DHVANI_ERR_INVALID_CHANNELS)    { return "invalid channel count"; }
    if (code == DHVANI_ERR_DSP)                 { return "DSP error"; }
    if (code == DHVANI_ERR_CAPTURE)             { return "capture error"; }
    if (code == DHVANI_ERR_INVALID_PARAMETER)   { return "invalid parameter"; }
    if (code == DHVANI_ERR_CONVERSION)          { return "conversion error"; }
    if (code == DHVANI_ERR_OTHER)               { return "other error"; }
    return "unknown error";
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn dhvani_is_finite(x) {
    return f64_lt(f64_abs(x), DH_POS_INF);
}

# Range test: 1 iff lo <= x <= hi, as the oracle's `(lo..=hi).contains(&x)`, so a NaN
# x is OUTSIDE. Write every validate() bound this way: the negated form
# `f64_lt(x, lo) || f64_gt(x, hi)` lets a NaN through, since both compares are false.
#must_use
fn dh_in_range(x, lo, hi) {
    if (f64_ge(x, lo) == 0) { return 0; }
    if (f64_le(x, hi) == 0) { return 0; }
    return 1;
}

# Rust's `x % 1.0` (fmod: the remainder keeps the dividend's sign; NaN and +-Inf give
# NaN). For |x| < 2^52, x - trunc(x) IS that remainder, exactly: the fractional part is
# representable and the subtraction rounds nothing. From 2^52 up x is an integer and the
# remainder is a zero, which keeps x's sign, as fmod's does. The phase wraps of the
# oscillator and the modulated delay's LFO use it (2.3.3).
#must_use
fn dh_fmod1(x) {
    var r = f64_sub(x, f64_trunc(x));
    if (f64_eq(r, 0) == 1) { return x & 0x8000000000000000; }
    return r;
}

# tan(x) = sin(x)/cos(x). The stdlib exposes f64_sin/f64_cos but not f64_tan
# (only f64_tanh); the filter modules (svf, biquad) need tangent for coefficient
# design. Defined here in the L0 base so both share one definition.
#must_use
fn dhvani_tan(x) {
    return f64_div(f64_sin(x), f64_cos(x));
}

# --- simd.cyr ---

# simd.cyr -- audio kernels: rust-old/src/simd/{mod,x86,aarch64}.rs.
# L0, no internal deps. Needs the stdlib `simd` leaf (lib/simd.cyr: the AVX2 probe).
#
# Two forms of every kernel, as in the oracle:
#   dhvani_simd_<k>         -- the accelerated kernel; what buffer/convert/resample/dsp/
#                              biquad call.
#   dhvani_simd_<k>_scalar  -- the scalar fallback (rust-old/src/simd/mod.rs `<k>_scalar`),
#                              the parity oracle the accelerated kernel is tested against.
#
# 2.0.0 - 2.3.1 shipped only the scalar form: Cyrius had no vector story, so the SSE2/AVX2
# (x86.rs) and NEON (aarch64.rs) arms were dropped as platform-blocked. 2.3.2 restores them
# on the compiler's flat-array packed verbs -- `f64v_*` (2 f64 lanes: SSE2 on x86, NEON on
# aarch64, per-lane loops on cx) and `f64v256_*` (4 lanes, AVX2) -- the builtins abaco and
# goonj already use. There are no packed min/max/compare/convert verbs, so peak_abs, clamp,
# noise_gate and the PCM conversions stay scalar: what they gain is the per-element
# vec_get/vec_set call (two bounds checks each) replaced by a walk over the element storage.
#
# PARITY.
#   - Element-wise kernels (add_buffers, apply_gain, biquad_stereo, and every walked
#     kernel) do the same IEEE op per element as the scalar form: BIT-IDENTICAL to it, on
#     either lane width. biquad_stereo keeps the scalar grouping, mul then add, never fused.
#   - The two reductions (sum_of_squares, weighted_sum) add in lane order -- two partial
#     sums, then their total -- as Rust's SSE2 arm did, so they differ from the
#     left-to-right scalar sum in the last bits (the oracle tolerates 1e-3 / 1e-2). They
#     use the 128-bit kernel only: f64v256_dot reduces in yet another order, and the answer
#     must not depend on whether the CPU has AVX2.
#
# Buffers are `vec` handles; f64 samples live directly in the 8-byte slots. Integer-PCM
# sources (i16/i24/u8) hold their integer value per slot. f32->f64 throughout (the whole
# port is f64). Everything alloc-free (in place, or into the caller's dst).

# -1.0 as an f64 bit pattern. (A bare `-1.0` literal is INTEGER-negated -> wrong;
# negative floats must come from f64_neg() or an explicit bit pattern.)
var DH_NEG_ONE = 0xBFF0000000000000;   # -1.0

# min of two integer lengths.
#must_use
fn dh_imin(a, b) {
    if (a < b) { return a; }
    return b;
}

# sign-extend the low 24 bits of x (matches Rust `(x << 8) >> 8` on i32).
#must_use
fn dh_sext24(x) {
    var low = x & 0xFFFFFF;
    if ((low & 0x800000) == 0) { return low; }
    return low - 0x1000000;
}

# Running-max fold that IGNORES NaN, matching Rust's `f32::max` (and the
# `.fold(0.0f32, f32::max)` the oracle uses). Cyrius's f64_max is ASYMMETRIC on
# NaN -- f64_max(x, NaN) returns NaN while f64_max(NaN, x) returns x -- so a
# single NaN sample first poisons a running peak and then RESETS it to whatever
# comes next, silently under-reporting the true peak. The threat model treats
# incoming samples as untrusted and explicitly expects NaN, and an
# under-reported peak makes dhvani_dsp_normalize OVER-amplify, so this is the
# guard that keeps the whole peak family honest.
fn dh_max_ignore_nan(acc, x) {
    if (f64_eq(x, x) == 0) { return acc; }
    return f64_max(acc, x);
}

# The min fold's twin, as Rust's `f32::min`: a NaN x leaves the accumulator alone.
fn dh_min_ignore_nan(acc, x) {
    if (f64_eq(x, x) == 0) { return acc; }
    return f64_min(acc, x);
}

# ================================================================
# Element storage + lane plumbing
# ================================================================

# The element storage of a vec. lib/vec.cyr lays a vec out as { data_ptr, len, cap }.
# Stale after any push (a push may move the storage): take it after the last one.
#inline
#must_use
fn dh_vec_data(v) {
    return load64(v);
}

# 1 = the CPU has AVX2, so long rows take the 256-bit kernels; 0 = 128-bit only;
# 2 = not probed yet. f64v256_* is an illegal instruction without AVX2 (SIGILL), so this
# comes from CPUID (simd_has_avx2, which answers 0 on every non-x86 target), never from a
# guess. Only a test sets it otherwise, to force the 128-bit path.
var dh_simd_wide = 2;

# Below this a row stays on 128-bit lanes: every 256-bit call pays a vzeroupper, which
# loses to the 128-bit kernel on short rows (goonj ADR-0008 measured the crossover at ~64).
var DH_SIMD_WIDE_MIN = 64;

# Elements of an n-long row for the 256-bit kernels: a multiple of 4, or 0.
#must_use
fn dh_simd_wide_len(n) {
    if (n < DH_SIMD_WIDE_MIN) { return 0; }
    if (dh_simd_wide == 2) { dh_simd_wide = simd_has_avx2(); }
    if (dh_simd_wide == 0) { return 0; }
    return n & (0 - 4);
}

# The packed verbs step 2 (f64v_*) or 4 (f64v256_*) lanes with NO scalar tail:
# f64v_add(out, a, b, 1) writes TWO elements, one past a 1-long row. These touch exactly
# n elements -- the 256-bit prefix, the 128-bit middle, then an odd last element in scalar
# code with the same rounding. `out` may be `a` or `b`, but must not overlap them at an
# offset.

# out[i] = a[i] + b[i], i < n.
fn dh_simd_row_add(out, a, b, n) {
    if (n <= 0) { return 0; }
    var wide = dh_simd_wide_len(n);
    if (wide > 0) { f64v256_add(out, a, b, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_add(out + wide * 8, a + wide * 8, b + wide * 8, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_add(load64(a + even * 8), load64(b + even * 8)));
    }
    return 0;
}

# out[i] = a[i] * s, i < n.
fn dh_simd_row_scale(out, a, s, n) {
    if (n <= 0) { return 0; }
    var wide = dh_simd_wide_len(n);
    if (wide > 0) { f64v256_scale(out, a, s, wide); }
    var even = n & (0 - 2);
    if (even > wide) {
        f64v_scale(out + wide * 8, a + wide * 8, s, even - wide);
    }
    if (even != n) {
        store64(out + even * 8, f64_mul(load64(a + even * 8), s));
    }
    return 0;
}

# sum(a[i] * b[i]), i < n: the 128-bit kernel's two partial sums, then the odd last
# product. 128-bit only, so the bits do not depend on the CPU (see PARITY above).
#must_use
fn dh_simd_row_dot(a, b, n) {
    var sum = 0;              # +0.0
    if (n <= 0) { return sum; }
    var even = n & (0 - 2);
    if (even > 0) { sum = f64v_dot(a, b, even); }
    if (even != n) {
        sum = f64_add(sum, f64_mul(load64(a + even * 8), load64(b + even * 8)));
    }
    return sum;
}

# 64 f64 ones, for the weight total: sum(w[i]) = dot(w, ones), exactly, since every
# product is w[i] * 1.0. Filled on first use (BSS, no alloc).
var dh_simd_ones[512];
var dh_simd_ones_ready = 0;

# sum(a[i]), i < n, in the same lane order as dh_simd_row_dot, 64 elements at a time.
#must_use
fn dh_simd_row_sum(a, n) {
    if (dh_simd_ones_ready == 0) {
        var k = 0;
        while (k < 64) { store64(&dh_simd_ones + k * 8, 1.0); k = k + 1; }
        dh_simd_ones_ready = 1;
    }
    var sum = 0;              # +0.0
    var off = 0;
    while (off < n) {
        var cnt = n - off;
        if (cnt > 64) { cnt = 64; }
        sum = f64_add(sum, dh_simd_row_dot(a + off * 8, &dh_simd_ones, cnt));
        off = off + cnt;
    }
    return sum;
}

# ================================================================
# Gain / mix / dynamics
# ================================================================

# add_buffers(dst, src) -- dst[i] += src[i] over min length.
fn dhvani_simd_add_buffers(dst, src) {
    var len = dh_imin(vec_len(dst), vec_len(src));
    var d = dh_vec_data(dst);
    dh_simd_row_add(d, d, dh_vec_data(src), len);
    return 0;
}

fn dhvani_simd_add_buffers_scalar(dst, src) {
    var len = dh_imin(vec_len(dst), vec_len(src));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_add(vec_get(dst, i), vec_get(src, i)));
        i = i + 1;
    }
    return 0;
}

# apply_gain(samples, gain) -- multiply every sample by gain.
fn dhvani_simd_apply_gain(samples, gain) {
    var d = dh_vec_data(samples);
    dh_simd_row_scale(d, d, gain, vec_len(samples));
    return 0;
}

fn dhvani_simd_apply_gain_scalar(samples, gain) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        vec_set(samples, i, f64_mul(vec_get(samples, i), gain));
        i = i + 1;
    }
    return 0;
}

# clamp(samples, min, max) -- clamp every sample into [min, max]. Walked (no packed
# min/max), with f64_clamp's two tests inline: below min -> min, else above max -> max,
# else as it is (so a NaN sample passes through, as it does through f64_clamp).
fn dhvani_simd_clamp(samples, min, max) {
    var p = dh_vec_data(samples);
    var end = p + vec_len(samples) * 8;
    while (p < end) {
        var x = load64(p);
        if (f64_lt(x, min) == 1) { store64(p, min); }
        else { if (f64_gt(x, max) == 1) { store64(p, max); } }
        p = p + 8;
    }
    return 0;
}

fn dhvani_simd_clamp_scalar(samples, min, max) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        vec_set(samples, i, f64_clamp(vec_get(samples, i), min, max));
        i = i + 1;
    }
    return 0;
}

# peak_abs(samples) -- max |sample|, 0.0 for empty, NaN ignored. Walked, with
# dh_max_ignore_nan's fold inline: a sample replaces the peak only when it compares
# GREATER, and f64_gt is 0 for a NaN, so a NaN never enters. The answer is the same bits:
# the peak is never NaN, and |x| is never -0.0, so an equal sample is the same value.
#must_use
fn dhvani_simd_peak_abs(samples) {
    var p = dh_vec_data(samples);
    var end = p + vec_len(samples) * 8;
    var peak = 0;              # +0.0
    while (p < end) {
        var x = f64_abs(load64(p));
        if (f64_gt(x, peak) == 1) { peak = x; }
        p = p + 8;
    }
    return peak;
}

#must_use
fn dhvani_simd_peak_abs_scalar(samples) {
    var len = vec_len(samples);
    var peak = 0;              # +0.0
    var i = 0;
    while (i < len) {
        peak = dh_max_ignore_nan(peak, f64_abs(vec_get(samples, i)));
        i = i + 1;
    }
    return peak;
}

# sum_of_squares(samples) -- sum(s*s) as f64, in lane order (see PARITY).
#must_use
fn dhvani_simd_sum_of_squares(samples) {
    var d = dh_vec_data(samples);
    return dh_simd_row_dot(d, d, vec_len(samples));
}

#must_use
fn dhvani_simd_sum_of_squares_scalar(samples) {
    var len = vec_len(samples);
    var sum = 0;              # +0.0
    var i = 0;
    while (i < len) {
        var s = vec_get(samples, i);
        sum = f64_add(sum, f64_mul(s, s));
        i = i + 1;
    }
    return sum;
}

# noise_gate(samples, threshold) -- zero samples with |s| < threshold. Walked.
fn dhvani_simd_noise_gate(samples, threshold) {
    var p = dh_vec_data(samples);
    var end = p + vec_len(samples) * 8;
    while (p < end) {
        if (f64_lt(f64_abs(load64(p)), threshold) == 1) { store64(p, 0); }
        p = p + 8;
    }
    return 0;
}

fn dhvani_simd_noise_gate_scalar(samples, threshold) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        if (f64_lt(f64_abs(vec_get(samples, i)), threshold) == 1) {
            vec_set(samples, i, 0);
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Format conversion (integer PCM <-> f32). Walked: no packed int<->float verb. The
# float->PCM forms test f64_clamp's bounds inline, in its order (below lo, else above hi).
# ================================================================

# i16_to_f32(src, dst) -- src[i] / 32768.0.
fn dhvani_simd_i16_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        store64(d, f64_div(f64_from(load64(s)), 32768.0));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_i16_to_f32_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_from(vec_get(src, i)), 32768.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_i16(src, dst) -- (clamp(src,-1,1) * 32767) truncated to i16.
fn dhvani_simd_f32_to_i16(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        var c = load64(s);
        if (f64_lt(c, DH_NEG_ONE) == 1) { c = DH_NEG_ONE; }
        else { if (f64_gt(c, 1.0) == 1) { c = 1.0; } }
        store64(d, f64_to(f64_trunc(f64_mul(c, 32767.0))));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_f32_to_i16_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_mul(c, 32767.0))));
        i = i + 1;
    }
    return 0;
}

# i24_to_f32(src, dst) -- sign-extend low 24 bits, / 8388608.0.
fn dhvani_simd_i24_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        # dh_sext24 by hand: the compiler ignores its #inline (it has control flow)
        var x = load64(s) & 0xFFFFFF;
        if ((x & 0x800000) != 0) { x = x - 0x1000000; }
        store64(d, f64_div(f64_from(x), 8388608.0));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_i24_to_f32_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_from(dh_sext24(vec_get(src, i))), 8388608.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_i24(src, dst) -- (clamp(src,-1,1) * 8388607) truncated to i32.
fn dhvani_simd_f32_to_i24(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        var c = load64(s);
        if (f64_lt(c, DH_NEG_ONE) == 1) { c = DH_NEG_ONE; }
        else { if (f64_gt(c, 1.0) == 1) { c = 1.0; } }
        store64(d, f64_to(f64_trunc(f64_mul(c, 8388607.0))));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_f32_to_i24_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_mul(c, 8388607.0))));
        i = i + 1;
    }
    return 0;
}

# u8_to_f32(src, dst) -- (src[i] - 128) / 128.0.
fn dhvani_simd_u8_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        store64(d, f64_div(f64_sub(f64_from(load64(s)), 128.0), 128.0));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_u8_to_f32_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_sub(f64_from(vec_get(src, i)), 128.0), 128.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_u8(src, dst) -- ((clamp(src,-1,1)*128)+128) clamped to [0,255], to u8.
fn dhvani_simd_f32_to_u8(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        var c = load64(s);
        if (f64_lt(c, DH_NEG_ONE) == 1) { c = DH_NEG_ONE; }
        else { if (f64_gt(c, 1.0) == 1) { c = 1.0; } }
        var v = f64_add(f64_mul(c, 128.0), 128.0);
        if (f64_lt(v, 0) == 1) { v = 0; }
        else { if (f64_gt(v, 255.0) == 1) { v = 255.0; } }
        store64(d, f64_to(f64_trunc(v)));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

fn dhvani_simd_f32_to_u8_scalar(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        var v = f64_add(f64_mul(c, 128.0), 128.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_clamp(v, 0, 255.0))));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Resampling kernel
# ================================================================

# weighted_sum(samples, weights, out_sum, out_weight_sum) -- dot product +
# weight total, written via store64 (Cyrius has no tuple returns). Returns 0.
# Both in lane order (see PARITY).
fn dhvani_simd_weighted_sum(samples, weights, out_sum, out_weight_sum) {
    var len = dh_imin(vec_len(samples), vec_len(weights));
    var w = dh_vec_data(weights);
    store64(out_sum, dh_simd_row_dot(dh_vec_data(samples), w, len));
    store64(out_weight_sum, dh_simd_row_sum(w, len));
    return 0;
}

fn dhvani_simd_weighted_sum_scalar(samples, weights, out_sum, out_weight_sum) {
    var len = dh_imin(vec_len(samples), vec_len(weights));
    var sum = 0;            # +0.0
    var wsum = 0;           # +0.0
    var i = 0;
    while (i < len) {
        var w = vec_get(weights, i);
        sum = f64_add(sum, f64_mul(vec_get(samples, i), w));
        wsum = f64_add(wsum, w);
        i = i + 1;
    }
    store64(out_sum, sum);
    store64(out_weight_sum, wsum);
    return 0;
}

# ================================================================
# Stereo biquad (Direct Form II Transposed, cross-channel): rust-old x86.rs biquad_stereo_sse2
# ================================================================

# The kernel over raw storage, so dhvani_biquad_process can run it on its own coeffs and
# states without building vecs. data = interleaved L/R f64, frames = pairs to process;
# c -> { b0, b1, b2, a1, a2 } (DhBiquadCoeffs' layout); st_l / st_r -> { z1, z2 }
# (DhBiquadState's layout), read before and written after. Lane 0 is L, lane 1 is R: one
# interleaved frame IS one 2-lane vector, so each step is a packed op over the frame.
fn dh_simd_biquad_stereo_raw(data, frames, c, st_l, st_r) {
    var b0[16];
    var b1[16];
    var b2[16];
    var a1[16];
    var a2[16];
    var z1[16];
    var z2[16];
    var out[16];
    var t[16];
    var u[16];
    store64(&b0, load64(c));      store64(&b0 + 8, load64(c));
    store64(&b1, load64(c + 8));  store64(&b1 + 8, load64(c + 8));
    store64(&b2, load64(c + 16)); store64(&b2 + 8, load64(c + 16));
    store64(&a1, load64(c + 24)); store64(&a1 + 8, load64(c + 24));
    store64(&a2, load64(c + 32)); store64(&a2 + 8, load64(c + 32));
    store64(&z1, load64(st_l));     store64(&z1 + 8, load64(st_r));
    store64(&z2, load64(st_l + 8)); store64(&z2 + 8, load64(st_r + 8));
    var p = data;
    var end = data + frames * 16;
    while (p < end) {
        f64v_mul(&t, &b0, p, 2);
        f64v_add(&out, &t, &z1, 2);            # out = b0*in + z1
        f64v_mul(&t, &b1, p, 2);
        f64v_mul(&u, &a1, &out, 2);
        f64v_sub(&t, &t, &u, 2);
        f64v_add(&z1, &t, &z2, 2);             # z1 = (b1*in - a1*out) + z2
        f64v_mul(&t, &b2, p, 2);
        f64v_mul(&u, &a2, &out, 2);
        f64v_sub(&z2, &t, &u, 2);              # z2 = b2*in - a2*out
        store64(p, load64(&out));
        store64(p + 8, load64(&out + 8));
        p = p + 16;
    }
    store64(st_l, load64(&z1));     store64(st_r, load64(&z1 + 8));
    store64(st_l + 8, load64(&z2)); store64(st_r + 8, load64(&z2 + 8));
    return 0;
}

# biquad_stereo(samples, coeffs, state) -- process interleaved L/R in place.
# coeffs = [b0,b1,b2,a1,a2] (vec), state = [z1L,z2L,z1R,z2R] (vec, mutated).
# DHVANI_ERR_INVALID_PARAMETER for a coeffs vec under 5 or a state vec under 4: the raw
# kernel reads and writes those slots directly (the oracle's types fixed the lengths).
fn dhvani_simd_biquad_stereo(samples, coeffs, state) {
    if (vec_len(coeffs) < 5) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (vec_len(state) < 4) { return DHVANI_ERR_INVALID_PARAMETER; }
    var st = dh_vec_data(state);
    dh_simd_biquad_stereo_raw(dh_vec_data(samples), vec_len(samples) / 2,
      dh_vec_data(coeffs), st, st + 16);
    return 0;
}

fn dhvani_simd_biquad_stereo_scalar(samples, coeffs, state) {
    var b0 = vec_get(coeffs, 0);
    var b1 = vec_get(coeffs, 1);
    var b2 = vec_get(coeffs, 2);
    var a1 = vec_get(coeffs, 3);
    var a2 = vec_get(coeffs, 4);
    var frames = vec_len(samples) / 2;
    var f = 0;
    while (f < frames) {
        var idx = f * 2;
        # left
        var in_l = vec_get(samples, idx);
        var out_l = f64_add(f64_mul(b0, in_l), vec_get(state, 0));
        vec_set(state, 0, f64_add(f64_sub(f64_mul(b1, in_l), f64_mul(a1, out_l)), vec_get(state, 1)));
        vec_set(state, 1, f64_sub(f64_mul(b2, in_l), f64_mul(a2, out_l)));
        vec_set(samples, idx, out_l);
        # right
        var in_r = vec_get(samples, idx + 1);
        var out_r = f64_add(f64_mul(b0, in_r), vec_get(state, 2));
        vec_set(state, 2, f64_add(f64_sub(f64_mul(b1, in_r), f64_mul(a1, out_r)), vec_get(state, 3)));
        vec_set(state, 3, f64_sub(f64_mul(b2, in_r), f64_mul(a2, out_r)));
        vec_set(samples, idx + 1, out_r);
        f = f + 1;
    }
    return 0;
}

# --- clock.cyr ---

# clock.cyr -- sample-accurate transport clock (position, tempo, A/V sync).
# Ports rust-old/src/clock/mod.rs (AudioClock). L0, no internal deps besides
# error.cyr (dhvani_is_finite). serde derive dropped.
#
# TYPES: position_samples (u64) and sample_rate (u32) are INTEGER counts, stored
# as plain i64 slots (converted to f64 via f64_from only for time math).
# tempo_bpm is an f64 (bit pattern). running (bool) -> i64 flag (0/1).
# Option<f64> (position_beats / samples_per_beat, None when tempo<=0) ->
# DH_CLOCK_NONE (NaN) sentinel; callers test dhvani_is_finite().

var DH_CLOCK_NONE = 0x7FF8000000000000;   # NaN -- Option::None sentinel

#derive(accessors)
struct DhAudioClock { position_samples; sample_rate; tempo_bpm; running; }

# new(sample_rate) -- clock at position 0, no tempo, stopped.
#must_use
fn dhvani_clock_new(sample_rate) {
    var self = alloc(sizeof(DhAudioClock));
    DhAudioClock_set_position_samples(self, 0);
    DhAudioClock_set_sample_rate(self, sample_rate);
    DhAudioClock_set_tempo_bpm(self, 0);
    DhAudioClock_set_running(self, 0);
    return self;
}

# with_tempo(sample_rate, bpm) -- clock at 0 with tempo (bpm is f64).
#must_use
fn dhvani_clock_with_tempo(sample_rate, bpm) {
    var self = alloc(sizeof(DhAudioClock));
    DhAudioClock_set_position_samples(self, 0);
    DhAudioClock_set_sample_rate(self, sample_rate);
    DhAudioClock_set_tempo_bpm(self, bpm);
    DhAudioClock_set_running(self, 0);
    return self;
}

# position_secs -- position_samples / sample_rate (f64).
#inline
#must_use
fn dhvani_clock_position_secs(self) {
    return f64_div(f64_from(DhAudioClock_position_samples(self)),
      f64_from(DhAudioClock_sample_rate(self)));
}

# position_ms -- position in milliseconds.
#inline
#must_use
fn dhvani_clock_position_ms(self) {
    return f64_mul(dhvani_clock_position_secs(self), 1000.0);
}

# position_beats -- beat position, or DH_CLOCK_NONE (NaN) if tempo<=0.
#inline
#must_use
fn dhvani_clock_position_beats(self) {
    var tempo = DhAudioClock_tempo_bpm(self);
    if (f64_le(tempo, 0) == 1) { return DH_CLOCK_NONE; }
    return f64_div(f64_mul(dhvani_clock_position_secs(self), tempo), 60.0);
}

# advance(frames) -- add frames to position, only when running.
fn dhvani_clock_advance(self, frames) {
    if (DhAudioClock_running(self) == 1) {
        DhAudioClock_set_position_samples(self,
          DhAudioClock_position_samples(self) + frames);
    }
    return 0;
}

# start / stop -- toggle the running flag.
fn dhvani_clock_start(self) { DhAudioClock_set_running(self, 1); return 0; }
fn dhvani_clock_stop(self)  { DhAudioClock_set_running(self, 0); return 0; }

# reset -- position back to 0 (running state unchanged).
fn dhvani_clock_reset(self) { DhAudioClock_set_position_samples(self, 0); return 0; }

# seek_secs(secs) -- position = max(secs*sample_rate, 0) truncated to u64.
fn dhvani_clock_seek_secs(self, secs) {
    var samples = f64_mul(secs, f64_from(DhAudioClock_sample_rate(self)));
    DhAudioClock_set_position_samples(self, f64_to(f64_trunc(f64_max(samples, 0))));
    return 0;
}

# samples_per_beat -- or DH_CLOCK_NONE (NaN) if tempo<=0.
#inline
#must_use
fn dhvani_clock_samples_per_beat(self) {
    var tempo = DhAudioClock_tempo_bpm(self);
    if (f64_le(tempo, 0) == 1) { return DH_CLOCK_NONE; }
    return f64_div(f64_mul(f64_from(DhAudioClock_sample_rate(self)), 60.0), tempo);
}

# pts_us -- presentation timestamp in microseconds (u64), for A/V sync.
#inline
#must_use
fn dhvani_clock_pts_us(self) {
    return f64_to(f64_trunc(f64_mul(dhvani_clock_position_secs(self), 1000000.0)));
}

# --- accessors (mirror the Rust public getters) ---
#inline
#must_use
fn dhvani_clock_position_samples(self) { return DhAudioClock_position_samples(self); }
#inline
#must_use
fn dhvani_clock_sample_rate(self) { return DhAudioClock_sample_rate(self); }
#inline
#must_use
fn dhvani_clock_tempo_bpm(self) { return DhAudioClock_tempo_bpm(self); }
#inline
#must_use
fn dhvani_clock_is_running(self) { return DhAudioClock_running(self); }

# set_tempo(bpm) -- finite && >0 keeps bpm, else clamps to 0 (matches Rust).
fn dhvani_clock_set_tempo(self, bpm) {
    if (dhvani_is_finite(bpm) == 1) {
        if (f64_gt(bpm, 0) == 1) {
            DhAudioClock_set_tempo_bpm(self, bpm);
            return 0;
        }
    }
    DhAudioClock_set_tempo_bpm(self, 0);
    return 0;
}

# --- oscillator.cyr ---

# oscillator.cyr -- anti-aliased waveform generation (PolyBLEP).
# Ports rust-old/src/dsp/oscillator.rs. L0 leaf (deps: error + abaco::poly_blep).
# Waveform enum -> codes; validate() Result -> error code; serde dropped.
# rng_state u32 xorshift inlined with 32-bit masking (anonymous -- does not
# redefine dither's dh_xorshift32_next). TAU via the exact-hex stdlib F64_TAU.

var DH_WAVE_SINE     = 0;
var DH_WAVE_SAW      = 1;
var DH_WAVE_SQUARE   = 2;
var DH_WAVE_TRIANGLE = 3;
var DH_WAVE_NOISE    = 4;

#derive(accessors)
struct DhOscillator { waveform; phase; sample_rate; rng_state; tri_integrator; }

# new(waveform, sample_rate) -- phase 0, seeded RNG.
#must_use
fn dhvani_osc_new(waveform, sample_rate) {
    var self = alloc(sizeof(DhOscillator));
    DhOscillator_set_waveform(self, waveform);
    DhOscillator_set_phase(self, 0);
    DhOscillator_set_sample_rate(self, f64_from(sample_rate));
    DhOscillator_set_rng_state(self, 0x12345678);
    DhOscillator_set_tri_integrator(self, 0);
    return self;
}

# validate -- ERR_NONE if sample_rate > 0 (a NaN rate is rejected), else
# ERR_INVALID_SAMPLE_RATE.
#must_use
fn dhvani_osc_validate(self) {
    if (f64_gt(DhOscillator_sample_rate(self), 0) == 0) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

# Phase wraps use dh_fmod1 (error.cyr), Rust's `x % 1.0`. Through 2.3.2 the port
# subtracted 1 once when x >= 1, which differs from x >= 2 on (a frequency above the
# sample rate grows the phase past 1.5).

# sample(freq) -- next sample; advances phase. Call once per sample.
fn dhvani_osc_sample(self, freq) {
    var phase = DhOscillator_phase(self);
    var dt = f64_div(freq, DhOscillator_sample_rate(self));
    var wf = DhOscillator_waveform(self);
    var value = 0;
    # Cyrius `var` is function-scoped -- every local below has a unique name.
    var naive = 0;
    var p2 = 0;
    if (wf == DH_WAVE_SINE) {
        value = f64_sin(f64_mul(phase, F64_TAU));
    } elif (wf == DH_WAVE_SAW) {
        naive = f64_sub(f64_mul(2.0, phase), 1.0);
        value = f64_sub(naive, poly_blep(phase, dt));
    } elif (wf == DH_WAVE_SQUARE) {
        naive = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { naive = 1.0; }
        p2 = dh_fmod1(f64_add(phase, 0.5));
        value = f64_sub(f64_add(naive, poly_blep(phase, dt)), poly_blep(p2, dt));
    } elif (wf == DH_WAVE_TRIANGLE) {
        naive = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { naive = 1.0; }
        p2 = dh_fmod1(f64_add(phase, 0.5));
        var sq_blep = f64_sub(f64_add(naive, poly_blep(phase, dt)), poly_blep(p2, dt));
        # leaky integrator (stored unclamped; returned value is clamped)
        var tri = f64_add(DhOscillator_tri_integrator(self), f64_mul(f64_mul(sq_blep, 4.0), dt));
        tri = f64_mul(tri, f64_sub(1.0, dt));
        DhOscillator_set_tri_integrator(self, tri);
        value = f64_clamp(tri, f64_neg(1.0), 1.0);
    } else {
        # Noise: xorshift32 (u32 wrap emulated with 32-bit masks).
        var s = DhOscillator_rng_state(self);
        s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        s = (s ^ (s >> 17)) & 0xFFFFFFFF;
        s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        DhOscillator_set_rng_state(self, s);
        value = f64_sub(f64_mul(f64_div(f64_from(s), f64_from(4294967295)), 2.0), 1.0);
    }
    phase = f64_add(phase, dt);
    if (f64_ge(phase, 1.0) == 1) { phase = f64_sub(phase, 1.0); }
    DhOscillator_set_phase(self, phase);
    return value;
}

fn dhvani_osc_set_waveform(self, wf) { DhOscillator_set_waveform(self, wf); return 0; }
#inline
#must_use
fn dhvani_osc_waveform(self) { return DhOscillator_waveform(self); }

fn dhvani_osc_reset(self) {
    DhOscillator_set_phase(self, 0);
    DhOscillator_set_tri_integrator(self, 0);
    return 0;
}

#inline
#must_use
fn dhvani_osc_phase(self) { return DhOscillator_phase(self); }

fn dhvani_osc_set_sample_rate(self, sample_rate) {
    DhOscillator_set_sample_rate(self, f64_from(sample_rate));
    return 0;
}

# --- gain_smoother.cyr ---

# gain_smoother.cyr -- exponential-moving-average gain smoother (anti-pumping).
# Ports rust-old/src/dsp/gain_smoother.rs. L0, deps error only.
# GainSmootherParams held by GainSmoother as a nested struct handle. Attack
# (gain decreasing, fast) vs release (increasing, slow). serde dropped.
# from_params()/set_params() COPY the params into storage the smoother owns (the
# oracle takes them by value); validate() rejects NaN, as the oracle's `contains` does.

#derive(accessors)
struct DhGainSmootherParams { attack; release; }

#derive(accessors)
struct DhGainSmoother { params; current; }

# ---- GainSmootherParams ----
#must_use
fn dhvani_gsparams_new(attack, release) {
    var p = alloc(sizeof(DhGainSmootherParams));
    DhGainSmootherParams_set_attack(p, attack);
    DhGainSmootherParams_set_release(p, release);
    return p;
}
#must_use
fn dhvani_gsparams_default() { return dhvani_gsparams_new(0.3, 0.05); }
#inline
#must_use
fn dhvani_gsparams_attack(p) { return DhGainSmootherParams_attack(p); }
#inline
#must_use
fn dhvani_gsparams_release(p) { return DhGainSmootherParams_release(p); }

# validate -- ERR_NONE if attack & release in [0,1] (NaN is outside), else
# ERR_INVALID_PARAMETER.
#must_use
fn dhvani_gsparams_validate(p) {
    if (dh_in_range(DhGainSmootherParams_attack(p), 0, 1.0) == 0)  { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhGainSmootherParams_release(p), 0, 1.0) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# copy src's fields into dst (a smoother's own params); returns dst.
fn dh_gsparams_copy(dst, src) {
    DhGainSmootherParams_set_attack(dst, DhGainSmootherParams_attack(src));
    DhGainSmootherParams_set_release(dst, DhGainSmootherParams_release(src));
    return dst;
}

# ---- GainSmoother ----
# new(attack, release) -- clamps coeffs to [0,1]; current starts at 1.0.
#must_use
fn dhvani_gs_new(attack, release) {
    var self = alloc(sizeof(DhGainSmoother));
    DhGainSmoother_set_params(self, dhvani_gsparams_new(f64_clamp(attack, 0, 1.0), f64_clamp(release, 0, 1.0)));
    DhGainSmoother_set_current(self, 1.0);
    return self;
}
#must_use
fn dhvani_gs_from_params(params) {
    var self = alloc(sizeof(DhGainSmoother));
    DhGainSmoother_set_params(self, dh_gsparams_copy(alloc(sizeof(DhGainSmootherParams)), params));
    DhGainSmoother_set_current(self, 1.0);
    return self;
}

# smooth(target) -- converge toward target (attack coeff if decreasing, else
# release); returns the new smoothed value.
fn dhvani_gs_smooth(self, target) {
    var current = DhGainSmoother_current(self);
    var p = DhGainSmoother_params(self);
    var alpha = DhGainSmootherParams_release(p);
    if (f64_lt(target, current) == 1) { alpha = DhGainSmootherParams_attack(p); }
    current = f64_add(current, f64_mul(alpha, f64_sub(target, current)));
    DhGainSmoother_set_current(self, current);
    return current;
}

#inline
#must_use
fn dhvani_gs_current(self) { return DhGainSmoother_current(self); }
fn dhvani_gs_reset(self, value) { DhGainSmoother_set_current(self, value); return 0; }
fn dhvani_gs_set_params(self, params) { dh_gsparams_copy(DhGainSmoother_params(self), params); return 0; }
#inline
#must_use
fn dhvani_gs_params(self) { return DhGainSmoother_params(self); }

# --- envelope.cyr ---

# envelope.cyr -- ADSR envelope generator.
# Ports rust-old/src/dsp/envelope.rs. L0, deps error only.
# AdsrParams + EnvelopeState enum -> codes. validate()/set_params() Result ->
# error codes. stage_pos is an integer sample counter. serde dropped.
# The params are COPIED into storage the envelope owns (the oracle takes them by
# value), so a later change to the caller's handle cannot skip validate(), and
# validate() rejects NaN in every bound (the oracle's `contains` does for sustain; its
# `< 0.0` tests let a NaN attack, decay or release through).

# ---- EnvelopeState ----
var DH_ENV_IDLE    = 0;
var DH_ENV_ATTACK  = 1;
var DH_ENV_DECAY   = 2;
var DH_ENV_SUSTAIN = 3;
var DH_ENV_RELEASE = 4;

#derive(accessors)
struct DhAdsrParams { attack; decay; sustain; release; }

#derive(accessors)
struct DhEnvelope { params; state; level; sample_rate; stage_pos; release_start_level; }

# ---- AdsrParams ----
#must_use
fn dhvani_adsr_new(attack, decay, sustain, release) {
    var p = alloc(sizeof(DhAdsrParams));
    DhAdsrParams_set_attack(p, attack);
    DhAdsrParams_set_decay(p, decay);
    DhAdsrParams_set_sustain(p, sustain);
    DhAdsrParams_set_release(p, release);
    return p;
}
#must_use
fn dhvani_adsr_default() { return dhvani_adsr_new(0.01, 0.1, 0.7, 0.3); }

# copy src's fields into dst (an envelope's own params); returns dst.
fn dh_adsr_copy(dst, src) {
    DhAdsrParams_set_attack(dst, DhAdsrParams_attack(src));
    DhAdsrParams_set_decay(dst, DhAdsrParams_decay(src));
    DhAdsrParams_set_sustain(dst, DhAdsrParams_sustain(src));
    DhAdsrParams_set_release(dst, DhAdsrParams_release(src));
    return dst;
}

# validate -- attack/decay/release >= 0, sustain in [0,1] (NaN rejected).
#must_use
fn dhvani_adsr_validate(p) {
    if (dh_in_range(DhAdsrParams_attack(p), 0, DH_POS_INF) == 0)  { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhAdsrParams_decay(p), 0, DH_POS_INF) == 0)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhAdsrParams_sustain(p), 0, 1.0) == 0)        { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhAdsrParams_release(p), 0, DH_POS_INF) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- Envelope ----
#must_use
fn dhvani_env_new(params, sample_rate) {
    var self = alloc(sizeof(DhEnvelope));
    DhEnvelope_set_params(self, dh_adsr_copy(alloc(sizeof(DhAdsrParams)), params));
    DhEnvelope_set_state(self, DH_ENV_IDLE);
    DhEnvelope_set_level(self, 0);
    DhEnvelope_set_sample_rate(self, f64_from(sample_rate));
    DhEnvelope_set_stage_pos(self, 0);
    DhEnvelope_set_release_start_level(self, 0);
    return self;
}

# trigger -- note-on: enter Attack.
fn dhvani_env_trigger(self) {
    DhEnvelope_set_state(self, DH_ENV_ATTACK);
    DhEnvelope_set_stage_pos(self, 0);
    return 0;
}

# release -- note-off: enter Release from the current level (unless Idle).
fn dhvani_env_release(self) {
    if (DhEnvelope_state(self) != DH_ENV_IDLE) {
        DhEnvelope_set_release_start_level(self, DhEnvelope_level(self));
        DhEnvelope_set_state(self, DH_ENV_RELEASE);
        DhEnvelope_set_stage_pos(self, 0);
    }
    return 0;
}

# tick -- advance one sample, return current level (0..1).
fn dhvani_env_tick(self) {
    var state = DhEnvelope_state(self);
    var p = DhEnvelope_params(self);
    var sr = DhEnvelope_sample_rate(self);
    var stage_pos = DhEnvelope_stage_pos(self);
    var samples = 0;
    var progress = 0;
    if (state == DH_ENV_IDLE) {
        DhEnvelope_set_level(self, 0);
    } elif (state == DH_ENV_ATTACK) {
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_attack(p), sr), 1.0)));
        var lvl = f64_div(f64_from(stage_pos), f64_from(samples));
        if (f64_ge(lvl, 1.0) == 1) {
            DhEnvelope_set_level(self, 1.0);
            DhEnvelope_set_state(self, DH_ENV_DECAY);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_level(self, lvl);
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    } elif (state == DH_ENV_DECAY) {
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_decay(p), sr), 1.0)));
        progress = f64_div(f64_from(stage_pos), f64_from(samples));
        var sustain = DhAdsrParams_sustain(p);
        DhEnvelope_set_level(self, f64_add(1.0, f64_mul(f64_sub(sustain, 1.0), progress)));
        if (f64_ge(progress, 1.0) == 1) {
            DhEnvelope_set_level(self, sustain);
            DhEnvelope_set_state(self, DH_ENV_SUSTAIN);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    } elif (state == DH_ENV_SUSTAIN) {
        DhEnvelope_set_level(self, DhAdsrParams_sustain(p));
    } else {
        # Release
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_release(p), sr), 1.0)));
        progress = f64_div(f64_from(stage_pos), f64_from(samples));
        DhEnvelope_set_level(self, f64_mul(DhEnvelope_release_start_level(self), f64_sub(1.0, progress)));
        if (f64_ge(progress, 1.0) == 1) {
            DhEnvelope_set_level(self, 0);
            DhEnvelope_set_state(self, DH_ENV_IDLE);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    }
    return DhEnvelope_level(self);
}

#inline
#must_use
fn dhvani_env_level(self) { return DhEnvelope_level(self); }
#inline
#must_use
fn dhvani_env_state(self) { return DhEnvelope_state(self); }
#must_use
fn dhvani_env_is_finished(self) {
    if (DhEnvelope_state(self) == DH_ENV_IDLE) { return 1; }
    return 0;
}
fn dhvani_env_set_sample_rate(self, sample_rate) { DhEnvelope_set_sample_rate(self, f64_from(sample_rate)); return 0; }

fn dhvani_env_reset(self) {
    DhEnvelope_set_state(self, DH_ENV_IDLE);
    DhEnvelope_set_level(self, 0);
    DhEnvelope_set_stage_pos(self, 0);
    return 0;
}

# set_params -- validate, then copy into the envelope's own params (no allocation);
# returns error code on invalid params.
fn dhvani_env_set_params(self, params) {
    var rc = dhvani_adsr_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dh_adsr_copy(DhEnvelope_params(self), params);
    return DHVANI_ERR_NONE;
}

# --- lfo.cyr ---

# lfo.cyr -- low-frequency oscillator for modulation (6 shapes).
# Ports rust-old/src/dsp/lfo.rs. L0, deps error only. LfoShape enum -> codes;
# validate() Result -> error code; serde dropped. Output range [-depth,+depth].
# S&H uses xorshift32 (inline, 32-bit masked); TAU via exact-hex F64_TAU.

var DH_LFO_SINE            = 0;
var DH_LFO_TRIANGLE        = 1;
var DH_LFO_SQUARE          = 2;
var DH_LFO_SAWUP           = 3;
var DH_LFO_SAWDOWN         = 4;
var DH_LFO_SAMPLE_AND_HOLD = 5;

#derive(accessors)
struct DhLfo { shape; rate; depth; phase; sample_rate; sh_value; rng_state; prev_phase; }

# new(shape, rate, depth, sample_rate) -- depth clamped to [0,1]; RNG seeded.
#must_use
fn dhvani_lfo_new(shape, rate, depth, sample_rate) {
    var self = alloc(sizeof(DhLfo));
    DhLfo_set_shape(self, shape);
    DhLfo_set_rate(self, rate);
    DhLfo_set_depth(self, f64_clamp(depth, 0, 1.0));
    DhLfo_set_phase(self, 0);
    DhLfo_set_sample_rate(self, f64_from(sample_rate));
    DhLfo_set_sh_value(self, 0);
    DhLfo_set_rng_state(self, 0xDEADBEEF);
    DhLfo_set_prev_phase(self, 0);
    return self;
}

# validate -- rate>=0, depth>=0, sample_rate>0. Every bound rejects NaN (the oracle's
# `< 0.0` / `<= 0.0` tests let a NaN through).
#must_use
fn dhvani_lfo_validate(self) {
    if (dh_in_range(DhLfo_rate(self), 0, DH_POS_INF) == 0)  { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhLfo_depth(self), 0, DH_POS_INF) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(DhLfo_sample_rate(self), 0) == 0)            { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

# tick -- advance one sample; return value in [-depth, +depth].
fn dhvani_lfo_tick(self) {
    var phase = DhLfo_phase(self);
    var shape = DhLfo_shape(self);
    var raw = 0;
    if (shape == DH_LFO_SINE) {
        raw = f64_sin(f64_mul(phase, F64_TAU));
    } elif (shape == DH_LFO_TRIANGLE) {
        raw = f64_sub(f64_mul(4.0, f64_abs(f64_sub(phase, 0.5))), 1.0);
    } elif (shape == DH_LFO_SQUARE) {
        raw = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { raw = 1.0; }
    } elif (shape == DH_LFO_SAWUP) {
        raw = f64_sub(f64_mul(2.0, phase), 1.0);
    } elif (shape == DH_LFO_SAWDOWN) {
        raw = f64_sub(1.0, f64_mul(2.0, phase));
    } else {
        # SampleAndHold: new value on phase wrap.
        if (f64_lt(phase, DhLfo_prev_phase(self)) == 1) {
            var s = DhLfo_rng_state(self);
            s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
            s = (s ^ (s >> 17)) & 0xFFFFFFFF;
            s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
            DhLfo_set_rng_state(self, s);
            DhLfo_set_sh_value(self, f64_sub(f64_mul(f64_div(f64_from(s), f64_from(4294967295)), 2.0), 1.0));
        }
        raw = DhLfo_sh_value(self);
    }
    DhLfo_set_prev_phase(self, phase);
    var new_phase = f64_add(phase, f64_div(DhLfo_rate(self), DhLfo_sample_rate(self)));
    if (f64_ge(new_phase, 1.0) == 1) { new_phase = f64_sub(new_phase, 1.0); }
    DhLfo_set_phase(self, new_phase);
    return f64_mul(raw, DhLfo_depth(self));
}

fn dhvani_lfo_set_sample_rate(self, sample_rate) { DhLfo_set_sample_rate(self, f64_from(sample_rate)); return 0; }

fn dhvani_lfo_reset(self) {
    DhLfo_set_phase(self, 0);
    DhLfo_set_prev_phase(self, 0);
    DhLfo_set_sh_value(self, 0);
    return 0;
}

fn dhvani_lfo_set_rate(self, rate) { DhLfo_set_rate(self, f64_max(rate, 0)); return 0; }
fn dhvani_lfo_set_depth(self, depth) { DhLfo_set_depth(self, f64_clamp(depth, 0, 1.0)); return 0; }
fn dhvani_lfo_set_shape(self, shape) { DhLfo_set_shape(self, shape); return 0; }

#inline
#must_use
fn dhvani_lfo_rate(self) { return DhLfo_rate(self); }
#inline
#must_use
fn dhvani_lfo_depth(self) { return DhLfo_depth(self); }
#inline
#must_use
fn dhvani_lfo_shape(self) { return DhLfo_shape(self); }
#inline
#must_use
fn dhvani_lfo_phase(self) { return DhLfo_phase(self); }

# --- automation.cyr ---

# automation.cyr -- sample-accurate automation curves (breakpoint interpolation).
# Ports rust-old/src/dsp/automation.rs. L0, deps error only (+ F64_PI stdlib).
# CurveType enum -> codes; the Exponential(f32) payload becomes a separate `exp`
# field on the breakpoint. serde dropped.
#
# Breakpoint search is the oracle's `binary_search_by_key(&frame, |b| b.frame)
# .unwrap_or_else(|i| i)`, answered the way rust-old's toolchain answers it (1.89,
# checked again on 1.100): Ok(the LAST breakpoint at that frame) when there is one,
# else Err(the insertion point). That decides where add() puts a breakpoint at a frame
# already taken (just before the last one there, so the first one added stays last)
# and which pair value_at() interpolates between. Through 2.3.2 the port appended
# same-frame breakpoints in insertion order and scanned linearly for the first
# breakpoint >= the query, so a jump authored as two breakpoints at one frame
# interpolated from the wrong one.

var DH_CURVE_STEP        = 0;
var DH_CURVE_LINEAR      = 1;
var DH_CURVE_EXPONENTIAL = 2;   # exponent lives in the breakpoint's `exp` field
var DH_CURVE_SMOOTH      = 3;

#derive(accessors)
struct DhBreakpoint { frame; value; curve; exp; }

#derive(accessors)
struct DhAutomationLane { breakpoints; default_value; }

# Breakpoint::new(frame, value, curve, exp). exp is only used for EXPONENTIAL.
#must_use
fn dhvani_breakpoint_new(frame, value, curve, exp) {
    var bp = alloc(sizeof(DhBreakpoint));
    DhBreakpoint_set_frame(bp, frame);
    DhBreakpoint_set_value(bp, value);
    DhBreakpoint_set_curve(bp, curve);
    DhBreakpoint_set_exp(bp, exp);
    return bp;
}

# interpolate between two values along `curve` at `current` frame.
#must_use
fn dhvani_auto_interpolate(from, to, from_frame, to_frame, current, curve, exp) {
    if (from_frame == to_frame) { return to; }
    var t = f64_div(f64_from(current - from_frame), f64_from(to_frame - from_frame));
    t = f64_clamp(t, 0, 1.0);
    if (curve == DH_CURVE_STEP)   { return from; }
    if (curve == DH_CURVE_LINEAR) { return f64_add(from, f64_mul(f64_sub(to, from), t)); }
    if (curve == DH_CURVE_EXPONENTIAL) {
        var e = f64_max(exp, 0.001);
        # Historically f64_pow(0, e) returned NaN in Cyrius (ln(0)) while Rust
        # powf(0,e) = 0, so this guard was load-bearing. ganita 1.1.4 (via hisab
        # 2.11.2) fixed the zero-base case — f64_pow(0, e) is now 0 — so the guard
        # is redundant, but it is KEPT: it states the oracle's contract explicitly
        # and costs one predictable branch outside any hot loop.
        var tp = 0;
        if (f64_gt(t, 0) == 1) { tp = f64_pow(t, e); }
        return f64_add(from, f64_mul(f64_sub(to, from), tp));
    }
    # Smooth: cosine interpolation.
    var t_smooth = f64_mul(f64_sub(1.0, f64_cos(f64_mul(t, F64_PI))), 0.5);
    return f64_add(from, f64_mul(f64_sub(to, from), t_smooth));
}

# new(default_value) -- empty lane.
#must_use
fn dhvani_auto_new(default_value) {
    var self = alloc(sizeof(DhAutomationLane));
    DhAutomationLane_set_breakpoints(self, vec_new());
    DhAutomationLane_set_default_value(self, default_value);
    return self;
}

# Index of the first breakpoint whose frame is > `frame` (binary search; the lane is
# kept sorted by add()).
#must_use
fn dh_auto_upper(bps, frame) {
    var lo = 0;
    var hi = vec_len(bps);
    while (lo < hi) {
        var mid = lo + (hi - lo) / 2;
        if (DhBreakpoint_frame(vec_get(bps, mid)) <= frame) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

# The oracle's binary_search_by_key(&frame).unwrap_or_else(|i| i) (see the header): the
# last breakpoint at `frame` if there is one, else the insertion point.
#must_use
fn dh_auto_search(bps, frame) {
    var ub = dh_auto_upper(bps, frame);
    if (ub > 0) {
        if (DhBreakpoint_frame(vec_get(bps, ub - 1)) == frame) { return ub - 1; }
    }
    return ub;
}

# add(bp) -- insert at the oracle's search position, keeping the lane sorted by frame.
fn dhvani_auto_add(self, bp) {
    var bps = DhAutomationLane_breakpoints(self);
    var pos = dh_auto_search(bps, DhBreakpoint_frame(bp));
    vec_push(bps, bp);
    var i = vec_len(bps) - 1;
    while (i > pos) {
        vec_set(bps, i, vec_get(bps, i - 1));
        i = i - 1;
    }
    vec_set(bps, pos, bp);
    return 0;
}

# remove_at(frame) -- drop all breakpoints at `frame`, compacting in place (the
# oracle's retain; no new vec).
fn dhvani_auto_remove_at(self, frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var n = vec_len(bps);
    var kept = 0;
    var i = 0;
    while (i < n) {
        var bp = vec_get(bps, i);
        if (DhBreakpoint_frame(bp) != frame) {
            if (kept != i) { vec_set(bps, kept, bp); }
            kept = kept + 1;
        }
        i = i + 1;
    }
    vec_truncate(bps, kept);
    return 0;
}

# clear -- drop every breakpoint, keeping the vec (no allocation).
fn dhvani_auto_clear(self) { vec_truncate(DhAutomationLane_breakpoints(self), 0); return 0; }

#inline
#must_use
fn dhvani_auto_len(self) { return vec_len(DhAutomationLane_breakpoints(self)); }
#must_use
fn dhvani_auto_is_empty(self) {
    if (vec_len(DhAutomationLane_breakpoints(self)) == 0) { return 1; }
    return 0;
}
#inline
#must_use
fn dhvani_auto_breakpoints(self) { return DhAutomationLane_breakpoints(self); }

# value_at(frame) -- interpolated value.
#must_use
fn dhvani_auto_value_at(self, frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var n = vec_len(bps);
    if (n == 0) { return DhAutomationLane_default_value(self); }
    var first = vec_get(bps, 0);
    if (frame <= DhBreakpoint_frame(first)) {
        if (DhBreakpoint_curve(first) == DH_CURVE_STEP) { return DhAutomationLane_default_value(self); }
        return DhBreakpoint_value(first);
    }
    var last = vec_get(bps, n - 1);
    if (frame >= DhBreakpoint_frame(last)) { return DhBreakpoint_value(last); }
    var idx = dh_auto_search(bps, frame);
    if (idx == 0) { return DhBreakpoint_value(first); }
    var prev = vec_get(bps, idx - 1);
    var next = vec_get(bps, idx);
    return dhvani_auto_interpolate(DhBreakpoint_value(prev), DhBreakpoint_value(next),
      DhBreakpoint_frame(prev), DhBreakpoint_frame(next), frame,
      DhBreakpoint_curve(next), DhBreakpoint_exp(next));
}

# render(output, start_frame) -- fill output[i] with value_at(start_frame+i).
fn dhvani_auto_render(self, output, start_frame) {
    var n = vec_len(output);
    var i = 0;
    while (i < n) {
        vec_set(output, i, dhvani_auto_value_at(self, start_frame + i));
        i = i + 1;
    }
    return 0;
}

# render_fast(output, start_frame) -- segment-walking render (monotone seg_idx).
fn dhvani_auto_render_fast(self, output, start_frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var nbp = vec_len(bps);
    var n = vec_len(output);
    if (nbp == 0) {
        var dv = DhAutomationLane_default_value(self);
        var j = 0;
        while (j < n) { vec_set(output, j, dv); j = j + 1; }
        return 0;
    }
    # seeded by the oracle's search, then walked forward (O(log n + block) per call)
    var seg_idx = dh_auto_search(bps, start_frame);
    var i = 0;
    while (i < n) {
        var frame = start_frame + i;
        var advancing = 1;
        while (advancing == 1) {
            if (seg_idx < nbp) {
                if (DhBreakpoint_frame(vec_get(bps, seg_idx)) <= frame) { seg_idx = seg_idx + 1; }
                else { advancing = 0; }
            } else { advancing = 0; }
        }
        if (seg_idx == 0) {
            var f0 = vec_get(bps, 0);
            if (DhBreakpoint_curve(f0) == DH_CURVE_STEP) { vec_set(output, i, DhAutomationLane_default_value(self)); }
            else { vec_set(output, i, DhBreakpoint_value(f0)); }
        } elif (seg_idx >= nbp) {
            vec_set(output, i, DhBreakpoint_value(vec_get(bps, nbp - 1)));
        } else {
            var prev = vec_get(bps, seg_idx - 1);
            var next = vec_get(bps, seg_idx);
            vec_set(output, i, dhvani_auto_interpolate(DhBreakpoint_value(prev), DhBreakpoint_value(next),
                DhBreakpoint_frame(prev), DhBreakpoint_frame(next), frame,
                DhBreakpoint_curve(next), DhBreakpoint_exp(next)));
        }
        i = i + 1;
    }
    return 0;
}

# --- midi.cyr ---

# midi.cyr -- MIDI 1.0 core types: NoteEvent, ControlChange, MidiEvent, MidiClip.
# Ports rust-old/src/midi/mod.rs. L0: dep error only (stdlib vec).
# The data-carrying MidiEvent enum -> a `kind` code + a fat struct holding every
# variant's fields (only position/channel are read across variants). FramePos
# (u64) and the u8 fields -> i64 slots. serde dropped. Names are string handles.
#
# Allocation (free-less bump allocator): every constructor and every allocating
# clip query (notes_at, note_ons_at, note_offs_at, events_in_range) returns a
# FRESH handle/vec that is never reclaimed. Real-time callers use the zero-alloc
# forms instead: `*_init(e, ...)` reinitialises a caller-owned event handle, and
# the clip queries' `*_into(..., out)` forms truncate + refill a caller-owned vec
# (0 bytes per call once `out` has grown to the result size).

# ---- NoteEvent ----
#derive(accessors)
struct DhNoteEvent { position; duration; note; velocity; channel; }
# init -- (re)initialise a caller-owned DhNoteEvent handle in place; returns e.
# The zero-alloc twin of _new for event reuse in a render loop.
fn dhvani_note_event_init(e, position, duration, note, velocity, channel) {
    DhNoteEvent_set_position(e, position);
    DhNoteEvent_set_duration(e, duration);
    DhNoteEvent_set_note(e, note);
    DhNoteEvent_set_velocity(e, velocity);
    DhNoteEvent_set_channel(e, channel);
    return e;
}
#must_use
fn dhvani_note_event_new(position, duration, note, velocity, channel) {
    return dhvani_note_event_init(alloc(sizeof(DhNoteEvent)), position, duration, note, velocity, channel);
}
#inline
#must_use
fn dhvani_note_event_position(e) { return DhNoteEvent_position(e); }
#inline
#must_use
fn dhvani_note_event_duration(e) { return DhNoteEvent_duration(e); }
#inline
#must_use
fn dhvani_note_event_note(e) { return DhNoteEvent_note(e); }
#inline
#must_use
fn dhvani_note_event_velocity(e) { return DhNoteEvent_velocity(e); }
#inline
#must_use
fn dhvani_note_event_channel(e) { return DhNoteEvent_channel(e); }

# ---- ControlChange ----
#derive(accessors)
struct DhControlChange { position; controller; value; channel; }
# init -- (re)initialise a caller-owned DhControlChange handle; returns e.
fn dhvani_cc_init(e, position, controller, value, channel) {
    DhControlChange_set_position(e, position);
    DhControlChange_set_controller(e, controller);
    DhControlChange_set_value(e, value);
    DhControlChange_set_channel(e, channel);
    return e;
}
#must_use
fn dhvani_cc_new(position, controller, value, channel) {
    return dhvani_cc_init(alloc(sizeof(DhControlChange)), position, controller, value, channel);
}
#inline
#must_use
fn dhvani_cc_position(e) { return DhControlChange_position(e); }
#inline
#must_use
fn dhvani_cc_controller(e) { return DhControlChange_controller(e); }
#inline
#must_use
fn dhvani_cc_value(e) { return DhControlChange_value(e); }
#inline
#must_use
fn dhvani_cc_channel(e) { return DhControlChange_channel(e); }

# ---- MidiEvent (data-carrying enum -> kind code + fat struct) ----
var DH_MIDI_NOTE_ON         = 0;
var DH_MIDI_NOTE_OFF        = 1;
var DH_MIDI_CONTROL_CHANGE  = 2;
var DH_MIDI_PITCH_BEND      = 3;
var DH_MIDI_AFTERTOUCH      = 4;
var DH_MIDI_POLY_AFTERTOUCH = 5;
var DH_MIDI_PROGRAM_CHANGE  = 6;

#derive(accessors)
struct DhMidiEvent { kind; position; note; velocity; controller; value; pressure; program; channel; }

# reset a caller-owned event: kind/position/channel set, every payload slot 0.
fn dh_midi_event_reset(e, kind, position, channel) {
    DhMidiEvent_set_kind(e, kind);
    DhMidiEvent_set_position(e, position);
    DhMidiEvent_set_note(e, 0);
    DhMidiEvent_set_velocity(e, 0);
    DhMidiEvent_set_controller(e, 0);
    DhMidiEvent_set_value(e, 0);
    DhMidiEvent_set_pressure(e, 0);
    DhMidiEvent_set_program(e, 0);
    DhMidiEvent_set_channel(e, channel);
    return e;
}

# *_init(e, ...) -- re-tag a caller-owned DhMidiEvent as that variant (all other
# payload slots zeroed); returns e. The constructors below are alloc + _init.
fn dhvani_midi_note_on_init(e, position, note, velocity, channel) {
    dh_midi_event_reset(e, DH_MIDI_NOTE_ON, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_velocity(e, velocity);
    return e;
}
fn dhvani_midi_note_off_init(e, position, note, velocity, channel) {
    dh_midi_event_reset(e, DH_MIDI_NOTE_OFF, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_velocity(e, velocity);
    return e;
}
fn dhvani_midi_control_change_init(e, position, controller, value, channel) {
    dh_midi_event_reset(e, DH_MIDI_CONTROL_CHANGE, position, channel);
    DhMidiEvent_set_controller(e, controller);
    DhMidiEvent_set_value(e, value);
    return e;
}
fn dhvani_midi_pitch_bend_init(e, position, value, channel) {
    dh_midi_event_reset(e, DH_MIDI_PITCH_BEND, position, channel);
    DhMidiEvent_set_value(e, value);
    return e;
}
fn dhvani_midi_aftertouch_init(e, position, pressure, channel) {
    dh_midi_event_reset(e, DH_MIDI_AFTERTOUCH, position, channel);
    DhMidiEvent_set_pressure(e, pressure);
    return e;
}
fn dhvani_midi_poly_aftertouch_init(e, position, note, pressure, channel) {
    dh_midi_event_reset(e, DH_MIDI_POLY_AFTERTOUCH, position, channel);
    DhMidiEvent_set_note(e, note);
    DhMidiEvent_set_pressure(e, pressure);
    return e;
}
fn dhvani_midi_program_change_init(e, position, program, channel) {
    dh_midi_event_reset(e, DH_MIDI_PROGRAM_CHANGE, position, channel);
    DhMidiEvent_set_program(e, program);
    return e;
}

#must_use
fn dhvani_midi_note_on(position, note, velocity, channel) {
    return dhvani_midi_note_on_init(alloc(sizeof(DhMidiEvent)), position, note, velocity, channel);
}
#must_use
fn dhvani_midi_note_off(position, note, velocity, channel) {
    return dhvani_midi_note_off_init(alloc(sizeof(DhMidiEvent)), position, note, velocity, channel);
}
#must_use
fn dhvani_midi_control_change(position, controller, value, channel) {
    return dhvani_midi_control_change_init(alloc(sizeof(DhMidiEvent)), position, controller, value, channel);
}
#must_use
fn dhvani_midi_pitch_bend(position, value, channel) {
    return dhvani_midi_pitch_bend_init(alloc(sizeof(DhMidiEvent)), position, value, channel);
}
#must_use
fn dhvani_midi_aftertouch(position, pressure, channel) {
    return dhvani_midi_aftertouch_init(alloc(sizeof(DhMidiEvent)), position, pressure, channel);
}
#must_use
fn dhvani_midi_poly_aftertouch(position, note, pressure, channel) {
    return dhvani_midi_poly_aftertouch_init(alloc(sizeof(DhMidiEvent)), position, note, pressure, channel);
}
#must_use
fn dhvani_midi_program_change(position, program, channel) {
    return dhvani_midi_program_change_init(alloc(sizeof(DhMidiEvent)), position, program, channel);
}
#inline
#must_use
fn dhvani_midi_event_kind(e) { return DhMidiEvent_kind(e); }
#inline
#must_use
fn dhvani_midi_event_position(e) { return DhMidiEvent_position(e); }
#inline
#must_use
fn dhvani_midi_event_channel(e) { return DhMidiEvent_channel(e); }

# ---- MidiClip ----
# Invariants the queries rely on (kept by every dhvani_midi_clip_* mutator; the
# notes()/control_changes() vecs are READ-ONLY views -- Rust hands out &[T]):
#   * notes are sorted by position (non-decreasing). add_note/merge insert in
#     order; quantize maps positions through a monotone function; transpose
#     leaves positions alone.
#   * max_note_duration >= every note's duration (starts 0, only ever raised;
#     no mutator shortens a duration). It bounds how far before a window a note
#     can start and still reach into it, which makes the lower-bound binary
#     search in the queries sound for any mix of durations.
#derive(accessors)
struct DhMidiClip { name; notes; control_changes; timeline_pos; duration; max_note_duration; }
#must_use
fn dhvani_midi_clip_new(name, timeline_pos, duration) {
    var c = alloc(sizeof(DhMidiClip));
    DhMidiClip_set_name(c, name);
    DhMidiClip_set_notes(c, vec_new());
    DhMidiClip_set_control_changes(c, vec_new());
    DhMidiClip_set_timeline_pos(c, timeline_pos);
    DhMidiClip_set_duration(c, duration);
    DhMidiClip_set_max_note_duration(c, 0);
    return c;
}
#inline
#must_use
fn dhvani_midi_clip_name(c) { return DhMidiClip_name(c); }
#inline
#must_use
fn dhvani_midi_clip_notes(c) { return DhMidiClip_notes(c); }
#inline
#must_use
fn dhvani_midi_clip_control_changes(c) { return DhMidiClip_control_changes(c); }
#inline
#must_use
fn dhvani_midi_clip_timeline_pos(c) { return DhMidiClip_timeline_pos(c); }
#inline
#must_use
fn dhvani_midi_clip_duration(c) { return DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_end_pos(c) { return DhMidiClip_timeline_pos(c) + DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_event_count(c) { return vec_len(DhMidiClip_notes(c)) + vec_len(DhMidiClip_control_changes(c)); }

# insert a note handle keeping notes sorted by position (partition_point <=:
# new note goes AFTER equal-position notes).
fn dh_midi_insert_note(notes, e) {
    var pos = DhNoteEvent_position(e);
    vec_push(notes, e);
    var i = vec_len(notes) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(notes, i - 1);
            if (DhNoteEvent_position(left) > pos) {
                vec_set(notes, i, left); vec_set(notes, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}
# insert a note handle into the clip (sorted) and raise max_note_duration.
fn dh_midi_clip_insert_note(self, e) {
    dh_midi_insert_note(DhMidiClip_notes(self), e);
    if (DhNoteEvent_duration(e) > DhMidiClip_max_note_duration(self)) {
        DhMidiClip_set_max_note_duration(self, DhNoteEvent_duration(e));
    }
    return 0;
}
fn dhvani_midi_clip_add_note(self, position, duration, note, velocity, channel) {
    dh_midi_clip_insert_note(self, dhvani_note_event_new(position, duration, note, velocity, channel));
    return 0;
}
fn dhvani_midi_clip_add_cc(self, position, controller, value, channel) {
    var ccs = DhMidiClip_control_changes(self);
    var e = dhvani_cc_new(position, controller, value, channel);
    vec_push(ccs, e);
    var i = vec_len(ccs) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(ccs, i - 1);
            if (DhControlChange_position(left) > position) {
                vec_set(ccs, i, left); vec_set(ccs, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}

# first index whose note position is >= x (binary search; sound because the
# notes are sorted by position). Returns vec_len when every note is before x.
fn dh_midi_lower_bound(notes, x) {
    var lo = 0;
    var hi = vec_len(notes);
    while (lo < hi) {
        var mid = lo + (hi - lo) / 2;
        if (DhNoteEvent_position(vec_get(notes, mid)) < x) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

# Query pruning (all four queries return exactly what a full linear filter over
# the notes would, in note order): a note with duration d <= max_note_duration
# that ends after `t` (position + d > t) must START after t - max_note_duration,
# so the scan begins at lower_bound(t - max_note_duration + 1); and because the
# notes are sorted it stops at the first note starting past the window.

# notes active at `frame` (position <= frame < position+duration) -> `out`
# (truncated first). Returns the match count. Zero-alloc once `out` has room.
fn dhvani_midi_clip_notes_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame - DhMidiClip_max_note_duration(self) + 1);
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p > frame) { break; }
        if (frame < p + DhNoteEvent_duration(e)) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_notes_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_notes_at_into(self, frame, out);
    return out;
}

# note-ons starting exactly at `frame` -> `out`. Returns the match count.
fn dhvani_midi_clip_note_ons_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame);
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) != frame) { break; }
        vec_push(out, e);
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_note_ons_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_note_ons_at_into(self, frame, out);
    return out;
}

# note-offs ending exactly at `frame` (position+duration == frame) -> `out`.
# Returns the match count. Only the lower bound is pruned: position = frame -
# duration >= frame - max_note_duration. There is no upper stop -- with an i64
# (possibly negative) duration a matching note may start after `frame`.
fn dhvani_midi_clip_note_offs_at_into(self, frame, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, frame - DhMidiClip_max_note_duration(self));
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) + DhNoteEvent_duration(e) == frame) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_note_offs_at(self, frame) {
    var out = vec_new();
    dhvani_midi_clip_note_offs_at_into(self, frame, out);
    return out;
}

# note events overlapping [start, end) -- position < end AND position+duration >
# start -- -> `out`. Returns the match count.
# PARITY NOTE: rust-old/src/midi/mod.rs:351 binary-searches
# `partition_point(|n| n.position + n.duration <= start)` over notes sorted by
# POSITION; end times are not monotone in that order, so the search can land
# past a long note that still overlaps (notes (0,1000),(100,10),(200,10) and
# [500,600): Rust returns [], the note at 0 is active). This port returns the
# correct overlap set; its binary search is on position, bounded by the tracked
# max_note_duration (see "Query pruning" above).
fn dhvani_midi_clip_events_in_range_into(self, start, end, out) {
    vec_truncate(out, 0);
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = dh_midi_lower_bound(notes, start - DhMidiClip_max_note_duration(self) + 1);
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p >= end) { break; }
        if (p + DhNoteEvent_duration(e) > start) { vec_push(out, e); }
        i = i + 1;
    }
    return vec_len(out);
}
#must_use
fn dhvani_midi_clip_events_in_range(self, start, end) {
    var out = vec_new();
    dhvani_midi_clip_events_in_range_into(self, start, end, out);
    return out;
}

# merge another clip's notes+CCs (kept sorted); extend duration if needed.
# merge(c, c) is legal here (Rust's borrow checker forbids it): when `other` IS
# `self`, iterate a snapshot of the handles so the inserts don't shift the
# source under the loop.
# DIVERGES from rust-old (mod.rs:374), which extends to `other.notes.last()`'s
# end -- the note that STARTS last, not the one that ENDS last. This extends to
# the max position+duration over other's notes.
fn dhvani_midi_clip_merge(self, other) {
    var onotes = DhMidiClip_notes(other);
    var occs = DhMidiClip_control_changes(other);
    if (other == self) {
        var snap_n = vec_new();
        var si = 0;
        while (si < vec_len(onotes)) { vec_push(snap_n, vec_get(onotes, si)); si = si + 1; }
        var snap_c = vec_new();
        var sj = 0;
        while (sj < vec_len(occs)) { vec_push(snap_c, vec_get(occs, sj)); sj = sj + 1; }
        onotes = snap_n;
        occs = snap_c;
    }
    var nn = vec_len(onotes);
    var other_end = 0;
    var have_end = 0;
    var i = 0;
    while (i < nn) {
        var e = vec_get(onotes, i);
        var end_i = DhNoteEvent_position(e) + DhNoteEvent_duration(e);
        if (have_end == 0) { other_end = end_i; have_end = 1; }
        if (end_i > other_end) { other_end = end_i; }
        dh_midi_clip_insert_note(self,
          dhvani_note_event_new(
            DhNoteEvent_position(e),
            DhNoteEvent_duration(e),
            DhNoteEvent_note(e),
            DhNoteEvent_velocity(e),
            DhNoteEvent_channel(e)));
        i = i + 1;
    }
    var nc = vec_len(occs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(occs, j);
        dhvani_midi_clip_add_cc(
          self,
          DhControlChange_position(c),
          DhControlChange_controller(c),
          DhControlChange_value(c),
          DhControlChange_channel(c));
        j = j + 1;
    }
    if (have_end == 1) {
        if (other_end > DhMidiClip_duration(self)) { DhMidiClip_set_duration(self, other_end); }
    }
    return 0;
}

# transpose all notes by `semitones` (clamped to 0..127).
fn dhvani_midi_clip_transpose(self, semitones) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        var nn = DhNoteEvent_note(e) + semitones;
        if (nn < 0) { nn = 0; }
        if (nn > 127) { nn = 127; }
        DhNoteEvent_set_note(e, nn);
        i = i + 1;
    }
    return 0;
}

# quantize note+CC positions to the nearest grid boundary. No-op for grid 0.
fn dhvani_midi_clip_quantize(self, grid_frames) {
    if (grid_frames == 0) { return 0; }
    var half = grid_frames / 2;
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        DhNoteEvent_set_position(e, ((DhNoteEvent_position(e) + half) / grid_frames) * grid_frames);
        i = i + 1;
    }
    var ccs = DhMidiClip_control_changes(self);
    var nc = vec_len(ccs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(ccs, j);
        DhControlChange_set_position(c, ((DhControlChange_position(c) + half) / grid_frames) * grid_frames);
        j = j + 1;
    }
    return 0;
}

# --- voice.cyr ---

# voice.cyr -- polyphonic voice pool: allocation + stealing. Ports
# rust-old/src/midi/voice.rs. L0: dep error only (all logic is integer
# note/velocity/channel/age + one float for frequency). Zero allocation after
# dhvani_voice_manager_new: note_on/note_off/tick_age/free_voice reuse the pool.
#
# The oracle re-exports abaco::dsp::{A4_FREQUENCY, A4_MIDI_NOTE,
# SEMITONES_PER_OCTAVE} and computes frequency() with abaco::dsp::midi_to_freq.
# abaco.cyr does carry a `midi_to_freq` (f64_exp2-based), but its constants are
# internal `var DSP_*` and this L0 module takes no abaco include, so the three
# constants are redefined locally as f64 bit patterns and frequency() =
# 440 * 2^((note - 69) / 12) via ganita's f64_pow (both forms are ~1 ulp).
#
# Enums -> int codes: VoiceState {Idle=0, Active=1, Releasing=2};
# VoiceStealMode {Oldest=0, Quietest=1, Lowest=2, None=3}. note_on returns a
# slot index or DH_VOICE_NONE (-1) when full + stealing disabled. serde +
# Debug/Display dropped.

# ---- MIDI constants (locally defined; abaco does not export these) ----
var DH_A4_FREQUENCY        = 0x407B800000000000;    # 440.0 Hz   (abaco DSP_A4_FREQ)
var DH_A4_MIDI_NOTE        = 0x4051400000000000;    # 69.0       (abaco DSP_A4_MIDI)
var DH_SEMITONES_PER_OCTAVE = 0x4028000000000000;   # 12.0       (abaco DSP_SEMITONES)

# ---- VoiceState codes ----
var DH_VOICE_STATE_IDLE      = 0;
var DH_VOICE_STATE_ACTIVE    = 1;
var DH_VOICE_STATE_RELEASING = 2;

# ---- VoiceStealMode codes ----
var DH_STEAL_OLDEST   = 0;
var DH_STEAL_QUIETEST = 1;
var DH_STEAL_LOWEST   = 2;
var DH_STEAL_NONE     = 3;

# ---- note_on "None" sentinel (Rust Option<usize>::None) ----
var DH_VOICE_NONE = (0 - 1);

# ================================================================
# Voice -- a single synthesizer voice.
# state/note/velocity/channel/age are integer slots; envelope_level/pitch_bend/
# pressure/brightness are f64 bit patterns (Rust f32, widened).
# ================================================================
#derive(accessors)
struct DhVoice { state; note; velocity; channel; envelope_level; age; pitch_bend; pressure; brightness; }

# new() -- an idle voice, all fields zeroed.
#must_use
fn dhvani_voice_new() {
    var v = alloc(sizeof(DhVoice));
    DhVoice_set_state(v, DH_VOICE_STATE_IDLE);
    DhVoice_set_note(v, 0);
    DhVoice_set_velocity(v, 0);
    DhVoice_set_channel(v, 0);
    DhVoice_set_envelope_level(v, 0);
    DhVoice_set_age(v, 0);
    DhVoice_set_pitch_bend(v, 0);
    DhVoice_set_pressure(v, 0);
    DhVoice_set_brightness(v, 0);
    return v;
}

#inline
#must_use
fn dhvani_voice_state(v) { return DhVoice_state(v); }
#inline
#must_use
fn dhvani_voice_note(v) { return DhVoice_note(v); }
#inline
#must_use
fn dhvani_voice_velocity(v) { return DhVoice_velocity(v); }
#inline
#must_use
fn dhvani_voice_channel(v) { return DhVoice_channel(v); }
#inline
#must_use
fn dhvani_voice_envelope_level(v) { return DhVoice_envelope_level(v); }
#inline
#must_use
fn dhvani_voice_age(v) { return DhVoice_age(v); }
#inline
#must_use
fn dhvani_voice_pitch_bend(v) { return DhVoice_pitch_bend(v); }
#inline
#must_use
fn dhvani_voice_pressure(v) { return DhVoice_pressure(v); }
#inline
#must_use
fn dhvani_voice_brightness(v) { return DhVoice_brightness(v); }

# is_idle -- 1 iff state == Idle.
#must_use
fn dhvani_voice_is_idle(v) {
    if (DhVoice_state(v) == DH_VOICE_STATE_IDLE) { return 1; }
    return 0;
}

# is_active -- 1 iff producing sound (Active or Releasing).
#must_use
fn dhvani_voice_is_active(v) {
    var st = DhVoice_state(v);
    if (st == DH_VOICE_STATE_ACTIVE) { return 1; }
    if (st == DH_VOICE_STATE_RELEASING) { return 1; }
    return 0;
}

# frequency -- Hz for this voice's note (12-TET, A4=440):
# 440 * 2^((note - 69) / 12).
#must_use
fn dhvani_voice_frequency(v) {
    var note_f = f64_from(DhVoice_note(v));
    var exponent = f64_div(f64_sub(note_f, DH_A4_MIDI_NOTE), DH_SEMITONES_PER_OCTAVE);
    return f64_mul(DH_A4_FREQUENCY, f64_pow(2.0, exponent));
}

# apply_per_note_cc -- only CC#74 (brightness) is handled; others ignored.
# value clamped to [0, 1].
fn dhvani_voice_apply_per_note_cc(v, controller, value_normalized) {
    if (controller == 74) {
        DhVoice_set_brightness(v, f64_clamp(value_normalized, 0, 1.0));
    }
    return 0;
}

# ---- consumer field setters (public API) ----
# set_envelope_level -- the consumer owns the amplitude envelope; it writes the
# current level (f64, 0.0..1.0) back here every block so DH_STEAL_QUIETEST has
# real levels to compare (without it every voice reads 0.0 and Quietest always
# steals slot 0). rust-old keeps the field pub(crate), so only its own tests
# could set it; this setter is the Cyrius consumer hook.
fn dhvani_voice_set_envelope_level(v, level) { DhVoice_set_envelope_level(v, level); return 0; }
# set_note -- overwrite a voice's note (retune / tests; the Rust tests poke the
# pub(crate) field directly).
fn dhvani_voice_set_note(v, note) { DhVoice_set_note(v, note); return 0; }

# ================================================================
# VoiceManager -- polyphonic pool with configurable stealing.
# voices is a vec of DhVoice handles.
# ================================================================
#derive(accessors)
struct DhVoiceManager { voices; max_voices; steal_mode; }

# new(max_voices, steal_mode) -- pool of `max_voices` idle voices.
#must_use
fn dhvani_voice_manager_new(max_voices, steal_mode) {
    var self = alloc(sizeof(DhVoiceManager));
    var voices = vec_new();
    var i = 0;
    while (i < max_voices) {
        vec_push(voices, dhvani_voice_new());
        i = i + 1;
    }
    DhVoiceManager_set_voices(self, voices);
    DhVoiceManager_set_max_voices(self, max_voices);
    DhVoiceManager_set_steal_mode(self, steal_mode);
    return self;
}

# activate_voice -- reset slot idx into an Active note (private helper).
fn dh_voice_activate(self, idx, note, velocity, channel) {
    var voice = vec_get(DhVoiceManager_voices(self), idx);
    DhVoice_set_state(voice, DH_VOICE_STATE_ACTIVE);
    DhVoice_set_note(voice, note);
    DhVoice_set_velocity(voice, velocity);
    DhVoice_set_channel(voice, channel);
    DhVoice_set_envelope_level(voice, 0);
    DhVoice_set_age(voice, 0);
    DhVoice_set_pitch_bend(voice, 0);
    DhVoice_set_pressure(voice, 0);
    DhVoice_set_brightness(voice, 0);
    return 0;
}

# note_on -- allocate a voice for a new note. Returns the slot index, or
# DH_VOICE_NONE (-1) if the pool is full and stealing is disabled.
fn dhvani_voice_manager_note_on(self, note, velocity, channel) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);

    # First: the lowest-index idle voice (Rust iter().position -- stops at the
    # first match).
    var i = 0;
    while (i < n) {
        if (DhVoice_state(vec_get(voices, i)) == DH_VOICE_STATE_IDLE) {
            dh_voice_activate(self, i, note, velocity, channel);
            return i;
        }
        i = i + 1;
    }

    # No idle voice -- try stealing per the configured policy.
    var mode = DhVoiceManager_steal_mode(self);
    var steal_idx = DH_VOICE_NONE;

    if (mode == DH_STEAL_OLDEST) {
        # max_by_key(v.age): ties -> LAST element (Rust semantics). >= keeps last.
        if (n > 0) {
            steal_idx = 0;
            var best_age = DhVoice_age(vec_get(voices, 0));
            var j = 1;
            while (j < n) {
                var aj = DhVoice_age(vec_get(voices, j));
                if (aj >= best_age) { steal_idx = j; best_age = aj; }
                j = j + 1;
            }
        }
    } elif (mode == DH_STEAL_QUIETEST) {
        # min_by(envelope_level): ties -> FIRST element (Rust semantics). Strict
        # < keeps first. partial_cmp NaN -> Equal (treated as not-less, keep first).
        if (n > 0) {
            steal_idx = 0;
            var best_env = DhVoice_envelope_level(vec_get(voices, 0));
            var k = 1;
            while (k < n) {
                var ek = DhVoice_envelope_level(vec_get(voices, k));
                if (f64_lt(ek, best_env) == 1) { steal_idx = k; best_env = ek; }
                k = k + 1;
            }
        }
    } elif (mode == DH_STEAL_LOWEST) {
        # min_by_key(v.note): ties -> FIRST element (Rust semantics). Strict <.
        if (n > 0) {
            steal_idx = 0;
            var best_note = DhVoice_note(vec_get(voices, 0));
            var m = 1;
            while (m < n) {
                var nm = DhVoice_note(vec_get(voices, m));
                if (nm < best_note) { steal_idx = m; best_note = nm; }
                m = m + 1;
            }
        }
    } else {
        # DH_STEAL_NONE -- do not steal.
        steal_idx = DH_VOICE_NONE;
    }

    if (steal_idx != DH_VOICE_NONE) {
        dh_voice_activate(self, steal_idx, note, velocity, channel);
        return steal_idx;
    }
    return DH_VOICE_NONE;
}

# note_off -- release the first Active voice matching note+channel.
fn dhvani_voice_manager_note_off(self, note, channel) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    while (i < n) {
        var voice = vec_get(voices, i);
        if (DhVoice_state(voice) == DH_VOICE_STATE_ACTIVE) {
            if (DhVoice_note(voice) == note) {
                if (DhVoice_channel(voice) == channel) {
                    DhVoice_set_state(voice, DH_VOICE_STATE_RELEASING);
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# free_voice -- mark a slot idle (age reset). Out-of-range index is a no-op.
fn dhvani_voice_manager_free_voice(self, index) {
    var voices = DhVoiceManager_voices(self);
    if (index >= 0) {
        if (index < vec_len(voices)) {
            var voice = vec_get(voices, index);
            DhVoice_set_state(voice, DH_VOICE_STATE_IDLE);
            DhVoice_set_age(voice, 0);
        }
    }
    return 0;
}

# active_count -- number of non-idle voices.
#must_use
fn dhvani_voice_manager_active_count(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (dhvani_voice_is_idle(vec_get(voices, i)) == 0) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# tick_age -- increment age of every active voice. Call once per process block.
fn dhvani_voice_manager_tick_age(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    while (i < n) {
        var voice = vec_get(voices, i);
        if (dhvani_voice_is_active(voice) == 1) {
            DhVoice_set_age(voice, DhVoice_age(voice) + 1);
        }
        i = i + 1;
    }
    return 0;
}

# reset -- return every slot to a fresh idle voice.
fn dhvani_voice_manager_reset(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    while (i < n) {
        var voice = vec_get(voices, i);
        DhVoice_set_state(voice, DH_VOICE_STATE_IDLE);
        DhVoice_set_note(voice, 0);
        DhVoice_set_velocity(voice, 0);
        DhVoice_set_channel(voice, 0);
        DhVoice_set_envelope_level(voice, 0);
        DhVoice_set_age(voice, 0);
        DhVoice_set_pitch_bend(voice, 0);
        DhVoice_set_pressure(voice, 0);
        DhVoice_set_brightness(voice, 0);
        i = i + 1;
    }
    return 0;
}

# voice -- borrow slot `index`, or 0 (null) if out of range.
#must_use
fn dhvani_voice_manager_voice(self, index) {
    var voices = DhVoiceManager_voices(self);
    if (index >= 0) {
        if (index < vec_len(voices)) { return vec_get(voices, index); }
    }
    return 0;
}

# voice_mut -- same as voice() (Cyrius handles are shared/mutable).
#must_use
fn dhvani_voice_manager_voice_mut(self, index) {
    return dhvani_voice_manager_voice(self, index);
}

# capacity -- number of voice slots.
#inline
#must_use
fn dhvani_voice_manager_capacity(self) { return DhVoiceManager_max_voices(self); }

# steal_mode -- current steal mode code.
#inline
#must_use
fn dhvani_voice_manager_steal_mode(self) { return DhVoiceManager_steal_mode(self); }

# --- capture.cyr ---

# capture.cyr -- capture/output configuration + device description + event enum.
# Ports rust-old/src/capture/mod.rs (the pure config surface). L1: dep error +
# buffer (DH_MAX_SAMPLE_RATE). The PipeWire backend (capture/pw) is
# platform-blocked and NOT ported; the lock-free record threads (capture/record,
# mpsc + thread::spawn) are single-threaded concerns dropped from this port.
#
# DeviceType (enum)      -> DH_DEVICE_* int codes.
# CaptureEvent (enum)    -> DH_CEVENT_* kind code + a fat struct (device / id).
# Option<u32> device_id  -> i64 sentinel: DH_CAPTURE_NO_DEVICE (-1) == None.
# validate()             -> shared DHVANI_ERR_* code (Rust had none; added per
#                           the port spec; 0 = "use device default" stays valid).
# serde + Display string tests dropped (no runtime representation to port).

# ---- DeviceType (was `enum DeviceType`) -> int codes ----
var DH_DEVICE_SOURCE = 0;   # audio input  (microphone, line-in, desktop capture)
var DH_DEVICE_SINK   = 1;   # audio output (speakers, headphones)

# Static name for a DeviceType code (diagnostics; Rust derived Debug only).
#must_use
fn dhvani_capture_device_type_name(kind) {
    if (kind == DH_DEVICE_SOURCE) { return "source"; }
    if (kind == DH_DEVICE_SINK)   { return "sink"; }
    return "unknown";
}

# ---- device_id sentinel (Option<u32>::None) ----
var DH_CAPTURE_NO_DEVICE = (0 - 1);   # None; any value >= 0 is Some(id)

# ---- AudioDevice (was `struct AudioDevice`) ----
# name is a string handle; device_type is a DH_DEVICE_* code.
#derive(accessors)
struct DhAudioDevice { id; name; device_type; channels; sample_rate; }

#must_use
fn dhvani_capture_device_new(id, name, device_type, channels, sample_rate) {
    var d = alloc(sizeof(DhAudioDevice));
    DhAudioDevice_set_id(d, id);
    DhAudioDevice_set_name(d, name);
    DhAudioDevice_set_device_type(d, device_type);
    DhAudioDevice_set_channels(d, channels);
    DhAudioDevice_set_sample_rate(d, sample_rate);
    return d;
}
#inline
#must_use
fn dhvani_capture_device_id(d) { return DhAudioDevice_id(d); }
#inline
#must_use
fn dhvani_capture_device_name(d) { return DhAudioDevice_name(d); }
#inline
#must_use
fn dhvani_capture_device_type(d) { return DhAudioDevice_device_type(d); }
#inline
#must_use
fn dhvani_capture_device_channels(d) { return DhAudioDevice_channels(d); }
#inline
#must_use
fn dhvani_capture_device_sample_rate(d) { return DhAudioDevice_sample_rate(d); }

# ---- CaptureConfig (was `struct CaptureConfig`) ----
# sample_rate 0 = device default; channels 0 = device default; device_id
# DH_CAPTURE_NO_DEVICE = None.
#derive(accessors)
struct DhCaptureConfig { sample_rate; channels; buffer_frames; device_id; }

#must_use
fn dhvani_capture_config_new(sample_rate, channels, buffer_frames, device_id) {
    var c = alloc(sizeof(DhCaptureConfig));
    DhCaptureConfig_set_sample_rate(c, sample_rate);
    DhCaptureConfig_set_channels(c, channels);
    DhCaptureConfig_set_buffer_frames(c, buffer_frames);
    DhCaptureConfig_set_device_id(c, device_id);
    return c;
}

# Default (impl Default): 48000 Hz, 2 ch, 1024 frames, no device.
#must_use
fn dhvani_capture_config_default() {
    return dhvani_capture_config_new(48000, 2, 1024, DH_CAPTURE_NO_DEVICE);
}

#inline
#must_use
fn dhvani_capture_config_sample_rate(c) { return DhCaptureConfig_sample_rate(c); }
#inline
#must_use
fn dhvani_capture_config_channels(c) { return DhCaptureConfig_channels(c); }
#inline
#must_use
fn dhvani_capture_config_buffer_frames(c) { return DhCaptureConfig_buffer_frames(c); }
#inline
#must_use
fn dhvani_capture_config_device_id(c) { return DhCaptureConfig_device_id(c); }

# 1 iff device_id is Some (>= 0), 0 iff None. Mirrors Option::is_some.
#must_use
fn dhvani_capture_config_has_device(c) {
    if (DhCaptureConfig_device_id(c) < 0) { return 0; }
    return 1;
}

# ---- OutputConfig (was `struct OutputConfig`) ----
# Same field set + defaults as CaptureConfig, kept a distinct type as in Rust.
#derive(accessors)
struct DhOutputConfig { sample_rate; channels; buffer_frames; device_id; }

#must_use
fn dhvani_capture_output_config_new(sample_rate, channels, buffer_frames, device_id) {
    var o = alloc(sizeof(DhOutputConfig));
    DhOutputConfig_set_sample_rate(o, sample_rate);
    DhOutputConfig_set_channels(o, channels);
    DhOutputConfig_set_buffer_frames(o, buffer_frames);
    DhOutputConfig_set_device_id(o, device_id);
    return o;
}

# Default (impl Default): 48000 Hz, 2 ch, 1024 frames, no device.
#must_use
fn dhvani_capture_output_config_default() {
    return dhvani_capture_output_config_new(48000, 2, 1024, DH_CAPTURE_NO_DEVICE);
}

#inline
#must_use
fn dhvani_capture_output_config_sample_rate(o) { return DhOutputConfig_sample_rate(o); }
#inline
#must_use
fn dhvani_capture_output_config_channels(o) { return DhOutputConfig_channels(o); }
#inline
#must_use
fn dhvani_capture_output_config_buffer_frames(o) { return DhOutputConfig_buffer_frames(o); }
#inline
#must_use
fn dhvani_capture_output_config_device_id(o) { return DhOutputConfig_device_id(o); }

#must_use
fn dhvani_capture_output_config_has_device(o) {
    if (DhOutputConfig_device_id(o) < 0) { return 0; }
    return 1;
}

# ---- validate (added per port spec; Rust had no validate) ----
# Rust's fields are u32 / Option<u32>, so a negative value was unrepresentable
# there; here every one is an i64 and is checked. 0 = "use device default" stays
# valid for sample_rate / channels, and buffer_frames 0 is accepted as before. A
# nonzero sample rate must be <= DH_MAX_SAMPLE_RATE; device_id must be >= 0 (Some)
# or exactly DH_CAPTURE_NO_DEVICE (None). Returns a shared DHVANI_ERR_* code,
# DHVANI_ERR_NONE on success (DHVANI_ERR_INVALID_PARAMETER for a null config).
#must_use
fn dh_capture_fields_validate(sr, channels, buffer_frames, device_id) {
    if (sr < 0) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    if (sr > DH_MAX_SAMPLE_RATE) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    if (channels < 0) { return DHVANI_ERR_INVALID_CHANNELS; }
    if (buffer_frames < 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (device_id < DH_CAPTURE_NO_DEVICE) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

#must_use
fn dhvani_capture_config_validate(c) {
    if (c == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    return dh_capture_fields_validate(DhCaptureConfig_sample_rate(c), DhCaptureConfig_channels(c),
      DhCaptureConfig_buffer_frames(c), DhCaptureConfig_device_id(c));
}

#must_use
fn dhvani_capture_output_config_validate(o) {
    if (o == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    return dh_capture_fields_validate(DhOutputConfig_sample_rate(o), DhOutputConfig_channels(o),
      DhOutputConfig_buffer_frames(o), DhOutputConfig_device_id(o));
}

# ---- CaptureEvent (was data-carrying `enum CaptureEvent`) ----
# kind code + a fat struct: DeviceAdded carries a DhAudioDevice handle (in
# `device`); DeviceRemoved carries a PipeWire id (in `id`); Overflow / Underrun
# carry nothing.
var DH_CEVENT_DEVICE_ADDED   = 0;
var DH_CEVENT_DEVICE_REMOVED = 1;
var DH_CEVENT_OVERFLOW       = 2;
var DH_CEVENT_UNDERRUN       = 3;

#derive(accessors)
struct DhCaptureEvent { kind; device; id; }

# DeviceAdded(device) -- carries the AudioDevice handle.
#must_use
fn dhvani_capture_event_device_added(device) {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_DEVICE_ADDED);
    DhCaptureEvent_set_device(e, device);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

# DeviceRemoved { id } -- carries the removed PipeWire id.
#must_use
fn dhvani_capture_event_device_removed(id) {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_DEVICE_REMOVED);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, id);
    return e;
}

# Overflow -- capture buffer overflow (data lost).
#must_use
fn dhvani_capture_event_overflow() {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_OVERFLOW);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

# Underrun -- output buffer underrun (silence inserted).
#must_use
fn dhvani_capture_event_underrun() {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_UNDERRUN);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

#inline
#must_use
fn dhvani_capture_event_kind(e) { return DhCaptureEvent_kind(e); }
#inline
#must_use
fn dhvani_capture_event_device(e) { return DhCaptureEvent_device(e); }
#inline
#must_use
fn dhvani_capture_event_id(e) { return DhCaptureEvent_id(e); }

# --- record.cyr ---

# record.cyr -- ring-buffer / accumulator recording.
# Ports rust-old/src/capture/record.rs. L1: dep error only (+ stdlib vec).
#
# The Rust original is a lock-free RT->accumulator pipeline: the RT thread
# push()es interleaved f32 chunks into a bounded mpsc channel, a background
# thread drains them into a Vec (or a Vec<Vec> of takes for loop recording),
# and finish() joins and returns. The Cyrius port is SINGLE-THREADED, so the
# channel + accumulator thread collapse into direct in-place accumulation:
# push_samples() appends straight into owned storage, finish() returns it.
#
# `channel_bound` (backpressure knob) is retained for fidelity but never drops
# in a single-threaded model -- there is no queue to overflow -- so
# dropped_samples stays 0 (matching every Rust test). f32 samples -> f64 slots.
# serde + Display dropped. mode/RecordingMode enum -> integer codes.
#
# STORAGE. Rust grew its Vec on the accumulator thread, off the RT path. Here the
# append runs inside push_samples (the RT call), so the storage is a list of
# fixed-size chunks rather than one growing vec: appending never copies what is
# already stored. A doubling vec copied up to 512 MiB inside one push (at ~11.6
# min into a 48 kHz stereo take), plus the discarded halves. push_samples now does
# O(chunk) copying and at most one fixed DH_RECORD_CHUNK allocation per 65,536
# samples -- the recording's own storage, not a leak. finish() flattens into one
# exact-size vec (not an RT call): the peak there is twice the recording.

# ---- RecordingMode (was enum) ----
var DH_RECORDING_MODE_NORMAL  = 0;   # linear recording
var DH_RECORDING_MODE_OVERDUB = 1;   # layer on top of existing takes
var DH_RECORDING_MODE_REPLACE = 2;   # overwrite per loop iteration

# Maximum accumulator size, in SAMPLES (the Rust MAX_ACCUMULATOR_SAMPLES). Rust
# held f32, ~500 MB at the cap; the port holds f64, so the cap is ~1 GB of
# samples (plus the same again transiently while finish() flattens). A chunk that
# would cross it is dropped whole, uncounted, exactly as the oracle's
# accumulator thread drops it.
var DH_MAX_ACCUMULATOR_SAMPLES = 125000000;

# Samples per storage chunk (512 KiB of f64).
var DH_RECORD_CHUNK = 65536;

# ================================================================
# DhRecordAcc -- chunked sample storage shared by both managers.
# chunks: vec of raw chunk pointers (DH_RECORD_CHUNK f64 slots each); len: samples
# stored. Every chunk but the last is full.
# ================================================================
#derive(accessors)
struct DhRecordAcc { chunks; len; }

#must_use
fn dh_record_acc_new() {
    var a = alloc(sizeof(DhRecordAcc));
    DhRecordAcc_set_chunks(a, vec_new());
    DhRecordAcc_set_len(a, 0);
    return a;
}

# Append the `n` samples of vec `data`, all or nothing: every chunk it needs is
# allocated before anything is copied. 0, or -1 when a chunk allocation is refused
# (nothing appended; chunks already obtained stay for the next append).
fn dh_record_acc_append(a, data) {
    var n = vec_len(data);
    if (n <= 0) { return 0; }
    var chunks = DhRecordAcc_chunks(a);
    var len = DhRecordAcc_len(a);
    var need = (len + n + DH_RECORD_CHUNK - 1) / DH_RECORD_CHUNK;
    while (vec_len(chunks) < need) {
        var c = alloc(DH_RECORD_CHUNK * 8);
        if (c == 0) { return 0 - 1; }
        vec_push(chunks, c);
    }
    var src = dh_vec_data(data);
    var i = 0;
    while (i < n) {
        var ci = len / DH_RECORD_CHUNK;
        var off = len - ci * DH_RECORD_CHUNK;
        var take = dh_imin(n - i, DH_RECORD_CHUNK - off);
        var d = vec_get(chunks, ci) + off * 8;
        var s = src + i * 8;
        var end = s + take * 8;
        while (s < end) { store64(d, load64(s)); s = s + 8; d = d + 8; }
        i = i + take;
        len = len + take;
    }
    DhRecordAcc_set_len(a, len);
    return 0;
}

# One exact-size vec holding everything stored, in order (empty vec when empty).
#must_use
fn dh_record_acc_flatten(a) {
    var len = DhRecordAcc_len(a);
    var out = dh_vec_zeros(len);
    if (vec_len(out) != len) { return out; }
    var chunks = DhRecordAcc_chunks(a);
    var d = dh_vec_data(out);
    var done = 0;
    var ci = 0;
    while (done < len) {
        var take = dh_imin(len - done, DH_RECORD_CHUNK);
        var s = vec_get(chunks, ci);
        var end = s + take * 8;
        while (s < end) { store64(d, load64(s)); s = s + 8; d = d + 8; }
        done = done + take;
        ci = ci + 1;
    }
    return out;
}

# ================================================================
# RecordManager -- flat accumulator: every pushed chunk is appended in order,
# capped at DH_MAX_ACCUMULATOR_SAMPLES. `accumulated` caches finish()'s flat vec
# (0 until finish, cleared by the next push).
# ================================================================
#derive(accessors)
struct DhRecordManager { accumulated; channel_bound; dropped_samples; acc; }

# new(channel_bound) -- channel_bound.max(1) preserved for fidelity.
#must_use
fn dhvani_record_new(channel_bound) {
    var bound = channel_bound;
    if (bound < 1) { bound = 1; }
    var self = alloc(sizeof(DhRecordManager));
    DhRecordManager_set_accumulated(self, 0);
    DhRecordManager_set_channel_bound(self, bound);
    DhRecordManager_set_dropped_samples(self, 0);
    DhRecordManager_set_acc(self, dh_record_acc_new());
    return self;
}

# push_samples(data) -- append the chunk unless it would exceed the cap.
# Single-threaded: no backpressure, so nothing is dropped here. A null manager or
# null data is a no-op.
fn dhvani_record_push_samples(self, data) {
    if (self == 0) { return 0; }
    if (data == 0) { return 0; }
    var acc = DhRecordManager_acc(self);
    if ((DhRecordAcc_len(acc) + vec_len(data)) <= DH_MAX_ACCUMULATOR_SAMPLES) {
        if (dh_record_acc_append(acc, data) == 0) {
            DhRecordManager_set_accumulated(self, 0);
        }
    }
    return 0;
}

# Samples accumulated so far (before finish).
#must_use
fn dhvani_record_len(self) {
    return DhRecordAcc_len(DhRecordManager_acc(self));
}

# dropped_samples -- count dropped due to backpressure (always 0 here).
#inline
#must_use
fn dhvani_record_dropped_samples(self) {
    return DhRecordManager_dropped_samples(self);
}

# finish -- all accumulated samples as one vec. Repeated calls return the same vec
# until another push (Rust's finish consumed the manager, so it had no such case).
#must_use
fn dhvani_record_finish(self) {
    var cached = DhRecordManager_accumulated(self);
    if (cached != 0) { return cached; }
    var flat = dh_record_acc_flatten(DhRecordManager_acc(self));
    DhRecordManager_set_accumulated(self, flat);
    return flat;
}

# ================================================================
# LoopRecordManager -- loop-aware: takes is a vec of accumulators (one per loop
# iteration), seeded with a single empty take. Samples append to the last take;
# a loop marker starts a fresh empty take. finish() flattens each take.
# ================================================================
#derive(accessors)
struct DhLoopRecordManager { takes; channel_bound; mode; dropped_samples; }

# new(channel_bound, mode) -- starts with one empty take.
#must_use
fn dhvani_record_loop_new(channel_bound, mode) {
    var bound = channel_bound;
    if (bound < 1) { bound = 1; }
    var takes = vec_new();
    vec_push(takes, dh_record_acc_new());
    var self = alloc(sizeof(DhLoopRecordManager));
    DhLoopRecordManager_set_takes(self, takes);
    DhLoopRecordManager_set_channel_bound(self, bound);
    DhLoopRecordManager_set_mode(self, mode);
    DhLoopRecordManager_set_dropped_samples(self, 0);
    return self;
}

# mode -- current recording mode code.
#inline
#must_use
fn dhvani_record_loop_mode(self) {
    return DhLoopRecordManager_mode(self);
}

# push_samples(data) -- append into the current (last) take unless capped. A null
# manager or null data is a no-op.
fn dhvani_record_loop_push_samples(self, data) {
    if (self == 0) { return 0; }
    if (data == 0) { return 0; }
    var takes = DhLoopRecordManager_takes(self);
    var n = vec_len(takes);
    if (n > 0) {
        var current = vec_get(takes, n - 1);
        if ((DhRecordAcc_len(current) + vec_len(data)) <= DH_MAX_ACCUMULATOR_SAMPLES) {
            dh_record_acc_append(current, data);
        }
    }
    return 0;
}

# push_loop_marker -- start a new empty take.
fn dhvani_record_loop_push_marker(self) {
    if (self == 0) { return 0; }
    vec_push(DhLoopRecordManager_takes(self), dh_record_acc_new());
    return 0;
}

# Number of takes so far (1 + markers pushed).
#must_use
fn dhvani_record_loop_take_count(self) {
    return vec_len(DhLoopRecordManager_takes(self));
}

# Samples in take `i` so far, or -1 for an index out of range.
#must_use
fn dhvani_record_loop_take_len(self, i) {
    var takes = DhLoopRecordManager_takes(self);
    if (i < 0) { return 0 - 1; }
    if (i >= vec_len(takes)) { return 0 - 1; }
    return DhRecordAcc_len(vec_get(takes, i));
}

# dropped_samples -- always 0 in the single-threaded port.
#inline
#must_use
fn dhvani_record_loop_dropped_samples(self) {
    return DhLoopRecordManager_dropped_samples(self);
}

# finish -- all takes as a vec of sample vecs (one per loop iteration; empties
# kept). Builds new vecs on every call.
#must_use
fn dhvani_record_loop_finish(self) {
    var takes = DhLoopRecordManager_takes(self);
    var n = vec_len(takes);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(out, dh_record_acc_flatten(vec_get(takes, i)));
        i = i + 1;
    }
    return out;
}

# --- buffer.cyr ---

# buffer.cyr -- AudioBuffer: unified f64 sample buffers + mixing, resampling,
# and a reusable BufferPool. Ports rust-old/src/buffer/mod.rs.
# L1: depends on error.cyr + simd.cyr (peak/rms/gain/clamp/mix kernels).
#
# samples: a `vec` of f64 (was Vec<f32>). channels/sample_rate/frames: integer
# counts. SampleFormat/Layout enums -> integer codes. Fallible constructors
# (from_interleaved/mix/resample_linear return Result) -> a valid handle, or 0
# (null) on error. serde dropped. AudioBufferRef is deferred (roadmap.md, CHANGELOG [2.0.0]):
# a borrowed view buys nothing here -- in Cyrius a "ref" is the same handle read
# via accessors -- so it lands only when a consumer needs the distinct type.

# ---- SampleFormat (was enum) ----
var DH_FMT_F32 = 0;
var DH_FMT_I16 = 1;
var DH_FMT_I32 = 2;
var DH_FMT_I24 = 3;
var DH_FMT_F64 = 4;
var DH_FMT_U8  = 5;

# ---- Layout (was enum) ----
var DH_LAYOUT_INTERLEAVED = 0;
var DH_LAYOUT_PLANAR      = 1;

var DH_MAX_SAMPLE_RATE = 768000;

# bytes_per_sample for a SampleFormat code.
#must_use
fn dhvani_format_bytes_per_sample(fmt) {
    if (fmt == DH_FMT_F32) { return 4; }
    if (fmt == DH_FMT_I16) { return 2; }
    if (fmt == DH_FMT_I32) { return 4; }
    if (fmt == DH_FMT_I24) { return 3; }
    if (fmt == DH_FMT_F64) { return 8; }
    if (fmt == DH_FMT_U8)  { return 1; }
    return 0;
}

# Display name for a SampleFormat code (was impl Display).
#must_use
fn dhvani_format_name(fmt) {
    if (fmt == DH_FMT_F32) { return "f32"; }
    if (fmt == DH_FMT_I16) { return "i16"; }
    if (fmt == DH_FMT_I32) { return "i32"; }
    if (fmt == DH_FMT_I24) { return "i24"; }
    if (fmt == DH_FMT_F64) { return "f64"; }
    if (fmt == DH_FMT_U8)  { return "u8"; }
    return "unknown";
}

# build a `vec` of n zeros (was vec![0.0; n]): one header plus exactly n slots, zeroed
# in place (lib/vec.cyr's layout is { data_ptr, len, cap }). Through 2.3.2 this pushed n
# times, so the vec doubled from 16 and kept every outgrown copy: about 2x the bytes
# under the free-less allocator, for every buffer the library made. n <= 0, or past
# vec.cyr's VEC_CAP_MAX, gives an empty vec (the push loop aborted the process there).
#must_use
fn dh_vec_zeros(n) {
    if (n <= 0) { return vec_new(); }
    if (n > VEC_CAP_MAX) { return vec_new(); }
    var data = alloc(n * 8);
    if (data == 0) { return vec_new(); }
    var p = data;
    var end = data + n * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    var v = alloc(24);
    if (v == 0) { return vec_new(); }
    store64(v, data);
    store64(v + 8, n);
    store64(v + 16, n);
    return v;
}

# a copy of vec `src` with exactly its length (the same layout as dh_vec_zeros).
#must_use
fn dh_vec_copy(src) {
    var n = vec_len(src);
    var v = dh_vec_zeros(n);
    if (vec_len(v) != n) { return v; }
    var s = dh_vec_data(src);
    var d = dh_vec_data(v);
    var end = s + n * 8;
    while (s < end) { store64(d, load64(s)); s = s + 8; d = d + 8; }
    return v;
}

#derive(accessors)
struct DhAudioBuffer { samples; channels; sample_rate; frames; }

# from_interleaved(samples, channels, sample_rate) -> buffer handle, or 0 on
# error (channels or sample rate <= 0, a rate past the max, or a length not divisible
# by channels; the oracle's u16 / u32 could not be negative).
#must_use
fn dhvani_buffer_from_interleaved(samples, channels, sample_rate) {
    if (channels <= 0) { return 0; }
    if (sample_rate <= 0) { return 0; }
    if (sample_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var len = vec_len(samples);
    if (len > 0) {
        if ((len % channels) > 0) { return 0; }
    }
    var self = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(self, samples);
    DhAudioBuffer_set_channels(self, channels);
    DhAudioBuffer_set_sample_rate(self, sample_rate);
    DhAudioBuffer_set_frames(self, len / channels);
    return self;
}

# silence(channels, frames, sample_rate) -- a zero-filled buffer. 0 for a negative
# channel or frame count, or one whose channels * frames would overflow the vec cap:
# the header must never claim more samples than the vec holds, since the kernels walk
# the storage by it.
#must_use
fn dhvani_buffer_silence(channels, frames, sample_rate) {
    if (channels < 0) { return 0; }
    if (frames < 0) { return 0; }
    if (channels > 0) {
        if (frames > VEC_CAP_MAX / channels) { return 0; }
    }
    var self = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(self, dh_vec_zeros(channels * frames));
    DhAudioBuffer_set_channels(self, channels);
    DhAudioBuffer_set_sample_rate(self, sample_rate);
    DhAudioBuffer_set_frames(self, frames);
    return self;
}

# --- accessors ---
#inline
#must_use
fn dhvani_buffer_samples(self) { return DhAudioBuffer_samples(self); }
#inline
#must_use
fn dhvani_buffer_channels(self) { return DhAudioBuffer_channels(self); }
#inline
#must_use
fn dhvani_buffer_sample_rate(self) { return DhAudioBuffer_sample_rate(self); }
#inline
#must_use
fn dhvani_buffer_frames(self) { return DhAudioBuffer_frames(self); }
#inline
#must_use
fn dhvani_buffer_total_samples(self) { return vec_len(DhAudioBuffer_samples(self)); }

# duration in seconds.
#inline
#must_use
fn dhvani_buffer_duration_secs(self) {
    return f64_div(f64_from(DhAudioBuffer_frames(self)),
      f64_from(DhAudioBuffer_sample_rate(self)));
}

# peak amplitude across all channels.
#must_use
fn dhvani_buffer_peak(self) {
    return dhvani_simd_peak_abs(DhAudioBuffer_samples(self));
}

# RMS level (0.0 for an empty buffer).
#must_use
fn dhvani_buffer_rms(self) {
    var samples = DhAudioBuffer_samples(self);
    var len = vec_len(samples);
    if (len == 0) { return 0; }
    return f64_sqrt(f64_div(dhvani_simd_sum_of_squares(samples), f64_from(len)));
}

# multiply all samples by gain.
fn dhvani_buffer_apply_gain(self, gain) {
    dhvani_simd_apply_gain(DhAudioBuffer_samples(self), gain);
    return 0;
}

# clamp all samples to [-1.0, 1.0].
fn dhvani_buffer_clamp(self) {
    dhvani_simd_clamp(DhAudioBuffer_samples(self), DH_NEG_ONE, 1.0);
    return 0;
}

# deep-copy a buffer (was #[derive(Clone)]).
#must_use
fn dhvani_buffer_clone(self) {
    var dst = dh_vec_copy(DhAudioBuffer_samples(self));
    var b = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(b, dst);
    DhAudioBuffer_set_channels(b, DhAudioBuffer_channels(self));
    DhAudioBuffer_set_sample_rate(b, DhAudioBuffer_sample_rate(self));
    DhAudioBuffer_set_frames(b, DhAudioBuffer_frames(self));
    return b;
}

# mix(buffers) -- sum a `vec` of buffer handles (same channels + sample rate).
# Empty -> a silent stereo buffer; channel/rate mismatch -> 0.
#must_use
fn dhvani_buffer_mix(buffers) {
    var n = vec_len(buffers);
    if (n == 0) { return dhvani_buffer_silence(2, 0, 44100); }
    var first = vec_get(buffers, 0);
    var channels = DhAudioBuffer_channels(first);
    var sample_rate = DhAudioBuffer_sample_rate(first);
    var max_frames = 0;
    var i = 0;
    while (i < n) {
        var b = vec_get(buffers, i);
        var bch = DhAudioBuffer_channels(b);
        if (bch < channels) { return 0; }
        if (bch > channels) { return 0; }
        var bsr = DhAudioBuffer_sample_rate(b);
        if (bsr < sample_rate) { return 0; }
        if (bsr > sample_rate) { return 0; }
        var bf = DhAudioBuffer_frames(b);
        if (bf > max_frames) { max_frames = bf; }
        i = i + 1;
    }
    var mixed = dh_vec_zeros(max_frames * channels);
    var j = 0;
    while (j < n) {
        dhvani_simd_add_buffers(mixed, DhAudioBuffer_samples(vec_get(buffers, j)));
        j = j + 1;
    }
    var out = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(out, mixed);
    DhAudioBuffer_set_channels(out, channels);
    DhAudioBuffer_set_sample_rate(out, sample_rate);
    DhAudioBuffer_set_frames(out, max_frames);
    return out;
}

# resample_linear(buf, target_rate) -- linear-interpolated rate conversion.
# Bad rate -> 0; same rate -> clone; empty -> silence.
#must_use
fn dhvani_buffer_resample_linear(buf, target_rate) {
    if (target_rate <= 0) { return 0; }
    if (target_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (target_rate == src_rate) { return dhvani_buffer_clone(buf); }
    var frames = DhAudioBuffer_frames(buf);
    var ch = DhAudioBuffer_channels(buf);
    if (frames == 0) { return dhvani_buffer_silence(ch, 0, target_rate); }
    # a 0 Hz (or negative) source rate makes the ratio infinite and new_frames saturate
    if (src_rate <= 0) { return 0; }
    if (ch < 1) { return 0; }
    var ratio = f64_div(f64_from(target_rate), f64_from(src_rate));
    var new_frames = f64_to(f64_ceil(f64_mul(f64_from(frames), ratio)));
    if (new_frames > VEC_CAP_MAX / ch) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var src_len = vec_len(src);
    var out = dh_vec_zeros(new_frames * ch);
    var frame = 0;
    while (frame < new_frames) {
        var src_pos = f64_div(f64_from(frame), ratio);
        var src_frame = f64_to(f64_floor(src_pos));
        var frac = f64_sub(src_pos, f64_from(src_frame));
        var c = 0;
        while (c < ch) {
            var i0 = src_frame * ch + c;
            var nxt = src_frame + 1;
            if (nxt > frames - 1) { nxt = frames - 1; }
            var i1 = nxt * ch + c;
            var s0 = 0;
            if (i0 < src_len) { s0 = vec_get(src, i0); }
            var s1 = 0;
            if (i1 < src_len) { s1 = vec_get(src, i1); }
            vec_set(out, frame * ch + c, f64_add(s0, f64_mul(frac, f64_sub(s1, s0))));
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, ch);
    DhAudioBuffer_set_sample_rate(ob, target_rate);
    DhAudioBuffer_set_frames(ob, new_frames);
    return ob;
}

# ---- BufferPool: reuse buffers to avoid per-cycle allocation ----
#derive(accessors)
struct DhBufferPool { buffers; channels; frames; sample_rate; }

# new(capacity, channels, frames, sample_rate) -- pool of `capacity` silent buffers.
#must_use
fn dhvani_pool_new(capacity, channels, frames, sample_rate) {
    var buffers = vec_new();
    var i = 0;
    while (i < capacity) {
        vec_push(buffers, dhvani_buffer_silence(channels, frames, sample_rate));
        i = i + 1;
    }
    var self = alloc(sizeof(DhBufferPool));
    DhBufferPool_set_buffers(self, buffers);
    DhBufferPool_set_channels(self, channels);
    DhBufferPool_set_frames(self, frames);
    DhBufferPool_set_sample_rate(self, sample_rate);
    return self;
}

# acquire -- pop a buffer, or allocate a fresh silent one if the pool is empty.
#must_use
fn dhvani_pool_acquire(self) {
    var buffers = DhBufferPool_buffers(self);
    if (vec_len(buffers) > 0) { return vec_pop(buffers); }
    return dhvani_buffer_silence(DhBufferPool_channels(self),
      DhBufferPool_frames(self),
      DhBufferPool_sample_rate(self));
}

# release -- silence a buffer and return it to the pool.
fn dhvani_pool_release(self, buf) {
    var samples = DhAudioBuffer_samples(buf);
    var p = dh_vec_data(samples);
    var end = p + vec_len(samples) * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    vec_push(DhBufferPool_buffers(self), buf);
    return 0;
}

# number of buffers currently available.
#inline
#must_use
fn dhvani_pool_available(self) {
    return vec_len(DhBufferPool_buffers(self));
}

# --- convert.cyr ---

# convert.cyr -- format, layout, and channel-mapping conversion.
# Ports rust-old/src/buffer/convert.rs. L2: depends on error + simd (dh_imin,
# dh_sext24, DH_NEG_ONE) + buffer (AudioBuffer, from_interleaved).
#
# The i16/i24/u8 <-> f32 converters that Rust's convert.rs delegated to `simd`
# are NOT re-wrapped here -- call dhvani_simd_{i16,i24,u8}_* directly. This
# module adds i32<->f32, i24-packed, f64<->f32, planar<->interleaved, channel
# up/down-mix, and 5.1 downmix.
#
# Same-size sample converters take a caller-provided out `vec` (alloc-free);
# size-changing ops (packed, planar, channel maps) return a fresh vec/buffer.

var DH_FRAC_1_SQRT_2 = F64_FRAC_1_SQRT2;   # 1/sqrt(2), ITU downmix coeff (exact-hex stdlib const)

# ---- i32 <-> f32 (same size, caller-out) ----

# i32_to_f32(src, dst) -- src[i] / 2^31.
fn dhvani_convert_i32_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var full = f64_from(2147483648);
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        store64(d, f64_div(f64_from(load64(s)), full));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

# f32_to_i32(src, dst) -- (clamp(src,-1,1) * (2^31 - 1)) truncated to i32.
fn dhvani_convert_f32_to_i32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var full = f64_from(2147483647);
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) {
        # f64_clamp's two tests inline, in its order
        var c = load64(s);
        if (f64_lt(c, DH_NEG_ONE) == 1) { c = DH_NEG_ONE; }
        else { if (f64_gt(c, 1.0) == 1) { c = 1.0; } }
        store64(d, f64_to(f64_trunc(f64_mul(c, full))));
        s = s + 8;
        d = d + 8;
    }
    return 0;
}

# copy min(len) slots from src to dst (the f64 <-> f32 identity converters).
fn dh_convert_copy(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var s = dh_vec_data(src);
    var d = dh_vec_data(dst);
    var end = s + len * 8;
    while (s < end) { store64(d, load64(s)); s = s + 8; d = d + 8; }
    return 0;
}

# ---- f64 <-> f32 (identity in the all-f64 port; kept for API parity) ----
fn dhvani_convert_f64_to_f32(src, dst) { return dh_convert_copy(src, dst); }
fn dhvani_convert_f32_to_f64(src, dst) { return dh_convert_copy(src, dst); }

# ---- 24-bit packed bytes <-> f32 (3 bytes/sample, little-endian) ----

# i24_packed_to_f32(bytes) -> fresh vec of len(bytes)/3 samples.
#must_use
fn dhvani_convert_i24_packed_to_f32(bytes) {
    var n = vec_len(bytes) / 3;
    var dst = vec_new();
    var i = 0;
    while (i < n) {
        var b0 = vec_get(bytes, i * 3);
        var b1 = vec_get(bytes, i * 3 + 1);
        var b2 = vec_get(bytes, i * 3 + 2);
        var raw = b0 | (b1 << 8) | (b2 << 16);
        vec_push(dst, f64_div(f64_from(dh_sext24(raw)), 8388608.0));
        i = i + 1;
    }
    return dst;
}

# f32_to_i24_packed(samples) -> fresh vec of len*3 bytes.
#must_use
fn dhvani_convert_f32_to_i24_packed(samples) {
    var out = vec_new();
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(samples, i), DH_NEG_ONE, 1.0);
        var val = f64_to(f64_trunc(f64_mul(c, 8388607.0)));
        vec_push(out, val & 0xFF);
        vec_push(out, (val >> 8) & 0xFF);
        vec_push(out, (val >> 16) & 0xFF);
        i = i + 1;
    }
    return out;
}

# ---- layout: interleaved <-> planar ----

# interleaved_to_planar(buf) -> a vec of `channels` plane vecs.
#must_use
fn dhvani_convert_interleaved_to_planar(buf) {
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    var planes = vec_new();
    var c = 0;
    while (c < ch) { vec_push(planes, vec_new()); c = c + 1; }
    var frame = 0;
    while (frame < frames) {
        var cc = 0;
        while (cc < ch) {
            vec_push(vec_get(planes, cc), vec_get(samples, frame * ch + cc));
            cc = cc + 1;
        }
        frame = frame + 1;
    }
    return planes;
}

# planar_to_interleaved(channels, sample_rate) -> buffer, or 0 on empty /
# length-mismatch.
#must_use
fn dhvani_convert_planar_to_interleaved(channels, sample_rate) {
    var ch_count = vec_len(channels);
    if (ch_count == 0) { return 0; }
    var frames = vec_len(vec_get(channels, 0));
    var i = 0;
    while (i < ch_count) {
        if (vec_len(vec_get(channels, i)) != frames) { return 0; }
        i = i + 1;
    }
    var samples = vec_new();
    var frame = 0;
    while (frame < frames) {
        var c = 0;
        while (c < ch_count) {
            vec_push(samples, vec_get(vec_get(channels, c), frame));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(samples, ch_count, sample_rate);
}

# ---- channel maps ----

# mono_to_stereo(buf) -- duplicate the single channel; 0 if not mono.
#must_use
fn dhvani_convert_mono_to_stereo(buf) {
    if (DhAudioBuffer_channels(buf) != 1) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var len = vec_len(src);
    var out = vec_new();
    var i = 0;
    while (i < len) {
        var s = vec_get(src, i);
        vec_push(out, s);
        vec_push(out, s);
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(out, 2, DhAudioBuffer_sample_rate(buf));
}

# stereo_to_mono(buf) -- average L and R; 0 if not stereo.
#must_use
fn dhvani_convert_stereo_to_mono(buf) {
    if (DhAudioBuffer_channels(buf) != 2) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var out = vec_new();
    var frame = 0;
    while (frame < frames) {
        var l = vec_get(src, frame * 2);
        var r = vec_get(src, frame * 2 + 1);
        vec_push(out, f64_mul(f64_add(l, r), 0.5));
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(out, 1, DhAudioBuffer_sample_rate(buf));
}

# downmix_5_1_to_stereo(buf) -- ITU-R BS.775 (L,R,C,LFE,Ls,Rs); LFE dropped.
# 0 if not 6 channels.
#must_use
fn dhvani_convert_downmix_5_1_to_stereo(buf) {
    if (DhAudioBuffer_channels(buf) != 6) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var out = vec_new();
    var frame = 0;
    while (frame < frames) {
        var base = frame * 6;
        var l = vec_get(src, base);
        var r = vec_get(src, base + 1);
        var c = vec_get(src, base + 2);
        var ls = vec_get(src, base + 4);
        var rs = vec_get(src, base + 5);
        var lo = f64_add(f64_add(l, f64_mul(DH_FRAC_1_SQRT_2, c)), f64_mul(DH_FRAC_1_SQRT_2, ls));
        var ro = f64_add(f64_add(r, f64_mul(DH_FRAC_1_SQRT_2, c)), f64_mul(DH_FRAC_1_SQRT_2, rs));
        vec_push(out, lo);
        vec_push(out, ro);
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(out, 2, DhAudioBuffer_sample_rate(buf));
}

# --- dither.cyr ---

# dither.cyr -- dithering for bit-depth reduction. Ports rust-old/src/buffer/dither.rs.
# L1, deps error + simd (dh_imin). TPDF (triangular PDF, flat noise) and noise-shaped (first-
# order error feedback). Rust returned a fresh Vec<f32>; the Cyrius port writes
# into a caller-provided output `vec` (alloc-free under the bump allocator).
#
# RNG: xorshift32 with u32 wrapping. Cyrius is i64-only, so every shift result is
# masked to 32 bits (& 0xFFFFFFFF) or the sequence diverges. u32::MAX = 4294967295.

# u32::MAX = 4294967295 (RNG normalization divisor). Stored as an integer and
# converted with f64_from at use -- a decimal literal >= ~2^24 misparses.
var DH_U32_MAX = 4294967295;

# xorshift32 step: advance a 32-bit state, return the next value.
#must_use
fn dh_xorshift32_next(s) {
    s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
    s = (s ^ (s >> 17)) & 0xFFFFFFFF;
    s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
    return s;
}

# one uniform sample in [-1, 1): (state / u32::MAX) * 2 - 1.
#must_use
fn dh_rng_bipolar(state) {
    return f64_sub(f64_mul(f64_div(f64_from(state), f64_from(DH_U32_MAX)), 2.0), 1.0);
}

# tpdf_dither(samples, out, target_bits) -- fill `out` with TPDF-dithered samples, over
# the shorter of the two lengths. Returns 0.
fn dhvani_dither_tpdf(samples, out, target_bits) {
    var lsb = 1 << (target_bits - 1);
    var quant_step = f64_div(1.0, f64_from(lsb));
    var rng = 0x12345678;
    # min of the two lengths: a shorter `out` aborted the process through 2.3.2 (the
    # oracle returned a fresh Vec, so it could not mismatch)
    var len = dh_imin(vec_len(samples), vec_len(out));
    var i = 0;
    while (i < len) {
        rng = dh_xorshift32_next(rng);
        var r1 = dh_rng_bipolar(rng);
        rng = dh_xorshift32_next(rng);
        var r2 = dh_rng_bipolar(rng);
        var dither = f64_mul(f64_mul(f64_add(r1, r2), 0.5), quant_step);
        vec_set(out, i, f64_add(vec_get(samples, i), dither));
        i = i + 1;
    }
    return 0;
}

# noise_shaped_dither(samples, out, target_bits) -- first-order error-feedback
# dither into `out`. Returns 0.
fn dhvani_dither_noise_shaped(samples, out, target_bits) {
    var lsb = 1 << (target_bits - 1);
    var quant_step = f64_div(1.0, f64_from(lsb));
    var rng = 0x12345678;
    var error = 0;             # +0.0
    # min of the two lengths: a shorter `out` aborted the process through 2.3.2 (the
    # oracle returned a fresh Vec, so it could not mismatch)
    var len = dh_imin(vec_len(samples), vec_len(out));
    var i = 0;
    while (i < len) {
        var shaped = f64_sub(vec_get(samples, i), error);
        rng = dh_xorshift32_next(rng);
        var r1 = dh_rng_bipolar(rng);
        rng = dh_xorshift32_next(rng);
        var r2 = dh_rng_bipolar(rng);
        var dither = f64_mul(f64_mul(f64_add(r1, r2), 0.5), quant_step);
        var dithered = f64_add(shaped, dither);
        var quantized = f64_mul(f64_round_half_away(f64_div(dithered, quant_step)), quant_step);
        error = f64_sub(quantized, shaped);
        vec_set(out, i, quantized);
        i = i + 1;
    }
    return 0;
}

# --- resample.cyr ---

# resample.cyr -- windowed-sinc resampling with configurable quality.
# Ports rust-old/src/buffer/resample.rs. L1: depends on error + simd + buffer.
# ResampleQuality enum -> codes. serde dropped. Result -> null-handle sentinel.
#
# Both of the oracle's paths, as in simd.cyr:
#   dhvani_resample_sinc         -- its default (`simd` feature) path: each output frame's
#                                   kernel weights are computed ONCE and shared by every
#                                   channel, and each channel's taps are gathered into one
#                                   contiguous row for the packed weighted-sum kernel.
#   dhvani_resample_sinc_scalar  -- its `not(simd)` path: the windowed sinc recomputed per
#                                   channel, summed left to right. The parity oracle.
# Through 2.3.1 only the second was ported, under the first one's name. The two differ in
# the last bits (lane-order sums, see simd.cyr) and in the silence threshold the oracle
# gives each: |weight sum| > 1e-6 on the default path, > 1e-10 on the scalar one.

# Exact-hex stdlib constants (a long decimal literal loses precision vs the oracle).
var DH_PI  = F64_PI;
var DH_TAU = F64_TAU;

# ResampleQuality (kernel half-width in samples).
var DH_RESAMPLE_DRAFT = 0;   # 4-point  (half-width 2)
var DH_RESAMPLE_GOOD  = 1;   # 16-point (half-width 8)
var DH_RESAMPLE_BEST  = 2;   # 64-point (half-width 32)

#must_use
fn dhvani_resample_kernel_half_width(quality) {
    if (quality == DH_RESAMPLE_DRAFT) { return 2; }
    if (quality == DH_RESAMPLE_GOOD)  { return 8; }
    if (quality == DH_RESAMPLE_BEST)  { return 32; }
    return 8;
}

# windowed_sinc(x, half_width) -- sinc * Blackman-Harris window.
#must_use
fn dhvani_resample_windowed_sinc(x, half_width) {
    var ax = f64_abs(x);
    if (f64_lt(ax, 0.0000000001) == 1) { return 1.0; }   # |x| < 1e-10 -> 1.0
    var pix = f64_mul(DH_PI, x);
    var sinc = f64_div(f64_sin(pix), pix);
    if (f64_gt(ax, half_width) == 1) { return 0; }        # outside window -> 0
    var t = f64_mul(f64_add(f64_div(x, half_width), 1.0), 0.5);
    var tau_t = f64_mul(DH_TAU, t);
    var window = f64_sub(
      f64_add(
        f64_sub(0.35875, f64_mul(0.48829, f64_cos(tau_t))),
        f64_mul(0.14128, f64_cos(f64_mul(2.0, tau_t)))
        ),
      f64_mul(0.01168, f64_cos(f64_mul(3.0, tau_t))));
    return f64_mul(sinc, window);
}

# 1 iff `buf` can be resampled to `target_rate` without either path walking past
# memory: both rates in 1..=DH_MAX_SAMPLE_RATE (a 0 Hz source makes the ratio
# infinite, f64_to then saturates the output frame count, and the old default path
# stored past the heap), at least one channel, and a vec that really holds
# frames * channels samples. The oracle checks only target_rate == 0 (and panics
# or wraps on the rest).
#must_use
fn dh_resample_rates_ok(buf, target_rate) {
    if (target_rate <= 0) { return 0; }
    if (target_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (src_rate <= 0) { return 0; }
    if (src_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 1) { return 0; }
    var frames = DhAudioBuffer_frames(buf);
    if (frames < 0) { return 0; }
    if (frames > vec_len(DhAudioBuffer_samples(buf)) / ch) { return 0; }
    return 1;
}

# resample_sinc(buf, target_rate, quality) -- buffer handle, or 0 when
# dh_resample_rates_ok refuses the shapes.
# same rate -> clone; empty -> silence. The oracle's default path (see the header).
#must_use
fn dhvani_resample_sinc(buf, target_rate, quality) {
    if (dh_resample_rates_ok(buf, target_rate) == 0) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (target_rate == src_rate) { return dhvani_buffer_clone(buf); }
    var frames = DhAudioBuffer_frames(buf);
    var ch = DhAudioBuffer_channels(buf);
    if (frames == 0) { return dhvani_buffer_silence(ch, 0, target_rate); }

    var ratio = f64_div(f64_from(target_rate), f64_from(src_rate));
    var new_frames = f64_to(f64_ceil(f64_mul(f64_from(frames), ratio)));
    if (new_frames > VEC_CAP_MAX / ch) { return 0; }
    var half_width = dhvani_resample_kernel_half_width(quality);
    # downsampling scales the kernel to avoid aliasing.
    var filter_scale = 1.0;
    var kernel_scale = 1.0;
    if (f64_lt(ratio, 1.0) == 1) {
        filter_scale = ratio;
        kernel_scale = ratio;
    }
    var out = dh_vec_zeros(new_frames * ch);
    # The weight row and the gathered-tap row: once per call, like `out`, never per frame.
    var max_kernel_len = f64_to(f64_ceil(f64_div(f64_from(half_width), filter_scale))) * 2 + 1;
    if (max_kernel_len > VEC_CAP_MAX) { return 0; }
    var kw = dh_vec_zeros(max_kernel_len);
    var ks = dh_vec_zeros(max_kernel_len);
    var wp = dh_vec_data(kw);
    var kp = dh_vec_data(ks);
    var sp = dh_vec_data(DhAudioBuffer_samples(buf));
    var op = dh_vec_data(out);
    var frame = 0;
    while (frame < new_frames) {
        var src_pos = f64_div(f64_from(frame), ratio);
        var src_center = f64_to(f64_floor(src_pos));
        var frac = f64_sub(src_pos, f64_from(src_center));
        var scaled_half = f64_to(f64_ceil(f64_div(f64_from(half_width), filter_scale)));
        # this frame's weights, for the taps inside the buffer (a contiguous run from
        # first_valid, since the buffer's indices are)
        var kernel_len = 0;
        var first_valid = 0;
        var i = 0 - scaled_half;
        while (i <= scaled_half) {
            var src_idx = src_center + i;
            if (src_idx >= 0) {
                if (src_idx < frames) {
                    if (kernel_len == 0) { first_valid = src_idx; }
                    var x = f64_mul(f64_sub(f64_from(i), frac), kernel_scale);
                    store64(wp + kernel_len * 8, dhvani_resample_windowed_sinc(x, f64_from(scaled_half)));
                    kernel_len = kernel_len + 1;
                }
            }
            i = i + 1;
        }
        # the weight total is the same for every channel (the oracle recomputes it per
        # channel, to the same bits)
        var weight_sum = dh_simd_row_sum(wp, kernel_len);
        var c = 0;
        while (c < ch) {
            # mono taps are already one contiguous row; other layouts gather a channel's
            var row = sp + first_valid * 8;
            if (ch > 1) {
                var k = 0;
                while (k < kernel_len) {
                    store64(kp + k * 8, load64(sp + ((first_valid + k) * ch + c) * 8));
                    k = k + 1;
                }
                row = kp;
            }
            var sum = dh_simd_row_dot(row, wp, kernel_len);
            if (f64_gt(f64_abs(weight_sum), 0.000001) == 1) {
                store64(op + (frame * ch + c) * 8, f64_div(sum, weight_sum));
            }
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, ch);
    DhAudioBuffer_set_sample_rate(ob, target_rate);
    DhAudioBuffer_set_frames(ob, new_frames);
    return ob;
}

# resample_sinc_scalar(buf, target_rate, quality) -- the oracle's `not(simd)` path: the
# same contract, the windowed sinc recomputed per channel and summed left to right.
#must_use
fn dhvani_resample_sinc_scalar(buf, target_rate, quality) {
    if (dh_resample_rates_ok(buf, target_rate) == 0) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (target_rate == src_rate) { return dhvani_buffer_clone(buf); }
    var frames = DhAudioBuffer_frames(buf);
    var ch = DhAudioBuffer_channels(buf);
    if (frames == 0) { return dhvani_buffer_silence(ch, 0, target_rate); }

    var ratio = f64_div(f64_from(target_rate), f64_from(src_rate));
    var new_frames = f64_to(f64_ceil(f64_mul(f64_from(frames), ratio)));
    if (new_frames > VEC_CAP_MAX / ch) { return 0; }
    var half_width = dhvani_resample_kernel_half_width(quality);
    # downsampling scales the kernel to avoid aliasing.
    var filter_scale = 1.0;
    var kernel_scale = 1.0;
    if (f64_lt(ratio, 1.0) == 1) {
        filter_scale = ratio;
        kernel_scale = ratio;
    }
    var src = DhAudioBuffer_samples(buf);
    var out = dh_vec_zeros(new_frames * ch);
    var frame = 0;
    while (frame < new_frames) {
        var src_pos = f64_div(f64_from(frame), ratio);
        var src_center = f64_to(f64_floor(src_pos));
        var frac = f64_sub(src_pos, f64_from(src_center));
        var scaled_half = f64_to(f64_ceil(f64_div(f64_from(half_width), filter_scale)));
        var c = 0;
        while (c < ch) {
            var sum = 0;
            var weight_sum = 0;
            var i = 0 - scaled_half;
            while (i <= scaled_half) {
                var src_idx = src_center + i;
                if (src_idx >= 0) {
                    if (src_idx < frames) {
                        var x = f64_mul(f64_sub(f64_from(i), frac), kernel_scale);
                        var w = dhvani_resample_windowed_sinc(x, f64_from(scaled_half));
                        sum = f64_add(sum, f64_mul(vec_get(src, src_idx * ch + c), w));
                        weight_sum = f64_add(weight_sum, w);
                    }
                }
                i = i + 1;
            }
            if (f64_gt(f64_abs(weight_sum), 0.0000000001) == 1) {
                vec_set(out, frame * ch + c, f64_div(sum, weight_sum));
            }
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, ch);
    DhAudioBuffer_set_sample_rate(ob, target_rate);
    DhAudioBuffer_set_frames(ob, new_frames);
    return ob;
}

# --- waveform.cyr ---

# waveform.cyr -- downsampled peak data for visualization.
# Ports rust-old/src/analysis/waveform.rs. L0: deps error + buffer.
# WaveformData: channels[ch] = a flat vec of (min,max) pairs interleaved
# (min at 2i, max at 2i+1) -- Vec<Vec<(f32,f32)>> flattened per channel.

#derive(accessors)
struct DhWaveformData { channels; peaks_per_second; sample_rate; }

#must_use
fn dhvani_waveform_num_peaks(self) {
    var channels = DhWaveformData_channels(self);
    if (vec_len(channels) == 0) { return 0; }
    return vec_len(vec_get(channels, 0)) / 2;
}
#inline
#must_use
fn dhvani_waveform_num_channels(self) { return vec_len(DhWaveformData_channels(self)); }
#must_use
fn dhvani_waveform_duration_secs(self) {
    var pps = DhWaveformData_peaks_per_second(self);
    if (pps == 0) { return 0; }
    return f64_div(f64_from(dhvani_waveform_num_peaks(self)), f64_from(pps));
}
# (min,max) of peak i on channel c.
#must_use
fn dhvani_waveform_min(self, c, i) { return vec_get(vec_get(DhWaveformData_channels(self), c), i * 2); }
#must_use
fn dhvani_waveform_max(self, c, i) { return vec_get(vec_get(DhWaveformData_channels(self), c), i * 2 + 1); }

# compute_waveform(buf, peaks_per_second) -- (min,max) per time window per channel.
#must_use
fn dhvani_waveform_compute(buf, peaks_per_second) {
    var pps = peaks_per_second;
    if (pps < 1) { pps = 1; }
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (ch < 1) { frames = 0; } else { frames = dh_imin(frames, vec_len(samples) / ch); }
    var d = dh_vec_data(samples);
    var spp = f64_to(f64_ceil(f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(pps))));
    if (spp < 1) { spp = 1; }
    var num_peaks = (frames + spp - 1) / spp;   # div_ceil
    var channels = vec_new();
    var c0 = 0;
    while (c0 < ch) { vec_push(channels, vec_new()); c0 = c0 + 1; }
    var peak_idx = 0;
    while (peak_idx < num_peaks) {
        var start_frame = peak_idx * spp;
        var end_frame = (peak_idx + 1) * spp;
        if (end_frame > frames) { end_frame = frames; }
        var c = 0;
        while (c < ch) {
            var min_val = DH_POS_INF;
            var max_val = DH_NEG_INF;
            # NaN-ignoring folds, as the oracle's f32::min / f32::max: the bare f64_min /
            # f64_max are asymmetric on NaN, so [0.9, NaN, 0.1] read max 0.1 (2.3.2).
            # dh_min_ignore_nan / dh_max_ignore_nan inline, with their exact selection
            # (take x unless acc < x, resp. acc > x, and x is not NaN), so the bits match
            # them, signed zeros included, without four calls per sample.
            var p = d + (start_frame * ch + c) * 8;
            var end = d + (end_frame * ch + c) * 8;
            var stride = ch * 8;
            while (p < end) {
                var sample = load64(p);
                if (f64_eq(sample, sample) == 1) {
                    if (f64_lt(min_val, sample) == 0) { min_val = sample; }
                    if (f64_gt(max_val, sample) == 0) { max_val = sample; }
                }
                p = p + stride;
            }
            if (min_val == DH_POS_INF) { min_val = 0; max_val = 0; }
            var chan = vec_get(channels, c);
            vec_push(chan, min_val);
            vec_push(chan, max_val);
            c = c + 1;
        }
        peak_idx = peak_idx + 1;
    }
    var self = alloc(sizeof(DhWaveformData));
    DhWaveformData_set_channels(self, channels);
    DhWaveformData_set_peaks_per_second(self, pps);
    DhWaveformData_set_sample_rate(self, DhAudioBuffer_sample_rate(buf));
    return self;
}

# --- zcr.cyr ---

# zcr.cyr -- zero-crossing rate (sign changes per second).
# Ports rust-old/src/analysis/zcr.rs. L0: deps error + buffer.
# ZcrResult struct; Result -> null-handle sentinel (buffer < 2 frames).

#derive(accessors)
struct DhZcrResult { rate_hz; per_channel; total_crossings; }

# zero_crossing_rate(buf) -> result handle, or 0 if fewer than 2 frames.
#must_use
fn dhvani_zcr_compute(buf) {
    var frames = DhAudioBuffer_frames(buf);
    if (frames < 2) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var per_channel = vec_new();
    var total = 0;
    var c = 0;
    while (c < ch) {
        var crossings = 0;
        var prev = vec_get(samples, c);
        var frame = 1;
        while (frame < frames) {
            var curr = vec_get(samples, frame * ch + c);
            # sign change positive<->negative (zero->nonzero not counted)
            if (f64_gt(prev, 0) == 1) { if (f64_lt(curr, 0) == 1) { crossings = crossings + 1; } }
            if (f64_lt(prev, 0) == 1) { if (f64_gt(curr, 0) == 1) { crossings = crossings + 1; } }
            prev = curr;
            frame = frame + 1;
        }
        var rate = f64_div(
          f64_mul(f64_from(crossings), f64_from(DhAudioBuffer_sample_rate(buf))),
          f64_from(frames - 1));
        vec_push(per_channel, rate);
        total = total + crossings;
        c = c + 1;
    }
    var sum = 0;
    var i = 0;
    while (i < ch) { sum = f64_add(sum, vec_get(per_channel, i)); i = i + 1; }
    var self = alloc(sizeof(DhZcrResult));
    DhZcrResult_set_rate_hz(self, f64_div(sum, f64_from(ch)));
    DhZcrResult_set_per_channel(self, per_channel);
    DhZcrResult_set_total_crossings(self, total);
    return self;
}

#inline
#must_use
fn dhvani_zcr_rate_hz(self) { return DhZcrResult_rate_hz(self); }
#inline
#must_use
fn dhvani_zcr_total_crossings(self) { return DhZcrResult_total_crossings(self); }
# per-channel rate at index c.
#must_use
fn dhvani_zcr_per_channel(self, c) { return vec_get(DhZcrResult_per_channel(self), c); }

# --- pan.cyr ---

# pan.cyr -- constant-power (sin/cos) stereo panner.
# Ports rust-old/src/dsp/pan.rs. L1: deps error + buffer + abaco::constant_power_pan.
# pan in [-1,+1]; abaco's constant_power_pan(pan, out_l, out_r) writes gains via
# out-pointers. serde/Default dropped.

#derive(accessors)
struct DhStereoPanner { pan; gain_l; gain_r; }

# new(pan) -- panner at the given position (-1 left .. +1 right).
#must_use
fn dhvani_pan_new(pan) {
    var self = alloc(sizeof(DhStereoPanner));
    DhStereoPanner_set_pan(self, 0);
    DhStereoPanner_set_gain_l(self, 0);
    DhStereoPanner_set_gain_r(self, 0);
    dhvani_pan_set_pan(self, pan);
    return self;
}

# set_pan(pan) -- clamp to [-1,1] and recompute L/R gains.
fn dhvani_pan_set_pan(self, pan) {
    var clamped = f64_clamp(pan, f64_neg(1.0), 1.0);
    DhStereoPanner_set_pan(self, clamped);
    # stack out-params: pan automation calls this every block, and two alloc(8)s per
    # call leaked under the free-less allocator through 2.3.2
    var lp[8];
    var rp[8];
    constant_power_pan(clamped, &lp, &rp);
    DhStereoPanner_set_gain_l(self, load64(&lp));
    DhStereoPanner_set_gain_r(self, load64(&rp));
    return 0;
}

#inline
#must_use
fn dhvani_pan_pan(self) { return DhStereoPanner_pan(self); }
#inline
#must_use
fn dhvani_pan_gain_l(self) { return DhStereoPanner_gain_l(self); }
#inline
#must_use
fn dhvani_pan_gain_r(self) { return DhStereoPanner_gain_r(self); }

# process(buf) -- apply pan gains to L/R in place. No-op for < 2 channels.
fn dhvani_pan_process(self, buf) {
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 2) { return 0; }
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var gl = DhStereoPanner_gain_l(self);
    var gr = DhStereoPanner_gain_r(self);
    frames = dh_imin(frames, vec_len(samples) / ch);
    var p = dh_vec_data(samples);
    var end = p + frames * ch * 8;
    var stride = ch * 8;
    while (p < end) {
        store64(p, f64_mul(load64(p), gl));
        store64(p + 8, f64_mul(load64(p + 8), gr));
        p = p + stride;
    }
    return 0;
}

# --- svf.cyr ---

# svf.cyr -- State Variable Filter (Cytomic / Andrew Simper topology).
# Ports rust-old/src/dsp/svf.rs. L1: deps error + buffer. SvfMode enum -> codes.
# Per-channel state (ic1eq/ic2eq) as a vec of DhSvfState. serde dropped;
# f32 params widen to f64. Stable under real-time cutoff modulation.
#
# Hardening beyond the oracle (as biquad.cyr):
#   - Buffer channels beyond the filter's state count pass through untouched, and
#     process_sample passes a negative channel through (the oracle panics on its
#     out-of-range state index).
#   - A sample rate whose Nyquist clamp `sample_rate * 0.499` falls below the 1 Hz floor
#     (any rate under 3) makes the filter a pass-through: the oracle's
#     `f64::clamp(1.0, sr * 0.499)` panics there, and tan(pi * 0 / 0) would make every
#     later output NaN.
#   - A state that went non-finite (a NaN or Inf input reached it) is cleared at the end
#     of the block it arrived in. The oracle keeps it, so one bad sample made every later
#     output NaN until reset().

var DH_SVF_LOWPASS   = 0;
var DH_SVF_HIGHPASS  = 1;
var DH_SVF_BANDPASS  = 2;
var DH_SVF_NOTCH     = 3;
var DH_SVF_ALLPASS   = 4;
var DH_SVF_PEAK      = 5;
var DH_SVF_LOWSHELF  = 6;
var DH_SVF_HIGHSHELF = 7;

#derive(accessors)
struct DhSvfState { ic1eq; ic2eq; }

# thru = 1 while the sample rate is too low for the coefficients (see the header).
#derive(accessors)
struct DhSvfFilter { mode; freq_hz; q; gain_db; sample_rate; states; bypassed; mix; g; k; a1; a2; a3; a; thru; }

# new(mode, freq_hz, q, gain_db, sample_rate, channels).
#must_use
fn dhvani_svf_new(mode, freq_hz, q, gain_db, sample_rate, channels) {
    var self = alloc(sizeof(DhSvfFilter));
    DhSvfFilter_set_mode(self, mode);
    DhSvfFilter_set_freq_hz(self, freq_hz);
    DhSvfFilter_set_q(self, f64_max(q, 0.01));
    DhSvfFilter_set_gain_db(self, gain_db);
    DhSvfFilter_set_sample_rate(self, sample_rate);
    var states = vec_new();
    var c = 0;
    while (c < channels) {
        var st = alloc(sizeof(DhSvfState));
        DhSvfState_set_ic1eq(st, 0);
        DhSvfState_set_ic2eq(st, 0);
        vec_push(states, st);
        c = c + 1;
    }
    DhSvfFilter_set_states(self, states);
    DhSvfFilter_set_bypassed(self, 0);
    DhSvfFilter_set_mix(self, 1.0);
    DhSvfFilter_set_g(self, 0);
    DhSvfFilter_set_k(self, 0);
    DhSvfFilter_set_a1(self, 0);
    DhSvfFilter_set_a2(self, 0);
    DhSvfFilter_set_a3(self, 0);
    DhSvfFilter_set_a(self, 1.0);
    DhSvfFilter_set_thru(self, 0);
    dhvani_svf_update_coeffs(self);
    return self;
}

# recompute g/k/a1/a2/a3/a from current params.
fn dhvani_svf_update_coeffs(self) {
    var sr = f64_from(DhSvfFilter_sample_rate(self));
    if (f64_lt(f64_mul(sr, 0.499), 1.0) == 1) {
        DhSvfFilter_set_thru(self, 1);
        DhSvfFilter_set_g(self, 0);
        DhSvfFilter_set_k(self, 0);
        DhSvfFilter_set_a1(self, 0);
        DhSvfFilter_set_a2(self, 0);
        DhSvfFilter_set_a3(self, 0);
        DhSvfFilter_set_a(self, 1.0);
        return 0;
    }
    DhSvfFilter_set_thru(self, 0);
    var freq = f64_clamp(DhSvfFilter_freq_hz(self), 1.0, f64_mul(sr, 0.499));
    var g = dhvani_tan(f64_div(f64_mul(F64_PI, freq), sr));
    var q = f64_max(DhSvfFilter_q(self), 0.01);
    var k = f64_div(1.0, q);
    var a = f64_pow(10.0, f64_div(DhSvfFilter_gain_db(self), 40.0));
    DhSvfFilter_set_a(self, a);
    var mode = DhSvfFilter_mode(self);
    if (mode == DH_SVF_PEAK) {
        k = f64_div(1.0, f64_mul(q, a));
    } elif (mode == DH_SVF_LOWSHELF) {
        g = f64_mul(g, f64_sqrt(a));
    } elif (mode == DH_SVF_HIGHSHELF) {
        g = f64_div(g, f64_sqrt(a));
    }
    var denom = f64_add(1.0, f64_mul(g, f64_add(g, k)));
    var a1 = f64_div(1.0, denom);
    var a2 = f64_mul(g, a1);
    var a3 = f64_mul(g, a2);
    DhSvfFilter_set_g(self, g);
    DhSvfFilter_set_k(self, k);
    DhSvfFilter_set_a1(self, a1);
    DhSvfFilter_set_a2(self, a2);
    DhSvfFilter_set_a3(self, a3);
    return 0;
}

# process one sample for `channel`; updates channel state.
fn dhvani_svf_process_sample_internal(self, input, channel) {
    var s = vec_get(DhSvfFilter_states(self), channel);
    var ic1 = DhSvfState_ic1eq(s);
    var ic2 = DhSvfState_ic2eq(s);
    var k = DhSvfFilter_k(self);
    var a = DhSvfFilter_a(self);
    var v3 = f64_sub(input, ic2);
    var v1 = f64_add(f64_mul(DhSvfFilter_a1(self), ic1), f64_mul(DhSvfFilter_a2(self), v3));
    var v2 = f64_add(f64_add(ic2, f64_mul(DhSvfFilter_a2(self), ic1)), f64_mul(DhSvfFilter_a3(self), v3));
    DhSvfState_set_ic1eq(s, f64_sub(f64_mul(2.0, v1), ic1));
    DhSvfState_set_ic2eq(s, f64_sub(f64_mul(2.0, v2), ic2));
    var mode = DhSvfFilter_mode(self);
    if (mode == DH_SVF_LOWPASS)  { return v2; }
    if (mode == DH_SVF_HIGHPASS) { return f64_sub(f64_sub(input, f64_mul(k, v1)), v2); }
    if (mode == DH_SVF_BANDPASS) { return v1; }
    if (mode == DH_SVF_NOTCH)    { return f64_sub(input, f64_mul(k, v1)); }
    if (mode == DH_SVF_ALLPASS)  { return f64_sub(input, f64_mul(f64_mul(2.0, k), v1)); }
    if (mode == DH_SVF_PEAK)     { return f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), v1)); }
    if (mode == DH_SVF_LOWSHELF) {
        return f64_add(f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), v2)),
          f64_mul(f64_mul(f64_sub(a, 1.0), k), v1));
    }
    # HighShelf
    var hp = f64_sub(f64_sub(input, f64_mul(k, v1)), v2);
    return f64_add(f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), hp)),
      f64_mul(f64_mul(f64_sub(a, 1.0), k), v1));
}

# Clear a state that went non-finite (see the header). Returns 1 if it was cleared.
fn dh_svf_state_sanitize(st) {
    var ic1 = DhSvfState_ic1eq(st);
    var ic2 = DhSvfState_ic2eq(st);
    if (dhvani_is_finite(ic1) == 0 || dhvani_is_finite(ic2) == 0) {
        DhSvfState_set_ic1eq(st, 0);
        DhSvfState_set_ic2eq(st, 0);
        return 1;
    }
    return 0;
}

# process(buf) -- filter in place with dry/wet mix. The per-sample step of
# dhvani_svf_process_sample_internal, with the coefficients read once per block, the
# channel state in locals and the samples walked in place: the same operations in the
# same order, so the same bits. Channels beyond the state count pass through.
fn dhvani_svf_process(self, buf) {
    if (DhSvfFilter_bypassed(self) == 1) { return 0; }
    if (DhSvfFilter_thru(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    var states = DhSvfFilter_states(self);
    var nst = dh_imin(ch, vec_len(states));
    var mix = DhSvfFilter_mix(self);
    var dry = f64_sub(1.0, mix);
    var k = DhSvfFilter_k(self);
    var a = DhSvfFilter_a(self);
    var a1 = DhSvfFilter_a1(self);
    var a2 = DhSvfFilter_a2(self);
    var a3 = DhSvfFilter_a3(self);
    var mode = DhSvfFilter_mode(self);
    # the mode outputs' coefficient products, as process_sample_internal forms them
    var k2 = f64_mul(2.0, k);
    var aa1 = f64_sub(f64_mul(a, a), 1.0);
    var am1k = f64_mul(f64_sub(a, 1.0), k);
    var d = dh_vec_data(samples);
    var stride = ch * 8;
    var c = 0;
    while (c < nst) {
        var st = vec_get(states, c);
        var ic1 = DhSvfState_ic1eq(st);
        var ic2 = DhSvfState_ic2eq(st);
        var p = d + c * 8;
        var end = p + frames * stride;
        while (p < end) {
            var input = load64(p);
            var v3 = f64_sub(input, ic2);
            var v1 = f64_add(f64_mul(a1, ic1), f64_mul(a2, v3));
            var v2 = f64_add(f64_add(ic2, f64_mul(a2, ic1)), f64_mul(a3, v3));
            ic1 = f64_sub(f64_mul(2.0, v1), ic1);
            ic2 = f64_sub(f64_mul(2.0, v2), ic2);
            var out = v2;
            if (mode == DH_SVF_LOWPASS) {
                out = v2;
            } elif (mode == DH_SVF_HIGHPASS) {
                out = f64_sub(f64_sub(input, f64_mul(k, v1)), v2);
            } elif (mode == DH_SVF_BANDPASS) {
                out = v1;
            } elif (mode == DH_SVF_NOTCH) {
                out = f64_sub(input, f64_mul(k, v1));
            } elif (mode == DH_SVF_ALLPASS) {
                out = f64_sub(input, f64_mul(k2, v1));
            } elif (mode == DH_SVF_PEAK) {
                out = f64_add(input, f64_mul(aa1, v1));
            } elif (mode == DH_SVF_LOWSHELF) {
                out = f64_add(f64_add(input, f64_mul(aa1, v2)), f64_mul(am1k, v1));
            } else {
                var hp = f64_sub(f64_sub(input, f64_mul(k, v1)), v2);
                out = f64_add(f64_add(input, f64_mul(aa1, hp)), f64_mul(am1k, v1));
            }
            store64(p, f64_add(f64_mul(input, dry), f64_mul(out, mix)));
            p = p + stride;
        }
        DhSvfState_set_ic1eq(st, ic1);
        DhSvfState_set_ic2eq(st, ic2);
        dh_svf_state_sanitize(st);
        c = c + 1;
    }
    return 0;
}

# process_sample(sample, channel) -- passthrough if channel out of range (negative
# too), or while the sample rate is too low for the coefficients.
#must_use
fn dhvani_svf_process_sample(self, sample, channel) {
    if (channel < 0) { return sample; }
    if (DhSvfFilter_thru(self) == 1) { return sample; }
    if (channel < vec_len(DhSvfFilter_states(self))) {
        return dhvani_svf_process_sample_internal(self, sample, channel);
    }
    return sample;
}

fn dhvani_svf_set_params(self, mode, freq_hz, q, gain_db) {
    DhSvfFilter_set_mode(self, mode);
    DhSvfFilter_set_freq_hz(self, freq_hz);
    DhSvfFilter_set_q(self, f64_max(q, 0.01));
    DhSvfFilter_set_gain_db(self, gain_db);
    dhvani_svf_update_coeffs(self);
    return 0;
}
fn dhvani_svf_set_frequency(self, freq_hz) {
    DhSvfFilter_set_freq_hz(self, freq_hz);
    dhvani_svf_update_coeffs(self);
    return 0;
}
fn dhvani_svf_set_q(self, q) { DhSvfFilter_set_q(self, f64_max(q, 0.01)); dhvani_svf_update_coeffs(self); return 0; }
fn dhvani_svf_set_gain_db(self, gain_db) {
    DhSvfFilter_set_gain_db(self, gain_db);
    dhvani_svf_update_coeffs(self);
    return 0;
}
fn dhvani_svf_set_sample_rate(self, sample_rate) {
    DhSvfFilter_set_sample_rate(self, sample_rate);
    dhvani_svf_update_coeffs(self);
    return 0;
}
fn dhvani_svf_set_bypass(self, bypassed) { DhSvfFilter_set_bypassed(self, bypassed); return 0; }
fn dhvani_svf_set_mix(self, mix) { DhSvfFilter_set_mix(self, f64_clamp(mix, 0, 1.0)); return 0; }

fn dhvani_svf_reset(self) {
    var states = DhSvfFilter_states(self);
    var n = vec_len(states);
    var i = 0;
    while (i < n) {
        var st = vec_get(states, i);
        DhSvfState_set_ic1eq(st, 0);
        DhSvfState_set_ic2eq(st, 0);
        i = i + 1;
    }
    return 0;
}

#inline
#must_use
fn dhvani_svf_mode(self) { return DhSvfFilter_mode(self); }
#inline
#must_use
fn dhvani_svf_freq_hz(self) { return DhSvfFilter_freq_hz(self); }
#inline
#must_use
fn dhvani_svf_q(self) { return DhSvfFilter_q(self); }
#inline
#must_use
fn dhvani_svf_gain_db(self) { return DhSvfFilter_gain_db(self); }
#inline
#must_use
fn dhvani_svf_mix(self) { return DhSvfFilter_mix(self); }
#must_use
fn dhvani_svf_is_bypassed(self) {
    if (DhSvfFilter_bypassed(self) == 1) { return 1; }
    return 0;
}

# --- biquad.cyr ---

# biquad.cyr -- RBJ Audio EQ Cookbook biquad filters (Direct Form II Transposed).
# Ports rust-old/src/dsp/biquad.rs. L1: deps error + simd + buffer + abaco
# (angular_frequency, db_gain_factor). FilterType enum with data-carrying
# Peaking/LowShelf/HighShelf{gain_db} -> integer code + a separate gain_db
# param/field. process() keeps the oracle's stereo fast path (2.3.2; dropped
# through 2.3.1, when simd had no vector arm to run it on).

var DH_BQ_LOWPASS   = 0;
var DH_BQ_HIGHPASS  = 1;
var DH_BQ_BANDPASS  = 2;
var DH_BQ_NOTCH     = 3;
var DH_BQ_ALLPASS   = 4;
var DH_BQ_PEAKING   = 5;   # uses gain_db
var DH_BQ_LOWSHELF  = 6;   # uses gain_db
var DH_BQ_HIGHSHELF = 7;   # uses gain_db

#derive(accessors)
struct DhBiquadCoeffs { b0; b1; b2; a1; a2; }

#derive(accessors)
struct DhBiquadState { z1; z2; }

#derive(accessors)
struct DhBiquadFilter { coeffs; states; filter_type; gain_db; freq_hz; q; sample_rate; bypassed; mix; }

# design_into(c, filter_type, gain_db, freq_hz, q, sample_rate) -- write the RBJ
# coefficients into the existing DhBiquadCoeffs `c`. Allocation-free, so a parameter
# change on a live filter (set_params, set_sample_rate, EQ band automation) costs no
# memory under the free-less allocator. (Through 2.3.2 every change allocated a fresh
# 40-byte coeffs struct, which leaked at the automation rate.)
# A rate whose Nyquist clamp `sample_rate * 0.499` falls below the 1 Hz floor (any rate
# under 3) gives unity coefficients: the oracle's `f32::clamp(1.0, sr * 0.499)` panics
# there, and w0 = 0/0 would otherwise make every later output NaN.
fn dhvani_biquad_design_into(c, filter_type, gain_db, freq_hz, q, sample_rate) {
    var sr = f64_from(sample_rate);
    if (f64_lt(f64_mul(sr, 0.499), 1.0) == 1) {
        DhBiquadCoeffs_set_b0(c, 1.0);
        DhBiquadCoeffs_set_b1(c, 0);
        DhBiquadCoeffs_set_b2(c, 0);
        DhBiquadCoeffs_set_a1(c, 0);
        DhBiquadCoeffs_set_a2(c, 0);
        return 0;
    }
    var f0 = f64_clamp(freq_hz, 1.0, f64_mul(sr, 0.499));
    var qq = f64_max(q, 0.01);
    var w0 = angular_frequency(f0, sr);
    var cos_w0 = f64_cos(w0);
    var sin_w0 = f64_sin(w0);
    var alpha = f64_div(sin_w0, f64_mul(2.0, qq));
    var neg2cos = f64_mul(f64_neg(2.0), cos_w0);
    var b0 = 0; var b1 = 0; var b2 = 0;
    var a0 = 0; var a1 = 0; var a2 = 0;
    var a = 0; var tsa = 0;
    if (filter_type == DH_BQ_LOWPASS) {
        b1 = f64_sub(1.0, cos_w0);
        b0 = f64_div(b1, 2.0);
        b2 = b0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_HIGHPASS) {
        b0 = f64_div(f64_add(1.0, cos_w0), 2.0);
        b1 = f64_neg(f64_add(1.0, cos_w0));
        b2 = b0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_BANDPASS) {
        b0 = alpha; b1 = 0; b2 = f64_neg(alpha);
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_NOTCH) {
        b0 = 1.0; b1 = neg2cos; b2 = 1.0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_ALLPASS) {
        b0 = f64_sub(1.0, alpha); b1 = neg2cos; b2 = f64_add(1.0, alpha);
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_PEAKING) {
        a = db_gain_factor(gain_db);
        b0 = f64_add(1.0, f64_mul(alpha, a));
        b1 = neg2cos;
        b2 = f64_sub(1.0, f64_mul(alpha, a));
        a0 = f64_add(1.0, f64_div(alpha, a));
        a1 = neg2cos;
        a2 = f64_sub(1.0, f64_div(alpha, a));
    } elif (filter_type == DH_BQ_LOWSHELF) {
        a = db_gain_factor(gain_db);
        tsa = f64_mul(f64_mul(2.0, f64_sqrt(a)), alpha);
        b0 = f64_mul(a, f64_add(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        b1 = f64_mul(f64_mul(2.0, a), f64_sub(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        b2 = f64_mul(a, f64_sub(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        a0 = f64_add(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
        a1 = f64_mul(f64_neg(2.0), f64_add(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        a2 = f64_sub(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
    } else {
        # HighShelf
        a = db_gain_factor(gain_db);
        tsa = f64_mul(f64_mul(2.0, f64_sqrt(a)), alpha);
        b0 = f64_mul(a, f64_add(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        b1 = f64_mul(f64_mul(f64_neg(2.0), a), f64_add(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        b2 = f64_mul(a, f64_sub(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        a0 = f64_add(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
        a1 = f64_mul(2.0, f64_sub(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        a2 = f64_sub(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
    }
    DhBiquadCoeffs_set_b0(c, f64_div(b0, a0));
    DhBiquadCoeffs_set_b1(c, f64_div(b1, a0));
    DhBiquadCoeffs_set_b2(c, f64_div(b2, a0));
    DhBiquadCoeffs_set_a1(c, f64_div(a1, a0));
    DhBiquadCoeffs_set_a2(c, f64_div(a2, a0));
    return 0;
}

# design(filter_type, gain_db, freq_hz, q, sample_rate) -> a new coeffs handle.
#must_use
fn dhvani_biquad_design(filter_type, gain_db, freq_hz, q, sample_rate) {
    var c = alloc(sizeof(DhBiquadCoeffs));
    dhvani_biquad_design_into(c, filter_type, gain_db, freq_hz, q, sample_rate);
    return c;
}

# unity (pass-through) coefficients.
#must_use
fn dhvani_biquad_coeffs_unity() {
    var c = alloc(sizeof(DhBiquadCoeffs));
    DhBiquadCoeffs_set_b0(c, 1.0);
    DhBiquadCoeffs_set_b1(c, 0);
    DhBiquadCoeffs_set_b2(c, 0);
    DhBiquadCoeffs_set_a1(c, 0);
    DhBiquadCoeffs_set_a2(c, 0);
    return c;
}

# process one sample through a state (Direct Form II Transposed).
fn dhvani_biquad_state_process(st, input, c) {
    var out = f64_add(f64_mul(DhBiquadCoeffs_b0(c), input), DhBiquadState_z1(st));
    var z1n = f64_sub(f64_mul(DhBiquadCoeffs_b1(c), input), f64_mul(DhBiquadCoeffs_a1(c), out));
    DhBiquadState_set_z1(st, f64_add(z1n, DhBiquadState_z2(st)));
    DhBiquadState_set_z2(st, f64_sub(f64_mul(DhBiquadCoeffs_b2(c), input), f64_mul(DhBiquadCoeffs_a2(c), out)));
    return out;
}

# new(filter_type, gain_db, freq_hz, q, sample_rate, channels).
#must_use
fn dhvani_biquad_new(filter_type, gain_db, freq_hz, q, sample_rate, channels) {
    var self = alloc(sizeof(DhBiquadFilter));
    DhBiquadFilter_set_coeffs(self, dhvani_biquad_design(filter_type, gain_db, freq_hz, q, sample_rate));
    var states = vec_new();
    var c = 0;
    while (c < channels) {
        var st = alloc(sizeof(DhBiquadState));
        DhBiquadState_set_z1(st, 0);
        DhBiquadState_set_z2(st, 0);
        vec_push(states, st);
        c = c + 1;
    }
    DhBiquadFilter_set_states(self, states);
    DhBiquadFilter_set_filter_type(self, filter_type);
    DhBiquadFilter_set_gain_db(self, gain_db);
    DhBiquadFilter_set_freq_hz(self, freq_hz);
    DhBiquadFilter_set_q(self, q);
    DhBiquadFilter_set_sample_rate(self, sample_rate);
    DhBiquadFilter_set_bypassed(self, 0);
    DhBiquadFilter_set_mix(self, 1.0);
    return self;
}

# A state that went non-finite (a NaN or Inf input reached it) is cleared at the end
# of the block it arrived in. The oracle keeps it, so one bad sample made every later
# output NaN until reset(); here the bad sample's own outputs stay NaN and the filter
# recovers on the next block (docs/decisions/005-hardening-divergences.md).
fn dh_biquad_state_sanitize(st) {
    var z1 = load64(st);
    var z2 = load64(st + 8);
    if (f64_eq(f64_sub(z1, z1), 0) == 0) { store64(st, 0); store64(st + 8, 0); return 1; }
    if (f64_eq(f64_sub(z2, z2), 0) == 0) { store64(st, 0); store64(st + 8, 0); return 1; }
    return 0;
}

# process(buf) -- filter in place with dry/wet mix. Channels beyond the filter's state
# count pass through untouched (the oracle panics on its out-of-range state index).
fn dhvani_biquad_process(self, buf) {
    if (DhBiquadFilter_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    # never walk past the storage, whatever `frames` claims
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    var coeffs = DhBiquadFilter_coeffs(self);
    var states = DhBiquadFilter_states(self);
    var nst = dh_imin(ch, vec_len(states));
    var stp = dh_vec_data(states);
    var mix = DhBiquadFilter_mix(self);
    var d = dh_vec_data(samples);
    # Fast path, as in the oracle: stereo at full wet (|mix - 1| < f32::EPSILON) runs
    # both channels through the cross-channel kernel, which reads the coeffs and the two
    # states in place (DhBiquadCoeffs / DhBiquadState are its layouts) -- no vec built.
    # The output is pure wet, where the loop below would add input * (1 - mix). It runs
    # `frames` frames, never vec_len / 2: a caller may reuse a longer vec for a shorter
    # block (the de-esser's sidechain does), and the tail past `frames` is not this block.
    if (ch == 2) {
        if (nst == 2) {
            if (f64_lt(f64_abs(f64_sub(mix, 1.0)), DH_EPSILON) == 1) {
                dh_simd_biquad_stereo_raw(d, frames, coeffs, load64(stp), load64(stp + 8));
                dh_biquad_state_sanitize(load64(stp));
                dh_biquad_state_sanitize(load64(stp + 8));
                return 0;
            }
        }
    }
    # The generic loop: the state update of dhvani_biquad_state_process, with the
    # coefficients read once per block and the samples walked in place (same bits).
    var b0 = DhBiquadCoeffs_b0(coeffs);
    var b1 = DhBiquadCoeffs_b1(coeffs);
    var b2 = DhBiquadCoeffs_b2(coeffs);
    var a1 = DhBiquadCoeffs_a1(coeffs);
    var a2 = DhBiquadCoeffs_a2(coeffs);
    var dry = f64_sub(1.0, mix);
    var c = 0;
    while (c < nst) {
        var st = load64(stp + c * 8);
        var z1 = load64(st);
        var z2 = load64(st + 8);
        var p = d + c * 8;
        var end = p + frames * ch * 8;
        var stride = ch * 8;
        while (p < end) {
            var input = load64(p);
            var out = f64_add(f64_mul(b0, input), z1);
            z1 = f64_add(f64_sub(f64_mul(b1, input), f64_mul(a1, out)), z2);
            z2 = f64_sub(f64_mul(b2, input), f64_mul(a2, out));
            store64(p, f64_add(f64_mul(input, dry), f64_mul(out, mix)));
            p = p + stride;
        }
        store64(st, z1);
        store64(st + 8, z2);
        dh_biquad_state_sanitize(st);
        c = c + 1;
    }
    return 0;
}

# process_sample(sample, channel) -- passthrough if channel out of range (negative too).
#must_use
fn dhvani_biquad_process_sample(self, sample, channel) {
    if (channel < 0) { return sample; }
    if (channel < vec_len(DhBiquadFilter_states(self))) {
        return dhvani_biquad_state_process(
          vec_get(DhBiquadFilter_states(self), channel),
          sample,
          DhBiquadFilter_coeffs(self));
    }
    return sample;
}

fn dhvani_biquad_reset(self) {
    var states = DhBiquadFilter_states(self);
    var n = vec_len(states);
    var i = 0;
    while (i < n) {
        var st = vec_get(states, i);
        DhBiquadState_set_z1(st, 0);
        DhBiquadState_set_z2(st, 0);
        i = i + 1;
    }
    return 0;
}

# set_params(filter_type, gain_db, freq_hz, q) -- recompute coeffs in place, keep state.
fn dhvani_biquad_set_params(self, filter_type, gain_db, freq_hz, q) {
    DhBiquadFilter_set_filter_type(self, filter_type);
    DhBiquadFilter_set_gain_db(self, gain_db);
    DhBiquadFilter_set_freq_hz(self, freq_hz);
    DhBiquadFilter_set_q(self, q);
    dhvani_biquad_design_into(DhBiquadFilter_coeffs(self), filter_type, gain_db, freq_hz, q,
      DhBiquadFilter_sample_rate(self));
    return 0;
}
fn dhvani_biquad_set_sample_rate(self, sample_rate) {
    DhBiquadFilter_set_sample_rate(self, sample_rate);
    dhvani_biquad_design_into(
      DhBiquadFilter_coeffs(self),
      DhBiquadFilter_filter_type(self),
      DhBiquadFilter_gain_db(self),
      DhBiquadFilter_freq_hz(self),
      DhBiquadFilter_q(self),
      sample_rate);
    return 0;
}
fn dhvani_biquad_set_bypass(self, bypassed) { DhBiquadFilter_set_bypassed(self, bypassed); return 0; }
fn dhvani_biquad_set_mix(self, mix) { DhBiquadFilter_set_mix(self, f64_clamp(mix, 0, 1.0)); return 0; }

#inline
#must_use
fn dhvani_biquad_filter_type(self) { return DhBiquadFilter_filter_type(self); }
#inline
#must_use
fn dhvani_biquad_freq_hz(self) { return DhBiquadFilter_freq_hz(self); }
#inline
#must_use
fn dhvani_biquad_q(self) { return DhBiquadFilter_q(self); }
#inline
#must_use
fn dhvani_biquad_mix(self) { return DhBiquadFilter_mix(self); }
#must_use
fn dhvani_biquad_is_bypassed(self) {
    if (DhBiquadFilter_bypassed(self) == 1) { return 1; }
    return 0;
}

# --- routing.cyr ---

# routing.cyr -- N×M channel routing matrix with per-crosspoint gain.
# Ports rust-old/src/dsp/routing.rs. L1: deps error + buffer.
# Vec<Vec<f32>> gains -> a flat `vec` arena indexed [out*inputs + inp]
# (Vec-arena-over-nested). apply() Result -> null-handle sentinel. serde dropped.

#derive(accessors)
struct DhRoutingMatrix { gains; inputs; outputs; }

# new(inputs, outputs) -- all crosspoints zero.
#must_use
fn dhvani_routing_new(inputs, outputs) {
    var self = alloc(sizeof(DhRoutingMatrix));
    DhRoutingMatrix_set_gains(self, dh_vec_zeros(outputs * inputs));
    DhRoutingMatrix_set_inputs(self, inputs);
    DhRoutingMatrix_set_outputs(self, outputs);
    return self;
}

# set_gain(output_ch, input_ch, gain) -- 1 on success, 0 if out of bounds (a
# negative index included: it would otherwise land on another crosspoint of the flat
# arena, or abort in vec_set).
fn dhvani_routing_set_gain(self, output_ch, input_ch, gain) {
    if (output_ch < 0 || input_ch < 0) { return 0; }
    if (output_ch < DhRoutingMatrix_outputs(self)) {
        if (input_ch < DhRoutingMatrix_inputs(self)) {
            vec_set(DhRoutingMatrix_gains(self), output_ch * DhRoutingMatrix_inputs(self) + input_ch, gain);
            return 1;
        }
    }
    return 0;
}

# gain(output_ch, input_ch) -- crosspoint gain, or 0.0 if out of bounds (negative too).
#must_use
fn dhvani_routing_gain(self, output_ch, input_ch) {
    if (output_ch < 0 || input_ch < 0) { return 0; }
    if (output_ch < DhRoutingMatrix_outputs(self)) {
        if (input_ch < DhRoutingMatrix_inputs(self)) {
            return vec_get(DhRoutingMatrix_gains(self), output_ch * DhRoutingMatrix_inputs(self) + input_ch);
        }
    }
    return 0;
}

#inline
#must_use
fn dhvani_routing_inputs(self) { return DhRoutingMatrix_inputs(self); }
#inline
#must_use
fn dhvani_routing_outputs(self) { return DhRoutingMatrix_outputs(self); }

# identity(channels) -- pass-through (unity on the diagonal).
#must_use
fn dhvani_routing_identity(channels) {
    var m = dhvani_routing_new(channels, channels);
    var i = 0;
    while (i < channels) { dhvani_routing_set_gain(m, i, i, 1.0); i = i + 1; }
    return m;
}
#must_use
fn dhvani_routing_mono_to_stereo() {
    var m = dhvani_routing_new(1, 2);
    dhvani_routing_set_gain(m, 0, 0, 1.0);
    dhvani_routing_set_gain(m, 1, 0, 1.0);
    return m;
}
#must_use
fn dhvani_routing_stereo_to_mono() {
    var m = dhvani_routing_new(2, 1);
    dhvani_routing_set_gain(m, 0, 0, 0.5);
    dhvani_routing_set_gain(m, 0, 1, 0.5);
    return m;
}
#must_use
fn dhvani_routing_mid_side_encode() {
    var m = dhvani_routing_new(2, 2);
    dhvani_routing_set_gain(m, 0, 0, 0.5);
    dhvani_routing_set_gain(m, 0, 1, 0.5);
    dhvani_routing_set_gain(m, 1, 0, 0.5);
    dhvani_routing_set_gain(m, 1, 1, f64_neg(0.5));
    return m;
}
#must_use
fn dhvani_routing_mid_side_decode() {
    var m = dhvani_routing_new(2, 2);
    dhvani_routing_set_gain(m, 0, 0, 1.0);
    dhvani_routing_set_gain(m, 0, 1, 1.0);
    dhvani_routing_set_gain(m, 1, 0, 1.0);
    dhvani_routing_set_gain(m, 1, 1, f64_neg(1.0));
    return m;
}

# apply(buf) -- route to a new buffer with `outputs` channels; 0 on channel
# count mismatch.
#must_use
fn dhvani_routing_apply(self, buf) {
    var in_ch = DhAudioBuffer_channels(buf);
    var inputs = DhRoutingMatrix_inputs(self);
    if (in_ch != inputs) { return 0; }
    var frames = DhAudioBuffer_frames(buf);
    var out_ch = DhRoutingMatrix_outputs(self);
    var samples = DhAudioBuffer_samples(buf);
    var gains = DhRoutingMatrix_gains(self);
    var output = dh_vec_zeros(frames * out_ch);
    var frame = 0;
    while (frame < frames) {
        var o = 0;
        while (o < out_ch) {
            var sum = 0;
            var i = 0;
            while (i < inputs) {
                var gain = vec_get(gains, o * inputs + i);
                # the oracle's `gain != 0.0`: -0.0 is a zero too (a bit compare missed it,
                # letting a NaN/Inf sample through a muted crosspoint)
                if (f64_eq(gain, 0) == 0) {
                    sum = f64_add(sum, f64_mul(vec_get(samples, frame * in_ch + i), gain));
                }
                i = i + 1;
            }
            vec_set(output, frame * out_ch + o, sum);
            o = o + 1;
        }
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(output, out_ch, DhAudioBuffer_sample_rate(buf));
}

# --- dsp.cyr ---

# dsp.cyr -- DSP facade: free-function processors + shared soft-knee math.
# Ports the OWN code of rust-old/src/dsp/mod.rs (the module re-exports are
# implicit in the flat bundle). L1: deps error + simd + buffer. The abaco DSP
# math (amplitude_to_db / db_to_amplitude / sanitize_sample) is used directly
# from abaco by consumers.

# noise_gate(buf, threshold) -- silence samples with |s| < threshold.
fn dhvani_dsp_noise_gate(buf, threshold) {
    dhvani_simd_noise_gate(DhAudioBuffer_samples(buf), threshold);
    return 0;
}

# hard_limiter(buf, ceiling) -- clamp to [-|ceiling|, |ceiling|].
fn dhvani_dsp_hard_limiter(buf, ceiling) {
    var c = f64_abs(ceiling);
    dhvani_simd_clamp(DhAudioBuffer_samples(buf), f64_neg(c), c);
    return 0;
}

# normalize(buf, target_peak) -- scale so the peak reaches target_peak.
fn dhvani_dsp_normalize(buf, target_peak) {
    var peak = dhvani_buffer_peak(buf);
    if (f64_gt(peak, 0) == 1) {
        dhvani_buffer_apply_gain(buf, f64_div(target_peak, peak));
    }
    return 0;
}

# soft_knee_gain(env_db, threshold_db, knee_db, slope) -- gain reduction in dB
# (negative = reduction). Shared by compressor + limiter for the quadratic
# knee region. slope = 1/ratio - 1 (compressor) or -1.0 (limiter).
#must_use
fn dhvani_dsp_soft_knee_gain(env_db, threshold_db, knee_db, slope) {
    var half_knee = f64_div(knee_db, 2.0);
    var lower = f64_sub(threshold_db, half_knee);
    var upper = f64_add(threshold_db, half_knee);
    if (f64_le(env_db, lower) == 1) { return 0; }
    if (f64_ge(env_db, upper) == 1) { return f64_mul(slope, f64_sub(env_db, threshold_db)); }
    var x = f64_sub(env_db, lower);
    return f64_div(f64_mul(f64_mul(slope, x), x), f64_mul(2.0, knee_db));
}

# --- compressor.cyr ---

# compressor.cyr -- dynamic range compressor (dB-domain, envelope follower).
# Ports rust-old/src/dsp/compressor.rs. L1: deps error + simd + buffer + dsp
# (soft_knee_gain) + abaco (time_constant, amplitude_to_db, db_to_amplitude).
# new()/set_params() Result -> handle-or-null / error code. serde + with_*
# builders dropped (untested convenience). knee via dsp::soft_knee_gain.
#
# Hardening beyond the oracle:
#   - The params are COPIED into storage the compressor owns (the oracle takes them by
#     value), so a later change to the caller's handle cannot skip validate().
#   - validate() rejects NaN in every bound (the oracle's `< 1.0` / `< 0.0` tests pass it).
#   - A non-finite sample (NaN, +-Inf) is left out of the envelope detector and comes
#     out as 0. In the oracle a single +Inf latched envelope_db at +Inf for good: the
#     gain went -Inf, failed is_finite, and compression stopped (and the +Inf passed).

#derive(accessors)
struct DhCompressorParams { threshold_db; ratio; attack_ms; release_ms; makeup_gain_db; knee_db; mix; }

#derive(accessors)
struct DhCompressor { params; envelope_db; gain_reduction_db; sample_rate; bypassed; }

# ---- CompressorParams ----
#must_use
fn dhvani_compparams_new(threshold_db, ratio, attack_ms, release_ms, makeup_gain_db, knee_db, mix) {
    var p = alloc(sizeof(DhCompressorParams));
    DhCompressorParams_set_threshold_db(p, threshold_db);
    DhCompressorParams_set_ratio(p, ratio);
    DhCompressorParams_set_attack_ms(p, attack_ms);
    DhCompressorParams_set_release_ms(p, release_ms);
    DhCompressorParams_set_makeup_gain_db(p, makeup_gain_db);
    DhCompressorParams_set_knee_db(p, knee_db);
    DhCompressorParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_compparams_default() { return dhvani_compparams_new(f64_neg(20.0), 4.0, 10.0, 100.0, 0, 0, 1.0); }

# copy src's fields into dst (a compressor's own params); returns dst.
fn dh_compparams_copy(dst, src) {
    DhCompressorParams_set_threshold_db(dst, DhCompressorParams_threshold_db(src));
    DhCompressorParams_set_ratio(dst, DhCompressorParams_ratio(src));
    DhCompressorParams_set_attack_ms(dst, DhCompressorParams_attack_ms(src));
    DhCompressorParams_set_release_ms(dst, DhCompressorParams_release_ms(src));
    DhCompressorParams_set_makeup_gain_db(dst, DhCompressorParams_makeup_gain_db(src));
    DhCompressorParams_set_knee_db(dst, DhCompressorParams_knee_db(src));
    DhCompressorParams_set_mix(dst, DhCompressorParams_mix(src));
    return dst;
}

# validate -- ratio>=1, attack/release/knee >= 0 (NaN rejected).
#must_use
fn dhvani_compparams_validate(p) {
    if (dh_in_range(DhCompressorParams_ratio(p), 1.0, DH_POS_INF) == 0)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhCompressorParams_attack_ms(p), 0, DH_POS_INF) == 0)  { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhCompressorParams_release_ms(p), 0, DH_POS_INF) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhCompressorParams_knee_db(p), 0, DH_POS_INF) == 0)    { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- Compressor ----
# new(params, sample_rate) -- handle, or 0 if params invalid. The params are copied.
#must_use
fn dhvani_comp_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_compparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhCompressor));
    DhCompressor_set_params(self, dh_compparams_copy(alloc(sizeof(DhCompressorParams)), params));
    DhCompressor_set_envelope_db(self, f64_neg(120.0));
    DhCompressor_set_gain_reduction_db(self, 0);
    DhCompressor_set_sample_rate(self, sample_rate);
    DhCompressor_set_bypassed(self, 0);
    return self;
}

# gain curve for an envelope level (dB): slope = 1/ratio - 1.
#must_use
fn dhvani_comp_compute_gain(self, env_db) {
    var p = DhCompressor_params(self);
    var slope = f64_sub(f64_div(1.0, DhCompressorParams_ratio(p)), 1.0);
    return dhvani_dsp_soft_knee_gain(env_db, DhCompressorParams_threshold_db(p), DhCompressorParams_knee_db(p), slope);
}

# process(buf) -- compress in place. The gain curve's slope, threshold and knee are read
# once per block (dhvani_comp_compute_gain's values, same bits), and the samples are
# walked in place.
fn dhvani_comp_process(self, buf) {
    var p = DhCompressor_params(self);
    if (f64_le(DhCompressorParams_ratio(p), 1.0) == 1) { return 0; }
    if (DhCompressor_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    # abaco's time_constant takes the rate as an f64 (Rust: `sample_rate as f32`
    # inside abaco::dsp::time_constant). The stored rate is an integer; passed raw
    # it reads as a subnormal and abaco >= 2.4.9 answers NaN.
    var sr = f64_from(DhCompressor_sample_rate(self));
    var attack_coeff = time_constant(DhCompressorParams_attack_ms(p), sr);
    var release_coeff = time_constant(DhCompressorParams_release_ms(p), sr);
    var makeup_lin = db_to_amplitude(DhCompressorParams_makeup_gain_db(p));
    var mix = f64_clamp(DhCompressorParams_mix(p), 0, 1.0);
    var dry = f64_sub(1.0, mix);
    var slope = f64_sub(f64_div(1.0, DhCompressorParams_ratio(p)), 1.0);
    var threshold = DhCompressorParams_threshold_db(p);
    var knee = DhCompressorParams_knee_db(p);
    var floor_db = f64_neg(120.0);
    var env_db = DhCompressor_envelope_db(self);
    var gain_db = 0;
    var stride = ch * 8;
    var fp = dh_vec_data(samples);
    var end = fp + frames * stride;
    while (fp < end) {
        var fe = fp + stride;
        # frame peak over the finite samples (a NaN or Inf never reaches the detector)
        var peak = 0;
        var q = fp;
        while (q < fe) {
            var a = f64_abs(load64(q));
            if (f64_lt(a, DH_POS_INF) == 1) {
                if (f64_gt(a, peak) == 1) { peak = a; }
            }
            q = q + 8;
        }
        var input_db = f64_max(amplitude_to_db(peak), floor_db);
        var coeff = release_coeff;
        if (f64_gt(input_db, env_db) == 1) { coeff = attack_coeff; }
        env_db = f64_add(f64_mul(coeff, env_db), f64_mul(f64_sub(1.0, coeff), input_db));
        gain_db = dhvani_dsp_soft_knee_gain(env_db, threshold, knee, slope);
        q = fp;
        if (dhvani_is_finite(gain_db) == 1) {
            var gain_lin = f64_mul(db_to_amplitude(gain_db), makeup_lin);
            while (q < fe) {
                var dry_sample = load64(q);
                var wet_sample = f64_mul(dry_sample, gain_lin);
                var out = f64_add(f64_mul(dry_sample, dry), f64_mul(wet_sample, mix));
                if (dhvani_is_finite(out) == 0) { out = 0; }
                store64(q, out);
                q = q + 8;
            }
        } else {
            # no gain this frame; a non-finite sample still comes out as 0
            while (q < fe) {
                if (dhvani_is_finite(load64(q)) == 0) { store64(q, 0); }
                q = q + 8;
            }
        }
        fp = fe;
    }
    DhCompressor_set_gain_reduction_db(self, gain_db);
    DhCompressor_set_envelope_db(self, env_db);
    return 0;
}

#inline
#must_use
fn dhvani_comp_gain_reduction_db(self) { return DhCompressor_gain_reduction_db(self); }
#inline
#must_use
fn dhvani_comp_envelope_db(self) { return DhCompressor_envelope_db(self); }
fn dhvani_comp_set_bypass(self, bypassed) { DhCompressor_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_comp_is_bypassed(self) { if (DhCompressor_bypassed(self) == 1) { return 1; } return 0; }
fn dhvani_comp_set_sample_rate(self, sample_rate) { DhCompressor_set_sample_rate(self, sample_rate); return 0; }
fn dhvani_comp_reset(self) {
    DhCompressor_set_envelope_db(self, f64_neg(120.0));
    DhCompressor_set_gain_reduction_db(self, 0);
    return 0;
}

# set_params -- validate, then copy into the compressor's own params; error code on invalid.
fn dhvani_comp_set_params(self, params) {
    var rc = dhvani_compparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dh_compparams_copy(DhCompressor_params(self), params);
    return DHVANI_ERR_NONE;
}

# --- limiter.cyr ---

# limiter.cyr -- brick-wall envelope limiter (instant attack, soft-knee).
# Ports rust-old/src/dsp/limiter.rs. L1: deps error + simd + buffer + dsp
# (soft_knee_gain) + abaco (time_constant, amplitude_to_db, db_to_amplitude).
# Limiter = inf:1 compression -> soft_knee slope = -1.0. serde + with_* dropped.
#
# Hardening beyond the oracle (as in compressor.cyr): the params are COPIED into
# storage the limiter owns; validate() rejects NaN in every bound; a non-finite sample
# is left out of the envelope detector and comes out as 0. In the oracle a single +Inf
# latched envelope_db at +Inf for good, leaving a hard clipper with no release, and a
# NaN sample passed straight through the "brick wall".

#derive(accessors)
struct DhLimiterParams { ceiling_db; release_ms; knee_db; mix; }

#derive(accessors)
struct DhEnvelopeLimiter { params; envelope_db; sample_rate; bypassed; }

# ---- LimiterParams ----
#must_use
fn dhvani_limparams_new(ceiling_db, release_ms, knee_db, mix) {
    var p = alloc(sizeof(DhLimiterParams));
    DhLimiterParams_set_ceiling_db(p, ceiling_db);
    DhLimiterParams_set_release_ms(p, release_ms);
    DhLimiterParams_set_knee_db(p, knee_db);
    DhLimiterParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_limparams_default() { return dhvani_limparams_new(f64_neg(0.3), 50.0, 0, 1.0); }

# copy src's fields into dst (a limiter's own params); returns dst.
fn dh_limparams_copy(dst, src) {
    DhLimiterParams_set_ceiling_db(dst, DhLimiterParams_ceiling_db(src));
    DhLimiterParams_set_release_ms(dst, DhLimiterParams_release_ms(src));
    DhLimiterParams_set_knee_db(dst, DhLimiterParams_knee_db(src));
    DhLimiterParams_set_mix(dst, DhLimiterParams_mix(src));
    return dst;
}

# validate -- ceiling <= 0, release/knee >= 0 (NaN rejected).
#must_use
fn dhvani_limparams_validate(p) {
    if (dh_in_range(DhLimiterParams_ceiling_db(p), DH_NEG_INF, 0) == 0)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhLimiterParams_release_ms(p), 0, DH_POS_INF) == 0)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhLimiterParams_knee_db(p), 0, DH_POS_INF) == 0)       { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- EnvelopeLimiter ----
# new(params, sample_rate) -- handle, or 0 if params invalid. The params are copied.
#must_use
fn dhvani_lim_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_limparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhEnvelopeLimiter));
    DhEnvelopeLimiter_set_params(self, dh_limparams_copy(alloc(sizeof(DhLimiterParams)), params));
    DhEnvelopeLimiter_set_envelope_db(self, f64_neg(120.0));
    DhEnvelopeLimiter_set_sample_rate(self, sample_rate);
    DhEnvelopeLimiter_set_bypassed(self, 0);
    return self;
}

# gain curve (slope = -1.0, i.e. inf:1).
#must_use
fn dhvani_lim_compute_gain(self, env_db) {
    var p = DhEnvelopeLimiter_params(self);
    return dhvani_dsp_soft_knee_gain(env_db, DhLimiterParams_ceiling_db(p), DhLimiterParams_knee_db(p), f64_neg(1.0));
}

# process(buf) -- limit in place with a hard-clamp safety net. The gain curve's ceiling
# and knee are read once per block (dhvani_lim_compute_gain's values, same bits), and the
# samples are walked in place.
fn dhvani_lim_process(self, buf) {
    if (DhEnvelopeLimiter_bypassed(self) == 1) { return 0; }
    var p = DhEnvelopeLimiter_params(self);
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    # f64 rate for abaco's time_constant (see dhvani_comp_process).
    var release_coeff = time_constant(DhLimiterParams_release_ms(p), f64_from(DhEnvelopeLimiter_sample_rate(self)));
    var ceiling_db = DhLimiterParams_ceiling_db(p);
    var knee = DhLimiterParams_knee_db(p);
    var neg_one = f64_neg(1.0);
    var ceiling_lin = db_to_amplitude(ceiling_db);
    var neg_ceiling = f64_neg(ceiling_lin);
    var mix = f64_clamp(DhLimiterParams_mix(p), 0, 1.0);
    var dry = f64_sub(1.0, mix);
    var floor_db = f64_neg(120.0);
    var env_db = DhEnvelopeLimiter_envelope_db(self);
    var stride = ch * 8;
    var fp = dh_vec_data(samples);
    var end = fp + frames * stride;
    while (fp < end) {
        var fe = fp + stride;
        # frame peak over the finite samples (a NaN or Inf never reaches the detector)
        var peak = 0;
        var q = fp;
        while (q < fe) {
            var a = f64_abs(load64(q));
            if (f64_lt(a, DH_POS_INF) == 1) {
                if (f64_gt(a, peak) == 1) { peak = a; }
            }
            q = q + 8;
        }
        var input_db = f64_max(amplitude_to_db(peak), floor_db);
        if (f64_gt(input_db, env_db) == 1) {
            env_db = input_db;
        } else {
            env_db = f64_add(f64_mul(release_coeff, env_db), f64_mul(f64_sub(1.0, release_coeff), input_db));
        }
        var gain_db = dhvani_dsp_soft_knee_gain(env_db, ceiling_db, knee, neg_one);
        if (f64_lt(gain_db, 0) == 1) {
            if (dhvani_is_finite(gain_db) == 1) {
                var gain_lin = db_to_amplitude(gain_db);
                q = fp;
                while (q < fe) {
                    var dry_sample = load64(q);
                    store64(q, f64_add(f64_mul(dry_sample, dry), f64_mul(f64_mul(dry_sample, gain_lin), mix)));
                    q = q + 8;
                }
            }
        }
        # hard-clamp safety net on every channel; a non-finite sample comes out as 0
        q = fp;
        while (q < fe) {
            var x = load64(q);
            if (dhvani_is_finite(x) == 0) { x = 0; }
            store64(q, f64_clamp(x, neg_ceiling, ceiling_lin));
            q = q + 8;
        }
        fp = fe;
    }
    DhEnvelopeLimiter_set_envelope_db(self, env_db);
    return 0;
}

#must_use
fn dhvani_lim_gain_reduction_db(self) { return dhvani_lim_compute_gain(self, DhEnvelopeLimiter_envelope_db(self)); }
#inline
#must_use
fn dhvani_lim_envelope_db(self) { return DhEnvelopeLimiter_envelope_db(self); }
fn dhvani_lim_set_bypass(self, bypassed) { DhEnvelopeLimiter_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_lim_is_bypassed(self) { if (DhEnvelopeLimiter_bypassed(self) == 1) { return 1; } return 0; }
fn dhvani_lim_set_sample_rate(self, sample_rate) { DhEnvelopeLimiter_set_sample_rate(self, sample_rate); return 0; }
fn dhvani_lim_reset(self) { DhEnvelopeLimiter_set_envelope_db(self, f64_neg(120.0)); return 0; }

# set_params -- validate, then copy into the limiter's own params; error code on invalid.
fn dhvani_lim_set_params(self, params) {
    var rc = dhvani_limparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dh_limparams_copy(DhEnvelopeLimiter_params(self), params);
    return DHVANI_ERR_NONE;
}

# --- delay.cyr ---

# delay.cyr -- delay line with feedback + modulated delay (chorus/flanger).
# Ports rust-old/src/dsp/delay.rs. L1: deps error + buffer. Per-channel ring
# buffers = a vec of per-channel `vec`s. serde dropped.
#
# Hardening beyond the oracle (each one changes output only on input the oracle
# mishandles):
#   - A time in ms becomes samples as Rust's `as usize` cast does: negative, -Inf and
#     NaN floor to 0 (the port's f64_to kept a negative count, and -Inf aborted).
#   - A non-finite value is never written into a ring. The oracle stores
#     `input + delayed * feedback` as is, so one NaN came round every `delay` frames
#     forever (NaN * 0 is NaN, so even feedback 0 kept it) and zeroed that output.
#   - Buffer channels beyond the delay's channel count pass through untouched (the
#     oracle panics on the out-of-range ring index).
#   - ModulatedDelay::set_params grows the ring when the new base + depth outgrow it,
#     and process clamps the read delay to the ring. The oracle does neither: its
#     usize index underflows (a debug panic, a silent wrap in release), and here it
#     was a vec_get abort.

#derive(accessors)
struct DhDelayLine { buffers; write_pos; delay_samples; max_delay_samples; feedback; mix; bypassed; }

#derive(accessors)
struct DhModulatedDelayParams { base_delay_ms; depth_ms; rate_hz; feedback; mix; }

#derive(accessors)
struct DhModulatedDelay { delay; params; lfo_phase; sample_rate; bypassed; }

# Above this a sample count is capped (2^62): Rust's cast saturates at usize::MAX,
# which no i64 holds, and every caller clamps the count to a ring far smaller.
var DH_DELAY_SAMPLES_CAP_F = 0x43D0000000000000;   # 2^62 as an f64
var DH_DELAY_SAMPLES_CAP = 0x4000000000000000;     # 2^62

# ms -> samples, as Rust's `((ms / 1000.0) * sample_rate as f32) as usize`: the cast
# saturates, so a negative, -Inf or NaN time is 0 samples.
#must_use
fn dh_delay_ms_to_samples(ms, sample_rate) {
    var s = f64_mul(f64_div(ms, 1000.0), f64_from(sample_rate));
    if (f64_gt(s, 0) == 0) { return 0; }
    if (f64_ge(s, DH_DELAY_SAMPLES_CAP_F) == 1) { return DH_DELAY_SAMPLES_CAP; }
    return f64_to(f64_trunc(s));
}

# A value bound for a ring: non-finite becomes 0, so it cannot circulate.
#must_use
fn dh_delay_ring_value(x) {
    if (dhvani_is_finite(x) == 0) { return 0; }
    return x;
}

# ---- DelayLine ----
#must_use
fn dhvani_delay_new(delay_ms, max_delay_ms, feedback, mix, sample_rate, channels) {
    var self = alloc(sizeof(DhDelayLine));
    # f32::max ignores a NaN operand: the larger of the two real times sizes the ring
    var max_samples = dh_delay_ms_to_samples(dh_max_ignore_nan(max_delay_ms, delay_ms), sample_rate);
    if (max_samples < 1) { max_samples = 1; }
    var delay_samples = dh_delay_ms_to_samples(delay_ms, sample_rate);
    if (delay_samples > max_samples) { delay_samples = max_samples; }
    var buffers = vec_new();
    var c = 0;
    while (c < channels) { vec_push(buffers, dh_vec_zeros(max_samples)); c = c + 1; }
    DhDelayLine_set_buffers(self, buffers);
    DhDelayLine_set_write_pos(self, 0);
    DhDelayLine_set_delay_samples(self, delay_samples);
    DhDelayLine_set_max_delay_samples(self, max_samples);
    DhDelayLine_set_feedback(self, f64_clamp(feedback, 0, 0.99));
    DhDelayLine_set_mix(self, f64_clamp(mix, 0, 1.0));
    DhDelayLine_set_bypassed(self, 0);
    return self;
}

# The ring of `channel`, or 0 when there is none, or when its length is not the ring
# size (an allocation that failed): every caller then passes the sample through.
#must_use
fn dh_delay_ring(self, channel) {
    if (channel < 0) { return 0; }
    var buffers = DhDelayLine_buffers(self);
    if (channel >= vec_len(buffers)) { return 0; }
    var ring = vec_get(buffers, channel);
    if (vec_len(ring) != DhDelayLine_max_delay_samples(self)) { return 0; }
    return ring;
}

# process one sample for a channel (does NOT advance write_pos). A channel the delay
# has no ring for returns the input unchanged.
fn dhvani_delay_process_sample(self, input, channel) {
    var ring = dh_delay_ring(self, channel);
    if (ring == 0) { return input; }
    var max = DhDelayLine_max_delay_samples(self);
    var wp = DhDelayLine_write_pos(self);
    var read_pos = (wp + max - DhDelayLine_delay_samples(self)) % max;
    var delayed = vec_get(ring, read_pos);
    vec_set(ring, wp, dh_delay_ring_value(f64_add(input, f64_mul(delayed, DhDelayLine_feedback(self)))));
    var mix = DhDelayLine_mix(self);
    return f64_add(f64_mul(input, f64_sub(1.0, mix)), f64_mul(delayed, mix));
}

# read a fractional delay position via linear interpolation. The delay is clamped to
# [0, ring - 1] samples, the deepest read that stays inside the ring.
#must_use
fn dhvani_delay_read_interpolated(self, channel, delay_frac) {
    var ring = dh_delay_ring(self, channel);
    if (ring == 0) { return 0; }
    var max = DhDelayLine_max_delay_samples(self);
    var wp = DhDelayLine_write_pos(self);
    var df = f64_max(delay_frac, 0);
    var lim = f64_from(max - 1);
    if (f64_gt(df, lim) == 1) { df = lim; }
    var delay_int = f64_to(f64_trunc(df));
    var frac = f64_sub(df, f64_from(delay_int));
    var pos0 = (wp + max - delay_int) % max;
    var pos1 = (wp + max - delay_int - 1) % max;
    return f64_add(f64_mul(vec_get(ring, pos0), f64_sub(1.0, frac)), f64_mul(vec_get(ring, pos1), frac));
}

# process(buf) -- fixed delay in place. The rings are independent, so each channel is
# walked on its own, with the struct fields read once per block: the same operations,
# in the same order per channel, as dhvani_delay_process_sample per sample.
fn dhvani_delay_process(self, buf) {
    if (DhDelayLine_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    var max = DhDelayLine_max_delay_samples(self);
    var delay = DhDelayLine_delay_samples(self);
    var fb = DhDelayLine_feedback(self);
    var mix = DhDelayLine_mix(self);
    var dry = f64_sub(1.0, mix);
    var wp0 = DhDelayLine_write_pos(self);
    var d = dh_vec_data(samples);
    var stride = ch * 8;
    var c = 0;
    while (c < ch) {
        var ring = dh_delay_ring(self, c);
        if (ring != 0) {
            var rp = dh_vec_data(ring);
            var wp = wp0;
            var p = d + c * 8;
            var end = p + frames * stride;
            while (p < end) {
                var input = load64(p);
                var delayed = load64(rp + ((wp + max - delay) % max) * 8);
                store64(rp + wp * 8, dh_delay_ring_value(f64_add(input, f64_mul(delayed, fb))));
                var out = f64_add(f64_mul(input, dry), f64_mul(delayed, mix));
                if (dhvani_is_finite(out) == 0) { out = 0; }
                store64(p, out);
                wp = wp + 1;
                if (wp == max) { wp = 0; }
                p = p + stride;
            }
        }
        c = c + 1;
    }
    DhDelayLine_set_write_pos(self, (wp0 + frames) % max);
    return 0;
}

fn dhvani_delay_set_bypass(self, bypassed) { DhDelayLine_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_delay_is_bypassed(self) { if (DhDelayLine_bypassed(self) == 1) { return 1; } return 0; }
#inline
#must_use
fn dhvani_delay_latency_frames(self) { return DhDelayLine_delay_samples(self); }
fn dhvani_delay_set_delay_ms(self, delay_ms, sample_rate) {
    var samples = dh_delay_ms_to_samples(delay_ms, sample_rate);
    var max = DhDelayLine_max_delay_samples(self);
    if (samples > max) { samples = max; }
    DhDelayLine_set_delay_samples(self, samples);
    return 0;
}
fn dhvani_delay_reset(self) {
    var buffers = DhDelayLine_buffers(self);
    var nc = vec_len(buffers);
    var c = 0;
    while (c < nc) {
        var ring = vec_get(buffers, c);
        var n = vec_len(ring);
        var i = 0;
        while (i < n) { vec_set(ring, i, 0); i = i + 1; }
        c = c + 1;
    }
    DhDelayLine_set_write_pos(self, 0);
    return 0;
}

# Grow every ring to new_max samples, keeping each sample at its age: the sample written
# `age` frames ago moves to new_max - age, and write_pos restarts at 0. All new rings are
# allocated before any is swapped in, so a failed allocation leaves the delay as it was
# (returns -1). A no-op when the ring is already at least new_max.
fn dh_delay_grow(self, new_max) {
    var old_max = DhDelayLine_max_delay_samples(self);
    if (new_max <= old_max) { return 0; }
    var buffers = DhDelayLine_buffers(self);
    var n = vec_len(buffers);
    var fresh = vec_new();
    var c = 0;
    while (c < n) {
        var nr = dh_vec_zeros(new_max);
        if (vec_len(nr) != new_max) { return 0 - 1; }
        vec_push(fresh, nr);
        c = c + 1;
    }
    var wp = DhDelayLine_write_pos(self);
    c = 0;
    while (c < n) {
        var old = vec_get(buffers, c);
        var nr2 = vec_get(fresh, c);
        if (vec_len(old) == old_max) {
            var age = 1;
            while (age <= old_max) {
                vec_set(nr2, new_max - age, vec_get(old, (wp - age + old_max) % old_max));
                age = age + 1;
            }
        }
        vec_set(buffers, c, nr2);
        c = c + 1;
    }
    DhDelayLine_set_write_pos(self, 0);
    DhDelayLine_set_max_delay_samples(self, new_max);
    return 0;
}

# ---- ModulatedDelayParams ----
#must_use
fn dhvani_moddelayparams_new(base_delay_ms, depth_ms, rate_hz, feedback, mix) {
    var p = alloc(sizeof(DhModulatedDelayParams));
    DhModulatedDelayParams_set_base_delay_ms(p, base_delay_ms);
    DhModulatedDelayParams_set_depth_ms(p, depth_ms);
    DhModulatedDelayParams_set_rate_hz(p, rate_hz);
    DhModulatedDelayParams_set_feedback(p, feedback);
    DhModulatedDelayParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_moddelayparams_default() { return dhvani_moddelayparams_new(7.0, 3.0, 0.5, 0.3, 0.5); }

# copy src's fields into dst (an instance's own params); returns dst.
fn dh_moddelayparams_copy(dst, src) {
    DhModulatedDelayParams_set_base_delay_ms(dst, DhModulatedDelayParams_base_delay_ms(src));
    DhModulatedDelayParams_set_depth_ms(dst, DhModulatedDelayParams_depth_ms(src));
    DhModulatedDelayParams_set_rate_hz(dst, DhModulatedDelayParams_rate_hz(src));
    DhModulatedDelayParams_set_feedback(dst, DhModulatedDelayParams_feedback(src));
    DhModulatedDelayParams_set_mix(dst, DhModulatedDelayParams_mix(src));
    return dst;
}

# validate -- base/depth/rate >= 0, feedback in [0, 0.99], mix in [0, 1]. Every bound
# rejects NaN (the oracle's `contains` does for feedback and mix; its `< 0.0` tests let a
# NaN base, depth or rate through).
#must_use
fn dhvani_moddelayparams_validate(p) {
    var bad = DHVANI_ERR_INVALID_PARAMETER;
    if (dh_in_range(DhModulatedDelayParams_base_delay_ms(p), 0, DH_POS_INF) == 0) { return bad; }
    if (dh_in_range(DhModulatedDelayParams_depth_ms(p), 0, DH_POS_INF) == 0)      { return bad; }
    if (dh_in_range(DhModulatedDelayParams_rate_hz(p), 0, DH_POS_INF) == 0)       { return bad; }
    if (dh_in_range(DhModulatedDelayParams_feedback(p), 0, 0.99) == 0)            { return bad; }
    if (dh_in_range(DhModulatedDelayParams_mix(p), 0, 1.0) == 0)                  { return bad; }
    return DHVANI_ERR_NONE;
}

# ---- ModulatedDelay ----
# The ring a ModulatedDelay needs for params p: base + depth + 1 ms, as the oracle sizes it.
#must_use
fn dh_moddelay_max_ms(p) {
    return f64_add(f64_add(DhModulatedDelayParams_base_delay_ms(p), DhModulatedDelayParams_depth_ms(p)), 1.0);
}

# The DelayLine for params p, as the oracle builds it: base delay, a base + depth + 1 ms ring.
#must_use
fn dh_moddelay_line(p, sample_rate, channels) {
    return dhvani_delay_new(DhModulatedDelayParams_base_delay_ms(p), dh_moddelay_max_ms(p),
      DhModulatedDelayParams_feedback(p), DhModulatedDelayParams_mix(p), sample_rate, channels);
}

# new(params, sample_rate, channels) -- the params are COPIED into storage the delay
# owns (the oracle takes them by value), so a later change to the caller's handle
# cannot reach the delay without set_params.
#must_use
fn dhvani_moddelay_new(params, sample_rate, channels) {
    var self = alloc(sizeof(DhModulatedDelay));
    var own = dh_moddelayparams_copy(alloc(sizeof(DhModulatedDelayParams)), params);
    DhModulatedDelay_set_delay(self, dh_moddelay_line(own, sample_rate, channels));
    DhModulatedDelay_set_params(self, own);
    DhModulatedDelay_set_lfo_phase(self, 0);
    DhModulatedDelay_set_sample_rate(self, sample_rate);
    DhModulatedDelay_set_bypassed(self, 0);
    return self;
}

fn dhvani_moddelay_process(self, buf) {
    if (DhModulatedDelay_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return 0; }
    frames = dh_imin(frames, vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    var p = DhModulatedDelay_params(self);
    var delay = DhModulatedDelay_delay(self);
    var sr = DhModulatedDelay_sample_rate(self);
    var srf = f64_from(sr);
    var phase_inc = f64_div(DhModulatedDelayParams_rate_hz(p), srf);
    var lfo_phase = DhModulatedDelay_lfo_phase(self);
    var base = DhModulatedDelayParams_base_delay_ms(p);
    var depth = DhModulatedDelayParams_depth_ms(p);
    var feedback = DhModulatedDelayParams_feedback(p);
    var mix = DhModulatedDelayParams_mix(p);
    var dry = f64_sub(1.0, mix);
    var max = DhDelayLine_max_delay_samples(delay);
    # the deepest read that stays inside the ring (pos1 = delay_int + 1 frames back)
    var lim = f64_from(max - 1);
    var two_pi = f64_mul(2.0, F64_PI);
    # leading channels with a ring of the right size; the rest pass through
    var nring = 0;
    while (nring < ch) {
        if (dh_delay_ring(delay, nring) == 0) { break; }
        nring = nring + 1;
    }
    var bp = dh_vec_data(DhDelayLine_buffers(delay));
    var d = dh_vec_data(samples);
    var wp = DhDelayLine_write_pos(delay);
    var frame = 0;
    while (frame < frames) {
        var lfo = f64_sin(f64_mul(two_pi, lfo_phase));
        var delay_ms = f64_add(base, f64_mul(depth, lfo));
        var delay_frac = f64_max(f64_mul(f64_div(delay_ms, 1000.0), srf), 0);
        if (f64_gt(delay_frac, lim) == 1) { delay_frac = lim; }
        var delay_int = f64_to(f64_trunc(delay_frac));
        var frac = f64_sub(delay_frac, f64_from(delay_int));
        var inv = f64_sub(1.0, frac);
        var pos0 = (wp + max - delay_int) % max;
        var pos1 = (wp + max - delay_int - 1) % max;
        var fp = d + frame * ch * 8;
        var c = 0;
        while (c < nring) {
            var rp = dh_vec_data(load64(bp + c * 8));
            var input = load64(fp);
            var delayed = f64_add(f64_mul(load64(rp + pos0 * 8), inv), f64_mul(load64(rp + pos1 * 8), frac));
            store64(rp + wp * 8, dh_delay_ring_value(f64_add(input, f64_mul(delayed, feedback))));
            var out = f64_add(f64_mul(input, dry), f64_mul(delayed, mix));
            if (dhvani_is_finite(out) == 0) { out = 0; }
            store64(fp, out);
            fp = fp + 8;
            c = c + 1;
        }
        wp = wp + 1;
        if (wp == max) { wp = 0; }
        lfo_phase = dh_fmod1(f64_add(lfo_phase, phase_inc));
        frame = frame + 1;
    }
    DhDelayLine_set_write_pos(delay, wp);
    DhModulatedDelay_set_lfo_phase(self, lfo_phase);
    return 0;
}

#inline
#must_use
fn dhvani_moddelay_latency_frames(self) {
    var p = DhModulatedDelay_params(self);
    return dh_delay_ms_to_samples(DhModulatedDelayParams_base_delay_ms(p), DhModulatedDelay_sample_rate(self));
}
#inline
#must_use
fn dhvani_moddelay_lfo_phase(self) { return DhModulatedDelay_lfo_phase(self); }
fn dhvani_moddelay_set_bypass(self, bypassed) { DhModulatedDelay_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_moddelay_is_bypassed(self) { if (DhModulatedDelay_bypassed(self) == 1) { return 1; } return 0; }

# set_params -- copy the params in (feedback/mix also clamped onto the delay line, as the
# oracle does). When the new base + depth outgrow the ring it is grown, keeping its
# history; that allocates, so do it off the RT path. A change that fits allocates nothing.
fn dhvani_moddelay_set_params(self, params) {
    var delay = DhModulatedDelay_delay(self);
    DhDelayLine_set_feedback(delay, f64_clamp(DhModulatedDelayParams_feedback(params), 0, 0.99));
    DhDelayLine_set_mix(delay, f64_clamp(DhModulatedDelayParams_mix(params), 0, 1.0));
    var own = dh_moddelayparams_copy(DhModulatedDelay_params(self), params);
    var need = dh_delay_ms_to_samples(
      dh_max_ignore_nan(dh_moddelay_max_ms(own), DhModulatedDelayParams_base_delay_ms(own)),
      DhModulatedDelay_sample_rate(self));
    dh_delay_grow(delay, need);
    return 0;
}
fn dhvani_moddelay_set_sample_rate(self, sample_rate) {
    DhModulatedDelay_set_sample_rate(self, sample_rate);
    var p = DhModulatedDelay_params(self);
    var channels = vec_len(DhDelayLine_buffers(DhModulatedDelay_delay(self)));
    DhModulatedDelay_set_delay(self, dh_moddelay_line(p, sample_rate, channels));
    DhModulatedDelay_set_lfo_phase(self, 0);
    return 0;
}
fn dhvani_moddelay_reset(self) {
    dhvani_delay_reset(DhModulatedDelay_delay(self));
    DhModulatedDelay_set_lfo_phase(self, 0);
    return 0;
}

# --- reverb.cyr ---

# reverb.cyr -- Schroeder/Freeverb reverb (4 combs -> 2 allpass, per channel).
# Ports rust-old/src/dsp/reverb.rs. L1: deps error + buffer. Comb/allpass rings
# as `vec`s; filter banks as vecs of filter handles. serde dropped.
# Base delays @44100 scaled to the target rate. ALLPASS_FEEDBACK = 0.5.
#
# process() runs block-wise per channel lane: each comb walks the whole block over
# its ring (data pointer, length and write position hoisted into locals,
# compare-and-wrap instead of `%`), accumulating into a struct-owned grow-only
# scratch row; then the two allpasses cascade over that row. Every sample sees
# exactly the oracle's per-sample arithmetic in the oracle's order (combs summed
# in index order from 0.0, x0.25, allpass cascade), so the output is bit-identical
# to the per-sample chain (dhvani_reverb_run_chain) -- the reorder only removes
# the per-sample handle/accessor/bounds-check traffic. Steady state: 0 bytes.
#
# Hardening (deliberate divergences from the oracle, docs/decisions/005):
# - ReverbParams::validate rejects NaN, as the oracle's `(0.0..=1.0).contains`
#   does (an `x < 0 || x > 1` test lets NaN through: mix=NaN made every output 0).
# - Ring-store guard: a non-finite value is stored into a comb/allpass ring (and
#   the comb's damping state) as 0, so one NaN/Inf input sample costs that one
#   output sample instead of muting the channel -- dry path included -- until
#   reset() (the oracle latches it into the feedback forever).
# - Denormal flush: |x| < 1e-30 is stored as (signed) zero. Without it a silent
#   tail with high feedback and low damping (room 1.0 / damping 0.2) settles into
#   a permanent subnormal limit cycle (x * 0.95 rounds back to x at a few ulp),
#   which costs subnormal-arithmetic CPU forever.
# - A 0-channel buffer is a no-op (the oracle indexes samples[0] and panics).
# - Params are copied into instance-owned storage on new()/set_params (the oracle
#   moves them): mutating the caller's handle later cannot half-apply.

#derive(accessors)
struct DhReverbParams { room_size; damping; mix; }

#derive(accessors)
struct DhCombFilter { buffer; write_pos; feedback; damp; damp_state; }

#derive(accessors)
struct DhAllpassFilter { buffer; write_pos; }

#derive(accessors)
struct DhReverb { combs_l; combs_r; allpasses_l; allpasses_r; params; bypassed; scratch; }

# ring-store guard thresholds, on the f64 bit pattern with the sign cleared:
# >= +inf bits -> non-finite (store 0); < 1e-30 bits -> flush to signed zero.
var DH_RV_ABS_MASK   = 0x7FFFFFFFFFFFFFFF;
var DH_RV_INF_BITS   = 0x7FF0000000000000;
var DH_RV_FLUSH_BITS = 0x39B4484BFEEBC2A0;   # 1e-30

# ---- ReverbParams ----
#must_use
fn dhvani_reverbparams_new(room_size, damping, mix) {
    var p = alloc(sizeof(DhReverbParams));
    DhReverbParams_set_room_size(p, room_size);
    DhReverbParams_set_damping(p, damping);
    DhReverbParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_reverbparams_default() { return dhvani_reverbparams_new(0.5, 0.5, 0.3); }
# validate -- each of room_size / damping / mix in [0, 1]; NaN is rejected.
#must_use
fn dhvani_reverbparams_validate(p) {
    if (dh_in_range(DhReverbParams_room_size(p), 0, 1.0) == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhReverbParams_damping(p), 0, 1.0) == 0)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (dh_in_range(DhReverbParams_mix(p), 0, 1.0) == 0)       { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}
# copy every field of src into dst (no allocation).
fn dh_reverbparams_copy_into(dst, src) {
    DhReverbParams_set_room_size(dst, DhReverbParams_room_size(src));
    DhReverbParams_set_damping(dst, DhReverbParams_damping(src));
    DhReverbParams_set_mix(dst, DhReverbParams_mix(src));
    return 0;
}

# scale a base delay (@44100) to the target rate; min 1.
#must_use
fn dhvani_reverb_scale_delay(base, sample_rate) {
    var s = f64_to(f64_round_half_away(f64_div(f64_mul(f64_from(base), f64_from(sample_rate)), 44100.0)));
    if (s < 1) { s = 1; }
    return s;
}

# The ring-store guard (see header): non-finite -> 0, |x| < 1e-30 -> signed zero,
# anything else unchanged. The block loops below inline the same two compares.
#must_use
fn dh_reverb_guard(x) {
    var ab = x & DH_RV_ABS_MASK;
    if (ab < DH_RV_FLUSH_BITS) { return f64_mul(x, 0); }
    if (ab >= DH_RV_INF_BITS) { return 0; }
    return x;
}

# ---- CombFilter ----
#must_use
fn dhvani_comb_new(delay_samples) {
    var self = alloc(sizeof(DhCombFilter));
    var d = delay_samples;
    if (d < 1) { d = 1; }
    DhCombFilter_set_buffer(self, dh_vec_zeros(d));
    DhCombFilter_set_write_pos(self, 0);
    DhCombFilter_set_feedback(self, 0.5);
    DhCombFilter_set_damp(self, 0.5);
    DhCombFilter_set_damp_state(self, 0);
    return self;
}
# one sample through the comb (the per-sample form of dh_reverb_comb_block).
fn dhvani_comb_process(self, input) {
    var ring = DhCombFilter_buffer(self);
    var wp = DhCombFilter_write_pos(self);
    var output = vec_get(ring, wp);
    var damp = DhCombFilter_damp(self);
    var ds = DhCombFilter_damp_state(self);
    ds = dh_reverb_guard(f64_add(f64_mul(output, f64_sub(1.0, damp)), f64_mul(ds, damp)));
    DhCombFilter_set_damp_state(self, ds);
    vec_set(ring, wp, dh_reverb_guard(f64_add(input, f64_mul(ds, DhCombFilter_feedback(self)))));
    wp = wp + 1;
    if (wp >= vec_len(ring)) { wp = 0; }
    DhCombFilter_set_write_pos(self, wp);
    return output;
}
fn dhvani_comb_reset(self) {
    var ring = DhCombFilter_buffer(self);
    var p = dh_vec_data(ring);
    var end = p + vec_len(ring) * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    DhCombFilter_set_write_pos(self, 0);
    DhCombFilter_set_damp_state(self, 0);
    return 0;
}

# run one comb over an n-sample block: acc[i] += comb(in[i]), where the input
# walks `ip` with byte stride `stride` (one lane of an interleaved buffer).
fn dh_reverb_comb_block(comb, ip, stride, acc, n) {
    var ring = DhCombFilter_buffer(comb);
    var rd = dh_vec_data(ring);
    var rlen = vec_len(ring);
    var wp = DhCombFilter_write_pos(comb);
    var fb = DhCombFilter_feedback(comb);
    var damp = DhCombFilter_damp(comb);
    var omd = f64_sub(1.0, damp);
    var ds = DhCombFilter_damp_state(comb);
    var a = acc;
    var aend = acc + n * 8;
    var p = ip;
    while (a < aend) {
        var slot = rd + wp * 8;
        var output = load64(slot);
        # one-pole low-pass damping on the feedback, then the guarded ring store
        ds = f64_add(f64_mul(output, omd), f64_mul(ds, damp));
        var ab = ds & DH_RV_ABS_MASK;
        if (ab < DH_RV_FLUSH_BITS) { ds = f64_mul(ds, 0); } elif (ab >= DH_RV_INF_BITS) { ds = 0; }
        var v = f64_add(load64(p), f64_mul(ds, fb));
        ab = v & DH_RV_ABS_MASK;
        if (ab < DH_RV_FLUSH_BITS) { v = f64_mul(v, 0); } elif (ab >= DH_RV_INF_BITS) { v = 0; }
        store64(slot, v);
        wp = wp + 1;
        if (wp >= rlen) { wp = 0; }
        store64(a, f64_add(load64(a), output));
        p = p + stride;
        a = a + 8;
    }
    DhCombFilter_set_write_pos(comb, wp);
    DhCombFilter_set_damp_state(comb, ds);
    return 0;
}

# ---- AllpassFilter ----
#must_use
fn dhvani_allpass_new(delay_samples) {
    var self = alloc(sizeof(DhAllpassFilter));
    var d = delay_samples;
    if (d < 1) { d = 1; }
    DhAllpassFilter_set_buffer(self, dh_vec_zeros(d));
    DhAllpassFilter_set_write_pos(self, 0);
    return self;
}
# one sample through the allpass (the per-sample form of dh_reverb_allpass_block).
fn dhvani_allpass_process(self, input) {
    var ring = DhAllpassFilter_buffer(self);
    var wp = DhAllpassFilter_write_pos(self);
    var buffered = vec_get(ring, wp);
    vec_set(ring, wp, dh_reverb_guard(f64_add(input, f64_mul(buffered, 0.5))));
    wp = wp + 1;
    if (wp >= vec_len(ring)) { wp = 0; }
    DhAllpassFilter_set_write_pos(self, wp);
    return f64_add(f64_neg(input), buffered);
}
fn dhvani_allpass_reset(self) {
    var ring = DhAllpassFilter_buffer(self);
    var p = dh_vec_data(ring);
    var end = p + vec_len(ring) * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    DhAllpassFilter_set_write_pos(self, 0);
    return 0;
}

# run one allpass over an n-sample row in place: x[i] = allpass(x[i]).
fn dh_reverb_allpass_block(ap, x, n) {
    var ring = DhAllpassFilter_buffer(ap);
    var rd = dh_vec_data(ring);
    var rlen = vec_len(ring);
    var wp = DhAllpassFilter_write_pos(ap);
    var a = x;
    var aend = x + n * 8;
    while (a < aend) {
        var input = load64(a);
        var slot = rd + wp * 8;
        var buffered = load64(slot);
        var v = f64_add(input, f64_mul(buffered, 0.5));
        var ab = v & DH_RV_ABS_MASK;
        if (ab < DH_RV_FLUSH_BITS) { v = f64_mul(v, 0); } elif (ab >= DH_RV_INF_BITS) { v = 0; }
        store64(slot, v);
        wp = wp + 1;
        if (wp >= rlen) { wp = 0; }
        store64(a, f64_add(f64_neg(input), buffered));
        a = a + 8;
    }
    DhAllpassFilter_set_write_pos(ap, wp);
    return 0;
}

# ---- Reverb ----
# run one channel's chain for ONE sample: sum 4 combs (x0.25) -> cascade allpasses.
# The per-sample reference form of dh_reverb_lane (kept public; the block path is
# bit-identical to it).
#must_use
fn dhvani_reverb_run_chain(combs, allpasses, input) {
    var comb_sum = 0;
    var nc = vec_len(combs); var i = 0;
    while (i < nc) { comb_sum = f64_add(comb_sum, dhvani_comb_process(vec_get(combs, i), input)); i = i + 1; }
    comb_sum = f64_mul(comb_sum, 0.25);
    var out = comb_sum;
    var na = vec_len(allpasses); var j = 0;
    while (j < na) { out = dhvani_allpass_process(vec_get(allpasses, j), out); j = j + 1; }
    return out;
}

# one lane of an n-frame block: in/out walk `ip` with byte stride `stride`; `acc`
# is >= n f64 slots of scratch. Combs -> x0.25 -> allpass cascade -> dry/wet mix.
fn dh_reverb_lane(combs, allpasses, ip, stride, acc, n, dry, mix) {
    var aend = acc + n * 8;
    var a = acc;
    while (a < aend) { store64(a, 0); a = a + 8; }
    var nc = vec_len(combs);
    var cd = dh_vec_data(combs);
    var i = 0;
    while (i < nc) { dh_reverb_comb_block(load64(cd + i * 8), ip, stride, acc, n); i = i + 1; }
    a = acc;
    while (a < aend) { store64(a, f64_mul(load64(a), 0.25)); a = a + 8; }
    var na = vec_len(allpasses);
    var ad = dh_vec_data(allpasses);
    var j = 0;
    while (j < na) { dh_reverb_allpass_block(load64(ad + j * 8), acc, n); j = j + 1; }
    a = acc;
    var p = ip;
    while (a < aend) {
        var out = f64_add(f64_mul(load64(p), dry), f64_mul(load64(a), mix));
        if (dhvani_is_finite(out) == 0) { out = 0; }
        store64(p, out);
        p = p + stride;
        a = a + 8;
    }
    return 0;
}

fn dhvani_reverb_set_combs_fd(combs, feedback, damp) {
    var n = vec_len(combs); var i = 0;
    while (i < n) {
        var comb = vec_get(combs, i);
        DhCombFilter_set_feedback(comb, feedback);
        DhCombFilter_set_damp(comb, damp);
        i = i + 1;
    }
    return 0;
}
fn dhvani_reverb_update_params(self, params) {
    var feedback = f64_add(f64_mul(f64_clamp(DhReverbParams_room_size(params), 0, 1.0), 0.9), 0.05);
    var damp = f64_clamp(DhReverbParams_damping(params), 0, 1.0);
    dhvani_reverb_set_combs_fd(DhReverb_combs_l(self), feedback, damp);
    dhvani_reverb_set_combs_fd(DhReverb_combs_r(self), feedback, damp);
    return 0;
}

# new(params, sample_rate) -- handle, or 0 if params invalid. The params are
# copied; the caller keeps ownership of its handle.
#must_use
fn dhvani_reverb_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_reverbparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhReverb));
    var cd = vec_new(); vec_push(cd, 1557); vec_push(cd, 1617); vec_push(cd, 1491); vec_push(cd, 1422);
    var combs_l = vec_new();
    var combs_r = vec_new();
    var i = 0;
    while (i < 4) {
        vec_push(combs_l, dhvani_comb_new(dhvani_reverb_scale_delay(vec_get(cd, i), sample_rate)));
        vec_push(combs_r, dhvani_comb_new(dhvani_reverb_scale_delay(vec_get(cd, i) + 23, sample_rate)));
        i = i + 1;
    }
    var ad = vec_new(); vec_push(ad, 225); vec_push(ad, 556);
    var allpasses_l = vec_new();
    var allpasses_r = vec_new();
    var j = 0;
    while (j < 2) {
        vec_push(allpasses_l, dhvani_allpass_new(dhvani_reverb_scale_delay(vec_get(ad, j), sample_rate)));
        vec_push(allpasses_r, dhvani_allpass_new(dhvani_reverb_scale_delay(vec_get(ad, j) + 23, sample_rate)));
        j = j + 1;
    }
    var own = alloc(sizeof(DhReverbParams));
    dh_reverbparams_copy_into(own, params);
    DhReverb_set_combs_l(self, combs_l);
    DhReverb_set_combs_r(self, combs_r);
    DhReverb_set_allpasses_l(self, allpasses_l);
    DhReverb_set_allpasses_r(self, allpasses_r);
    DhReverb_set_params(self, own);
    DhReverb_set_bypassed(self, 0);
    DhReverb_set_scratch(self, vec_new());
    dhvani_reverb_update_params(self, own);
    return self;
}

# process(buf) -- in place. Mono runs the left path; stereo and wider buffers run
# L/R decorrelated paths on channels 0/1 and pass the rest through unchanged.
fn dhvani_reverb_process(self, buf) {
    if (DhReverb_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 1) { return 0; }
    var samples = DhAudioBuffer_samples(buf);
    # never walk past the storage, whatever `frames` claims
    var frames = dh_imin(DhAudioBuffer_frames(buf), vec_len(samples) / ch);
    if (frames < 1) { return 0; }
    var mix = DhReverbParams_mix(DhReverb_params(self));
    var dry = f64_sub(1.0, mix);
    # grow-only scratch row (allocates only past the largest block seen)
    var scratch = DhReverb_scratch(self);
    if (vec_cap(scratch) < frames) {
        scratch = dh_vec_zeros(frames);
        DhReverb_set_scratch(self, scratch);
    }
    var acc = dh_vec_data(scratch);
    var d = dh_vec_data(samples);
    if (ch == 1) {
        dh_reverb_lane(DhReverb_combs_l(self), DhReverb_allpasses_l(self), d, 8, acc, frames, dry, mix);
    } else {
        var stride = ch * 8;
        dh_reverb_lane(DhReverb_combs_l(self), DhReverb_allpasses_l(self), d, stride, acc, frames, dry, mix);
        dh_reverb_lane(DhReverb_combs_r(self), DhReverb_allpasses_r(self), d + 8, stride, acc, frames, dry, mix);
    }
    return 0;
}

fn dhvani_reverb_set_bypass(self, bypassed) { DhReverb_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_reverb_is_bypassed(self) { if (DhReverb_bypassed(self) == 1) { return 1; } return 0; }

# set_params(params) -- validate, then copy into the owned params; error code on
# invalid (nothing changes then).
fn dhvani_reverb_set_params(self, params) {
    var rc = dhvani_reverbparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dh_reverbparams_copy_into(DhReverb_params(self), params);
    dhvani_reverb_update_params(self, DhReverb_params(self));
    return DHVANI_ERR_NONE;
}

# set_sample_rate(sample_rate) -- rebuild the delay lines for the new rate. This
# reallocates the rings: call it on session changes, not per buffer.
fn dhvani_reverb_set_sample_rate(self, sample_rate) {
    var was_bypassed = DhReverb_bypassed(self);
    var fresh = dhvani_reverb_new(DhReverb_params(self), sample_rate);
    if (fresh != 0) {
        DhReverb_set_combs_l(self, DhReverb_combs_l(fresh));
        DhReverb_set_combs_r(self, DhReverb_combs_r(fresh));
        DhReverb_set_allpasses_l(self, DhReverb_allpasses_l(fresh));
        DhReverb_set_allpasses_r(self, DhReverb_allpasses_r(fresh));
    }
    DhReverb_set_bypassed(self, was_bypassed);
    return 0;
}

fn dhvani_reverb_reset_combs(combs) {
    var n = vec_len(combs); var i = 0;
    while (i < n) { dhvani_comb_reset(vec_get(combs, i)); i = i + 1; }
    return 0;
}
fn dhvani_reverb_reset_allpasses(aps) {
    var n = vec_len(aps); var i = 0;
    while (i < n) { dhvani_allpass_reset(vec_get(aps, i)); i = i + 1; }
    return 0;
}
fn dhvani_reverb_reset(self) {
    dhvani_reverb_reset_combs(DhReverb_combs_l(self));
    dhvani_reverb_reset_combs(DhReverb_combs_r(self));
    dhvani_reverb_reset_allpasses(DhReverb_allpasses_l(self));
    dhvani_reverb_reset_allpasses(DhReverb_allpasses_r(self));
    return 0;
}

# --- analysis.cyr ---

# analysis.cyr -- Spectrum type + DFT + loudness/silence/gain helpers.
# Ports the OWN code of rust-old/src/analysis/mod.rs (the per-submodule facade
# re-exports are implicit in the flat bundle). L1: deps error + simd + buffer +
# abaco (amplitude_to_db). Spectrum consumed by fft.cyr (spectrum_fft) too.
# log10(x) = ln(x)/ln(10) (no f64_log10 in stdlib).

#derive(accessors)
struct DhSpectrum {
    magnitudes;
    magnitude_db;
    freq_resolution;
    sample_rate;
    fft_size;
    peak_frequency;
    peak_magnitude_db;
}

#must_use
fn dh_log10(x) { return f64_div(f64_ln(x), F64_LN10); }

# from_magnitudes(magnitudes, freq_resolution, sample_rate, fft_size) -> Spectrum.
#must_use
fn dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, sample_rate, fft_size) {
    var n = vec_len(magnitudes);
    var magnitude_db = dh_vec_zeros(n);
    # Peak bin as the oracle's `max_by(partial_cmp().unwrap_or(Equal))`: the fold
    # starts from bin 0 and moves to bin i unless the running peak is strictly
    # greater, so the LAST of equal maxima wins (silence -> bin n-1), and a NaN
    # compares Equal (it is taken, and the next bin replaces it). (0, 0.0) if empty.
    var peak_idx = 0;
    var peak_mag = 0;
    if (n > 0) { peak_mag = vec_get(magnitudes, 0); }
    var i = 0;
    while (i < n) {
        var m = vec_get(magnitudes, i);
        if (f64_gt(m, 0.0000000001) == 1) { vec_set(magnitude_db, i, f64_mul(20.0, dh_log10(m))); }
        else { vec_set(magnitude_db, i, f64_neg(200.0)); }
        if (i > 0) {
            if (f64_gt(peak_mag, m) == 0) { peak_mag = m; peak_idx = i; }
        }
        i = i + 1;
    }
    var peak_magnitude_db = f64_neg(200.0);
    if (f64_gt(peak_mag, 0.0000000001) == 1) { peak_magnitude_db = f64_mul(20.0, dh_log10(peak_mag)); }
    var self = alloc(sizeof(DhSpectrum));
    DhSpectrum_set_magnitudes(self, magnitudes);
    DhSpectrum_set_magnitude_db(self, magnitude_db);
    DhSpectrum_set_freq_resolution(self, freq_resolution);
    DhSpectrum_set_sample_rate(self, sample_rate);
    DhSpectrum_set_fft_size(self, fft_size);
    DhSpectrum_set_peak_frequency(self, f64_mul(f64_from(peak_idx), freq_resolution));
    DhSpectrum_set_peak_magnitude_db(self, peak_magnitude_db);
    return self;
}

#inline
#must_use
fn dhvani_spectrum_magnitudes(self) { return DhSpectrum_magnitudes(self); }
#inline
#must_use
fn dhvani_spectrum_freq_resolution(self) { return DhSpectrum_freq_resolution(self); }
#inline
#must_use
fn dhvani_spectrum_bin_count(self) { return vec_len(DhSpectrum_magnitudes(self)); }
#must_use
fn dhvani_spectrum_bin_frequency(self, bin) { return f64_mul(f64_from(bin), DhSpectrum_freq_resolution(self)); }
# magnitude at bin k.
#must_use
fn dhvani_spectrum_magnitude(self, k) { return vec_get(DhSpectrum_magnitudes(self), k); }
# dominant frequency (peak bin frequency). The oracle's Option: None only for an
# empty spectrum (bin_count 0), where this returns 0.0 -- check bin_count to tell
# that apart from a DC peak. Ties go to the LAST bin (silence -> (n-1) * fr).
#must_use
fn dhvani_spectrum_dominant_frequency(self) { return DhSpectrum_peak_frequency(self); }

# spectral centroid — magnitude-weighted mean frequency; 0.0 for silence.
#must_use
fn dhvani_spectrum_spectral_centroid(self) {
    var mags = DhSpectrum_magnitudes(self);
    var fr = DhSpectrum_freq_resolution(self);
    var n = vec_len(mags);
    var total = 0;
    var i = 0;
    while (i < n) { total = f64_add(total, vec_get(mags, i)); i = i + 1; }
    if (f64_le(total, 0) == 1) { return 0; }
    var weighted = 0;
    var j = 0;
    while (j < n) { weighted = f64_add(weighted, f64_mul(f64_mul(f64_from(j), fr), vec_get(mags, j))); j = j + 1; }
    return f64_div(weighted, total);
}

# spectral rolloff — frequency below which `threshold` fraction of energy sits.
#must_use
fn dhvani_spectrum_spectral_rolloff(self, threshold) {
    var mags = DhSpectrum_magnitudes(self);
    var fr = DhSpectrum_freq_resolution(self);
    var n = vec_len(mags);
    var total_energy = 0;
    var i = 0;
    while (i < n) { var m = vec_get(mags, i); total_energy = f64_add(total_energy, f64_mul(m, m)); i = i + 1; }
    if (f64_le(total_energy, 0) == 1) { return 0; }
    var target = f64_mul(total_energy, f64_clamp(threshold, 0, 1.0));
    var cumulative = 0;
    var k = 0;
    while (k < n) {
        var mm = vec_get(mags, k);
        cumulative = f64_add(cumulative, f64_mul(mm, mm));
        if (f64_ge(cumulative, target) == 1) { return f64_mul(f64_from(k), fr); }
        k = k + 1;
    }
    return f64_mul(f64_from(n), fr);
}

# spectrum_dft(buf, window_size) -- O(n^2) DFT magnitude spectrum, or 0 on error.
#must_use
fn dhvani_analysis_spectrum_dft(buf, window_size) {
    var samples = DhAudioBuffer_samples(buf);
    var slen = vec_len(samples);
    if (slen == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }
    var n = window_size;
    if (slen < window_size) { n = slen; }
    var num_bins = n / 2;
    var magnitudes = dh_vec_zeros(num_bins);
    var k = 0;
    while (k < num_bins) {
        var re = 0;
        var im = 0;
        var i = 0;
        while (i < n) {
            var angle = f64_div(f64_mul(f64_mul(f64_mul(f64_neg(2.0), F64_PI), f64_from(k)), f64_from(i)), f64_from(n));
            var s = vec_get(samples, i);
            re = f64_add(re, f64_mul(s, f64_cos(angle)));
            im = f64_add(im, f64_mul(s, f64_sin(angle)));
            i = i + 1;
        }
        vec_set(magnitudes, k, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(n)));
        k = k + 1;
    }
    dhvani_analysis_normalize(magnitudes, num_bins);
    var freq_resolution = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(n));
    return dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, DhAudioBuffer_sample_rate(buf), n);
}

# normalize magnitudes to 0..1 by the peak (shared by DFT + FFT).
fn dhvani_analysis_normalize(magnitudes, num_bins) {
    var max = 0;
    var m = 0;
    while (m < num_bins) { max = dh_max_ignore_nan(max, vec_get(magnitudes, m)); m = m + 1; }
    if (f64_gt(max, 0) == 1) {
        var p = 0;
        while (p < num_bins) { vec_set(magnitudes, p, f64_div(vec_get(magnitudes, p), max)); p = p + 1; }
    }
    return 0;
}

# loudness_lufs(buf) -- simplified EBU R128; -inf for empty/silence.
#must_use
fn dhvani_analysis_loudness_lufs(buf) {
    var samples = DhAudioBuffer_samples(buf);
    var len = vec_len(samples);
    if (len == 0) { return DH_NEG_INF; }
    var sum = 0;
    var i = 0;
    while (i < len) { var s = vec_get(samples, i); sum = f64_add(sum, f64_mul(s, s)); i = i + 1; }
    var mean_sq = f64_div(sum, f64_from(len));
    if (f64_le(mean_sq, 0) == 1) { return DH_NEG_INF; }
    return f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_sq)));
}

# is_silent(buf, threshold_db) -- peak dB below threshold.
#must_use
fn dhvani_analysis_is_silent(buf, threshold_db) {
    if (f64_lt(amplitude_to_db(dhvani_buffer_peak(buf)), threshold_db) == 1) { return 1; }
    return 0;
}

# suggest_gain(buf, target_rms) -- linear gain clamped to [0.1, 10.0]; 1.0 for silence.
#must_use
fn dhvani_analysis_suggest_gain(buf, target_rms) {
    var rms = dhvani_buffer_rms(buf);
    if (f64_lt(rms, 0.000001) == 1) { return 1.0; }
    return f64_clamp(f64_div(target_rms, rms), 0.1, 10.0);
}

# --- fft.cyr ---

# fft.cyr -- radix-2 Cooley-Tukey FFT + windowed magnitude spectrum.
# Ports rust-old/src/analysis/fft.rs. L1: deps error + simd + buffer + analysis
# (Spectrum). fft_in_place operates on two f64 `vec`s (real, imag) in place.

# Largest window the analysis entry points accept (spectrum_fft, and through it
# chroma/key; stft). rust-old had no cap -- a huge window_size just allocated
# window_size f64s even for a 10-sample buffer; here that would abort in the vec
# layer (or allocate gigabytes the bump allocator never gives back), so the entry
# points return 0 instead. 2^24 = 16.7M points, far past any analysis window.
var DH_MAX_FFT = 0x1000000;

# smallest power of two >= v (v >= 1). Ports usize::next_power_of_two. Returns 0
# when v > 2^62: the next power would be 2^63, which is not a positive i64 (the
# doubling loop wrapped to i64::MIN, then 0, and never terminated).
#must_use
fn dh_next_pow2(v) {
    if (v > 0x4000000000000000) { return 0; }
    var p = 1;
    while (p < v) { p = p << 1; }
    return p;
}
# 1 if n is a power of two (n > 0), else 0.
#must_use
fn dh_is_pow2(n) {
    if (n <= 0) { return 0; }
    if ((n & (n - 1)) == 0) { return 1; }
    return 0;
}

# ---- twiddle tables ----
# The butterflies' (cos, sin) pairs depend only on the size: stage `len` (half =
# len/2) walks angle = 0, +step, +step, ... with step = -2*pi/len, ACCUMULATED by
# f64_add exactly as the per-butterfly loop did, so a table entry is bit-for-bit
# the value that loop computed (dhvani_fft_in_place_scalar is that loop, kept as
# the oracle). One table per size holds every stage: entry (half - 1) + k of
# [cos | sin] for k < half, n - 1 entries each, 16 (n - 1) bytes in all.
# Built once per size and kept (the bump allocator would leak a per-call table).
# Cached up to 2^16 points (1 MB for that size, ~2 MB for every size below it);
# a larger transform evaluates cos/sin in the stage loop instead.
var DH_FFT_TW_CACHE_MAX = 0x10000;
var dh_fft_tw_tab[136];      # 17 slots: log2(n) -> table pointer (0 = not built)
var dh_fft_tw_ready = 0;

#must_use
fn dh_fft_build_twiddles(n) {
    var cnt = n - 1;
    var tw = alloc(cnt * 16);
    if (tw == 0) { return 0; }
    var tws = tw + cnt * 8;
    var len = 2;
    while (len <= n) {
        var half = len / 2;
        var base = half - 1;
        var angle_step = f64_div(f64_mul(f64_neg(2.0), F64_PI), f64_from(len));
        var angle = 0;
        var k = 0;
        while (k < half) {
            store64(tw + (base + k) * 8, f64_cos(angle));
            store64(tws + (base + k) * 8, f64_sin(angle));
            angle = f64_add(angle, angle_step);
            k = k + 1;
        }
        len = len << 1;
    }
    return tw;
}

# the cached table for power-of-two n (2 <= n <= DH_FFT_TW_CACHE_MAX), or 0.
#must_use
fn dh_fft_twiddles(n) {
    if (n < 2) { return 0; }
    if (n > DH_FFT_TW_CACHE_MAX) { return 0; }
    if (dh_fft_tw_ready == 0) {
        var z = 0;
        while (z < 17) { store64(&dh_fft_tw_tab + z * 8, 0); z = z + 1; }
        dh_fft_tw_ready = 1;
    }
    var slot = 0;
    var p = 1;
    while (p < n) { p = p << 1; slot = slot + 1; }
    var tw = load64(&dh_fft_tw_tab + slot * 8);
    if (tw == 0) {
        tw = dh_fft_build_twiddles(n);
        # published only once filled, so a racing caller sees 0 or a full table
        store64(&dh_fft_tw_tab + slot * 8, tw);
    }
    return tw;
}

# bit-reversal permutation of re/im (raw f64 storage, n elements).
fn dh_fft_bitrev(re, im, n) {
    var j = 0;
    var i = 0;
    while (i < n) {
        if (i < j) {
            var pa = re + i * 8;
            var pb = re + j * 8;
            var tr0 = load64(pa); store64(pa, load64(pb)); store64(pb, tr0);
            var qa = im + i * 8;
            var qb = im + j * 8;
            var ti0 = load64(qa); store64(qa, load64(qb)); store64(qb, ti0);
        }
        var m = n >> 1;
        var cont = 1;
        while (cont == 1) {
            if (m >= 1) {
                if (j >= m) { j = j - m; m = m >> 1; } else { cont = 0; }
            } else { cont = 0; }
        }
        j = j + m;
        i = i + 1;
    }
    return 0;
}

# butterfly stages over raw storage. tw = a dh_fft_twiddles table for n, or 0 to
# evaluate cos/sin per butterfly (same accumulated angle, same bits).
fn dh_fft_stages(re, im, n, tw) {
    var tws = tw + (n - 1) * 8;
    var len = 2;
    while (len <= n) {
        var half = len / 2;
        var hb = half * 8;
        var tc = tw + (half - 1) * 8;
        var ts = tws + (half - 1) * 8;
        var angle_step = f64_div(f64_mul(f64_neg(2.0), F64_PI), f64_from(len));
        var start = 0;
        while (start < n) {
            var pr = re + start * 8;
            var pi = im + start * 8;
            var angle = 0;
            var k = 0;
            while (k < half) {
                var cos_a = 0;
                var sin_a = 0;
                if (tw != 0) {
                    cos_a = load64(tc + k * 8);
                    sin_a = load64(ts + k * 8);
                } else {
                    cos_a = f64_cos(angle);
                    sin_a = f64_sin(angle);
                    angle = f64_add(angle, angle_step);
                }
                var pri = pr + k * 8;
                var prj = pri + hb;
                var pii = pi + k * 8;
                var pij = pii + hb;
                var rj = load64(prj);
                var ij = load64(pij);
                var tr = f64_sub(f64_mul(rj, cos_a), f64_mul(ij, sin_a));
                var ti = f64_add(f64_mul(rj, sin_a), f64_mul(ij, cos_a));
                var ri = load64(pri);
                var iiv = load64(pii);
                store64(prj, f64_sub(ri, tr));
                store64(pij, f64_sub(iiv, ti));
                store64(pri, f64_add(ri, tr));
                store64(pii, f64_add(iiv, ti));
                k = k + 1;
            }
            start = start + len;
        }
        len = len << 1;
    }
    return 0;
}

# in-place radix-2 FFT on parallel real/imag vecs. Returns 1 on success, 0 if
# length is not a power of two / mismatched / zero. Allocation-free after the
# first call at a given size (which builds that size's twiddle table).
fn dhvani_fft_in_place(real, imag) {
    var n = vec_len(real);
    if (dh_is_pow2(n) == 0) { return 0; }
    if (n != vec_len(imag)) { return 0; }
    var re = dh_vec_data(real);
    var im = dh_vec_data(imag);
    dh_fft_bitrev(re, im, n);
    dh_fft_stages(re, im, n, dh_fft_twiddles(n));
    return 1;
}

# The pre-2.3.2 dhvani_fft_in_place, verbatim (per-butterfly cos/sin, vec
# accessors): the bit-exactness oracle the table-driven transform is tested
# against. Same contract.
fn dhvani_fft_in_place_scalar(real, imag) {
    var n = vec_len(real);
    if (dh_is_pow2(n) == 0) { return 0; }
    if (n != vec_len(imag)) { return 0; }
    # bit-reversal permutation
    var j = 0;
    var i = 0;
    while (i < n) {
        if (i < j) {
            var tr0 = vec_get(real, i); vec_set(real, i, vec_get(real, j)); vec_set(real, j, tr0);
            var ti0 = vec_get(imag, i); vec_set(imag, i, vec_get(imag, j)); vec_set(imag, j, ti0);
        }
        var m = n >> 1;
        var cont = 1;
        while (cont == 1) {
            if (m >= 1) {
                if (j >= m) { j = j - m; m = m >> 1; } else { cont = 0; }
            } else { cont = 0; }
        }
        j = j + m;
        i = i + 1;
    }
    # butterfly stages
    var len = 2;
    while (len <= n) {
        var half = len / 2;
        var angle_step = f64_div(f64_mul(f64_neg(2.0), F64_PI), f64_from(len));
        var start = 0;
        while (start < n) {
            var angle = 0;
            var k = 0;
            while (k < half) {
                var cos_a = f64_cos(angle);
                var sin_a = f64_sin(angle);
                var ii = start + k;
                var jj = start + k + half;
                var rj = vec_get(real, jj);
                var ij = vec_get(imag, jj);
                var tr = f64_sub(f64_mul(rj, cos_a), f64_mul(ij, sin_a));
                var ti = f64_add(f64_mul(rj, sin_a), f64_mul(ij, cos_a));
                var ri = vec_get(real, ii);
                var iiv = vec_get(imag, ii);
                vec_set(real, jj, f64_sub(ri, tr));
                vec_set(imag, jj, f64_sub(iiv, ti));
                vec_set(real, ii, f64_add(ri, tr));
                vec_set(imag, ii, f64_add(iiv, ti));
                angle = f64_add(angle, angle_step);
                k = k + 1;
            }
            start = start + len;
        }
        len = len << 1;
    }
    return 1;
}

# spectrum_fft(buf, window_size) -- Hann-windowed radix-2 FFT magnitude
# spectrum; window_size rounded DOWN to a power of two (>=2). 0 on error:
# empty buffer, zero channels, or window_size > DH_MAX_FFT.
#must_use
fn dhvani_fft_spectrum(buf, window_size) {
    var samples = DhAudioBuffer_samples(buf);
    var slen = vec_len(samples);
    if (slen == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }
    if (window_size > DH_MAX_FFT) { return 0; }
    var ws = window_size;
    if (dh_is_pow2(ws) == 0) { ws = dh_next_pow2(ws) >> 1; }
    if (ws < 2) { ws = 2; }
    var n = ws;
    if (slen < ws) { n = slen; }
    var num_bins = ws / 2;
    var real = dh_vec_zeros(ws);
    var imag = dh_vec_zeros(ws);
    if (vec_len(real) != ws) { return 0; }
    if (vec_len(imag) != ws) { return 0; }
    var denom = n - 1;
    if (denom < 1) { denom = 1; }
    var sd = dh_vec_data(samples);
    var rd = dh_vec_data(real);
    var i = 0;
    while (i < n) {
        var window = f64_mul(
          0.5,
          f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), f64_from(denom)))));
        store64(rd + i * 8, f64_mul(load64(sd + i * 8), window));
        i = i + 1;
    }
    var freq_resolution = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(ws));
    if (dhvani_fft_in_place(real, imag) == 0) { return 0; }
    var magnitudes = dh_vec_zeros(num_bins);
    var id = dh_vec_data(imag);
    var md = dh_vec_data(magnitudes);
    var k = 0;
    while (k < num_bins) {
        var re = load64(rd + k * 8);
        var im = load64(id + k * 8);
        store64(md + k * 8, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(ws)));
        k = k + 1;
    }
    dhvani_analysis_normalize(magnitudes, num_bins);
    return dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, DhAudioBuffer_sample_rate(buf), ws);
}

# --- loudness.cyr ---

# loudness.cyr -- EBU R128 loudness: K-weighting + gated LUFS.
# Ports rust-old/src/analysis/loudness.rs. L2: deps error + simd + buffer +
# biquad + abaco. K-weighting = HighShelf(1681Hz,+4dB,Q0.707) cascaded with
# HighPass(38Hz,Q0.5), built via dhvani_biquad_new. measure_r128 -> a
# R128Loudness handle, or 0 (null) on error (empty buffer / zero channels).
#
# FLOAT NOTES: negative float constants (-70, -10, -0.691) go through f64_neg.
# The Rust f32::NEG_INFINITY sentinel maps to DH_NEG_INF (error.cyr).
# 10.0.powf(lufs/10) has a positive base so f64_pow is safe. log10 via dh_log10
# (analysis.cyr). The 400ms block / 100ms hop counts are integer sample counts.

#derive(accessors)
struct DhR128Loudness { integrated_lufs; range_lu; short_term_lufs; momentary_lufs; }

# --- R128Loudness accessors (was impl getters) ---
#inline
#must_use
fn dhvani_r128_integrated_lufs(self) { return DhR128Loudness_integrated_lufs(self); }
#inline
#must_use
fn dhvani_r128_range_lu(self) { return DhR128Loudness_range_lu(self); }
#inline
#must_use
fn dhvani_r128_short_term_lufs(self) { return DhR128Loudness_short_term_lufs(self); }
#inline
#must_use
fn dhvani_r128_momentary_lufs(self) { return DhR128Loudness_momentary_lufs(self); }

# construct an R128Loudness handle.
#must_use
fn dhvani_r128_new(integrated_lufs, range_lu, short_term_lufs, momentary_lufs) {
    var self = alloc(sizeof(DhR128Loudness));
    DhR128Loudness_set_integrated_lufs(self, integrated_lufs);
    DhR128Loudness_set_range_lu(self, range_lu);
    DhR128Loudness_set_short_term_lufs(self, short_term_lufs);
    DhR128Loudness_set_momentary_lufs(self, momentary_lufs);
    return self;
}

# Apply K-weighting filter -- returns a new `vec` of filtered samples.
# Stage 1: HighShelf at 1681 Hz, +4 dB, Q=0.707. Stage 2: HighPass at 38 Hz,
# Q=0.5. The oracle applies both per-sample (shelf then HP) with per-channel
# state; a cascade of two LTI biquads is order-invariant across the pass, so we
# process the whole buffer through the shelf then through the HP (identical
# output). Works on a cloned buffer so the input is untouched.
#must_use
fn dhvani_loudness_apply_k_weighting(buf) {
    var sr = DhAudioBuffer_sample_rate(buf);
    var ch = DhAudioBuffer_channels(buf);
    var work = dhvani_buffer_clone(buf);
    # Stage 1: High shelf at ~1681 Hz, +4 dB (pre-emphasis for head acoustics)
    var shelf = dhvani_biquad_new(DH_BQ_HIGHSHELF, 4.0, 1681.0, 0.707, sr, ch);
    dhvani_biquad_process(shelf, work);
    # Stage 2: High pass at ~38 Hz (remove DC and sub-bass)
    var hp = dhvani_biquad_new(DH_BQ_HIGHPASS, 0, 38.0, 0.5, sr, ch);
    dhvani_biquad_process(hp, work);
    return DhAudioBuffer_samples(work);
}

# Average block LUFS values in the linear power domain per EBU R128.
# mean_power = mean(10^(lufs/10)); -inf if empty or non-positive power.
#must_use
fn dhvani_loudness_lufs_from_blocks(blocks) {
    var n = vec_len(blocks);
    if (n == 0) { return DH_NEG_INF; }
    var sum = 0;
    var i = 0;
    while (i < n) {
        var lufs = vec_get(blocks, i);
        sum = f64_add(sum, f64_pow(10.0, f64_div(lufs, 10.0)));
        i = i + 1;
    }
    var mean_power = f64_div(sum, f64_from(n));
    if (f64_gt(mean_power, 0) == 1) {
        return f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_power)));
    }
    return DH_NEG_INF;
}

# three-way f64 comparator for vec_sort_by: partial_cmp().unwrap_or(Equal), so a
# NaN compares Equal (block loudness values are finite or +/-inf in practice).
#must_use
fn dh_loudness_cmp_asc(a, b) {
    if (f64_lt(a, b) == 1) { return 0 - 1; }
    if (f64_gt(a, b) == 1) { return 1; }
    return 0;
}

# ascending in-place sort of a `vec` of f64 (the oracle's sort_by(partial_cmp)).
# vec_sort_by: introsort, O(n log n), O(n) on already-ordered input, no scratch
# allocation. (Was an O(n^2) insertion sort: ~1.2 s for 30 min of 100 ms blocks.)
# Equal-comparing block values are bit-identical, so the order -- and every
# percentile read from it -- matches the stable sort it replaced.
fn dhvani_loudness_sort_asc(v) {
    vec_sort_by(v, &dh_loudness_cmp_asc);
    return 0;
}

# Compute Loudness Range (LRA): p95 - p10 of sorted gated blocks. 0.0 if <2.
#must_use
fn dhvani_loudness_compute_lra(blocks) {
    var n = vec_len(blocks);
    if (n < 2) { return 0; }
    var sorted = dh_vec_copy(blocks);
    if (vec_len(sorted) != n) { return 0; }
    dhvani_loudness_sort_asc(sorted);
    var nf = f64_from(n);
    var idx10 = f64_to(f64_mul(nf, 0.1));
    var idx95 = f64_to(f64_min(f64_mul(nf, 0.95), f64_sub(nf, 1.0)));
    var p10 = vec_get(sorted, idx10);
    var p95 = vec_get(sorted, idx95);
    return f64_sub(p95, p10);
}

# Measure EBU R128 integrated loudness. Returns an R128Loudness handle, or 0
# (null) on error (empty buffer / zero channels).
#must_use
fn dhvani_loudness_measure_r128(buf) {
    var samples = DhAudioBuffer_samples(buf);
    if (vec_len(samples) == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }

    var sr = DhAudioBuffer_sample_rate(buf);
    var ch = DhAudioBuffer_channels(buf);

    # Step 1: Apply K-weighting filter
    var filtered = dhvani_loudness_apply_k_weighting(buf);

    # Step 2: mean square per 400ms block (75% overlap = 100ms hop)
    var block_samples = f64_to(f64_mul(f64_from(sr), 0.4));
    var hop_samples = f64_to(f64_mul(f64_from(sr), 0.1));
    if (block_samples < 1) { block_samples = 1; }
    if (hop_samples < 1) { hop_samples = 1; }

    var block_loudness = vec_new();
    var frames = DhAudioBuffer_frames(buf);
    var pos = 0;
    while ((pos + block_samples) <= frames) {
        var mean_sq = 0;
        var count = 0;
        var frame = pos;
        while (frame < (pos + block_samples)) {
            var c = 0;
            while (c < ch) {
                var sv = vec_get(filtered, frame * ch + c);
                mean_sq = f64_add(mean_sq, f64_mul(sv, sv));
                count = count + 1;
                c = c + 1;
            }
            frame = frame + 1;
        }
        if (count > 0) { mean_sq = f64_div(mean_sq, f64_from(count)); }
        var lufs = DH_NEG_INF;
        if (f64_gt(mean_sq, 0) == 1) {
            lufs = f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_sq)));
        }
        vec_push(block_loudness, lufs);
        pos = pos + hop_samples;
    }

    var nblocks = vec_len(block_loudness);
    if (nblocks == 0) {
        return dhvani_r128_new(DH_NEG_INF, 0, DH_NEG_INF, DH_NEG_INF);
    }

    # Step 3: Absolute gate at -70 LUFS
    var neg70 = f64_neg(70.0);
    var above_abs_gate = vec_new();
    var a = 0;
    while (a < nblocks) {
        var la = vec_get(block_loudness, a);
        if (f64_gt(la, neg70) == 1) { vec_push(above_abs_gate, la); }
        a = a + 1;
    }

    var last_block = vec_get(block_loudness, nblocks - 1);
    if (vec_len(above_abs_gate) == 0) {
        return dhvani_r128_new(DH_NEG_INF, 0, last_block, last_block);
    }

    # Ungated loudness (above absolute gate) -- linear power domain mean.
    var ungated_lufs = dhvani_loudness_lufs_from_blocks(above_abs_gate);

    # Step 4: Relative gate at ungated - 10 LU
    var relative_threshold = f64_sub(ungated_lufs, 10.0);
    var above_rel_gate = vec_new();
    var r = 0;
    var nabs = vec_len(above_abs_gate);
    while (r < nabs) {
        var lr = vec_get(above_abs_gate, r);
        if (f64_gt(lr, relative_threshold) == 1) { vec_push(above_rel_gate, lr); }
        r = r + 1;
    }

    var integrated_lufs = ungated_lufs;
    if (vec_len(above_rel_gate) > 0) {
        integrated_lufs = dhvani_loudness_lufs_from_blocks(above_rel_gate);
    }

    # Momentary = last 400ms block
    var momentary_lufs = last_block;

    # Short-term = mean of last ~3s (30 blocks) in linear power domain
    var short_term_blocks = 30;
    if (nblocks < 30) { short_term_blocks = nblocks; }
    var st_slice = vec_new();
    var st_start = nblocks - short_term_blocks;
    var st = st_start;
    while (st < nblocks) { vec_push(st_slice, vec_get(block_loudness, st)); st = st + 1; }
    var short_term_lufs = dhvani_loudness_lufs_from_blocks(st_slice);

    # LRA: 95th - 10th percentile of relatively-gated blocks
    var range_lu = dhvani_loudness_compute_lra(above_rel_gate);

    return dhvani_r128_new(integrated_lufs, range_lu, short_term_lufs, momentary_lufs);
}

# --- dynamics.cyr ---

# dynamics.cyr -- Dynamics analysis: per-channel peak, RMS, true peak, crest
# factor, dynamic range, LUFS. Ports rust-old/src/analysis/dynamics.rs.
# L1: deps error + simd + buffer + abaco (amplitude_to_db). Does not use Spectrum.
#
# DynamicsAnalysis result -> a struct handle with vec fields (peak/peak_db/
# true_peak/true_peak_db/rms/rms_db/crest_factor_db) and scalar fields
# (lufs, dynamic_range_db, frame_count, channel_count). #[must_use] fns ->
# plain fns; the analyze entry point returns a valid handle. serde/Display N/A.

#derive(accessors)
struct DhDynamicsAnalysis {
    peak;
    peak_db;
    true_peak;
    true_peak_db;
    rms;
    rms_db;
    crest_factor_db;
    lufs;
    dynamic_range_db;
    frame_count;
    channel_count;
}

# --- accessors (return the whole per-channel vec / scalar) ---
#inline
#must_use
fn dhvani_dynamics_peak(self) { return DhDynamicsAnalysis_peak(self); }
#inline
#must_use
fn dhvani_dynamics_peak_db(self) { return DhDynamicsAnalysis_peak_db(self); }
#inline
#must_use
fn dhvani_dynamics_true_peak(self) { return DhDynamicsAnalysis_true_peak(self); }
#inline
#must_use
fn dhvani_dynamics_true_peak_db(self) { return DhDynamicsAnalysis_true_peak_db(self); }
#inline
#must_use
fn dhvani_dynamics_rms(self) { return DhDynamicsAnalysis_rms(self); }
#inline
#must_use
fn dhvani_dynamics_rms_db(self) { return DhDynamicsAnalysis_rms_db(self); }
#inline
#must_use
fn dhvani_dynamics_crest_factor_db(self) { return DhDynamicsAnalysis_crest_factor_db(self); }
#inline
#must_use
fn dhvani_dynamics_lufs(self) { return DhDynamicsAnalysis_lufs(self); }
#inline
#must_use
fn dhvani_dynamics_dynamic_range_db(self) { return DhDynamicsAnalysis_dynamic_range_db(self); }
#inline
#must_use
fn dhvani_dynamics_frame_count(self) { return DhDynamicsAnalysis_frame_count(self); }
#inline
#must_use
fn dhvani_dynamics_channel_count(self) { return DhDynamicsAnalysis_channel_count(self); }

# max_peak() -- max peak across channels (linear), folded from 0.0. Every fold
# here ignores NaN like the oracle's `f32::max` (dh_max_ignore_nan; a bare
# f64_max returns NaN for f64_max(x, NaN) and then drops it on the next step).
#must_use
fn dhvani_dynamics_max_peak(self) {
    var peak = DhDynamicsAnalysis_peak(self);
    var n = vec_len(peak);
    var acc = 0;
    var i = 0;
    while (i < n) { acc = dh_max_ignore_nan(acc, vec_get(peak, i)); i = i + 1; }
    return acc;
}

# max_peak_db() -- max peak dB across channels, folded from -inf.
#must_use
fn dhvani_dynamics_max_peak_db(self) {
    var pdb = DhDynamicsAnalysis_peak_db(self);
    var n = vec_len(pdb);
    var acc = DH_NEG_INF;
    var i = 0;
    while (i < n) { acc = dh_max_ignore_nan(acc, vec_get(pdb, i)); i = i + 1; }
    return acc;
}

# max_true_peak() -- max true peak across channels (linear), folded from 0.0.
#must_use
fn dhvani_dynamics_max_true_peak(self) {
    var tp = DhDynamicsAnalysis_true_peak(self);
    var n = vec_len(tp);
    var acc = 0;
    var i = 0;
    while (i < n) { acc = dh_max_ignore_nan(acc, vec_get(tp, i)); i = i + 1; }
    return acc;
}

# max_true_peak_db() -- max true peak dB across channels, folded from -inf.
#must_use
fn dhvani_dynamics_max_true_peak_db(self) {
    var tpdb = DhDynamicsAnalysis_true_peak_db(self);
    var n = vec_len(tpdb);
    var acc = DH_NEG_INF;
    var i = 0;
    while (i < n) { acc = dh_max_ignore_nan(acc, vec_get(tpdb, i)); i = i + 1; }
    return acc;
}

# mean_rms() -- mean of per-channel rms (linear); 0.0 for empty.
#must_use
fn dhvani_dynamics_mean_rms(self) {
    var rms = DhDynamicsAnalysis_rms(self);
    var n = vec_len(rms);
    if (n == 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < n) { sum = f64_add(sum, vec_get(rms, i)); i = i + 1; }
    return f64_div(sum, f64_from(n));
}

# mean_crest_factor_db() -- mean of per-channel crest factor dB; 0.0 for empty.
#must_use
fn dhvani_dynamics_mean_crest_factor_db(self) {
    var cf = DhDynamicsAnalysis_crest_factor_db(self);
    var n = vec_len(cf);
    if (n == 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < n) { sum = f64_add(sum, vec_get(cf, i)); i = i + 1; }
    return f64_div(sum, f64_from(n));
}

# analyze_dynamics(buf) -- comprehensive per-channel dynamics analysis.
#must_use
fn dhvani_analyze_dynamics(buf) {
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);

    var peak = dh_vec_zeros(ch);
    var rms_sum = dh_vec_zeros(ch);
    var true_peak = dh_vec_zeros(ch);

    # Frames actually readable from the sample storage (== frames for any buffer
    # the constructors build); the reads below walk raw storage, so they must not
    # trust a frames field larger than the data.
    var nf = frames;
    if (ch > 0) {
        if (nf > vec_len(samples) / ch) { nf = vec_len(samples) / ch; }
    } else { nf = 0; }
    var sd = dh_vec_data(samples);
    var stride = ch * 8;

    # Catmull-Rom sub-sample positions t = k/4 (k = 1..3) and their powers,
    # evaluated once with the expressions the per-k loop used (exact dyadics).
    var ta = f64_div(f64_from(1), 4.0);
    var ta2 = f64_mul(ta, ta);
    var ta3 = f64_mul(ta2, ta);
    var tb = f64_div(f64_from(2), 4.0);
    var tb2 = f64_mul(tb, tb);
    var tb3 = f64_mul(tb2, tb);
    var tc = f64_div(f64_from(3), 4.0);
    var tc2 = f64_mul(tc, tc);
    var tc3 = f64_mul(tc2, tc);

    # Per-channel peak and RMS accumulation (plain locals, written back once).
    var c = 0;
    while (c < ch) {
        var pk = 0;
        var sq = 0;
        var sp = sd + c * 8;
        var frame = 0;
        while (frame < nf) {
            var s = load64(sp);
            var absv = f64_abs(s);
            if (f64_gt(absv, pk) == 1) { pk = absv; }
            sq = f64_add(sq, f64_mul(s, s));
            sp = sp + stride;
            frame = frame + 1;
        }
        vec_set(peak, c, pk);
        vec_set(rms_sum, c, sq);

        # True peak: 4x oversampled inter-sample detection using 4-point cubic
        # Hermite (Catmull-Rom) interpolation. The frame's polynomial terms are
        # hoisted out of the k loop; each interp keeps the original operation
        # order, so the result is bit-identical. NaN interps are ignored
        # (dh_max_ignore_nan), as the oracle's `f32::max` does, so
        # true_peak >= peak holds even with NaN samples present.
        if (nf > 1) {
            var tp = pk;
            var f2 = 0;
            var last = nf - 1;
            var base = sd + c * 8;
            while (f2 < last) {
                var p0 = base + f2 * stride;
                var s0 = load64(p0);
                var s1 = load64(p0 + stride);
                var sm1 = s0;
                if (f2 > 0) { sm1 = load64(p0 - stride); }
                var s2 = s1;
                if ((f2 + 2) < nf) { s2 = load64(p0 + stride + stride); }
                # 0.5 * (2*s0 + (-sm1 + s1)*t
                #        + (2*sm1 - 5*s0 + 4*s1 - s2)*t2
                #        + (-sm1 + 3*s0 - 3*s1 + s2)*t3)
                var c0 = f64_mul(2.0, s0);
                var d1 = f64_add(f64_neg(sm1), s1);
                var c2quad = f64_sub(f64_add(f64_sub(f64_mul(2.0, sm1), f64_mul(5.0, s0)), f64_mul(4.0, s1)), s2);
                var c3cub = f64_add(f64_sub(f64_add(f64_neg(sm1), f64_mul(3.0, s0)), f64_mul(3.0, s1)), s2);
                var ia = f64_add(f64_add(f64_add(c0, f64_mul(d1, ta)), f64_mul(c2quad, ta2)), f64_mul(c3cub, ta3));
                ia = f64_mul(0.5, ia);
                tp = dh_max_ignore_nan(tp, f64_abs(ia));
                var ib = f64_add(f64_add(f64_add(c0, f64_mul(d1, tb)), f64_mul(c2quad, tb2)), f64_mul(c3cub, tb3));
                ib = f64_mul(0.5, ib);
                tp = dh_max_ignore_nan(tp, f64_abs(ib));
                var ic = f64_add(f64_add(f64_add(c0, f64_mul(d1, tc)), f64_mul(c2quad, tc2)), f64_mul(c3cub, tc3));
                ic = f64_mul(0.5, ic);
                tp = dh_max_ignore_nan(tp, f64_abs(ic));
                f2 = f2 + 1;
            }
            vec_set(true_peak, c, tp);
        }
        elif (nf == 1) {
            vec_set(true_peak, c, pk);
        }

        c = c + 1;
    }

    # rms per channel: sqrt(sum / frames), or 0.0 when frames == 0.
    var rms = dh_vec_zeros(ch);
    var ri = 0;
    while (ri < ch) {
        if (frames > 0) {
            vec_set(rms, ri, f64_sqrt(f64_div(vec_get(rms_sum, ri), f64_from(frames))));
        }
        ri = ri + 1;
    }

    # dB conversions per channel.
    var peak_db = dh_vec_zeros(ch);
    var rms_db = dh_vec_zeros(ch);
    var true_peak_db = dh_vec_zeros(ch);
    var di = 0;
    while (di < ch) {
        vec_set(peak_db, di, amplitude_to_db(vec_get(peak, di)));
        vec_set(rms_db, di, amplitude_to_db(vec_get(rms, di)));
        vec_set(true_peak_db, di, amplitude_to_db(vec_get(true_peak, di)));
        di = di + 1;
    }

    # crest factor: p - r if r > -inf, else 0.0.
    var crest_factor_db = dh_vec_zeros(ch);
    var ci = 0;
    while (ci < ch) {
        var pval = vec_get(peak_db, ci);
        var rval = vec_get(rms_db, ci);
        if (f64_gt(rval, DH_NEG_INF) == 1) {
            vec_set(crest_factor_db, ci, f64_sub(pval, rval));
        }
        ci = ci + 1;
    }

    # Simplified LUFS: mean RMS-squared across channels in LUFS scale.
    var total_sq_sum = 0;
    var ti = 0;
    while (ti < ch) { total_sq_sum = f64_add(total_sq_sum, vec_get(rms_sum, ti)); ti = ti + 1; }
    var frames_denom = frames;
    if (frames_denom < 1) { frames_denom = 1; }
    var total_rms_sq = f64_div(total_sq_sum, f64_mul(f64_from(ch), f64_from(frames_denom)));
    var lufs = DH_NEG_INF;
    # 1e-20 threshold. log10(x) = ln(x)/ln(10) (no f64_log10 in stdlib).
    if (f64_gt(total_rms_sq, 0x3BC79CA10C924223) == 1) {
        var log10_rms = f64_div(f64_ln(total_rms_sq), F64_LN10);
        lufs = f64_add(f64_neg(0.691), f64_mul(10.0, log10_rms));
    }

    # dynamic range: max peak dB - mean RMS dB.
    var max_peak_db = DH_NEG_INF;
    var mi = 0;
    while (mi < ch) { max_peak_db = dh_max_ignore_nan(max_peak_db, vec_get(peak_db, mi)); mi = mi + 1; }
    var mean_rms_db = DH_NEG_INF;
    if (ch > 0) {
        var sum_rms_db = 0;
        var mj = 0;
        while (mj < ch) { sum_rms_db = f64_add(sum_rms_db, vec_get(rms_db, mj)); mj = mj + 1; }
        mean_rms_db = f64_div(sum_rms_db, f64_from(ch));
    }
    var dynamic_range_db = f64_sub(max_peak_db, mean_rms_db);

    var self = alloc(sizeof(DhDynamicsAnalysis));
    DhDynamicsAnalysis_set_peak(self, peak);
    DhDynamicsAnalysis_set_peak_db(self, peak_db);
    DhDynamicsAnalysis_set_true_peak(self, true_peak);
    DhDynamicsAnalysis_set_true_peak_db(self, true_peak_db);
    DhDynamicsAnalysis_set_rms(self, rms);
    DhDynamicsAnalysis_set_rms_db(self, rms_db);
    DhDynamicsAnalysis_set_crest_factor_db(self, crest_factor_db);
    DhDynamicsAnalysis_set_lufs(self, lufs);
    DhDynamicsAnalysis_set_dynamic_range_db(self, dynamic_range_db);
    DhDynamicsAnalysis_set_frame_count(self, frames);
    DhDynamicsAnalysis_set_channel_count(self, ch);
    return self;
}

# --- stft.cyr ---

# stft.cyr -- Short-Time Fourier Transform for spectrogram generation.
# Ports rust-old/src/analysis/stft.rs. L1: deps error + simd + buffer + analysis
# + fft (dhvani_fft_in_place). Hann-windowed overlapping frames -> per-frame
# magnitude spectra. Spectrogram + StftProcessor.
#
# Spectrogram.frames was Vec<Vec<f32>>: here a `vec` of frame handles, each a
# `vec` of f64 magnitudes (window_size/2 bins). num_bins/sample_rate are integer
# counts; freq_resolution/time_resolution are f64. Fallible stft()/new()/compute()
# return a valid handle, or 0 (null) on error (empty buffer / bad window / hop=0).

#derive(accessors)
struct DhSpectrogram { frames; num_bins; freq_resolution; time_resolution; sample_rate; }

# ---- Spectrogram accessors / methods ----
#inline
#must_use
fn dhvani_spectrogram_frames(self) { return DhSpectrogram_frames(self); }
#inline
#must_use
fn dhvani_spectrogram_num_bins(self) { return DhSpectrogram_num_bins(self); }
#inline
#must_use
fn dhvani_spectrogram_freq_resolution(self) { return DhSpectrogram_freq_resolution(self); }
#inline
#must_use
fn dhvani_spectrogram_time_resolution(self) { return DhSpectrogram_time_resolution(self); }
#inline
#must_use
fn dhvani_spectrogram_sample_rate(self) { return DhSpectrogram_sample_rate(self); }

# number of time frames.
#inline
#must_use
fn dhvani_spectrogram_num_frames(self) { return vec_len(DhSpectrogram_frames(self)); }

# frequency of a bin index (Hz).
#must_use
fn dhvani_spectrogram_bin_frequency(self, bin) {
    return f64_mul(f64_from(bin), DhSpectrogram_freq_resolution(self));
}

# time in seconds of a frame index.
#must_use
fn dhvani_spectrogram_frame_time(self, frame) {
    return f64_mul(f64_from(frame), DhSpectrogram_time_resolution(self));
}

# the magnitude `vec` for one frame index.
#inline
#must_use
fn dhvani_spectrogram_frame(self, frame) {
    return vec_get(DhSpectrogram_frames(self), frame);
}

# ---- Hann window builder: 0.5 * (1 - cos(2*pi*i/(window_size-1))) ----
#must_use
fn dhvani_stft_hann_window(window_size) {
    var window = dh_vec_zeros(window_size);
    var denom = f64_from(window_size - 1);
    var i = 0;
    while (i < window_size) {
        var w = f64_mul(0.5, f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), denom))));
        vec_set(window, i, w);
        i = i + 1;
    }
    return window;
}

# shared STFT core: given a precomputed window (len window_size), a buffer, and a
# hop_size (> 0), build the frames vec. Preallocates real/imag scratch ONCE and
# walks raw storage; per frame only imag is re-zeroed (real is fully overwritten
# by the windowed samples). Bit-identical to the vec-accessor loop it replaced.
# The loop bound is `pos <= frames - window_size`, so pos + window_size never
# overflows however large hop_size is (pos <= frames before every add).
#must_use
fn dhvani_stft_run(window, window_size, buf, hop_size) {
    var num_bins = window_size / 2;
    var samples = DhAudioBuffer_samples(buf);
    var ch = DhAudioBuffer_channels(buf);
    var total_mono_frames = DhAudioBuffer_frames(buf);

    var frames = vec_new();
    if (ch < 1) { return frames; }
    if (hop_size < 1) { return frames; }
    # never read past the sample storage, whatever the frames field says
    var avail = vec_len(samples) / ch;
    if (total_mono_frames > avail) { total_mono_frames = avail; }
    var last_pos = total_mono_frames - window_size;
    var pos = 0;
    # Pre-allocate scratch buffers ONCE to avoid per-frame heap allocation.
    var real = dh_vec_zeros(window_size);
    var imag = dh_vec_zeros(window_size);
    if (vec_len(real) != window_size) { return frames; }
    if (vec_len(imag) != window_size) { return frames; }
    var sd = dh_vec_data(samples);
    var wd = dh_vec_data(window);
    var rd = dh_vec_data(real);
    var id = dh_vec_data(imag);
    var stride = ch * 8;
    var ws_f = f64_from(window_size);

    while (pos <= last_pos) {
        # imag.fill(0.0); real is overwritten below
        var z = 0;
        while (z < window_size) { store64(id + z * 8, 0); z = z + 1; }

        var sp = sd + pos * stride;
        var i = 0;
        while (i < window_size) {
            store64(rd + i * 8, f64_mul(load64(sp), load64(wd + i * 8)));
            sp = sp + stride;
            i = i + 1;
        }

        if (dhvani_fft_in_place(real, imag) == 0) {
            vec_push(frames, dh_vec_zeros(num_bins));
        } else {
            var magnitudes = dh_vec_zeros(num_bins);
            var md = dh_vec_data(magnitudes);
            var k = 0;
            while (k < num_bins) {
                var re = load64(rd + k * 8);
                var im = load64(id + k * 8);
                store64(md + k * 8, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), ws_f));
                k = k + 1;
            }
            vec_push(frames, magnitudes);
        }
        pos = pos + hop_size;
    }
    return frames;
}

# build the Spectrogram result struct from computed frames + metadata.
#must_use
fn dhvani_stft_make_spectrogram(frames, num_bins, sample_rate, window_size, hop_size) {
    var self = alloc(sizeof(DhSpectrogram));
    DhSpectrogram_set_frames(self, frames);
    DhSpectrogram_set_num_bins(self, num_bins);
    DhSpectrogram_set_freq_resolution(self, f64_div(f64_from(sample_rate), f64_from(window_size)));
    DhSpectrogram_set_time_resolution(self, f64_div(f64_from(hop_size), f64_from(sample_rate)));
    DhSpectrogram_set_sample_rate(self, sample_rate);
    return self;
}

# stft(buf, window_size, hop_size) -- Hann-windowed spectrogram, or 0 on error.
# Errors: empty buffer, window_size not a power of two, window_size < 4 or
# > DH_MAX_FFT, hop_size <= 0 (rust-old's usize hop could not be negative; a
# negative hop here walked pos below 0 and aborted the process in vec_get).
#must_use
fn dhvani_stft(buf, window_size, hop_size) {
    if (vec_len(DhAudioBuffer_samples(buf)) == 0) { return 0; }
    if (dh_is_pow2(window_size) == 0) { return 0; }
    if (window_size < 4) { return 0; }
    if (window_size > DH_MAX_FFT) { return 0; }
    if (hop_size <= 0) { return 0; }
    var num_bins = window_size / 2;
    var window = dhvani_stft_hann_window(window_size);
    var frames = dhvani_stft_run(window, window_size, buf, hop_size);
    return dhvani_stft_make_spectrogram(frames, num_bins, DhAudioBuffer_sample_rate(buf), window_size, hop_size);
}

# ---- StftProcessor: cached Hann window ----
#derive(accessors)
struct DhStftProcessor { window; window_size; }

# new(window_size) -- precompute the Hann window; 0 if window not pow2, < 4 or
# > DH_MAX_FFT.
#must_use
fn dhvani_stftproc_new(window_size) {
    if (dh_is_pow2(window_size) == 0) { return 0; }
    if (window_size < 4) { return 0; }
    if (window_size > DH_MAX_FFT) { return 0; }
    var self = alloc(sizeof(DhStftProcessor));
    DhStftProcessor_set_window(self, dhvani_stft_hann_window(window_size));
    DhStftProcessor_set_window_size(self, window_size);
    return self;
}

# compute(self, buf, hop_size) -- spectrogram using the cached window, or 0 on error.
# Errors: empty buffer, hop_size <= 0.
#must_use
fn dhvani_stftproc_compute(self, buf, hop_size) {
    if (vec_len(DhAudioBuffer_samples(buf)) == 0) { return 0; }
    if (hop_size <= 0) { return 0; }
    var window_size = DhStftProcessor_window_size(self);
    var num_bins = window_size / 2;
    var frames = dhvani_stft_run(DhStftProcessor_window(self), window_size, buf, hop_size);
    return dhvani_stft_make_spectrogram(frames, num_bins, DhAudioBuffer_sample_rate(buf), window_size, hop_size);
}

# window size.
#inline
#must_use
fn dhvani_stftproc_window_size(self) { return DhStftProcessor_window_size(self); }

# --- chroma.cyr ---

# chroma.cyr -- Chromagram: 12 pitch-class energies from the FFT spectrum.
# Ports rust-old/src/analysis/chroma.rs. L1: deps error + simd + buffer +
# abaco + analysis (Spectrum) + fft (spectrum_fft). Maps each FFT bin frequency
# to a pitch class (round(12 * log2(freq / C0)) mod 12), accumulates squared
# magnitude (energy) per class, normalizes to 0..1. serde + Display dropped.

# ---- PITCH_CLASSES lookup (was [&str; 12]) ----
#must_use
fn dhvani_chroma_pitch_class_name(idx) {
    if (idx == 0)  { return "C"; }
    if (idx == 1)  { return "C#"; }
    if (idx == 2)  { return "D"; }
    if (idx == 3)  { return "D#"; }
    if (idx == 4)  { return "E"; }
    if (idx == 5)  { return "F"; }
    if (idx == 6)  { return "F#"; }
    if (idx == 7)  { return "G"; }
    if (idx == 8)  { return "G#"; }
    if (idx == 9)  { return "A"; }
    if (idx == 10) { return "A#"; }
    if (idx == 11) { return "B"; }
    return "unknown";
}

#derive(accessors)
struct DhChromagram { chroma; }

# from_array(chroma) -- wrap a 12-slot `vec` of pitch-class energies; 0 (null)
# unless it holds exactly 12 values (the oracle's `[f32; 12]` enforced the length
# at compile time; a short vec here made dominant_class / detect_key_from_chroma
# read past it and abort the process).
#must_use
fn dhvani_chromagram_from_array(chroma) {
    if (chroma == 0) { return 0; }
    if (vec_len(chroma) != 12) { return 0; }
    var self = alloc(sizeof(DhChromagram));
    DhChromagram_set_chroma(self, chroma);
    return self;
}

# chroma() -- energy per pitch class (0=C, ..., 11=B). Normalized 0..1.
#inline
#must_use
fn dhvani_chromagram_chroma(self) { return DhChromagram_chroma(self); }

# dominant_class() -- index of the dominant (max-energy) pitch class, as the
# oracle's `max_by(partial_cmp().unwrap_or(Equal))`: starting from class 0, class
# i replaces the running best unless the best is strictly greater, so the LAST of
# equal maxima wins (silence -> 11, "B") and a NaN compares Equal (it is taken,
# then replaced by the next class).
#must_use
fn dhvani_chromagram_dominant_class(self) {
    var chroma = DhChromagram_chroma(self);
    var best_idx = 0;
    var best_val = vec_get(chroma, 0);
    var i = 1;
    while (i < 12) {
        var v = vec_get(chroma, i);
        if (f64_gt(best_val, v) == 0) { best_val = v; best_idx = i; }
        i = i + 1;
    }
    return best_idx;
}

# dominant_name() -- name of the dominant pitch class.
#must_use
fn dhvani_chromagram_dominant_name(self) {
    return dhvani_chroma_pitch_class_name(dhvani_chromagram_dominant_class(self));
}

# chromagram(buf, window_size) -- compute a chromagram from an audio buffer.
# Maps FFT bin freqs to 12 pitch classes: class = round(12*log2(freq/C0)) mod 12
# with C0 = 16.3516 Hz. Bins below C0 or below 1 Hz are skipped. 0 on FFT error
# (empty buffer, zero channels, window_size > DH_MAX_FFT).
#must_use
fn dhvani_chroma_chromagram(buf, window_size) {
    var spec = dhvani_fft_spectrum(buf, window_size);
    if (spec == 0) { return 0; }
    var chroma = dh_vec_zeros(12);
    var c0 = 16.3516;
    var mags = dhvani_spectrum_magnitudes(spec);
    var num_bins = vec_len(mags);
    var bin = 0;
    while (bin < num_bins) {
        var mag = vec_get(mags, bin);
        var freq = dhvani_spectrum_bin_frequency(spec, bin);
        if (f64_lt(freq, c0) == 1) { bin = bin + 1; }
        elif (f64_lt(freq, 1.0) == 1) { bin = bin + 1; }
        else {
            var semitones = f64_mul(12.0, f64_log2(f64_div(freq, c0)));
            var rounded = f64_to(f64_round_half_away(semitones));
            # rem_euclid(12): always in [0, 11].
            var class = ((rounded % 12) + 12) % 12;
            vec_set(chroma, class, f64_add(vec_get(chroma, class), f64_mul(mag, mag)));
            bin = bin + 1;
        }
    }
    # Normalize to 0..1 by the peak.
    var max = 0;
    var m = 0;
    while (m < 12) { max = dh_max_ignore_nan(max, vec_get(chroma, m)); m = m + 1; }
    if (f64_gt(max, 0) == 1) {
        var p = 0;
        while (p < 12) { vec_set(chroma, p, f64_div(vec_get(chroma, p), max)); p = p + 1; }
    }
    return dhvani_chromagram_from_array(chroma);
}

# --- convolution.cyr ---

# convolution.cyr -- FFT-based partitioned overlap-add convolution reverb.
# Ports rust-old/src/dsp/convolution.rs. L1: deps error + simd + buffer +
# analysis + fft (dhvani_fft_in_place, dh_next_pow2).
#
# Rust Vec<(Vec<f64>,Vec<f64>)> -> a `vec` of DhComplexBuf handles (each holds a
# `real` vec + an `imag` vec). Vec<Vec<f32>>/Vec<Vec<f64>> -> a `vec` of vec
# handles. Vec<Vec<(...)>> (per-channel FDL) -> a `vec` of vec-of-DhComplexBuf.
# f32 samples stored as f64 slots (lossless for the tested values). serde +
# Display + Clone dropped. IFFT via the conjugate trick, exactly as the oracle.
#
# LATENCY (2.3.3, docs/decisions/005): process() streams one block behind
# (dhvani_conv_latency_frames = block_size), so every frame is processed for any host
# block size; render() is the aligned offline form. The oracle has zero latency but
# returns some frames raw whenever a call does not end on a block boundary.
#
# Memory (free-less bump allocator): every buffer is struct-owned and only grows.
# - Partition accumulators: struct-owned, zeroed in place per block.
# - Per-channel buffers (input block, overlap, frequency delay line): allocated
#   for the LARGEST channel count seen; a channel-count change zeroes the active
#   channels in place (the oracle reallocates fresh zeros -- same values). Through
#   2.3.2 every change reallocated everything (~428 KB per switch for an
#   8-partition IR), so a graph alternating mono/stereo buffers leaked per call.
# - IR partitions: set_ir() refills the existing partition storage when the new IR
#   needs no more partitions than any IR before it, and grows the pool + FDL slots
#   only when it needs more (through 2.3.2 every set_ir reallocated the whole FDL).
# The hot loops walk the vec storage (dh_vec_data) with the oracle's exact
# arithmetic order, so the output is bit-identical to the per-element form.

# ---- ComplexBuf: one frequency-domain block (parallel real/imag vecs) ----
#derive(accessors)
struct DhComplexBuf { real; imag; }

#must_use
fn dhvani_cbuf_new(fft_size) {
    var self = alloc(sizeof(DhComplexBuf));
    DhComplexBuf_set_real(self, dh_vec_zeros(fft_size));
    DhComplexBuf_set_imag(self, dh_vec_zeros(fft_size));
    return self;
}

# zero the first n f64 slots of a vec's storage.
fn dh_conv_zero(v, n) {
    var p = dh_vec_data(v);
    var end = p + n * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    return 0;
}

# fill both real/imag with zeros.
fn dhvani_cbuf_clear(self, fft_size) {
    dh_conv_zero(DhComplexBuf_real(self), fft_size);
    dh_conv_zero(DhComplexBuf_imag(self), fft_size);
    return 0;
}

# ---- ConvolutionReverb ----
# channels = the ACTIVE channel count (0 until the first process); the per-channel
# vecs may hold more (grow-only). fdl_slots = FDL slots per allocated channel
# (>= the partition count). ir_pool = every partition buffer ever allocated;
# ir_partitions = the active prefix of it, one per partition of the current IR.
#derive(accessors)
struct DhConvolutionReverb {
    fft_size;
    block_size;
    ir_partitions;
    input_buffers;
    overlap;
    write_pos;
    mix;
    channels;
    scratch_real;
    scratch_imag;
    acc_real;
    acc_imag;
    fdl;
    fdl_pos;
    fdl_slots;
    ir_pool;
}

# number of block_size partitions an ir_len-sample IR needs (integer div_ceil).
#must_use
fn dh_conv_num_partitions(ir_len, block_size) {
    if (ir_len <= 0) { return 0; }
    return (ir_len + block_size - 1) / block_size;
}

# FFT one zero-padded IR segment ir[start..end) into the partition buffer cb.
fn dh_conv_fill_partition(cb, ir, start, end, fft_size) {
    var real = DhComplexBuf_real(cb);
    dh_conv_zero(real, fft_size);
    dh_conv_zero(DhComplexBuf_imag(cb), fft_size);
    var src = dh_vec_data(ir) + start * 8;
    var dst = dh_vec_data(real);
    var send = dh_vec_data(ir) + end * 8;
    while (src < send) { store64(dst, load64(src)); src = src + 8; dst = dst + 8; }
    dhvani_fft_in_place(real, DhComplexBuf_imag(cb));
    return 0;
}

# partition_ir(ir, block_size, fft_size) -> a NEW `vec` of DhComplexBuf handles.
# Empty IR -> an empty vec. Each partition is a zero-padded, FFT'd block.
#must_use
fn dhvani_conv_partition_ir(ir, block_size, fft_size) {
    var parts = vec_new();
    var ir_len = vec_len(ir);
    var num_partitions = dh_conv_num_partitions(ir_len, block_size);
    var p = 0;
    while (p < num_partitions) {
        var start = p * block_size;
        var end = dh_imin(start + block_size, ir_len);
        var cb = dhvani_cbuf_new(fft_size);
        dh_conv_fill_partition(cb, ir, start, end, fft_size);
        vec_push(parts, cb);
        p = p + 1;
    }
    return parts;
}

# Partition `ir` into the reverb's own storage: reuse the pooled partition buffers
# (allocating only past the largest partition count seen) and rebuild the active
# ir_partitions list in place.
fn dh_conv_partition_into(self, ir) {
    var block_size = DhConvolutionReverb_block_size(self);
    var fft_size = DhConvolutionReverb_fft_size(self);
    var pool = DhConvolutionReverb_ir_pool(self);
    var parts = DhConvolutionReverb_ir_partitions(self);
    var ir_len = vec_len(ir);
    var np = dh_conv_num_partitions(ir_len, block_size);
    while (vec_len(pool) < np) { vec_push(pool, dhvani_cbuf_new(fft_size)); }
    vec_truncate(parts, 0);
    var p = 0;
    while (p < np) {
        var start = p * block_size;
        var cb = vec_get(pool, p);
        dh_conv_fill_partition(cb, ir, start, dh_imin(start + block_size, ir_len), fft_size);
        vec_push(parts, cb);
        p = p + 1;
    }
    return np;
}

# Grow-only per-channel storage: at least `ch` allocated channels, each with at
# least `slots` FDL slots. New storage is zeroed; existing contents are kept.
fn dh_conv_grow(self, ch, slots) {
    var block_size = DhConvolutionReverb_block_size(self);
    var fft_size = DhConvolutionReverb_fft_size(self);
    var input_buffers = DhConvolutionReverb_input_buffers(self);
    var overlap = DhConvolutionReverb_overlap(self);
    var fdl = DhConvolutionReverb_fdl(self);
    var need = DhConvolutionReverb_fdl_slots(self);
    if (slots > need) { need = slots; }
    var have = vec_len(input_buffers);
    var c = 0;
    while (c < have) {
        var ch_fdl = vec_get(fdl, c);
        while (vec_len(ch_fdl) < need) { vec_push(ch_fdl, dhvani_cbuf_new(fft_size)); }
        c = c + 1;
    }
    while (have < ch) {
        vec_push(input_buffers, dh_vec_zeros(block_size));
        vec_push(overlap, dh_vec_zeros(fft_size));
        var nf = vec_new();
        var p = 0;
        while (p < need) { vec_push(nf, dhvani_cbuf_new(fft_size)); p = p + 1; }
        vec_push(fdl, nf);
        have = have + 1;
    }
    DhConvolutionReverb_set_fdl_slots(self, need);
    return 0;
}

# with_block_size(ir, block_size, mix, sample_rate) -> handle, or 0 (null) for an
# unusable block size: block_size <= 0, or one whose next power of two is 0
# (block_size > 2^62) or above DH_MAX_FFT / 2 (the fft_size = 2 * block would
# exceed the FFT limit). The oracle clamps 0 up to 1 (`block_size.max(1)`); here
# 0 and negatives are rejected like the other out-of-range sizes, so a bad size
# can never reach partition_ir. sample_rate is for the caller's bookkeeping only
# (the IR is assumed to match), as in the oracle.
#must_use
fn dhvani_conv_with_block_size(ir_samples, block_size, mix, sample_rate) {
    # rust-old: `block_size.max(1).next_power_of_two()` -- 0 (and so anything below 1)
    # becomes 1; only sizes whose power of two would pass the FFT limit are refused
    var bsz = block_size;
    if (bsz < 1) { bsz = 1; }
    var bs = dh_next_pow2(bsz);
    if (bs < 1) { return 0; }
    if (bs > DH_MAX_FFT / 2) { return 0; }
    var fft_size = bs * 2;
    var self = alloc(sizeof(DhConvolutionReverb));
    DhConvolutionReverb_set_fft_size(self, fft_size);
    DhConvolutionReverb_set_block_size(self, bs);
    DhConvolutionReverb_set_ir_partitions(self, vec_new());
    DhConvolutionReverb_set_ir_pool(self, vec_new());
    DhConvolutionReverb_set_input_buffers(self, vec_new());
    DhConvolutionReverb_set_overlap(self, vec_new());
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_mix(self, f64_clamp(mix, 0, 1.0));
    DhConvolutionReverb_set_channels(self, 0);
    DhConvolutionReverb_set_scratch_real(self, dh_vec_zeros(fft_size));
    DhConvolutionReverb_set_scratch_imag(self, dh_vec_zeros(fft_size));
    # Reusable partition accumulators. rust-old allocates these per block and
    # lets scope drop them; under the free-less bump allocator that is an
    # unbounded leak (~2 * fft_size * 8 B per channel per block), so they are
    # struct-owned and zeroed in place instead — same values, zero bytes/block.
    DhConvolutionReverb_set_acc_real(self, dh_vec_zeros(fft_size));
    DhConvolutionReverb_set_acc_imag(self, dh_vec_zeros(fft_size));
    DhConvolutionReverb_set_fdl(self, vec_new());
    DhConvolutionReverb_set_fdl_pos(self, 0);
    DhConvolutionReverb_set_fdl_slots(self, 0);
    dh_conv_partition_into(self, ir_samples);
    return self;
}

# new(ir, mix, sample_rate) -- default block size 512 (always valid: never null).
#must_use
fn dhvani_conv_new(ir_samples, mix, sample_rate) {
    return dhvani_conv_with_block_size(ir_samples, 512, mix, sample_rate);
}

# set_mix(mix) -- clamp to [0,1].
fn dhvani_conv_set_mix(self, mix) {
    DhConvolutionReverb_set_mix(self, f64_clamp(mix, 0, 1.0));
    return 0;
}

#inline
#must_use
fn dhvani_conv_mix(self) { return DhConvolutionReverb_mix(self); }

# set_ir(ir) -- load a new IR into the partition storage, then reset all state.
# The per-channel frequency delay line must hold at least one slot per partition:
# process_block indexes ch_fdl[0..num_partitions), and through 2.2.2 a longer IR
# ran off its end (vec_get -> _vec_die -> exit 1). Every allocated channel's FDL is
# grown here when the new IR needs more slots; a same-size or shorter IR reuses
# all storage (0 bytes). set_ir is a configuration call, not a hot path.
fn dhvani_conv_set_ir(self, ir_samples) {
    var np = dh_conv_partition_into(self, ir_samples);
    dh_conv_grow(self, 0, np);
    dhvani_conv_reset(self);
    return 0;
}

# zero channel c's input block, overlap and every FDL slot.
fn dh_conv_zero_channel(self, c) {
    var fft_size = DhConvolutionReverb_fft_size(self);
    var ib = vec_get(DhConvolutionReverb_input_buffers(self), c);
    dh_conv_zero(ib, vec_len(ib));
    var ov = vec_get(DhConvolutionReverb_overlap(self), c);
    dh_conv_zero(ov, vec_len(ov));
    var ch_fdl = vec_get(DhConvolutionReverb_fdl(self), c);
    var np = vec_len(ch_fdl);
    var fi = 0;
    while (fi < np) {
        dhvani_cbuf_clear(vec_get(ch_fdl, fi), fft_size);
        fi = fi + 1;
    }
    return 0;
}

# reset() -- zero input buffers, overlap, FDL; reset write/fdl positions.
fn dhvani_conv_reset(self) {
    var n = vec_len(DhConvolutionReverb_input_buffers(self));
    var c = 0;
    while (c < n) { dh_conv_zero_channel(self, c); c = c + 1; }
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_fdl_pos(self, 0);
    return 0;
}

# ensure_channels(ch) -- on a channel-count change, give the first ch channels
# fresh (zeroed) buffers and restart the block/FDL positions, as the oracle's
# reallocation does. Storage is grow-only: only a count above the largest seen,
# or a partition count above the FDL slots, allocates.
fn dhvani_conv_ensure_channels(self, ch) {
    if (DhConvolutionReverb_channels(self) == ch) { return 0; }
    DhConvolutionReverb_set_channels(self, ch);
    var num_partitions = vec_len(DhConvolutionReverb_ir_partitions(self));
    if (num_partitions < 1) { num_partitions = 1; }
    dh_conv_grow(self, ch, num_partitions);
    var c = 0;
    while (c < ch) { dh_conv_zero_channel(self, c); c = c + 1; }
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_fdl_pos(self, 0);
    return 0;
}

# process_block(channel) -- partitioned convolution for one channel's block.
fn dhvani_conv_process_block(self, channel) {
    var fft_size = DhConvolutionReverb_fft_size(self);
    var block_size = DhConvolutionReverb_block_size(self);
    var ir_partitions = DhConvolutionReverb_ir_partitions(self);
    var num_partitions = vec_len(ir_partitions);
    var fdl_pos = DhConvolutionReverb_fdl_pos(self);
    var ch_fdl = vec_get(DhConvolutionReverb_fdl(self), channel);
    var input_ch = vec_get(DhConvolutionReverb_input_buffers(self), channel);
    var span = fft_size * 8;

    var scratch_real = DhConvolutionReverb_scratch_real(self);
    var scratch_imag = DhConvolutionReverb_scratch_imag(self);
    # FFT the input block (zero-padded)
    var sr = dh_vec_data(scratch_real);
    var si = dh_vec_data(scratch_imag);
    dh_conv_zero(scratch_real, fft_size);
    dh_conv_zero(scratch_imag, fft_size);
    var ip = dh_vec_data(input_ch);
    var i = 0;
    var bspan = block_size * 8;
    while (i < bspan) { store64(sr + i, load64(ip + i)); i = i + 8; }
    if (dhvani_fft_in_place(scratch_real, scratch_imag) == 0) { return 0; }

    # Store in the frequency delay line (copy scratch into fdl[fdl_pos]).
    var slot = vec_get(ch_fdl, fdl_pos);
    var slot_r = dh_vec_data(DhComplexBuf_real(slot));
    var slot_i = dh_vec_data(DhComplexBuf_imag(slot));
    var cp = 0;
    while (cp < span) {
        store64(slot_r + cp, load64(sr + cp));
        store64(slot_i + cp, load64(si + cp));
        cp = cp + 8;
    }

    # Accumulate: sum over all partitions (FDL[pos-k] * IR[k]).
    # Struct-owned scratch, zeroed in place (the accumulate below reads the
    # previous value via f64_add, so the zero-fill is mandatory, not cosmetic).
    var acc_real = DhConvolutionReverb_acc_real(self);
    var acc_imag = DhConvolutionReverb_acc_imag(self);
    var ar = dh_vec_data(acc_real);
    var ai = dh_vec_data(acc_imag);
    dh_conv_zero(acc_real, fft_size);
    dh_conv_zero(acc_imag, fft_size);
    var k = 0;
    while (k < num_partitions) {
        var fdl_idx = (fdl_pos + num_partitions - k) % num_partitions;
        var fslot = vec_get(ch_fdl, fdl_idx);
        var fdl_r = dh_vec_data(DhComplexBuf_real(fslot));
        var fdl_i = dh_vec_data(DhComplexBuf_imag(fslot));
        var iref = vec_get(ir_partitions, k);
        var ir_r = dh_vec_data(DhComplexBuf_real(iref));
        var ir_i = dh_vec_data(DhComplexBuf_imag(iref));
        var b = 0;
        while (b < span) {
            var fr = load64(fdl_r + b);
            var fi = load64(fdl_i + b);
            var cr = load64(ir_r + b);
            var di = load64(ir_i + b);
            # (a+bi)(c+di) = (ac-bd) + (ad+bc)i
            store64(ar + b, f64_add(load64(ar + b), f64_sub(f64_mul(fr, cr), f64_mul(fi, di))));
            store64(ai + b, f64_add(load64(ai + b), f64_add(f64_mul(fr, di), f64_mul(fi, cr))));
            b = b + 8;
        }
        k = k + 1;
    }

    # IFFT via conjugate: IFFT(X) = conj(FFT(conj(X))) / N
    var n2 = 0;
    while (n2 < span) { store64(ai + n2, f64_neg(load64(ai + n2))); n2 = n2 + 8; }
    if (dhvani_fft_in_place(acc_real, acc_imag) == 0) { return 0; }
    var scale = f64_div(1.0, f64_from(fft_size));

    # Overlap-add into output.
    var ov = dh_vec_data(vec_get(DhConvolutionReverb_overlap(self), channel));
    var o = 0;
    while (o < span) {
        store64(ov + o, f64_add(load64(ov + o), f64_mul(load64(ar + o), scale)));
        o = o + 8;
    }
    return 0;
}

# latency_frames() -- how far process() delays its output: one block (block_size
# frames) once an IR is loaded, 0 for an empty IR (process is then a no-op). Report it
# to the graph's latency compensation.
#must_use
fn dhvani_conv_latency_frames(self) {
    if (vec_len(DhConvolutionReverb_ir_partitions(self)) == 0) { return 0; }
    return DhConvolutionReverb_block_size(self);
}

# process(buf) -- convolution reverb in place, streaming with ONE BLOCK of latency.
# No-op if the IR is empty or the buffer has no channels.
#
# OUTPUT TIMING (2.3.3). Output frame t is dry * x[t - B] + mix * wet[t - B], with
# B = block_size, the dry path delayed with the wet one so they stay aligned. The
# first B frames after construction, reset() or a channel-count change are silence.
# Every frame of every call is processed, whatever the host block size, and how the
# input is split into calls does not change a single bit of the output.
# - The sample one block back is read from the input block's own slot, which still
#   holds it until this block's sample overwrites it. Its wet output is the
#   overlap's slot. At each block boundary the overlap is shifted first (dropping the
#   frames just emitted), and only then is the new block's convolution added.
# - The overlap therefore goes through the oracle's exact sequence of adds and
#   shifts. For calls whose frame count is a multiple of B, the output is the
#   oracle's, bit for bit, B frames later.
# Through 2.3.2 the port kept the oracle's zero-latency timing. A block was written
# back only into the call that completed it, so with a host block that is not a
# multiple of B some frames came back raw (with 256-frame calls against B = 512,
# every other call was dry), and a one-shot call left its last frames % B raw.
# Nothing here aborts: `frames` is clamped to the sample storage.
fn dhvani_conv_process(self, buf) {
    var ir_partitions = DhConvolutionReverb_ir_partitions(self);
    if (vec_len(ir_partitions) == 0) { return 0; }

    var ch = DhAudioBuffer_channels(buf);
    dhvani_conv_ensure_channels(self, ch);
    if (ch < 1) { return 0; }

    var mix = DhConvolutionReverb_mix(self);
    var dry = f64_sub(1.0, mix);
    var samples = DhAudioBuffer_samples(buf);
    var samples_len = vec_len(samples);
    # never walk past the storage, whatever `frames` claims
    var frames = dh_imin(DhAudioBuffer_frames(buf), samples_len / ch);
    var block_size = DhConvolutionReverb_block_size(self);
    var fft_size = DhConvolutionReverb_fft_size(self);
    var input_buffers = DhConvolutionReverb_input_buffers(self);
    var overlap = DhConvolutionReverb_overlap(self);
    var num_partitions = vec_len(ir_partitions);
    var d = dh_vec_data(samples);
    var stride = ch * 8;
    var tail = (fft_size - block_size) * 8;
    var bspan = block_size * 8;
    var fspan = fft_size * 8;

    var frame = 0;
    while (frame < frames) {
        var write_pos = DhConvolutionReverb_write_pos(self);
        var to_copy = dh_imin(block_size - write_pos, frames - frame);

        # Emit the delayed frame and store the new one, per channel.
        var c0 = 0;
        while (c0 < ch) {
            var ib = dh_vec_data(vec_get(input_buffers, c0)) + write_pos * 8;
            var ov = dh_vec_data(vec_get(overlap, c0)) + write_pos * 8;
            var sp = d + (frame * ch + c0) * 8;
            var iend = ib + to_copy * 8;
            while (ib < iend) {
                var x = load64(sp);
                store64(sp, f64_add(f64_mul(load64(ib), dry), f64_mul(load64(ov), mix)));
                store64(ib, x);
                ib = ib + 8;
                ov = ov + 8;
                sp = sp + stride;
            }
            c0 = c0 + 1;
        }
        write_pos = write_pos + to_copy;
        DhConvolutionReverb_set_write_pos(self, write_pos);

        # A full block: retire the emitted overlap, then convolve the new block.
        if (write_pos >= block_size) {
            var cb = 0;
            while (cb < ch) {
                var ovb = dh_vec_data(vec_get(overlap, cb));
                var ti = 0;
                while (ti < tail) { store64(ovb + ti, load64(ovb + bspan + ti)); ti = ti + 8; }
                var tj = tail;
                while (tj < fspan) { store64(ovb + tj, 0); tj = tj + 8; }
                dhvani_conv_process_block(self, cb);
                cb = cb + 1;
            }
            DhConvolutionReverb_set_fdl_pos(self, (DhConvolutionReverb_fdl_pos(self) + 1) % num_partitions);
            DhConvolutionReverb_set_write_pos(self, 0);
        }

        frame = frame + to_copy;
    }
    return 0;
}

# render(buf) -- OFFLINE, latency-compensated: reset, then convolve `buf` as a whole
# signal so its output is aligned with its input (frame t = dry * x[t] + mix * wet[t]
# for every frame, the last partial block included). It runs a copy padded with one
# block of trailing zeros through process() and copies frames [B, B + frames) back.
# The IR tail past the end of `buf` is not emitted. Allocates the padded copy per
# call: not for the RT path (use process() there and compensate its latency). Returns
# DHVANI_ERR_NONE, or DHVANI_ERR_INVALID_PARAMETER for a buffer whose samples do not
# cover frames * channels or whose padded copy cannot be allocated.
fn dhvani_conv_render(self, buf) {
    if (vec_len(DhConvolutionReverb_ir_partitions(self)) == 0) { return DHVANI_ERR_NONE; }
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    if (ch < 1) { return DHVANI_ERR_NONE; }
    if (frames <= 0) { return DHVANI_ERR_NONE; }
    var samples = DhAudioBuffer_samples(buf);
    var n = frames * ch;
    if (n > vec_len(samples)) { return DHVANI_ERR_INVALID_PARAMETER; }
    var lat = DhConvolutionReverb_block_size(self);
    var total = (frames + lat) * ch;
    var pv = dh_vec_zeros(total);
    if (vec_len(pv) != total) { return DHVANI_ERR_INVALID_PARAMETER; }
    var src = dh_vec_data(samples);
    var dst = dh_vec_data(pv);
    var end = src + n * 8;
    var s = src;
    var t = dst;
    while (s < end) { store64(t, load64(s)); s = s + 8; t = t + 8; }
    var tmp = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(tmp, pv);
    DhAudioBuffer_set_channels(tmp, ch);
    DhAudioBuffer_set_sample_rate(tmp, DhAudioBuffer_sample_rate(buf));
    DhAudioBuffer_set_frames(tmp, frames + lat);
    dhvani_conv_reset(self);
    dhvani_conv_process(self, tmp);
    s = dst + lat * ch * 8;
    t = src;
    end = s + n * 8;
    while (s < end) { store64(t, load64(s)); s = s + 8; t = t + 8; }
    return DHVANI_ERR_NONE;
}

# --- noise_reduction.cyr ---

# noise_reduction.cyr -- spectral noise reduction (STFT soft gating).
# Ports rust-old/src/dsp/noise_reduction.rs. L1: deps error + simd + buffer +
# analysis + fft (dhvani_fft_in_place). NoiseReducer preallocates window/real/
# imag/avg_magnitude scratch once in `new`, and owns grow-only per-channel scratch
# (mono / output / window_sum): `process` reuses all of it, so a steady-state call
# allocates 0 bytes. (The oracle allocates `mono`, `output` and `window_sum` per
# channel per call and lets scope drop them; under the free-less bump allocator
# that leaked ~392 KB per stereo 4096-frame call through 2.3.1.)
#
# Two-pass per channel: pass 1 estimates the average magnitude spectrum (noise
# floor); pass 2 soft-gates bins below threshold and rebuilds via overlap-add.
# IFFT via conjugate: IFFT(X) = conj(FFT(conj(X))) / N. Rust stored f32 samples
# (cast `as f64` before windowing) -- the Cyrius port is f64 throughout, so the
# window multiply is direct. The loops walk the vec storage (dh_vec_data) with the
# oracle's arithmetic order. serde/Debug/Clone/Default dropped.

var DH_NR_WINDOW_SIZE = 2048;
var DH_NR_HOP_SIZE    = 1024;   # WINDOW_SIZE / 2 -- 50% overlap
var DH_NR_NUM_BINS    = 1024;   # WINDOW_SIZE / 2

#derive(accessors)
struct DhNoiseReducer { window; real; imag; avg_magnitude; mono; output; window_sum; }

# new() -- allocate scratch: Hann window + zeroed real/imag (WINDOW_SIZE) +
# zeroed avg_magnitude (NUM_BINS). The per-channel scratch starts empty and grows
# to the longest channel seen.
#must_use
fn dhvani_noise_reducer_new() {
    var window = dh_vec_zeros(DH_NR_WINDOW_SIZE);
    var denom = DH_NR_WINDOW_SIZE - 1;
    var i = 0;
    while (i < DH_NR_WINDOW_SIZE) {
        var w = f64_mul(
          0.5,
          f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), f64_from(denom)))));
        vec_set(window, i, w);
        i = i + 1;
    }
    var self = alloc(sizeof(DhNoiseReducer));
    DhNoiseReducer_set_window(self, window);
    DhNoiseReducer_set_real(self, dh_vec_zeros(DH_NR_WINDOW_SIZE));
    DhNoiseReducer_set_imag(self, dh_vec_zeros(DH_NR_WINDOW_SIZE));
    DhNoiseReducer_set_avg_magnitude(self, dh_vec_zeros(DH_NR_NUM_BINS));
    DhNoiseReducer_set_mono(self, vec_new());
    DhNoiseReducer_set_output(self, vec_new());
    DhNoiseReducer_set_window_sum(self, vec_new());
    return self;
}

# fill a vec's first `n` slots with 0.
fn dh_nr_fill_zero(v, n) {
    var p = dh_vec_data(v);
    var end = p + n * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    return 0;
}

# A vec of exactly n slots for scratch: `v` itself when its storage already holds n
# (length set by truncate / in-capacity push -- no allocation), else one fresh
# exact allocation. Contents are unspecified; callers overwrite or zero them.
#must_use
fn dh_nr_fit(v, n) {
    if (vec_cap(v) < n) { return dh_vec_zeros(n); }
    vec_truncate(v, n);
    var len = vec_len(v);
    while (len < n) { vec_push(v, 0); len = len + 1; }
    return v;
}

# windowed frame at samples[pos..pos+WINDOW_SIZE) -> real; imag zeroed.
fn dh_nr_load_frame(sd, pos, wd, rd, id) {
    var i = 0;
    var span = DH_NR_WINDOW_SIZE * 8;
    var sp = sd + pos * 8;
    while (i < span) {
        store64(rd + i, f64_mul(load64(sp + i), load64(wd + i)));
        store64(id + i, 0);
        i = i + 8;
    }
    return 0;
}

# process_channel(self, samples, strength) -- gate one mono `vec` in place.
fn dhvani_noise_reducer_process_channel(self, samples, strength) {
    var n = vec_len(samples);
    if (n < DH_NR_WINDOW_SIZE) { return 0; }

    var window = DhNoiseReducer_window(self);
    var real = DhNoiseReducer_real(self);
    var imag = DhNoiseReducer_imag(self);
    var avg = DhNoiseReducer_avg_magnitude(self);
    var sd = dh_vec_data(samples);
    var wd = dh_vec_data(window);
    var rd = dh_vec_data(real);
    var id = dh_vec_data(imag);
    var ad = dh_vec_data(avg);
    var nbins = DH_NR_NUM_BINS * 8;

    # Pass 1: estimate average magnitude spectrum (noise floor)
    dh_nr_fill_zero(avg, DH_NR_NUM_BINS);
    var frame_count = 0;
    var pos = 0;
    while (pos + DH_NR_WINDOW_SIZE <= n) {
        dh_nr_load_frame(sd, pos, wd, rd, id);
        if (dhvani_fft_in_place(real, imag) == 1) {
            var k1 = 0;
            while (k1 < nbins) {
                var re1 = load64(rd + k1);
                var im1 = load64(id + k1);
                store64(ad + k1, f64_add(load64(ad + k1), f64_sqrt(f64_add(f64_mul(re1, re1), f64_mul(im1, im1)))));
                k1 = k1 + 8;
            }
            frame_count = frame_count + 1;
        }
        pos = pos + DH_NR_HOP_SIZE;
    }

    if (frame_count == 0) { return 0; }
    var fc = f64_from(frame_count);
    var mi = 0;
    while (mi < nbins) {
        store64(ad + mi, f64_div(load64(ad + mi), fc));
        mi = mi + 8;
    }

    # Pass 2: gate + reconstruct via overlap-add into the owned, grow-only
    # per-channel-length scratch (zeroed in place).
    var output = dh_nr_fit(DhNoiseReducer_output(self), n);
    DhNoiseReducer_set_output(self, output);
    var window_sum = dh_nr_fit(DhNoiseReducer_window_sum(self), n);
    DhNoiseReducer_set_window_sum(self, window_sum);
    dh_nr_fill_zero(output, n);
    dh_nr_fill_zero(window_sum, n);
    var od = dh_vec_data(output);
    var wsd = dh_vec_data(window_sum);
    var gate_factor = f64_mul(strength, 1.5);
    var scale = f64_div(1.0, f64_from(DH_NR_WINDOW_SIZE));
    var wspan = DH_NR_WINDOW_SIZE * 8;
    pos = 0;
    while (pos + DH_NR_WINDOW_SIZE <= n) {
        dh_nr_load_frame(sd, pos, wd, rd, id);
        if (dhvani_fft_in_place(real, imag) == 1) {
            # Soft gate: attenuate bins below threshold
            var k2 = 0;
            while (k2 < DH_NR_NUM_BINS) {
                var re2 = load64(rd + k2 * 8);
                var im2 = load64(id + k2 * 8);
                var mag = f64_sqrt(f64_add(f64_mul(re2, re2), f64_mul(im2, im2)));
                var threshold = f64_mul(load64(ad + k2 * 8), gate_factor);
                if (f64_lt(mag, threshold) == 1) {
                    if (f64_gt(threshold, 0.0) == 1) {
                        var attenuation = f64_div(mag, threshold);
                        store64(rd + k2 * 8, f64_mul(re2, attenuation));
                        store64(id + k2 * 8, f64_mul(im2, attenuation));
                        # Mirror for negative frequencies (k2 < NUM_BINS always holds)
                        if (k2 > 0) {
                            var mirror = (DH_NR_WINDOW_SIZE - k2) * 8;
                            store64(rd + mirror, f64_mul(load64(rd + mirror), attenuation));
                            store64(id + mirror, f64_mul(load64(id + mirror), attenuation));
                        }
                    }
                }
                k2 = k2 + 1;
            }

            # Inverse FFT (conjugate: negate imag, forward FFT, divide by N)
            var ci = 0;
            while (ci < wspan) {
                store64(id + ci, f64_neg(load64(id + ci)));
                ci = ci + 8;
            }
            if (dhvani_fft_in_place(real, imag) == 1) {
                # scale, then overlap-add with window
                var oi = 0;
                var op = od + pos * 8;
                var wp = wsd + pos * 8;
                while (oi < wspan) {
                    var wv = load64(wd + oi);
                    var r = f64_mul(load64(rd + oi), scale);
                    store64(op + oi, f64_add(load64(op + oi), f64_mul(r, wv)));
                    store64(wp + oi, f64_add(load64(wp + oi), f64_mul(wv, wv)));
                    oi = oi + 8;
                }
            }
        }
        pos = pos + DH_NR_HOP_SIZE;
    }

    # Normalize by window sum and write back
    var ni = 0;
    var nspan = n * 8;
    while (ni < nspan) {
        var ws = load64(wsd + ni);
        if (f64_gt(ws, 0.0000000001) == 1) {
            store64(sd + ni, f64_div(load64(od + ni), ws));
        }
        if (dhvani_is_finite(load64(sd + ni)) == 0) {
            store64(sd + ni, 0);
        }
        ni = ni + 8;
    }
    return 0;
}

# process(self, buf, strength) -- apply spectral noise reduction in place.
# Steady state (a buffer no longer than the longest seen) allocates 0 bytes.
fn dhvani_noise_reducer_process(self, buf, strength) {
    var s = f64_clamp(strength, 0.0, 1.0);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    var slen = vec_len(samples);
    var d = dh_vec_data(samples);
    if (frames < DH_NR_WINDOW_SIZE) {
        # Too short for STFT -- fall back to a simple amplitude gate.
        var threshold = f64_mul(s, 0.05);
        var p = d;
        var end = d + slen * 8;
        while (p < end) {
            if (f64_lt(f64_abs(load64(p)), threshold) == 1) { store64(p, 0); }
            p = p + 8;
        }
        return 0;
    }

    var ch = DhAudioBuffer_channels(buf);
    if (ch < 1) { return 0; }
    # never walk past the storage, whatever `frames` claims
    frames = dh_imin(frames, slen / ch);
    var mono = dh_nr_fit(DhNoiseReducer_mono(self), frames);
    DhNoiseReducer_set_mono(self, mono);
    var md = dh_vec_data(mono);
    var stride = ch * 8;
    var mend = md + frames * 8;

    # Process each channel independently
    var c = 0;
    while (c < ch) {
        # Extract mono channel
        var src = d + c * 8;
        var m = md;
        while (m < mend) { store64(m, load64(src)); src = src + stride; m = m + 8; }
        dhvani_noise_reducer_process_channel(self, mono, s);
        # Write back
        var dst = d + c * 8;
        m = md;
        while (m < mend) { store64(dst, load64(m)); dst = dst + stride; m = m + 8; }
        c = c + 1;
    }
    return 0;
}

# noise_reduce(buf, strength) -- ONE-SHOT spectral noise reduction in place. Builds
# a fresh NoiseReducer every call (Hann window + ~115 KB of scratch, never freed
# under the bump allocator): fine for a single offline pass, a leak if called per
# block. For repeated processing keep a dhvani_noise_reducer_new() handle and call
# dhvani_noise_reducer_process, which reuses its scratch (0 bytes per call).
fn dhvani_noise_reduce(buf, strength) {
    var reducer = dhvani_noise_reducer_new();
    dhvani_noise_reducer_process(reducer, buf, strength);
    return 0;
}

# --- eq.cyr ---

# eq.cyr -- Parametric EQ: N-band biquad cascade with configurable band types.
# Ports rust-old/src/dsp/eq.rs. L1: deps error + simd + buffer + abaco + biquad.
#
# BandType enum -> integer code. EqBandConfig -> struct. ParametricEq holds a
# vec of band configs (parallel) and a vec of biquad filter handles, plus a
# struct-owned dry scratch vec (allocated once, reused per process() call) so the
# dry/wet mix path never clones buf.samples per call (alloc-hot: the bump
# allocator never frees). band()/set_band() Option -> index-valid / sentinel
# (a negative index is out of range, never an abort).
# to_filter_type() -> (biquad code, gain_db) threaded as separate args to
# dhvani_biquad_new / dhvani_biquad_set_params. serde + Display dropped.
#
# Band configs are COPIED into eq-owned storage by new / add_band / set_params /
# set_band (the oracle moves them in), so a caller reusing or mutating its own
# config handle afterwards cannot half-apply a change (`enabled` read live while
# the coefficients stay stale). set_band rewrites the owned config and the band's
# coefficients in place: zero bytes per call, so band automation does not leak.

# ---- BandType (was enum) ----
var DH_BAND_PEAKING   = 0;
var DH_BAND_LOWSHELF  = 1;
var DH_BAND_HIGHSHELF = 2;
var DH_BAND_LOWPASS   = 3;
var DH_BAND_HIGHPASS  = 4;
var DH_BAND_BANDPASS  = 5;
var DH_BAND_NOTCH     = 6;

# BandType -> biquad filter-type code (was to_filter_type()). The gain_db payload
# of the Peaking/LowShelf/HighShelf variants is threaded separately (the biquad
# port already takes gain_db as its own arg).
#must_use
fn dhvani_eq_band_to_filter_type(band_type) {
    if (band_type == DH_BAND_PEAKING)   { return DH_BQ_PEAKING; }
    if (band_type == DH_BAND_LOWSHELF)  { return DH_BQ_LOWSHELF; }
    if (band_type == DH_BAND_HIGHSHELF) { return DH_BQ_HIGHSHELF; }
    if (band_type == DH_BAND_LOWPASS)   { return DH_BQ_LOWPASS; }
    if (band_type == DH_BAND_HIGHPASS)  { return DH_BQ_HIGHPASS; }
    if (band_type == DH_BAND_BANDPASS)  { return DH_BQ_BANDPASS; }
    return DH_BQ_NOTCH;
}

# ---- EqBandConfig ----
#derive(accessors)
struct DhEqBandConfig { band_type; freq_hz; gain_db; q; enabled; }

# new(band_type, freq_hz, gain_db, q, enabled).
#must_use
fn dhvani_eq_band_config_new(band_type, freq_hz, gain_db, q, enabled) {
    var cfg = alloc(sizeof(DhEqBandConfig));
    DhEqBandConfig_set_band_type(cfg, band_type);
    DhEqBandConfig_set_freq_hz(cfg, freq_hz);
    DhEqBandConfig_set_gain_db(cfg, gain_db);
    DhEqBandConfig_set_q(cfg, q);
    DhEqBandConfig_set_enabled(cfg, enabled);
    return cfg;
}

# copy every field of src into dst (no allocation).
fn dh_eq_band_config_copy_into(dst, src) {
    DhEqBandConfig_set_band_type(dst, DhEqBandConfig_band_type(src));
    DhEqBandConfig_set_freq_hz(dst, DhEqBandConfig_freq_hz(src));
    DhEqBandConfig_set_gain_db(dst, DhEqBandConfig_gain_db(src));
    DhEqBandConfig_set_q(dst, DhEqBandConfig_q(src));
    DhEqBandConfig_set_enabled(dst, DhEqBandConfig_enabled(src));
    return 0;
}

# a new config handle with src's fields (the oracle's `config.clone()`).
#must_use
fn dh_eq_band_config_copy(src) {
    var cfg = alloc(sizeof(DhEqBandConfig));
    dh_eq_band_config_copy_into(cfg, src);
    return cfg;
}

# --- EqBandConfig accessors ---
#inline
#must_use
fn dhvani_eq_band_config_band_type(cfg) { return DhEqBandConfig_band_type(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_freq_hz(cfg) { return DhEqBandConfig_freq_hz(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_gain_db(cfg) { return DhEqBandConfig_gain_db(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_q(cfg) { return DhEqBandConfig_q(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_enabled(cfg) { return DhEqBandConfig_enabled(cfg); }

# ---- ParametricEq ----
# configs + filts are parallel vecs (was Vec<(EqBandConfig, BiquadFilter)>).
# dry_scratch is a struct-owned f64 vec reused every process() call so the
# dry/wet path never allocates per call.
#derive(accessors)
struct DhParametricEq { configs; filts; sample_rate; channels; bypassed; mix; dry_scratch; }

# build a biquad filter for a band config.
#must_use
fn dhvani_eq_build_filter(cfg, sample_rate, channels) {
    return dhvani_biquad_new(
      dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(cfg)),
      DhEqBandConfig_gain_db(cfg),
      DhEqBandConfig_freq_hz(cfg),
      DhEqBandConfig_q(cfg),
      sample_rate,
      channels);
}

# new(bands, sample_rate, channels) -- bands is a vec of DhEqBandConfig handles
# (copied; the caller keeps its handles).
#must_use
fn dhvani_eq_new(bands, sample_rate, channels) {
    var self = alloc(sizeof(DhParametricEq));
    var configs = vec_new();
    var filts = vec_new();
    var n = vec_len(bands);
    var i = 0;
    while (i < n) {
        var cfg = dh_eq_band_config_copy(vec_get(bands, i));
        vec_push(configs, cfg);
        vec_push(filts, dhvani_eq_build_filter(cfg, sample_rate, channels));
        i = i + 1;
    }
    DhParametricEq_set_configs(self, configs);
    DhParametricEq_set_filts(self, filts);
    DhParametricEq_set_sample_rate(self, sample_rate);
    DhParametricEq_set_channels(self, channels);
    DhParametricEq_set_bypassed(self, 0);
    DhParametricEq_set_mix(self, 1.0);
    DhParametricEq_set_dry_scratch(self, vec_new());
    return self;
}

fn dhvani_eq_set_bypass(self, bypassed) {
    DhParametricEq_set_bypassed(self, bypassed);
    return 0;
}

#must_use
fn dhvani_eq_is_bypassed(self) {
    if (DhParametricEq_bypassed(self) == 1) { return 1; }
    return 0;
}

# process(buf) -- run each enabled band's filter in series, in place. When
# mix < 1.0, snapshot dry into the struct-owned scratch (grow-only: allocates only
# past the largest buffer seen) then blend dry*(1-mix) + wet*mix, walking the
# storage. No per-call allocation.
fn dhvani_eq_process(self, buf) {
    if (DhParametricEq_bypassed(self) == 1) { return 0; }
    var configs = DhParametricEq_configs(self);
    var filts = DhParametricEq_filts(self);
    var n = vec_len(configs);
    var mix = DhParametricEq_mix(self);
    if (f64_lt(mix, 1.0) == 1) {
        var samples = DhAudioBuffer_samples(buf);
        var len = vec_len(samples);
        var scratch = DhParametricEq_dry_scratch(self);
        if (vec_cap(scratch) < len) {
            scratch = dh_vec_zeros(len);
            DhParametricEq_set_dry_scratch(self, scratch);
        }
        # copy dry samples into scratch (within its capacity).
        var dd = dh_vec_data(scratch);
        var sp = dh_vec_data(samples);
        var send = sp + len * 8;
        var q = dd;
        while (sp < send) { store64(q, load64(sp)); sp = sp + 8; q = q + 8; }
        var i = 0;
        while (i < n) {
            if (DhEqBandConfig_enabled(vec_get(configs, i)) == 1) {
                dhvani_biquad_process(vec_get(filts, i), buf);
            }
            i = i + 1;
        }
        var dry = f64_sub(1.0, mix);
        # the filters work in place, so the storage pointer is still current
        var w = dh_vec_data(samples);
        var wend = w + len * 8;
        q = dd;
        while (w < wend) {
            store64(w, f64_add(f64_mul(load64(q), dry), f64_mul(load64(w), mix)));
            w = w + 8;
            q = q + 8;
        }
    } else {
        var i2 = 0;
        while (i2 < n) {
            if (DhEqBandConfig_enabled(vec_get(configs, i2)) == 1) {
                dhvani_biquad_process(vec_get(filts, i2), buf);
            }
            i2 = i2 + 1;
        }
    }
    return 0;
}

# 1 iff 0 <= index < band count.
#must_use
fn dh_eq_index_ok(self, index) {
    if (index < 0) { return 0; }
    if (index < vec_len(DhParametricEq_configs(self))) { return 1; }
    return 0;
}

# set_band(index, config) -- rebuild that band's coeffs (filter state kept, as the
# oracle's `filt.set_params`), copy config into the band's owned config. No-op if
# index out of range (Option::None branch). Zero bytes per call.
fn dhvani_eq_set_band(self, index, config) {
    if (dh_eq_index_ok(self, index) == 1) {
        var filt = vec_get(DhParametricEq_filts(self), index);
        dhvani_biquad_set_params(
          filt,
          dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(config)),
          DhEqBandConfig_gain_db(config),
          DhEqBandConfig_freq_hz(config),
          DhEqBandConfig_q(config));
        var own = vec_get(DhParametricEq_configs(self), index);
        if (own != config) { dh_eq_band_config_copy_into(own, config); }
    }
    return 0;
}

# add_band(config) -- append a new band (config copied) + its filter.
fn dhvani_eq_add_band(self, config) {
    var cfg = dh_eq_band_config_copy(config);
    vec_push(DhParametricEq_configs(self), cfg);
    vec_push(DhParametricEq_filts(self),
      dhvani_eq_build_filter(cfg,
        DhParametricEq_sample_rate(self),
        DhParametricEq_channels(self)));
    return 0;
}

# remove_band(index) -- remove a band by index. No-op if out of range.
fn dhvani_eq_remove_band(self, index) {
    var configs = DhParametricEq_configs(self);
    if (dh_eq_index_ok(self, index) == 1) {
        vec_remove(configs, index);
        vec_remove(DhParametricEq_filts(self), index);
    }
    return 0;
}

# number of bands.
#inline
#must_use
fn dhvani_eq_band_count(self) {
    return vec_len(DhParametricEq_configs(self));
}

# band(index) -- the band's config handle, or 0 (null / None) if index out of
# range. The handle is the eq's own config (the oracle returns `&EqBandConfig`):
# treat it as read-only and change a band with dhvani_eq_set_band, which also
# rebuilds the coefficients.
#must_use
fn dhvani_eq_band(self, index) {
    if (dh_eq_index_ok(self, index) == 1) {
        return vec_get(DhParametricEq_configs(self), index);
    }
    return 0;
}

# set_params(bands) -- replace all bands + rebuild all filters (fresh state, as the
# oracle). bands is a vec of DhEqBandConfig handles (copied).
fn dhvani_eq_set_params(self, bands) {
    var configs = vec_new();
    var filts = vec_new();
    var sr = DhParametricEq_sample_rate(self);
    var ch = DhParametricEq_channels(self);
    var n = vec_len(bands);
    var i = 0;
    while (i < n) {
        var cfg = dh_eq_band_config_copy(vec_get(bands, i));
        vec_push(configs, cfg);
        vec_push(filts, dhvani_eq_build_filter(cfg, sr, ch));
        i = i + 1;
    }
    DhParametricEq_set_configs(self, configs);
    DhParametricEq_set_filts(self, filts);
    return 0;
}

# set_mix(mix) -- clamp to [0, 1].
fn dhvani_eq_set_mix(self, mix) {
    DhParametricEq_set_mix(self, f64_clamp(mix, 0, 1.0));
    return 0;
}

#inline
#must_use
fn dhvani_eq_mix(self) { return DhParametricEq_mix(self); }

# set_sample_rate(sample_rate) -- update rate, rebuild all coeffs.
fn dhvani_eq_set_sample_rate(self, sample_rate) {
    DhParametricEq_set_sample_rate(self, sample_rate);
    var configs = DhParametricEq_configs(self);
    var filts = DhParametricEq_filts(self);
    var n = vec_len(configs);
    var i = 0;
    while (i < n) {
        var cfg = vec_get(configs, i);
        var filt = vec_get(filts, i);
        dhvani_biquad_set_sample_rate(filt, sample_rate);
        dhvani_biquad_set_params(
          filt,
          dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(cfg)),
          DhEqBandConfig_gain_db(cfg),
          DhEqBandConfig_freq_hz(cfg),
          DhEqBandConfig_q(cfg));
        i = i + 1;
    }
    return 0;
}

# reset all filter states.
fn dhvani_eq_reset(self) {
    var filts = DhParametricEq_filts(self);
    var n = vec_len(filts);
    var i = 0;
    while (i < n) {
        dhvani_biquad_reset(vec_get(filts, i));
        i = i + 1;
    }
    return 0;
}

# --- deesser.cyr ---

# deesser.cyr -- De-esser: sibilance reduction via a biquad BandPass sidechain.
# Ports rust-old/src/dsp/deesser.rs. L2: deps error + simd + buffer +
# abaco (db_to_amplitude) + biquad (BandPass detector).
#
# Detects energy in the sibilant band (typ. 4-9 kHz) with a BandPass biquad
# sidechain and ducks the signal when it exceeds threshold. The Rust used a
# pre-allocated Vec<f32> `sidechain` reclaimed each call via std::mem::take
# wrapped in a temp AudioBuffer. The Cyrius port owns a `sidechain` vec AND a
# `scratch` AudioBuffer wrapper, both allocated once in new(); process() sizes
# the sidechain to exactly this block's sample count, as the oracle's
# `resize(len)` does (the storage only grows; a shorter block truncates the
# length and keeps the capacity) -- no per-call allocation on the hot path.
#
# Params are copied into instance-owned storage on new()/set_params (the oracle
# moves them), so a caller mutating its own handle afterwards cannot half-apply a
# change (threshold/reduction are read live, freq/q are baked into the detector).
# set_params / set_sample_rate rebuild the detector IN PLACE: the oracle builds a
# fresh BiquadFilter (new coefficients, zeroed state); here the existing filter
# gets the new coefficients via dhvani_biquad_set_params plus a state reset --
# same values, zero bytes.
#
# DeEsserParams::validate -> DHVANI_ERR_NONE / negative DHVANI_ERR_INVALID_PARAMETER.
# new()/set_params Result -> handle-or-null / error code. serde + Display dropped.

#derive(accessors)
struct DhDeEsserParams { freq_hz; threshold_db; reduction_db; q; }

#derive(accessors)
struct DhDeEsser { params; detector; sidechain; scratch; sample_rate; channels; bypassed; }

# ---- DeEsserParams ----
#must_use
fn dhvani_deesserparams_new(freq_hz, threshold_db, reduction_db, q) {
    var p = alloc(sizeof(DhDeEsserParams));
    DhDeEsserParams_set_freq_hz(p, freq_hz);
    DhDeEsserParams_set_threshold_db(p, threshold_db);
    DhDeEsserParams_set_reduction_db(p, reduction_db);
    DhDeEsserParams_set_q(p, q);
    return p;
}

# default: freq 6000, threshold -20 dB, reduction 6 dB, q 2.
#must_use
fn dhvani_deesserparams_default() {
    return dhvani_deesserparams_new(6000.0, f64_neg(20.0), 6.0, 2.0);
}

# copy every field of src into dst (no allocation).
fn dh_deesserparams_copy_into(dst, src) {
    DhDeEsserParams_set_freq_hz(dst, DhDeEsserParams_freq_hz(src));
    DhDeEsserParams_set_threshold_db(dst, DhDeEsserParams_threshold_db(src));
    DhDeEsserParams_set_reduction_db(dst, DhDeEsserParams_reduction_db(src));
    DhDeEsserParams_set_q(dst, DhDeEsserParams_q(src));
    return 0;
}

# validate -- freq_hz>0, reduction_db>=0, q>0.
#must_use
fn dhvani_deesserparams_validate(p) {
    if (f64_le(DhDeEsserParams_freq_hz(p), 0) == 1)     { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhDeEsserParams_reduction_db(p), 0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_le(DhDeEsserParams_q(p), 0) == 1)            { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- DeEsser ----
# new(params, sample_rate, channels) -- handle, or 0 if params invalid. The params
# are copied; the caller keeps ownership of its handle.
#must_use
fn dhvani_deesser_new(params, sample_rate, channels) {
    if (dhvani_is_err(dhvani_deesserparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhDeEsser));
    var detector = dhvani_biquad_new(DH_BQ_BANDPASS, 0,
      DhDeEsserParams_freq_hz(params),
      DhDeEsserParams_q(params),
      sample_rate, channels);
    var own = alloc(sizeof(DhDeEsserParams));
    dh_deesserparams_copy_into(own, params);
    DhDeEsser_set_params(self, own);
    DhDeEsser_set_detector(self, detector);
    # reusable sidechain sample vec (grows to buffer length, reused per call)
    DhDeEsser_set_sidechain(self, vec_new());
    # reusable AudioBuffer wrapper around the sidechain vec (rebound each call)
    var scratch = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(scratch, DhDeEsser_sidechain(self));
    DhAudioBuffer_set_channels(scratch, channels);
    DhAudioBuffer_set_sample_rate(scratch, sample_rate);
    DhAudioBuffer_set_frames(scratch, 0);
    DhDeEsser_set_scratch(self, scratch);
    DhDeEsser_set_sample_rate(self, sample_rate);
    DhDeEsser_set_channels(self, channels);
    DhDeEsser_set_bypassed(self, 0);
    return self;
}

fn dhvani_deesser_set_bypass(self, bypassed) { DhDeEsser_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_deesser_is_bypassed(self) { if (DhDeEsser_bypassed(self) == 1) { return 1; } return 0; }

# process(buf) -- duck sibilance in place.
fn dhvani_deesser_process(self, buf) {
    if (DhDeEsser_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 1) { return 0; }
    var samples = DhAudioBuffer_samples(buf);
    var total = vec_len(samples);
    # never walk past the storage, whatever `frames` claims
    var frames = dh_imin(DhAudioBuffer_frames(buf), total / ch);
    var params = DhDeEsser_params(self);

    # Reuse the sidechain vec: exactly `total` samples, as the oracle's resize(len).
    # Growth pushes (allocates only past the high-water mark); a shorter block
    # truncates, keeping the storage. Then copy the block in.
    var side = DhDeEsser_sidechain(self);
    var cur = vec_len(side);
    while (cur < total) { vec_push(side, 0); cur = cur + 1; }
    vec_truncate(side, total);
    var sp = dh_vec_data(samples);
    var dp = dh_vec_data(side);
    var send = sp + total * 8;
    while (sp < send) { store64(dp, load64(sp)); sp = sp + 8; dp = dp + 8; }

    # Rebind the reusable scratch AudioBuffer to this call's format, then filter.
    var scratch = DhDeEsser_scratch(self);
    DhAudioBuffer_set_samples(scratch, side);
    DhAudioBuffer_set_channels(scratch, ch);
    DhAudioBuffer_set_sample_rate(scratch, DhAudioBuffer_sample_rate(buf));
    DhAudioBuffer_set_frames(scratch, frames);
    dhvani_biquad_process(DhDeEsser_detector(self), scratch);

    var threshold_lin = db_to_amplitude(DhDeEsserParams_threshold_db(params));
    var max_reduction_lin = db_to_amplitude(f64_neg(DhDeEsserParams_reduction_db(params)));

    var sd = dh_vec_data(side);
    var d = dh_vec_data(samples);
    var stride = ch * 8;
    var off = 0;
    var oend = frames * stride;
    while (off < oend) {
        # Detect sidechain peak across channels.
        var sidechain_peak = 0;
        var c = 0;
        while (c < stride) {
            sidechain_peak = dh_max_ignore_nan(sidechain_peak, f64_abs(load64(sd + off + c)));
            c = c + 8;
        }
        # If sidechain exceeds threshold, compute proportional gain reduction.
        if (f64_gt(sidechain_peak, threshold_lin) == 1) {
            var excess_ratio = f64_div(sidechain_peak, threshold_lin);
            var reduction = f64_max(f64_div(1.0, excess_ratio), max_reduction_lin);
            var c2 = 0;
            while (c2 < stride) {
                var out = f64_mul(load64(d + off + c2), reduction);
                if (dhvani_is_finite(out) == 0) { out = 0; }
                store64(d + off + c2, out);
                c2 = c2 + 8;
            }
        }
        off = off + stride;
    }
    return 0;
}

# Give the detector its fresh-filter state for the current params + rate: new
# BandPass coefficients written in place, state zeroed, full wet, not bypassed --
# what the oracle's `BiquadFilter::new` builds, without the allocation.
fn dh_deesser_refresh_detector(self) {
    var det = DhDeEsser_detector(self);
    var params = DhDeEsser_params(self);
    DhBiquadFilter_set_sample_rate(det, DhDeEsser_sample_rate(self));
    dhvani_biquad_set_params(det, DH_BQ_BANDPASS, 0,
      DhDeEsserParams_freq_hz(params), DhDeEsserParams_q(params));
    dhvani_biquad_reset(det);
    DhBiquadFilter_set_mix(det, 1.0);
    DhBiquadFilter_set_bypassed(det, 0);
    return 0;
}

# set_sample_rate -- rebuild the detector filter for the new rate (in place).
fn dhvani_deesser_set_sample_rate(self, sample_rate) {
    DhDeEsser_set_sample_rate(self, sample_rate);
    dh_deesser_refresh_detector(self);
    return 0;
}

# reset -- clear detector filter state.
fn dhvani_deesser_reset(self) {
    dhvani_biquad_reset(DhDeEsser_detector(self));
    return 0;
}

# set_params -- validate, copy into the owned params, rebuild the detector in
# place; error code on invalid (nothing changes then). Zero bytes per call.
fn dhvani_deesser_set_params(self, params) {
    var rc = dhvani_deesserparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dh_deesserparams_copy_into(DhDeEsser_params(self), params);
    dh_deesser_refresh_detector(self);
    return DHVANI_ERR_NONE;
}

#inline
#must_use
fn dhvani_deesser_detector(self) { return DhDeEsser_detector(self); }

# --- ops.cyr ---

# ops.cyr -- buffer utilities: crossfade + fade in/out.
# Ports rust-old/src/buffer/ops.rs. L2: depends on error + buffer.
# CrossfadeType/FadeCurve enums -> codes. Result -> null-handle sentinel.
#
# The EqualPower branch called abaco::dsp::equal_power_crossfade, which is
# (cos(t*PI/2), sin(t*PI/2)); matched inline here so ops stays abaco-free.
# normalize_to_lufs (analysis-gated in Rust) is at the bottom — it pulls
# dhvani_loudness_measure_r128 + abaco db_to_amplitude, so in the dist bundle
# ops must follow loudness.

var DH_PI_2 = F64_PI_2;   # PI/2 (equal-power crossfade angle scale; exact-hex stdlib const)

# ---- CrossfadeType ----
var DH_XFADE_LINEAR      = 0;
var DH_XFADE_EQUAL_POWER = 1;

# ---- FadeCurve ----
var DH_FADE_LINEAR      = 0;
var DH_FADE_EXPONENTIAL = 1;

# crossfade(a, b, kind) -- `a` fades out, `b` fades in over their full length.
# Requires equal channels/rate/frames; returns 0 on mismatch.
#must_use
fn dhvani_ops_crossfade(a, b, kind) {
    var channels = DhAudioBuffer_channels(a);
    if (channels != DhAudioBuffer_channels(b)) { return 0; }
    if (DhAudioBuffer_sample_rate(a) != DhAudioBuffer_sample_rate(b)) { return 0; }
    var frames = DhAudioBuffer_frames(a);
    if (frames != DhAudioBuffer_frames(b)) { return 0; }
    var sa = DhAudioBuffer_samples(a);
    var sb = DhAudioBuffer_samples(b);
    var len = dh_imin(vec_len(sa), vec_len(sb));
    if (channels < 1) { len = 0; }
    var out = dh_vec_zeros(vec_len(sa));
    var pa = dh_vec_data(sa);
    var pb = dh_vec_data(sb);
    var po = dh_vec_data(out);
    # the gains depend only on the frame: computed once per frame (the same bits as
    # once per sample, at half the trig for stereo)
    var i = 0;
    var frame = 0;
    while (i < len) {
        var t = 1.0;
        if (frames > 1) { t = f64_div(f64_from(frame), f64_from(frames - 1)); }
        var gain_a = 0;
        var gain_b = 0;
        if (kind == DH_XFADE_EQUAL_POWER) {
            var angle = f64_mul(t, DH_PI_2);
            gain_a = f64_cos(angle);
            gain_b = f64_sin(angle);
        } else {
            gain_a = f64_sub(1.0, t);
            gain_b = t;
        }
        var c = 0;
        while (c < channels) {
            if (i < len) {
                var off = i * 8;
                store64(po + off, f64_add(f64_mul(load64(pa + off), gain_a), f64_mul(load64(pb + off), gain_b)));
            }
            i = i + 1;
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, channels);
    DhAudioBuffer_set_sample_rate(ob, DhAudioBuffer_sample_rate(a));
    DhAudioBuffer_set_frames(ob, frames);
    return ob;
}

# fade_in(buf, fade_frames, curve) -- ramp the first `fade_frames` up from
# silence (in place). Clamped to the buffer length.
fn dhvani_ops_fade_in(buf, fade_frames, curve) {
    var frames = DhAudioBuffer_frames(buf);
    var ff = fade_frames;
    if (ff > frames) { ff = frames; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (ch < 1) { return 0; }
    ff = dh_imin(ff, vec_len(samples) / ch);
    var p = dh_vec_data(samples);
    var frame = 0;
    while (frame < ff) {
        var t = 1.0;
        if (ff > 1) { t = f64_div(f64_from(frame), f64_from(ff - 1)); }
        var gain = t;
        if (curve == DH_FADE_EXPONENTIAL) { gain = f64_mul(t, t); }
        var c = 0;
        while (c < ch) {
            store64(p, f64_mul(load64(p), gain));
            p = p + 8;
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# fade_out(buf, fade_frames, curve) -- ramp the last `fade_frames` down to
# silence (in place). Clamped to the buffer length.
fn dhvani_ops_fade_out(buf, fade_frames, curve) {
    var frames = DhAudioBuffer_frames(buf);
    var ff = fade_frames;
    if (ff > frames) { ff = frames; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (ch < 1) { return 0; }
    # a header that claims more frames than the vec holds must not be walked past
    if (frames > vec_len(samples) / ch) { return 0; }
    var start = frames - ff;
    var frame = 0;
    while (frame < ff) {
        var t = 0;
        if (ff > 1) { t = f64_div(f64_from(frame), f64_from(ff - 1)); }
        var gain = f64_sub(1.0, t);
        if (curve == DH_FADE_EXPONENTIAL) {
            var inv = f64_sub(1.0, t);
            gain = f64_mul(inv, inv);
        }
        var c = 0;
        while (c < ch) {
            var idx = (start + frame) * ch + c;
            vec_set(samples, idx, f64_mul(vec_get(samples, idx), gain));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# normalize_to_lufs(buf, target_lufs) -- measure integrated R128 loudness, apply
# the gain needed to reach target_lufs, return the applied gain in dB. A silent
# or too-quiet signal (integrated < -120 LUFS or non-finite) is a no-op -> 0.0.
# Rust returns Result<f32>: since a valid gain_db can be negative, the Err path
# (measurement failed, e.g. empty buffer) returns NaN, not a negative code —
# callers test dhvani_is_finite (finite == success). analysis-gated: needs
# dhvani_loudness_measure_r128 (loudness.cyr) + db_to_amplitude (abaco).
#must_use
fn dhvani_ops_normalize_to_lufs(buf, target_lufs) {
    var r128 = dhvani_loudness_measure_r128(buf);
    if (r128 == 0) { return DH_NAN; }
    var current = dhvani_r128_integrated_lufs(r128);
    if (dhvani_is_finite(current) == 0) { return 0; }
    if (f64_lt(current, f64_neg(f64_from(120))) == 1) { return 0; }
    var gain_db = f64_sub(target_lufs, current);
    dhvani_buffer_apply_gain(buf, db_to_amplitude(gain_db));
    return gain_db;
}

# --- meter.cyr ---

# meter.cyr -- lock-free audio metering + block-accumulating level meter.
# Ports rust-old/src/meter/mod.rs. L1: deps error + simd + buffer + math (F64_*)
# + ganita (f64_pow) + abaco (not required here; log10 done inline via F64_LN10).
#
# ATOMICS: the Rust PeakMeter/MeterBank use AtomicU32/AtomicUsize (f32 bit
# patterns) for lock-free RT<->UI sharing. The Cyrius port is single-threaded,
# so the shared peak levels are PLAIN f64 struct fields (no atomic ops) --
# behaviorally identical for the tests. store()/load() no longer round through
# f32 bits; the whole port is f64, so store keeps the f64 value directly.
#
# RETURNS: load()/read_all() returned [f32;2] / Vec<[f32;2]> in Rust. In Cyrius
# a stereo pair is a 2-element `vec` (index 0 = left, 1 = right); read_all() is a
# `vec` of such pairs. peak()/rms()/peak_hold() return the owned `vec` handles.
# Those vec-returning reads allocate per call (the bump allocator never frees),
# so a polling reader (UI meter refresh) must use the allocation-free forms:
# the scalar getters (dhvani_meter_peak_left/right, dhvani_meter_bank_left/right)
# or the *_into forms that write a caller-owned vec.
#
# INDICES: a negative slot/channel index is out of bounds (rust-old's usize
# cannot be negative) -- the no-op / [0,0] / 0.0 fallbacks apply, never an abort.
#
# DROPPED: Debug/Display formatters, the SharedMeterBank Arc alias (Cyrius is
# single-threaded -- shared_meter_bank just builds a MeterBank), and the
# threaded store/load test (ported as a plain sequential store then load).
#
# FLOAT TRAPS: negative float literals via f64_neg (-200.0, -0.691, -70/10,
# -10/10); the decay/gate powers via f64_pow; log10(x)=ln(x)/F64_LN10.

# ---- constants (was module-level `const`) ----
# DB_FLOOR = -200.0 (silence sentinel for dB conversion).
var DH_METER_DB_FLOOR = 0xC069000000000000;        # -200.0
# LINEAR_FLOOR = 1e-10 (minimum linear amplitude treated as non-zero).
var DH_METER_LINEAR_FLOOR = 0x3DDB7CDFD9D7BDBB;    # 1e-10
# LUFS_OFFSET = -0.691 (EBU R128 offset).
var DH_METER_LUFS_OFFSET = 0xBFE61CAC083126E9;     # -0.691
# LUFS_BLOCK_DURATION = 0.4 s (EBU R128 400ms block).
var DH_METER_LUFS_BLOCK_DURATION = 0x3FD999999999999A;  # 0.4
# PEAK_DECAY_COEFFICIENT = 0.9995 per sample.
var DH_METER_PEAK_DECAY = 0x3FEFFBE76C8B4396;      # 0.9995
# MAX_LUFS_BLOCKS = 1500 (~10 min of 400ms blocks).
var DH_METER_MAX_LUFS_BLOCKS = 1500;

# log10(x) = ln(x)/ln(10); the stdlib has no f64_log10.
#must_use
fn dhvani_meter_log10(x) { return f64_div(f64_ln(x), F64_LN10); }

# linear_to_db(linear) -- 20*log10, or DB_FLOOR below LINEAR_FLOOR.
#must_use
fn dhvani_meter_linear_to_db(linear) {
    if (f64_lt(linear, DH_METER_LINEAR_FLOOR) == 1) { return DH_METER_DB_FLOOR; }
    return f64_mul(20.0, dhvani_meter_log10(linear));
}

# 1 iff 0 <= i < n (a negative index is out of bounds, as for rust-old's usize).
fn dh_meter_idx_ok(i, n) {
    if (i < 0) { return 0; }
    if (i >= n) { return 0; }
    return 1;
}

# Rewrite `out` as the pair [l, r]: truncate + push stays inside the vec's
# capacity (a vec_new() holds 16), so this allocates nothing.
fn dh_meter_write_pair(out, l, r) {
    vec_truncate(out, 0);
    vec_push(out, l);
    vec_push(out, r);
    return 0;
}

# ================================================================
# PeakMeter -- a single stereo peak level (was two AtomicU32).
# ================================================================
#derive(accessors)
struct DhPeakMeter { left; right; }

# new() -- a meter reading zero.
#must_use
fn dhvani_meter_peak_new() {
    var self = alloc(sizeof(DhPeakMeter));
    DhPeakMeter_set_left(self, 0);   # +0.0
    DhPeakMeter_set_right(self, 0);  # +0.0
    return self;
}

# store(left, right) -- set the stereo peak level.
fn dhvani_meter_peak_store(self, left, right) {
    DhPeakMeter_set_left(self, left);
    DhPeakMeter_set_right(self, right);
    return 0;
}

# load() -- a NEW 2-element vec [left, right] (allocates; for polling use
# dhvani_meter_peak_left/right or dhvani_meter_peak_load_into).
#must_use
fn dhvani_meter_peak_load(self) {
    var out = vec_new();
    vec_push(out, DhPeakMeter_left(self));
    vec_push(out, DhPeakMeter_right(self));
    return out;
}

# left()/right() -- the stored levels, no allocation.
#inline
#must_use
fn dhvani_meter_peak_left(self) { return DhPeakMeter_left(self); }
#inline
#must_use
fn dhvani_meter_peak_right(self) { return DhPeakMeter_right(self); }

# load_into(out) -- write [left, right] into caller-owned `out` (no allocation).
fn dhvani_meter_peak_load_into(self, out) {
    return dh_meter_write_pair(out, DhPeakMeter_left(self), DhPeakMeter_right(self));
}

# ================================================================
# MeterBank -- a bank of stereo peak meters with dynamic activation.
# ================================================================
#derive(accessors)
struct DhMeterBank { slots; active; }

# new(capacity) -- pre-allocate `capacity` zeroed meters, all active.
#must_use
fn dhvani_meter_bank_new(capacity) {
    var slots = vec_new();
    var i = 0;
    while (i < capacity) { vec_push(slots, dhvani_meter_peak_new()); i = i + 1; }
    var self = alloc(sizeof(DhMeterBank));
    DhMeterBank_set_slots(self, slots);
    DhMeterBank_set_active(self, vec_len(slots));
    return self;
}

# len() -- number of active slots.
#inline
#must_use
fn dhvani_meter_bank_len(self) { return DhMeterBank_active(self); }

# is_empty() -- 1 iff no active slots.
#must_use
fn dhvani_meter_bank_is_empty(self) {
    if (DhMeterBank_active(self) == 0) { return 1; }
    return 0;
}

# capacity() -- total allocated slots.
#inline
#must_use
fn dhvani_meter_bank_capacity(self) { return vec_len(DhMeterBank_slots(self)); }

# store(index, left, right) -- no-op if index out of bounds.
fn dhvani_meter_bank_store(self, index, left, right) {
    var slots = DhMeterBank_slots(self);
    if (dh_meter_idx_ok(index, vec_len(slots)) == 1) {
        dhvani_meter_peak_store(vec_get(slots, index), left, right);
    }
    return 0;
}

# load(index) -- a NEW vec [left, right], or [0.0, 0.0] if index out of bounds
# (allocates; for polling use dhvani_meter_bank_left/right or _load_into).
#must_use
fn dhvani_meter_bank_load(self, index) {
    var slots = DhMeterBank_slots(self);
    if (dh_meter_idx_ok(index, vec_len(slots)) == 1) { return dhvani_meter_peak_load(vec_get(slots, index)); }
    var zeros = vec_new();
    vec_push(zeros, 0);   # +0.0
    vec_push(zeros, 0);   # +0.0
    return zeros;
}

# left(index)/right(index) -- the slot's level, 0.0 if out of bounds; no allocation.
#must_use
fn dhvani_meter_bank_left(self, index) {
    var slots = DhMeterBank_slots(self);
    if (dh_meter_idx_ok(index, vec_len(slots)) == 0) { return 0; }
    return DhPeakMeter_left(vec_get(slots, index));
}

#must_use
fn dhvani_meter_bank_right(self, index) {
    var slots = DhMeterBank_slots(self);
    if (dh_meter_idx_ok(index, vec_len(slots)) == 0) { return 0; }
    return DhPeakMeter_right(vec_get(slots, index));
}

# load_into(index, out) -- write [left, right] (or [0.0, 0.0] out of bounds)
# into caller-owned `out`; no allocation.
fn dhvani_meter_bank_load_into(self, index, out) {
    return dh_meter_write_pair(out, dhvani_meter_bank_left(self, index), dhvani_meter_bank_right(self, index));
}

# read_all() -- a NEW vec of NEW [left,right] pairs, one per active slot
# (allocates; for polling use dhvani_meter_bank_read_all_into).
#must_use
fn dhvani_meter_bank_read_all(self) {
    var active = DhMeterBank_active(self);
    var out = vec_new();
    var i = 0;
    while (i < active) { vec_push(out, dhvani_meter_bank_load(self, i)); i = i + 1; }
    return out;
}

# read_all_into(out) -- rewrite caller-owned `out` as the FLAT interleaved list
# [l0, r0, l1, r1, ...] over the active slots; returns the slot count. Allocates
# only when `out` must grow past its capacity (first call), never in steady state.
fn dhvani_meter_bank_read_all_into(self, out) {
    var active = DhMeterBank_active(self);
    var slots = DhMeterBank_slots(self);
    vec_truncate(out, 0);
    var i = 0;
    while (i < active) {
        var s = vec_get(slots, i);
        vec_push(out, DhPeakMeter_left(s));
        vec_push(out, DhPeakMeter_right(s));
        i = i + 1;
    }
    return active;
}

# set_active(count) -- clamp to [0, capacity], then store as active.
fn dhvani_meter_bank_set_active(self, count) {
    var cap = vec_len(DhMeterBank_slots(self));
    var n = count;
    if (n > cap) { n = cap; }
    if (n < 0) { n = 0; }
    DhMeterBank_set_active(self, n);
    return 0;
}

# shared_meter_bank(capacity) -- Rust returned an Arc<MeterBank>; the
# single-threaded Cyrius port just builds a MeterBank.
#must_use
fn dhvani_meter_shared_bank(capacity) { return dhvani_meter_bank_new(capacity); }

# ================================================================
# LevelMeter -- block-accumulating meter (peak, RMS, LUFS, peak-hold).
# ================================================================
# lufs_len = the 400 ms LUFS window in frames. rust-old kept the window's
# per-frame mean squares in `lufs_buffer` and summed it once full; it is
# overwritten front to back every block, so a running sum (lufs_acc) adds the
# same values in the same order from the same +0.0 -- bit-identical, without
# the window's storage or the per-block re-read.
#derive(accessors)
struct DhLevelMeter {
    peak;
    rms;
    lufs;
    channels;
    rms_sum;
    rms_count;
    lufs_blocks;
    lufs_len;
    lufs_acc;
    lufs_buffer_pos;
    peak_hold;
    peak_decay;
}

# new(channels, sample_rate) -- allocate per-channel state; lufs = DB_FLOOR.
# sample_rate is an INTEGER Hz value like every other dhvani constructor (rust-old
# took f32; converted here). The LUFS window = trunc(sample_rate * 0.4) frames
# (Rust `as usize`). Returns 0 when that window would hold < 1 frame (sample_rate
# < 3, zero, negative -- or an f64 bit pattern passed by mistake, which reads as
# an absurd integer) or channels < 0: rust-old then pushed a NaN 0/0 block every
# frame and re-gated 1500 blocks per frame, leaving LUFS pinned at the floor.
#must_use
fn dhvani_meter_level_new(channels, sample_rate) {
    if (channels < 0) { return 0; }
    if (sample_rate <= 0) { return 0; }
    if (sample_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var buf_len = f64_to(f64_trunc(f64_mul(f64_from(sample_rate), DH_METER_LUFS_BLOCK_DURATION)));
    if (buf_len < 1) { return 0; }
    var self = alloc(sizeof(DhLevelMeter));
    DhLevelMeter_set_peak(self, dh_vec_zeros(channels));
    DhLevelMeter_set_rms(self, dh_vec_zeros(channels));
    DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR);
    DhLevelMeter_set_channels(self, channels);
    DhLevelMeter_set_rms_sum(self, dh_vec_zeros(channels));
    DhLevelMeter_set_rms_count(self, 0);
    DhLevelMeter_set_lufs_blocks(self, vec_new());
    DhLevelMeter_set_lufs_len(self, buf_len);
    DhLevelMeter_set_lufs_acc(self, 0);   # +0.0
    DhLevelMeter_set_lufs_buffer_pos(self, 0);
    DhLevelMeter_set_peak_hold(self, dh_vec_zeros(channels));
    DhLevelMeter_set_peak_decay(self, DH_METER_PEAK_DECAY);
    if (vec_len(DhLevelMeter_peak(self)) != channels) { return 0; }
    if (vec_len(DhLevelMeter_peak_hold(self)) != channels) { return 0; }
    return self;
}

# process(buf) -- analyze a buffer, update peak/rms/lufs/peak_hold.
# Walks the sample storage directly (0 bytes/sample).
# NON-FINITE samples (NaN/Inf) are skipped -- no peak, and silence in the
# RMS/LUFS sums. rust-old let one NaN make RMS NaN for the meter's lifetime (the
# sums are cumulative) and one Inf pin peak_hold at Inf and gate LUFS to the floor
# for 1500 blocks; for finite input the result is bit-identical to rust-old's.
fn dhvani_meter_level_process(self, buf) {
    if (self == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (buf == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    var frames = DhAudioBuffer_frames(buf);
    var buf_channels = DhAudioBuffer_channels(buf);
    var channels = DhLevelMeter_channels(self);
    var active_channels = buf_channels;
    if (channels < active_channels) { active_channels = channels; }
    if (active_channels < 0) { active_channels = 0; }
    var samples = DhAudioBuffer_samples(buf);
    # never walk past the storage of an inconsistent buffer
    if (buf_channels > 0) {
        var avail = vec_len(samples) / buf_channels;
        if (frames > avail) { frames = avail; }
    }
    if (frames < 0) { frames = 0; }
    var peak = DhLevelMeter_peak(self);
    var rms = DhLevelMeter_rms(self);
    var lufs_blocks = DhLevelMeter_lufs_blocks(self);
    var lufs_len = DhLevelMeter_lufs_len(self);
    var sd = dh_vec_data(samples);
    var pk = dh_vec_data(peak);
    var rs = dh_vec_data(DhLevelMeter_rms_sum(self));
    var stride = buf_channels * 8;

    # Reset per-block peak.
    var rp = 0;
    while (rp < channels) { store64(pk + rp * 8, 0); rp = rp + 1; }

    var rms_count = DhLevelMeter_rms_count(self);
    var lufs_pos = DhLevelMeter_lufs_buffer_pos(self);
    var lufs_acc = DhLevelMeter_lufs_acc(self);
    var fac = f64_from(active_channels);

    var frame = 0;
    var fp = sd;
    while (frame < frames) {
        var channel_sq_sum = 0;   # +0.0
        var ch = 0;
        while (ch < active_channels) {
            var sample = load64(fp + ch * 8);
            # finite <=> exponent field not all ones
            if (((sample >> 52) & 0x7FF) != 0x7FF) {
                var absval = f64_abs(sample);
                var pslot = pk + ch * 8;
                if (f64_gt(absval, load64(pslot)) == 1) { store64(pslot, absval); }
                var sq = f64_mul(sample, sample);
                var rslot = rs + ch * 8;
                store64(rslot, f64_add(load64(rslot), sq));
                channel_sq_sum = f64_add(channel_sq_sum, sq);
            }
            ch = ch + 1;
        }

        rms_count = rms_count + 1;

        var mean_sq = 0;   # +0.0
        if (active_channels > 0) { mean_sq = f64_div(channel_sq_sum, fac); }
        if (lufs_pos < lufs_len) {
            lufs_acc = f64_add(lufs_acc, mean_sq);
            lufs_pos = lufs_pos + 1;
        }

        if (lufs_pos >= lufs_len) {
            vec_push(lufs_blocks, f64_div(lufs_acc, f64_from(lufs_len)));
            lufs_acc = 0;   # +0.0
            lufs_pos = 0;
            dhvani_meter_level_compute_lufs(self);
        }
        frame = frame + 1;
        fp = fp + stride;
    }

    DhLevelMeter_set_rms_count(self, rms_count);
    DhLevelMeter_set_lufs_buffer_pos(self, lufs_pos);
    DhLevelMeter_set_lufs_acc(self, lufs_acc);

    # Update RMS.
    if (rms_count > 0) {
        var fcount = f64_from(rms_count);
        var rd = dh_vec_data(rms);
        var uc = 0;
        while (uc < channels) {
            store64(rd + uc * 8, f64_sqrt(f64_div(load64(rs + uc * 8), fcount)));
            uc = uc + 1;
        }
    }

    # Update peak hold with decay (scaled by frame count).
    var hd = dh_vec_data(DhLevelMeter_peak_hold(self));
    var decay = f64_pow(DhLevelMeter_peak_decay(self), f64_from(frames));
    var hc = 0;
    while (hc < channels) {
        var pv = load64(pk + hc * 8);
        var hslot = hd + hc * 8;
        if (f64_gt(pv, load64(hslot)) == 1) {
            store64(hslot, pv);
        } else {
            store64(hslot, f64_mul(load64(hslot), decay));
        }
        hc = hc + 1;
    }
    return 0;
}

# compute_lufs() -- simplified EBU R128 gating over lufs_blocks.
fn dhvani_meter_level_compute_lufs(self) {
    var lufs_blocks = DhLevelMeter_lufs_blocks(self);
    var n = vec_len(lufs_blocks);
    if (n == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }
    if (n > DH_METER_MAX_LUFS_BLOCKS) {
        var drain_count = n - DH_METER_MAX_LUFS_BLOCKS;
        var d = 0;
        while (d < drain_count) { vec_remove(lufs_blocks, 0); d = d + 1; }
        n = vec_len(lufs_blocks);
    }

    # abs_gate = 10^(-70/10) = 10^-7.
    var abs_gate = f64_pow(10.0, f64_neg(f64_div(70.0, 10.0)));

    var gated_count = 0;
    var gated_sum = 0;   # +0.0
    var i = 0;
    while (i < n) {
        var p = vec_get(lufs_blocks, i);
        if (f64_gt(p, abs_gate) == 1) { gated_count = gated_count + 1; gated_sum = f64_add(gated_sum, p); }
        i = i + 1;
    }

    if (gated_count == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }

    var mean_power = f64_div(gated_sum, f64_from(gated_count));
    # rel_gate = mean_power * 10^(-10/10) = mean_power * 0.1.
    var rel_gate = f64_mul(mean_power, f64_pow(10.0, f64_neg(f64_div(10.0, 10.0))));

    var final_count = 0;
    var final_sum = 0;   # +0.0
    var j = 0;
    while (j < n) {
        var pp = vec_get(lufs_blocks, j);
        if (f64_gt(pp, abs_gate) == 1) {
            if (f64_gt(pp, rel_gate) == 1) { final_count = final_count + 1; final_sum = f64_add(final_sum, pp); }
        }
        j = j + 1;
    }

    if (final_count == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }

    var integrated = f64_div(final_sum, f64_from(final_count));
    DhLevelMeter_set_lufs(self, f64_add(DH_METER_LUFS_OFFSET, f64_mul(10.0, dhvani_meter_log10(integrated))));
    return 0;
}

# --- accessors ---
#inline
#must_use
fn dhvani_meter_level_peak(self) { return DhLevelMeter_peak(self); }
#inline
#must_use
fn dhvani_meter_level_rms(self) { return DhLevelMeter_rms(self); }
#inline
#must_use
fn dhvani_meter_level_lufs(self) { return DhLevelMeter_lufs(self); }

# dB of v[channel], or of 0.0 (-> DB_FLOOR) if channel is out of range.
fn dh_meter_chan_db(v, channel) {
    var x = 0;   # +0.0 (Rust unwrap_or(0.0))
    if (dh_meter_idx_ok(channel, vec_len(v)) == 1) { x = vec_get(v, channel); }
    return dhvani_meter_linear_to_db(x);
}

# peak_db(channel) -- dB of the channel's peak (0.0 if channel out of range).
#must_use
fn dhvani_meter_level_peak_db(self, channel) { return dh_meter_chan_db(DhLevelMeter_peak(self), channel); }

# rms_db(channel) -- dB of the channel's RMS (0.0 if out of range).
#must_use
fn dhvani_meter_level_rms_db(self, channel) { return dh_meter_chan_db(DhLevelMeter_rms(self), channel); }

# peak_hold_db(channel) -- dB of the channel's peak hold (0.0 if out of range).
#must_use
fn dhvani_meter_level_peak_hold_db(self, channel) { return dh_meter_chan_db(DhLevelMeter_peak_hold(self), channel); }

#inline
#must_use
fn dhvani_meter_level_peak_hold(self) { return DhLevelMeter_peak_hold(self); }
#inline
#must_use
fn dhvani_meter_level_channels(self) { return DhLevelMeter_channels(self); }

# zero every entry of a vec by walking its storage.
fn dh_meter_zero(v) {
    var p = dh_vec_data(v);
    var end = p + vec_len(v) * 8;
    while (p < end) { store64(p, 0); p = p + 8; }
    return 0;
}

# reset() -- clear all meter state (no allocation: lufs_blocks is truncated,
# keeping its capacity, rather than replaced).
fn dhvani_meter_level_reset(self) {
    if (self == 0) { return DHVANI_ERR_INVALID_PARAMETER; }
    dh_meter_zero(DhLevelMeter_peak(self));
    dh_meter_zero(DhLevelMeter_rms(self));
    DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR);
    dh_meter_zero(DhLevelMeter_rms_sum(self));
    DhLevelMeter_set_rms_count(self, 0);
    vec_truncate(DhLevelMeter_lufs_blocks(self), 0);
    DhLevelMeter_set_lufs_acc(self, 0);   # +0.0
    DhLevelMeter_set_lufs_buffer_pos(self, 0);
    dh_meter_zero(DhLevelMeter_peak_hold(self));
    return 0;
}

# --- midi_routing.cyr ---

# midi_routing.cyr -- MIDI channel/note filtering, velocity curves, CC mapping.
# Ports rust-old/src/midi/routing.rs. Pure integer logic for routing/filtering;
# f64 arithmetic only in the velocity curves (sqrt/square) and CC value mapping.
# L1: deps error + midi (consumes DhNoteEvent + dhvani_note_event_*). serde
# dropped.
#
# VelocityCurve (data-carrying enum) -> a `kind` code + a separate fixed-value
# payload threaded through apply(). Option<u8> channel_filter -> -1 sentinel for
# None (channels are 0..15). Prefix dhvani_midiroute_ (dsp routing owns
# dhvani_routing_).

# ================================================================
# VelocityCurve -- kind codes. The Fixed(u8) payload rides as a separate arg.
# ================================================================
var DH_MIDIROUTE_CURVE_LINEAR = 0;
var DH_MIDIROUTE_CURVE_SOFT   = 1;
var DH_MIDIROUTE_CURVE_HARD   = 2;
var DH_MIDIROUTE_CURVE_FIXED  = 3;

# Rust float `as u8`: truncate toward zero, SATURATING to 0..255 (NaN -> 0).
# f64_to alone truncates without saturating, so Hard(200) gave 314 not 255.
#must_use
fn dh_midiroute_f64_as_u8(x) {
    if (f64_ge(x, 1.0) == 0) { return 0; }      # NaN, negative, [0,1) -> 0
    if (f64_ge(x, 255.0) == 1) { return 255; }
    return f64_to(x);
}

# Normalise a curve code: anything outside the four known codes -> LINEAR, so a
# bad code can no longer silently act as Fixed(payload) (Fixed(0) = all
# note-offs).
#must_use
fn dh_midiroute_curve_code(kind) {
    if (kind == DH_MIDIROUTE_CURVE_SOFT) { return kind; }
    if (kind == DH_MIDIROUTE_CURVE_HARD) { return kind; }
    if (kind == DH_MIDIROUTE_CURVE_FIXED) { return kind; }
    return DH_MIDIROUTE_CURVE_LINEAR;
}

# Apply a velocity curve to a raw 0..127 velocity. `kind` is one of the curve
# codes; `fixed_value` is only read when kind == FIXED. Soft/Hard emulate Rust
# `as u8` (truncate + saturate to 0..255). Unknown codes behave as LINEAR.
# The f32 oracle and this f64 port agree exactly on every velocity 0..255.
#must_use
fn dhvani_midiroute_curve_apply(kind, fixed_value, velocity) {
    if (kind == DH_MIDIROUTE_CURVE_SOFT) {
        var ns = f64_div(f64_from(velocity), 127.0);
        return dh_midiroute_f64_as_u8(f64_mul(f64_sqrt(ns), 127.0));
    }
    if (kind == DH_MIDIROUTE_CURVE_HARD) {
        var nh = f64_div(f64_from(velocity), 127.0);
        return dh_midiroute_f64_as_u8(f64_mul(f64_mul(nh, nh), 127.0));
    }
    if (kind == DH_MIDIROUTE_CURVE_FIXED) { return fixed_value; }
    return velocity;
}

# ================================================================
# MidiRoute -- filter + transform rule.
# channel_filter: -1 = None (all channels), else 0..15.
# velocity_curve: a curve kind code (unknown codes stored as LINEAR);
# velocity_fixed holds the Fixed payload.
# note_min/note_max: inclusive note range (0..127, min <= max).
# ================================================================
#derive(accessors)
struct DhMidiRoute { channel_filter; velocity_curve; velocity_fixed; note_min; note_max; }

# Clamp a channel-filter Option to 0..15. `ch` == -1 means None (kept as -1).
#must_use
fn dh_midiroute_clamp_channel(ch) {
    if (ch < 0) { return (0 - 1); }
    if (ch > 15) { return 15; }
    return ch;
}

# new(channel_filter, velocity_curve, velocity_fixed, note_min, note_max).
# channel_filter -1 = None. note_range clamped so min <= max and both 0..127.
#must_use
fn dhvani_midiroute_new(channel_filter, velocity_curve, velocity_fixed, note_min, note_max) {
    var self = alloc(sizeof(DhMidiRoute));
    DhMidiRoute_set_channel_filter(self, dh_midiroute_clamp_channel(channel_filter));
    DhMidiRoute_set_velocity_curve(self, dh_midiroute_curve_code(velocity_curve));
    DhMidiRoute_set_velocity_fixed(self, velocity_fixed);
    var lo = note_min;
    if (lo > 127) { lo = 127; }
    var hi = note_max;
    if (hi > 127) { hi = 127; }
    if (hi < lo) { hi = lo; }
    DhMidiRoute_set_note_min(self, lo);
    DhMidiRoute_set_note_max(self, hi);
    return self;
}

# passthrough -- all events unmodified: no channel filter, Linear, full range.
#must_use
fn dhvani_midiroute_passthrough() {
    return dhvani_midiroute_new((0 - 1), DH_MIDIROUTE_CURVE_LINEAR, 0, 0, 127);
}

# default == passthrough.
#must_use
fn dhvani_midiroute_default() { return dhvani_midiroute_passthrough(); }

#inline
#must_use
fn dhvani_midiroute_channel_filter(self) { return DhMidiRoute_channel_filter(self); }
#inline
#must_use
fn dhvani_midiroute_velocity_curve(self) { return DhMidiRoute_velocity_curve(self); }
#inline
#must_use
fn dhvani_midiroute_velocity_fixed(self) { return DhMidiRoute_velocity_fixed(self); }
#inline
#must_use
fn dhvani_midiroute_note_min(self) { return DhMidiRoute_note_min(self); }
#inline
#must_use
fn dhvani_midiroute_note_max(self) { return DhMidiRoute_note_max(self); }

# set_channel_filter -- -1 = None; otherwise clamped to 0..15.
fn dhvani_midiroute_set_channel_filter(self, channel) {
    DhMidiRoute_set_channel_filter(self, dh_midiroute_clamp_channel(channel));
    return 0;
}

# set_velocity_curve -- kind + Fixed payload (ignored for non-Fixed). Unknown
# kind codes are stored as LINEAR.
fn dhvani_midiroute_set_velocity_curve(self, velocity_curve, velocity_fixed) {
    DhMidiRoute_set_velocity_curve(self, dh_midiroute_curve_code(velocity_curve));
    DhMidiRoute_set_velocity_fixed(self, velocity_fixed);
    return 0;
}

# set_note_range -- clamp to 0..127 with min <= max.
fn dhvani_midiroute_set_note_range(self, min, max) {
    var lo = min;
    if (lo > 127) { lo = 127; }
    var hi = max;
    if (hi > 127) { hi = 127; }
    if (hi < lo) { hi = lo; }
    DhMidiRoute_set_note_min(self, lo);
    DhMidiRoute_set_note_max(self, hi);
    return 0;
}

# 1 iff `event` passes the channel filter and the note range.
#must_use
fn dh_midiroute_accepts(self, event) {
    var cf = DhMidiRoute_channel_filter(self);
    if (cf >= 0) {
        if (dhvani_note_event_channel(event) != cf) { return 0; }
    }
    var note = dhvani_note_event_note(event);
    if (note < DhMidiRoute_note_min(self)) { return 0; }
    if (note > DhMidiRoute_note_max(self)) { return 0; }
    return 1;
}

# filter_event_into -- zero-alloc filter + transform. If `event` passes, writes
# the velocity-transformed copy into the caller-owned DhNoteEvent `out` and
# returns 1; if rejected, returns 0 and leaves `out` untouched. `out` may be
# `event` itself (in-place transform).
fn dhvani_midiroute_filter_event_into(self, event, out) {
    if (dh_midiroute_accepts(self, event) == 0) { return 0; }
    var vel = dhvani_midiroute_curve_apply(
      DhMidiRoute_velocity_curve(self),
      DhMidiRoute_velocity_fixed(self),
      dhvani_note_event_velocity(event));
    dhvani_note_event_init(
      out,
      dhvani_note_event_position(event),
      dhvani_note_event_duration(event),
      dhvani_note_event_note(event),
      vel,
      dhvani_note_event_channel(event));
    return 1;
}

# filter_event -- filter + transform a DhNoteEvent. Returns a NEW DhNoteEvent
# handle (velocity-transformed clone) if the event passes, or 0 (None) if the
# channel filter or note range rejects it. Allocates 40 B per passing event --
# per-event RT paths use filter_event_into.
#must_use
fn dhvani_midiroute_filter_event(self, event) {
    if (dh_midiroute_accepts(self, event) == 0) { return 0; }
    var out = alloc(sizeof(DhNoteEvent));
    dhvani_midiroute_filter_event_into(self, event, out);
    return out;
}

# ================================================================
# CcMapping -- maps a MIDI CC number to a parameter value range.
# cc: 0..127; param_index: usize; min_value/max_value: f64 param bounds.
# ================================================================
#derive(accessors)
struct DhCcMapping { cc; param_index; min_value; max_value; }

#must_use
fn dhvani_midiroute_cc_new(cc, param_index, min_value, max_value) {
    var m = alloc(sizeof(DhCcMapping));
    DhCcMapping_set_cc(m, cc);
    DhCcMapping_set_param_index(m, param_index);
    DhCcMapping_set_min_value(m, min_value);
    DhCcMapping_set_max_value(m, max_value);
    return m;
}

#inline
#must_use
fn dhvani_midiroute_cc_number(m) { return DhCcMapping_cc(m); }
#inline
#must_use
fn dhvani_midiroute_cc_param_index(m) { return DhCcMapping_param_index(m); }
#inline
#must_use
fn dhvani_midiroute_cc_min_value(m) { return DhCcMapping_min_value(m); }
#inline
#must_use
fn dhvani_midiroute_cc_max_value(m) { return DhCcMapping_max_value(m); }

# map_value -- 7-bit CC (0..127) -> param range: min + (cc/127)*(max-min).
#must_use
fn dhvani_midiroute_cc_map_value(m, cc_value) {
    var norm = f64_div(f64_from(cc_value), 127.0);
    return f64_add(
      DhCcMapping_min_value(m),
      f64_mul(norm, f64_sub(DhCcMapping_max_value(m), DhCcMapping_min_value(m))));
}

# map_value_32 -- 32-bit CC (MIDI 2.0) -> param range. u32::MAX = 4294967295
# exceeds 2^24 so build the f64 via f64_from(int), not a decimal literal.
#must_use
fn dhvani_midiroute_cc_map_value_32(m, cc_value) {
    var norm = f64_div(f64_from(cc_value), f64_from(4294967295));
    return f64_add(
      DhCcMapping_min_value(m),
      f64_mul(norm, f64_sub(DhCcMapping_max_value(m), DhCcMapping_min_value(m))));
}

# --- midi_v2.cyr ---

# midi_v2.cyr -- MIDI 2.0 / UMP types: 16-bit velocity, 32-bit CC, per-note
# expression. Ports rust-old/src/midi/v2.rs. L0: dep error only (all integer
# logic -- MIDI note/velocity/channel/CC are ints; no floats here).
#
# The data structs (NoteOnV2, NoteOffV2, ControlChangeV2, PerNotePitchBend,
# PerNoteController, ChannelPressureV2, PolyPressureV2, PitchBendV2) -> Dh<Name>
# structs with untyped i64 slots (FramePos u64, u8/u16/u32 fields all fit).
# The UmpMessageType enum (#[non_exhaustive], 6 variants) -> DH_UMP_* int codes
# (the variant order happens to equal the UMP Message Type nibble 0x0..0x5).
# serde dropped (Cyrius has no derive-serde).
#
# Every constructor allocates (free-less bump allocator); each has a zero-alloc
# `*_init(e, ...)` twin that (re)initialises a caller-owned handle and returns
# it, for event reuse in a render loop. The constructors are alloc + _init.

# ---- UmpMessageType (enum -> int codes, in Rust variant order) ----
var DH_UMP_UTILITY            = 0;   # Utility (JR Timestamp, JR Clock)
var DH_UMP_SYSTEM_COMMON      = 1;   # System Real-Time / System Common (MIDI 1.0)
var DH_UMP_MIDI1_CHANNEL_VOICE = 2;  # MIDI 1.0 Channel Voice (7-bit)
var DH_UMP_DATA64             = 3;   # Data messages (SysEx 7-bit)
var DH_UMP_MIDI2_CHANNEL_VOICE = 4;  # MIDI 2.0 Channel Voice (32-bit)
var DH_UMP_DATA128            = 5;   # Data messages (SysEx 8-bit)

# ---- NoteOnV2 (16-bit velocity, per-note attributes) ----
#derive(accessors)
struct DhNoteOnV2 { position; note; velocity; channel; attribute_type; attribute_data; }
fn dhvani_midi2_note_on_init(e, position, note, velocity, channel, attribute_type, attribute_data) {
    DhNoteOnV2_set_position(e, position);
    DhNoteOnV2_set_note(e, note);
    DhNoteOnV2_set_velocity(e, velocity);
    DhNoteOnV2_set_channel(e, channel);
    DhNoteOnV2_set_attribute_type(e, attribute_type);
    DhNoteOnV2_set_attribute_data(e, attribute_data);
    return e;
}
#must_use
fn dhvani_midi2_note_on_new(position, note, velocity, channel, attribute_type, attribute_data) {
    return dhvani_midi2_note_on_init(
      alloc(sizeof(DhNoteOnV2)), position, note, velocity, channel, attribute_type, attribute_data);
}
#inline
#must_use
fn dhvani_midi2_note_on_position(e) { return DhNoteOnV2_position(e); }
#inline
#must_use
fn dhvani_midi2_note_on_note(e) { return DhNoteOnV2_note(e); }
