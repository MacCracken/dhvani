# limiter.tcyr -- parity tests for src/limiter.cyr
# Ported one-for-one from the 8 #[test] blocks in rust-old/src/dsp/limiter.rs.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/dsp.cyr"
include "src/limiter.cyr"

alloc_init();

fn make_sine(amplitude, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(i)), f64_from(44100));
        vec_push(v, f64_mul(amplitude, f64_sin(ph)));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 1, 44100);
}
fn all_finite(buf) {
    var s = dhvani_buffer_samples(buf);
    var n = vec_len(s); var i = 0;
    while (i < n) { if (dhvani_is_finite(vec_get(s, i)) == 0) { return 0; } i = i + 1; }
    return 1;
}

# ---- below_ceiling_unchanged ----
test_group("below_ceiling_unchanged");
var l1 = dhvani_lim_new(dhvani_limparams_new(0, 50.0, 0, 1.0), 44100);
var b1 = make_sine(0.5, 4096);
var r1 = dhvani_buffer_rms(b1);
dhvani_lim_process(l1, b1);
assert(f64_lt(f64_abs(f64_sub(dhvani_buffer_rms(b1), r1)), f64_mul(r1, 0.05)), "below ceiling ~unchanged");

# ---- above_ceiling_limited ----
test_group("above_ceiling_limited");
var l2 = dhvani_lim_new(dhvani_limparams_new(f64_neg(6.0), 10.0, 0, 1.0), 44100);
var b2 = make_sine(1.0, 4096);
dhvani_lim_process(l2, b2);
var cl2 = db_to_amplitude(f64_neg(6.0));
assert(f64_le(dhvani_buffer_peak(b2), f64_add(cl2, 0.01)), "peak at/below ceiling");

# ---- output_finite ----
test_group("output_finite");
var l3 = dhvani_lim_new(dhvani_limparams_default(), 44100);
var b3 = make_sine(2.0, 4096);
dhvani_lim_process(l3, b3);
assert_eq(all_finite(b3), 1, "output finite");

# ---- reset_clears_state ----
test_group("reset_clears_state");
var l4 = dhvani_lim_new(dhvani_limparams_default(), 44100);
var b4 = make_sine(1.0, 1024);
dhvani_lim_process(l4, b4);
dhvani_lim_reset(l4);
assert(f64_lt(f64_abs(f64_add(dhvani_lim_envelope_db(l4), 120.0)), 0.0000001), "envelope reset to -120");

# ---- soft_knee_limits ----
test_group("soft_knee_limits");
var l5 = dhvani_lim_new(dhvani_limparams_new(f64_neg(6.0), 10.0, 6.0, 1.0), 44100);
var b5 = make_sine(1.0, 4096);
dhvani_lim_process(l5, b5);
var cl5 = db_to_amplitude(f64_neg(6.0));
assert(f64_le(dhvani_buffer_peak(b5), f64_add(cl5, 0.02)), "soft-knee peak <= ceiling");
assert_eq(all_finite(b5), 1, "soft-knee output finite");

# ---- gain_reduction_reports ----
test_group("gain_reduction_reports");
var l6 = dhvani_lim_new(dhvani_limparams_new(f64_neg(12.0), 10.0, 0, 1.0), 44100);
var b6 = make_sine(1.0, 4096);
dhvani_lim_process(l6, b6);
assert(f64_lt(dhvani_lim_gain_reduction_db(l6), 0), "gain reduction applied");

# ---- set_params_updates ----
test_group("set_params_updates");
var l7 = dhvani_lim_new(dhvani_limparams_default(), 44100);
var l7p = dhvani_limparams_new(f64_neg(3.0), 100.0, 3.0, 1.0);
assert_eq(dhvani_lim_set_params(l7, l7p), DHVANI_ERR_NONE, "set_params ok");
var b7 = make_sine(1.0, 2048);
dhvani_lim_process(l7, b7);
assert_eq(all_finite(b7), 1, "finite after set_params");

# ---- stereo_limiting ----
test_group("stereo_limiting");
var l8 = dhvani_lim_new(dhvani_limparams_new(f64_neg(6.0), 10.0, 0, 1.0), 44100);
var sv8 = vec_new();
var si8 = 0;
while (si8 < 8192) {
    var ph8 = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(si8 / 2)), f64_from(44100));
    vec_push(sv8, f64_sin(ph8));
    si8 = si8 + 1;
}
var b8 = dhvani_buffer_from_interleaved(sv8, 2, 44100);
dhvani_lim_process(l8, b8);
var cl8 = db_to_amplitude(f64_neg(6.0));
assert(f64_le(dhvani_buffer_peak(b8), f64_add(cl8, 0.02)), "stereo peak <= ceiling");

# ---- release_time_constant_uses_sample_rate (regression, 2.2.7) ----
# Same defect as compressor.tcyr's attack_time_constant_uses_sample_rate: the
# integer rate reached abaco's f64 time_constant raw. Frame 0 at 0 dB snaps env
# to 0 (instant attack); 480 silent frames (input floors at -120 dB) through a
# 100 ms release at 48 kHz then give env = -120 * (1 - c^480), c = exp(-1/4800),
# i.e. -120 * (1 - exp(-0.1)). The collapsed coefficient lands at ~-120 instead.
test_group("release_time_constant_uses_sample_rate");
var l9 = dhvani_lim_new(dhvani_limparams_new(0, 100.0, 0, 1.0), 48000);
var v9 = vec_new();
vec_push(v9, 1.0);
var i9 = 0;
while (i9 < 480) { vec_push(v9, 0); i9 = i9 + 1; }
var b9 = dhvani_buffer_from_interleaved(v9, 1, 48000);
dhvani_lim_process(l9, b9);
var want9 = f64_mul(f64_neg(120.0), f64_sub(1.0, f64_exp(f64_neg(0.1))));
var err9 = f64_abs(f64_sub(dhvani_lim_envelope_db(l9), want9));
assert(f64_lt(err9, 0.000001), "100 ms release @48k: env -120*(1-exp(-0.1)) after 10 ms");

# ================================================================
# 2.3.2 hardening regressions (each fails on the 2.3.2 code)
# ================================================================
var lx_nan = 0x7FF8000000000000;

fn lx_mono(n, val) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, val); i = i + 1; }
    return dhvani_buffer_from_interleaved(v, 1, 48000);
}
fn lx_stereo(frames, phase0) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var t = f64_from(i + phase0);
        vec_push(v, f64_mul(f64_sin(f64_mul(t, 0.0627)), 1.4));
        vec_push(v, f64_mul(f64_sin(f64_mul(t, 0.31)), 0.6));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 2, 48000);
}

# ---- nonfinite_sample_does_not_latch ----
# In the oracle a single +Inf drove envelope_db to +Inf for good (gain -Inf, skipped),
# leaving a hard clipper with no release; a NaN passed the "brick wall" untouched.
test_group("nonfinite_sample_does_not_latch");
var lx_l = dhvani_lim_new(dhvani_limparams_default(), 48000);
var lx_b1 = lx_mono(1, DH_POS_INF);
dhvani_lim_process(lx_l, lx_b1);
assert_eq(vec_get(dhvani_buffer_samples(lx_b1), 0), 0, "+Inf in -> 0 out");
assert_eq(dhvani_is_finite(dhvani_lim_envelope_db(lx_l)), 1, "envelope stays finite");
var lx_b2 = lx_mono(48000, 0.05);
dhvani_lim_process(lx_l, lx_b2);
assert_eq(dhvani_lim_gain_reduction_db(lx_l), 0, "quiet signal 1 s later: the envelope released");
var lx_n = dhvani_lim_new(dhvani_limparams_default(), 48000);
var lx_nv = vec_new(); vec_push(lx_nv, lx_nan); vec_push(lx_nv, 0.25);
var lx_nb = dhvani_buffer_from_interleaved(lx_nv, 2, 48000);
dhvani_lim_process(lx_n, lx_nb);
assert_eq(vec_get(dhvani_buffer_samples(lx_nb), 0), 0, "NaN in -> 0 out");
assert_eq(vec_get(dhvani_buffer_samples(lx_nb), 1), 0.25, "the finite channel passes (under the ceiling)");
assert_eq(dhvani_is_finite(dhvani_lim_envelope_db(lx_n)), 1, "NaN never reaches the detector");

# ---- validate_rejects_nan ----
# The oracle's `ceiling_db > 0.0` / `release_ms < 0.0` tests let a NaN through.
test_group("validate_rejects_nan");
fn lx_pv(ceiling, release, knee) {
    return dhvani_limparams_validate(dhvani_limparams_new(ceiling, release, knee, 1.0));
}
var lx_bad = DHVANI_ERR_INVALID_PARAMETER;
assert_eq(lx_pv(lx_nan, 50.0, 0), lx_bad, "NaN ceiling");
assert_eq(lx_pv(f64_neg(0.3), lx_nan, 0), lx_bad, "NaN release");
assert_eq(lx_pv(f64_neg(0.3), 50.0, lx_nan), lx_bad, "NaN knee");
assert_eq(dhvani_lim_new(dhvani_limparams_new(lx_nan, 50.0, 0, 1.0), 48000), 0, "new() refuses NaN ceiling");
assert_eq(lx_pv(0, 0, 0), DHVANI_ERR_NONE, "bounds inclusive");
assert_eq(lx_pv(DH_NEG_INF, 0, 0), DHVANI_ERR_NONE, "-Inf ceiling valid, as in the oracle");

# ---- params_owned ----
test_group("params_owned");
var lx_p = dhvani_limparams_default();
var lx_o = dhvani_lim_new(lx_p, 48000);
DhLimiterParams_set_ceiling_db(lx_p, 6.0);
assert_eq(DhLimiterParams_ceiling_db(DhEnvelopeLimiter_params(lx_o)), f64_neg(0.3), "new(): ceiling still -0.3 dB");
var lx_q = dhvani_limparams_new(f64_neg(1.0), 20.0, 0, 1.0);
var lx_u = alloc_used();
assert_eq(dhvani_lim_set_params(lx_o, lx_q), DHVANI_ERR_NONE, "set_params ok");
assert_eq(alloc_used() - lx_u, 0, "set_params allocates nothing");
DhLimiterParams_set_ceiling_db(lx_q, 6.0);
var lx_oc = DhLimiterParams_ceiling_db(DhEnvelopeLimiter_params(lx_o));
assert_eq(lx_oc, f64_neg(1.0), "set_params(): ceiling still -1 dB");

# ---- process_matches_reference ----
# The 2.3.2 loop, verbatim: the hoisted, storage-walking process() gives the same bits
# on finite input.
fn lx_old_process(self, buf) {
    var p = DhEnvelopeLimiter_params(self);
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var release_coeff = time_constant(DhLimiterParams_release_ms(p), f64_from(DhEnvelopeLimiter_sample_rate(self)));
    var ceiling_lin = db_to_amplitude(DhLimiterParams_ceiling_db(p));
    var neg_ceiling = f64_neg(ceiling_lin);
    var mix = f64_clamp(DhLimiterParams_mix(p), 0, 1.0);
    var dry = f64_sub(1.0, mix);
    var env_db = DhEnvelopeLimiter_envelope_db(self);
    var frame = 0;
    while (frame < frames) {
        var peak = 0;
        var c = 0;
        while (c < ch) {
            peak = dh_max_ignore_nan(peak, f64_abs(vec_get(samples, frame * ch + c)));
            c = c + 1;
        }
        var input_db = f64_max(amplitude_to_db(peak), f64_neg(120.0));
        if (f64_gt(input_db, env_db) == 1) {
            env_db = input_db;
        } else {
            env_db = f64_add(f64_mul(release_coeff, env_db), f64_mul(f64_sub(1.0, release_coeff), input_db));
        }
        var gain_db = dhvani_lim_compute_gain(self, env_db);
        if (f64_lt(gain_db, 0) == 1) {
            if (dhvani_is_finite(gain_db) == 1) {
                var gain_lin = db_to_amplitude(gain_db);
                var c2 = 0;
                while (c2 < ch) {
                    var idx = frame * ch + c2;
                    var dry_sample = vec_get(samples, idx);
                    var wet = f64_mul(f64_mul(dry_sample, gain_lin), mix);
                    vec_set(samples, idx, f64_add(f64_mul(dry_sample, dry), wet));
                    c2 = c2 + 1;
                }
            }
        }
        var c3 = 0;
        while (c3 < ch) {
            var idx3 = frame * ch + c3;
            vec_set(samples, idx3, f64_clamp(vec_get(samples, idx3), neg_ceiling, ceiling_lin));
            c3 = c3 + 1;
        }
        frame = frame + 1;
    }
    DhEnvelopeLimiter_set_envelope_db(self, env_db);
    return 0;
}
test_group("process_matches_reference");
var lx_rp = dhvani_limparams_new(f64_neg(1.5), 30.0, 4.0, 0.8);
var lx_rn = dhvani_lim_new(lx_rp, 48000);
var lx_ro = dhvani_lim_new(lx_rp, 48000);
var lx_rok = 1;
var lx_rb = 0;
while (lx_rb < 3) {
    var lx_ba = lx_stereo(500, lx_rb * 500);
    var lx_bb = lx_stereo(500, lx_rb * 500);
    var lx_ru = alloc_used();
    dhvani_lim_process(lx_rn, lx_ba);
    if (alloc_used() != lx_ru) { lx_rok = 0; }
    lx_old_process(lx_ro, lx_bb);
    var lx_sa = dhvani_buffer_samples(lx_ba);
    var lx_sb = dhvani_buffer_samples(lx_bb);
    var lx_ri = 0;
    while (lx_ri < 1000) { if (vec_get(lx_sa, lx_ri) != vec_get(lx_sb, lx_ri)) { lx_rok = 0; } lx_ri = lx_ri + 1; }
    if (dhvani_lim_envelope_db(lx_rn) != dhvani_lim_envelope_db(lx_ro)) { lx_rok = 0; }
    lx_rb = lx_rb + 1;
}
assert_eq(lx_rok, 1, "bit-identical to the 2.3.2 loop (samples, envelope), 0 bytes");

var rc = assert_summary();
syscall(60, rc);
