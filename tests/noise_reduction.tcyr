# noise_reduction.tcyr -- parity tests for src/noise_reduction.cyr
# Ported one-for-one from the 6 #[test] blocks in
# rust-old/src/dsp/noise_reduction.rs. No serde/Display tests to drop.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/fft.cyr"
include "src/noise_reduction.cyr"

alloc_init();

# amp * sin(2*PI*freq*i/sr), interleaved mono, `frames` samples.
fn nr_make_sine(amp, freq, sr, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), freq), f64_from(i)), f64_from(sr));
        vec_push(v, f64_mul(amp, f64_sin(ph)));
        i = i + 1;
    }
    return v;
}

# 1 if every sample in the buffer is finite, else 0.
fn nr_all_finite(buf) {
    var s = DhAudioBuffer_samples(buf);
    var n = vec_len(s);
    var i = 0;
    while (i < n) {
        if (dhvani_is_finite(vec_get(s, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ---- silence_unchanged ----
test_group("silence_unchanged");
var buf_s = dhvani_buffer_silence(1, 4096, 44100);
dhvani_noise_reduce(buf_s, 0.5);
assert(f64_lt(dhvani_buffer_peak(buf_s), DH_EPSILON) == 1, "silence peak < epsilon");

# ---- loud_signal_preserved ----
test_group("loud_signal_preserved");
var samples_l = nr_make_sine(0.8, 440.0, 44100, 44100);
var buf_l = dhvani_buffer_from_interleaved(samples_l, 1, 44100);
var original_rms = dhvani_buffer_rms(buf_l);
dhvani_noise_reduce(buf_l, 0.3);
assert(f64_gt(dhvani_buffer_rms(buf_l), f64_mul(original_rms, 0.7)) == 1, "loud signal survives");

# ---- noise_reduced ----
test_group("noise_reduced");
var samples_n = vec_new();
var in1 = 0;
while (in1 < 44100) {
    var ph1 = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(in1)), f64_from(44100));
    var signal = f64_mul(0.5, f64_sin(ph1));
    var noise = f64_mul(0.02, f64_sin(f64_mul(f64_from(in1), 12345.679)));
    vec_push(samples_n, f64_add(signal, noise));
    in1 = in1 + 1;
}
var buf_n = dhvani_buffer_from_interleaved(samples_n, 1, 44100);
dhvani_noise_reduce(buf_n, 0.5);
assert_eq(nr_all_finite(buf_n), 1, "noise_reduced output all finite");
assert(f64_gt(dhvani_buffer_rms(buf_n), 0.0) == 1, "noise_reduced signal survives");

# ---- short_buffer_fallback ----
test_group("short_buffer_fallback");
var samples_sb = vec_new();
var isb = 0;
while (isb < 100) { vec_push(samples_sb, 0.01); isb = isb + 1; }
var buf_sb = dhvani_buffer_from_interleaved(samples_sb, 1, 44100);
dhvani_noise_reduce(buf_sb, 0.5);
assert_eq(nr_all_finite(buf_sb), 1, "short buffer output all finite");

# ---- stereo_processing ----
test_group("stereo_processing");
var samples_st = vec_new();
var ist = 0;
while (ist < 88200) {
    var phst = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(ist / 2)), f64_from(44100));
    vec_push(samples_st, f64_mul(0.5, f64_sin(phst)));
    ist = ist + 1;
}
var buf_st = dhvani_buffer_from_interleaved(samples_st, 2, 44100);
dhvani_noise_reduce(buf_st, 0.3);
assert_eq(nr_all_finite(buf_st), 1, "stereo output all finite");
assert(f64_gt(dhvani_buffer_rms(buf_st), 0.0) == 1, "stereo signal survives");

# ---- output_finite ----
test_group("output_finite");
var samples_of = vec_new();
var iof = 0;
while (iof < 44100) {
    vec_push(samples_of, f64_sub(f64_mul(f64_div(f64_from(iof), f64_from(44100)), 2.0), 1.0));
    iof = iof + 1;
}
var buf_of = dhvani_buffer_from_interleaved(samples_of, 1, 44100);
dhvani_noise_reduce(buf_of, 1.0);
assert_eq(nr_all_finite(buf_of), 1, "ramp output all finite");

# ---- reducer_is_alloc_free (regression, 2.3.2) ----
# NoiseReducer exists to reuse its buffers across calls. Through 2.3.1 process()
# still allocated the per-channel `mono`, `output` and `window_sum` vecs on every
# call (392,592 bytes per stereo 4096-frame call, never freed). They are now
# grow-only fields: after the first call at a size, later calls allocate nothing.
test_group("reducer_is_alloc_free");
fn nr_stereo(frames, f0) {
    var v = vec_new();
    var i = 0;
    while (i < frames * 2) {
        var t = f64_div(f64_from(f0 + i / 2), f64_from(44100));
        var x = f64_mul(0.4, f64_sin(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), t)));
        if ((i % 7) == 3) { x = f64_add(x, 0.05); }
        vec_push(v, x);
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 2, 44100);
}
var nr9 = dhvani_noise_reducer_new();
var w9 = nr_stereo(4096, 0);
dhvani_noise_reducer_process(nr9, w9, 0.5);
var b9 = nr_stereo(4096, 100);
var u9a = alloc_used();
dhvani_noise_reducer_process(nr9, b9, 0.5);
var u9b = alloc_used();
assert_eq(u9b - u9a, 0, "steady-state stereo 4096-frame process allocates 0 bytes");
var s9 = nr_stereo(2500, 7);
var u9c = alloc_used();
dhvani_noise_reducer_process(nr9, s9, 0.7);
var u9d = alloc_used();
assert_eq(u9d - u9c, 0, "a shorter buffer reuses the scratch (0 bytes)");

# ---- reused_scratch_matches_fresh ----
# The reused scratch is zeroed in place, so a reducer that already processed a
# longer buffer gives bit-identical output to a fresh one-shot reduce.
test_group("reused_scratch_matches_fresh");
var a10 = nr_stereo(3000, 11);
var b10 = nr_stereo(3000, 11);
dhvani_noise_reducer_process(nr9, a10, 0.6);
dhvani_noise_reduce(b10, 0.6);
var sa10 = dhvani_buffer_samples(a10);
var sb10 = dhvani_buffer_samples(b10);
var d10 = 0;
var i10 = 0;
while (i10 < vec_len(sa10)) { if (vec_get(sa10, i10) != vec_get(sb10, i10)) { d10 = d10 + 1; } i10 = i10 + 1; }
assert_eq(d10, 0, "reused reducer == fresh one-shot, bit for bit");

# ---- zero_channel_buffer (hardening, 2.3.2) ----
test_group("zero_channel_buffer");
var z11 = dhvani_buffer_silence(0, 4096, 44100);
dhvani_noise_reducer_process(nr9, z11, 0.5);
assert_eq(vec_len(dhvani_buffer_samples(z11)), 0, "0-channel buffer is a no-op");

var rc = assert_summary();
syscall(60, rc);
