# simd.tcyr -- parity tests for src/simd.cyr: every #[test] block in
# rust-old/src/simd/mod.rs, one-for-one. The five SIMD-vs-scalar tests
# (simd_scalar_parity, i24_parity, u8_parity, biquad_stereo_parity,
# various_buffer_sizes) were dropped through 2.3.1, while only the scalar path
# existed; since 2.3.2 they compare each packed kernel with its `_scalar` oracle,
# followed by dhvani's own bit-identity / canary / alloc-free sweeps.
#
# NOTE: negative FLOAT literals must go through f64_neg() (a bare `-1.0` is
# integer-negated -> a wrong bit pattern). Negative INTEGER PCM values
# (-32768, -8388608) are fine as literals.

include "src/error.cyr"
include "src/simd.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }

# ---- add_buffers_basic ----
test_group("add_buffers_basic");
var d1 = vec_new();
vec_push(d1, 1.0); vec_push(d1, 2.0); vec_push(d1, 3.0); vec_push(d1, 4.0);
vec_push(d1, 5.0); vec_push(d1, 6.0); vec_push(d1, 7.0); vec_push(d1, 8.0); vec_push(d1, 9.0);
var s1 = vec_new();
vec_push(s1, 10.0); vec_push(s1, 20.0); vec_push(s1, 30.0); vec_push(s1, 40.0);
vec_push(s1, 50.0); vec_push(s1, 60.0); vec_push(s1, 70.0); vec_push(s1, 80.0); vec_push(s1, 90.0);
dhvani_simd_add_buffers(d1, s1);
var i = 0;
var ok = 1;
while (i < 9) {
    if (near(vec_get(d1, i), f64_mul(f64_from(i + 1), 11.0), 0.0001) == 0) { ok = 0; }
    i = i + 1;
}
assert_eq(ok, 1, "dst[i] = 11*(i+1)");

# ---- add_buffers_mismatched_len ----
test_group("add_buffers_mismatched_len");
var d2 = vec_new(); vec_push(d2, 1.0); vec_push(d2, 2.0); vec_push(d2, 3.0);
var s2 = vec_new(); vec_push(s2, 10.0); vec_push(s2, 20.0);
dhvani_simd_add_buffers(d2, s2);
assert(near(vec_get(d2, 0), 11.0, 0.0001), "[0]=11");
assert(near(vec_get(d2, 1), 22.0, 0.0001), "[1]=22");
assert(near(vec_get(d2, 2), 3.0, 0.0001), "[2] untouched");

# ---- apply_gain_basic ----
test_group("apply_gain_basic");
var g1 = vec_new();
vec_push(g1, 0.5); vec_push(g1, f64_neg(0.5)); vec_push(g1, 1.0); vec_push(g1, f64_neg(1.0)); vec_push(g1, 0.25);
dhvani_simd_apply_gain(g1, 2.0);
assert(near(vec_get(g1, 0), 1.0, 0.0001), "0.5*2");
assert(near(vec_get(g1, 1), f64_neg(1.0), 0.0001), "-0.5*2");
assert(near(vec_get(g1, 2), 2.0, 0.0001), "1*2");
assert(near(vec_get(g1, 3), f64_neg(2.0), 0.0001), "-1*2");
assert(near(vec_get(g1, 4), 0.5, 0.0001), "0.25*2");

# ---- clamp_basic ----
test_group("clamp_basic");
var c1 = vec_new();
vec_push(c1, 2.0); vec_push(c1, f64_neg(2.0)); vec_push(c1, 0.5); vec_push(c1, f64_neg(0.5)); vec_push(c1, 1.5);
dhvani_simd_clamp(c1, f64_neg(1.0), 1.0);
assert(near(vec_get(c1, 0), 1.0, 0.0001), "2->1");
assert(near(vec_get(c1, 1), f64_neg(1.0), 0.0001), "-2->-1");
assert(near(vec_get(c1, 2), 0.5, 0.0001), "0.5 kept");
assert(near(vec_get(c1, 4), 1.0, 0.0001), "1.5->1");

# ---- peak_abs ----
test_group("peak_abs");
var p1 = vec_new();
vec_push(p1, 0.3); vec_push(p1, f64_neg(0.7)); vec_push(p1, 0.5); vec_push(p1, 0.1); vec_push(p1, f64_neg(0.2));
assert(near(dhvani_simd_peak_abs(p1), 0.7, 0.0001), "peak = 0.7");
var pe = vec_new();
assert_eq(dhvani_simd_peak_abs(pe), 0, "empty peak = 0.0");

# ---- sum_of_squares ----
test_group("sum_of_squares");
var q1 = vec_new(); vec_push(q1, 1.0); vec_push(q1, 2.0); vec_push(q1, 3.0);
assert(near(dhvani_simd_sum_of_squares(q1), 14.0, 0.000001), "1+4+9 = 14");

# ---- noise_gate ----
test_group("noise_gate");
var n1 = vec_new();
vec_push(n1, 0.01); vec_push(n1, f64_neg(0.01)); vec_push(n1, 0.5);
vec_push(n1, f64_neg(0.5)); vec_push(n1, 0.001); vec_push(n1, 0.8);
dhvani_simd_noise_gate(n1, 0.1);
assert_eq(vec_get(n1, 0), 0, "0.01 gated");
assert_eq(vec_get(n1, 1), 0, "-0.01 gated");
assert(near(vec_get(n1, 2), 0.5, 0.0001), "0.5 kept");
assert(near(vec_get(n1, 3), f64_neg(0.5), 0.0001), "-0.5 kept");
assert_eq(vec_get(n1, 4), 0, "0.001 gated");
assert(near(vec_get(n1, 5), 0.8, 0.0001), "0.8 kept");

# ---- i16 <-> f32 roundtrip (integer PCM negatives are literal) ----
test_group("i16_f32_roundtrip");
var i16src = vec_new();
vec_push(i16src, 0); vec_push(i16src, 16384); vec_push(i16src, -16384);
vec_push(i16src, 32767); vec_push(i16src, -32768);
var f32buf = vec_new();
vec_push(f32buf, 0); vec_push(f32buf, 0);
vec_push(f32buf, 0); vec_push(f32buf, 0); vec_push(f32buf, 0);
dhvani_simd_i16_to_f32(i16src, f32buf);
var i16back = vec_new();
vec_push(i16back, 0); vec_push(i16back, 0);
vec_push(i16back, 0); vec_push(i16back, 0); vec_push(i16back, 0);
dhvani_simd_f32_to_i16(f32buf, i16back);
var jj = 0;
var i16ok = 1;
while (jj < 5) {
    var diff = vec_get(i16src, jj) - vec_get(i16back, jj);
    if (diff < 0) { diff = 0 - diff; }
    if (diff > 1) { i16ok = 0; }
    jj = jj + 1;
}
assert_eq(i16ok, 1, "i16 roundtrip within +-1");

# ---- weighted_sum ----
test_group("weighted_sum");
var ws = vec_new(); vec_push(ws, 1.0); vec_push(ws, 2.0); vec_push(ws, 3.0); vec_push(ws, 4.0); vec_push(ws, 5.0);
var ww = vec_new(); vec_push(ww, 0.5); vec_push(ww, 0.5); vec_push(ww, 0.5); vec_push(ww, 0.5); vec_push(ww, 0.5);
var osum = alloc(8);
var owt = alloc(8);
dhvani_simd_weighted_sum(ws, ww, osum, owt);
assert(near(load64(osum), 7.5, 0.0001), "weighted sum = 7.5");
assert(near(load64(owt), 2.5, 0.0001), "weight sum = 2.5");
var ws2 = vec_new(); vec_push(ws2, 1.0); vec_push(ws2, 2.0); vec_push(ws2, 3.0);
var ww2 = vec_new(); vec_push(ww2, 1.0); vec_push(ww2, 0); vec_push(ww2, 0.5);
dhvani_simd_weighted_sum(ws2, ww2, osum, owt);
assert(near(load64(osum), 2.5, 0.0001), "unequal weighted sum = 2.5");
assert(near(load64(owt), 1.5, 0.0001), "unequal weight sum = 1.5");

# ---- i24 <-> f32 roundtrip ----
test_group("i24_f32_roundtrip");
var i24src = vec_new();
vec_push(i24src, 0); vec_push(i24src, 4194304); vec_push(i24src, -4194304);
vec_push(i24src, 8388607); vec_push(i24src, -8388608);
var f24 = vec_new(); vec_push(f24, 0); vec_push(f24, 0); vec_push(f24, 0); vec_push(f24, 0); vec_push(f24, 0);
dhvani_simd_i24_to_f32(i24src, f24);
var i24back = vec_new();
vec_push(i24back, 0); vec_push(i24back, 0);
vec_push(i24back, 0); vec_push(i24back, 0); vec_push(i24back, 0);
dhvani_simd_f32_to_i24(f24, i24back);
var kk = 0;
var i24ok = 1;
while (kk < 5) {
    var d = vec_get(i24src, kk) - vec_get(i24back, kk);
    if (d < 0) { d = 0 - d; }
    if (d > 1) { i24ok = 0; }
    kk = kk + 1;
}
assert_eq(i24ok, 1, "i24 roundtrip within +-1");

# ---- u8 <-> f32 roundtrip ----
test_group("u8_f32_roundtrip");
var u8src = vec_new();
vec_push(u8src, 0); vec_push(u8src, 64); vec_push(u8src, 128); vec_push(u8src, 192); vec_push(u8src, 255);
var fu = vec_new(); vec_push(fu, 0); vec_push(fu, 0); vec_push(fu, 0); vec_push(fu, 0); vec_push(fu, 0);
dhvani_simd_u8_to_f32(u8src, fu);
assert(f64_lt(f64_abs(vec_get(fu, 2)), 0.01), "u8 128 -> ~0.0");
assert(near(vec_get(fu, 0), f64_neg(1.0), 0.01), "u8 0 -> ~-1.0");

# ---- biquad_stereo: first-sample output == b0*input (zero initial state) ----
test_group("biquad_stereo");
var coeffs = vec_new();
vec_push(coeffs, 0.004836739652368523);      # b0;
vec_push(coeffs, 0.009673479304737046);      # b1;
vec_push(coeffs, 0.004836739652368523);      # b2;
vec_push(coeffs, f64_neg(1.9029109205028356)); # a1;
vec_push(coeffs, 0.9222578791123097);        # a2;
var state = vec_new(); vec_push(state, 0); vec_push(state, 0); vec_push(state, 0); vec_push(state, 0);
var bs = vec_new(); vec_push(bs, 1.0); vec_push(bs, 1.0); vec_push(bs, 0.5); vec_push(bs, 0.5);
dhvani_simd_biquad_stereo(bs, coeffs, state);
assert(near(vec_get(bs, 0), 0.004836739652368523, 0.000000001), "L[0] = b0*1.0");
assert(near(vec_get(bs, 1), 0.004836739652368523, 0.000000001), "R[0] = b0*1.0");
assert_eq(dhvani_is_finite(vec_get(bs, 2)), 1, "L[1] finite");
assert_eq(dhvani_is_finite(vec_get(state, 0)), 1, "state finite");

# ---- peak_abs_ignores_nan (regression, 2.2.3) ----
# Cyrius f64_max is asymmetric on NaN: f64_max(x, NaN) -> NaN, f64_max(NaN, x) -> x.
# A naive fold therefore poisons the running peak on a NaN and then RESETS it to
# the next sample, under-reporting the peak -- which makes normalize OVER-amplify.
# rust-old uses f32::max / .fold(0.0f32, f32::max), which IGNORE NaN.
test_group("peak_abs_ignores_nan");
var nanbuf = vec_new();
vec_push(nanbuf, 0.8);
vec_push(nanbuf, f64_div(0, 0));   # NaN;
vec_push(nanbuf, 0.2);
var np = dhvani_simd_peak_abs(nanbuf);
assert_eq(f64_eq(np, np), 1, "peak over a NaN-containing buffer is not NaN");
assert_eq(f64_to(f64_mul(np, 100.0)), 80, "peak keeps the true max (0.8), not the post-NaN reset (0.2)");

# ================================================================
# Vector vs scalar (2.3.2). The five oracle tests below compare the accelerated kernel
# with its `_scalar` fallback; through 2.3.1 they were dropped, since with only the
# scalar path ported they compared it with itself. Ported one-for-one, with the oracle's
# tolerances. (Ours are tighter: every element-wise kernel is bit-identical.)
# ================================================================

fn vzeros(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, 0); i = i + 1; }
    return v;
}
fn vcopy(src) {
    var v = vec_new();
    var i = 0;
    while (i < vec_len(src)) { vec_push(v, vec_get(src, i)); i = i + 1; }
    return v;
}
fn vec_bits_eq(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn vec_all_near(a, b, tol) {
    var i = 0;
    while (i < vec_len(a)) {
        if (near(vec_get(a, i), vec_get(b, i), tol) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn vec_all_within_int(a, b, d) {
    var i = 0;
    while (i < vec_len(a)) {
        var x = vec_get(a, i) - vec_get(b, i);
        if (x < 0) { x = 0 - x; }
        if (x > d) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ---- simd_scalar_parity ----
test_group("simd_scalar_parity");
var pd = vec_new();
var pi = 0;
while (pi < 1025) { vec_push(pd, f64_mul(f64_sin(f64_mul(f64_from(pi), 0.01)), 0.9)); pi = pi + 1; }
assert(near(dhvani_simd_peak_abs(pd), dhvani_simd_peak_abs_scalar(pd), 0.000001), "peak_abs");
assert(near(dhvani_simd_sum_of_squares(pd), dhvani_simd_sum_of_squares_scalar(pd), 0.001), "sum_of_squares");
var pa1 = vec_new();
var pa2 = vec_new();
pi = 0;
while (pi < 1025) { vec_push(pa1, 1.0); vec_push(pa2, 1.0); pi = pi + 1; }
dhvani_simd_add_buffers(pa1, pd);
dhvani_simd_add_buffers_scalar(pa2, pd);
assert_eq(vec_bits_eq(pa1, pa2), 1, "add_buffers");
var pg1 = vcopy(pd);
var pg2 = vcopy(pd);
dhvani_simd_apply_gain(pg1, 0.75);
dhvani_simd_apply_gain_scalar(pg2, 0.75);
assert_eq(vec_all_near(pg1, pg2, 0.000001), 1, "apply_gain");
var pc1 = vcopy(pd);
dhvani_simd_apply_gain_scalar(pc1, 2.0);
var pc2 = vcopy(pc1);
dhvani_simd_clamp(pc1, f64_neg(0.5), 0.5);
dhvani_simd_clamp_scalar(pc2, f64_neg(0.5), 0.5);
assert_eq(vec_bits_eq(pc1, pc2), 1, "clamp");
var pn1 = vcopy(pd);
var pn2 = vcopy(pd);
dhvani_simd_noise_gate(pn1, 0.3);
dhvani_simd_noise_gate_scalar(pn2, 0.3);
assert_eq(vec_bits_eq(pn1, pn2), 1, "noise_gate");
var pi16 = vec_new();
pi = 0;
while (pi < 1025) { vec_push(pi16, (pi * 31) % 65536); pi = pi + 1; }
var pf1 = vzeros(1025);
var pf2 = vzeros(1025);
dhvani_simd_i16_to_f32(pi16, pf1);
dhvani_simd_i16_to_f32_scalar(pi16, pf2);
assert_eq(vec_all_near(pf1, pf2, 0.000001), 1, "i16_to_f32");
var pb1 = vzeros(1025);
var pb2 = vzeros(1025);
dhvani_simd_f32_to_i16(pf1, pb1);
dhvani_simd_f32_to_i16_scalar(pf2, pb2);
assert_eq(vec_all_within_int(pb1, pb2, 1), 1, "f32_to_i16 within +-1");
var pw = vec_new();
pi = 0;
while (pi < 1025) { vec_push(pw, f64_cos(f64_mul(f64_from(pi), 0.003))); pi = pi + 1; }
var pws1 = alloc(16);
var pws2 = alloc(16);
dhvani_simd_weighted_sum(pd, pw, pws1, pws1 + 8);
dhvani_simd_weighted_sum_scalar(pd, pw, pws2, pws2 + 8);
assert(near(load64(pws1), load64(pws2), 0.01), "weighted_sum");
assert(near(load64(pws1 + 8), load64(pws2 + 8), 0.01), "weight_sum");

# ---- i24_parity ----
test_group("i24_parity");
var qi24 = vec_new();
pi = 0;
while (pi < 1025) { vec_push(qi24, ((pi * 7919) % 16777216) - 8388608); pi = pi + 1; }
var qf1 = vzeros(1025);
var qf2 = vzeros(1025);
dhvani_simd_i24_to_f32(qi24, qf1);
dhvani_simd_i24_to_f32_scalar(qi24, qf2);
assert_eq(vec_all_near(qf1, qf2, 0.000001), 1, "i24_to_f32");
var qb1 = vzeros(1025);
var qb2 = vzeros(1025);
dhvani_simd_f32_to_i24(qf1, qb1);
dhvani_simd_f32_to_i24_scalar(qf2, qb2);
assert_eq(vec_all_within_int(qb1, qb2, 1), 1, "f32_to_i24 within +-1");

# ---- u8_parity ----
test_group("u8_parity");
var ru8 = vec_new();
pi = 0;
while (pi < 256) { vec_push(ru8, pi); pi = pi + 1; }
var rf1 = vzeros(256);
var rf2 = vzeros(256);
dhvani_simd_u8_to_f32(ru8, rf1);
dhvani_simd_u8_to_f32_scalar(ru8, rf2);
assert_eq(vec_all_near(rf1, rf2, 0.000001), 1, "u8_to_f32");
var rb1 = vzeros(256);
var rb2 = vzeros(256);
dhvani_simd_f32_to_u8(rf1, rb1);
dhvani_simd_f32_to_u8_scalar(rf2, rb2);
assert_eq(vec_all_within_int(rb1, rb2, 1), 1, "f32_to_u8 within +-1");

# ---- biquad_stereo_parity ----
test_group("biquad_stereo_parity");
var sbq1 = vec_new();
pi = 0;
while (pi < 2048) {
    var t = f64_div(f64_from(pi / 2), 44100.0);
    vec_push(sbq1, f64_mul(f64_sin(f64_mul(f64_mul(2.0, F64_PI), f64_mul(440.0, t))), 0.8));
    pi = pi + 1;
}
var sbq2 = vcopy(sbq1);
var sst1 = vzeros(4);
var sst2 = vzeros(4);
dhvani_simd_biquad_stereo(sbq1, coeffs, sst1);
dhvani_simd_biquad_stereo_scalar(sbq2, coeffs, sst2);
assert_eq(vec_all_near(sbq1, sbq2, 0.00001), 1, "samples within 1e-5");
assert_eq(vec_all_near(sst1, sst2, 0.0000000001), 1, "state within 1e-10");
assert_eq(vec_bits_eq(sbq1, sbq2), 1, "samples bit-identical (mul then add, never fused)");
assert_eq(vec_bits_eq(sst1, sst2), 1, "state bit-identical");

# ---- various_buffer_sizes ----
test_group("various_buffer_sizes");
var sizes_ok = 1;
var szs = vec_new();
vec_push(szs, 0); vec_push(szs, 1); vec_push(szs, 3); vec_push(szs, 4); vec_push(szs, 7);
vec_push(szs, 8); vec_push(szs, 15); vec_push(szs, 16); vec_push(szs, 17);
var zi = 0;
while (zi < vec_len(szs)) {
    var sz = vec_get(szs, zi);
    var zd = vec_new();
    var zs = vec_new();
    var zg = vec_new();
    var zc = vec_new();
    var zk = 0;
    while (zk < sz) { vec_push(zd, 1.0); vec_push(zs, 2.0); vec_push(zg, 0.5); vec_push(zc, 2.0); zk = zk + 1; }
    dhvani_simd_add_buffers(zd, zs);
    dhvani_simd_apply_gain(zg, 2.0);
    dhvani_simd_clamp(zc, f64_neg(1.0), 1.0);
    zk = 0;
    while (zk < sz) {
        if (near(vec_get(zd, zk), 3.0, DH_EPSILON) == 0) { sizes_ok = 0; }
        if (near(vec_get(zg, zk), 1.0, DH_EPSILON) == 0) { sizes_ok = 0; }
        if (near(vec_get(zc, zk), 1.0, DH_EPSILON) == 0) { sizes_ok = 0; }
        zk = zk + 1;
    }
    zi = zi + 1;
}
assert_eq(sizes_ok, 1, "add / gain / clamp at sizes 0,1,3,4,7,8,15,16,17");

# ================================================================
# dhvani's own (2.3.2): what the oracle's tests do not reach. The packed verbs step 2
# or 4 lanes with no scalar tail, so every size around a lane boundary is checked for
# the exact bits the scalar form gives AND for no write past vec_len (six canary slots
# beyond len, inside the vec's capacity). Inputs carry NaN, +-Inf and -0.0. Run once on
# the CPU's widest path and once forced onto 128-bit lanes.
# ================================================================

var CANARY = 0x7FF4DEADBEEF0001;   # a signalling-NaN pattern no kernel writes

# n samples from a deterministic generator, then 6 canaries past len. specials = 1
# sprinkles NaN, +Inf, -Inf and -0.0 among them.
fn vgen(n, seed, specials) {
    var v = vec_new();
    var i = 0;
    while (i < n + 6) {
        var x = f64_mul(f64_sin(f64_mul(f64_from(i * 7 + seed), 0.013)), 1.7);
        if (specials == 1) {
            if ((i % 37) == 5) { x = f64_div(0, 0); }
            if ((i % 41) == 7) { x = 0x7FF0000000000000; }
            if ((i % 43) == 9) { x = 0xFFF0000000000000; }
            if ((i % 47) == 11) { x = 0x8000000000000000; }
        }
        if (i >= n) { x = CANARY; }
        vec_push(v, x);
        i = i + 1;
    }
    vec_truncate(v, n);
    return v;
}
# n integers in [-off, modu - off), then 6 canaries.
fn vgeni(n, seed, modu, off) {
    var v = vec_new();
    var i = 0;
    while (i < n + 6) {
        var x = ((i * 7919 + seed) % modu) - off;
        if (i >= n) { x = CANARY; }
        vec_push(v, x);
        i = i + 1;
    }
    vec_truncate(v, n);
    return v;
}
# the same bits through len AND through the 6 slots past it.
fn vsame(a, b) {
    var n = vec_len(a);
    if (vec_len(b) != n) { return 0; }
    var i = 0;
    while (i < n + 6) {
        if (load64(load64(a) + i * 8) != load64(load64(b) + i * 8)) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn vcanary(a) {
    var i = vec_len(a);
    while (i < vec_len(a) + 6) {
        if (load64(load64(a) + i * 8) != CANARY) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Every kernel, every size; returns the number of mismatches.
fn vector_vs_scalar_mismatches() {
    var szl = vec_new();
    var k = 0;
    while (k < 21) { vec_push(szl, k); k = k + 1; }
    vec_push(szl, 63); vec_push(szl, 64); vec_push(szl, 65); vec_push(szl, 66); vec_push(szl, 67);
    vec_push(szl, 511); vec_push(szl, 512); vec_push(szl, 513); vec_push(szl, 1025);
    var bc = vec_new();
    vec_push(bc, 0.004836739652368523); vec_push(bc, 0.009673479304737046);
    vec_push(bc, 0.004836739652368523); vec_push(bc, f64_neg(1.9029109205028356));
    vec_push(bc, 0.9222578791123097);
    var out1 = alloc(16);
    var out2 = alloc(16);
    var bad = 0;
    var si = 0;
    while (si < vec_len(szl)) {
        var n = vec_get(szl, si);
        var src = vgen(n, 11, 1);
        var a = vgen(n, 3, 1);
        var b = vgen(n, 3, 1);
        dhvani_simd_add_buffers(a, src);
        dhvani_simd_add_buffers_scalar(b, src);
        if (vsame(a, b) == 0) { bad = bad + 1; }
        a = vgen(n, 5, 1);
        b = vgen(n, 5, 1);
        dhvani_simd_apply_gain(a, 0.75);
        dhvani_simd_apply_gain_scalar(b, 0.75);
        if (vsame(a, b) == 0) { bad = bad + 1; }
        a = vgen(n, 5, 1);
        b = vgen(n, 5, 1);
        dhvani_simd_clamp(a, f64_neg(0.5), 0.5);
        dhvani_simd_clamp_scalar(b, f64_neg(0.5), 0.5);
        if (vsame(a, b) == 0) { bad = bad + 1; }
        a = vgen(n, 5, 1);
        b = vgen(n, 5, 1);
        dhvani_simd_noise_gate(a, 0.3);
        dhvani_simd_noise_gate_scalar(b, 0.3);
        if (vsame(a, b) == 0) { bad = bad + 1; }
        a = vgen(n, 9, 1);
        if (dhvani_simd_peak_abs(a) != dhvani_simd_peak_abs_scalar(a)) { bad = bad + 1; }
        # the reductions: lane order, so equal to within rounding, on finite input
        a = vgen(n, 9, 0);
        if (near(dhvani_simd_sum_of_squares(a), dhvani_simd_sum_of_squares_scalar(a), 0.000000001) == 0) {
            bad = bad + 1;
        }
        var w = vgen(n, 17, 0);
        dhvani_simd_weighted_sum(a, w, out1, out1 + 8);
        dhvani_simd_weighted_sum_scalar(a, w, out2, out2 + 8);
        if (near(load64(out1), load64(out2), 0.000000001) == 0) { bad = bad + 1; }
        if (near(load64(out1 + 8), load64(out2 + 8), 0.000000001) == 0) { bad = bad + 1; }
        # PCM -> float
        var d1 = vgen(n, 0, 0);
        var d2 = vgen(n, 0, 0);
        var i16s = vgeni(n, 1, 65536, 32768);
        dhvani_simd_i16_to_f32(i16s, d1);
        dhvani_simd_i16_to_f32_scalar(i16s, d2);
        if (vsame(d1, d2) == 0) { bad = bad + 1; }
        var i24s = vgeni(n, 5, 16777216, 8388608);
        dhvani_simd_i24_to_f32(i24s, d1);
        dhvani_simd_i24_to_f32_scalar(i24s, d2);
        if (vsame(d1, d2) == 0) { bad = bad + 1; }
        var u8s = vgeni(n, 5, 256, 0);
        dhvani_simd_u8_to_f32(u8s, d1);
        dhvani_simd_u8_to_f32_scalar(u8s, d2);
        if (vsame(d1, d2) == 0) { bad = bad + 1; }
        # float -> PCM (NaN / Inf in, so f64_to's out-of-range answer must agree too)
        var fsrc = vgen(n, 21, 1);
        var e1 = vgeni(n, 0, 1, 0);
        var e2 = vgeni(n, 0, 1, 0);
        dhvani_simd_f32_to_i16(fsrc, e1);
        dhvani_simd_f32_to_i16_scalar(fsrc, e2);
        if (vsame(e1, e2) == 0) { bad = bad + 1; }
        dhvani_simd_f32_to_i24(fsrc, e1);
        dhvani_simd_f32_to_i24_scalar(fsrc, e2);
        if (vsame(e1, e2) == 0) { bad = bad + 1; }
        dhvani_simd_f32_to_u8(fsrc, e1);
        dhvani_simd_f32_to_u8_scalar(fsrc, e2);
        if (vsame(e1, e2) == 0) { bad = bad + 1; }
        # stereo biquad: n samples = n/2 frames (an odd n leaves the last sample alone)
        var st1 = vec_new();
        var st2 = vec_new();
        var q = 0;
        while (q < 4) {
            vec_push(st1, f64_mul(f64_from(q + 1), 0.01));
            vec_push(st2, f64_mul(f64_from(q + 1), 0.01));
            q = q + 1;
        }
        a = vgen(n, 23, 0);
        b = vgen(n, 23, 0);
        dhvani_simd_biquad_stereo(a, bc, st1);
        dhvani_simd_biquad_stereo_scalar(b, bc, st2);
        if (vsame(a, b) == 0) { bad = bad + 1; }
        if (vec_bits_eq(st1, st2) == 0) { bad = bad + 1; }
        si = si + 1;
    }
    return bad;
}

test_group("vector_matches_scalar_bitwise");
assert_eq(vector_vs_scalar_mismatches(), 0, "every kernel, sizes 0-20 / 63-67 / 511-513 / 1025, widest path");
var cw = vgen(65, 3, 0);
dhvani_simd_add_buffers(cw, vgen(65, 4, 0));
assert_eq(vcanary(cw), 1, "an odd row past the 256-bit cutoff leaves the slot after len alone");

test_group("vector_matches_scalar_bitwise_128");
dh_simd_wide = 0;
assert_eq(vector_vs_scalar_mismatches(), 0, "every kernel, every size, 128-bit lanes only");
dh_simd_wide = 2;

# ---- alloc-free: a warmed-up call of every accelerated kernel allocates 0 bytes ----
test_group("vector_kernels_alloc_free");
var fa = vgen(512, 1, 0);
var fb = vgen(512, 2, 0);
var fi = vgeni(512, 3, 65536, 32768);
var fo = alloc(16);
var fst = vzeros(4);
dhvani_simd_weighted_sum(fa, fb, fo, fo + 8);   # warm: fills the ones table once
var fused_before = alloc_used();
dhvani_simd_add_buffers(fa, fb);
dhvani_simd_apply_gain(fa, 0.5);
dhvani_simd_clamp(fa, f64_neg(1.0), 1.0);
dhvani_simd_noise_gate(fa, 0.001);
var fpk = dhvani_simd_peak_abs(fa);
var fss = dhvani_simd_sum_of_squares(fa);
dhvani_simd_weighted_sum(fa, fb, fo, fo + 8);
dhvani_simd_i16_to_f32(fi, fb);
dhvani_simd_f32_to_i16(fa, fi);
dhvani_simd_biquad_stereo(fa, coeffs, fst);
assert_eq(alloc_used() - fused_before, 0, "0 bytes across one call of each");

# ---- biquad_stereo refuses short coeffs / state vecs (2.3.3) ----
# The raw kernel reads 5 coeffs and writes 4 state slots directly; a short vec read
# garbage coefficients and wrote past its length (the old vec_get form aborted).
test_group("biquad_stereo_short_vecs");
var sv_c4 = vec_new(); vec_push(sv_c4, 1.0); vec_push(sv_c4, 0); vec_push(sv_c4, 0); vec_push(sv_c4, 0);
var sv_st = vzeros(4);
var sv_s = vec_new(); vec_push(sv_s, 0.5); vec_push(sv_s, 0.5);
assert_eq(dhvani_simd_biquad_stereo(sv_s, sv_c4, sv_st), DHVANI_ERR_INVALID_PARAMETER, "4 coeffs refused");
assert_eq(dhvani_simd_biquad_stereo(sv_s, coeffs, vzeros(3)), DHVANI_ERR_INVALID_PARAMETER, "3 state slots refused");
assert_eq(vec_get(sv_s, 0), 0.5, "samples untouched");
assert_eq(dhvani_simd_biquad_stereo(sv_s, coeffs, sv_st), 0, "full vecs accepted");

var rc = assert_summary();
syscall(60, rc);
