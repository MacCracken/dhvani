# delay.tcyr -- parity tests for src/delay.cyr
# Ported one-for-one from the 6 #[test] blocks in rust-old/src/dsp/delay.rs.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/delay.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }

# ---- zero_mix_passthrough ----
test_group("zero_mix_passthrough");
var zv = vec_new(); vec_push(zv, 1.0); vec_push(zv, 0.5); vec_push(zv, 0.25); vec_push(zv, 0);
var zb = dhvani_buffer_from_interleaved(zv, 1, 44100);
var zorig = vec_new(); vec_push(zorig, 1.0); vec_push(zorig, 0.5); vec_push(zorig, 0.25); vec_push(zorig, 0);
var zd = dhvani_delay_new(10.0, 10.0, 0, 0, 44100, 1);
dhvani_delay_process(zd, zb);
var zs = dhvani_buffer_samples(zb);
var zi = 0; var zok = 1;
while (zi < 4) { if (near(vec_get(zs, zi), vec_get(zorig, zi), 0.000001) == 0) { zok = 0; } zi = zi + 1; }
assert_eq(zok, 1, "mix=0 passes dry through");

# ---- delay_shifts_signal ----
test_group("delay_shifts_signal");
var dv = dh_vec_zeros(16);
vec_set(dv, 0, 1.0);
var db = dhvani_buffer_from_interleaved(dv, 1, 1000);
var dd = dhvani_delay_new(1.0, 1.0, 0, 1.0, 1000, 1);
dhvani_delay_process(dd, db);
var ds = dhvani_buffer_samples(db);
assert(f64_lt(f64_abs(vec_get(ds, 0)), 0.0000001), "frame 0 dry = 0");
assert(near(vec_get(ds, 1), 1.0, 0.0000001), "frame 1 = delayed impulse");

# ---- feedback_produces_echoes ----
test_group("feedback_produces_echoes");
var fv = dh_vec_zeros(32);
vec_set(fv, 0, 1.0);
var fb = dhvani_buffer_from_interleaved(fv, 1, 1000);
var fd = dhvani_delay_new(2.0, 2.0, 0.5, 1.0, 1000, 1);
dhvani_delay_process(fd, fb);
var fs = dhvani_buffer_samples(fb);
assert(f64_gt(f64_abs(vec_get(fs, 2)), 0.9), "first echo at frame 2");
assert(f64_gt(f64_abs(vec_get(fs, 4)), 0.4), "second echo at frame 4");
assert(f64_lt(f64_abs(vec_get(fs, 4)), f64_abs(vec_get(fs, 2))), "second echo attenuated");

# ---- reset_clears_buffers ----
test_group("reset_clears_buffers");
var rd = dhvani_delay_new(10.0, 10.0, 0.5, 1.0, 44100, 2);
var rb = dhvani_buffer_from_interleaved(dh_vec_zeros(200), 2, 44100);
var rbs = dhvani_buffer_samples(rb);
var rj = 0; while (rj < 200) { vec_set(rbs, rj, 1.0); rj = rj + 1; }
dhvani_delay_process(rd, rb);
dhvani_delay_reset(rd);
var rbufs = DhDelayLine_buffers(rd);
var rc0 = vec_get(rbufs, 0); var rc1 = vec_get(rbufs, 1);
var rok = 1;
var ri = 0; var rn = vec_len(rc0);
while (ri < rn) {
    if (vec_get(rc0, ri) != 0) { rok = 0; }
    if (vec_get(rc1, ri) != 0) { rok = 0; }
    ri = ri + 1;
}
assert_eq(rok, 1, "both channel buffers cleared");

# ---- modulated_delay_produces_output ----
test_group("modulated_delay_produces_output");
var md = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
var mv = vec_new();
var mi = 0;
while (mi < 4096) {
    var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(mi)), f64_from(44100));
    vec_push(mv, f64_sin(ph));
    mi = mi + 1;
}
var mb = dhvani_buffer_from_interleaved(mv, 1, 44100);
dhvani_moddelay_process(md, mb);
assert(f64_gt(dhvani_buffer_rms(mb), 0), "modulated delay produces output");

# ---- modulated_delay_reset ----
test_group("modulated_delay_reset");
var md2 = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
DhModulatedDelay_set_lfo_phase(md2, 0.5);
dhvani_moddelay_reset(md2);
assert(f64_lt(f64_abs(dhvani_moddelay_lfo_phase(md2)), 0.0000001), "lfo phase reset to 0");

# ================================================================
# 2.3.2 hardening + parity regressions (each fails on the 2.3.2 code)
# ================================================================
var x_nan = 0x7FF8000000000000;

fn x_mono(n, val, sr) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, val); i = i + 1; }
    return dhvani_buffer_from_interleaved(v, 1, sr);
}
fn x_stereo(frames, phase0, sr) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var t = f64_from(i + phase0);
        vec_push(v, f64_mul(f64_sin(f64_mul(t, 0.0627)), 0.8));
        vec_push(v, f64_mul(f64_sin(f64_mul(t, 0.4274)), 0.5));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 2, sr);
}
fn x_count_zero(buf) {
    var s = DhAudioBuffer_samples(buf);
    var n = 0;
    var i = 0;
    while (i < vec_len(s)) { if (vec_get(s, i) == 0) { n = n + 1; } i = i + 1; }
    return n;
}
fn x_all_finite(buf) {
    var s = DhAudioBuffer_samples(buf);
    var i = 0;
    while (i < vec_len(s)) { if (dhvani_is_finite(vec_get(s, i)) == 0) { return 0; } i = i + 1; }
    return 1;
}

# ---- negative_time_floors_to_zero ----
# Rust's `as usize` saturates a negative, -Inf or NaN sample count to 0; f64_to kept
# a negative count (-Inf gave INT64_MIN, whose read index wrapped negative: abort).
test_group("negative_time_floors_to_zero");
var x_nd = dhvani_delay_new(f64_neg(5.0), 10.0, 0, 1.0, 1000, 1);
assert_eq(dhvani_delay_latency_frames(x_nd), 0, "negative delay_ms -> 0 samples");
dhvani_delay_set_delay_ms(x_nd, f64_neg(3.0), 1000);
assert_eq(dhvani_delay_latency_frames(x_nd), 0, "negative set_delay_ms -> 0 samples");
dhvani_delay_set_delay_ms(x_nd, DH_NEG_INF, 1000);
assert_eq(dhvani_delay_latency_frames(x_nd), 0, "-Inf set_delay_ms -> 0 samples");
var x_ni = dhvani_delay_new(DH_NEG_INF, 10.0, 0, 1.0, 1000, 1);
assert_eq(dhvani_delay_latency_frames(x_ni), 0, "-Inf delay_ms -> 0 samples");
var x_nib = x_mono(32, 0.5, 1000);
dhvani_delay_process(x_ni, x_nib);
assert_eq(x_all_finite(x_nib), 1, "-Inf delay processes (no abort)");
var x_nan2 = dhvani_delay_new(x_nan, 10.0, 0, 1.0, 1000, 1);
assert_eq(DhDelayLine_max_delay_samples(x_nan2), 10, "NaN delay_ms: ring sized by max_delay_ms (f32::max ignores NaN)");
assert_eq(dhvani_delay_latency_frames(x_nan2), 0, "NaN delay_ms -> 0 samples");
var x_nan1 = dhvani_delay_new(5.0, x_nan, 0, 1.0, 1000, 1);
assert_eq(DhDelayLine_max_delay_samples(x_nan1), 5, "NaN max_delay_ms: ring sized by delay_ms");
var x_md0 = dhvani_moddelay_new(dhvani_moddelayparams_new(f64_neg(4.0), 1.0, 0.5, 0, 0.5), 1000, 1);
assert_eq(dhvani_moddelay_latency_frames(x_md0), 0, "moddelay negative base -> 0 latency");

# ---- ring_never_stores_nonfinite ----
# The oracle writes input + delayed * feedback as is: one NaN came round every
# `delay` frames forever (NaN * 0 is NaN, so feedback 0 kept it) and zeroed that frame.
test_group("ring_never_stores_nonfinite");
var x_pd = dhvani_delay_new(10.0, 10.0, 0, F64_HALF, 1000, 1);
dhvani_delay_process(x_pd, x_mono(1, x_nan, 1000));
var x_pb = x_mono(1000, 0.4, 1000);
dhvani_delay_process(x_pd, x_pb);
assert_eq(x_count_zero(x_pb), 0, "one NaN does not keep zeroing the output (feedback 0)");
var x_ring = vec_get(DhDelayLine_buffers(x_pd), 0);
var x_rf = 1;
var x_ri = 0;
while (x_ri < vec_len(x_ring)) { if (dhvani_is_finite(vec_get(x_ring, x_ri)) == 0) { x_rf = 0; } x_ri = x_ri + 1; }
assert_eq(x_rf, 1, "the ring holds only finite values");
var x_pi = dhvani_delay_new(2.0, 2.0, 0.5, 1.0, 1000, 1);
var x_pio = dhvani_delay_process_sample(x_pi, DH_POS_INF, 0);   # output: Inf * 0 dry = NaN, as Rust's
assert_eq(vec_get(vec_get(DhDelayLine_buffers(x_pi), 0), 0), 0, "process_sample stores 0 for +Inf");
var x_pm = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
dhvani_moddelay_process(x_pm, x_mono(1, x_nan, 44100));
var x_pmb = x_mono(4096, 0.4, 44100);
dhvani_moddelay_process(x_pm, x_pmb);
assert_eq(x_count_zero(x_pmb), 0, "moddelay: one NaN does not spread through the ring");

# ---- extra_channels_pass_through ----
# A buffer with more channels than the delay: the oracle panics on its ring index
# (here: vec_get abort). The extra channels now pass through untouched.
test_group("extra_channels_pass_through");
var x_ed = dhvani_delay_new(1.0, 1.0, 0, 1.0, 1000, 1);
var x_eb = x_stereo(8, 0, 1000);
var x_er = DhAudioBuffer_samples(x_stereo(8, 0, 1000));
dhvani_delay_process(x_ed, x_eb);
var x_es = DhAudioBuffer_samples(x_eb);
var x_eok = 1;
var x_ei = 0;
while (x_ei < 8) { if (vec_get(x_es, x_ei * 2 + 1) != vec_get(x_er, x_ei * 2 + 1)) { x_eok = 0; } x_ei = x_ei + 1; }
assert_eq(x_eok, 1, "delay: channel 1 untouched");
assert_eq(vec_get(x_es, 2), vec_get(x_er, 0), "delay: channel 0 still delayed by 1 frame");
assert_eq(dhvani_delay_process_sample(x_ed, 0.25, 1), 0.25, "process_sample: no ring -> input");
assert_eq(dhvani_delay_process_sample(x_ed, 0.25, 0 - 1), 0.25, "process_sample: negative channel -> input");
var x_em = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
var x_emb = x_stereo(64, 0, 44100);
var x_emr = DhAudioBuffer_samples(x_stereo(64, 0, 44100));
dhvani_moddelay_process(x_em, x_emb);
var x_ems = DhAudioBuffer_samples(x_emb);
x_eok = 1;
x_ei = 0;
while (x_ei < 64) { if (vec_get(x_ems, x_ei * 2 + 1) != vec_get(x_emr, x_ei * 2 + 1)) { x_eok = 0; } x_ei = x_ei + 1; }
assert_eq(x_eok, 1, "moddelay: channel 1 untouched");

# ---- process_matches_process_sample ----
# The hoisted, storage-walking process() gives the bits of process_sample per sample
# (the 2.3.2 per-sample body) across two blocks, and allocates nothing.
test_group("process_matches_process_sample");
var x_bd = dhvani_delay_new(3.0, 5.0, 0.6, 0.7, 1000, 2);
var x_bt = dhvani_delay_new(3.0, 5.0, 0.6, 0.7, 1000, 2);
var x_bok = 1;
var x_blk = 0;
while (x_blk < 2) {
    var x_bb = x_stereo(37, x_blk * 37, 1000);
    var x_br = DhAudioBuffer_samples(x_stereo(37, x_blk * 37, 1000));
    var x_bu = alloc_used();
    dhvani_delay_process(x_bd, x_bb);
    if (alloc_used() != x_bu) { x_bok = 0; }
    var x_bs = DhAudioBuffer_samples(x_bb);
    var x_bf = 0;
    while (x_bf < 37) {
        var x_bc = 0;
        while (x_bc < 2) {
            var x_want = dhvani_delay_process_sample(x_bt, vec_get(x_br, x_bf * 2 + x_bc), x_bc);
            if (dhvani_is_finite(x_want) == 0) { x_want = 0; }
            if (vec_get(x_bs, x_bf * 2 + x_bc) != x_want) { x_bok = 0; }
            x_bc = x_bc + 1;
        }
        DhDelayLine_set_write_pos(x_bt, (DhDelayLine_write_pos(x_bt) + 1) % DhDelayLine_max_delay_samples(x_bt));
        x_bf = x_bf + 1;
    }
    x_blk = x_blk + 1;
}
assert_eq(x_bok, 1, "bit-identical to process_sample, 0 bytes per block");
assert_eq(DhDelayLine_write_pos(x_bd), DhDelayLine_write_pos(x_bt), "write_pos advanced alike");

# ---- moddelay_process_matches_reference ----
# The 2.3.2 moddelay loop, verbatim (read_interpolated per channel, vec_get/vec_set,
# a single conditional phase wrap -- exact for the normal phase range): the hoisted
# process() must give the same bits.
fn x_old_moddelay_process(self, buf) {
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var p = DhModulatedDelay_params(self);
    var delay = DhModulatedDelay_delay(self);
    var sr = DhModulatedDelay_sample_rate(self);
    var phase_inc = f64_div(DhModulatedDelayParams_rate_hz(p), f64_from(sr));
    var lfo_phase = DhModulatedDelay_lfo_phase(self);
    var base = DhModulatedDelayParams_base_delay_ms(p);
    var depth = DhModulatedDelayParams_depth_ms(p);
    var feedback = DhModulatedDelayParams_feedback(p);
    var mix = DhModulatedDelayParams_mix(p);
    var max = DhDelayLine_max_delay_samples(delay);
    var frame = 0;
    while (frame < frames) {
        var lfo = f64_sin(f64_mul(f64_mul(2.0, F64_PI), lfo_phase));
        var delay_ms = f64_add(base, f64_mul(depth, lfo));
        var delay_frac = f64_max(f64_mul(f64_div(delay_ms, 1000.0), f64_from(sr)), 0);
        var wp = DhDelayLine_write_pos(delay);
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            var input = vec_get(samples, idx);
            var delayed = dhvani_delay_read_interpolated(delay, c, delay_frac);
            var ring = vec_get(DhDelayLine_buffers(delay), c);
            vec_set(ring, wp, f64_add(input, f64_mul(delayed, feedback)));
            var out = f64_add(f64_mul(input, f64_sub(1.0, mix)), f64_mul(delayed, mix));
            if (dhvani_is_finite(out) == 0) { out = 0; }
            vec_set(samples, idx, out);
            c = c + 1;
        }
        DhDelayLine_set_write_pos(delay, (wp + 1) % max);
        lfo_phase = f64_add(lfo_phase, phase_inc);
        if (f64_ge(lfo_phase, 1.0) == 1) { lfo_phase = f64_sub(lfo_phase, 1.0); }
        frame = frame + 1;
    }
    DhModulatedDelay_set_lfo_phase(self, lfo_phase);
    return 0;
}
test_group("moddelay_process_matches_reference");
var x_mpar = dhvani_moddelayparams_new(5.0, 2.5, 3.0, 0.45, 0.6);
var x_mn = dhvani_moddelay_new(x_mpar, 44100, 2);
var x_mo = dhvani_moddelay_new(x_mpar, 44100, 2);
var x_mok = 1;
var x_mblk = 0;
while (x_mblk < 3) {
    var x_ma = x_stereo(300, x_mblk * 300, 44100);
    var x_mb2 = x_stereo(300, x_mblk * 300, 44100);
    var x_mu = alloc_used();
    dhvani_moddelay_process(x_mn, x_ma);
    if (alloc_used() != x_mu) { x_mok = 0; }
    x_old_moddelay_process(x_mo, x_mb2);
    var x_msa = DhAudioBuffer_samples(x_ma);
    var x_msb = DhAudioBuffer_samples(x_mb2);
    var x_mi = 0;
    while (x_mi < 600) { if (vec_get(x_msa, x_mi) != vec_get(x_msb, x_mi)) { x_mok = 0; } x_mi = x_mi + 1; }
    x_mblk = x_mblk + 1;
}
assert_eq(x_mok, 1, "bit-identical to the 2.3.2 loop, 0 bytes per block");
assert_eq(dhvani_moddelay_lfo_phase(x_mn), dhvani_moddelay_lfo_phase(x_mo), "same lfo phase");

# ---- moddelay_set_params_grows_ring ----
# set_params with a base + depth past the ring (valid params) used to abort the next
# process (a negative read index). The ring now grows, keeping its history.
test_group("moddelay_set_params_grows_ring");
var x_gm = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
var x_gold = DhDelayLine_max_delay_samples(DhModulatedDelay_delay(x_gm));
var x_big = dhvani_moddelayparams_new(20.0, 3.0, 0.5, 0.3, 0.5);
assert_eq(dhvani_moddelayparams_validate(x_big), DHVANI_ERR_NONE, "20 ms base is valid");
dhvani_moddelay_set_params(x_gm, x_big);
assert_eq(DhDelayLine_max_delay_samples(DhModulatedDelay_delay(x_gm)), 1058, "ring grown to 24 ms @44.1k");
assert(x_gold < 1058, "it was smaller");
var x_gb = x_mono(4096, 0.3, 44100);
dhvani_moddelay_process(x_gm, x_gb);
assert_eq(x_all_finite(x_gb), 1, "processes after the grow");
var x_gsmall = dhvani_moddelayparams_default();
var x_gu = alloc_used();
dhvani_moddelay_set_params(x_gm, x_gsmall);
assert_eq(alloc_used() - x_gu, 0, "a change that fits the ring allocates nothing");
# the grow keeps every sample at its age: an impulse 1 frame before the grow comes out
# of a 3-sample delay 2 frames after it
var x_gd = dhvani_delay_new(3.0, 5.0, 0, 1.0, 1000, 1);
var x_gv = vec_new(); vec_push(x_gv, 1.0); vec_push(x_gv, 0);
dhvani_delay_process(x_gd, dhvani_buffer_from_interleaved(x_gv, 1, 1000));
dh_delay_grow(x_gd, 12);
assert_eq(DhDelayLine_max_delay_samples(x_gd), 12, "grown to 12");
var x_gb2 = x_mono(4, 0, 1000);
dhvani_delay_process(x_gd, x_gb2);
assert_eq(vec_get(DhAudioBuffer_samples(x_gb2), 1), 1.0, "the impulse kept its age across the grow");
# process clamps the read to the ring, whatever the params say (raw field write)
var x_cm = dhvani_moddelay_new(dhvani_moddelayparams_default(), 44100, 1);
DhModulatedDelayParams_set_depth_ms(DhModulatedDelay_params(x_cm), 80.0);
var x_cb = x_mono(4096, 0.3, 44100);
dhvani_moddelay_process(x_cm, x_cb);
assert_eq(x_all_finite(x_cb), 1, "read delay clamped to the ring (no abort)");
var x_lr = dhvani_moddelay_new(dhvani_moddelayparams_default(), 500, 1);
var x_lrb = x_mono(5000, 0.3, 500);
dhvani_moddelay_process(x_lr, x_lrb);
assert_eq(x_all_finite(x_lrb), 1, "500 Hz rate: read stays inside the 5-sample ring");

# ---- moddelay_lfo_phase_is_fmod ----
# Rust: lfo_phase = (lfo_phase + inc) % 1.0. A rate above the sample rate (inc = 1.5)
# made the single conditional subtract drift: 1.5 after 3 frames where Rust has 0.5.
test_group("moddelay_lfo_phase_is_fmod");
var x_fm = dhvani_moddelay_new(dhvani_moddelayparams_new(1.0, 0.5, 1500.0, 0, 0.5), 1000, 1);
dhvani_moddelay_process(x_fm, x_mono(3, 0.1, 1000));
assert_eq(dhvani_moddelay_lfo_phase(x_fm), F64_HALF, "after 3 frames: 0.5 (rust-old)");
dhvani_moddelay_process(x_fm, x_mono(4, 0.1, 1000));
assert_eq(dhvani_moddelay_lfo_phase(x_fm), F64_HALF, "after 7 frames: 0.5 (rust-old)");
# x % 1.0 on the pinned Rust toolchain: { x bits, (x % 1.0) bits }
var x_fq = vec_new();
fn x_fq2(v, x, r) { vec_push(v, x); vec_push(v, r); return 0; }
x_fq2(x_fq, 0x0000000000000000, 0x0000000000000000);
x_fq2(x_fq, 0x8000000000000000, 0x8000000000000000);
x_fq2(x_fq, 0x3FD0000000000000, 0x3FD0000000000000);
x_fq2(x_fq, 0xBFD0000000000000, 0xBFD0000000000000);
x_fq2(x_fq, 0x3FE8000000000000, 0x3FE8000000000000);
x_fq2(x_fq, 0x3FF0000000000000, 0x0000000000000000);
x_fq2(x_fq, 0xBFF0000000000000, 0x8000000000000000);
x_fq2(x_fq, 0x3FF4000000000000, 0x3FD0000000000000);
x_fq2(x_fq, 0xBFF4000000000000, 0xBFD0000000000000);
x_fq2(x_fq, 0x3FF8000000000000, 0x3FE0000000000000);
x_fq2(x_fq, 0x4004CCCCCCCCCCCD, 0x3FE3333333333334);
x_fq2(x_fq, 0xC004CCCCCCCCCCCD, 0xBFE3333333333334);
x_fq2(x_fq, 0x4008CCCCCCCCCCCD, 0x3FB99999999999A0);
x_fq2(x_fq, 0x3FEFFFFFFFFFFFFF, 0x3FEFFFFFFFFFFFFF);
x_fq2(x_fq, 0x3FF0000000000001, 0x3CB0000000000000);
x_fq2(x_fq, 0x432FFFFFFFFFFFFF, 0x3FE0000000000000);
x_fq2(x_fq, 0x4330000000000000, 0x0000000000000000);
x_fq2(x_fq, 0xC330000000000001, 0x8000000000000000);
x_fq2(x_fq, 0x7E37E43C8800759C, 0x0000000000000000);
x_fq2(x_fq, 0xFE37E43C8800759C, 0x8000000000000000);
x_fq2(x_fq, 0x0000000000000001, 0x0000000000000001);
x_fq2(x_fq, 0x8000000000000001, 0x8000000000000001);
var x_fok = 1;
var x_fi = 0;
while (x_fi < vec_len(x_fq)) {
    if (dh_fmod1(vec_get(x_fq, x_fi)) != vec_get(x_fq, x_fi + 1)) { x_fok = 0; }
    x_fi = x_fi + 2;
}
assert_eq(x_fok, 1, "dh_fmod1 = Rust x % 1.0, bit for bit (22 values)");
var x_finf = dh_fmod1(DH_POS_INF);
assert_eq(f64_eq(x_finf, x_finf), 0, "+Inf % 1.0 is NaN");
var x_fninf = dh_fmod1(DH_NEG_INF);
assert_eq(f64_eq(x_fninf, x_fninf), 0, "-Inf % 1.0 is NaN");

# ---- moddelay_params_owned ----
# The params are copied in (the oracle takes them by value): mutating the caller's
# handle afterwards reaches neither new() nor set_params().
test_group("moddelay_params_owned");
var x_op = dhvani_moddelayparams_default();
var x_om = dhvani_moddelay_new(x_op, 44100, 1);
DhModulatedDelayParams_set_depth_ms(x_op, 500.0);
assert_eq(DhModulatedDelayParams_depth_ms(DhModulatedDelay_params(x_om)), 3.0, "new: depth still 3 ms");
var x_op2 = dhvani_moddelayparams_new(6.0, 2.0, 0.5, 0.3, 0.5);
dhvani_moddelay_set_params(x_om, x_op2);
DhModulatedDelayParams_set_base_delay_ms(x_op2, 900.0);
assert_eq(DhModulatedDelayParams_base_delay_ms(DhModulatedDelay_params(x_om)), 6.0, "set_params: base still 6 ms");

# ---- moddelay_validate_rejects_nan ----
test_group("moddelay_validate_rejects_nan");
fn x_mdv(base, depth, rate, fb, mix) {
    return dhvani_moddelayparams_validate(dhvani_moddelayparams_new(base, depth, rate, fb, mix));
}
var x_bad = DHVANI_ERR_INVALID_PARAMETER;
assert_eq(x_mdv(7.0, 3.0, 0.5, x_nan, 0.5), x_bad, "NaN feedback (oracle: contains rejects)");
assert_eq(x_mdv(7.0, 3.0, 0.5, 0.3, x_nan), x_bad, "NaN mix (oracle: contains rejects)");
assert_eq(x_mdv(x_nan, 3.0, 0.5, 0.3, 0.5), x_bad, "NaN base");
assert_eq(x_mdv(7.0, x_nan, 0.5, 0.3, 0.5), x_bad, "NaN depth");
assert_eq(x_mdv(7.0, 3.0, x_nan, 0.3, 0.5), x_bad, "NaN rate");
assert_eq(dhvani_moddelayparams_validate(dhvani_moddelayparams_default()), DHVANI_ERR_NONE, "default valid");

var rc = assert_summary();
syscall(60, rc);
