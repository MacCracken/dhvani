# ================================================================
# biquad_peaking_exact_boost
# Peaking +6dB at center (1kHz, Q=1) -> +6 dB, tol 0.01.
# ================================================================
test_group("biquad_peaking_exact_boost");
var filt_e = dhvani_biquad_new(DH_BQ_PEAKING, 6.0, 1000.0, 1.0, 48000, 1);
var buf_e = make_sine_mono(1000.0, 0.25, 48000, 96000);
var in_e = measure_steady_state_db(buf_e, 48000);
dhvani_biquad_process(filt_e, buf_e);
var out_e = measure_steady_state_db(buf_e, 48000);
assert(f64_lt(f64_abs(f64_sub(f64_sub(out_e, in_e), 6.0)), 0.01), "Peaking +6dB exact");

# ================================================================
# biquad_peaking_exact_cut
# Peaking -12dB at center (1kHz, Q=1) -> -12 dB, tol 0.01.
# ================================================================
test_group("biquad_peaking_exact_cut");
