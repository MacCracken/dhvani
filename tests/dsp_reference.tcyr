# dsp_reference.tcyr -- INTEGRATION numerical-accuracy parity tests.
# Ported one-for-one from the `dsp_reference_tests` submodule of
# rust-old/src/tests/mod.rs (RBJ biquad coeff math, limiter ceiling,
# compressor ratio, constant-power pan, DC/Nyquist gains, dB roundtrip).
# Links the assembled bundle (whole dhvani API), not individual modules.
#
# f32 -> f64 widening throughout. Reference values, target dBs, frequencies
# and tolerances copied EXACTLY from the Rust; nothing loosened beyond the
# f32->f64 widening. Rust std::f32::consts::FRAC_1_SQRT_2 = 0.7071067811865476.
#
# NOTE: the Cyrius lexer loses precision on decimal literals past ~9 significant
# digits (a 16-digit literal parses to a wildly-wrong value), so FRAC_1_SQRT_2
# is written to 9 sig figs (0.707106781, accurate to ~1e-9 -- orders of
# magnitude tighter than every tolerance here: 0.01 dB / 0.05 dB / 1e-10).

include "lib/abaco.cyr"
include "dist/dhvani.cyr"

alloc_init();

# ---- constants (mirror the Rust `const`s) ----
# DB_TOLERANCE = 0.01, SR = 48000, FRAMES = 96000, SKIP = 48000.
var FRAC_1_SQRT_2 = 0.707106781;

# ---- helper: measure_steady_state_db(buf, skip_frames) ----
# RMS in dB over frames [skip_frames, frames), all channels. DH_NEG_INF sentinel
# for silence (Rust f32::NEG_INFINITY).
fn measure_steady_state_db(buf, skip_frames) {
    var ch = dhvani_buffer_channels(buf);
    var samples = dhvani_buffer_samples(buf);
    var nframes = dhvani_buffer_frames(buf);
    var total = nframes - skip_frames;
    if (total == 0) { return DH_NEG_INF; }
    var sum_sq = f64_from(0);
    var frame = skip_frames;
    while (frame < nframes) {
        var c = 0;
        while (c < ch) {
            var s = vec_get(samples, frame * ch + c);
            sum_sq = f64_add(sum_sq, f64_mul(s, s));
            c = c + 1;
        }
        frame = frame + 1;
    }
    var rms = f64_sqrt(f64_div(sum_sq, f64_from(total * ch)));
    if (f64_lt(rms, 0.000000000000001) == 1) { return DH_NEG_INF; }
    return f64_mul(20.0, f64_div(f64_ln(rms), F64_LN10));
}

# ---- dB <-> amplitude ----
# abaco's dsp bundle provides the oracle pair directly:
#   db_to_amplitude(db)  = exp(db * ln10/20)  = 10^(db/20)
#   amplitude_to_db(amp) = (20/ln10) * ln(amp) = 20*log10(amp)
# Earlier the vendored port mis-encoded DB_SCALE/DB_EXP as f64 bit patterns
# (product 0.99919, not ~1.0), so the round trip drifted ~0.081% of |db| and
# blew the 0.01 dB tolerance for |db| >= 20; local F64_LN10 helpers routed
# around it. Fixed upstream in abaco src/dsp.cyr and re-vendored into
# lib/abaco.cyr, so these tests call the bare functions directly now.

# ---- helper: make_sine_mono(freq_hz, amplitude, sr, frames) ----
fn make_sine_mono(freq_hz, amplitude, sr, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), freq_hz), f64_from(i)), f64_from(sr));
        vec_push(v, f64_mul(amplitude, f64_sin(ph)));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 1, sr);
}

# ================================================================
# biquad_lp_at_cutoff_minus_3db
# LPF Butterworth at cutoff (1kHz) -> -3.01 dB, tol 0.05.
# ================================================================
test_group("biquad_lp_at_cutoff_minus_3db");
var filt_a = dhvani_biquad_new(DH_BQ_LOWPASS, 0, 1000.0, FRAC_1_SQRT_2, 48000, 1);
var buf_a = make_sine_mono(1000.0, 1.0, 48000, 96000);
var in_a = measure_steady_state_db(buf_a, 48000);
dhvani_biquad_process(filt_a, buf_a);
var out_a = measure_steady_state_db(buf_a, 48000);
var att_a = f64_sub(out_a, in_a);
assert(f64_lt(f64_abs(f64_sub(att_a, f64_neg(3.01))), 0.05), "LP at cutoff -3.01 dB");

# ================================================================
# biquad_lp_passband_unity
# LPF passband (100Hz, cutoff 5kHz) -> 0 dB, tol 0.01.
# ================================================================
test_group("biquad_lp_passband_unity");
var filt_b = dhvani_biquad_new(DH_BQ_LOWPASS, 0, 5000.0, FRAC_1_SQRT_2, 48000, 1);
var buf_b = make_sine_mono(100.0, 0.5, 48000, 96000);
var in_b = measure_steady_state_db(buf_b, 48000);
dhvani_biquad_process(filt_b, buf_b);
var out_b = measure_steady_state_db(buf_b, 48000);
assert(f64_lt(f64_abs(f64_sub(out_b, in_b)), 0.01), "LP passband unity");

# ================================================================
# biquad_hp_passband_unity
# HPF passband (5kHz, cutoff 100Hz) -> 0 dB, tol 0.01.
# ================================================================
test_group("biquad_hp_passband_unity");
var filt_c = dhvani_biquad_new(DH_BQ_HIGHPASS, 0, 100.0, FRAC_1_SQRT_2, 48000, 1);
var buf_c = make_sine_mono(5000.0, 0.5, 48000, 96000);
var in_c = measure_steady_state_db(buf_c, 48000);
dhvani_biquad_process(filt_c, buf_c);
var out_c = measure_steady_state_db(buf_c, 48000);
assert(f64_lt(f64_abs(f64_sub(out_c, in_c)), 0.01), "HP passband unity");

