dhvani_biquad_process(filt_f, buf_f);
var out_f = measure_steady_state_db(buf_f, 48000);
assert(f64_lt(f64_abs(f64_sub(f64_sub(out_f, in_f), f64_neg(12.0))), 0.01), "Peaking -12dB exact");

# ================================================================
# biquad_peaking_passthrough_off_freq
# Peaking +12dB @ 10kHz Q=2, signal 100Hz -> 0 dB, tol 0.01.
# ================================================================
test_group("biquad_peaking_passthrough_off_freq");
