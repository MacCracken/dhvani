# ================================================================
# biquad_low_shelf_exact_boost
# LowShelf +6dB @ 1kHz, signal 50Hz -> +6 dB, tol 0.01.
# ================================================================
test_group("biquad_low_shelf_exact_boost");
var filt_h = dhvani_biquad_new(DH_BQ_LOWSHELF, 6.0, 1000.0, FRAC_1_SQRT_2, 48000, 1);
var buf_h = make_sine_mono(50.0, 0.25, 48000, 96000);
var in_h = measure_steady_state_db(buf_h, 48000);
dhvani_biquad_process(filt_h, buf_h);
var out_h = measure_steady_state_db(buf_h, 48000);
assert(f64_lt(f64_abs(f64_sub(f64_sub(out_h, in_h), 6.0)), 0.01), "Low shelf +6dB exact");

# ================================================================
# biquad_high_shelf_exact_boost
# HighShelf +6dB @ 1kHz, signal 15kHz -> +6 dB, tol 0.01.
# ================================================================
test_group("biquad_high_shelf_exact_boost");
var filt_i = dhvani_biquad_new(DH_BQ_HIGHSHELF, 6.0, 1000.0, FRAC_1_SQRT_2, 48000, 1);
var buf_i = make_sine_mono(15000.0, 0.25, 48000, 96000);
var in_i = measure_steady_state_db(buf_i, 48000);
dhvani_biquad_process(filt_i, buf_i);
