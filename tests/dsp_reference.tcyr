# ================================================================
# biquad_allpass_unity_magnitude
# AllPass @ 1kHz -> 0 dB at [100,500,1000,5000,15000] Hz, tol 0.01.
# ================================================================
test_group("biquad_allpass_unity_magnitude");
var filt_j = dhvani_biquad_new(DH_BQ_ALLPASS, 0, 1000.0, FRAC_1_SQRT_2, 48000, 1);
var freqs_j = vec_new();
vec_push(freqs_j, 100.0); vec_push(freqs_j, 500.0); vec_push(freqs_j, 1000.0);
vec_push(freqs_j, 5000.0); vec_push(freqs_j, 15000.0);
var jf = 0;
var jok = 1;
while (jf < vec_len(freqs_j)) {
    var buf_j = make_sine_mono(vec_get(freqs_j, jf), 0.5, 48000, 96000);
    var in_j = measure_steady_state_db(buf_j, 48000);
    dhvani_biquad_reset(filt_j);
    dhvani_biquad_process(filt_j, buf_j);
    var out_j = measure_steady_state_db(buf_j, 48000);
    if (f64_lt(f64_abs(f64_sub(out_j, in_j)), 0.01) == 0) { jok = 0; }
    jf = jf + 1;
}
assert_eq(jok, 1, "AllPass unity magnitude all freqs");

# ================================================================
# biquad_notch_deep_at_center
# Notch @ 1kHz Q=10, signal 1kHz -> >40 dB rejection.
# ================================================================
test_group("biquad_notch_deep_at_center");
var filt_k = dhvani_biquad_new(DH_BQ_NOTCH, 0, 1000.0, 10.0, 48000, 1);
var buf_k = make_sine_mono(1000.0, 0.5, 48000, 96000);
var in_k = measure_steady_state_db(buf_k, 48000);
dhvani_biquad_process(filt_k, buf_k);
var out_k = measure_steady_state_db(buf_k, 48000);
assert(f64_gt(f64_sub(in_k, out_k), 40.0), "Notch >40 dB rejection");

# ================================================================
# limiter_ceiling_accuracy
# ceiling -6 dB, release 10ms; hot 440Hz full-scale sine; after SKIP no
# |sample| exceeds 10^((ceiling+0.01)/20).
# ================================================================
test_group("limiter_ceiling_accuracy");
var ceiling_db = f64_neg(6.0);
var lp2 = dhvani_limparams_new(ceiling_db, 10.0, 0, 1.0);
var lim = dhvani_lim_new(lp2, 48000);
assert(lim != 0, "limiter built");
var buf_l = make_sine_mono(440.0, 1.0, 48000, 96000);
dhvani_lim_process(lim, buf_l);
var tol_lin = db_to_amplitude(f64_add(ceiling_db, 0.01));
var sl = dhvani_buffer_samples(buf_l);
var li = 48000;
var lok = 1;
while (li < 96000) {
    if (f64_le(f64_abs(vec_get(sl, li)), tol_lin) == 0) { lok = 0; }
    li = li + 1;
}
assert_eq(lok, 1, "limiter never exceeds ceiling");

# ================================================================
# compressor_below_threshold_unity
# threshold -6, ratio 4, attack 1ms, release 50ms; -20 dBFS 440Hz -> 0 dB gain.
# ================================================================
test_group("compressor_below_threshold_unity");
var cparams = dhvani_compparams_new(f64_neg(6.0), 4.0, 1.0, 50.0, 0, 0, 1.0);
var comp = dhvani_comp_new(cparams, 48000);
assert(comp != 0, "compressor built");
var amp_m = db_to_amplitude(f64_neg(20.0));
var buf_m = make_sine_mono(440.0, amp_m, 48000, 96000);
var in_m = measure_steady_state_db(buf_m, 48000);
dhvani_comp_process(comp, buf_m);
var out_m = measure_steady_state_db(buf_m, 48000);
assert(f64_lt(f64_abs(f64_sub(out_m, in_m)), 0.01), "compressor below threshold unity");

# ================================================================
# panner_center_constant_power
# center pan (0.0): stereo L^2+R^2 power == mono power, 0 dB tol 0.01.
# ================================================================
test_group("panner_center_constant_power");
var panner = dhvani_pan_new(0);
var mono_buf = make_sine_mono(440.0, 0.5, 48000, 96000);
var mono = dhvani_buffer_samples(mono_buf);
# mono input power over [SKIP, FRAMES)
var mono_power = f64_from(0);
var pi = 48000;
while (pi < 96000) {
    var ms = vec_get(mono, pi);
    mono_power = f64_add(mono_power, f64_mul(ms, ms));
    pi = pi + 1;
}
mono_power = f64_div(mono_power, f64_from(96000 - 48000));
# duplicate to stereo interleaved
var stereo = vec_new();
var si = 0;
while (si < 96000) {
    var mv = vec_get(mono, si);
    vec_push(stereo, mv);
    vec_push(stereo, mv);
    si = si + 1;
}
var buf_p = dhvani_buffer_from_interleaved(stereo, 2, 48000);
dhvani_pan_process(panner, buf_p);
var sp = dhvani_buffer_samples(buf_p);
var stereo_power = f64_from(0);
var pf = 48000;
while (pf < 96000) {
    var l = vec_get(sp, pf * 2);
    var r = vec_get(sp, pf * 2 + 1);
    stereo_power = f64_add(stereo_power, f64_add(f64_mul(l, l), f64_mul(r, r)));
    pf = pf + 1;
}
stereo_power = f64_div(stereo_power, f64_from(96000 - 48000));
var pratio_db = f64_mul(10.0, f64_div(f64_ln(f64_div(stereo_power, mono_power)), F64_LN10));
assert(f64_lt(f64_abs(pratio_db), 0.01), "Panner center constant power 0 dB");

# ================================================================
# biquad_coeffs_dc_gain_unity_lp
# LPF DC gain = (b0+b1+b2)/(1+a1+a2) -> 0 dB, tol 0.01.
# ================================================================
test_group("biquad_coeffs_dc_gain_unity_lp");
var c_lp = dhvani_biquad_design(DH_BQ_LOWPASS, 0, 1000.0, FRAC_1_SQRT_2, 48000);
var dc_gain = f64_div(
    f64_add(f64_add(DhBiquadCoeffs_b0(c_lp), DhBiquadCoeffs_b1(c_lp)), DhBiquadCoeffs_b2(c_lp)),
    f64_add(f64_add(1.0, DhBiquadCoeffs_a1(c_lp)), DhBiquadCoeffs_a2(c_lp)));
var dc_db = f64_mul(20.0, f64_div(f64_ln(f64_abs(dc_gain)), F64_LN10));
assert(f64_lt(f64_abs(dc_db), 0.01), "LPF DC gain 0 dB");

# ================================================================
# biquad_coeffs_dc_gain_zero_hp
# HPF DC gain ~ 0 (< 1e-10).
# ================================================================
test_group("biquad_coeffs_dc_gain_zero_hp");
var c_hp = dhvani_biquad_design(DH_BQ_HIGHPASS, 0, 1000.0, FRAC_1_SQRT_2, 48000);
var dc_gain_hp = f64_div(
    f64_add(f64_add(DhBiquadCoeffs_b0(c_hp), DhBiquadCoeffs_b1(c_hp)), DhBiquadCoeffs_b2(c_hp)),
    f64_add(f64_add(1.0, DhBiquadCoeffs_a1(c_hp)), DhBiquadCoeffs_a2(c_hp)));
assert(f64_lt(f64_abs(dc_gain_hp), 0.0000000001), "HPF DC gain ~0");

# ================================================================
# biquad_coeffs_nyquist_gain_unity_hp
# HPF Nyquist gain = (b0-b1+b2)/(1-a1+a2) -> 0 dB, tol 0.01.
# ================================================================
test_group("biquad_coeffs_nyquist_gain_unity_hp");
var c_hp2 = dhvani_biquad_design(DH_BQ_HIGHPASS, 0, 1000.0, FRAC_1_SQRT_2, 48000);
var nyq_gain = f64_div(
    f64_add(f64_sub(DhBiquadCoeffs_b0(c_hp2), DhBiquadCoeffs_b1(c_hp2)), DhBiquadCoeffs_b2(c_hp2)),
    f64_add(f64_sub(1.0, DhBiquadCoeffs_a1(c_hp2)), DhBiquadCoeffs_a2(c_hp2)));
var nyq_db = f64_mul(20.0, f64_div(f64_ln(f64_abs(nyq_gain)), F64_LN10));
assert(f64_lt(f64_abs(nyq_db), 0.01), "HPF Nyquist gain 0 dB");

# ================================================================
# db_conversion_roundtrip_accuracy
# db -> amp -> db within 0.01 for [-60,-40,-20,-6,-3,0,3,6,12,20].
# ================================================================
test_group("db_conversion_roundtrip_accuracy");
var dbs = vec_new();
vec_push(dbs, f64_neg(60.0)); vec_push(dbs, f64_neg(40.0)); vec_push(dbs, f64_neg(20.0));
vec_push(dbs, f64_neg(6.0)); vec_push(dbs, f64_neg(3.0)); vec_push(dbs, f64_from(0));
vec_push(dbs, 3.0); vec_push(dbs, 6.0); vec_push(dbs, 12.0); vec_push(dbs, 20.0);
var di = 0;
var dok = 1;
while (di < vec_len(dbs)) {
    var db = vec_get(dbs, di);
    var amp = db_to_amplitude(db);
    var back = amplitude_to_db(amp);
    if (f64_lt(f64_abs(f64_sub(back, db)), 0.01) == 0) { dok = 0; }
    di = di + 1;
}
assert_eq(dok, 1, "dB roundtrip accuracy");

var rc = assert_summary();
syscall(60, rc);
