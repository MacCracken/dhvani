# deesser.tcyr -- parity tests for src/deesser.cyr
# Ported one-for-one from the 7 #[test] blocks in rust-old/src/dsp/deesser.rs.
# No serde/Display tests to drop. The Rust `sidechain_buffer_reused` test asserts
# Vec::capacity() stability across calls; Cyrius vecs expose no capacity, so it is
# ported as the observable reuse invariant: non-empty after process, length stable
# across two equal-size process calls.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/biquad.cyr"
include "src/deesser.cyr"

alloc_init();

# amplitude * sin(2*pi*freq*i/44100) mono @44100 (frames samples).
fn make_sine(freq, amplitude, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), freq), f64_from(i)), f64_from(44100));
        vec_push(v, f64_mul(amplitude, f64_sin(ph)));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 1, 44100);
}
fn all_finite(buf) {
    var s = dhvani_buffer_samples(buf);
    var n = vec_len(s);
    var i = 0;
    while (i < n) { if (dhvani_is_finite(vec_get(s, i)) == 0) { return 0; } i = i + 1; }
    return 1;
}

# ---- low_frequency_unaffected ----
test_group("low_frequency_unaffected");
var d1 = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0), 44100, 1);
var b1 = make_sine(200.0, 0.8, 4096);
var orig1 = dhvani_buffer_rms(b1);
dhvani_deesser_process(d1, b1);
# 200Hz should not trigger the de-esser at 6kHz: rms change < 10% of original.
assert(f64_lt(f64_abs(f64_sub(dhvani_buffer_rms(b1), orig1)), f64_mul(orig1, 0.1)), "200Hz not de-essed at 6kHz");

# ---- sibilance_reduced ----
test_group("sibilance_reduced");
var d2 = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 1.0), 44100, 1);
var b2 = make_sine(6000.0, 0.8, 4096);
var orig2 = dhvani_buffer_rms(b2);
dhvani_deesser_process(d2, b2);
assert(f64_lt(dhvani_buffer_rms(b2), f64_mul(orig2, 0.8)), "6kHz reduced by de-esser");

# ---- below_threshold_passthrough ----
test_group("below_threshold_passthrough");
var d3 = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, 0, 12.0, 2.0), 44100, 1);
var b3 = make_sine(6000.0, 0.1, 4096);
var orig3 = dhvani_buffer_rms(b3);
dhvani_deesser_process(d3, b3);
# Signal too quiet to trigger: rms change < 15% of original.
assert(f64_lt(f64_abs(f64_sub(dhvani_buffer_rms(b3), orig3)), f64_mul(orig3, 0.15)), "below-threshold near-unchanged");

# ---- reset_clears_state ----
test_group("reset_clears_state");
var d4 = dhvani_deesser_new(dhvani_deesserparams_default(), 44100, 1);
var b4 = make_sine(6000.0, 0.8, 256);
dhvani_deesser_process(d4, b4);
dhvani_deesser_reset(d4);
var out4 = dhvani_biquad_process_sample(dhvani_deesser_detector(d4), 0, 0);
assert(f64_lt(f64_abs(out4), DH_EPSILON), "reset clears detector state");

# ---- set_params_updates_detector ----
test_group("set_params_updates_detector");
var d5 = dhvani_deesser_new(dhvani_deesserparams_default(), 44100, 1);
var rc5 = dhvani_deesser_set_params(d5, dhvani_deesserparams_new(8000.0, f64_neg(20.0), 8.0, 3.0));
assert_eq(rc5, DHVANI_ERR_NONE, "set_params ok");
var b5 = make_sine(8000.0, 0.8, 4096);
dhvani_deesser_process(d5, b5);
assert_eq(all_finite(b5), 1, "set_params output finite");

# ---- stereo_deessing ----
test_group("stereo_deessing");
var d6 = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 1.0), 44100, 2);
var sv6 = vec_new();
var si6 = 0;
while (si6 < 8192) {
    var ph6 = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 6000.0), f64_from(si6 / 2)), f64_from(44100));
    vec_push(sv6, f64_mul(0.8, f64_sin(ph6)));
    si6 = si6 + 1;
}
var b6 = dhvani_buffer_from_interleaved(sv6, 2, 44100);
dhvani_deesser_process(d6, b6);
assert_eq(all_finite(b6), 1, "stereo output finite");

# ---- sidechain_buffer_reused ----
test_group("sidechain_buffer_reused");
var d7 = dhvani_deesser_new(dhvani_deesserparams_default(), 44100, 1);
var b7 = make_sine(6000.0, 0.8, 1024);
dhvani_deesser_process(d7, b7);
# After process the sidechain vec is populated (reusable).
var len_after_first = vec_len(DhDeEsser_sidechain(d7));
assert(len_after_first > 0, "sidechain populated after first process");
# Process again with an equal-size buffer: same allocation, length unchanged.
var b7b = make_sine(6000.0, 0.8, 1024);
dhvani_deesser_process(d7, b7b);
assert_eq(vec_len(DhDeEsser_sidechain(d7)), len_after_first, "sidechain length stable (reused)");

# ---- block_split_invariance (regression, 2.3.2) ----
# The de-esser is block-partition invariant: the detector state is continuous and
# the gain is decided per frame, so the same signal split as 4x256 frames or as
# 512+256+256 must come out bit-identical. Through 2.3.1 the sidechain vec only
# grew, and the biquad stereo fast path ran vec_len/2 frames, so after a 512-frame
# block every 256-frame block also filtered the stale tail of the previous one:
# the detector state ran 256 frames ahead and the next block's gains were wrong
# (58 of 512 samples differed). Mono never took the fast path and was unaffected.
test_group("block_split_invariance");
fn ds_sig(f0, n, ch) {
    var v = vec_new();
    var f = 0;
    while (f < n) {
        var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 6000.0), f64_from(f0 + f)), f64_from(44100));
        var s = f64_mul(0.5, f64_sin(ph));
        var c = 0;
        while (c < ch) { vec_push(v, s); c = c + 1; }
        f = f + 1;
    }
    return dhvani_buffer_from_interleaved(v, ch, 44100);
}
fn ds_ndiff(a, b) {
    var sa = dhvani_buffer_samples(a);
    var sb = dhvani_buffer_samples(b);
    var n = vec_len(sa);
    var i = 0;
    var d = 0;
    while (i < n) { if (vec_get(sa, i) != vec_get(sb, i)) { d = d + 1; } i = i + 1; }
    return d;
}
fn ds_split_diffs(ch) {
    var da = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0), 44100, ch);
    var db = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0), 44100, ch);
    var a0 = ds_sig(0, 256, ch);
    dhvani_deesser_process(da, a0);
    var a1 = ds_sig(256, 256, ch);
    dhvani_deesser_process(da, a1);
    var a2 = ds_sig(512, 256, ch);
    dhvani_deesser_process(da, a2);
    var a3 = ds_sig(768, 256, ch);
    dhvani_deesser_process(da, a3);
    var b0 = ds_sig(0, 512, ch);
    dhvani_deesser_process(db, b0);
    var b2 = ds_sig(512, 256, ch);
    dhvani_deesser_process(db, b2);
    # the sidechain is exactly this block's length, as the oracle's resize(len)
    assert_eq(vec_len(DhDeEsser_sidechain(db)), 256 * ch, "sidechain sized to the block");
    var b3 = ds_sig(768, 256, ch);
    dhvani_deesser_process(db, b3);
    return ds_ndiff(a2, b2) + ds_ndiff(a3, b3);
}
assert_eq(ds_split_diffs(1), 0, "mono: 4x256 == 512+256+256, bit for bit");
assert_eq(ds_split_diffs(2), 0, "stereo: 4x256 == 512+256+256, bit for bit");

# ---- set_params_is_alloc_free (regression, 2.3.2) ----
# Through 2.3.1 set_params / set_sample_rate built a whole new detector biquad per
# call (296 bytes) -- an unbounded leak under parameter automation.
test_group("set_params_is_alloc_free");
var d8 = dhvani_deesser_new(dhvani_deesserparams_default(), 44100, 2);
var p8 = dhvani_deesserparams_new(7000.0, f64_neg(20.0), 6.0, 2.0);
var rc8 = dhvani_deesser_set_params(d8, p8);
var u8a = alloc_used();
var k8 = 0;
while (k8 < 100) { rc8 = dhvani_deesser_set_params(d8, p8); k8 = k8 + 1; }
dhvani_deesser_set_sample_rate(d8, 48000);
var u8b = alloc_used();
assert_eq(u8b - u8a, 0, "100x set_params + set_sample_rate allocate 0 bytes");
assert_eq(rc8, DHVANI_ERR_NONE, "set_params ok");
# the in-place rebuild is the oracle's fresh filter: same coefficients, zero state
var fresh8 = dhvani_biquad_new(DH_BQ_BANDPASS, 0, 7000.0, 2.0, 48000, 2);
var c8 = DhBiquadFilter_coeffs(dhvani_deesser_detector(d8));
var f8 = DhBiquadFilter_coeffs(fresh8);
assert_eq(DhBiquadCoeffs_b0(c8), DhBiquadCoeffs_b0(f8), "b0 == fresh filter");
assert_eq(DhBiquadCoeffs_a1(c8), DhBiquadCoeffs_a1(f8), "a1 == fresh filter");
assert_eq(DhBiquadCoeffs_a2(c8), DhBiquadCoeffs_a2(f8), "a2 == fresh filter");
var b8 = ds_sig(0, 512, 2);
dhvani_deesser_process(d8, b8);
var rc8b = dhvani_deesser_set_params(d8, p8);
assert_eq(dhvani_biquad_process_sample(dhvani_deesser_detector(d8), 0, 0), 0, "set_params zeroes detector state");
assert_eq(rc8b, DHVANI_ERR_NONE, "set_params ok");
var u8c = alloc_used();
var b8b = ds_sig(512, 512, 2);
var u8d = alloc_used();
dhvani_deesser_process(d8, b8b);
var u8e = alloc_used();
assert_eq(u8e - u8d, 0, "steady-state process allocates 0 bytes");
assert(u8d - u8c > 0, "sanity: building the input buffer did allocate");

# ---- params_are_copied (regression, 2.3.2) ----
# The oracle moves DeEsserParams into the processor. Through 2.3.1 the port kept the
# caller's handle, so mutating it later half-applied: threshold/reduction changed
# live while freq/q stayed baked into the detector.
test_group("params_are_copied");
var p9 = dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0);
var d9 = dhvani_deesser_new(p9, 44100, 1);
var dref9 = dhvani_deesser_new(dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0), 44100, 1);
DhDeEsserParams_set_threshold_db(p9, 0);
DhDeEsserParams_set_reduction_db(p9, 0);
var b9 = ds_sig(0, 1024, 1);
var bref9 = ds_sig(0, 1024, 1);
dhvani_deesser_process(d9, b9);
dhvani_deesser_process(dref9, bref9);
assert_eq(ds_ndiff(b9, bref9), 0, "mutating the caller's handle after new() changes nothing");
var p9b = dhvani_deesserparams_new(6000.0, f64_neg(30.0), 12.0, 2.0);
var rc9 = dhvani_deesser_set_params(d9, p9b);
DhDeEsserParams_set_threshold_db(p9b, 0);
assert_eq(rc9, DHVANI_ERR_NONE, "set_params ok");
assert_eq(DhDeEsserParams_threshold_db(DhDeEsser_params(d9)), f64_neg(30.0), "set_params copied, not aliased");
var bad9 = dhvani_deesser_set_params(d9, dhvani_deesserparams_new(0, 0, 0, 0));
assert_eq(bad9, DHVANI_ERR_INVALID_PARAMETER, "invalid params rejected");
assert_eq(DhDeEsserParams_freq_hz(DhDeEsser_params(d9)), 6000.0, "rejected params leave the old ones");

# ---- zero_channel_buffer (hardening, 2.3.2) ----
test_group("zero_channel_buffer");
var d10 = dhvani_deesser_new(dhvani_deesserparams_default(), 44100, 1);
var z10 = dhvani_buffer_silence(0, 16, 44100);
dhvani_deesser_process(d10, z10);
assert_eq(vec_len(dhvani_buffer_samples(z10)), 0, "0-channel buffer is a no-op");

var rc = assert_summary();
syscall(60, rc);
