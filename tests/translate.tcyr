# translate.tcyr -- parity tests for src/translate.cyr
# Ported one-for-one from the 12 #[test] blocks in rust-old/src/midi/translate.rs.
# No serde round-trip or Display-string tests exist in the oracle -> none dropped.
# Groups after `pitch_bend_center_constant` are port regressions (type-width
# masking and saturation, the note-on velocity floor, zero-alloc `_into`) and the
# min-center-max up-scaling that replaced the oracle's bit replication (ADR 005).

include "src/error.cyr"
include "src/midi.cyr"
include "src/midi_v2.cyr"
include "src/translate.cyr"

alloc_init();

# ---- velocity_7_to_16_zero ----
test_group("velocity_7_to_16_zero");
assert_eq(dhvani_miditx_velocity_7_to_16(0), 0, "v7->16(0) = 0");

# ---- velocity_7_to_16_max ----
test_group("velocity_7_to_16_max");
var vmax = dhvani_miditx_velocity_7_to_16(127);
assert_eq(vmax > 65000, 1, "max velocity near 65535");

# ---- velocity_roundtrip ----
test_group("velocity_roundtrip");
var vr = 0;
while (vr <= 127) {
    var v16r = dhvani_miditx_velocity_7_to_16(vr);
    var backr = dhvani_miditx_velocity_16_to_7(v16r);
    assert_eq(backr, vr, "velocity roundtrip");
    vr = vr + 1;
}

# ---- cc_roundtrip ----
test_group("cc_roundtrip");
var cr = 0;
while (cr <= 127) {
    var v32c = dhvani_miditx_cc_7_to_32(cr);
    var backc = dhvani_miditx_cc_32_to_7(v32c);
    assert_eq(backc, cr, "cc roundtrip");
    cr = cr + 1;
}

# ---- pitch_bend_roundtrip ----
test_group("pitch_bend_roundtrip");
var pbv = vec_new();
vec_push(pbv, 0);
vec_push(pbv, 1);
vec_push(pbv, 8192);
vec_push(pbv, 16383);
var pi = 0;
while (pi < vec_len(pbv)) {
    var pv = vec_get(pbv, pi);
    var v32p = dhvani_miditx_pitch_bend_14_to_32(pv);
    var backp = dhvani_miditx_pitch_bend_32_to_14(v32p);
    assert_eq(backp, pv, "pitch bend roundtrip");
    pi = pi + 1;
}

# ---- pitch_bend_center ----
test_group("pitch_bend_center");
var center14 = 8192;
var v32center = dhvani_miditx_pitch_bend_14_to_32(center14);
var backcenter = dhvani_miditx_pitch_bend_32_to_14(v32center);
assert_eq(backcenter, center14, "pitch bend center roundtrip");

# ---- note_event_to_v2_and_back ----
test_group("note_event_to_v2_and_back");
var ev = dhvani_note_event_new(1000, 500, 60, 100, 0);
var v2 = dhvani_miditx_note_event_to_v2(ev);
assert_eq(dhvani_midi2_note_on_note(v2), 60, "v2 note = 60");
assert_eq(dhvani_midi2_note_on_channel(v2), 0, "v2 channel = 0");
var back = dhvani_miditx_note_on_v2_to_event(v2, 500);
assert_eq(dhvani_note_event_note(back), 60, "back note = 60");
assert_eq(dhvani_note_event_velocity(back), 100, "back velocity = 100");
assert_eq(dhvani_note_event_duration(back), 500, "back duration = 500");

# ---- cc_to_v2_and_back ----
test_group("cc_to_v2_and_back");
var cc = dhvani_cc_new(0, 7, 100, 0);
var ccv2 = dhvani_miditx_cc_to_v2(cc);
assert_eq(dhvani_midi2_cc_controller(ccv2), 7, "ccv2 controller = 7");
var ccback = dhvani_miditx_cc_v2_to_cc(ccv2);
assert_eq(dhvani_cc_controller(ccback), 7, "ccback controller = 7");
assert_eq(dhvani_cc_value(ccback), 100, "ccback value = 100");

# ---- cc_7_to_32_max ----
test_group("cc_7_to_32_max");
var v32max = dhvani_miditx_cc_7_to_32(127);
assert_eq(v32max > 4000000000, 1, "max CC near u32::MAX");

# ---- pitch_bend_center_constant ----
test_group("pitch_bend_center_constant");
assert_eq(DH_MIDITX_PITCH_BEND_CENTER, 0x80000000, "PITCH_BEND_CENTER = 0x80000000");

# ---- scalers_full_7_and_14_bit_parity ----
# Every 7-bit / 14-bit value round-trips (the oracle tests only 4 bend values).
test_group("scalers_full_7_and_14_bit_parity");
var pb_bad = 0;
var pbx = 0;
while (pbx < 16384) {
    if (dhvani_miditx_pitch_bend_32_to_14(dhvani_miditx_pitch_bend_14_to_32(pbx)) != pbx) { pb_bad = pb_bad + 1; }
    pbx = pbx + 1;
}
assert_eq(pb_bad, 0, "all 16384 bend values round-trip");

# ---- scalers_mask_to_rust_type_width ----
# Inputs are masked at entry like the Rust argument type (u8 / u16 / u32). An
# up-scaler input past the 7/14-bit MIDI 1.0 range saturates to full scale (the
# oracle let it wrap in u16/u32); down-scaler outputs stay in 7/14 bits.
test_group("scalers_mask_to_rust_type_width");
assert_eq(dhvani_miditx_velocity_7_to_16(200), 0xFFFF, "u8 200 saturates to 127 -> 0xFFFF");
assert_eq(dhvani_miditx_velocity_7_to_16(128), 0xFFFF, "u8 128 saturates to 127 -> 0xFFFF");
assert_eq(dhvani_miditx_cc_7_to_32(200), 0xFFFFFFFF, "u8 200 saturates to 127 -> u32 max");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(0xFFFF), 0xFFFFFFFF, "u16 0xFFFF -> u32 max");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(16384), 0xFFFFFFFF, "u16 16384 saturates to 16383");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(0x10000), 0, "0x10000 masks to u16 0 -> 0");
assert_eq(dhvani_miditx_velocity_7_to_16(256), 0, "256 masks to u8 0 -> 0");
assert_eq(dhvani_miditx_velocity_7_to_16(0 - 1), 0xFFFF, "-1 masks to u8 255 -> 0xFFFF");
assert_eq(dhvani_miditx_velocity_16_to_7(0x1FFFF), 127, "16->7 out-of-type input stays 7-bit");
assert_eq(dhvani_miditx_cc_32_to_7(0 - 1), 127, "32->7 sign-extended -1 -> 127");
assert_eq(dhvani_miditx_pitch_bend_32_to_14(0 - 1), 16383, "32->14 sign-extended -1 -> 16383");
assert_eq(dhvani_miditx_cc_32_to_7(0x1FFFFFFFF), 127, "32->7 >32-bit input stays 7-bit");
assert_eq(dhvani_miditx_pitch_bend_32_to_14(0x1FFFFFFFF), 16383, "32->14 >32-bit input stays 14-bit");

# ---- note_on_v2_velocity_floor (oracle-divergent) ----
# MIDI 2.0 -> 1.0: a note-on whose velocity down-scales to 0 becomes 1.
test_group("note_on_v2_velocity_floor");
var nv0 = dhvani_midi2_note_on_new(0, 60, 0, 0, 0, 0);
var nv300 = dhvani_midi2_note_on_new(0, 60, 300, 0, 0, 0);
var nv511 = dhvani_midi2_note_on_new(0, 60, 511, 0, 0, 0);
var nv512 = dhvani_midi2_note_on_new(0, 60, 512, 0, 0, 0);
var nvmax = dhvani_midi2_note_on_new(0, 60, 65535, 0, 0, 0);
assert_eq(dhvani_note_event_velocity(dhvani_miditx_note_on_v2_to_event(nv0, 1)), 1, "v2 vel 0 -> 1");
assert_eq(dhvani_note_event_velocity(dhvani_miditx_note_on_v2_to_event(nv300, 1)), 1, "v2 vel 300 -> 1");
assert_eq(dhvani_note_event_velocity(dhvani_miditx_note_on_v2_to_event(nv511, 1)), 1, "v2 vel 511 -> 1");
assert_eq(dhvani_note_event_velocity(dhvani_miditx_note_on_v2_to_event(nv512, 1)), 1, "v2 vel 512 -> 1");
assert_eq(dhvani_note_event_velocity(dhvani_miditx_note_on_v2_to_event(nvmax, 1)), 127, "v2 vel max -> 127");
assert_eq(dhvani_miditx_velocity_16_to_7(511), 0, "scalar 16->7 unchanged (511 -> 0)");

# ---- translate_into_zero_alloc ----
test_group("translate_into_zero_alloc");
var tev = dhvani_note_event_new(1000, 500, 60, 100, 3);
var tv2 = dhvani_midi2_note_on_new(0, 0, 0, 0, 9, 9);
var tback = dhvani_note_event_new(0, 0, 0, 0, 0);
var tcc = dhvani_cc_new(40, 7, 100, 2);
var tcc2 = dhvani_midi2_cc_new(0, 0, 0, 0);
var tccb = dhvani_cc_new(0, 0, 0, 0);
var ta0 = alloc_used();
assert_eq(dhvani_miditx_note_event_to_v2_into(tev, tv2), tv2, "note_event_to_v2_into returns out");
dhvani_miditx_note_on_v2_to_event_into(tv2, 250, tback);
dhvani_miditx_cc_to_v2_into(tcc, tcc2);
dhvani_miditx_cc_v2_to_cc_into(tcc2, tccb);
assert_eq(alloc_used() - ta0, 0, "translate _into: 0 B");
assert_eq(dhvani_midi2_note_on_position(tv2), 1000, "v2 pos");
assert_eq(dhvani_midi2_note_on_velocity(tv2), dhvani_miditx_velocity_7_to_16(100), "v2 velocity up-scaled");
assert_eq(dhvani_midi2_note_on_channel(tv2), 3, "v2 channel");
assert_eq(dhvani_midi2_note_on_attribute_type(tv2), 0, "v2 attribute_type reset");
assert_eq(dhvani_midi2_note_on_attribute_data(tv2), 0, "v2 attribute_data reset");
assert_eq(dhvani_note_event_duration(tback), 250, "back duration");
assert_eq(dhvani_note_event_velocity(tback), 100, "back velocity");
assert_eq(dhvani_note_event_channel(tback), 3, "back channel");
assert_eq(dhvani_midi2_cc_value(tcc2), dhvani_miditx_cc_7_to_32(100), "cc2 value up-scaled");
assert_eq(dhvani_cc_position(tccb), 40, "ccb position");
assert_eq(dhvani_cc_controller(tccb), 7, "ccb controller");
assert_eq(dhvani_cc_value(tccb), 100, "ccb value");
assert_eq(dhvani_cc_channel(tccb), 2, "ccb channel");

# ---- upscale_is_min_center_max (oracle-divergent, ADR 005) ----
# The MIDI 2.0 spec's min-center-max rule: min, centre and max land exactly on the
# 2.0 min, centre and max. The oracle's bit replication gave 0x8102, 0x81020408 and
# 0x80020008 for the three centres. Values computed by hand from the spec's
# reference algorithm, and checked against a separate implementation of it.
test_group("upscale_is_min_center_max");
var pb_center = dhvani_miditx_pitch_bend_14_to_32(8192);
assert_eq(pb_center, DH_MIDITX_PITCH_BEND_CENTER, "bend 8192 -> PITCH_BEND_CENTER");
assert_eq(dhvani_miditx_cc_7_to_32(64), 0x80000000, "cc 64 -> 0x80000000");
assert_eq(dhvani_miditx_velocity_7_to_16(64), 0x8000, "velocity 64 -> 0x8000");
assert_eq(dhvani_miditx_velocity_7_to_16(127), 0xFFFF, "velocity 127 -> 0xFFFF");
assert_eq(dhvani_miditx_cc_7_to_32(127), 0xFFFFFFFF, "cc 127 -> 0xFFFFFFFF");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(16383), 0xFFFFFFFF, "bend 16383 -> 0xFFFFFFFF");
assert_eq(dhvani_miditx_cc_7_to_32(0), 0, "cc 0 -> 0");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(0), 0, "bend 0 -> 0");
# at or below the centre: a plain shift
assert_eq(dhvani_miditx_velocity_7_to_16(1), 0x0200, "velocity 1 -> 0x0200");
assert_eq(dhvani_miditx_velocity_7_to_16(63), 0x7E00, "velocity 63 -> 0x7E00");
assert_eq(dhvani_miditx_cc_7_to_32(1), 0x02000000, "cc 1 -> 0x02000000");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(1), 0x40000, "bend 1 -> 0x40000");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(8191), 0x7FFC0000, "bend 8191 -> 0x7FFC0000");
# above the centre: the low source bits repeated downward
assert_eq(dhvani_miditx_velocity_7_to_16(65), 0x8208, "velocity 65 -> 0x8208");
assert_eq(dhvani_miditx_velocity_7_to_16(100), 0xC924, "velocity 100 -> 0xC924");
assert_eq(dhvani_miditx_velocity_7_to_16(126), 0xFDF7, "velocity 126 -> 0xFDF7");
assert_eq(dhvani_miditx_cc_7_to_32(65), 0x82082082, "cc 65 -> 0x82082082");
assert_eq(dhvani_miditx_cc_7_to_32(100), 0xC9249249, "cc 100 -> 0xC9249249");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(8193), 0x80040020, "bend 8193 -> 0x80040020");
assert_eq(dhvani_miditx_pitch_bend_14_to_32(12288), 0xC0020010, "bend 12288 -> 0xC0020010");
# the note-on struct path carries the centre too
var cev = dhvani_note_event_new(0, 10, 60, 64, 0);
assert_eq(dhvani_midi2_note_on_velocity(dhvani_miditx_note_event_to_v2(cev)), 0x8000, "note velocity 64 -> 0x8000");
var ccc = dhvani_cc_new(0, 10, 64, 0);
assert_eq(dhvani_midi2_cc_value(dhvani_miditx_cc_to_v2(ccc)), 0x80000000, "cc struct 64 -> 0x80000000");

# ---- upscale_monotone_over_the_whole_domain ----
# Every up-scaler is strictly increasing over its whole 7- or 14-bit domain, stays
# inside its 16- or 32-bit result, and every value round-trips through the
# down-scaler.
test_group("upscale_monotone_over_the_whole_domain");

# count of domain values (0 .. 2^bits - 1) where up(x) <= up(x-1), up(x) leaves
# [0, out_max], or down(up(x)) != x. fp_up / fp_down are the scaler pair.
fn upscale_faults(fp_up, fp_down, bits, out_max) {
    var bad = 0;
    var prev = 0 - 1;
    var x = 0;
    while (x < (1 << bits)) {
        var u = fncall1(fp_up, x);
        if (u <= prev) { bad = bad + 1; }
        if (u < 0 || u > out_max) { bad = bad + 1; }
        if (fncall1(fp_down, u) != x) { bad = bad + 1; }
        prev = u;
        x = x + 1;
    }
    return bad;
}
var vel_up = &dhvani_miditx_velocity_7_to_16;
var vel_dn = &dhvani_miditx_velocity_16_to_7;
var cc_up = &dhvani_miditx_cc_7_to_32;
var cc_dn = &dhvani_miditx_cc_32_to_7;
var pb_up = &dhvani_miditx_pitch_bend_14_to_32;
var pb_dn = &dhvani_miditx_pitch_bend_32_to_14;
assert_eq(upscale_faults(vel_up, vel_dn, 7, 0xFFFF), 0, "velocity 7->16");
assert_eq(upscale_faults(cc_up, cc_dn, 7, 0xFFFFFFFF), 0, "cc 7->32");
assert_eq(upscale_faults(pb_up, pb_dn, 14, 0xFFFFFFFF), 0, "bend 14->32");

var rc = assert_summary();
syscall(60, rc);
