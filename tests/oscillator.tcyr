# oscillator.tcyr -- parity tests for src/oscillator.cyr
# Ported one-for-one from the 8 #[test] blocks in rust-old/src/dsp/oscillator.rs.
# Uses abaco::poly_blep (include lib/abaco.cyr).

include "src/error.cyr"
include "lib/abaco.cyr"
include "src/oscillator.cyr"

alloc_init();

# ---- sine_oscillates ----
test_group("sine_oscillates");
var so = dhvani_osc_new(DH_WAVE_SINE, 44100);
var has_pos = 0;
var has_neg = 0;
var i = 0;
while (i < 44100) {
    var s0 = dhvani_osc_sample(so, 440.0);
    if (f64_gt(s0, 0.1) == 1) { has_pos = 1; }
    if (f64_lt(s0, f64_neg(0.1)) == 1) { has_neg = 1; }
    i = i + 1;
}
assert_eq(has_pos, 1, "sine has positive");
assert_eq(has_neg, 1, "sine has negative");

# ---- saw_range ----
test_group("saw_range");
var sw = dhvani_osc_new(DH_WAVE_SAW, 44100);
var smin = 1.0;
var smax = f64_neg(1.0);
i = 0;
while (i < 44100) {
    var s1 = dhvani_osc_sample(sw, 440.0);
    if (f64_lt(s1, smin) == 1) { smin = s1; }
    if (f64_gt(s1, smax) == 1) { smax = s1; }
    i = i + 1;
}
assert(f64_lt(smin, f64_neg(0.9)), "saw min < -0.9");
assert(f64_gt(smax, 0.9), "saw max > 0.9");

# ---- square_bipolar ----
test_group("square_bipolar");
var sq = dhvani_osc_new(DH_WAVE_SQUARE, 44100);
var hi = 0;
var lo = 0;
i = 0;
while (i < 44100) {
    var s2 = dhvani_osc_sample(sq, 440.0);
    if (f64_gt(s2, 0.5) == 1) { hi = 1; }
    if (f64_lt(s2, f64_neg(0.5)) == 1) { lo = 1; }
    i = i + 1;
}
assert_eq(hi, 1, "square has high");
assert_eq(lo, 1, "square has low");

# ---- triangle_range ----
test_group("triangle_range");
var tr = dhvani_osc_new(DH_WAVE_TRIANGLE, 44100);
var tmin = 1.0;
var tmax = f64_neg(1.0);
i = 0;
while (i < 44100) {
    var s3 = dhvani_osc_sample(tr, 440.0);
    if (f64_lt(s3, tmin) == 1) { tmin = s3; }
    if (f64_gt(s3, tmax) == 1) { tmax = s3; }
    i = i + 1;
}
assert(f64_lt(tmin, f64_neg(0.9)), "triangle min < -0.9");
assert(f64_gt(tmax, 0.9), "triangle max > 0.9");

# ---- noise_nonzero ----
test_group("noise_nonzero");
var no = dhvani_osc_new(DH_WAVE_NOISE, 44100);
var sum = 0;
i = 0;
while (i < 1000) {
    sum = f64_add(sum, f64_abs(dhvani_osc_sample(no, 440.0)));
    i = i + 1;
}
assert(f64_gt(sum, 0), "noise produces non-zero output");

# ---- reset_clears_phase ----
test_group("reset_clears_phase");
var ro = dhvani_osc_new(DH_WAVE_SINE, 44100);
i = 0;
while (i < 100) { dhvani_osc_sample(ro, 440.0); i = i + 1; }
assert(f64_gt(dhvani_osc_phase(ro), 0), "phase advanced");
dhvani_osc_reset(ro);
assert(f64_lt(f64_abs(dhvani_osc_phase(ro)), 0.0000001), "phase cleared");

# ---- all_waveforms_finite ----
test_group("all_waveforms_finite");
var wfs = vec_new();
vec_push(wfs, DH_WAVE_SINE); vec_push(wfs, DH_WAVE_SAW); vec_push(wfs, DH_WAVE_SQUARE);
vec_push(wfs, DH_WAVE_TRIANGLE); vec_push(wfs, DH_WAVE_NOISE);
var wi = 0;
var allfin = 1;
while (wi < 5) {
    var osc = dhvani_osc_new(vec_get(wfs, wi), 44100);
    var k = 0;
    while (k < 4096) {
        if (dhvani_is_finite(dhvani_osc_sample(osc, 440.0)) == 0) { allfin = 0; }
        k = k + 1;
    }
    wi = wi + 1;
}
assert_eq(allfin, 1, "all waveforms produce finite samples");

# ---- set_waveform ----
test_group("set_waveform");
var xo = dhvani_osc_new(DH_WAVE_SINE, 44100);
assert_eq(dhvani_osc_waveform(xo), DH_WAVE_SINE, "starts sine");
dhvani_osc_set_waveform(xo, DH_WAVE_SAW);
assert_eq(dhvani_osc_waveform(xo), DH_WAVE_SAW, "switched to saw");

# ================================================================
# 2.3.2 parity + hardening regressions (each fails on the 2.3.2 code)
# ================================================================

# ---- square_phase_wrap_is_fmod ----
# Rust: poly_blep((phase + 0.5) % 1.0, dt). At a frequency above the sample rate
# (dt = 1.7) the phase passes 1.5 and the single conditional subtract kept 1.6 where
# fmod gives 0.6. Expected: rust-old's Oscillator on its pinned toolchain (f32 out).
test_group("square_phase_wrap_is_fmod");
var ofq = vec_new();
vec_push(ofq, 0.4982699); vec_push(ofq, f64_neg(0.56747407)); vec_push(ofq, f64_neg(0.80968857));
vec_push(ofq, 2.1314878); vec_push(ofq, 3.916955); vec_push(ofq, 6.103806);
vec_push(ofq, 7.6539793); vec_push(ofq, 10.4359865);
var ofo = dhvani_osc_new(DH_WAVE_SQUARE, 44100);
var ofok = 1;
var ofi = 0;
while (ofi < 8) {
    var ofw = vec_get(ofq, ofi);
    var oftol = f64_mul(0.00001, f64_max(1.0, f64_abs(ofw)));
    if (f64_lt(f64_abs(f64_sub(dhvani_osc_sample(ofo, 74970.0), ofw)), oftol) == 0) { ofok = 0; }
    ofi = ofi + 1;
}
assert_eq(ofok, 1, "square at 1.7x the sample rate = rust-old, 8 samples");
# x % 1.0 on the pinned Rust toolchain: { x bits, (x % 1.0) bits }
var ofm = vec_new();
fn of2(v, x, r) { vec_push(v, x); vec_push(v, r); return 0; }
of2(ofm, 0x0000000000000000, 0x0000000000000000);
of2(ofm, 0x8000000000000000, 0x8000000000000000);
of2(ofm, 0x3FD0000000000000, 0x3FD0000000000000);
of2(ofm, 0xBFD0000000000000, 0xBFD0000000000000);
of2(ofm, 0x3FF0000000000000, 0x0000000000000000);
of2(ofm, 0xBFF0000000000000, 0x8000000000000000);
of2(ofm, 0x3FF8000000000000, 0x3FE0000000000000);
of2(ofm, 0x4004CCCCCCCCCCCD, 0x3FE3333333333334);
of2(ofm, 0xC004CCCCCCCCCCCD, 0xBFE3333333333334);
of2(ofm, 0x4008CCCCCCCCCCCD, 0x3FB99999999999A0);
of2(ofm, 0x3FEFFFFFFFFFFFFF, 0x3FEFFFFFFFFFFFFF);
of2(ofm, 0x3FF0000000000001, 0x3CB0000000000000);
of2(ofm, 0x432FFFFFFFFFFFFF, 0x3FE0000000000000);
of2(ofm, 0x4330000000000000, 0x0000000000000000);
of2(ofm, 0xC330000000000001, 0x8000000000000000);
of2(ofm, 0x7E37E43C8800759C, 0x0000000000000000);
of2(ofm, 0x0000000000000001, 0x0000000000000001);
of2(ofm, 0x8000000000000001, 0x8000000000000001);
var ofmok = 1;
var ofmi = 0;
while (ofmi < vec_len(ofm)) {
    if (dh_fmod1(vec_get(ofm, ofmi)) != vec_get(ofm, ofmi + 1)) { ofmok = 0; }
    ofmi = ofmi + 2;
}
assert_eq(ofmok, 1, "dh_fmod1 = Rust x % 1.0, bit for bit (18 values)");
var ofinf = dh_fmod1(DH_POS_INF);
assert_eq(f64_eq(ofinf, ofinf), 0, "+Inf % 1.0 is NaN");
# below the sample rate the wrap is the old subtract, bit for bit
var ofa = dhvani_osc_new(DH_WAVE_SQUARE, 44100);
var ofb = dhvani_osc_new(DH_WAVE_TRIANGLE, 44100);
var ofsame = 1;
var ofk = 0;
while (ofk < 2000) {
    var ofph = dhvani_osc_phase(ofa);
    var ofp2 = f64_add(ofph, 0.5);
    if (f64_ge(ofp2, 1.0) == 1) { ofp2 = f64_sub(ofp2, 1.0); }
    if (dh_fmod1(f64_add(ofph, 0.5)) != ofp2) { ofsame = 0; }
    var ofs1 = dhvani_osc_sample(ofa, 3001.0);
    var ofs2 = dhvani_osc_sample(ofb, 3001.0);
    ofk = ofk + 1;
}
assert_eq(ofsame, 1, "phase in [0,1): fmod = the 2.3.2 conditional subtract, bit for bit");

# ---- validate_rejects_nan_rate ----
test_group("validate_rejects_nan_rate");
var ofv = dhvani_osc_new(DH_WAVE_SINE, 44100);
DhOscillator_set_sample_rate(ofv, 0x7FF8000000000000);
assert_eq(dhvani_osc_validate(ofv), DHVANI_ERR_INVALID_SAMPLE_RATE, "NaN sample rate rejected");
assert_eq(dhvani_osc_validate(dhvani_osc_new(DH_WAVE_SINE, 0)), DHVANI_ERR_INVALID_SAMPLE_RATE, "0 Hz rejected");
assert_eq(dhvani_osc_validate(dhvani_osc_new(DH_WAVE_SINE, 48000)), DHVANI_ERR_NONE, "48 kHz valid");

var rc = assert_summary();
syscall(60, rc);
