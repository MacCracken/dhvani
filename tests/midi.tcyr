# midi.tcyr -- parity tests for src/midi.cyr
# Ported one-for-one from the 16 #[test] blocks in rust-old/src/midi/mod.rs
# (`events_in_range_binary_search` runs here as `events_in_range_uniform`: the
# port's range query is not the oracle's binary search). The groups after
# `midi_event_all_variants_position_channel` are port regressions: zero-alloc
# `_into`/`_init` forms, query pruning vs brute force, and the merge fixes.

include "src/error.cyr"
include "src/midi.cyr"

alloc_init();

# ---- clip_creation ----
test_group("clip_creation");
var c1 = dhvani_midi_clip_new("test", 0, 44100);
assert_eq(streq(dhvani_midi_clip_name(c1), "test"), 1, "name = test");
assert_eq(dhvani_midi_clip_timeline_pos(c1), 0, "timeline 0");
assert_eq(dhvani_midi_clip_duration(c1), 44100, "duration 44100");
assert_eq(vec_len(dhvani_midi_clip_notes(c1)), 0, "no notes");

# ---- add_note_sorted ----
test_group("add_note_sorted");
var c2 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_note(c2, 1000, 500, 60, 100, 0);
dhvani_midi_clip_add_note(c2, 500, 500, 62, 90, 0);
dhvani_midi_clip_add_note(c2, 2000, 500, 64, 80, 0);
var n2 = dhvani_midi_clip_notes(c2);
assert_eq(dhvani_note_event_position(vec_get(n2, 0)), 500, "sorted[0]=500");
assert_eq(dhvani_note_event_position(vec_get(n2, 1)), 1000, "sorted[1]=1000");
assert_eq(dhvani_note_event_position(vec_get(n2, 2)), 2000, "sorted[2]=2000");

# ---- notes_at_frame ----
test_group("notes_at_frame");
var c3 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_note(c3, 100, 200, 60, 100, 0);
dhvani_midi_clip_add_note(c3, 250, 100, 62, 90, 0);
var at150 = dhvani_midi_clip_notes_at(c3, 150);
assert_eq(vec_len(at150), 1, "1 note at 150");
assert_eq(dhvani_note_event_note(vec_get(at150, 0)), 60, "note 60 at 150");
assert_eq(vec_len(dhvani_midi_clip_notes_at(c3, 275)), 2, "2 notes at 275");
assert_eq(vec_len(dhvani_midi_clip_notes_at(c3, 400)), 0, "0 notes at 400");

# ---- note_ons_and_offs ----
test_group("note_ons_and_offs");
var c4 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_note(c4, 100, 200, 60, 100, 0);
dhvani_midi_clip_add_note(c4, 100, 300, 62, 90, 0);
assert_eq(vec_len(dhvani_midi_clip_note_ons_at(c4, 100)), 2, "2 note-ons @100");
assert_eq(vec_len(dhvani_midi_clip_note_ons_at(c4, 101)), 0, "0 note-ons @101");
assert_eq(vec_len(dhvani_midi_clip_note_offs_at(c4, 300)), 1, "1 note-off @300");
assert_eq(vec_len(dhvani_midi_clip_note_offs_at(c4, 400)), 1, "1 note-off @400");

# ---- events_in_range_uniform (oracle: events_in_range_binary_search) ----
test_group("events_in_range_uniform");
var c5 = dhvani_midi_clip_new("test", 0, 100000);
var i5 = 0;
while (i5 < 100) { dhvani_midi_clip_add_note(c5, i5 * 1000, 500, 60, 100, 0); i5 = i5 + 1; }
var r5 = dhvani_midi_clip_events_in_range(c5, 10000, 15000);
assert_eq(vec_len(r5), 5, "5 notes in [10000,15000)");
assert_eq(dhvani_note_event_position(vec_get(r5, 0)), 10000, "first @10000");

# ---- merge_clips ----
test_group("merge_clips");
var ca = dhvani_midi_clip_new("a", 0, 2000);
dhvani_midi_clip_add_note(ca, 0, 100, 60, 100, 0);
dhvani_midi_clip_add_note(ca, 500, 100, 62, 90, 0);
var cb = dhvani_midi_clip_new("b", 0, 2000);
dhvani_midi_clip_add_note(cb, 250, 100, 64, 80, 0);
dhvani_midi_clip_merge(ca, cb);
var na = dhvani_midi_clip_notes(ca);
assert_eq(vec_len(na), 3, "3 notes after merge");
assert_eq(dhvani_note_event_position(vec_get(na, 0)), 0, "merged[0]=0");
assert_eq(dhvani_note_event_position(vec_get(na, 1)), 250, "merged[1]=250");
assert_eq(dhvani_note_event_position(vec_get(na, 2)), 500, "merged[2]=500");

# ---- transpose ----
test_group("transpose");
var c7 = dhvani_midi_clip_new("test", 0, 1000);
dhvani_midi_clip_add_note(c7, 0, 100, 60, 100, 0);
dhvani_midi_clip_add_note(c7, 100, 100, 3, 100, 0);
dhvani_midi_clip_add_note(c7, 200, 100, 125, 100, 0);
dhvani_midi_clip_transpose(c7, 5);
var n7 = dhvani_midi_clip_notes(c7);
assert_eq(dhvani_note_event_note(vec_get(n7, 0)), 65, "60+5");
assert_eq(dhvani_note_event_note(vec_get(n7, 1)), 8, "3+5");
assert_eq(dhvani_note_event_note(vec_get(n7, 2)), 127, "125+5 clamped");
dhvani_midi_clip_transpose(c7, -20);
assert_eq(dhvani_note_event_note(vec_get(n7, 0)), 45, "65-20");
assert_eq(dhvani_note_event_note(vec_get(n7, 1)), 0, "8-20 clamped");
assert_eq(dhvani_note_event_note(vec_get(n7, 2)), 107, "127-20");

# ---- quantize_basic ----
test_group("quantize_basic");
var c8 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_note(c8, 90, 100, 60, 100, 0);
dhvani_midi_clip_add_note(c8, 110, 100, 62, 90, 0);
dhvani_midi_clip_add_note(c8, 400, 100, 64, 80, 0);
dhvani_midi_clip_quantize(c8, 200);
var n8 = dhvani_midi_clip_notes(c8);
assert_eq(dhvani_note_event_position(vec_get(n8, 0)), 0, "90 -> 0");
assert_eq(dhvani_note_event_position(vec_get(n8, 1)), 200, "110 -> 200");
assert_eq(dhvani_note_event_position(vec_get(n8, 2)), 400, "400 -> 400");

# ---- quantize_zero_grid_noop ----
test_group("quantize_zero_grid_noop");
var c9 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_note(c9, 105, 100, 60, 100, 0);
dhvani_midi_clip_quantize(c9, 0);
assert_eq(dhvani_note_event_position(vec_get(dhvani_midi_clip_notes(c9), 0)), 105, "grid 0 no-op");

# ---- add_cc_sorted ----
test_group("add_cc_sorted");
var c10 = dhvani_midi_clip_new("test", 0, 44100);
dhvani_midi_clip_add_cc(c10, 1000, 1, 64, 0);
dhvani_midi_clip_add_cc(c10, 500, 7, 100, 0);
var cc10 = dhvani_midi_clip_control_changes(c10);
assert_eq(dhvani_cc_position(vec_get(cc10, 0)), 500, "cc sorted[0]=500");
assert_eq(dhvani_cc_position(vec_get(cc10, 1)), 1000, "cc sorted[1]=1000");

# ---- midi_event_position_and_channel ----
test_group("midi_event_position_and_channel");
var ev = dhvani_midi_note_on(1000, 60, 100, 5);
assert_eq(dhvani_midi_event_position(ev), 1000, "position 1000");
assert_eq(dhvani_midi_event_channel(ev), 5, "channel 5");

# ---- end_pos ----
test_group("end_pos");
assert_eq(dhvani_midi_clip_end_pos(dhvani_midi_clip_new("test", 1000, 5000)), 6000, "end 6000");

# ---- note_event_accessors ----
test_group("note_event_accessors");
var ne = dhvani_note_event_new(100, 200, 60, 127, 3);
assert_eq(dhvani_note_event_position(ne), 100, "pos 100");
assert_eq(dhvani_note_event_duration(ne), 200, "dur 200");
assert_eq(dhvani_note_event_note(ne), 60, "note 60");
assert_eq(dhvani_note_event_velocity(ne), 127, "vel 127");
assert_eq(dhvani_note_event_channel(ne), 3, "ch 3");

# ---- control_change_accessors ----
test_group("control_change_accessors");
var cce = dhvani_cc_new(500, 7, 100, 0);
assert_eq(dhvani_cc_position(cce), 500, "pos 500");
assert_eq(dhvani_cc_controller(cce), 7, "ctrl 7");
assert_eq(dhvani_cc_value(cce), 100, "val 100");
assert_eq(dhvani_cc_channel(cce), 0, "ch 0");

# ---- midi_clip_accessors ----
test_group("midi_clip_accessors");
var c15 = dhvani_midi_clip_new("lead", 1000, 5000);
dhvani_midi_clip_add_note(c15, 1000, 500, 60, 100, 0);
dhvani_midi_clip_add_cc(c15, 2000, 1, 64, 0);
assert_eq(streq(dhvani_midi_clip_name(c15), "lead"), 1, "name lead");
assert_eq(vec_len(dhvani_midi_clip_notes(c15)), 1, "1 note");
assert_eq(vec_len(dhvani_midi_clip_control_changes(c15)), 1, "1 cc");
assert_eq(dhvani_midi_clip_timeline_pos(c15), 1000, "timeline 1000");
assert_eq(dhvani_midi_clip_duration(c15), 5000, "duration 5000");

# ---- midi_event_all_variants_position_channel ----
test_group("midi_event_all_variants_position_channel");
var evs = vec_new();
vec_push(evs, dhvani_midi_note_on(1, 60, 100, 0));
vec_push(evs, dhvani_midi_note_off(2, 60, 0, 1));
vec_push(evs, dhvani_midi_control_change(3, 7, 64, 2));
vec_push(evs, dhvani_midi_pitch_bend(4, 8192, 3));
vec_push(evs, dhvani_midi_aftertouch(5, 64, 4));
vec_push(evs, dhvani_midi_poly_aftertouch(6, 60, 32, 5));
vec_push(evs, dhvani_midi_program_change(7, 0, 6));
var vi = 0;
var vok = 1;
while (vi < 7) {
    var e = vec_get(evs, vi);
    if (dhvani_midi_event_position(e) != vi + 1) { vok = 0; }
    if (dhvani_midi_event_channel(e) != vi) { vok = 0; }
    vi = vi + 1;
}
assert_eq(vok, 1, "all variants position=i+1, channel=i");

# ---- events_in_range_overlapping_long_note (oracle-divergent) ----
# rust-old's partition_point over end times (non-monotone in position order)
# lands past the long note and returns []; the note at 0 is active in [500,600).
test_group("events_in_range_overlapping_long_note");
var cl = dhvani_midi_clip_new("long", 0, 10000);
dhvani_midi_clip_add_note(cl, 0, 1000, 60, 100, 0);
dhvani_midi_clip_add_note(cl, 100, 10, 62, 100, 0);
dhvani_midi_clip_add_note(cl, 200, 10, 64, 100, 0);
var rl = dhvani_midi_clip_events_in_range(cl, 500, 600);
assert_eq(vec_len(rl), 1, "long note overlaps [500,600)");
assert_eq(dhvani_note_event_note(vec_get(rl, 0)), 60, "it is note 60");
assert_eq(vec_len(dhvani_midi_clip_notes_at(cl, 550)), 1, "long note active at 550");

# ---- clip_queries_into_zero_alloc ----
test_group("clip_queries_into_zero_alloc");
var cz = dhvani_midi_clip_new("z", 0, 100000);
var iz = 0;
while (iz < 100) { dhvani_midi_clip_add_note(cz, iz * 1000, 500, 60, 100, 0); iz = iz + 1; }
var qout = vec_new();
assert_eq(dhvani_midi_clip_events_in_range_into(cz, 10000, 15000, qout), 5, "into: 5 in range");
assert_eq(dhvani_note_event_position(vec_get(qout, 0)), 10000, "into: first @10000");
var a0 = alloc_used();
dhvani_midi_clip_events_in_range_into(cz, 10000, 15000, qout);
assert_eq(alloc_used() - a0, 0, "events_in_range_into 0 B/call");
a0 = alloc_used();
assert_eq(dhvani_midi_clip_notes_at_into(cz, 12250, qout), 1, "into: 1 active @12250");
assert_eq(alloc_used() - a0, 0, "notes_at_into 0 B/call");
a0 = alloc_used();
assert_eq(dhvani_midi_clip_note_ons_at_into(cz, 13000, qout), 1, "into: 1 on @13000");
assert_eq(alloc_used() - a0, 0, "note_ons_at_into 0 B/call");
a0 = alloc_used();
assert_eq(dhvani_midi_clip_note_offs_at_into(cz, 13500, qout), 1, "into: 1 off @13500");
assert_eq(alloc_used() - a0, 0, "note_offs_at_into 0 B/call");
assert_eq(dhvani_midi_clip_note_ons_at_into(cz, 13001, qout), 0, "into: truncates to 0");
assert_eq(vec_len(qout), 0, "out emptied on no match");

# ---- clip_queries_match_bruteforce ----
# Mixed short/long/zero durations (added in random order, some via merge), then
# a quantize: every pruned query must equal a full linear filter.
test_group("clip_queries_match_bruteforce");
var cq = dhvani_midi_clip_new("q", 0, 8000);
var cm = dhvani_midi_clip_new("m", 0, 8000);
var seed = 12345;
var bi = 0;
while (bi < 240) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var bp = seed % 6000;
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var bd = 1 + seed % 40;
    if (bi % 17 == 0) { bd = 1500 + seed % 900; }
    if (bi % 23 == 0) { bd = 0; }
    if (bi % 2 == 0) { dhvani_midi_clip_add_note(cq, bp, bd, 60, 100, 0); }
    else { dhvani_midi_clip_add_note(cm, bp, bd, 62, 100, 1); }
    bi = bi + 1;
}
dhvani_midi_clip_merge(cq, cm);
var bad = 0;
var tot = 0;
var pass = 0;
while (pass < 2) {
    var notes_q = dhvani_midi_clip_notes(cq);
    var nq = vec_len(notes_q);
    var f = 0;
    while (f < 8200) {
        var e_at = 0;
        var e_on = 0;
        var e_off = 0;
        var e_rg = 0;
        var k = 0;
        while (k < nq) {
            var nk = vec_get(notes_q, k);
            var pk = DhNoteEvent_position(nk);
            var ek = pk + DhNoteEvent_duration(nk);
            if (pk <= f) { if (f < ek) { e_at = e_at + 1; } }
            if (pk == f) { e_on = e_on + 1; }
            if (ek == f) { e_off = e_off + 1; }
            if (pk < f + 64) { if (ek > f) { e_rg = e_rg + 1; } }
            k = k + 1;
        }
        tot = tot + e_at + e_on + e_off + e_rg;
        if (dhvani_midi_clip_notes_at_into(cq, f, qout) != e_at) { bad = bad + 1; }
        if (dhvani_midi_clip_note_ons_at_into(cq, f, qout) != e_on) { bad = bad + 1; }
        if (dhvani_midi_clip_note_offs_at_into(cq, f, qout) != e_off) { bad = bad + 1; }
        if (dhvani_midi_clip_events_in_range_into(cq, f, f + 64, qout) != e_rg) { bad = bad + 1; }
        f = f + 3;
    }
    dhvani_midi_clip_quantize(cq, 16);
    pass = pass + 1;
}
assert_eq(vec_len(dhvani_midi_clip_notes(cq)), 240, "240 notes after merge");
assert(tot > 10000, "brute-force expectations are non-trivial");
assert_eq(bad, 0, "pruned queries == brute force (pre/post quantize)");

# ---- merge_self ----
test_group("merge_self");
var cs = dhvani_midi_clip_new("s", 0, 2000);
dhvani_midi_clip_add_note(cs, 0, 100, 60, 100, 0);
dhvani_midi_clip_add_note(cs, 500, 100, 62, 100, 0);
dhvani_midi_clip_add_cc(cs, 10, 1, 64, 0);
dhvani_midi_clip_add_cc(cs, 700, 7, 100, 0);
dhvani_midi_clip_merge(cs, cs);
var ns = dhvani_midi_clip_notes(cs);
var at0 = 0;
var at500 = 0;
var si = 0;
while (si < vec_len(ns)) {
    var ps = DhNoteEvent_position(vec_get(ns, si));
    if (ps == 0) { at0 = at0 + 1; }
    if (ps == 500) { at500 = at500 + 1; }
    si = si + 1;
}
assert_eq(vec_len(ns), 4, "self-merge: 4 notes");
assert_eq(at0, 2, "self-merge: 2 copies of note@0");
assert_eq(at500, 2, "self-merge: 2 copies of note@500");
var css = dhvani_midi_clip_control_changes(cs);
assert_eq(vec_len(css), 4, "self-merge: 4 CCs");
assert_eq(dhvani_cc_position(vec_get(css, 1)), 10, "self-merge: CCs sorted [1]=10");
assert_eq(dhvani_cc_position(vec_get(css, 2)), 700, "self-merge: CCs sorted [2]=700");

# ---- merge_duration_max_end (oracle-divergent) ----
# rust-old extends to the LAST-STARTING note's end (100+10 -> no change).
test_group("merge_duration_max_end");
var md_a = dhvani_midi_clip_new("a", 0, 2000);
var md_b = dhvani_midi_clip_new("b", 0, 2000);
dhvani_midi_clip_add_note(md_b, 0, 5000, 60, 100, 0);
dhvani_midi_clip_add_note(md_b, 100, 10, 62, 100, 0);
dhvani_midi_clip_merge(md_a, md_b);
assert_eq(dhvani_midi_clip_duration(md_a), 5000, "duration -> max note end 5000");
var md_c = dhvani_midi_clip_new("c", 0, 9000);
dhvani_midi_clip_merge(md_c, md_b);
assert_eq(dhvani_midi_clip_duration(md_c), 9000, "never shrinks");

# ---- event_init_reuse ----
test_group("event_init_reuse");
var re = dhvani_midi_control_change(5, 7, 99, 3);
var ne2 = dhvani_note_event_new(1, 2, 3, 4, 5);
var ce2 = dhvani_cc_new(1, 2, 3, 4);
a0 = alloc_used();
assert_eq(dhvani_midi_note_on_init(re, 9, 61, 90, 2), re, "note_on_init returns e");
dhvani_note_event_init(ne2, 100, 200, 60, 127, 3);
dhvani_cc_init(ce2, 500, 7, 100, 0);
assert_eq(alloc_used() - a0, 0, "_init allocates 0 B");
assert_eq(dhvani_midi_event_kind(re), DH_MIDI_NOTE_ON, "re-tagged NOTE_ON");
assert_eq(DhMidiEvent_note(re), 61, "note 61");
assert_eq(DhMidiEvent_velocity(re), 90, "velocity 90");
assert_eq(DhMidiEvent_controller(re), 0, "old controller zeroed");
assert_eq(DhMidiEvent_value(re), 0, "old value zeroed");
assert_eq(dhvani_midi_event_position(re), 9, "position 9");
assert_eq(dhvani_midi_event_channel(re), 2, "channel 2");
dhvani_midi_pitch_bend_init(re, 4, 8192, 1);
assert_eq(dhvani_midi_event_kind(re), DH_MIDI_PITCH_BEND, "re-tagged PITCH_BEND");
assert_eq(DhMidiEvent_value(re), 8192, "bend 8192");
assert_eq(DhMidiEvent_note(re), 0, "note zeroed");
assert_eq(dhvani_note_event_position(ne2), 100, "ne init pos");
assert_eq(dhvani_note_event_duration(ne2), 200, "ne init dur");
assert_eq(dhvani_note_event_velocity(ne2), 127, "ne init vel");
assert_eq(dhvani_cc_controller(ce2), 7, "cc init ctrl");
assert_eq(dhvani_cc_value(ce2), 100, "cc init val");

var rc = assert_summary();
syscall(60, rc);
