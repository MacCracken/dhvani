# zcr.tcyr -- parity tests for src/zcr.cyr
# Ported one-for-one from the 4 #[test] blocks in rust-old/src/analysis/zcr.rs.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/zcr.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }

# ---- silence_zcr ----
test_group("silence_zcr");
var z1 = dhvani_zcr_compute(dhvani_buffer_silence(1, 44100, 44100));
assert_eq(dhvani_zcr_total_crossings(z1), 0, "silence: 0 crossings");
assert_eq(dhvani_zcr_rate_hz(z1), 0, "silence: 0 Hz");

# ---- sine_zcr_matches_frequency ----
test_group("sine_zcr_matches_frequency");
var sv = vec_new();
var i = 0;
while (i < 44100) {
    var ph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), f64_from(i)), f64_from(44100));
    vec_push(sv, f64_sin(ph));
    i = i + 1;
}
var z2 = dhvani_zcr_compute(dhvani_buffer_from_interleaved(sv, 1, 44100));
assert(near(dhvani_zcr_rate_hz(z2), 880.0, 5.0), "440Hz sine ~ 880 Hz ZCR");

# ---- stereo_independent ----
test_group("stereo_independent");
var stv = vec_new();
var j = 0;
while (j < 44100) {
    var t = f64_div(f64_from(j), f64_from(44100));
    vec_push(stv, f64_sin(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), t)));
    vec_push(stv, f64_sin(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 220.0), t)));
    j = j + 1;
}
var z3 = dhvani_zcr_compute(dhvani_buffer_from_interleaved(stv, 2, 44100));
assert(near(dhvani_zcr_per_channel(z3, 0), 880.0, 5.0), "L (440Hz) ~ 880");
assert(near(dhvani_zcr_per_channel(z3, 1), 440.0, 5.0), "R (220Hz) ~ 440");

# ---- too_short_buffer ----
test_group("too_short_buffer");
var tsv = vec_new(); vec_push(tsv, 0.5);
assert_eq(dhvani_zcr_compute(dhvani_buffer_from_interleaved(tsv, 1, 44100)), 0, "< 2 frames -> null");

var rc = assert_summary();
syscall(60, rc);
