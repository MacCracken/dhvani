# playback.tcyr -- tests for src/playback.cyr (the vani device-I/O bridge, 2.1.0).
# Covers the hardware-free format bridge (AudioBuffer f64 <-> S16_LE PCM bytes):
# exact byte packing + round-trip within i16 quantization. The device glue
# (open/write/close/capture over vani) needs /dev/snd and is validated on real
# hardware (see programs / play_tone), not here. Chain: yukti -> sakshi -> vani
# (vani's externalized deps) then dhvani error -> simd -> buffer -> playback.

include "lib/yukti.cyr"
include "lib/sakshi.cyr"
include "lib/vani.cyr"
include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/playback.cyr"

alloc_init();

# ---- to_s16le exact little-endian packing ----
# samples [1.0, -1.0, 0.5, 0.0] -> i16 [32767, -32767, 16383, 0] (trunc * 32767).
test_group("to_s16le_packing");
var v = vec_new();
vec_push(v, 1.0);
vec_push(v, f64_neg(1.0));
vec_push(v, 0.5);
vec_push(v, 0);
var pcm = dhvani_playback_to_s16le(dhvani_buffer_from_interleaved(v, 1, 44100));
assert_eq(load8(pcm + 0), 0xFF, "32767 lo");   # 0x7FFF
assert_eq(load8(pcm + 1), 0x7F, "32767 hi");
assert_eq(load8(pcm + 2), 0x01, "-32767 lo");  # 0x8001
assert_eq(load8(pcm + 3), 0x80, "-32767 hi");
assert_eq(load8(pcm + 4), 0xFF, "16383 lo");   # 0x3FFF
assert_eq(load8(pcm + 5), 0x3F, "16383 hi");
assert_eq(load8(pcm + 6), 0, "0 lo");
assert_eq(load8(pcm + 7), 0, "0 hi");

# ---- round-trip AudioBuffer -> S16_LE -> AudioBuffer (within quantization) ----
test_group("s16le_roundtrip");
var rv = vec_new();
var i = 0;
while (i < 128) {
    var s = f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, f64_from(440)), f64_from(i)), f64_from(44100)));
    vec_push(rv, s);
    vec_push(rv, f64_mul(s, 0.5));
    i = i + 1;
}
var src = dhvani_buffer_from_interleaved(rv, 2, 44100);
var back = dhvani_capture_from_s16le(dhvani_playback_to_s16le(src), 128, 2, 44100);
assert_eq(dhvani_buffer_channels(back), 2, "stereo preserved");
assert_eq(dhvani_buffer_frames(back), 128, "128 frames preserved");
var os = dhvani_buffer_samples(src);
var bs = dhvani_buffer_samples(back);
var ok = 1;
var j = 0;
while (j < 256) {
    if (f64_ge(f64_abs(f64_sub(vec_get(bs, j), vec_get(os, j))), 0.0001) == 1) { ok = 0; }
    j = j + 1;
}
assert_eq(ok, 1, "round-trip within i16 quantization (<1e-4)");

# ---- ring player: alloc-free push enqueues the same S16_LE bytes ----
test_group("player_ring_push");
var pv = vec_new();
vec_push(pv, 1.0);
vec_push(pv, f64_neg(0.5));
vec_push(pv, 0.25);
vec_push(pv, 0);
var pbuf = dhvani_buffer_from_interleaved(pv, 2, 44100);   # 2 frames stereo = 4 samples = 8 bytes
var expect = dhvani_playback_to_s16le(pbuf);
var player = dhvani_player_new(1024, 2, 2);
assert_eq(dhvani_player_push(player, pbuf), 8, "pushed 8 bytes");
var got = alloc(8);
assert_eq(vani_ring_read(dhvani_player_ring(player), got, 8), 8, "read 8 bytes back");
var pok = 1;
var k = 0;
while (k < 8) {
    if (load8(got + k) != load8(expect + k)) { pok = 0; }
    k = k + 1;
}
assert_eq(pok, 1, "ring bytes == one-shot to_s16le bytes");

# ---- multi-format PCM: full-scale packs to the right LE bytes per depth ----
# 1.0 -> i16 0x7FFF, i24 0x7FFFFF, i32 0x7FFFFFFF (little-endian).
test_group("pcm_formats");
var mv = vec_new();
vec_push(mv, 1.0);
var mb = dhvani_buffer_from_interleaved(mv, 1, 44100);
var p16 = dhvani_playback_to_pcm(mb, 16);
assert_eq(load8(p16 + 0), 0xFF, "i16 b0");
assert_eq(load8(p16 + 1), 0x7F, "i16 b1");
var p24 = dhvani_playback_to_pcm(mb, 24);
assert_eq(load8(p24 + 0), 0xFF, "i24 b0");
assert_eq(load8(p24 + 1), 0xFF, "i24 b1");
assert_eq(load8(p24 + 2), 0x7F, "i24 b2");
var p32 = dhvani_playback_to_pcm(mb, 32);
assert_eq(load8(p32 + 0), 0xFF, "i32 b0");
assert_eq(load8(p32 + 3), 0x7F, "i32 b3 (msb)");

# ---- round-trip i16/i24/i32 on a sine within quantization ----
test_group("pcm_roundtrip_depths");
var sv = vec_new();
var si = 0;
while (si < 32) {
    vec_push(sv, f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, f64_from(440)), f64_from(si)), f64_from(44100))));
    si = si + 1;
}
var sbuf = dhvani_buffer_from_interleaved(sv, 1, 44100);
var os2 = dhvani_buffer_samples(sbuf);
var depths = vec_new();
vec_push(depths, 16);
vec_push(depths, 24);
vec_push(depths, 32);
var dok = 1;
var di = 0;
while (di < 3) {
    var depth = vec_get(depths, di);
    var back = dhvani_capture_from_pcm(dhvani_playback_to_pcm(sbuf, depth), 32, 1, 44100, depth);
    var bs2 = dhvani_buffer_samples(back);
    var m = 0;
    while (m < 32) {
        if (f64_ge(f64_abs(f64_sub(vec_get(bs2, m), vec_get(os2, m))), 0.0001) == 1) { dok = 0; }
        m = m + 1;
    }
    di = di + 1;
}
assert_eq(dok, 1, "i16/i24/i32 round-trip within 1e-4");

var rc = assert_summary();
syscall(60, rc);
