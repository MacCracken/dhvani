# playback.tcyr -- tests for src/playback.cyr (the vani device-I/O bridge, 2.1.0).
# Covers the hardware-free format bridge (AudioBuffer f64 <-> S16_LE PCM bytes):
# exact byte packing + round-trip within i16 quantization. The device glue
# (open/write/close/capture over vani) needs /dev/snd and is validated on real
# hardware (see programs / play_tone), not here. Chain: patra -> yukti -> sakshi
# -> vani (vani's externalized deps) then dhvani error -> simd -> buffer -> playback.
# patra leads the chain as of yukti 2.3.8, which routes device discovery through
# patra_result_get_str_len (read_procfs_text) instead of raw sys_open/sys_read.

include "lib/patra.cyr"
include "lib/yukti.cyr"
include "lib/sakshi.cyr"
include "lib/vani.cyr"
include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/playback.cyr"

alloc_init();

# ---- to_s16le exact little-endian packing ----
# samples [1.0, -1.0, 0.5, 0.0] -> i16 [32767, -32767, 16383, 0] (trunc * 32767).
test_group("to_s16le_packing");
var v = vec_new();
vec_push(v, 1.0);
vec_push(v, f64_neg(1.0));
vec_push(v, 0.5);
vec_push(v, 0);
var pcm = dhvani_playback_to_s16le(dhvani_buffer_from_interleaved(v, 1, 44100));
assert_eq(load8(pcm + 0), 0xFF, "32767 lo");   # 0x7FFF
assert_eq(load8(pcm + 1), 0x7F, "32767 hi");
assert_eq(load8(pcm + 2), 0x01, "-32767 lo");  # 0x8001
assert_eq(load8(pcm + 3), 0x80, "-32767 hi");
assert_eq(load8(pcm + 4), 0xFF, "16383 lo");   # 0x3FFF
assert_eq(load8(pcm + 5), 0x3F, "16383 hi");
assert_eq(load8(pcm + 6), 0, "0 lo");
assert_eq(load8(pcm + 7), 0, "0 hi");

# ---- round-trip AudioBuffer -> S16_LE -> AudioBuffer (within quantization) ----
test_group("s16le_roundtrip");
var rv = vec_new();
var i = 0;
while (i < 128) {
    var s = f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, f64_from(440)), f64_from(i)), f64_from(44100)));
    vec_push(rv, s);
    vec_push(rv, f64_mul(s, 0.5));
    i = i + 1;
}
var src = dhvani_buffer_from_interleaved(rv, 2, 44100);
var back = dhvani_capture_from_s16le(dhvani_playback_to_s16le(src), 128, 2, 44100);
assert_eq(dhvani_buffer_channels(back), 2, "stereo preserved");
assert_eq(dhvani_buffer_frames(back), 128, "128 frames preserved");
var os = dhvani_buffer_samples(src);
var bs = dhvani_buffer_samples(back);
var ok = 1;
var j = 0;
while (j < 256) {
    if (f64_ge(f64_abs(f64_sub(vec_get(bs, j), vec_get(os, j))), 0.0001) == 1) { ok = 0; }
    j = j + 1;
}
assert_eq(ok, 1, "round-trip within i16 quantization (<1e-4)");

# ---- ring player: alloc-free push enqueues the same S16_LE bytes ----
test_group("player_ring_push");
var pv = vec_new();
vec_push(pv, 1.0);
vec_push(pv, f64_neg(0.5));
vec_push(pv, 0.25);
vec_push(pv, 0);
var pbuf = dhvani_buffer_from_interleaved(pv, 2, 44100);   # 2 frames stereo = 4 samples = 8 bytes
var expect = dhvani_playback_to_s16le(pbuf);
var player = dhvani_player_new(1024, 2, 2);
assert_eq(dhvani_player_push(player, pbuf), 8, "pushed 8 bytes");
var got = alloc(8);
assert_eq(vani_ring_read(dhvani_player_ring(player), got, 8), 8, "read 8 bytes back");
var pok = 1;
var k = 0;
while (k < 8) {
    if (load8(got + k) != load8(expect + k)) { pok = 0; }
    k = k + 1;
}
assert_eq(pok, 1, "ring bytes == one-shot to_s16le bytes");

# ---- multi-format PCM: full-scale packs to the right LE bytes per depth ----
# 1.0 -> i16 0x7FFF, i24 0x7FFFFF, i32 0x7FFFFFFF (little-endian).
test_group("pcm_formats");
var mv = vec_new();
vec_push(mv, 1.0);
var mb = dhvani_buffer_from_interleaved(mv, 1, 44100);
var p16 = dhvani_playback_to_pcm(mb, 16);
assert_eq(load8(p16 + 0), 0xFF, "i16 b0");
assert_eq(load8(p16 + 1), 0x7F, "i16 b1");
var p24 = dhvani_playback_to_pcm(mb, 24);
assert_eq(load8(p24 + 0), 0xFF, "i24 b0");
assert_eq(load8(p24 + 1), 0xFF, "i24 b1");
assert_eq(load8(p24 + 2), 0x7F, "i24 b2");
var p32 = dhvani_playback_to_pcm(mb, 32);
assert_eq(load8(p32 + 0), 0xFF, "i32 b0");
assert_eq(load8(p32 + 3), 0x7F, "i32 b3 (msb)");

# ---- round-trip i16/i24/i32 on a sine within quantization ----
test_group("pcm_roundtrip_depths");
var sv = vec_new();
var si = 0;
while (si < 32) {
    vec_push(sv, f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, f64_from(440)), f64_from(si)), f64_from(44100))));
    si = si + 1;
}
var sbuf = dhvani_buffer_from_interleaved(sv, 1, 44100);
var os2 = dhvani_buffer_samples(sbuf);
var depths = vec_new();
vec_push(depths, 16);
vec_push(depths, 24);
vec_push(depths, 32);
var dok = 1;
var di = 0;
while (di < 3) {
    var depth = vec_get(depths, di);
    var back = dhvani_capture_from_pcm(dhvani_playback_to_pcm(sbuf, depth), 32, 1, 44100, depth);
    var bs2 = dhvani_buffer_samples(back);
    var m = 0;
    while (m < 32) {
        if (f64_ge(f64_abs(f64_sub(vec_get(bs2, m), vec_get(os2, m))), 0.0001) == 1) { dok = 0; }
        m = m + 1;
    }
    di = di + 1;
}
assert_eq(dok, 1, "i16/i24/i32 round-trip within 1e-4");

# ---- capture recorder: ring bytes -> decoded AudioBuffer ----
# (fills the recorder's ring directly, standing in for vani_record_to_ring, which
# needs /dev/snd; validates the ring-drain + unpack side.)
test_group("recorder_ring_read");
var rec = dhvani_recorder_new(1024, 4, 2, 44100);
var kv = vec_new();
vec_push(kv, 1.0);
vec_push(kv, f64_neg(1.0));
vec_push(kv, 0.5);
vec_push(kv, 0);
var kpcm = dhvani_playback_to_s16le(dhvani_buffer_from_interleaved(kv, 2, 44100));
vani_ring_write(dhvani_recorder_ring(rec), kpcm, 8);
var got = dhvani_recorder_read(rec, 2);
assert_eq(dhvani_buffer_channels(got), 2, "recorder stereo");
assert_eq(dhvani_buffer_frames(got), 2, "recorder 2 frames");
var gs = dhvani_buffer_samples(got);
assert(f64_lt(f64_abs(f64_sub(vec_get(gs, 0), 1.0)), 0.0001), "sample0 ~1.0");
assert(f64_lt(f64_abs(f64_sub(vec_get(gs, 1), f64_neg(1.0))), 0.0001), "sample1 ~-1.0");
assert(f64_lt(f64_abs(f64_sub(vec_get(gs, 2), 0.5)), 0.0001), "sample2 ~0.5");
assert(f64_lt(f64_abs(vec_get(gs, 3)), 0.0001), "sample3 ~0");

# ---- s24_storage_vs_packed_width (regression, 2.2.3) ----
# ALSA's SND_PCM_FORMAT_S24_LE carries 24 significant bits in a 32-bit word, so
# the DEVICE width is 4 while the packed/logical width (rust-old parity, used by
# the pure bridge) is 3. Sizing a device buffer with the packed width made the
# kernel read/write 33% past the allocation.
test_group("s24_storage_vs_packed_width");
assert_eq(dh_pcm_bytes(16), 2, "packed width 16 == 2");
assert_eq(dh_pcm_bytes(24), 3, "packed width 24 == 3 (rust-old f32_to_i24_packed)");
assert_eq(dh_pcm_bytes(32), 4, "packed width 32 == 4");
assert_eq(dh_pcm_store_bytes(16), 2, "storage width 16 == 2");
assert_eq(dh_pcm_store_bytes(24), 4, "storage width 24 == 4 (S24_LE in a 32-bit word)");
assert_eq(dh_pcm_store_bytes(32), 4, "storage width 32 == 4");
# the storage width must agree with what vani will tell the kernel
assert_eq(dh_pcm_store_bytes(24), vani_bytes_per_sample(vani_alsa_for(24, 1)), "storage width 24 matches vani");
assert_eq(dh_pcm_store_bytes(16), vani_bytes_per_sample(vani_alsa_for(16, 1)), "storage width 16 matches vani");
assert_eq(dh_pcm_store_bytes(32), vani_bytes_per_sample(vani_alsa_for(32, 1)), "storage width 32 matches vani");

# ---- s24_storage_roundtrip_extremes (regression, 2.2.3) ----
# Round-trip through the 4-byte storage layout, including the sign padding that
# the unpack mask has to strip before the sign fold.
test_group("s24_storage_roundtrip_extremes");
var sv = vec_new();
vec_push(sv, 1.0); vec_push(sv, DH_NEG_ONE); vec_push(sv, 0); vec_push(sv, 0.5);
var sbytes = dh_pcm_store_bytes(24);
var sbuf = alloc(4 * sbytes);
dh_pack_le_w(sv, 4, sbuf, 24, sbytes);
var sout = dh_vec_zeros(4);
dh_unpack_le_w(sbuf, 4, sout, 24, sbytes);
assert_eq(f64_to(f64_mul(vec_get(sout, 0), 1000.0)), 1000, "S24 storage +full-scale round-trips");
assert_eq(f64_to(f64_mul(vec_get(sout, 1), 1000.0)), 0 - 1000, "S24 storage -full-scale round-trips (sign padding stripped)");
assert_eq(f64_to(f64_mul(vec_get(sout, 2), 1000.0)), 0, "S24 storage zero round-trips");
# half-scale is not exact: 0.5*8388607 = 4194303.5, and the pack TRUNCATES (as
# rust-old does), so the round-trip lands one quantum low. Assert within one LSB.
var half_err = f64_abs(f64_sub(vec_get(sout, 3), 0.5));
assert_eq(f64_lt(half_err, 0.0000002), 1, "S24 storage half-scale round-trips within 1 LSB");


var rc = assert_summary();
syscall(60, rc);
