# onset.tcyr -- parity tests for src/onset.cyr
# Ported one-for-one from the 5 #[test] blocks in rust-old/src/analysis/onset.rs:
#   silence_no_onsets, impulse_detected, multiple_onsets,
#   strengths_match_positions, high_threshold_fewer_onsets.
# (No serde / Display tests to drop.)

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/fft.cyr"
include "src/stft.cyr"
include "src/onset.cyr"

alloc_init();

# integer absolute value (no stdlib int-abs).
fn iabs(x) {
    if (x < 0) { return 0 - x; }
    return x;
}

# a `vec` of `n` zeros with samples[lo..hi] set to `val` (fill range).
fn make_impulse(n, lo, hi, val) {
    var v = dh_vec_zeros(n);
    var i = lo;
    while (i < hi) { vec_set(v, i, val); i = i + 1; }
    return v;
}

# ---- silence_no_onsets ----
# let buf = AudioBuffer::silence(1, 44100, 44100);
# let result = detect_onsets(&buf, 2048, 512, 0.3).unwrap();
# assert!(result.positions().is_empty()); assert_eq!(result.count(), 0);
test_group("silence_no_onsets");
var r1 = dhvani_detect_onsets(dhvani_buffer_silence(1, 44100, 44100), 2048, 512, 0.3);
assert(r1 != 0, "silence: non-null result");
assert_eq(vec_len(dhvani_onset_positions(r1)), 0, "silence: positions empty");
assert_eq(dhvani_onset_count(r1), 0, "silence: count == 0");

# ---- impulse_detected ----
# samples[22050..22150].fill(0.9); from_interleaved(_, 1, 44100);
# detect_onsets(&buf, 2048, 512, 0.2). positions non-empty, nearest to 22050
# is within 2048 samples.
test_group("impulse_detected");
var imp = make_impulse(44100, 22050, 22150, 0.9);
var r2 = dhvani_detect_onsets(dhvani_buffer_from_interleaved(imp, 1, 44100), 2048, 512, 0.2);
assert(r2 != 0, "impulse: non-null result");
var pos2 = dhvani_onset_positions(r2);
assert(vec_len(pos2) > 0, "impulse: positions non-empty");
# min_by_key(|&&p| (p - 22050).unsigned_abs()): earliest index wins ties.
var np2 = vec_len(pos2);
var nearest = vec_get(pos2, 0);
var best = iabs(vec_get(pos2, 0) - 22050);
var k2 = 1;
while (k2 < np2) {
    var pk = vec_get(pos2, k2);
    var dk = iabs(pk - 22050);
    if (dk < best) { best = dk; nearest = pk; }
    k2 = k2 + 1;
}
assert(iabs(nearest - 22050) < 2048, "impulse: onset near 22050");

# ---- multiple_onsets ----
# samples[10000..10100].fill(0.8); samples[30000..30100].fill(0.8);
# detect_onsets(&buf, 2048, 512, 0.2). positions.len() >= 2.
test_group("multiple_onsets");
var mv = dh_vec_zeros(44100);
var a = 10000;
while (a < 10100) { vec_set(mv, a, 0.8); a = a + 1; }
var b = 30000;
while (b < 30100) { vec_set(mv, b, 0.8); b = b + 1; }
var r3 = dhvani_detect_onsets(dhvani_buffer_from_interleaved(mv, 1, 44100), 2048, 512, 0.2);
assert(r3 != 0, "multiple: non-null result");
assert(vec_len(dhvani_onset_positions(r3)) >= 2, "multiple: >= 2 onsets");

# ---- strengths_match_positions ----
# samples[22050..22150].fill(0.9); detect_onsets(&buf, 2048, 512, 0.2).
# positions.len() == strengths.len(); each strength in (0.0, 1.0].
test_group("strengths_match_positions");
var imp4 = make_impulse(44100, 22050, 22150, 0.9);
var r4 = dhvani_detect_onsets(dhvani_buffer_from_interleaved(imp4, 1, 44100), 2048, 512, 0.2);
assert(r4 != 0, "strengths: non-null result");
var pos4 = dhvani_onset_positions(r4);
var str4 = dhvani_onset_strengths(r4);
assert_eq(vec_len(pos4), vec_len(str4), "strengths: len matches positions");
var ns4 = vec_len(str4);
var s4 = 0;
var ok4 = 1;
while (s4 < ns4) {
    var sv4 = vec_get(str4, s4);
    if (f64_gt(sv4, 0) == 0) { ok4 = 0; }
    if (f64_le(sv4, 1.0) == 0) { ok4 = 0; }
    s4 = s4 + 1;
}
assert_eq(ok4, 1, "strengths: each in (0, 1]");

# ---- high_threshold_fewer_onsets ----
# samples[10000..10050].fill(0.3); samples[30000..30050].fill(0.9);
# sensitive = detect_onsets(_, 2048, 512, 0.1); strict = detect_onsets(_, 2048, 512, 0.5);
# assert!(sensitive.positions.len() >= strict.positions.len());
test_group("high_threshold_fewer_onsets");
var hv = dh_vec_zeros(44100);
var c = 10000;
while (c < 10050) { vec_set(hv, c, 0.3); c = c + 1; }
var d = 30000;
while (d < 30050) { vec_set(hv, d, 0.9); d = d + 1; }
var hbuf = dhvani_buffer_from_interleaved(hv, 1, 44100);
var sensitive = dhvani_detect_onsets(hbuf, 2048, 512, 0.1);
var strict = dhvani_detect_onsets(hbuf, 2048, 512, 0.5);
assert(sensitive != 0, "threshold: sensitive non-null");
assert(strict != 0, "threshold: strict non-null");
var n_sensitive = vec_len(dhvani_onset_positions(sensitive));
assert(n_sensitive >= vec_len(dhvani_onset_positions(strict)), "sensitive >= strict onset count");

# ================================================================
# 2.3.2 audit regressions (not in rust-old)
# ================================================================

# ---- negative_hop_rejected ----
# Pre-fix: detect_onsets(buf, w, -hop, t) went through dhvani_stft's hop == 0-only
# guard and aborted the process in vec_get.
test_group("negative_hop_rejected");
var nh = dhvani_buffer_from_interleaved(make_impulse(44100, 22050, 22150, 0.9), 1, 44100);
assert_eq(dhvani_detect_onsets(nh, 2048, 0 - 512, 0.2), 0, "hop -512 -> 0 (no abort)");
assert_eq(dhvani_detect_onsets(nh, 2048, 0, 0.2), 0, "hop 0 -> 0");

# ---- spectral_flux_shared ----
# dhvani_spectral_flux is the flux detect_onsets peak-picks; < 2 frames -> empty.
test_group("spectral_flux_shared");
var fsg = dhvani_stft(nh, 2048, 512);
var fl = dhvani_spectral_flux(fsg);
assert_eq(vec_len(fl), dhvani_spectrogram_num_frames(fsg), "one flux value per frame");
assert_eq(vec_get(fl, 0), 0, "flux[0] = 0");
var fmax = 0;
var fi = 0;
while (fi < vec_len(fl)) { fmax = f64_max(fmax, vec_get(fl, fi)); fi = fi + 1; }
assert_eq(fmax, 1.0, "normalized to peak 1.0");
var fone = dhvani_stft(dhvani_buffer_silence(1, 2048, 44100), 2048, 512);
assert_eq(vec_len(dhvani_spectral_flux(fone)), 0, "1 frame -> empty flux");

# ---- flux_from_buffer_matches_spectrogram ----
# dhvani_spectral_flux_from_buffer streams the STFT frame by frame. It must give the
# spectrogram path's flux bit for bit, refuse what dhvani_stft refuses, and match its
# frame count at every edge (one frame, a hop past the window, an odd hop).
test_group("flux_from_buffer_matches_spectrogram");

# 1 if vecs a and b hold the same bits (and the same length).
fn bits_equal(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# A stereo test signal: tones, a chirp and two clicks on the left, a different tone on
# the right (only channel 0 feeds the STFT, as in the oracle).
fn flux_signal(frames, sr) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var t = f64_div(f64_from(i), f64_from(sr));
        var l = f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, 440.0), t)), 0.3);
        l = f64_add(l, f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, f64_mul(200.0, f64_add(1.0, t))), t)), 0.2));
        if (i > 9000 && i < 9100) { l = f64_add(l, 0.8); }
        if (i > 30000 && i < 30040) { l = f64_sub(l, 0.7); }
        vec_push(v, l);
        vec_push(v, f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, 1500.0), t)), 0.4));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 2, sr);
}

# 1 if both paths agree on (buf, ws, hop): both refuse, or both give the same bits.
fn flux_paths_agree(buf, ws, hop) {
    var sg = dhvani_stft(buf, ws, hop);
    var streamed = dhvani_spectral_flux_from_buffer(buf, ws, hop);
    if (sg == 0) { return streamed == 0; }
    if (streamed == 0) { return 0; }
    return bits_equal(dhvani_spectral_flux(sg), streamed);
}

var fsig = flux_signal(44100, 44100);
assert_eq(flux_paths_agree(fsig, 2048, 512), 1, "stereo 2048/512: bit for bit");
assert_eq(flux_paths_agree(fsig, 1024, 300), 1, "odd hop 300: bit for bit");
assert_eq(flux_paths_agree(flux_signal(4096, 44100), 512, 1), 1, "hop 1: bit for bit");
assert_eq(flux_paths_agree(fsig, 2048, 4096), 1, "hop past the window: bit for bit");
assert_eq(flux_paths_agree(nh, 2048, 512), 1, "mono impulse: bit for bit");
var fsil = dhvani_buffer_silence(2, 8192, 44100);
assert_eq(flux_paths_agree(fsil, 2048, 512), 1, "silence (peak 0, no normalize): bit for bit");
var fs2 = dhvani_spectral_flux_from_buffer(fsig, 2048, 512);
assert_eq(vec_len(fs2), dhvani_spectrogram_num_frames(dhvani_stft(fsig, 2048, 512)), "one value per frame");
assert_eq(vec_get(fs2, 0), 0, "flux[0] = 0");
# frame-count edges: exactly one frame, exactly two
# the flux length for a mono silent buffer of n frames at 2048/512
fn flux_len_of(n) {
    return vec_len(dhvani_spectral_flux_from_buffer(dhvani_buffer_silence(1, n, 44100), 2048, 512));
}
assert_eq(flux_len_of(2048), 0, "1 frame -> empty");
assert_eq(flux_len_of(2560), 2, "2 frames -> 2 values");
assert_eq(flux_len_of(1000), 0, "window longer than buffer -> empty");
# refusals match dhvani_stft's
assert_eq(dhvani_spectral_flux_from_buffer(fsig, 2048, 0), 0, "hop 0 -> 0");
assert_eq(dhvani_spectral_flux_from_buffer(fsig, 2048, 0 - 512), 0, "hop -512 -> 0");
assert_eq(dhvani_spectral_flux_from_buffer(fsig, 1000, 512), 0, "window not pow2 -> 0");
assert_eq(dhvani_spectral_flux_from_buffer(fsig, 2, 1), 0, "window < 4 -> 0");
var fempty = dhvani_buffer_from_interleaved(vec_new(), 1, 44100);
assert_eq(dhvani_spectral_flux_from_buffer(fempty, 2048, 512), 0, "empty buffer -> 0");
# detect_onsets runs on the streamed flux and still finds the impulse
assert(dhvani_onset_count(dhvani_detect_onsets(fsig, 2048, 512, 0.2)) > 0, "detect_onsets on the stream finds onsets");

# ---- flux_memory_is_per_frame ----
# The streamed flux keeps two magnitude frames plus one value per frame. The
# spectrogram path keeps every frame: 10 s at 2048/512 is 858 frames of 1024 bins,
# about 7 MB. Measured after one warm call, so the FFT's twiddle table already exists.
test_group("flux_memory_is_per_frame");
var flong = dhvani_buffer_silence(1, 441000, 44100);
var fwarm = dhvani_spectral_flux_from_buffer(flong, 2048, 512);
assert_eq(vec_len(fwarm), 858, "10 s at 2048/512 -> 858 frames");
var fu0 = alloc_used();
var fl2 = dhvani_spectral_flux_from_buffer(flong, 2048, 512);
var fu1 = alloc_used();
# window + real + imag (3 x 2048) + two frames (2 x 1024) + flux (858), in f64 words,
# plus vec headers
var fbound = (3 * 2048 + 2 * 1024 + 858) * 8 + 1024;
assert(fu1 - fu0 <= fbound, "streamed flux allocates O(window + frames)");
assert(fu1 - fu0 >= 858 * 8, "and does hold its flux values");
var fu2 = alloc_used();
var fsg2 = dhvani_stft(flong, 2048, 512);
var fu3 = alloc_used();
assert(fu3 - fu2 > 858 * 1024 * 8, "the spectrogram path holds every frame");
assert_eq(bits_equal(fl2, dhvani_spectral_flux(fsg2)), 1, "same bits on the long buffer");

var rc = assert_summary();
syscall(60, rc);
