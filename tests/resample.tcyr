# resample.tcyr -- parity tests for src/resample.cyr
# Ported from the #[test] blocks in rust-old/src/buffer/resample.rs. The
# analysis-gated sine_frequency_preserved test is re-enabled in Wave G (needs
# analysis::spectrum_dft). Negative loop start uses integer negation (indices),
# floats via f64_neg.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/fft.cyr"
include "src/resample.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }

# build sin(2*pi*freq*i/sr) for `frames` samples.
fn make_sine(frames, freq, sr) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var phase = f64_div(f64_mul(f64_mul(f64_mul(2.0, DH_PI), freq), f64_from(i)), f64_from(sr));
        vec_push(v, f64_sin(phase));
        i = i + 1;
    }
    return v;
}

# ---- same_rate_identity ----
test_group("same_rate_identity");
var sv = vec_new(); vec_push(sv, 0.5); vec_push(sv, f64_neg(0.5)); vec_push(sv, 0.3); vec_push(sv, f64_neg(0.3));
var sbuf = dhvani_buffer_from_interleaved(sv, 1, 44100);
var sout = dhvani_resample_sinc(sbuf, 44100, DH_RESAMPLE_GOOD);
assert_eq(dhvani_buffer_frames(sout), dhvani_buffer_frames(sbuf), "same frame count");
assert(near(vec_get(dhvani_buffer_samples(sout), 0), 0.5, 0.0001), "sample 0 preserved");
assert(near(vec_get(dhvani_buffer_samples(sout), 1), f64_neg(0.5), 0.0001), "sample 1 preserved");

# ---- zero_rate_rejected ----
test_group("zero_rate_rejected");
var zbuf = dhvani_buffer_silence(1, 100, 44100);
assert_eq(dhvani_resample_sinc(zbuf, 0, DH_RESAMPLE_DRAFT), 0, "rate 0 -> null");

# ---- empty_buffer ----
test_group("empty_buffer");
var ebuf = dhvani_buffer_silence(2, 0, 44100);
var eout = dhvani_resample_sinc(ebuf, 48000, DH_RESAMPLE_GOOD);
assert_eq(dhvani_buffer_frames(eout), 0, "empty stays empty");
assert_eq(dhvani_buffer_sample_rate(eout), 48000, "rate = 48000");

# ---- upsample_increases_frames ----
test_group("upsample_increases_frames");
var ubuf = dhvani_buffer_silence(1, 1000, 44100);
var uout = dhvani_resample_sinc(ubuf, 96000, DH_RESAMPLE_DRAFT);
assert(dhvani_buffer_frames(uout) > 1000, "upsample adds frames");
assert_eq(dhvani_buffer_sample_rate(uout), 96000, "rate = 96000");

# ---- downsample_decreases_frames ----
test_group("downsample_decreases_frames");
var dbuf = dhvani_buffer_silence(1, 1000, 96000);
var dout = dhvani_resample_sinc(dbuf, 44100, DH_RESAMPLE_DRAFT);
assert(dhvani_buffer_frames(dout) < 1000, "downsample removes frames");
assert_eq(dhvani_buffer_sample_rate(dout), 44100, "rate = 44100");

# ---- roundtrip_preserves_signal ----
test_group("roundtrip_preserves_signal");
var sine = make_sine(4096, 440.0, 44100);
var rbuf = dhvani_buffer_from_interleaved(sine, 1, 44100);
var orig_rms = dhvani_buffer_rms(rbuf);
var up = dhvani_resample_sinc(rbuf, 48000, DH_RESAMPLE_GOOD);
var back = dhvani_resample_sinc(up, 44100, DH_RESAMPLE_GOOD);
assert(f64_lt(f64_abs(f64_sub(dhvani_buffer_rms(back), orig_rms)), f64_mul(orig_rms, 0.1)), "RMS preserved within 10%");

# ---- quality_levels_all_work ----
test_group("quality_levels_all_work");
var qsine = make_sine(1024, 440.0, 44100);
var qbuf = dhvani_buffer_from_interleaved(qsine, 1, 44100);
var quals = vec_new();
vec_push(quals, DH_RESAMPLE_DRAFT); vec_push(quals, DH_RESAMPLE_GOOD); vec_push(quals, DH_RESAMPLE_BEST);
var qi = 0;
var qok = 1;
while (qi < 3) {
    var qout = dhvani_resample_sinc(qbuf, 48000, vec_get(quals, qi));
    if (dhvani_buffer_frames(qout) == 0) { qok = 0; }
    var qs = dhvani_buffer_samples(qout);
    var qn = vec_len(qs);
    var k = 0;
    while (k < qn) {
        if (dhvani_is_finite(vec_get(qs, k)) == 0) { qok = 0; }
        k = k + 1;
    }
    qi = qi + 1;
}
assert_eq(qok, 1, "all qualities produce finite non-empty output");

# ---- sine_frequency_preserved (re-enabled, Wave G) ----
# 440Hz sine at 44100 -> resample to 48000 -> DFT -> dominant bin near 440Hz.
test_group("sine_frequency_preserved");
var fsine = make_sine(4096, 440.0, 44100);
var fbuf = dhvani_buffer_from_interleaved(fsine, 1, 44100);
var fres = dhvani_resample_sinc(fbuf, 48000, DH_RESAMPLE_GOOD);
var spec = dhvani_analysis_spectrum_dft(fres, 4096);
var dominant = dhvani_spectrum_dominant_frequency(spec);
var freqres = dhvani_spectrum_freq_resolution(spec);
assert(f64_lt(f64_abs(f64_sub(dominant, f64_from(440))), f64_mul(freqres, 2.0)), "dominant freq near 440Hz");

# ---- default_path_matches_scalar_path (2.3.2) ----
# dhvani_resample_sinc (the oracle's `simd` path: weights once per frame, shared by the
# channels, gathered taps, lane-order sums) against dhvani_resample_sinc_scalar (its
# `not(simd)` path). Same shape, and every sample equal to within rounding, up and down
# (down scales the kernel), at every quality, mono and stereo with distinct channels.
fn stereo_two_tones(frames, sr) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        var t = f64_div(f64_from(i), f64_from(sr));
        vec_push(v, f64_mul(f64_sin(f64_mul(f64_mul(2.0, DH_PI), f64_mul(440.0, t))), 0.8));
        vec_push(v, f64_mul(f64_sin(f64_mul(f64_mul(2.0, DH_PI), f64_mul(3000.0, t))), 0.5));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 2, sr);
}
fn paths_agree(buf, rate, quality) {
    var a = dhvani_resample_sinc(buf, rate, quality);
    var b = dhvani_resample_sinc_scalar(buf, rate, quality);
    if (DhAudioBuffer_frames(a) != DhAudioBuffer_frames(b)) { return 0; }
    if (DhAudioBuffer_channels(a) != DhAudioBuffer_channels(b)) { return 0; }
    if (DhAudioBuffer_sample_rate(a) != DhAudioBuffer_sample_rate(b)) { return 0; }
    var sa = DhAudioBuffer_samples(a);
    var sb = DhAudioBuffer_samples(b);
    if (vec_len(sa) != vec_len(sb)) { return 0; }
    var i = 0;
    while (i < vec_len(sa)) {
        if (near(vec_get(sa, i), vec_get(sb, i), 0.000000000001) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}
test_group("default_path_matches_scalar_path");
var pst = stereo_two_tones(1000, 44100);
var pmo = dhvani_buffer_from_interleaved(make_sine(777, 440.0, 48000), 1, 48000);
assert_eq(paths_agree(pst, 48000, DH_RESAMPLE_GOOD), 1, "stereo 44.1k -> 48k, good");
assert_eq(paths_agree(pst, 22050, DH_RESAMPLE_BEST), 1, "stereo 44.1k -> 22.05k, best (scaled kernel)");
assert_eq(paths_agree(pst, 96000, DH_RESAMPLE_DRAFT), 1, "stereo 44.1k -> 96k, draft");
assert_eq(paths_agree(pmo, 44100, DH_RESAMPLE_GOOD), 1, "mono 48k -> 44.1k, good");
assert_eq(paths_agree(pmo, 8000, DH_RESAMPLE_BEST), 1, "mono 48k -> 8k, best (6x scaled kernel)");

# ---- shapes that would walk past memory (2.3.3) ----
# Through 2.3.2 the default path sized its raw stores from new_frames * ch: a 0 Hz
# source made the ratio infinite, f64_to saturated new_frames, the product wrapped and
# the stores ran off the heap (SIGSEGV). Both paths now refuse these shapes with 0.
test_group("refuses_unsafe_shapes");
var us_z = dhvani_buffer_silence(2, 10, 0);
assert_eq(dhvani_resample_sinc(us_z, 48000, DH_RESAMPLE_GOOD), 0, "0 Hz source, default path");
assert_eq(dhvani_resample_sinc_scalar(us_z, 48000, DH_RESAMPLE_GOOD), 0, "0 Hz source, scalar path");
var us_v = vec_new(); vec_push(us_v, 0.5); vec_push(us_v, 0.5); vec_push(us_v, 0.5); vec_push(us_v, 0.5);
var us_b = dhvani_buffer_from_interleaved(us_v, 2, 44100);
assert_eq(dhvani_resample_sinc(us_b, 0x7FFFFFFFFFFFFFFF, DH_RESAMPLE_GOOD), 0, "huge target rate");
assert_eq(dhvani_resample_sinc(us_b, 0 - 48000, DH_RESAMPLE_GOOD), 0, "negative target rate");
var us_lie = dhvani_buffer_from_interleaved(us_v, 2, 44100);
DhAudioBuffer_set_frames(us_lie, 1000);           # header claims more than the vec holds
assert_eq(dhvani_resample_sinc(us_lie, 48000, DH_RESAMPLE_GOOD), 0, "frames past the vec");
assert_eq(dhvani_resample_sinc_scalar(us_lie, 48000, DH_RESAMPLE_GOOD), 0, "frames past the vec, scalar");
assert(dhvani_resample_sinc(us_b, 48000, DH_RESAMPLE_GOOD) != 0, "a valid shape still resamples");

var rc = assert_summary();
syscall(60, rc);
