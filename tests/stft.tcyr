# stft.tcyr -- parity tests for src/stft.cyr
# Ported one-for-one from the 4 #[test] blocks in rust-old/src/analysis/stft.rs:
#   silence_spectrogram, sine_spectrogram_has_energy, time_resolution, freq_resolution.
# (No serde / Display tests to drop.)

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/fft.cyr"
include "src/stft.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn make_sine(freq, sr, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        vec_push(v, f64_sin(f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), freq), f64_from(i)), f64_from(sr))));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 1, sr);
}

# ---- silence_spectrogram ----
# let buf = AudioBuffer::silence(1, 4096, 44100);
# let sg = stft(&buf, 1024, 512).unwrap();
# assert!(sg.num_frames() > 0); assert_eq!(sg.num_bins, 512);
# all magnitudes zero
test_group("silence_spectrogram");
var sg1 = dhvani_stft(dhvani_buffer_silence(1, 4096, 44100), 1024, 512);
assert(dhvani_spectrogram_num_frames(sg1) > 0, "num_frames > 0");
assert_eq(dhvani_spectrogram_num_bins(sg1), 512, "num_bins == 512");
var nf1 = dhvani_spectrogram_num_frames(sg1);
var fi1 = 0;
var allzero = 1;
while (fi1 < nf1) {
    var frame1 = dhvani_spectrogram_frame(sg1, fi1);
    var b1 = 0;
    while (b1 < 512) { if (vec_get(frame1, b1) != 0) { allzero = 0; } b1 = b1 + 1; }
    fi1 = fi1 + 1;
}
assert_eq(allzero, 1, "silence mags all 0");

# ---- sine_spectrogram_has_energy ----
# 44100 samples of a 440 Hz sine, stft(2048, 1024).
# assert!(sg.num_frames() > 10); each frame total > 0.
test_group("sine_spectrogram_has_energy");
var sg2 = dhvani_stft(make_sine(440.0, 44100, 44100), 2048, 1024);
assert(dhvani_spectrogram_num_frames(sg2) > 10, "num_frames > 10");
var nf2 = dhvani_spectrogram_num_frames(sg2);
var fi2 = 0;
var all_pos = 1;
while (fi2 < nf2) {
    var frame2 = dhvani_spectrogram_frame(sg2, fi2);
    var nb2 = vec_len(frame2);
    var total2 = 0;
    var b2 = 0;
    while (b2 < nb2) { total2 = f64_add(total2, vec_get(frame2, b2)); b2 = b2 + 1; }
    if (f64_gt(total2, 0) == 0) { all_pos = 0; }
    fi2 = fi2 + 1;
}
assert_eq(all_pos, 1, "each frame total > 0");

# ---- time_resolution ----
# silence(1, 44100, 44100); stft(2048, 1024);
# (sg.time_resolution - 1024.0/44100.0).abs() < 0.001
test_group("time_resolution");
var sg3 = dhvani_stft(dhvani_buffer_silence(1, 44100, 44100), 2048, 1024);
var sg3_want = f64_div(f64_from(1024), f64_from(44100));
assert(near(dhvani_spectrogram_time_resolution(sg3), sg3_want, 0.001), "time_resolution ~ 1024/44100");

# ---- freq_resolution ----
# silence(1, 4096, 48000); stft(2048, 1024);
# (sg.freq_resolution - 48000.0/2048.0).abs() < 0.1
test_group("freq_resolution");
var sg4 = dhvani_stft(dhvani_buffer_silence(1, 4096, 48000), 2048, 1024);
var sg4_want = f64_div(f64_from(48000), f64_from(2048));
assert(near(dhvani_spectrogram_freq_resolution(sg4), sg4_want, 0.1), "freq_resolution ~ 48000/2048");

# ================================================================
# 2.3.2 audit regressions (not in rust-old)
# ================================================================

# The pre-2.3.2 dhvani_stft_run (vec accessors, full real+imag re-zero per frame,
# scalar FFT oracle), kept here as the bit-exactness reference.
fn ref_stft_frames(window, window_size, buf, hop_size) {
    var num_bins = window_size / 2;
    var samples = DhAudioBuffer_samples(buf);
    var ch = DhAudioBuffer_channels(buf);
    var total = DhAudioBuffer_frames(buf);
    var frames = vec_new();
    var pos = 0;
    var real = dh_vec_zeros(window_size);
    var imag = dh_vec_zeros(window_size);
    while ((pos + window_size) <= total) {
        var z = 0;
        while (z < window_size) { vec_set(real, z, 0); vec_set(imag, z, 0); z = z + 1; }
        var i = 0;
        while (i < window_size) {
            vec_set(real, i, f64_mul(vec_get(samples, (pos + i) * ch), vec_get(window, i)));
            i = i + 1;
        }
        var ok = dhvani_fft_in_place_scalar(real, imag);
        var mags = dh_vec_zeros(num_bins);
        var k = 0;
        while (k < num_bins) {
            var re = vec_get(real, k);
            var im = vec_get(imag, k);
            vec_set(mags, k, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(window_size)));
            k = k + 1;
        }
        vec_push(frames, mags);
        pos = pos + hop_size;
    }
    return frames;
}

fn frames_bit_equal(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var f = 0;
    while (f < vec_len(a)) {
        var fa = vec_get(a, f);
        var fb = vec_get(b, f);
        if (vec_len(fa) != vec_len(fb)) { return 0; }
        var k = 0;
        while (k < vec_len(fa)) { if (vec_get(fa, k) != vec_get(fb, k)) { return 0; } k = k + 1; }
        f = f + 1;
    }
    return 1;
}

# ---- hop_size_nonpositive ----
# Pre-fix only hop == 0 was rejected: a negative hop walked pos below 0 and
# aborted in vec_get ("vec: index < 0").
test_group("hop_size_nonpositive");
var hb = dhvani_buffer_silence(1, 4096, 44100);
assert_eq(dhvani_stft(hb, 1024, 0 - 1), 0, "stft hop -1 -> 0 (no abort)");
assert_eq(dhvani_stft(hb, 1024, 0 - 512), 0, "stft hop -512 -> 0");
var hproc = dhvani_stftproc_new(1024);
assert_eq(dhvani_stftproc_compute(hproc, hb, 0 - 1), 0, "stftproc hop -1 -> 0");
assert_eq(dhvani_stftproc_compute(hproc, hb, 0), 0, "stftproc hop 0 -> 0");

# ---- hop_size_huge ----
# Pre-fix: pos + window_size overflowed to a negative i64 after the first hop, so
# the loop kept going and aborted on an out-of-range index.
test_group("hop_size_huge");
var hh = dhvani_stft(hb, 1024, 0x7FFFFFFFFFFFFF00);
assert(hh != 0, "huge hop -> valid spectrogram");
assert_eq(dhvani_spectrogram_num_frames(hh), 1, "huge hop -> exactly the first frame");

# ---- window_size_cap ----
test_group("window_size_cap");
assert_eq(dhvani_stft(hb, 0x2000000, 512), 0, "stft window 2^25 > DH_MAX_FFT -> 0");
assert_eq(dhvani_stftproc_new(0x2000000), 0, "stftproc window 2^25 -> 0");
assert_eq(dhvani_stft(hb, 0 - 4, 512), 0, "negative window -> 0");

# ---- stft_bit_identical ----
# Raw-storage walk + imag-only re-zero + table FFT == the old accessor loop, on a
# stereo buffer (channel-0 stride), an odd hop, and a non-silent signal.
test_group("stft_bit_identical");
var bst = vec_new();
var bi = 0;
while (bi < 6000) {
    vec_push(bst, f64_sin(f64_mul(0.031, f64_from(bi))));
    vec_push(bst, f64_mul(0.5, f64_cos(f64_mul(0.17, f64_from(bi)))));
    bi = bi + 1;
}
var bbuf = dhvani_buffer_from_interleaved(bst, 2, 44100);
var bsg = dhvani_stft(bbuf, 512, 301);
var bref = ref_stft_frames(dhvani_stft_hann_window(512), 512, bbuf, 301);
assert(vec_len(bref) > 10, "reference has frames");
assert_eq(frames_bit_equal(dhvani_spectrogram_frames(bsg), bref), 1, "stft frames bit-identical to pre-fix loop");
var bproc = dhvani_stftproc_new(256);
var bpsg = dhvani_stftproc_compute(bproc, bbuf, 128);
var bpref = ref_stft_frames(dhvani_stft_hann_window(256), 256, bbuf, 128);
assert_eq(frames_bit_equal(dhvani_spectrogram_frames(bpsg), bpref), 1, "stftproc frames bit-identical");

var rc = assert_summary();
syscall(60, rc);
