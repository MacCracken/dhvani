# loudness.tcyr -- parity tests for src/loudness.cyr (EBU R128).
# Ported one-for-one from the 4 #[test] blocks in
# rust-old/src/analysis/loudness.rs. No serde/Display tests to drop.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/biquad.cyr"
include "src/loudness.cyr"

alloc_init();

# 1 if x is +/-inf or NaN (i.e. NOT finite) -- mirrors f32::is_infinite for the
# silence test (block loudness is finite or -inf, never NaN here).
fn is_inf(x) {
    if (dhvani_is_finite(x) == 0) { return 1; }
    return 0;
}

# RMS of a raw f64 `vec` (matches the Rust manual sqrt(mean(s^2))).
fn vec_rms(v) {
    var n = vec_len(v);
    var sum = 0;
    var i = 0;
    while (i < n) { var s = vec_get(v, i); sum = f64_add(sum, f64_mul(s, s)); i = i + 1; }
    return f64_sqrt(f64_div(sum, f64_from(n)));
}

# ---- silence_r128 ----
# AudioBuffer::silence(2, 48000, 48000); integrated < -60 OR infinite.
test_group("silence_r128");
var sil = dhvani_buffer_silence(2, 48000, 48000);
var rsil = dhvani_loudness_measure_r128(sil);
var integ_sil = dhvani_r128_integrated_lufs(rsil);
var sil_ok = 0;
if (f64_lt(integ_sil, f64_neg(60.0)) == 1) { sil_ok = 1; }
if (is_inf(integ_sil) == 1) { sil_ok = 1; }
assert_eq(sil_ok, 1, "silence integrated < -60 or infinite");
# Exercise all accessors (must not crash).
var _sil_range = dhvani_r128_range_lu(rsil);
var _sil_short = dhvani_r128_short_term_lufs(rsil);
var _sil_mom = dhvani_r128_momentary_lufs(rsil);

# ---- sine_r128_reasonable ----
# 2s of 1000Hz sine at amplitude 0.5, interleaved stereo @48000.
# A -6 dBFS sine should measure around -9 to -12 LUFS: -20 < LUFS < 0.
test_group("sine_r128_reasonable");
var sr2 = 48000;
var frames2 = 96000;    # sr * 2
var samps2 = vec_new();
var n2 = frames2 * 2;   # interleaved stereo -> 2 samples per interleaved index
var i2 = 0;
while (i2 < n2) {
    # 0.5 * sin(2*pi*1000*(i/2)/sr) -- (i/2) is integer frame index (Rust i/2).
    var frameidx2 = i2 / 2;   # integer division mirrors Rust (i/2) as usize
    var ph2 = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 1000.0), f64_from(frameidx2)), f64_from(sr2));
    vec_push(samps2, f64_mul(0.5, f64_sin(ph2)));
    i2 = i2 + 1;
}
var buf2 = dhvani_buffer_from_interleaved(samps2, 2, sr2);
var r2 = dhvani_loudness_measure_r128(buf2);
var integ2 = dhvani_r128_integrated_lufs(r2);
assert(f64_gt(integ2, f64_neg(20.0)), "sine LUFS > -20");
assert(f64_lt(integ2, 0.0), "sine LUFS < 0");

# ---- k_weighting_applied ----
# 5000Hz mono sine @48000, amplitude 0.5. High shelf boosts 5kHz so filtered
# RMS should exceed the input RMS by > 10%.
test_group("k_weighting_applied");
var sr3 = 48000;
var frames3 = 48000;
var samps3 = vec_new();
var i3 = 0;
while (i3 < frames3) {
    var ph3 = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 5000.0), f64_from(i3)), f64_from(sr3));
    vec_push(samps3, f64_mul(f64_sin(ph3), 0.5));
    i3 = i3 + 1;
}
var buf3 = dhvani_buffer_from_interleaved(samps3, 1, sr3);
var filtered3 = dhvani_loudness_apply_k_weighting(buf3);
var filtered_rms = vec_rms(filtered3);
var input_rms = dhvani_buffer_rms(buf3);
assert(f64_gt(filtered_rms, f64_mul(input_rms, 1.1)), "filtered RMS > input RMS * 1.1");

# ---- range_non_negative ----
# 3s mono @48000, 440Hz sine with amplitude modulated by (0.1 + 0.4*sin(t*0.5)).
test_group("range_non_negative");
var sr4 = 48000;
var frames4 = 144000;   # sr * 3
var samps4 = vec_new();
var i4 = 0;
while (i4 < frames4) {
    var t4 = f64_div(f64_from(i4), f64_from(sr4));
    var carrier4 = f64_sin(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 440.0), t4));
    var amp4 = f64_add(0.1, f64_mul(0.4, f64_sin(f64_mul(t4, 0.5))));
    vec_push(samps4, f64_mul(carrier4, amp4));
    i4 = i4 + 1;
}
var buf4 = dhvani_buffer_from_interleaved(samps4, 1, sr4);
var r4 = dhvani_loudness_measure_r128(buf4);
assert(f64_ge(dhvani_r128_range_lu(r4), 0.0), "range_lu >= 0");

var rc = assert_summary();
syscall(60, rc);
