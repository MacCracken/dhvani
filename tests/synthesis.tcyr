# synthesis.tcyr -- parity tests for src/synthesis.cyr.
# Ported one-for-one from the 7 #[test] blocks in rust-old/src/synthesis/mod.rs.
# The tests drive naad's synthesis engines through dhvani's render bridges.
# Sibling bundles are included in dependency order (sakshi -> hisab -> goonj ->
# naad), then dhvani's own modules -- see the Wave F note in port-audit.md.

include "lib/sakshi.cyr"
include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/synthesis.cyr"

# ---- stereo pan closure: s = osc.next_sample(); (s*L, s*R) ----
fn panned_tick(state, out_l, out_r) {
    var s = osc_next_sample(state);
    var g = panning_pan_gains(0.7, PAN_LAW_EQUAL_POWER);
    store64(out_l, f64_mul(s, PanGains_left(g)));
    store64(out_r, f64_mul(s, PanGains_right(g)));
    return 0;
}

# alloc-free stereo tick (panned_tick's pan-gain lookup allocates per call, which
# would hide whether the BRIDGE allocates): (s, s/2).
fn split_tick(state, out_l, out_r) {
    var s = osc_next_sample(state);
    store64(out_l, s);
    store64(out_r, f64_mul(s, 0.5));
    return 0;
}

# 1 second of 440 Hz sine as a granular source buffer.
fn build_sine(n, freq, sr) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, f64_sin(f64_div(f64_mul(f64_mul(F64_TAU, freq), f64_from(i)), sr)));
        i = i + 1;
    }
    return v;
}

# all samples finite?
fn all_finite(buf) {
    var s = dhvani_buffer_samples(buf);
    var n = vec_len(s);
    var i = 0;
    var ok = 1;
    while (i < n) {
        if (dhvani_is_finite(vec_get(s, i)) == 0) { ok = 0; }
        i = i + 1;
    }
    return ok;
}

alloc_init();

# ---- render_sine_to_buffer ----
test_group("render_sine_to_buffer");
var osc = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
var sbuf = dhvani_synth_render_to_buffer(&osc_next_sample, osc, 2, 4410, 44100);
assert_eq(dhvani_buffer_channels(sbuf), 2, "channels 2");
assert_eq(dhvani_buffer_frames(sbuf), 4410, "frames 4410");
assert(f64_gt(dhvani_buffer_peak(sbuf), 0.9), "peak > 0.9");
assert_eq(all_finite(sbuf), 1, "all finite");

# ---- render_fm_synth ----
test_group("render_fm_synth");
var fm = fm_engine_new(2, f64_from(44100));
fm_engine_set_algorithm(fm, FM_ALGO_SERIAL2);
fm_operator_set_frequency(fm_engine_operator_mut(fm, 0), f64_from(440));
fm_operator_set_level(fm_engine_operator_mut(fm, 0), F64_ONE);
fm_operator_set_frequency(fm_engine_operator_mut(fm, 1), f64_from(880));
fm_operator_set_level(fm_engine_operator_mut(fm, 1), F64_HALF);
fm_engine_note_on(fm);
var fmbuf = dhvani_synth_render_to_buffer(&fm_engine_next_sample, fm, 1, 4410, 44100);
assert(f64_gt(dhvani_buffer_rms(fmbuf), 0), "fm rms > 0");

# ---- render_stereo_panned ----
test_group("render_stereo_panned");
var posc = osc_new(WAVEFORM_SAW, f64_from(220), f64_from(44100));
var pbuf = dhvani_synth_render_stereo_to_buffer(&panned_tick, posc, 4410, 44100);
assert_eq(dhvani_buffer_channels(pbuf), 2, "channels 2");
assert(f64_gt(dhvani_buffer_peak(pbuf), 0.5), "peak > 0.5");

# ---- subtractive_synth_works ----
test_group("subtractive_synth_works");
var sub = subtractive_new(WAVEFORM_SAW, f64_from(440), f64_from(2000), 0.7, f64_from(44100));
subtractive_note_on(sub);
var subbuf = dhvani_synth_render_to_buffer(&subtractive_next_sample, sub, 1, 4410, 44100);
assert(f64_gt(dhvani_buffer_rms(subbuf), 0), "subtractive rms > 0");

# ---- granular_engine_works ----
test_group("granular_engine_works");
var gr = granular_new(f64_from(44100));
granular_set_source(gr, build_sine(44100, f64_from(440), f64_from(44100)));
granular_set_grain_rate(gr, f64_from(20));
granular_set_grain_duration(gr, f64_from(50));
var grbuf = dhvani_synth_render_to_buffer(&granular_next_sample, gr, 1, 4410, 44100);
assert_eq(all_finite(grbuf), 1, "granular all finite");

# ---- karplus_strong_works ----
test_group("karplus_strong_works");
var ks = physical_ks_new(f64_from(440), 0.99, 0.5, f64_from(44100));
physical_ks_pluck(ks);
var ksbuf = dhvani_synth_render_to_buffer(&physical_ks_next_sample, ks, 1, 4410, 44100);
assert(f64_gt(dhvani_buffer_peak(ksbuf), 0), "karplus peak > 0");

# ---- drum_kick_works ----
test_group("drum_kick_works");
var kick = drum_kick_new(f64_from(150), f64_from(40), f64_from(200), 0.8, f64_from(44100));
drum_kick_trigger(kick);
var kbuf = dhvani_synth_render_to_buffer(&drum_kick_next_sample, kick, 1, 4410, 44100);
assert(f64_gt(dhvani_buffer_peak(kbuf), 0), "kick peak > 0");

# ---- error_handles (2.3.2) ----
# A negative state is a sibling constructor's error code (osc_new answers
# NAAD_ERR_INVALID_PARAMETER for a bad waveform); osc_next_sample dereferences it.
test_group("error_handles");
var bad_osc = osc_new(0 - 1, f64_from(440), f64_from(44100));
assert(bad_osc < 0, "osc_new(bad waveform) is an error code");
assert_eq(dhvani_synth_render_to_buffer(&osc_next_sample, bad_osc, 2, 64, 44100), 0,
  "render_to_buffer(error state) -> 0");
assert_eq(dhvani_synth_render_stereo_to_buffer(&panned_tick, bad_osc, 64, 44100), 0,
  "render_stereo_to_buffer(error state) -> 0");
assert_eq(dhvani_synth_render_to_buffer(0, osc, 2, 64, 44100), 0, "render_to_buffer(null fn) -> 0");

# ---- render_alloc (2.3.2) ----
# One exact sample allocation per call (the push-grown vec allocated 32,696 B for
# a 1024-frame stereo block: ~2x the 16,384 B payload), and the _into forms
# allocate nothing while producing the same samples.
test_group("render_alloc");
var oa = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
var ob = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
var warm = dhvani_synth_render_to_buffer(&osc_next_sample, oa, 2, 1024, 44100);
var warmi = dhvani_buffer_from_interleaved(dh_vec_zeros(2048), 2, 44100);
var wri = dhvani_synth_render_into(&osc_next_sample, ob, warmi);
var sa0 = alloc_used();
var ra = dhvani_synth_render_to_buffer(&osc_next_sample, oa, 2, 1024, 44100);
var sa1 = alloc_used();
assert(sa1 - sa0 <= 16384 + 128, "render_to_buffer: one exact sample allocation");
var rib = dhvani_buffer_from_interleaved(dh_vec_zeros(2048), 2, 44100);
var sb0 = alloc_used();
assert_eq(dhvani_synth_render_into(&osc_next_sample, ob, rib), DHVANI_ERR_NONE, "render_into ok");
var sb1 = alloc_used();
assert_eq(sb1 - sb0, 0, "render_into allocates nothing");
var same = 1;
var k = 0;
while (k < 2048) {
    if (vec_get(dhvani_buffer_samples(ra), k) != vec_get(dhvani_buffer_samples(rib), k)) { same = 0; }
    k = k + 1;
}
assert_eq(same, 1, "render_into == render_to_buffer for identical oscillators");
var pa = osc_new(WAVEFORM_SAW, f64_from(220), f64_from(44100));
var pb = osc_new(WAVEFORM_SAW, f64_from(220), f64_from(44100));
var sra = dhvani_synth_render_stereo_to_buffer(&split_tick, pa, 512, 44100);
var srb = dhvani_buffer_from_interleaved(dh_vec_zeros(1024), 2, 44100);
var sc0 = alloc_used();
assert_eq(dhvani_synth_render_stereo_into(&split_tick, pb, srb), DHVANI_ERR_NONE, "render_stereo_into ok");
var sc1 = alloc_used();
assert_eq(sc1 - sc0, 0, "render_stereo_into allocates nothing");
var same2 = 1;
k = 0;
while (k < 1024) {
    if (vec_get(dhvani_buffer_samples(sra), k) != vec_get(dhvani_buffer_samples(srb), k)) { same2 = 0; }
    k = k + 1;
}
assert_eq(same2, 1, "render_stereo_into == render_stereo_to_buffer");
var monob = dhvani_buffer_from_interleaved(dh_vec_zeros(4), 1, 44100);
assert_eq(dhvani_synth_render_stereo_into(&panned_tick, pb, monob), DHVANI_ERR_INVALID_PARAMETER,
  "render_stereo_into(mono) -> invalid");
var z0 = dhvani_synth_render_to_buffer(&osc_next_sample, oa, 0, 16, 44100);
assert_eq(dhvani_buffer_channels(z0), 1, "channels 0 -> rust-old silence(1, frames, sr) fallback");
assert_eq(dhvani_buffer_frames(z0), 16, "fallback keeps the frame count");

var rc = assert_summary();
syscall(60, rc);
