# meter.tcyr -- parity tests for src/meter.cyr
# Ported one-for-one from the 17 #[test] blocks in rust-old/src/meter/mod.rs.
# No serde/Display tests to drop. The threaded shared_meter_bank test is ported
# as a plain sequential store->load (the Cyrius port is single-threaded).
# LevelMeter::new takes an INTEGER sample rate (rust-old: f32), like every other
# dhvani constructor. After the parity groups: the 2.3.3 P(-1) regressions.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/meter.cyr"

# 1 iff a and b have identical f64 bits, element by element.
fn same_bits(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# a mono/multichannel buffer of `frames` frames, every sample = v.
fn constbuf(ch, frames, v) {
    var d = vec_new();
    var i = 0;
    while (i < ch * frames) { vec_push(d, v); i = i + 1; }
    return dhvani_buffer_from_interleaved(d, ch, 48000);
}

# rust-old LevelMeter::process, verbatim as ported before 2.3.3: an explicit
# lufs_buffer window (`win`, caller-owned) summed when full, vec_get/vec_set per
# sample, no finiteness test. It drives a real DhLevelMeter's state, so the
# (unchanged) compute_lufs is shared. The bit-identity group runs it beside the
# storage-walking, running-sum dhvani_meter_level_process on finite input.
fn ref_process(self, win, buf) {
    var frames = DhAudioBuffer_frames(buf);
    var buf_channels = DhAudioBuffer_channels(buf);
    var channels = DhLevelMeter_channels(self);
    var active_channels = buf_channels;
    if (channels < active_channels) { active_channels = channels; }
    var samples = DhAudioBuffer_samples(buf);
    var peak = DhLevelMeter_peak(self);
    var rms = DhLevelMeter_rms(self);
    var rms_sum = DhLevelMeter_rms_sum(self);
    var lufs_buffer = win;
    var lufs_blocks = DhLevelMeter_lufs_blocks(self);
    var lufs_len = vec_len(lufs_buffer);
    var rp = 0;
    while (rp < vec_len(peak)) { vec_set(peak, rp, 0); rp = rp + 1; }
    var rms_count = DhLevelMeter_rms_count(self);
    var lufs_pos = DhLevelMeter_lufs_buffer_pos(self);
    var frame = 0;
    while (frame < frames) {
        var channel_sq_sum = 0;
        var ch = 0;
        while (ch < active_channels) {
            var sample = vec_get(samples, frame * buf_channels + ch);
            var absval = f64_abs(sample);
            if (f64_gt(absval, vec_get(peak, ch)) == 1) { vec_set(peak, ch, absval); }
            var sq = f64_mul(sample, sample);
            vec_set(rms_sum, ch, f64_add(vec_get(rms_sum, ch), sq));
            channel_sq_sum = f64_add(channel_sq_sum, sq);
            ch = ch + 1;
        }
        rms_count = rms_count + 1;
        var mean_sq = 0;
        if (active_channels > 0) { mean_sq = f64_div(channel_sq_sum, f64_from(active_channels)); }
        if (lufs_pos < lufs_len) {
            vec_set(lufs_buffer, lufs_pos, mean_sq);
            lufs_pos = lufs_pos + 1;
        }
        if (lufs_pos >= lufs_len) {
            var block_sum = 0;
            var bi = 0;
            while (bi < lufs_len) { block_sum = f64_add(block_sum, vec_get(lufs_buffer, bi)); bi = bi + 1; }
            vec_push(lufs_blocks, f64_div(block_sum, f64_from(lufs_len)));
            lufs_pos = 0;
            dhvani_meter_level_compute_lufs(self);
        }
        frame = frame + 1;
    }
    DhLevelMeter_set_rms_count(self, rms_count);
    DhLevelMeter_set_lufs_buffer_pos(self, lufs_pos);
    if (rms_count > 0) {
        var uc = 0;
        while (uc < channels) {
            vec_set(rms, uc, f64_sqrt(f64_div(vec_get(rms_sum, uc), f64_from(rms_count))));
            uc = uc + 1;
        }
    }
    var peak_hold = DhLevelMeter_peak_hold(self);
    var decay = f64_pow(DhLevelMeter_peak_decay(self), f64_from(frames));
    var hc = 0;
    while (hc < channels) {
        if (f64_gt(vec_get(peak, hc), vec_get(peak_hold, hc)) == 1) {
            vec_set(peak_hold, hc, vec_get(peak, hc));
        } else {
            vec_set(peak_hold, hc, f64_mul(vec_get(peak_hold, hc), decay));
        }
        hc = hc + 1;
    }
    return 0;
}

# deterministic finite pseudo-random samples in [-1, 1)
var lcg_s = 12345;
fn lcg_sample() {
    lcg_s = lcg_s * 6364136223846793005 + 1442695040888963407;
    var v = ((lcg_s >> 33) & 0xFFFFF) - 0x80000;
    return f64_div(f64_from(v), 524288.0);
}
fn randbuf(ch, frames) {
    var d = vec_new();
    var i = 0;
    while (i < ch * frames) { vec_push(d, lcg_sample()); i = i + 1; }
    return dhvani_buffer_from_interleaved(d, ch, 4000);
}

# 1 iff two meters agree bit for bit on peak, rms, peak_hold, lufs.
fn meters_same(a, b) {
    if (same_bits(dhvani_meter_level_peak(a), dhvani_meter_level_peak(b)) == 0) { return 0; }
    if (same_bits(dhvani_meter_level_rms(a), dhvani_meter_level_rms(b)) == 0) { return 0; }
    if (same_bits(dhvani_meter_level_peak_hold(a), dhvani_meter_level_peak_hold(b)) == 0) { return 0; }
    if (dhvani_meter_level_lufs(a) != dhvani_meter_level_lufs(b)) { return 0; }
    return 1;
}

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }

# ---- peak_meter_store_load ----
test_group("peak_meter_store_load");
var pm = dhvani_meter_peak_new();
var l0 = dhvani_meter_peak_load(pm);
assert_eq(vec_get(l0, 0), 0, "initial left = 0.0");
assert_eq(vec_get(l0, 1), 0, "initial right = 0.0");
dhvani_meter_peak_store(pm, 0.8, 0.6);
var l1 = dhvani_meter_peak_load(pm);
assert_eq(vec_get(l1, 0), 0.8, "stored left = 0.8");
assert_eq(vec_get(l1, 1), 0.6, "stored right = 0.6");

# ---- meter_bank_basic ----
test_group("meter_bank_basic");
var bank = dhvani_meter_bank_new(4);
assert_eq(dhvani_meter_bank_len(bank), 4, "len = 4");
assert_eq(dhvani_meter_bank_capacity(bank), 4, "capacity = 4");
dhvani_meter_bank_store(bank, 0, 0.9, 0.7);
dhvani_meter_bank_store(bank, 1, 0.5, 0.3);
var bl0 = dhvani_meter_bank_load(bank, 0);
assert_eq(vec_get(bl0, 0), 0.9, "slot0 left = 0.9");
assert_eq(vec_get(bl0, 1), 0.7, "slot0 right = 0.7");
var bl1 = dhvani_meter_bank_load(bank, 1);
assert_eq(vec_get(bl1, 0), 0.5, "slot1 left = 0.5");
assert_eq(vec_get(bl1, 1), 0.3, "slot1 right = 0.3");
var bl99 = dhvani_meter_bank_load(bank, 99);
assert_eq(vec_get(bl99, 0), 0, "oob left = 0.0");
assert_eq(vec_get(bl99, 1), 0, "oob right = 0.0");

# ---- meter_bank_read_all ----
test_group("meter_bank_read_all");
var bank2 = dhvani_meter_bank_new(3);
dhvani_meter_bank_store(bank2, 0, 0.1, 0.2);
dhvani_meter_bank_store(bank2, 1, 0.3, 0.4);
dhvani_meter_bank_store(bank2, 2, 0.5, 0.6);
var all = dhvani_meter_bank_read_all(bank2);
assert_eq(vec_len(all), 3, "read_all len = 3");
var all0 = vec_get(all, 0);
assert_eq(vec_get(all0, 0), 0.1, "all[0] left = 0.1");
assert_eq(vec_get(all0, 1), 0.2, "all[0] right = 0.2");
var all2 = vec_get(all, 2);
assert_eq(vec_get(all2, 0), 0.5, "all[2] left = 0.5");
assert_eq(vec_get(all2, 1), 0.6, "all[2] right = 0.6");

# ---- meter_bank_set_active ----
test_group("meter_bank_set_active");
var bank3 = dhvani_meter_bank_new(8);
assert_eq(dhvani_meter_bank_len(bank3), 8, "len = 8");
dhvani_meter_bank_set_active(bank3, 3);
assert_eq(dhvani_meter_bank_len(bank3), 3, "len after set_active = 3");
var all3 = dhvani_meter_bank_read_all(bank3);
assert_eq(vec_len(all3), 3, "read_all len = 3");

# ---- shared_meter_bank_threaded (sequential port) ----
test_group("shared_meter_bank_sequential");
var sbank = dhvani_meter_shared_bank(4);
dhvani_meter_bank_store(sbank, 0, 0.99, 0.88);
var slevels = dhvani_meter_bank_load(sbank, 0);
assert_eq(vec_get(slevels, 0), 0.99, "shared left = 0.99");
assert_eq(vec_get(slevels, 1), 0.88, "shared right = 0.88");

# ---- meter_bank_out_of_bounds_store_noop ----
test_group("meter_bank_out_of_bounds_store_noop");
var bank4 = dhvani_meter_bank_new(2);
dhvani_meter_bank_store(bank4, 999, 1.0, 1.0);   # should not panic
var oob = dhvani_meter_bank_load(bank4, 999);
assert_eq(vec_get(oob, 0), 0, "oob store left = 0.0");
assert_eq(vec_get(oob, 1), 0, "oob store right = 0.0");

# ---- level_meter_silence ----
test_group("level_meter_silence");
var sbuf = dhvani_buffer_silence(2, 256, 48000);
var smeter = dhvani_meter_level_new(2, 48000);
dhvani_meter_level_process(smeter, sbuf);
var speak = dhvani_meter_level_peak(smeter);
var srms = dhvani_meter_level_rms(smeter);
assert_eq(vec_get(speak, 0), 0, "silence peak[0] = 0.0");
assert_eq(vec_get(speak, 1), 0, "silence peak[1] = 0.0");
assert_eq(vec_get(srms, 0), 0, "silence rms[0] = 0.0");

# ---- level_meter_peak_detection ----
test_group("level_meter_peak_detection");
var pdata = dh_vec_zeros(256);
vec_set(pdata, 100, 0.75);
vec_set(pdata, 200, f64_neg(0.9));
var pbuf = dhvani_buffer_from_interleaved(pdata, 1, 48000);
var pmeter = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(pmeter, pbuf);
var ppeak = dhvani_meter_level_peak(pmeter);
assert(near(vec_get(ppeak, 0), 0.9, 0.001), "peak[0] ~ 0.9");

# ---- level_meter_rms_constant ----
test_group("level_meter_rms_constant");
var cdata = vec_new();
var ci = 0;
while (ci < 1024) { vec_push(cdata, 0.5); ci = ci + 1; }
var cbuf = dhvani_buffer_from_interleaved(cdata, 1, 48000);
var cmeter = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(cmeter, cbuf);
var crms = dhvani_meter_level_rms(cmeter);
assert(near(vec_get(crms, 0), 0.5, 0.001), "rms[0] ~ 0.5");

# ---- level_meter_rms_sine ----
# 48000 samples of sin(2*pi*1000*i/48000); RMS ~ 1/sqrt(2) ~ 0.707.
test_group("level_meter_rms_sine");
var sframes = 48000;
var sdata = vec_new();
var si = 0;
while (si < sframes) {
    var sph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 1000.0), f64_from(si)), f64_from(48000));
    vec_push(sdata, f64_sin(sph));
    si = si + 1;
}
var ssbuf = dhvani_buffer_from_interleaved(sdata, 1, 48000);
var ssmeter = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(ssmeter, ssbuf);
var ssrms = dhvani_meter_level_rms(ssmeter);
assert(near(vec_get(ssrms, 0), F64_FRAC_1_SQRT2, 0.01), "sine rms ~ 0.707");

# ---- level_meter_db_conversion ----
test_group("level_meter_db_conversion");
assert(f64_lt(f64_abs(dhvani_meter_linear_to_db(1.0)), 0.001), "db(1.0) ~ 0");
assert(near(dhvani_meter_linear_to_db(0.5), f64_neg(6.02), 0.1), "db(0.5) ~ -6.02");
assert(f64_lt(dhvani_meter_linear_to_db(0), f64_neg(100.0)), "db(0.0) < -100");

# ---- level_meter_reset ----
test_group("level_meter_reset");
var rdata = vec_new();
var rri = 0;
while (rri < 512) { vec_push(rdata, 0.5); rri = rri + 1; }
var rbuf = dhvani_buffer_from_interleaved(rdata, 2, 48000);
var rmeter = dhvani_meter_level_new(2, 48000);
dhvani_meter_level_process(rmeter, rbuf);
dhvani_meter_level_reset(rmeter);
var rpeak = dhvani_meter_level_peak(rmeter);
var rrms = dhvani_meter_level_rms(rmeter);
assert_eq(vec_get(rpeak, 0), 0, "reset peak[0] = 0.0");
assert_eq(vec_get(rrms, 0), 0, "reset rms[0] = 0.0");
assert_eq(dhvani_meter_level_lufs(rmeter), DH_METER_DB_FLOOR, "reset lufs = DB_FLOOR");

# ---- level_meter_lufs_with_signal ----
# 96000 samples (2s) of 0.5*sin(2*pi*1000*i/48000); LUFS computed, negative.
test_group("level_meter_lufs_with_signal");
var lframes = 96000;
var ldata = vec_new();
var li = 0;
while (li < lframes) {
    var lph = f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), 1000.0), f64_from(li)), f64_from(48000));
    vec_push(ldata, f64_mul(f64_sin(lph), 0.5));
    li = li + 1;
}
var lbuf = dhvani_buffer_from_interleaved(ldata, 1, 48000);
var lmeter = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(lmeter, lbuf);
var llufs = dhvani_meter_level_lufs(lmeter);
assert(f64_gt(llufs, f64_neg(200.0)), "lufs > -200");
assert(f64_lt(llufs, 0.0), "lufs < 0");

# ---- level_meter_peak_hold_decay ----
test_group("level_meter_peak_hold_decay");
var hmeter = dhvani_meter_level_new(1, 48000);
var hdata = dh_vec_zeros(256);
vec_set(hdata, 50, 0.8);
var hbuf = dhvani_buffer_from_interleaved(hdata, 1, 48000);
dhvani_meter_level_process(hmeter, hbuf);
var hhold = dhvani_meter_level_peak_hold(hmeter);
assert(near(vec_get(hhold, 0), 0.8, 0.001), "peak_hold ~ 0.8");
var hdata2 = vec_new();
var hi = 0;
while (hi < 256) { vec_push(hdata2, 0.01); hi = hi + 1; }
var hbuf2 = dhvani_buffer_from_interleaved(hdata2, 1, 48000);
dhvani_meter_level_process(hmeter, hbuf2);
var hhold2 = dhvani_meter_level_peak_hold(hmeter);
assert(f64_gt(vec_get(hhold2, 0), 0), "peak_hold > 0 after decay");
assert(f64_lt(vec_get(hhold2, 0), 0.8), "peak_hold < 0.8 after decay");

# ---- level_meter_multi_channel ----
test_group("level_meter_multi_channel");
var mframes = 256;
var mdata = dh_vec_zeros(mframes * 2);
var mi = 0;
while (mi < mframes) {
    vec_set(mdata, mi * 2, 0.6);
    vec_set(mdata, mi * 2 + 1, 0.3);
    mi = mi + 1;
}
var mbuf = dhvani_buffer_from_interleaved(mdata, 2, 48000);
var mmeter = dhvani_meter_level_new(2, 48000);
dhvani_meter_level_process(mmeter, mbuf);
var mpeak = dhvani_meter_level_peak(mmeter);
assert(near(vec_get(mpeak, 0), 0.6, 0.001), "peak[0] ~ 0.6");
assert(near(vec_get(mpeak, 1), 0.3, 0.001), "peak[1] ~ 0.3");
assert(f64_gt(dhvani_meter_level_peak_db(mmeter, 0), dhvani_meter_level_peak_db(mmeter, 1)), "peak_db(0) > peak_db(1)");

# ---- level_meter_invalid_channel_db ----
test_group("level_meter_invalid_channel_db");
var imeter = dhvani_meter_level_new(1, 48000);
assert(f64_lt(dhvani_meter_level_peak_db(imeter, 5), f64_neg(100.0)), "peak_db(5) < -100");
assert(f64_lt(dhvani_meter_level_rms_db(imeter, 5), f64_neg(100.0)), "rms_db(5) < -100");
assert(f64_lt(dhvani_meter_level_peak_hold_db(imeter, 5), f64_neg(100.0)), "peak_hold_db(5) < -100");

# ---- level_meter_public_accessors ----
test_group("level_meter_public_accessors");
var adata = vec_new();
var ai = 0;
while (ai < 512) { vec_push(adata, 0.5); ai = ai + 1; }
var abuf = dhvani_buffer_from_interleaved(adata, 2, 48000);
var ameter = dhvani_meter_level_new(2, 48000);
dhvani_meter_level_process(ameter, abuf);
assert_eq(vec_len(dhvani_meter_level_peak(ameter)), 2, "peak().len() = 2");
assert_eq(vec_len(dhvani_meter_level_rms(ameter)), 2, "rms().len() = 2");
assert(f64_gt(vec_get(dhvani_meter_level_peak(ameter), 0), 0), "peak()[0] > 0");
assert(f64_gt(vec_get(dhvani_meter_level_rms(ameter), 0), 0), "rms()[0] > 0");
assert_eq(dhvani_meter_level_channels(ameter), 2, "channels() = 2");
var _alufs = dhvani_meter_level_lufs(ameter);
assert_eq(vec_len(dhvani_meter_level_peak_hold(ameter)), 2, "peak_hold().len() = 2");

# ================================================================
# 2.3.3 regressions (P(-1) sweep). Non-aborting groups first.
# ================================================================

# ---- level_meter_int_sample_rate ----
# The window is trunc(sample_rate * 0.4) frames of an INTEGER rate. Pre-2.3.3 the
# f64-typed rate turned an integer 48000 into a 0-frame window: a NaN block per
# frame and LUFS pinned at -200. A window < 1 frame is now refused (0).
test_group("level_meter_int_sample_rate");
var im = dhvani_meter_level_new(1, 48000);
assert(im != 0, "48000 Hz meter");
dhvani_meter_level_process(im, constbuf(1, 48000, 0.5));
assert_eq(vec_len(DhLevelMeter_lufs_blocks(im)), 2, "1 s at 48 kHz = two 400 ms blocks");
assert_eq(dhvani_meter_level_lufs(im), f64_add(DH_METER_LUFS_OFFSET, f64_mul(10.0, dhvani_meter_log10(0.25))),
    "LUFS of a 0.5 constant = -0.691 + 10 log10(0.25)");
assert(dhvani_meter_level_new(1, 3) != 0, "3 Hz -> 1-frame window");
assert_eq(dhvani_meter_level_new(1, 2), 0, "2 Hz -> 0-frame window refused");
assert_eq(dhvani_meter_level_new(1, 0), 0, "0 Hz refused");
assert_eq(dhvani_meter_level_new(1, 0 - 48000), 0, "negative rate refused");
assert_eq(dhvani_meter_level_new(1, 48000.0), 0, "an f64 bit pattern (old convention) refused");
assert_eq(dhvani_meter_level_new(0 - 1, 48000), 0, "negative channels refused");
assert_eq(dhvani_meter_level_process(0, constbuf(1, 4, 0.5)), DHVANI_ERR_INVALID_PARAMETER, "process(0) -> error");

# ---- level_meter_non_finite_skipped ----
# Deliberate divergence from rust-old: NaN/Inf samples are skipped (no peak,
# silence in the RMS/LUFS sums). rust-old: one NaN = NaN RMS for the meter's
# lifetime; one Inf = peak_hold Inf forever and LUFS gated to -200 for 1500 blocks.
test_group("level_meter_non_finite_skipped");
var nfd = vec_new();
var nfi = 0;
while (nfi < 256) { vec_push(nfd, 0.5); nfi = nfi + 1; }
vec_set(nfd, 10, f64_div(0.0, 0.0));
var nfm = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(nfm, dhvani_buffer_from_interleaved(nfd, 1, 48000));
assert_eq(vec_get(dhvani_meter_level_peak(nfm), 0), 0.5, "NaN ignored by peak");
assert_eq(vec_get(dhvani_meter_level_rms(nfm), 0), f64_sqrt(f64_div(f64_mul(255.0, 0.25), 256.0)),
    "NaN = silence in the RMS sum");
var nfk = 0;
while (nfk < 100) { dhvani_meter_level_process(nfm, constbuf(1, 256, 0.5)); nfk = nfk + 1; }
assert(dhvani_is_finite(vec_get(dhvani_meter_level_rms(nfm), 0)), "RMS finite after a NaN");
var ifd = vec_new();
var ifi = 0;
while (ifi < 48000) { vec_push(ifd, 0.5); ifi = ifi + 1; }
vec_set(ifd, 100, DH_POS_INF);
vec_set(ifd, 200, DH_NEG_INF);
var ifm = dhvani_meter_level_new(1, 48000);
dhvani_meter_level_process(ifm, dhvani_buffer_from_interleaved(ifd, 1, 48000));
assert_eq(vec_get(dhvani_meter_level_peak(ifm), 0), 0.5, "Inf ignored by peak");
assert_eq(vec_get(dhvani_meter_level_peak_hold(ifm), 0), 0.5, "peak_hold stays finite");
assert(dhvani_is_finite(vec_get(dhvani_meter_level_rms(ifm), 0)), "RMS finite after an Inf");
assert(f64_gt(dhvani_meter_level_lufs(ifm), f64_neg(10.0)), "LUFS still measured (~-6.7), not gated to -200");

# ---- level_meter_reset_no_leak ----
test_group("level_meter_reset_no_leak");
var rlm = dhvani_meter_level_new(2, 48000);
var rlb = constbuf(2, 512, 0.25);
var rlk = 0;
while (rlk < 300) { dhvani_meter_level_process(rlm, rlb); rlk = rlk + 1; }
var rl0 = alloc_used();
dhvani_meter_level_reset(rlm);
rlk = 0;
while (rlk < 300) { dhvani_meter_level_process(rlm, rlb); rlk = rlk + 1; }
assert_eq(alloc_used() - rl0, 0, "reset + refill to the same block count allocates 0 bytes");
assert_eq(vec_len(DhLevelMeter_lufs_blocks(rlm)), 8, "8 LUFS blocks after 300 x 512 frames");

# ---- level_meter_bit_identical_to_rust_algorithm ----
# The storage walk + running LUFS sum must reproduce the pre-2.3.3 (rust-old)
# computation bit for bit on finite input: meter wider than the buffer, buffer
# wider than the meter, block sizes that straddle the 1600-frame (4 kHz) window.
test_group("level_meter_bit_identical_to_rust_algorithm");
var bsz = vec_new();
vec_push(bsz, 1);
vec_push(bsz, 37);
vec_push(bsz, 512);
vec_push(bsz, 1000);
vec_push(bsz, 4096);
var bnew = dhvani_meter_level_new(3, 4000);
var bref = dhvani_meter_level_new(3, 4000);
var bwin = dh_vec_zeros(1600);
var bnew2 = dhvani_meter_level_new(1, 4000);
var bref2 = dhvani_meter_level_new(1, 4000);
var bwin2 = dh_vec_zeros(1600);
var bok = 1;
var bk = 0;
while (bk < 60) {
    var bb = randbuf(2, vec_get(bsz, bk % 5));
    dhvani_meter_level_process(bnew, bb);
    ref_process(bref, bwin, bb);
    if (meters_same(bnew, bref) == 0) { bok = 0; }
    dhvani_meter_level_process(bnew2, bb);
    ref_process(bref2, bwin2, bb);
    if (meters_same(bnew2, bref2) == 0) { bok = 0; }
    bk = bk + 1;
}
assert_eq(bok, 1, "peak/rms/peak_hold/lufs bit-identical after every block");
assert(vec_len(DhLevelMeter_lufs_blocks(bnew)) > 30, "many LUFS blocks exercised");
assert(f64_gt(dhvani_meter_level_lufs(bnew), DH_METER_DB_FLOOR), "LUFS gated in");

# ---- meter_alloc_free_reads ----
# rust-old's load()/read_all() return by value; the port's vec-returning forms
# allocate per call (152 B per load). Polling uses these instead: 0 bytes.
test_group("meter_alloc_free_reads");
var ap = dhvani_meter_peak_new();
dhvani_meter_peak_store(ap, 0.8, 0.6);
var ab = dhvani_meter_bank_new(16);
dhvani_meter_bank_store(ab, 3, 0.9, 0.7);
var apair = vec_new();
var aflat = vec_new();
dhvani_meter_bank_read_all_into(ab, aflat);
var a0 = alloc_used();
var ai2 = 0;
var asum = 0;
while (ai2 < 1000) {
    asum = f64_add(asum, dhvani_meter_peak_left(ap));
    asum = f64_add(asum, dhvani_meter_peak_right(ap));
    asum = f64_add(asum, dhvani_meter_bank_left(ab, 3));
    asum = f64_add(asum, dhvani_meter_bank_right(ab, 3));
    dhvani_meter_peak_load_into(ap, apair);
    dhvani_meter_bank_load_into(ab, 3, apair);
    dhvani_meter_bank_read_all_into(ab, aflat);
    ai2 = ai2 + 1;
}
assert_eq(alloc_used() - a0, 0, "1000 rounds of scalar/_into reads allocate 0 bytes");
assert_eq(dhvani_meter_peak_left(ap), 0.8, "peak_left");
assert_eq(dhvani_meter_peak_right(ap), 0.6, "peak_right");
assert_eq(dhvani_meter_bank_left(ab, 3), 0.9, "bank_left");
assert_eq(dhvani_meter_bank_right(ab, 3), 0.7, "bank_right");
dhvani_meter_peak_load_into(ap, apair);
assert_eq(vec_len(apair), 2, "load_into writes a pair");
assert_eq(vec_get(apair, 0), 0.8, "load_into left");
assert_eq(vec_get(apair, 1), 0.6, "load_into right");
dhvani_meter_bank_load_into(ab, 99, apair);
assert_eq(vec_get(apair, 0), 0, "bank_load_into out of bounds -> 0.0");
assert_eq(dhvani_meter_bank_read_all_into(ab, aflat), 16, "read_all_into returns the active count");
assert_eq(vec_len(aflat), 32, "flat [l0, r0, l1, r1, ...]");
assert_eq(vec_get(aflat, 6), 0.9, "slot 3 left at 2*3");
assert_eq(vec_get(aflat, 7), 0.7, "slot 3 right at 2*3+1");
dhvani_meter_bank_set_active(ab, 2);
assert_eq(dhvani_meter_bank_read_all_into(ab, aflat), 2, "read_all_into follows set_active");
assert_eq(vec_len(aflat), 4, "2 active slots -> 4 entries");

# ---- meter_negative_index_guards ----
# rust-old indices are usize; a negative index is out of bounds (no-op / 0.0),
# never "vec: index < 0" (the pre-2.3.3 abort).
test_group("meter_negative_index_guards");
var ng = dhvani_meter_bank_new(4);
dhvani_meter_bank_store(ng, 0 - 1, 1.0, 1.0);
var ngl = dhvani_meter_bank_load(ng, 0 - 1);
assert_eq(vec_get(ngl, 0), 0, "bank_load(-1) left = 0.0");
assert_eq(vec_get(ngl, 1), 0, "bank_load(-1) right = 0.0");
assert_eq(dhvani_meter_bank_left(ng, 0 - 1), 0, "bank_left(-1) = 0.0");
assert_eq(dhvani_meter_bank_right(ng, 0 - 1), 0, "bank_right(-1) = 0.0");
assert_eq(dhvani_meter_bank_left(ng, 0), 0, "store(-1) touched no slot");
var ngm = dhvani_meter_level_new(1, 48000);
assert_eq(dhvani_meter_level_peak_db(ngm, 0 - 1), DH_METER_DB_FLOOR, "peak_db(-1) = floor");
assert_eq(dhvani_meter_level_rms_db(ngm, 0 - 1), DH_METER_DB_FLOOR, "rms_db(-1) = floor");
assert_eq(dhvani_meter_level_peak_hold_db(ngm, 0 - 1), DH_METER_DB_FLOOR, "peak_hold_db(-1) = floor");
dhvani_meter_bank_set_active(ng, 0 - 3);
assert_eq(dhvani_meter_bank_len(ng), 0, "set_active(-3) clamps to 0");
assert_eq(dhvani_meter_bank_is_empty(ng), 1, "empty after set_active(-3)");
var ngb = dhvani_meter_bank_new(0 - 2);
assert_eq(dhvani_meter_bank_len(ngb), 0, "bank_new(-2) has 0 active");

var rc = assert_summary();
syscall(60, rc);
