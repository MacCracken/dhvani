# analysis.tcyr -- parity tests for src/analysis.cyr (Spectrum + DFT + helpers)
# Ported one-for-one from the #[test] blocks in rust-old/src/analysis/mod.rs.

include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "lib/abaco.cyr"
include "src/analysis.cyr"
include "src/fft.cyr"

alloc_init();

fn near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn fill_c(n, v) { var out = vec_new(); var i = 0; while (i < n) { vec_push(out, v); i = i + 1; } return out; }
fn make_sine(freq, sr, frames) {
    var v = vec_new();
    var i = 0;
    while (i < frames) {
        vec_push(v, f64_sin(f64_div(f64_mul(f64_mul(f64_mul(2.0, F64_PI), freq), f64_from(i)), f64_from(sr))));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(v, 1, sr);
}
fn all_mags_zero(spec) {
    var m = dhvani_spectrum_magnitudes(spec);
    var n = vec_len(m); var i = 0;
    while (i < n) { if (vec_get(m, i) != 0) { return 0; } i = i + 1; }
    return 1;
}

# ---- spectrum_of_silence ----
test_group("spectrum_of_silence");
var s1 = dhvani_analysis_spectrum_dft(dhvani_buffer_silence(1, 256, 44100), 256);
assert_eq(dhvani_spectrum_bin_count(s1), 128, "128 bins");
assert_eq(all_mags_zero(s1), 1, "silence mags all 0");

# ---- spectrum_bin_frequency ----
test_group("spectrum_bin_frequency");
var s2 = dhvani_analysis_spectrum_dft(dhvani_buffer_silence(1, 1024, 44100), 1024);
assert(near(dhvani_spectrum_freq_resolution(s2), f64_div(f64_from(44100), f64_from(1024)), 0.1), "freq res");
assert(f64_lt(f64_abs(dhvani_spectrum_bin_frequency(s2, 0)), 0.1), "bin 0 = 0 Hz");
assert(near(dhvani_spectrum_bin_frequency(s2, 1), dhvani_spectrum_freq_resolution(s2), 0.1), "bin 1 = freq res");

# ---- loudness_of_silence ----
test_group("loudness_of_silence");
assert_eq(dhvani_analysis_loudness_lufs(dhvani_buffer_silence(1, 1024, 44100)), DH_NEG_INF, "silence -> -inf LUFS");

# ---- is_silent_detects_silence / signal ----
test_group("is_silent");
assert_eq(dhvani_analysis_is_silent(dhvani_buffer_silence(1, 1024, 44100), f64_neg(60.0)), 1, "silence is silent");
var sig_half = dhvani_buffer_from_interleaved(fill_c(1024, 0.5), 1, 44100);
assert_eq(dhvani_analysis_is_silent(sig_half, f64_neg(60.0)), 0, "signal not silent");

# ---- spectrum_dominant_frequency ----
test_group("spectrum_dominant_frequency");
var s6 = dhvani_analysis_spectrum_dft(make_sine(440.0, 44100, 4096), 4096);
var s6_err = f64_abs(f64_sub(dhvani_spectrum_dominant_frequency(s6), 440.0));
assert(f64_lt(s6_err, f64_mul(dhvani_spectrum_freq_resolution(s6), 2.0)), "dominant ~440");

# ---- suggest_gain ----
test_group("suggest_gain");
var loud_buf = dhvani_buffer_from_interleaved(fill_c(1024, 0.8), 1, 44100);
assert(f64_lt(dhvani_analysis_suggest_gain(loud_buf, 0.125), 1.0), "loud -> gain < 1");
var qg = dhvani_analysis_suggest_gain(dhvani_buffer_from_interleaved(fill_c(1024, 0.01), 1, 44100), 0.125);
assert(f64_gt(qg, 1.0), "quiet -> gain > 1");
assert(f64_le(qg, 10.0), "gain clamped <= 10");
assert_eq(dhvani_analysis_suggest_gain(dhvani_buffer_silence(1, 1024, 44100), 0.125), 1.0, "silence -> 1.0");
var faint_buf = dhvani_buffer_from_interleaved(fill_c(1024, 0.0001), 1, 44100);
assert_eq(dhvani_analysis_suggest_gain(faint_buf, 0.125), 10.0, "extreme -> clamp 10");

# ---- spectral_centroid ----
test_group("spectral_centroid");
var sil_dft_c = dhvani_analysis_spectrum_dft(dhvani_buffer_silence(1, 256, 44100), 256);
assert_eq(dhvani_spectrum_spectral_centroid(sil_dft_c), 0, "silence centroid 0");
var sc = dhvani_spectrum_spectral_centroid(dhvani_fft_spectrum(make_sine(2000.0, 44100, 4096), 4096));
assert(f64_lt(f64_abs(f64_sub(sc, 2000.0)), 200.0), "sine centroid ~2000");

# ---- spectral_rolloff ----
test_group("spectral_rolloff");
var sil_dft_r = dhvani_analysis_spectrum_dft(dhvani_buffer_silence(1, 256, 44100), 256);
assert_eq(dhvani_spectrum_spectral_rolloff(sil_dft_r, 0.95), 0, "silence rolloff 0");
var ro = dhvani_spectrum_spectral_rolloff(dhvani_fft_spectrum(make_sine(1000.0, 44100, 4096), 4096), 0.95);
assert(f64_gt(ro, 0), "rolloff > 0");
assert(f64_lt(ro, 22050.0), "rolloff below Nyquist");

# ================================================================
# 2.3.2 audit regressions (not in rust-old's test set; oracle semantics)
# ================================================================

# ---- spectrum_peak_ties_last ----
# rust-old's peak is `max_by(partial_cmp().unwrap_or(Equal))`, which returns the
# LAST of equal maxima: silence peaks at bin n-1. Pre-fix took the first (bin 0).
test_group("spectrum_peak_ties_last");
var sp_sil = dhvani_fft_spectrum(dhvani_buffer_silence(1, 1024, 44100), 1024);
var sp_want = f64_mul(511.0, dhvani_spectrum_freq_resolution(sp_sil));
assert_eq(dhvani_spectrum_dominant_frequency(sp_sil), sp_want, "fft silence: peak at bin 511");
var sd_sil = dhvani_analysis_spectrum_dft(dhvani_buffer_silence(1, 256, 44100), 256);
var sd_want = f64_mul(127.0, dhvani_spectrum_freq_resolution(sd_sil));
assert_eq(dhvani_spectrum_dominant_frequency(sd_sil), sd_want, "dft silence: peak at bin 127");
var tie_m = fill_c(4, 0.5);
vec_set(tie_m, 1, 1.0); vec_set(tie_m, 3, 1.0); vec_set(tie_m, 2, 0.2);
var tie_s = dhvani_spectrum_from_magnitudes(tie_m, 10.0, 44100, 8);
assert_eq(dhvani_spectrum_dominant_frequency(tie_s), 30.0, "tie at bins 1/3 -> bin 3");
assert_eq(DhSpectrum_peak_magnitude_db(tie_s), 0, "peak 1.0 -> 0 dB");
# NaN compares Equal: [1.0, NaN, 0.5] -> NaN taken at 1, replaced by 0.5 at 2.
var nan_m = fill_c(3, 1.0);
vec_set(nan_m, 1, DH_NAN); vec_set(nan_m, 2, 0.5);
var nan_s = dhvani_spectrum_from_magnitudes(nan_m, 10.0, 44100, 6);
assert_eq(dhvani_spectrum_dominant_frequency(nan_s), 20.0, "NaN Equal -> bin 2 (as max_by)");
var one_s = dhvani_spectrum_from_magnitudes(fill_c(5, 0), 10.0, 44100, 10);
assert_eq(dhvani_spectrum_dominant_frequency(one_s), 40.0, "all-zero -> last bin");
var emp_s = dhvani_spectrum_from_magnitudes(vec_new(), 10.0, 44100, 0);
assert_eq(dhvani_spectrum_dominant_frequency(emp_s), 0, "empty -> 0.0 (Rust None)");
assert_eq(DhSpectrum_peak_magnitude_db(emp_s), f64_neg(200.0), "empty -> -200 dB");
var pk_sine = dhvani_fft_spectrum(make_sine(440.0, 44100, 4096), 4096);
var pk_tol = f64_mul(dhvani_spectrum_freq_resolution(pk_sine), 2.0);
assert(near(dhvani_spectrum_dominant_frequency(pk_sine), 440.0, pk_tol), "sine peak unchanged");

var rc = assert_summary();
syscall(60, rc);
