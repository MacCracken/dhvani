# environment.tcyr -- parity tests for src/environment.cyr.
# Ported one-for-one from the 6 #[test] blocks in rust-old/src/environment/mod.rs.
# The tests drive garjan's environmental synths through dhvani's render bridges.
# Sibling bundles are included in dependency order (sakshi -> hisab -> goonj ->
# naad -> garjan), then dhvani's own modules -- see the Wave F note in port-audit.md.

include "lib/sakshi.cyr"
include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/garjan.cyr"
include "src/error.cyr"
include "src/simd.cyr"
include "src/buffer.cyr"
include "src/environment.cyr"

# all samples finite?
fn all_finite(buf) {
    var s = dhvani_buffer_samples(buf);
    var n = vec_len(s);
    var i = 0;
    var ok = 1;
    while (i < n) {
        if (dhvani_is_finite(vec_get(s, i)) == 0) { ok = 0; }
        i = i + 1;
    }
    return ok;
}

alloc_init();

# ---- rain_synthesis ----
test_group("rain_synthesis");
var rain = rain_new(RAIN_INTENSITY_HEAVY, f64_from(44100));
var rbuf = dhvani_env_render_environment(&rain_synthesize, rain, 44100, 0.5);
assert(dhvani_buffer_frames(rbuf) > 0, "rain frames > 0");
assert_eq(all_finite(rbuf), 1, "rain all finite");

# ---- wind_synthesis ----
test_group("wind_synthesis");
var wind = wind_new(f64_from(15), 0.5, f64_from(44100));
var wbuf = dhvani_env_render_environment(&wind_synthesize, wind, 44100, 0.5);
assert(dhvani_buffer_frames(wbuf) > 0, "wind frames > 0");
assert(f64_gt(dhvani_buffer_rms(wbuf), 0), "wind rms > 0");

# ---- thunder_synthesis ----
test_group("thunder_synthesis");
var thunder = thunder_new(f64_from(500), f64_from(44100));
var tbuf = dhvani_env_render_environment(&thunder_synthesize, thunder, 44100, 0.5);
assert(dhvani_buffer_frames(tbuf) > 0, "thunder frames > 0");

# ---- fire_synthesis ----
test_group("fire_synthesis");
var fire = fire_new(0.7, f64_from(44100));
var fbuf = dhvani_env_render_environment(&fire_synthesize, fire, 44100, 0.5);
assert(dhvani_buffer_frames(fbuf) > 0, "fire frames > 0");
assert_eq(all_finite(fbuf), 1, "fire all finite");

# ---- impact_synthesis ----
test_group("impact_synthesis");
var impact = impact_new(MATERIAL_WOOD, f64_from(44100));
var ibuf = dhvani_env_render_impact(impact, IMPACT_STRIKE, 44100);
assert(dhvani_buffer_frames(ibuf) > 0, "impact frames > 0");

# ---- render_block_streaming ----
test_group("render_block_streaming");
var rain2 = rain_new(RAIN_INTENSITY_LIGHT, f64_from(44100));
var bbuf = dhvani_env_render_block(&rain_process_block, rain2, 4410, 44100);
assert_eq(dhvani_buffer_frames(bbuf), 4410, "block frames 4410");
assert_eq(all_finite(bbuf), 1, "block all finite");

# ---- error_handles (2.3.2) ----
# garjan constructors return NEGATIVE codes and garjan's synthesize/process_block
# read the handle with no check: through 2.3.1 every bridge below SIGSEGV'd on one.
test_group("error_handles");
var bad_rain = rain_new(RAIN_INTENSITY_HEAVY, 0);
assert(bad_rain < 0, "rain_new(sr=0) is an error code");
var bad_impact = impact_new(MATERIAL_WOOD, 0);
assert(bad_impact < 0, "impact_new(sr=0) is an error code");
assert_eq(dhvani_env_render_environment(&rain_synthesize, bad_rain, 44100, 0.5), 0,
  "render_environment(error handle) -> 0");
assert_eq(dhvani_env_render_impact(bad_impact, IMPACT_STRIKE, 44100), 0, "render_impact(error handle) -> 0");
assert_eq(dhvani_env_render_block(&rain_process_block, bad_rain, 256, 44100), 0, "render_block(error handle) -> 0");
assert_eq(dhvani_env_render_block(&rain_process_block, 0, 256, 44100), 0, "render_block(null handle) -> 0");
assert_eq(dhvani_env_render_environment(0, rain, 44100, 0.5), 0, "render_environment(null fn) -> 0");

# ---- error_returns (2.3.2) ----
# Failures answer 0, the null-handle sentinel, not garjan's negative code; and a
# buffer-construction failure is a failure (rust-old map_err -> Err), not a 1 Hz
# silence buffer.
test_group("error_returns");
assert_eq(dhvani_env_render_environment(&rain_synthesize, rain, 44100, 0), 0,
  "invalid duration -> 0 (was a negative garjan code)");
assert_eq(dhvani_env_render_environment(&rain_synthesize, rain, 0, 0.1), 0,
  "sample_rate 0 -> 0 (was a silence buffer)");
assert_eq(dhvani_env_render_impact(impact, IMPACT_STRIKE, 0), 0, "render_impact(sample_rate 0) -> 0");
assert_eq(dhvani_env_render_impact(impact, 99, 44100), 0, "render_impact(bad type) -> 0");

# ---- render_block_alloc (2.3.2) ----
# one exact allocation per call (the push-grown vec was ~2x the payload: 16,312 B
# for 1024 frames), and the _into form allocates nothing.
test_group("render_block_alloc");
var rain3 = rain_new(RAIN_INTENSITY_LIGHT, f64_from(44100));
var bw0 = dhvani_env_render_block(&rain_process_block, rain3, 1024, 44100);
var ba0 = alloc_used();
var bw1 = dhvani_env_render_block(&rain_process_block, rain3, 1024, 44100);
var ba1 = alloc_used();
assert(ba1 - ba0 <= 1024 * 8 + 128, "render_block: one exact sample allocation");
var ibuf2 = dhvani_buffer_from_interleaved(dh_vec_zeros(1024), 1, 44100);
var bb0 = alloc_used();
assert_eq(dhvani_env_render_block_into(&rain_process_block, rain3, ibuf2), DHVANI_ERR_NONE, "render_block_into ok");
var bb1 = alloc_used();
assert_eq(bb1 - bb0, 0, "render_block_into allocates nothing");
assert_eq(all_finite(ibuf2), 1, "render_block_into all finite");
var rainA = rain_new(RAIN_INTENSITY_LIGHT, f64_from(44100));
var rainB = rain_new(RAIN_INTENSITY_LIGHT, f64_from(44100));
var ra = dhvani_env_render_block(&rain_process_block, rainA, 512, 44100);
var rbuf3 = dhvani_buffer_from_interleaved(dh_vec_zeros(512), 1, 44100);
var rbr = dhvani_env_render_block_into(&rain_process_block, rainB, rbuf3);
var same = 1;
var si = 0;
while (si < 512) {
    if (vec_get(dhvani_buffer_samples(ra), si) != vec_get(dhvani_buffer_samples(rbuf3), si)) { same = 0; }
    si = si + 1;
}
assert_eq(same, 1, "render_block_into == render_block for identical state");
var st2 = dhvani_buffer_from_interleaved(dh_vec_zeros(4), 2, 44100);
assert_eq(dhvani_env_render_block_into(&rain_process_block, rain3, st2), DHVANI_ERR_INVALID_PARAMETER,
  "render_block_into on stereo -> invalid");

var rc = assert_summary();
syscall(60, rc);
