# envelope.tcyr -- parity tests for src/envelope.cyr
# Ported one-for-one from the 7 #[test] blocks in rust-old/src/dsp/envelope.rs.

include "src/error.cyr"
include "src/envelope.cyr"

alloc_init();

# ---- idle_by_default ----
test_group("idle_by_default");
var e1 = dhvani_env_new(dhvani_adsr_default(), 44100);
assert_eq(dhvani_env_state(e1), DH_ENV_IDLE, "starts Idle");
assert_eq(dhvani_env_level(e1), 0, "level 0");
assert_eq(dhvani_env_is_finished(e1), 1, "is finished");

# ---- attack_ramps_up ----
test_group("attack_ramps_up");
var e2 = dhvani_env_new(dhvani_adsr_new(0.01, 0.01, 0.5, 0.01), 44100);
dhvani_env_trigger(e2);
assert_eq(dhvani_env_state(e2), DH_ENV_ATTACK, "in Attack after trigger");
var maxl = 0;
var i = 0;
while (i < 500) {
    var la = dhvani_env_tick(e2);
    if (f64_gt(la, maxl) == 1) { maxl = la; }
    i = i + 1;
}
assert(f64_gt(maxl, 0.9), "attack reaches near 1.0");

# ---- sustain_holds ----
test_group("sustain_holds");
var e3 = dhvani_env_new(dhvani_adsr_new(0.001, 0.001, 0.6, 0.1), 44100);
dhvani_env_trigger(e3);
i = 0;
while (i < 1000) { dhvani_env_tick(e3); i = i + 1; }
assert_eq(dhvani_env_state(e3), DH_ENV_SUSTAIN, "reaches Sustain");
assert(f64_lt(f64_abs(f64_sub(dhvani_env_level(e3), 0.6)), 0.05), "holds at 0.6");

# ---- release_decays_to_zero ----
test_group("release_decays_to_zero");
var e4 = dhvani_env_new(dhvani_adsr_new(0.001, 0.001, 0.7, 0.01), 44100);
dhvani_env_trigger(e4);
i = 0;
while (i < 500) { dhvani_env_tick(e4); i = i + 1; }
dhvani_env_release(e4);
assert_eq(dhvani_env_state(e4), DH_ENV_RELEASE, "in Release");
i = 0;
while (i < 1000) { dhvani_env_tick(e4); i = i + 1; }
assert_eq(dhvani_env_is_finished(e4), 1, "finished");
assert(f64_lt(dhvani_env_level(e4), 0.01), "level ~ 0");

# ---- release_from_attack ----
test_group("release_from_attack");
var e5 = dhvani_env_new(dhvani_adsr_new(0.1, 0.1, 0.5, 0.01), 44100);
dhvani_env_trigger(e5);
i = 0;
while (i < 100) { dhvani_env_tick(e5); i = i + 1; }
dhvani_env_release(e5);
i = 0;
while (i < 1000) { dhvani_env_tick(e5); i = i + 1; }
assert_eq(dhvani_env_is_finished(e5), 1, "finished after release-from-attack");

# ---- reset_goes_idle ----
test_group("reset_goes_idle");
var e6 = dhvani_env_new(dhvani_adsr_default(), 44100);
dhvani_env_trigger(e6);
i = 0;
while (i < 100) { dhvani_env_tick(e6); i = i + 1; }
dhvani_env_reset(e6);
assert_eq(dhvani_env_is_finished(e6), 1, "idle after reset");
assert_eq(dhvani_env_level(e6), 0, "level 0 after reset");

# ---- set_params_updates ----
test_group("set_params_updates");
var e7 = dhvani_env_new(dhvani_adsr_default(), 44100);
assert_eq(dhvani_env_set_params(e7, dhvani_adsr_new(0.5, 0.2, 0.3, 1.0)), DHVANI_ERR_NONE, "set_params ok");
dhvani_env_trigger(e7);
dhvani_env_tick(e7);
assert_eq(dhvani_env_state(e7), DH_ENV_ATTACK, "uses new attack (still ramping)");

# ================================================================
# 2.3.2 hardening regressions (each fails on the 2.3.2 code)
# ================================================================
var env_nan = 0x7FF8000000000000;

# ---- validate_rejects_nan ----
# Rust: !(0.0..=1.0).contains(&sustain) rejects a NaN sustain; the port's negated
# tests let it through, and the envelope then ticked NaN. The time bounds reject NaN too.
test_group("validate_rejects_nan");
assert_eq(dhvani_adsr_validate(dhvani_adsr_new(0.01, 0.1, env_nan, 0.3)), DHVANI_ERR_INVALID_PARAMETER, "NaN sustain");
assert_eq(dhvani_adsr_validate(dhvani_adsr_new(env_nan, 0.1, 0.7, 0.3)), DHVANI_ERR_INVALID_PARAMETER, "NaN attack");
assert_eq(dhvani_adsr_validate(dhvani_adsr_new(0.01, env_nan, 0.7, 0.3)), DHVANI_ERR_INVALID_PARAMETER, "NaN decay");
assert_eq(dhvani_adsr_validate(dhvani_adsr_new(0.01, 0.1, 0.7, env_nan)), DHVANI_ERR_INVALID_PARAMETER, "NaN release");
assert_eq(dhvani_adsr_validate(dhvani_adsr_new(0, 0, 1.0, 0)), DHVANI_ERR_NONE, "bounds inclusive");
var env_n1 = dhvani_env_new(dhvani_adsr_default(), 1000);
var env_bad = dhvani_adsr_new(0, 0, env_nan, 0.3);
assert_eq(dhvani_env_set_params(env_n1, env_bad), DHVANI_ERR_INVALID_PARAMETER, "set_params rejects NaN sustain");
dhvani_env_trigger(env_n1);
var env_t = 0;
var env_lv = 0;
while (env_t < 300) { env_lv = dhvani_env_tick(env_n1); env_t = env_t + 1; }
assert(f64_eq(env_lv, env_lv), "envelope still ticks real levels");

# ---- params_owned ----
# The oracle takes AdsrParams by value. The port stored the caller's handle, so a
# later write to it skipped validate(); new() and set_params() now copy.
test_group("params_owned");
var env_p = dhvani_adsr_new(0, 0, 0.7, 0.3);
var env_o = dhvani_env_new(env_p, 1000);
DhAdsrParams_set_sustain(env_p, env_nan);
dhvani_env_trigger(env_o);
var env_k = 0;
while (env_k < 10) { env_lv = dhvani_env_tick(env_o); env_k = env_k + 1; }
assert_eq(env_lv, 0.7, "new(): sustain still 0.7 after the caller's handle changed");
var env_q = dhvani_adsr_new(0, 0, 0.4, 0.3);
var env_u = alloc_used();
assert_eq(dhvani_env_set_params(env_o, env_q), DHVANI_ERR_NONE, "set_params ok");
assert_eq(alloc_used() - env_u, 0, "set_params allocates nothing");
DhAdsrParams_set_sustain(env_q, 0.9);
assert_eq(dhvani_env_tick(env_o), 0.4, "set_params(): sustain 0.4, not the handle's later 0.9");

var rc = assert_summary();
syscall(60, rc);
